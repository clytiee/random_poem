{
  "manifest_version": 3,
  "name": "随机诗文",
  "version": "0.1.0",
  "description": "点一下图标，随机读一首古诗词。",
  "permissions": ["storage", "unlimitedStorage", "downloads", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "随机一首"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
