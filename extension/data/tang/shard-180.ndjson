{"id":"802276f7ce","title":"登楼寄远","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满城春色花如雪，","极目烟光月似钩。","总是动人乡思处，","更堪容易上高楼。"],"stanzas":[["满城春色花如雪，","极目烟光月似钩。"],["总是动人乡思处，","更堪容易上高楼。"]]}
{"id":"bcd0fdcd73","title":"望思台","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉武年高慢帝图，","任人曾不问贤愚。","直饶四老依前出，","消得江充宠佞无。"],"stanzas":[["汉武年高慢帝图，","任人曾不问贤愚。"],["直饶四老依前出，","消得江充宠佞无。"]]}
{"id":"ab083c9bbc","title":"山舍偶题","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门掩松萝一径深，","偶携藜杖出前林。","谁知尽日看山坐，","万古兴亡总在心。"],"stanzas":[["门掩松萝一径深，","偶携藜杖出前林。"],["谁知尽日看山坐，","万古兴亡总在心。"]]}
{"id":"22b2c94801","title":"荆溪夜泊","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["点点渔灯照浪清，","水烟疎碧月胧明。","小滩惊起鸳鸯处，","一只采莲船过声。"],"stanzas":[["点点渔灯照浪清，","水烟疎碧月胧明。"],["小滩惊起鸳鸯处，","一只采莲船过声。"]]}
{"id":"354dd6aa3d","title":"旅舍卧病","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家隔西秦无远信，","身随东洛度流年。","病来旅馆谁相问，","牢落闲庭一树蝉。"],"stanzas":[["家隔西秦无远信，","身随东洛度流年。"],["病来旅馆谁相问，","牢落闲庭一树蝉。"]]}
{"id":"50ec2bcc57","title":"登昭福寺楼","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旅怀秋兴正无涯，","独倚危楼四望赊。","谷变陵迁何处问，","满川空有旧烟霞。"],"stanzas":[["旅怀秋兴正无涯，","独倚危楼四望赊。"],["谷变陵迁何处问，","满川空有旧烟霞。"]]}
{"id":"a0baac97a8","title":"代边将","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪冻阴河半夜风，","战回狂虏血漂红。","据鞍遥指长安路，","须刻麟台第一功。"],"stanzas":[["雪冻阴河半夜风，","战回狂虏血漂红。"],["据鞍遥指长安路，","须刻麟台第一功。"]]}
{"id":"23654521a1","title":"夜与张舒话别","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁听南楼角又吹，","晓鸡啼后更分离。","如何销得凄凉思，","更劝灯前酒一巵。"],"stanzas":[["愁听南楼角又吹，","晓鸡啼后更分离。"],["如何销得凄凉思，","更劝灯前酒一巵。"]]}
{"id":"3235f01b1d","title":"寒梅词","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霜梅先拆岭头枝，","万卉千花冻不知。","留得和羹滋味在，","任他风雪苦相欺。"],"stanzas":[["霜梅先拆岭头枝，","万卉千花冻不知。"],["留得和羹滋味在，","任他风雪苦相欺。"]]}
{"id":"cb2154cddc","title":"题灵泉寺","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["入谷先生一阵香，","异花奇木簇禅堂。","可怜门外高低路，","万毂千蹄日日忙。"],"stanzas":[["入谷先生一阵香，","异花奇木簇禅堂。"],["可怜门外高低路，","万毂千蹄日日忙。"]]}
{"id":"7047805c25","title":"宿张正字别业","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茅屋萧寥烟暗后，","松窗寂历月明初。","此时谁念孤吟客，","唯有黄公一帙书。"],"stanzas":[["茅屋萧寥烟暗后，","松窗寂历月明初。"],["此时谁念孤吟客，","唯有黄公一帙书。"]]}
{"id":"978f1e49ba","title":"鹤","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天上瑶池覆五云，","玉麟金凤好为群。","不须更饮人间水，","直是清流也汗君。"],"stanzas":[["天上瑶池覆五云，","玉麟金凤好为群。"],["不须更饮人间水，","直是清流也汗君。"]]}
{"id":"ff78d44329","title":"过相思谷","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悠悠信马春山曲，","芳草和烟铺嫩绿。","正被离愁著莫人，","那堪更过相思谷。"],"stanzas":[["悠悠信马春山曲，","芳草和烟铺嫩绿。"],["正被离愁著莫人，","那堪更过相思谷。"]]}
{"id":"0d9eca73d1","title":"写庄子","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣泽安排当散地，","贤侯优贷借新居。","闲中亦有闲生计，","写得南华一部书。"],"stanzas":[["圣泽安排当散地，","贤侯优贷借新居。"],["闲中亦有闲生计，","写得南华一部书。"]]}
{"id":"6da1375972","title":"山中寄友人","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱云堆里结茅庐，","已共红尘迹渐疎。","莫问野人生计事，","窗前流水枕前书。"],"stanzas":[["乱云堆里结茅庐，","已共红尘迹渐疎。"],["莫问野人生计事，","窗前流水枕前书。"]]}
{"id":"8ac33e87fe","title":"津亭","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["津亭欲阕戒棠舟，","五两风来不暂留。","西北浮云连魏阙，","东南初日满秦楼。","层城渺渺人伤别，","芳草萋萋客倦游。","平乐旧欢收不得，","更凭飞梦到瀛洲。"],"stanzas":[["津亭欲阕戒棠舟，","五两风来不暂留。"],["西北浮云连魏阙，","东南初日满秦楼。"],["层城渺渺人伤别，","芳草萋萋客倦游。"],["平乐旧欢收不得，","更凭飞梦到瀛洲。"]]}
{"id":"7034bb2bf7","title":"古别","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长道何年祖軷休，","风帆不断岳阳楼。","佳人挟瑟漳河晓，","壮士悲歌易水秋。","九帐[青]油徒自负，","百壶芳醑岂消忧。","至今长乐坡前水，","不啻秦人怨陇头。"],"stanzas":[["长道何年祖軷休，","风帆不断岳阳楼。"],["佳人挟瑟漳河晓，","壮士悲歌易水秋。"],["九帐[青]油徒自负，","百壶芳醑岂消忧。"],["至今长乐坡前水，","不啻秦人怨陇头。"]]}
{"id":"d1ed595775","title":"塞上","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉家神箭定天山，","烟火相望万里间。","契利请盟金匕酒，","将军归卧玉门关。","云沈老上妖氛断，","雪照回中探骑闲。","五饵已行王道胜，","绝无刁斗至阗颜。"],"stanzas":[["汉家神箭定天山，","烟火相望万里间。"],["契利请盟金匕酒，","将军归卧玉门关。"],["云沈老上妖氛断，","雪照回中探骑闲。"],["五饵已行王道胜，","绝无刁斗至阗颜。"]]}
{"id":"56d1bd1bdf","title":"寄昭潭王中立","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高弦一弄武陵深，","六幕天空万里心。","吴苑歌骊成久别，","楚峰回雁好归音。","十千美酒花期隔，","三百枯棋弈思沈。","莫上孤城频送目，","浮云西北是家林。"],"stanzas":[["高弦一弄武陵深，","六幕天空万里心。"],["吴苑歌骊成久别，","楚峰回雁好归音。"],["十千美酒花期隔，","三百枯棋弈思沈。"],["莫上孤城频送目，","浮云西北是家林。"]]}
{"id":"1d1a785c0d","title":"雪","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["屏翳驱云结夜阴，","素花飘坠恶氛沈。","色欺曹国麻衣浅，","寒入荆王翠被深。","天上明河银作水，","海中仙树玉为林。","日高独拥鹴裘卧，","谁乞长安取酒金。"],"stanzas":[["屏翳驱云结夜阴，","素花飘坠恶氛沈。"],["色欺曹国麻衣浅，","寒入荆王翠被深。"],["天上明河银作水，","海中仙树玉为林。"],["日高独拥鹴裘卧，","谁乞长安取酒金。"]]}
{"id":"a6fa3e0261","title":"冲虚观","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五粒青松护翠苔，","石门岑寂断纤埃。","水浮花片知仙路，","风递鸾声认啸台。","桐井晓寒千乳歛，","茗园春嫩一旗开。","驰烟未勒山亭字，","可是英灵许再来。"],"stanzas":[["五粒青松护翠苔，","石门岑寂断纤埃。"],["水浮花片知仙路，","风递鸾声认啸台。"],["桐井晓寒千乳歛，","茗园春嫩一旗开。"],["驰烟未勒山亭字，","可是英灵许再来。"]]}
{"id":"709c27690e","title":"淮南发运赵邢州被诏归阙","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天台封诏紫泥馨，","马首前瞻北斗城。","人在函关先望气，","帝于京兆最知名。","一区东第趋晨近，","数刻西厢接昼荣。","正是两宫裁化日，","百金双璧拜虞卿。"],"stanzas":[["天台封诏紫泥馨，","马首前瞻北斗城。"],["人在函关先望气，","帝于京兆最知名。"],["一区东第趋晨近，","数刻西厢接昼荣。"],["正是两宫裁化日，","百金双璧拜虞卿。"]]}
{"id":"9cd040dbfa","title":"天街晓望","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长乐才闻一叩钟，","百官初谒未央宫。","金波穆穆沙隄月，","玉树琤琤上苑风。","香重椒兰横结雾，","气寒龙虎远浮空。","嗟余索米无人问，","行避霜台御史骢。"],"stanzas":[["长乐才闻一叩钟，","百官初谒未央宫。"],["金波穆穆沙隄月，","玉树琤琤上苑风。"],["香重椒兰横结雾，","气寒龙虎远浮空。"],["嗟余索米无人问，","行避霜台御史骢。"]]}
{"id":"8783de9713","title":"淮南王","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贪铸金钱盗写符，","何曾七国戒前车。","长生不待炉中药，","鸿宝谁收箧里书。","碧井床空天影在，","小山人去桂丛疎。","云中鸡犬无消息，","麦秀渐渐徧故墟。"],"stanzas":[["贪铸金钱盗写符，","何曾七国戒前车。"],["长生不待炉中药，","鸿宝谁收箧里书。"],["碧井床空天影在，","小山人去桂丛疎。"],["云中鸡犬无消息，","麦秀渐渐徧故墟。"]]}
{"id":"a565e7ecdf","title":"赵宗道归辇下","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沿牒相逢楚水湄，","竹林文酒此攀嵇。","半毡未暖还伤别，","一臂初交又解携。","江浦呕哑风送樐，","河桥勃窣柳垂隄。","明年四月秦关到，","洗眼扬州看马[蹄]。"],"stanzas":[["沿牒相逢楚水湄，","竹林文酒此攀嵇。"],["半毡未暖还伤别，","一臂初交又解携。"],["江浦呕哑风送樐，","河桥勃窣柳垂隄。"],["明年四月秦关到，","洗眼扬州看马[蹄]。"]]}
{"id":"6d051271c3","title":"忆荐福寺牡丹","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十日春风隔翠岑，","秪应繁朵自成阴。","樽前可要人颓玉，","树底遥知地侧金。","花界三千春渺渺，","铜槃十二夜沈沈。","雕槃分𥮾何由得，","空作西州拥鼻吟。"],"stanzas":[["十日春风隔翠岑，","秪应繁朵自成阴。"],["樽前可要人颓玉，","树底遥知地侧金。"],["花界三千春渺渺，","铜槃十二夜沈沈。"],["雕槃分𥮾何由得，","空作西州拥鼻吟。"]]}
{"id":"777ac5aaa3","title":"次韵和朱况雨中之什","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍野迷云黯不归，","远风吹雨入岩扉。","石床润极琴丝缓，","水阁寒多酒力微。","夕梦将成还滴滴，","春心欲断正霏霏。","忧花惜月长如此，","争得东阳病骨肥。"],"stanzas":[["苍野迷云黯不归，","远风吹雨入岩扉。"],["石床润极琴丝缓，","水阁寒多酒力微。"],["夕梦将成还滴滴，","春心欲断正霏霏。"],["忧花惜月长如此，","争得东阳病骨肥。"]]}
{"id":"70130a41ef","title":"感旧","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千里青云未致身，","马蹄空踏几年尘。","曾迷玉洞花光老，","欲过金城柳眼新。","粉壁已沈题凤字，","酒垆犹记姓黄人。","坞中横笛偏多感，","一涕阑干白角巾。"],"stanzas":[["千里青云未致身，","马蹄空踏几年尘。"],["曾迷玉洞花光老，","欲过金城柳眼新。"],["粉壁已沈题凤字，","酒垆犹记姓黄人。"],["坞中横笛偏多感，","一涕阑干白角巾。"]]}
{"id":"1fe177e788","title":"城南","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨夜轻阴结夕霏，","城南十里有香泥。","初闻山鸟惊新哢，","遥见林花识旧蹊。","荡桨远从芳草渡，","垫巾还傍绿杨隄。","罗敷正苦桑蚕事，","惆怅南来五马蹄。"],"stanzas":[["昨夜轻阴结夕霏，","城南十里有香泥。"],["初闻山鸟惊新哢，","遥见林花识旧蹊。"],["荡桨远从芳草渡，","垫巾还傍绿杨隄。"],["罗敷正苦桑蚕事，","惆怅南来五马蹄。"]]}
{"id":"1137e3357c","title":"早夏","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["井辖投多思不禁，","密垂珠箔昼沈沈。","睡惊燕语频移枕，","病起蛛丝半在琴。","雨径乱花埋宿艳，","月轩修竹转凉阴。","一春酒费知多少，","探尽囊中换赋金。"],"stanzas":[["井辖投多思不禁，","密垂珠箔昼沈沈。"],["睡惊燕语频移枕，","病起蛛丝半在琴。"],["雨径乱花埋宿艳，","月轩修竹转凉阴。"],["一春酒费知多少，","探尽囊中换赋金。"]]}
{"id":"258e76e039","title":"侯家","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞户春迟漏箭长，","短辕初返雒阳傍。","彩云按曲青岑醴，","沈水薰衣白璧堂。","前槛兰苕依玉树，","后园桐叶护银床。","宴残红烛长庚烂，","还促朝珂谒未央。"],"stanzas":[["洞户春迟漏箭长，","短辕初返雒阳傍。"],["彩云按曲青岑醴，","沈水薰衣白璧堂。"],["前槛兰苕依玉树，","后园桐叶护银床。"],["宴残红烛长庚烂，","还促朝珂谒未央。"]]}
{"id":"b11e7e49ac","title":"函谷关","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天开函谷壮关中，","万古惊尘向此空。","望气竟能知老子，","弃𦈡何不识终童。","慢持白马先生论，","未抵鸣鸡下客功。","符命已归如掌地，","一丸曾误隗王东。"],"stanzas":[["天开函谷壮关中，","万古惊尘向此空。"],["望气竟能知老子，","弃𦈡何不识终童。"],["慢持白马先生论，","未抵鸣鸡下客功。"],["符命已归如掌地，","一丸曾误隗王东。"]]}
{"id":"cc2bd0727a","title":"残花","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨压残红一夜凋，","晓来帘外正飘摇。","数枝翠叶空相对，","万片香魂不可招。","长乐梦回春寂寂，","武陵人去水迢迢。","愁将玉笛传遗恨，","苦被芳风透绮寮。"],"stanzas":[["雨压残红一夜凋，","晓来帘外正飘摇。"],["数枝翠叶空相对，","万片香魂不可招。"],["长乐梦回春寂寂，","武陵人去水迢迢。"],["愁将玉笛传遗恨，","苦被芳风透绮寮。"]]}
{"id":"d57f88e70e","title":"次韵徐爽见寄","author":"胡宿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五两青丝帝渥深，","平时可敢叹英沈。","侏儒自是长三尺，","澼絖都来直数金。","寂寞死灰人丧偶，","婆娑生意树交阴。","年来想见琼枝色，","久梦蘧蘧到竹林。"],"stanzas":[["五两青丝帝渥深，","平时可敢叹英沈。"],["侏儒自是长三尺，","澼絖都来直数金。"],["寂寞死灰人丧偶，","婆娑生意树交阴。"],["年来想见琼枝色，","久梦蘧蘧到竹林。"]]}
{"id":"1b0e8295bf","title":"华清宫","author":"杜常","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行尽江南数十程，","晓星残月入华清。","朝元阁上西风急，","都入长杨作雨声。"],"stanzas":[["行尽江南数十程，","晓星残月入华清。"],["朝元阁上西风急，","都入长杨作雨声。"]]}
{"id":"fda05ef351","title":"华清宫","author":"杜常","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一别家山十六程，","晓来和月到华清。","朝元阁上西风急，","都入长杨作雨声。"],"stanzas":[["一别家山十六程，","晓来和月到华清。"],["朝元阁上西风急，","都入长杨作雨声。"]]}
{"id":"22856a54d1","title":"题文川村居","author":"滕白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["种茶岩接红霞坞，","灌稻泉生白石根。","皤腹老翁眉似雪，","海棠花下戏儿孙。"],"stanzas":[["种茶岩接红霞坞，","灌稻泉生白石根。"],["皤腹老翁眉似雪，","海棠花下戏儿孙。"]]}
{"id":"faf3bfa1ec","title":"燕","author":"滕白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["短羽新来别海阳，","真珠高卷语雕梁。","佳人未必全听尔，","正把金针绣凤凰。"],"stanzas":[["短羽新来别海阳，","真珠高卷语雕梁。"],["佳人未必全听尔，","正把金针绣凤凰。"]]}
{"id":"9a2778fe04","title":"题严君观","author":"王嵒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒云古木罩星台，","凡骨仙踪信可哀。","二十年前曾此到，","一千年内未归来。"],"stanzas":[["寒云古木罩星台，","凡骨仙踪信可哀。"],["二十年前曾此到，","一千年内未归来。"]]}
{"id":"4bb0243d2d","title":"山中有所思","author":"王嵒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["零零夜雨渍愁根，","触物伤离好断魂。","莫怪杜鹃飞去尽，","紫微花里有啼猨。"],"stanzas":[["零零夜雨渍愁根，","触物伤离好断魂。"],["莫怪杜鹃飞去尽，","紫微花里有啼猨。"]]}
{"id":"6c3dce58b7","title":"燕","author":"王嵒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一巢功绩破春光，","絮落花残两翅狂。","月树风枝不栖去，","强来言语泥雕梁。"],"stanzas":[["一巢功绩破春光，","絮落花残两翅狂。"],["月树风枝不栖去，","强来言语泥雕梁。"]]}
{"id":"a33e606340","title":"贫女","author":"王嵒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["难把菱花照素颜，","试临春水插花看。","木兰船上游春子，","笑指荆钗下远滩。"],"stanzas":[["难把菱花照素颜，","试临春水插花看。"],["木兰船上游春子，","笑指荆钗下远滩。"]]}
{"id":"cc5913448d","title":"杪春寄友人","author":"王嵒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何处相逢万事忙，","卓家楼上百淘香。","明朝渐近山僧寺，","更为残花醉一场。"],"stanzas":[["何处相逢万事忙，","卓家楼上百淘香。"],["明朝渐近山僧寺，","更为残花醉一场。"]]}
{"id":"fac0a9950e","title":"回旧山","author":"王嵒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庾家楼上谢家池，","处处风烟少旧知。","明日落花谁共醉，","野溪猨鸟恨归迟。"],"stanzas":[["庾家楼上谢家池，","处处风烟少旧知。"],["明日落花谁共醉，","野溪猨鸟恨归迟。"]]}
{"id":"da38212018","title":"感巫州荠菜","author":"高力士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两京作觔卖，","五溪无人采。","夷夏虽有殊，","气味都不改。"],"stanzas":[["两京作觔卖，","五溪无人采。"],["夷夏虽有殊，","气味都不改。"]]}
{"id":"22bfe072f6","title":"句","author":"高力士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟熏眼落膜，","瘴染面朱虞。"],"stanzas":[["烟熏眼落膜，","瘴染面朱虞。"]]}
{"id":"f53fc8ef01","title":"使至灊山","author":"王越宾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧坞烟霞昼未开，","游人到处尽裴回。","凭谁借问岩前叟，","曾托吾皇一梦来。"],"stanzas":[["碧坞烟霞昼未开，","游人到处尽裴回。"],["凭谁借问岩前叟，","曾托吾皇一梦来。"]]}
{"id":"12b7381a66","title":"和武相公中秋夜西蜀锦楼望月得清字","author":"王良会","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["德星摇此夜，","珥月满重城。","杳霭烟氛色，","飘飖砧杵声。","令行秋气爽，","乐感素风轻。","共赏千年圣，","长歌四海清。"],"stanzas":[["德星摇此夜，","珥月满重城。"],["杳霭烟氛色，","飘飖砧杵声。"],["令行秋气爽，","乐感素风轻。"],["共赏千年圣，","长歌四海清。"]]}
{"id":"692bf29ebf","title":"星回节游避风台与清平官赋","author":"南诏骠信","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["避风善阐台，","极目见藤越。","悲哉古与今，","依然烟与月。","自我居震旦，","翊卫类夔契。","伊昔颈皇运，","艰难仰忠烈。","不觉岁云暮，","感极星回节。","元昶同一心，","子孙堪贻厥。"],"stanzas":[["避风善阐台，","极目见藤越。"],["悲哉古与今，","依然烟与月。"],["自我居震旦，","翊卫类夔契。"],["伊昔颈皇运，","艰难仰忠烈。"],["不觉岁云暮，","感极星回节。"],["元昶同一心，","子孙堪贻厥。"]]}
{"id":"b0123fd211","title":"星回节避风台骠信命赋","author":"赵叔达","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["法驾避星回，","波罗毘勇猜。","河润冰难合，","地暖梅先开。","下令俚柔洽，","献賝弄栋来。","愿将不才质，","千载侍游台。"],"stanzas":[["法驾避星回，","波罗毘勇猜。"],["河润冰难合，","地暖梅先开。"],["下令俚柔洽，","献賝弄栋来。"],["愿将不才质，","千载侍游台。"]]}
{"id":"151735e507","title":"途中诗","author":"杨奇鲲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["□□□□□□□，","□□□□□□□。","风里浪花吹更白，","雨中山色洗还青。","海鸥聚处窗前见，","林狖啼时枕上听。","此际自然无限趣，","王程不敢暂留停。"],"stanzas":[["□□□□□□□，","□□□□□□□。"],["风里浪花吹更白，","雨中山色洗还青。"],["海鸥聚处窗前见，","林狖啼时枕上听。"],["此际自然无限趣，","王程不敢暂留停。"]]}
{"id":"ba751e43f8","title":"听妓洞云歌","author":"布燮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嵇叔夜，","鼓琴饮酒无闲暇。","若使当时闻此歌，","抛掷广陵都不藉。","刘伯伦，","虚生浪死过青春。","一饮一硕犹自醉，","无人为尔卜深尘。"],"stanzas":[["嵇叔夜，","鼓琴饮酒无闲暇。"],["若使当时闻此歌，","抛掷广陵都不藉。"],["刘伯伦，","虚生浪死过青春。"],["一饮一硕犹自醉，","无人为尔卜深尘。"]]}
{"id":"8cd594a420","title":"思乡作","author":"布燮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泸北行人绝，","云南信未还。","庭前花不埽，","门外柳谁攀。","坐久销银烛，","愁多减玉颜。","悬心秋夜月，","万里照关山。"],"stanzas":[["泸北行人绝，","云南信未还。"],["庭前花不埽，","门外柳谁攀。"],["坐久销银烛，","愁多减玉颜。"],["悬心秋夜月，","万里照关山。"]]}
{"id":"a9553385f9","title":"衔命还国作","author":"朝衡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["衔命将辞国，","非才忝侍臣。","天中恋明主，","海外忆慈亲。","伏奏违金阙，","𬴂骖去玉津。","蓬莱乡路远，","若木故园林。","西望怀恩日，","东归感义辰。","平生一宝劒，","留赠结交人。"],"stanzas":[["衔命将辞国，","非才忝侍臣。"],["天中恋明主，","海外忆慈亲。"],["伏奏违金阙，","𬴂骖去玉津。"],["蓬莱乡路远，","若木故园林。"],["西望怀恩日，","东归感义辰。"],["平生一宝劒，","留赠结交人。"]]}
{"id":"2fc33c73b0","title":"绣袈裟衣缘","author":"长屋","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山川异域，","风月同天。","寄诸佛子，","共结来缘。"],"stanzas":[["山川异域，","风月同天。"],["寄诸佛子，","共结来缘。"]]}
{"id":"0af1a69426","title":"愤怨诗","author":"王巨仁","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["于公恸哭三年旱，","邹衍含愁五月霜。","今我幽愁还似古，","皇天无语但苍苍。"],"stanzas":[["于公恸哭三年旱，","邹衍含愁五月霜。"],["今我幽愁还似古，","皇天无语但苍苍。"]]}
{"id":"7a1d91f733","title":"立木海上刻诗","author":"李赞华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小山压大山，","大山全无力。","羞见故乡人，","从此投外国。"],"stanzas":[["小山压大山，","大山全无力。"],["羞见故乡人，","从此投外国。"]]}
{"id":"0206b462e6","title":"戏语","author":"成辅端","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦地城池二百年，","何期如此贱田园。","一顷麦苗硕伍米，","三间堂屋二千钱。"],"stanzas":[["秦地城池二百年，","何期如此贱田园。"],["一顷麦苗硕伍米，","三间堂屋二千钱。"]]}
{"id":"752b885360","title":"万寿寺歌词","author":"张隐","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["位乖燮理致伤残，","四面墙匡不忍看。","正是花时堪下泪，","相公何必更追欢。"],"stanzas":[["位乖燮理致伤残，","四面墙匡不忍看。"],["正是花时堪下泪，","相公何必更追欢。"]]}
{"id":"ad516f04d3","title":"迎孙刺史","author":"朱元","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔日郎君今刺史，","朱元依旧守朱门。","今朝竹马诸童子，","尽是当时竹马孙。"],"stanzas":[["昔日郎君今刺史，","朱元依旧守朱门。"],["今朝竹马诸童子，","尽是当时竹马孙。"]]}
{"id":"d83fcf686d","title":"临刑诗","author":"陈璠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["积玉堆金官又崇，","祸来倏忽变成空。","五年荣贵今何在，","不异南柯一梦中。"],"stanzas":[["积玉堆金官又崇，","祸来倏忽变成空。"],["五年荣贵今何在，","不异南柯一梦中。"]]}
{"id":"2c51850189","title":"诗","author":"捧劒仆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青鸟衔葡萄，","飞上金井栏。","美人恐惊去，","不敢卷帘看。"],"stanzas":[["青鸟衔葡萄，","飞上金井栏。"],["美人恐惊去，","不敢卷帘看。"]]}
{"id":"365789caba","title":"题牡丹","author":"捧劒仆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一种芳菲出后庭，","却输桃李得佳名。","谁能为向天人说，","从此移根近太清。"],"stanzas":[["一种芳菲出后庭，","却输桃李得佳名。"],["谁能为向天人说，","从此移根近太清。"]]}
{"id":"8aab631a11","title":"将窜留诗","author":"捧劒仆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珍重郭四郎，","临行不得别。","晓漏动离心，","轻车冒残雪。","欲出主人门，","零涕暗呜咽。","万里隔关山，","一心思汉月。"],"stanzas":[["珍重郭四郎，","临行不得别。"],["晓漏动离心，","轻车冒残雪。"],["欲出主人门，","零涕暗呜咽。"],["万里隔关山，","一心思汉月。"]]}
{"id":"fe9531c251","title":"淮阳感怀","author":"李密","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金风荡初节，","玉露凋晚林。","此夕穷涂士，","郁陶伤寸心。","野平葭苇合，","村荒藜藿深。","眺听良多感，","徙倚独沾襟。","沾襟何所为，","怅然怀古意。","秦俗犹未平，","汉道将何翼。","樊哙市井徒，","萧何刀笔吏。","一朝时运会，","千古传名谥。","寄言世上雄，","虚生真可媿。"],"stanzas":[["金风荡初节，","玉露凋晚林。"],["此夕穷涂士，","郁陶伤寸心。"],["野平葭苇合，","村荒藜藿深。"],["眺听良多感，","徙倚独沾襟。"],["沾襟何所为，","怅然怀古意。"],["秦俗犹未平，","汉道将何翼。"],["樊哙市井徒，","萧何刀笔吏。"],["一朝时运会，","千古传名谥。"],["寄言世上雄，","虚生真可媿。"]]}
{"id":"7ebc274253","title":"南隐游泉山","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名山狎招隐，","俗外远相求。","还如倒景望，","忽似阆风游。","临崖俯大壑，","披雾仰飞流。","岁积松方偃，","年深椿欲秋。","野花开石镜，","云叶掩山楼。","何须问方士，","此处即瀛洲。"],"stanzas":[["名山狎招隐，","俗外远相求。"],["还如倒景望，","忽似阆风游。"],["临崖俯大壑，","披雾仰飞流。"],["岁积松方偃，","年深椿欲秋。"],["野花开石镜，","云叶掩山楼。"],["何须问方士，","此处即瀛洲。"]]}
{"id":"38b34b6b95","title":"行经太华","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["纷吾世网暇，","灵岳展幽寻。","寥廊风尘远，","杳冥川谷深。","山昏五里雾，","日落二华阴。","疎峰起莲叶，","危塞隐桃林。","何必东都外，","此处可抽簪。"],"stanzas":[["纷吾世网暇，","灵岳展幽寻。"],["寥廊风尘远，","杳冥川谷深。"],["山昏五里雾，","日落二华阴。"],["疎峰起莲叶，","危塞隐桃林。"],["何必东都外，","此处可抽簪。"]]}
{"id":"0e9cbae874","title":"夜宿荒村","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绵绵夕漏深，","客恨转伤心。","抚弦无人听，","对酒时独斟。","故乡万里绝，","穷愁百虑侵。","秋草思边马，","绕枝惊夜禽。","风度谷余响，","月斜山半阴。","劳歌欲叙意，","终是白头吟。"],"stanzas":[["绵绵夕漏深，","客恨转伤心。"],["抚弦无人听，","对酒时独斟。"],["故乡万里绝，","穷愁百虑侵。"],["秋草思边马，","绕枝惊夜禽。"],["风度谷余响，","月斜山半阴。"],["劳歌欲叙意，","终是白头吟。"]]}
{"id":"4404dc7b59","title":"王泽岭遭洪水","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地籁风声急，","天津云色愁。","悠然万顷满，","俄尔百川浮。","远似金堤溢，","翻如碧海流。","惊涛遥起鹭，","回岸不分牛。","徒知怀赵景，","终是倦阳侯。","木梗诚无托，","芦灰岂暇求。","思得乘槎便，","萧然河汉游。"],"stanzas":[["地籁风声急，","天津云色愁。"],["悠然万顷满，","俄尔百川浮。"],["远似金堤溢，","翻如碧海流。"],["惊涛遥起鹭，","回岸不分牛。"],["徒知怀赵景，","终是倦阳侯。"],["木梗诚无托，","芦灰岂暇求。"],["思得乘槎便，","萧然河汉游。"]]}
{"id":"60e69a42b3","title":"登白马山护明寺","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名岳标形胜，","危峰远郁纡。","成象建环极，","大壮阐规模。","层台从灵鹫，","高殿迩阳乌。","暂同游阆苑，","还类入仙都。","三休开碧岭，","万户洞金铺。","摄心罄前礼，","访道挹中虚。","遥瞻尽地轴，","长望极天隅。","白云起梁栋，","丹霞映栱栌。","露花疑濯锦，","泉月似沈珠。","今日桃源客，","相顾失归涂。"],"stanzas":[["名岳标形胜，","危峰远郁纡。"],["成象建环极，","大壮阐规模。"],["层台从灵鹫，","高殿迩阳乌。"],["暂同游阆苑，","还类入仙都。"],["三休开碧岭，","万户洞金铺。"],["摄心罄前礼，","访道挹中虚。"],["遥瞻尽地轴，","长望极天隅。"],["白云起梁栋，","丹霞映栱栌。"],["露花疑濯锦，","泉月似沈珠。"],["今日桃源客，","相顾失归涂。"]]}
{"id":"6ef2bf8d68","title":"送舍利宿定普岩","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仁祠表虚旷，","祗园展肃恭。","栖息翠微岭，","登顿白云峰。","映流看夜月，","临峰听晓钟。","涧芳十步草，","崖阴百丈松。","萧然遥路绝，","无复市朝踪。"],"stanzas":[["仁祠表虚旷，","祗园展肃恭。"],["栖息翠微岭，","登顿白云峰。"],["映流看夜月，","临峰听晓钟。"],["涧芳十步草，","崖阴百丈松。"],["萧然遥路绝，","无复市朝踪。"]]}
{"id":"628f714889","title":"观太常奏新乐","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大君膺宝历，","出豫表功成。","钧天金石响，","洞庭弦管清。","八音动繁会，","九变叶希声。","和云留睿赏，","熏风悦圣情。","盛烈光韶濩，","易俗迈咸英。","窃吹良无取，","率舞抃群生。"],"stanzas":[["大君膺宝历，","出豫表功成。"],["钧天金石响，","洞庭弦管清。"],["八音动繁会，","九变叶希声。"],["和云留睿赏，","熏风悦圣情。"],["盛烈光韶濩，","易俗迈咸英。"],["窃吹良无取，","率舞抃群生。"]]}
{"id":"b03bfcbcd9","title":"赋得涉江采芙蓉","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莲舟泛锦碛，","极目眺江干。","沿流渡檝易，","逆浪取花难。","有雾疑川广，","无风见水宽。","朝来采摘倦，","讵得久盘桓。"],"stanzas":[["莲舟泛锦碛，","极目眺江干。"],["沿流渡檝易，","逆浪取花难。"],["有雾疑川广，","无风见水宽。"],["朝来采摘倦，","讵得久盘桓。"]]}
{"id":"1a26321131","title":"赋得华亭鹤","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华亭失侣鹤，","乘轩宠遂终。","三山凌苦雾，","千里激悲风。","心危白露下，","声断彩弦中。","何言斯物变，","翻复似辽东。"],"stanzas":[["华亭失侣鹤，","乘轩宠遂终。"],["三山凌苦雾，","千里激悲风。"],["心危白露下，","声断彩弦中。"],["何言斯物变，","翻复似辽东。"]]}
{"id":"518d3edcf8","title":"送蔡君知入蜀二首 一","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金陵已去国，","铜梁忽背飞。","失路远相送，","他乡何日归。"],"stanzas":[["金陵已去国，","铜梁忽背飞。"],["失路远相送，","他乡何日归。"]]}
{"id":"af16c7ad05","title":"送蔡君知入蜀二首 二","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵关九折险，","蜀道二星遥。","乘槎若有便，","希泛广陵潮。"],"stanzas":[["灵关九折险，","蜀道二星遥。"],["乘槎若有便，","希泛广陵潮。"]]}
{"id":"eed8a0bb4d","title":"落叶","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早秋惊叶落，","飘零似客心。","翻飞未肯下，","犹言惜故林。"],"stanzas":[["早秋惊叶落，","飘零似客心。"],["翻飞未肯下，","犹言惜故林。"]]}
{"id":"9d42a40aa0","title":"句","author":"孔德绍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁分菱花影，","还看蓬鬓秋。"],"stanzas":[["谁分菱花影，","还看蓬鬓秋。"]]}
{"id":"8a8f3e4c27","title":"临刑诗","author":"郑颋","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幻生还幻灭，","大幻莫过身。","安心自有处，","求人无有人。"],"stanzas":[["幻生还幻灭，","大幻莫过身。"],["安心自有处，","求人无有人。"]]}
{"id":"c286df336d","title":"和谒孔子庙","author":"刘斌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["性与虽天纵，","主世乃无由。","何言泰山毁，","空惊逝水流。","及门思往烈，","入室想前修。","寂寞荒堦暮，","摧残古木秋。","遗风暧如此，","聊以慰蒸求。"],"stanzas":[["性与虽天纵，","主世乃无由。"],["何言泰山毁，","空惊逝水流。"],["及门思往烈，","入室想前修。"],["寂寞荒堦暮，","摧残古木秋。"],["遗风暧如此，","聊以慰蒸求。"]]}
{"id":"a103e0903d","title":"和许给事伤牛尚书","author":"刘斌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名臣不世出，","百工之所求。","况乃非常器，","遭逢兴运秋。","符彩照千里，","铨衡综九流。","经纶资百物，","樽俎寄皇猷。","韶濩倾复理，","典礼紊还修。","虽贞栋梁任，","兼好艺文游。","伫闻和鼎实，","行当奉介丘。","高衢翻税驾，","阅水遽迁舟。","传呼更何日，","曳履闻无由。","归魂藐修路，","征櫂舣邗沟。","林薄长风惨，","江上寒云愁。","夜台终不曙，","遗芳徒自留。"],"stanzas":[["名臣不世出，","百工之所求。"],["况乃非常器，","遭逢兴运秋。"],["符彩照千里，","铨衡综九流。"],["经纶资百物，","樽俎寄皇猷。"],["韶濩倾复理，","典礼紊还修。"],["虽贞栋梁任，","兼好艺文游。"],["伫闻和鼎实，","行当奉介丘。"],["高衢翻税驾，","阅水遽迁舟。"],["传呼更何日，","曳履闻无由。"],["归魂藐修路，","征櫂舣邗沟。"],["林薄长风惨，","江上寒云愁。"],["夜台终不曙，","遗芳徒自留。"]]}
{"id":"3885cf55a8","title":"送刘散员同赋陈思王诗得好鸟鸣高枝","author":"刘斌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春林已自好，","时鸟复和鸣。","枝交难奋翼，","谷静易流声。","间关才得性，","[矰]缴遽相惊。","安知背飞远，","拂雾独晨征。"],"stanzas":[["春林已自好，","时鸟复和鸣。"],["枝交难奋翼，","谷静易流声。"],["间关才得性，","[矰]缴遽相惊。"],["安知背飞远，","拂雾独晨征。"]]}
{"id":"d91a81539a","title":"咏山","author":"刘斌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵山峙千仞，","蔽日且嵯峨。","紫盖云阴远，","香炉烟气多。","石梁高鸟路，","瀑水近天河。","欲知闻道里，","别自有仙歌。"],"stanzas":[["灵山峙千仞，","蔽日且嵯峨。"],["紫盖云阴远，","香炉烟气多。"],["石梁高鸟路，","瀑水近天河。"],["欲知闻道里，","别自有仙歌。"]]}
{"id":"b5137dd33d","title":"登楼望月二首 一","author":"刘斌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圆月当新霁，","高楼见最明。","素波流粉壁，","丹桂拂飞甍。","下瞰千门静，","旁观万象生。","梧桐窗下影，","鸟鹊槛前声。","啸逸刘琨兴，","吟资庾亮情。","游人莫登眺，","迢递故乡程。"],"stanzas":[["圆月当新霁，","高楼见最明。"],["素波流粉壁，","丹桂拂飞甍。"],["下瞰千门静，","旁观万象生。"],["梧桐窗下影，","鸟鹊槛前声。"],["啸逸刘琨兴，","吟资庾亮情。"],["游人莫登眺，","迢递故乡程。"]]}
{"id":"6a14b2fcc1","title":"登楼望月二首 二","author":"刘斌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皎洁三秋月，","巍峨百丈楼。","下分征客路，","上有美人愁。","帐卷芙蓉带，","帘褰玳瑁钩。","倚窗情渺渺，","凭槛思悠悠。","末得金波转，","俄成玉筯流。","不堪三五夕，","夫壻在边州。"],"stanzas":[["皎洁三秋月，","巍峨百丈楼。"],["下分征客路，","上有美人愁。"],["帐卷芙蓉带，","帘褰玳瑁钩。"],["倚窗情渺渺，","凭槛思悠悠。"],["末得金波转，","俄成玉筯流。"],["不堪三五夕，","夫壻在边州。"]]}
{"id":"64040621fa","title":"题菊花","author":"黄巢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飒飒西风满院栽，","蘂寒香冷蝶难来。","他年我若为青帝，","报与桃花一处开。"],"stanzas":[["飒飒西风满院栽，","蘂寒香冷蝶难来。"],["他年我若为青帝，","报与桃花一处开。"]]}
{"id":"0df9c4e362","title":"不第后赋菊","author":"黄巢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["待到秋来九月八，","我花开后百花杀。","冲天香阵透长安，","满城尽带黄金甲。"],"stanzas":[["待到秋来九月八，","我花开后百花杀。"],["冲天香阵透长安，","满城尽带黄金甲。"]]}
{"id":"e713cc0acd","title":"自题像","author":"黄巢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["记得当年草上飞，","铁衣著尽著僧衣。","天津桥上无人识，","独倚栏干看落晖。"],"stanzas":[["记得当年草上飞，","铁衣著尽著僧衣。"],["天津桥上无人识，","独倚栏干看落晖。"]]}
{"id":"98d8253c5e","title":"柳","author":"罗绍威","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妆点青春更有谁，","青春常许占先知。","亚夫营畔风轻处，","元亮门前日暖时。","花密宛如飘六出，","叶繁何惜借双眉。","交情别绪论多少，","好向仁人赠一枝。"],"stanzas":[["妆点青春更有谁，","青春常许占先知。"],["亚夫营畔风轻处，","元亮门前日暖时。"],["花密宛如飘六出，","叶繁何惜借双眉。"],["交情别绪论多少，","好向仁人赠一枝。"]]}
{"id":"cee0ee45ee","title":"白菊","author":"罗绍威","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虽被风霜竞欲催，","皎然颜色不低摧。","已疑素手能妆出，","又似金钱未染来。","香散自宜飘渌酒，","叶交仍得荫苍苔。","寻思闭户中宵见，","应认寒窗雪一堆。"],"stanzas":[["虽被风霜竞欲催，","皎然颜色不低摧。"],["已疑素手能妆出，","又似金钱未染来。"],["香散自宜飘渌酒，","叶交仍得荫苍苔。"],["寻思闭户中宵见，","应认寒窗雪一堆。"]]}
{"id":"4b1fb564da","title":"句","author":"罗绍威","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼前澹澹云头日，","帘外萧萧雨脚风。"],"stanzas":[["楼前澹澹云头日，","帘外萧萧雨脚风。"]]}
{"id":"920276d9af","title":"清明登奉先城楼","author":"罗衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年来年去只艰危，","春半尧山草尚衰。","四海清平耆旧见，","五陵寒食小臣悲。","烟销井邑隈楼槛，","雪满川原泥酒巵。","拭尽贾生无限泪，","一行归雁远参差。"],"stanzas":[["年来年去只艰危，","春半尧山草尚衰。"],["四海清平耆旧见，","五陵寒食小臣悲。"],["烟销井邑隈楼槛，","雪满川原泥酒巵。"],["拭尽贾生无限泪，","一行归雁远参差。"]]}
{"id":"869b5beb68","title":"清明赤水寺居","author":"罗衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["榆火轻烟处处新，","旋从闲望到诸邻。","浮生浮世祗多事，","野水野花娱病身。","浊酒不禁云外景，","碧峰犹冷寺前春。","蓑衣毳衲诚吾党，","自结村园一社贫。"],"stanzas":[["榆火轻烟处处新，","旋从闲望到诸邻。"],["浮生浮世祗多事，","野水野花娱病身。"],["浊酒不禁云外景，","碧峰犹冷寺前春。"],["蓑衣毳衲诚吾党，","自结村园一社贫。"]]}
{"id":"be92941a27","title":"赠罗隐","author":"罗衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平日时风好涕流，","谗书虽盛一名休。","寰区叹屈瞻天问，","夷貊闻诗过海求。","向夕便思青琐拜，","近年寻伴赤松游。","何当世祖从人望，","早以公台命卓侯。"],"stanzas":[["平日时风好涕流，","谗书虽盛一名休。"],["寰区叹屈瞻天问，","夷貊闻诗过海求。"],["向夕便思青琐拜，","近年寻伴赤松游。"],["何当世祖从人望，","早以公台命卓侯。"]]}
{"id":"a34deeb2cd","title":"哭赵州和尚二首 一","author":"王镕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师离㴲水动王侯，","心印光潜麈尾收。","碧落雾霾松岭月，","沧溟浪覆济人舟。","一灯乍灭波旬喜，","双眼重昏道侣愁。","纵是了然云外客，","每瞻缾几泪还流。"],"stanzas":[["师离㴲水动王侯，","心印光潜麈尾收。"],["碧落雾霾松岭月，","沧溟浪覆济人舟。"],["一灯乍灭波旬喜，","双眼重昏道侣愁。"],["纵是了然云外客，","每瞻缾几泪还流。"]]}
{"id":"89cbac966b","title":"哭赵州和尚二首 二","author":"王镕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佛日西倾祖印隳，","珠沈丹沼月沈辉。","影敷丈室炉烟惨，","风起禅堂松韵微。","只履乍来留化迹，","五天何处又逢归。","解空弟子绝悲喜，","犹自潸然对雪帏。"],"stanzas":[["佛日西倾祖印隳，","珠沈丹沼月沈辉。"],["影敷丈室炉烟惨，","风起禅堂松韵微。"],["只履乍来留化迹，","五天何处又逢归。"],["解空弟子绝悲喜，","犹自潸然对雪帏。"]]}
{"id":"145a48beaa","title":"荅同年李昉见赠次韵","author":"邓洵美","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["词场几度让长鞭，","又向清朝贺九迁。","品秩虽然殊此日，","岁寒终不改当年。","驰名早已超三院，","侍直仍忻步八砖。","今日相逢翻自媿，","闲吟对酒倍潸然。"],"stanzas":[["词场几度让长鞭，","又向清朝贺九迁。"],["品秩虽然殊此日，","岁寒终不改当年。"],["驰名早已超三院，","侍直仍忻步八砖。"],["今日相逢翻自媿，","闲吟对酒倍潸然。"]]}
{"id":"73e28d73b0","title":"除夜长安作","author":"李京","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安朔风起，","穷巷掩双扉。","新岁明朝是，","故乡何路归。","鬓丝饶镜色，","隙雪夺灯辉。","却羡秦州雁，","逢春尽北飞。"],"stanzas":[["长安朔风起，","穷巷掩双扉。"],["新岁明朝是，","故乡何路归。"],["鬓丝饶镜色，","隙雪夺灯辉。"],["却羡秦州雁，","逢春尽北飞。"]]}
{"id":"ff4c89f5b3","title":"登岭望","author":"许鼎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["淼淼三江水，","悠悠五岭关。","雁飞犹不度，","人去若为还。"],"stanzas":[["淼淼三江水，","悠悠五岭关。"],["雁飞犹不度，","人去若为还。"]]}
{"id":"345d0d0e52","title":"㟧岭四望","author":"许鼎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉家仙仗在咸阳，","洛水东流出建章。","野老至今犹望辛，","离宫秋树独苍苍。"],"stanzas":[["汉家仙仗在咸阳，","洛水东流出建章。"],["野老至今犹望辛，","离宫秋树独苍苍。"]]}
{"id":"533cf3c162","title":"官左拾遗归隐作","author":"王易简","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汨没朝班媿不才，","谁能低折向尘埃。","青山得去且归去，","官职有来还自来。"],"stanzas":[["汨没朝班媿不才，","谁能低折向尘埃。"],["青山得去且归去，","官职有来还自来。"]]}
{"id":"5cbc1df5e2","title":"悼杨氏妓琴弦","author":"朱褒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魂归寥廊魄归泉，","只住人间十五年。","昨日施僧裙带上，","断肠犹系琵琶弦。"],"stanzas":[["魂归寥廊魄归泉，","只住人间十五年。"],["昨日施僧裙带上，","断肠犹系琵琶弦。"]]}
{"id":"51d0277123","title":"公子行","author":"黄损","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春草绿绵绵，","骄骖骤煖烟。","微风飘乐韵，","半日醉花边。","打鹊抛金盏，","招人举玉鞭。","田翁与蚕妇，","平地看神仙。"],"stanzas":[["春草绿绵绵，","骄骖骤煖烟。"],["微风飘乐韵，","半日醉花边。"],["打鹊抛金盏，","招人举玉鞭。"],["田翁与蚕妇，","平地看神仙。"]]}
{"id":"6a2161d9df","title":"读史","author":"黄损","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["逐鹿走红尘，","炎炎火德新。","家肥生孝子，","国霸有余臣。","帝道云龙合，","民心草木春。","须知烟阁上，","一半老儒真。"],"stanzas":[["逐鹿走红尘，","炎炎火德新。"],["家肥生孝子，","国霸有余臣。"],["帝道云龙合，","民心草木春。"],["须知烟阁上，","一半老儒真。"]]}
{"id":"3c850ef11a","title":"出山吟","author":"黄损","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["来书初出白云扃，","乍蹑秋风马走轻。","远近留连分岳色，","别离呜咽乱泉声。","休将巢许争喧杂，","自共伊臯论太平。","昨夜细看云色里，","进贤星座甚分明。"],"stanzas":[["来书初出白云扃，","乍蹑秋风马走轻。"],["远近留连分岳色，","别离呜咽乱泉声。"],["休将巢许争喧杂，","自共伊臯论太平。"],["昨夜细看云色里，","进贤星座甚分明。"]]}
{"id":"ab07c93d69","title":"书壁","author":"黄损","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一别人间岁月多，","归来人事已销磨。","惟有门前鉴池水，","春风不改旧时波。"],"stanzas":[["一别人间岁月多，","归来人事已销磨。"],["惟有门前鉴池水，","春风不改旧时波。"]]}
{"id":"4ff07a56ea","title":"句","author":"黄损","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["机关才运动，","胜败便相随。","忽遇南迁客，","若为西入心。","往来三岛近，","活计一囊空。","三通明主诏，","一片白云心。","扫地待明月，","踏花迎野僧。","水谙彭泽阔，","山忆武陵深。","金镫冷光风宛转，","锦袍红润雨霏微。","高齐日月方为道，","动合乾坤始是心。","傍水野禽通体白，","饤盘山菓半边红。","而今世上多离别，","莫向相思树下啼。"],"stanzas":[["机关才运动，","胜败便相随。"],["忽遇南迁客，","若为西入心。"],["往来三岛近，","活计一囊空。"],["三通明主诏，","一片白云心。"],["扫地待明月，","踏花迎野僧。"],["水谙彭泽阔，","山忆武陵深。"],["金镫冷光风宛转，","锦袍红润雨霏微。"],["高齐日月方为道，","动合乾坤始是心。"],["傍水野禽通体白，","饤盘山菓半边红。"],["而今世上多离别，","莫向相思树下啼。"]]}
{"id":"a3769e4b42","title":"梁郊祀乐章 庆肃","author":"张衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["笾豆簠簋，","黍稷非馨。","懿兹彝器，","厥德惟明。","金石匏革，","以和以平。","由此无疆，","期乎永宁。"],"stanzas":[["笾豆簠簋，","黍稷非馨。"],["懿兹彝器，","厥德惟明。"],["金石匏革，","以和以平。"],["由此无疆，","期乎永宁。"]]}
{"id":"1ef481af72","title":"梁郊祀乐章 庆熙","author":"张衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["哲后躬享，","旨酒斯陈。","王恭无斁，","严祀惟寅。","皇祖以配，","大孝以振。","宜锡景福，","永休下民。"],"stanzas":[["哲后躬享，","旨酒斯陈。"],["王恭无斁，","严祀惟寅。"],["皇祖以配，","大孝以振。"],["宜锡景福，","永休下民。"]]}
{"id":"3240a8a07e","title":"梁郊祀乐章 庆隆","author":"张衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恭祀上帝，","于国之阳。","爵醴是荷，","鸿基永昌。"],"stanzas":[["恭祀上帝，","于国之阳。"],["爵醴是荷，","鸿基永昌。"]]}
{"id":"70d34effd9","title":"梁郊祀乐章 庆融","author":"张衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["导和气兮袭氤氲，","宣皇使兮彰圣神。","服遐裔兮敷质文，","格苗扈兮息烟尘。"],"stanzas":[["导和气兮袭氤氲，","宣皇使兮彰圣神。"],["服遐裔兮敷质文，","格苗扈兮息烟尘。"]]}
{"id":"d7d664ae9d","title":"梁郊祀乐章 庆休","author":"张衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大业来四夷，","仁风和万国。","白日体无私，","皇天辅有德。","七旬罪已服，","六旬师方克。","伟哉帝道隆，","终始常作则。"],"stanzas":[["大业来四夷，","仁风和万国。"],["白日体无私，","皇天辅有德。"],["七旬罪已服，","六旬师方克。"],["伟哉帝道隆，","终始常作则。"]]}
{"id":"1b3de92c92","title":"梁郊祀乐章 庆和","author":"张衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟燎升，","礼容彻。","诚感达，","人神悦。","灵贶彰，","圣情结。","玉座寂，","金罏歇。"],"stanzas":[["烟燎升，","礼容彻。"],["诚感达，","人神悦。"],["灵贶彰，","圣情结。"],["玉座寂，","金罏歇。"]]}
{"id":"631a83317c","title":"梁郊祀乐章 庆和 一","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["就阳位，","升圜丘。","佩双玉，","御大裘。","膺天命，","拥神休。","万灵感，","百禄遒。"],"stanzas":[["就阳位，","升圜丘。"],["佩双玉，","御大裘。"],["膺天命，","拥神休。"],["万灵感，","百禄遒。"]]}
{"id":"cfb75df2fe","title":"梁郊祀乐章 庆和 二","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秉黄钺，","建朱旗。","震八表，","清二仪。","帝业显，","王道夷。","受景命，","启皇基。"],"stanzas":[["秉黄钺，","建朱旗。"],["震八表，","清二仪。"],["帝业显，","王道夷。"],["受景命，","启皇基。"]]}
{"id":"e60ccc95e5","title":"梁郊祀乐章 庆和 三","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["开九门，","怀百神。","通肸蚃，","接氤氲。","明粢荐，","广乐陈。","奠嘉璧，","燎芳薪。"],"stanzas":[["开九门，","怀百神。"],["通肸蚃，","接氤氲。"],["明粢荐，","广乐陈。"],["奠嘉璧，","燎芳薪。"]]}
{"id":"47017cd17d","title":"梁郊祀乐章 庆和 四","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["膺宝图，","执左契。","德应天，","圣飨帝。","荐表衷，","荷灵惠。","寿万年，","祚百世。"],"stanzas":[["膺宝图，","执左契。"],["德应天，","圣飨帝。"],["荐表衷，","荷灵惠。"],["寿万年，","祚百世。"]]}
{"id":"91a8b432dd","title":"梁郊祀乐章 庆和 五","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惟德动天，","有感必通。","秉兹一德，","禋于六宗。","钦夤宝命，","恭肃礼容。","来顾来享，","永穆皇风。"],"stanzas":[["惟德动天，","有感必通。"],["秉兹一德，","禋于六宗。"],["钦夤宝命，","恭肃礼容。"],["来顾来享，","永穆皇风。"]]}
{"id":"f8f6645885","title":"梁郊祀乐章 庆和 六","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天惟佑德，","辟乃奉天。","交感斯在，","昭事罔愆。","岁功已就，","王道无偏。","于焉报本，","是用告虔。"],"stanzas":[["天惟佑德，","辟乃奉天。"],["交感斯在，","昭事罔愆。"],["岁功已就，","王道无偏。"],["于焉报本，","是用告虔。"]]}
{"id":"8eab25c900","title":"梁郊祀乐章 庆顺","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣皇戾止，","天步舒迟。","干干睿相，","穆穆皇仪。","进退必肃，","陟降是祗。","六变克协，","万灵协随。"],"stanzas":[["圣皇戾止，","天步舒迟。"],["干干睿相，","穆穆皇仪。"],["进退必肃，","陟降是祗。"],["六变克协，","万灵协随。"]]}
{"id":"d98c95d998","title":"梁郊祀乐章 庆平","author":"赵光逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天命降鉴，","帝德惟馨。","享祀不忒，","礼容孔明。","奠璧布币，","荐纯献精。","神祐以荅，","敷锡永宁。"],"stanzas":[["天命降鉴，","帝德惟馨。"],["享祀不忒，","礼容孔明。"],["奠璧布币，","荐纯献精。"],["神祐以荅，","敷锡永宁。"]]}
{"id":"851ea9765d","title":"宫词百首 一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫燎光销大驾归，","御楼初见赭黄衣。","千声鼓定将宣赦，","竿上金鸡翅欲飞。"],"stanzas":[["紫燎光销大驾归，","御楼初见赭黄衣。"],["千声鼓定将宣赦，","竿上金鸡翅欲飞。"]]}
{"id":"bae500322a","title":"宫词百首 二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北阙晴分五凤楼，","嵩山秀色护神州。","洛河自契千年运，","更拟波中出九畴。"],"stanzas":[["北阙晴分五凤楼，","嵩山秀色护神州。"],["洛河自契千年运，","更拟波中出九畴。"]]}
{"id":"bec3a1747e","title":"宫词百首 三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中兴殿上晓光融，","一炷天香舞瑞风。","百辟虔心齐稽首，","卷帘遥见御衣红。"],"stanzas":[["中兴殿上晓光融，","一炷天香舞瑞风。"],["百辟虔心齐稽首，","卷帘遥见御衣红。"]]}
{"id":"147554410d","title":"宫词百首 四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日和风暖御楼时，","万姓齐瞻八彩眉。","瑞气祥烟笼细仗，","合门宣赦四方知。"],"stanzas":[["日和风暖御楼时，","万姓齐瞻八彩眉。"],["瑞气祥烟笼细仗，","合门宣赦四方知。"]]}
{"id":"9bbcaefe16","title":"宫词百首 五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤吹鸾歌晓日明，","丰年观稼出神京。","封人争献南山寿，","五色云中御辇平。"],"stanzas":[["凤吹鸾歌晓日明，","丰年观稼出神京。"],["封人争献南山寿，","五色云中御辇平。"]]}
{"id":"eb74d554e5","title":"宫词百首 六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣主临轩待晓时，","穿花宫漏正迟迟。","鸡人一唱乾坤晓，","百辟分班俨羽仪。"],"stanzas":[["圣主临轩待晓时，","穿花宫漏正迟迟。"],["鸡人一唱乾坤晓，","百辟分班俨羽仪。"]]}
{"id":"2af77a64a3","title":"宫词百首 七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朦胧西月照池亭，","初夜椒房掩画屏。","宫女相呼有何事，","上楼同看老人星。"],"stanzas":[["朦胧西月照池亭，","初夜椒房掩画屏。"],["宫女相呼有何事，","上楼同看老人星。"]]}
{"id":"03e4c52331","title":"宫词百首 八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红泥椒殿缀珠珰，","帐蹙金龙窣地长。","红兽慢然天色暖，","凤炉时复爇沉香。"],"stanzas":[["红泥椒殿缀珠珰，","帐蹙金龙窣地长。"],["红兽慢然天色暖，","凤炉时复爇沉香。"]]}
{"id":"a0c129d2c5","title":"宫词百首 九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九重楼殿簇丹青，","高柳含烟覆井亭。","宫内不知今日几，","自来阶下数尧蓂。"],"stanzas":[["九重楼殿簇丹青，","高柳含烟覆井亭。"],["宫内不知今日几，","自来阶下数尧蓂。"]]}
{"id":"4c6fa5299a","title":"宫词百首 十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寝殿香浓玉漏严，","云随凉月下西南。","帐前宫女低声道，","主上还应梦傅岩。"],"stanzas":[["寝殿香浓玉漏严，","云随凉月下西南。"],["帐前宫女低声道，","主上还应梦傅岩。"]]}
{"id":"3a7d649277","title":"宫词百首 十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绕殿钩栏压玉阶，","内人轻语凭葱苔。","皆言明主垂衣理，","不假朱云傍槛来。"],"stanzas":[["绕殿钩栏压玉阶，","内人轻语凭葱苔。"],["皆言明主垂衣理，","不假朱云傍槛来。"]]}
{"id":"4e75ac24b7","title":"宫词百首 十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["颟顸冰面莹池心，","风刮瑶阶腊雪深。","怪得宫中无兽炭，","步摇钗是辟寒金。"],"stanzas":[["颟顸冰面莹池心，","风刮瑶阶腊雪深。"],["怪得宫中无兽炭，","步摇钗是辟寒金。"]]}
{"id":"118c7f02cf","title":"宫词百首 十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兰殿春融自靘笙，","玉颜风透象纱明。","金簧如语莺声滑，","可使云和独得名。"],"stanzas":[["兰殿春融自靘笙，","玉颜风透象纱明。"],["金簧如语莺声滑，","可使云和独得名。"]]}
{"id":"c8e9bd1e7f","title":"宫词百首 十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兰烛时将凤髓添，","寒星遥映夜光帘。","龙楼露著鸳鸯瓦，","谁近螭头掷玉签。"],"stanzas":[["兰烛时将凤髓添，","寒星遥映夜光帘。"],["龙楼露著鸳鸯瓦，","谁近螭头掷玉签。"]]}
{"id":"7344d660ca","title":"宫词百首 十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉甃莲池春水平，","小鱼双竝锦鳞行。","内中知是黄河样，","九曲今年彻底清。"],"stanzas":[["玉甃莲池春水平，","小鱼双竝锦鳞行。"],["内中知是黄河样，","九曲今年彻底清。"]]}
{"id":"f95ebdcda0","title":"宫词百首 十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["真珠帘外静无尘，","耿耿凉天景象新。","金殿夜深银烛晃，","宫嫔来奏月重轮。"],"stanzas":[["真珠帘外静无尘，","耿耿凉天景象新。"],["金殿夜深银烛晃，","宫嫔来奏月重轮。"]]}
{"id":"b6d5b4a2d8","title":"宫词百首 十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼犀月掌夜通头，","自著盘莺锦臂鞲。","多把沈檀配龙麝，","宫中掌浸十香油。"],"stanzas":[["鱼犀月掌夜通头，","自著盘莺锦臂鞲。"],["多把沈檀配龙麝，","宫中掌浸十香油。"]]}
{"id":"bc0283bc83","title":"宫词百首 十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["香云双飐玉蝉轻，","侍从君王苑里行。","嘉瑞忽逢连理木，","一时跪拜贺文明。"],"stanzas":[["香云双飐玉蝉轻，","侍从君王苑里行。"],["嘉瑞忽逢连理木，","一时跪拜贺文明。"]]}
{"id":"1d4650d52d","title":"宫词百首 十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金鸾双立紫檀槽，","暖殿无风韵自高。","含笑试弹红蘂调，","君王宣赐酪樱桃。"],"stanzas":[["金鸾双立紫檀槽，","暖殿无风韵自高。"],["含笑试弹红蘂调，","君王宣赐酪樱桃。"]]}
{"id":"d9922be5ec","title":"宫词百首 二十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斑簟如霞可殿铺，","更开新进瑞莲图。","谁人筑损珊瑚架，","子细看时认沥苏。"],"stanzas":[["斑簟如霞可殿铺，","更开新进瑞莲图。"],["谁人筑损珊瑚架，","子细看时认沥苏。"]]}
{"id":"ed03cb185c","title":"宫词百首 二十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金盆初晓洗纤纤，","银鸭香焦特地添。","出户忽看春雪下，","六宫齐卷水晶帘。"],"stanzas":[["金盆初晓洗纤纤，","银鸭香焦特地添。"],["出户忽看春雪下，","六宫齐卷水晶帘。"]]}
{"id":"956c3876d7","title":"宫词百首 二十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖金盘里点酥山，","拟望君王子细看。","更向眉中分晓黛，","岩边染出碧琅玕。"],"stanzas":[["暖金盘里点酥山，","拟望君王子细看。"],["更向眉中分晓黛，","岩边染出碧琅玕。"]]}
{"id":"ee85eaeae2","title":"宫词百首 二十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云母屏前绣柱衣，","龙床闲卷谏书帏。","黄金槛外螭头活，","日照红兰露未晞。"],"stanzas":[["云母屏前绣柱衣，","龙床闲卷谏书帏。"],["黄金槛外螭头活，","日照红兰露未晞。"]]}
{"id":"f8b2f3d2ab","title":"宫词百首 二十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼西残月尚胧明，","中禁鸡人报晓声。","清旦司天台进状，","夜来晴霁泰阶平。"],"stanzas":[["楼西残月尚胧明，","中禁鸡人报晓声。"],["清旦司天台进状，","夜来晴霁泰阶平。"]]}
{"id":"0073acf32d","title":"宫词百首 二十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["纤辔摩轩响佩环，","银台门外集鸳鸾。","三钟五鼓祥烟歛，","日照仙人捧露盘。"],"stanzas":[["纤辔摩轩响佩环，","银台门外集鸳鸾。"],["三钟五鼓祥烟歛，","日照仙人捧露盘。"]]}
{"id":"8f74a02a91","title":"宫词百首 二十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["司膳厨中也禁烟，","春宫相对画秋千。","清明节日颁新火，","蜡炬星飞下九天。"],"stanzas":[["司膳厨中也禁烟，","春宫相对画秋千。"],["清明节日颁新火，","蜡炬星飞下九天。"]]}
{"id":"5b98e0251d","title":"宫词百首 二十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫木交芳色尽深，","和风轻舞早莺吟。","侍臣不异东方朔，","应喜仙桃满禁林。"],"stanzas":[["宫木交芳色尽深，","和风轻舞早莺吟。"],["侍臣不异东方朔，","应喜仙桃满禁林。"]]}
{"id":"84e2c70bd2","title":"宫词百首 二十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贡橘香匀䩋𩉙容，","星光初满小金笼。","近臣押赐诸王宅，","拜了方开敕字封。"],"stanzas":[["贡橘香匀䩋𩉙容，","星光初满小金笼。"],["近臣押赐诸王宅，","拜了方开敕字封。"]]}
{"id":"6ad2f9df61","title":"宫词百首 二十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["献寿朝元欲偃戈，","航深梯险竞骈罗。","若论万国来朝日，","比竝涂山更较多。"],"stanzas":[["献寿朝元欲偃戈，","航深梯险竞骈罗。"],["若论万国来朝日，","比竝涂山更较多。"]]}
{"id":"006073370e","title":"宫词百首 三十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["艳阳风景簇神州，","杏蘂桃心照凤楼。","遥望青青河畔草，","几多归马与休牛。"],"stanzas":[["艳阳风景簇神州，","杏蘂桃心照凤楼。"],["遥望青青河畔草，","几多归马与休牛。"]]}
{"id":"44884d8e7c","title":"宫词百首 三十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["銮舆观稼晚方归，","日月旗中见御衣。","万姓焚香惟顶礼，","瑞雪随繖入宫闱。"],"stanzas":[["銮舆观稼晚方归，","日月旗中见御衣。"],["万姓焚香惟顶礼，","瑞雪随繖入宫闱。"]]}
{"id":"0d1b135766","title":"宫词百首 三十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫庭皆应紫微垣，","壮丽宸居显至尊。","赤子颙颙瞻父母，","已将仁德比乾坤。"],"stanzas":[["宫庭皆应紫微垣，","壮丽宸居显至尊。"],["赤子颙颙瞻父母，","已将仁德比乾坤。"]]}
{"id":"1fd8e60c91","title":"宫词百首 三十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三农皆已辟田畴，","又见金门出土牛。","块雨条风符圣化，","嘉禾看却报新秋。"],"stanzas":[["三农皆已辟田畴，","又见金门出土牛。"],["块雨条风符圣化，","嘉禾看却报新秋。"]]}
{"id":"2d1c8815e6","title":"宫词百首 三十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["进食门前水陆陈，","大官斋洁贡时新。","明君宵旰分甘处，","便索金盘赐重臣。"],"stanzas":[["进食门前水陆陈，","大官斋洁贡时新。"],["明君宵旰分甘处，","便索金盘赐重臣。"]]}
{"id":"6815691eb0","title":"宫词百首 三十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["层台金碧惹红霞，","仙掌亭亭对月华。","昨夜盘中甘露满，","婕妤争去奏官家。"],"stanzas":[["层台金碧惹红霞，","仙掌亭亭对月华。"],["昨夜盘中甘露满，","婕妤争去奏官家。"]]}
{"id":"7c56d84ef3","title":"宫词百首 三十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水殿垂帘冷色凝，","一床珍簟展春冰。","才人侍立持团扇，","金缕双龙贴碧藤。"],"stanzas":[["水殿垂帘冷色凝，","一床珍簟展春冰。"],["才人侍立持团扇，","金缕双龙贴碧藤。"]]}
{"id":"8634fdd5db","title":"宫词百首 三十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["香鸭烟轻爇水沈，","云鬟闲坠凤犀簪。","珠帘半卷开花雨，","又见芭蕉展半心。"],"stanzas":[["香鸭烟轻爇水沈，","云鬟闲坠凤犀簪。"],["珠帘半卷开花雨，","又见芭蕉展半心。"]]}
{"id":"a1eedcdbe2","title":"宫词百首 三十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莺锦蝉罗撒麝脐，","狻猊轻喷瑞烟迷。","红酥点得香山小，","卷上珠帘日未西。"],"stanzas":[["莺锦蝉罗撒麝脐，","狻猊轻喷瑞烟迷。"],["红酥点得香山小，","卷上珠帘日未西。"]]}
{"id":"cf8a99cc60","title":"宫词百首 三十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦褥花明满殿铺，","宫娥分坐学樗蒲。","欲教官马冲关过，","呪愿纤纤早掷卢。"],"stanzas":[["锦褥花明满殿铺，","宫娥分坐学樗蒲。"],["欲教官马冲关过，","呪愿纤纤早掷卢。"]]}
{"id":"0df1a19ff1","title":"宫词百首 四十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小楼花簇钿山低，","金雉双来蹋马齐。","夸向傍人能彩戏，","朝来赢得鹭鸶犀。"],"stanzas":[["小楼花簇钿山低，","金雉双来蹋马齐。"],["夸向傍人能彩戏，","朝来赢得鹭鸶犀。"]]}
{"id":"f3e49c27b1","title":"宫词百首 四十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红鬃白马嫩龙飞，","天廐供来入紫微。","遥见玉阶嘶不已，","应缘识得赭黄衣。"],"stanzas":[["红鬃白马嫩龙飞，","天廐供来入紫微。"],["遥见玉阶嘶不已，","应缘识得赭黄衣。"]]}
{"id":"58ebeba7e0","title":"宫词百首 四十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["班定千牛立受宣，","佩刀搢笏凤墀前。","一声不坐祥云合，","鸳鹭依行拜两边。"],"stanzas":[["班定千牛立受宣，","佩刀搢笏凤墀前。"],["一声不坐祥云合，","鸳鹭依行拜两边。"]]}
{"id":"3e08b1c3ea","title":"宫词百首 四十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三殿香浓晓色来，","祥鸾威凤待门开。","锵金佩玉趋丹陛，","总是和羹作砺才。"],"stanzas":[["三殿香浓晓色来，","祥鸾威凤待门开。"],["锵金佩玉趋丹陛，","总是和羹作砺才。"]]}
{"id":"01ba2126ba","title":"宫词百首 四十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两番供奉打毬时，","鸾凤分厢锦绣衣。","虎骤龙腾宫殿响，","骅骝争趂一星飞。"],"stanzas":[["两番供奉打毬时，","鸾凤分厢锦绣衣。"],["虎骤龙腾宫殿响，","骅骝争趂一星飞。"]]}
{"id":"5e260c423d","title":"宫词百首 四十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤池冰泮岸莎匀，","柳眼花心雪里新。","都是九重和暖地，","东风先报禁园春。"],"stanzas":[["凤池冰泮岸莎匀，","柳眼花心雪里新。"],["都是九重和暖地，","东风先报禁园春。"]]}
{"id":"198694ddc7","title":"宫词百首 四十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫气氤氲满帝都，","映楼明月锁金铺。","银泥殿里嫌红烛，","教近龙床著火珠。"],"stanzas":[["紫气氤氲满帝都，","映楼明月锁金铺。"],["银泥殿里嫌红烛，","教近龙床著火珠。"]]}
{"id":"a90647ac16","title":"宫词百首 四十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地衣初展瑞霞融，","绣帽金铃舞舜风。","吹竹弹丝珠殿响，","坠仙双降五云中。"],"stanzas":[["地衣初展瑞霞融，","绣帽金铃舞舜风。"],["吹竹弹丝珠殿响，","坠仙双降五云中。"]]}
{"id":"8b0efcb213","title":"宫词百首 四十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦策匀铺寒玉齐，","星锤高运日通犀。","铿金曲罢春冰碎，","跪拜君王粉面低。"],"stanzas":[["锦策匀铺寒玉齐，","星锤高运日通犀。"],["铿金曲罢春冰碎，","跪拜君王粉面低。"]]}
{"id":"0f31ab7218","title":"宫词百首 四十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珠帘静卷水亭凉，","玉蘂风飘小槛香。","几处按歌齐入破，","双双雏燕出宫墙。"],"stanzas":[["珠帘静卷水亭凉，","玉蘂风飘小槛香。"],["几处按歌齐入破，","双双雏燕出宫墙。"]]}
{"id":"470de07e15","title":"宫词百首 五十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫娥解禊艳阳时，","鹢舸兰桡满凤池。","春水如蓝垂柳醉，","和风无力褭金丝。"],"stanzas":[["宫娥解禊艳阳时，","鹢舸兰桡满凤池。"],["春水如蓝垂柳醉，","和风无力褭金丝。"]]}
{"id":"c603b8ceeb","title":"宫词百首 五十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白玉阶前菊蘂香，","金杯仙酝赏重阳。","层台云集梨园乐，","献寿声声祝万康。"],"stanzas":[["白玉阶前菊蘂香，","金杯仙酝赏重阳。"],["层台云集梨园乐，","献寿声声祝万康。"]]}
{"id":"0e4265712f","title":"宫词百首 五十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天籁吟风社燕归，","渚莲香老碧苔肥。","夜来霜坠梧桐叶，","诸殿平明进御衣。"],"stanzas":[["天籁吟风社燕归，","渚莲香老碧苔肥。"],["夜来霜坠梧桐叶，","诸殿平明进御衣。"]]}
{"id":"eec8d4e419","title":"宫词百首 五十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["𬬻爇香檀兽炭痴，","真珠帘外雪花飞。","六宫进酒尧眉寿，","舞凤盘龙满御衣。"],"stanzas":[["𬬻爇香檀兽炭痴，","真珠帘外雪花飞。"],["六宫进酒尧眉寿，","舞凤盘龙满御衣。"]]}
{"id":"ee0fa35977","title":"宫词百首 五十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云行风静早秋天，","竞绕盆池蹋采莲。","罨画披袍从窣地，","更寻宫柳看鸣蝉。"],"stanzas":[["云行风静早秋天，","竞绕盆池蹋采莲。"],["罨画披袍从窣地，","更寻宫柳看鸣蝉。"]]}
{"id":"7d2249231a","title":"宫词百首 五十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阑珊星斗缀珠光，","七夕宫嫔乞巧忙。","总上穿针楼上去，","竞看银汉洒琼桨。"],"stanzas":[["阑珊星斗缀珠光，","七夕宫嫔乞巧忙。"],["总上穿针楼上去，","竞看银汉洒琼桨。"]]}
{"id":"0f6d46523f","title":"宫词百首 五十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝瑟凄锵夜漏余，","玉阶闲作对蟾蜍。","秋光寂历银河转，","已见宫花露滴疎。"],"stanzas":[["宝瑟凄锵夜漏余，","玉阶闲作对蟾蜍。"],["秋光寂历银河转，","已见宫花露滴疎。"]]}
{"id":"1a22431d09","title":"宫词百首 五十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风金褭万年枝，","簇白团红烂熳时。","宫女竞思游御苑，","大家齐奏圣人知。"],"stanzas":[["春风金褭万年枝，","簇白团红烂熳时。"],["宫女竞思游御苑，","大家齐奏圣人知。"]]}
{"id":"039db942b7","title":"宫词百首 五十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["干文初见泰阶平，","日月常遵阁道行。","昨夜仰观垂象正，","拱辰星宿转分明。"],"stanzas":[["干文初见泰阶平，","日月常遵阁道行。"],["昨夜仰观垂象正，","拱辰星宿转分明。"]]}
{"id":"4fea9d4286","title":"宫词百首 五十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锵锵济济赴延英，","渐近重瞳目转明。","君圣臣贤鱼水契，","鸿基须贺永清平。"],"stanzas":[["锵锵济济赴延英，","渐近重瞳目转明。"],["君圣臣贤鱼水契，","鸿基须贺永清平。"]]}
{"id":"dd7ed877cc","title":"宫词百首 六十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天廐骖𬴂集嫩龙，","雪光相照晓嘶风。","昂头步步金鞍稳，","掌扇花前御路中。"],"stanzas":[["天廐骖𬴂集嫩龙，","雪光相照晓嘶风。"],["昂头步步金鞍稳，","掌扇花前御路中。"]]}
{"id":"a87d7c7f5d","title":"宫词百首 六十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金吾细仗俨威仪，","圣旨凝旒对远夷。","晓日曈昽瞻玉案，","丁冬环珮满彤墀。"],"stanzas":[["金吾细仗俨威仪，","圣旨凝旒对远夷。"],["晓日曈昽瞻玉案，","丁冬环珮满彤墀。"]]}
{"id":"537a3b1de7","title":"宫词百首 六十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正旦垂旒御八方，","蛮夷无不奉梯航。","群臣舞蹈称觞处，","雷动山呼万岁长。"],"stanzas":[["正旦垂旒御八方，","蛮夷无不奉梯航。"],["群臣舞蹈称觞处，","雷动山呼万岁长。"]]}
{"id":"1e0776a01f","title":"宫词百首 六十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣主躬耕在籍田，","公卿环卫待丰年。","五风十雨余粮在，","金殿惟闻奏舜弦。"],"stanzas":[["圣主躬耕在籍田，","公卿环卫待丰年。"],["五风十雨余粮在，","金殿惟闻奏舜弦。"]]}
{"id":"d1766d6e79","title":"宫词百首 六十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣日垂科委所司，","英才咸喜遇明时。","春宫进榜莺离谷，","月殿香残桂魄枝。"],"stanzas":[["圣日垂科委所司，","英才咸喜遇明时。"],["春宫进榜莺离谷，","月殿香残桂魄枝。"]]}
{"id":"c5917e3630","title":"宫词百首 六十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天街香满瑞云生，","红繖凝空景日明。","先遣五坊排猎骑，","为民除害出神京。"],"stanzas":[["天街香满瑞云生，","红繖凝空景日明。"],["先遣五坊排猎骑，","为民除害出神京。"]]}
{"id":"ce9ecf5511","title":"宫词百首 六十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内宴初开锦绣攒，","教坊齐奏万年欢。","箫韶响亮春云合，","日照尧阶舞瑞鸾。"],"stanzas":[["内宴初开锦绣攒，","教坊齐奏万年欢。"],["箫韶响亮春云合，","日照尧阶舞瑞鸾。"]]}
{"id":"cab1e6c0e2","title":"宫词百首 六十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["视草词臣直玉堂，","对来新赐锦袍香。","班资最在云霄上，","长是先迎日月光。"],"stanzas":[["视草词臣直玉堂，","对来新赐锦袍香。"],["班资最在云霄上，","长是先迎日月光。"]]}
{"id":"e5e0ddc42d","title":"宫词百首 六十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉殿朦胧散晓光，","金龙高喷九天香。","摵鞭声定初开扇，","百辟齐呼万岁长。"],"stanzas":[["玉殿朦胧散晓光，","金龙高喷九天香。"],["摵鞭声定初开扇，","百辟齐呼万岁长。"]]}
{"id":"40f3ebcd91","title":"宫词百首 六十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五色卿云复九重，","香烟高舞御𬬻中。","含元殿里行仁德，","四海车书已混同。"],"stanzas":[["五色卿云复九重，","香烟高舞御𬬻中。"],["含元殿里行仁德，","四海车书已混同。"]]}
{"id":"730cdebc56","title":"宫词百首 七十","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲封丹诏紫泥香，","朱篆龙文御印光。","汗涣丝纶出丹禁，","便从天上凤衔将。"],"stanzas":[["欲封丹诏紫泥香，","朱篆龙文御印光。"],["汗涣丝纶出丹禁，","便从天上凤衔将。"]]}
{"id":"8f6e4db87a","title":"宫词百首 七十一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越溪姝丽入深宫，","俭素皆持马后风。","尽道君王修圣德，","不劳辞辇与当熊。"],"stanzas":[["越溪姝丽入深宫，","俭素皆持马后风。"],["尽道君王修圣德，","不劳辞辇与当熊。"]]}
{"id":"0024bd7239","title":"宫词百首 七十二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早梅初向雪中明，","风惹奇香粉蘂轻。","谁道落花堪靧面，","竞来枝上采繁英。"],"stanzas":[["早梅初向雪中明，","风惹奇香粉蘂轻。"],["谁道落花堪靧面，","竞来枝上采繁英。"]]}
{"id":"35e21161e1","title":"宫词百首 七十三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖殿奇香馥绮罗，","窗间初学绣金鹅。","才经冬至阳生后，","今日工夫一线多。"],"stanzas":[["暖殿奇香馥绮罗，","窗间初学绣金鹅。"],["才经冬至阳生后，","今日工夫一线多。"]]}
{"id":"a7501e0a9c","title":"宫词百首 七十四","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金井澄泉玉液香，","瑠璃深殿自清凉。","温汤头进瓜初熟，","后至宫嫔未得尝。"],"stanzas":[["金井澄泉玉液香，","瑠璃深殿自清凉。"],["温汤头进瓜初熟，","后至宫嫔未得尝。"]]}
{"id":"0550b9bd43","title":"宫词百首 七十五","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绣闼雕甍列锦闺，","珍奇惟待凤凰栖。","杏梁烜赫晴霞展，","时见空虚坠燕泥。"],"stanzas":[["绣闼雕甍列锦闺，","珍奇惟待凤凰栖。"],["杏梁烜赫晴霞展，","时见空虚坠燕泥。"]]}
{"id":"2a57aaa6e9","title":"宫词百首 七十六","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙凤金鞍软玉缏，","雪花光照锦连干。","驾头直指西郊去，","晓日寒生讲武天。"],"stanzas":[["龙凤金鞍软玉缏，","雪花光照锦连干。"],["驾头直指西郊去，","晓日寒生讲武天。"]]}
{"id":"89769f3130","title":"宫词百首 七十七","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戛云楼上定风盘，","雀跃猨跳总不难。","要对君王逞轻捷，","御楼时拟上鸡竿。"],"stanzas":[["戛云楼上定风盘，","雀跃猨跳总不难。"],["要对君王逞轻捷，","御楼时拟上鸡竿。"]]}
{"id":"22cd1e846b","title":"宫词百首 七十八","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["停稳春衫窣地长，","通天犀带缀金章。","近臣衔命离丹禁，","高捧恩波洒万方。"],"stanzas":[["停稳春衫窣地长，","通天犀带缀金章。"],["近臣衔命离丹禁，","高捧恩波洒万方。"]]}
{"id":"e4f6934639","title":"宫词百首 七十九","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["垂黎玉押春帘卷，","不夜珠楼晓鉴开。","袍袴宫人走迎驾，","东风吹送御香来。"],"stanzas":[["垂黎玉押春帘卷，","不夜珠楼晓鉴开。"],["袍袴宫人走迎驾，","东风吹送御香来。"]]}
