{"id":"d16746c781","title":"郑生诗","author":"湘中蛟女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["情无垠兮水汤汤，","怀佳期兮属三湘。"],"stanzas":[["情无垠兮水汤汤，","怀佳期兮属三湘。"]]}
{"id":"a65f2c26a7","title":"感怀诗","author":"龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海门连洞庭，","每去三千里。","十载一归来，","辛苦潇湘水。"],"stanzas":[["海门连洞庭，","每去三千里。"],["十载一归来，","辛苦潇湘水。"]]}
{"id":"1369b3c488","title":"寄张无颇 一","author":"广利王女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["羞解明珰寻汉渚，","但凭春梦访天涯。","红楼日暮莺飞去，","愁杀深宫落砌花。"],"stanzas":[["羞解明珰寻汉渚，","但凭春梦访天涯。"],["红楼日暮莺飞去，","愁杀深宫落砌花。"]]}
{"id":"81e8b3a90b","title":"寄张无颇 二","author":"广利王女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕语春泥堕锦筵，","情愁无意整花钿。","寒闺欹枕不成梦，","香炷金炉自褭烟。"],"stanzas":[["燕语春泥堕锦筵，","情愁无意整花钿。"],["寒闺欹枕不成梦，","香炷金炉自褭烟。"]]}
{"id":"77c1cefe58","title":"与崔渥冥会杂诗 一","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里同心别九重，","定知涉历此相逢。","谁人翻向群峰路，","不得苍梧徇玉容。"],"stanzas":[["万里同心别九重，","定知涉历此相逢。"],["谁人翻向群峰路，","不得苍梧徇玉容。"]]}
{"id":"394fcf484f","title":"与崔渥冥会杂诗 二","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春鸟交交引思浓，","岂期尘迹拜仙宫。","鸾歌凤舞飘珠翠，","疑是阳台一梦中。"],"stanzas":[["春鸟交交引思浓，","岂期尘迹拜仙宫。"],["鸾歌凤舞飘珠翠，","疑是阳台一梦中。"]]}
{"id":"81728074bb","title":"与崔渥冥会杂诗 三","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸾舆昔日出蒲关，","一去苍梧更不还。","若是不留千古恨，","湘江何事竹犹斑。"],"stanzas":[["鸾舆昔日出蒲关，","一去苍梧更不还。"],["若是不留千古恨，","湘江何事竹犹斑。"]]}
{"id":"a0faddd3e3","title":"与崔渥冥会杂诗 四","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁闻黄鸟夜关关，","沩汭春来有梦还。","遗美代移刊勒绝，","唯闻留得泪痕斑。"],"stanzas":[["愁闻黄鸟夜关关，","沩汭春来有梦还。"],["遗美代移刊勒绝，","唯闻留得泪痕斑。"]]}
{"id":"983132c711","title":"与崔渥冥会杂诗 五","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["方承恩宠醉金杯，","岂为干戈骤到来。","亡国破家皆有恨，","捧心无语泪苏台。"],"stanzas":[["方承恩宠醉金杯，","岂为干戈骤到来。"],["亡国破家皆有恨，","捧心无语泪苏台。"]]}
{"id":"6545f5125a","title":"与崔渥冥会杂诗 六","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桃花流水两堪伤，","洞口烟波月渐长。","莫道仙家无别恨，","至今垂泪忆刘郎。"],"stanzas":[["桃花流水两堪伤，","洞口烟波月渐长。"],["莫道仙家无别恨，","至今垂泪忆刘郎。"]]}
{"id":"b25c7cd758","title":"与崔渥冥会杂诗 七","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泾阳平野草初春，","遥望家乡泪滴频。","当此不知多少恨，","至今空忆在灵姻。"],"stanzas":[["泾阳平野草初春，","遥望家乡泪滴频。"],["当此不知多少恨，","至今空忆在灵姻。"]]}
{"id":"c1faed3776","title":"与崔渥冥会杂诗 八","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["目断魂销正惘然，","九疑山际路漫漫。","何人知得心中恨，","空有湘江竹万竿。"],"stanzas":[["目断魂销正惘然，","九疑山际路漫漫。"],["何人知得心中恨，","空有湘江竹万竿。"]]}
{"id":"6626ea0103","title":"与崔渥冥会杂诗 九","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["常说仙家事不同，","偶陪花月此宵中。","锦屏银烛皆堪恨，","惆怅纱窗向晓风。"],"stanzas":[["常说仙家事不同，","偶陪花月此宵中。"],["锦屏银烛皆堪恨，","惆怅纱窗向晓风。"]]}
{"id":"765d90a092","title":"又湘妃诗四首 一","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渺渺三湘万里程，","泪篁幽石助芳贞。","孤云目断苍梧野，","不得攀龙到玉京。"],"stanzas":[["渺渺三湘万里程，","泪篁幽石助芳贞。"],["孤云目断苍梧野，","不得攀龙到玉京。"]]}
{"id":"5fc32f6890","title":"又湘妃诗四首 二","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧杜红蘅缥渺香，","冰丝弹月弄清凉。","峰峦一一俱相似，","九处堪疑九断肠。"],"stanzas":[["碧杜红蘅缥渺香，","冰丝弹月弄清凉。"],["峰峦一一俱相似，","九处堪疑九断肠。"]]}
{"id":"b21e9f6ee1","title":"又湘妃诗四首 三","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉辇金根去不回，","湘川秋晚楚弦哀。","自从泣尽江蓠血，","夜夜愁风怨雨来。"],"stanzas":[["玉辇金根去不回，","湘川秋晚楚弦哀。"],["自从泣尽江蓠血，","夜夜愁风怨雨来。"]]}
{"id":"ec5454d8f6","title":"又湘妃诗四首 四","author":"湘妃庙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少将风月怨平湖，","见尽扶桑水到枯。","相约杏花坛上去，","画阑红子鬬摴蒲。"],"stanzas":[["少将风月怨平湖，","见尽扶桑水到枯。"],["相约杏花坛上去，","画阑红子鬬摴蒲。"]]}
{"id":"5e743ffa24","title":"与何光远赠荅诗 一","author":"明月潭龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["簷上簷前燕语新，","花开柳发自伤神。","谁能将我相思意，","说与江隈解佩人。"],"stanzas":[["簷上簷前燕语新，","花开柳发自伤神。"],["谁能将我相思意，","说与江隈解佩人。"]]}
{"id":"6ea1e8f9cd","title":"与何光远赠荅诗 二","author":"明月潭龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坐久风吹绿绮寒，","九天月照水精盘。","不思却返沈潜去，","为惜春光一夜欢。"],"stanzas":[["坐久风吹绿绮寒，","九天月照水精盘。"],["不思却返沈潜去，","为惜春光一夜欢。"]]}
{"id":"7d4f0482c7","title":"与何光远赠荅诗 三","author":"明月潭龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["澹荡春光物象饶，","一枝琼艳不胜娇。","若能许解相思佩，","何羡星天渡鹊桥。"],"stanzas":[["澹荡春光物象饶，","一枝琼艳不胜娇。"],["若能许解相思佩，","何羡星天渡鹊桥。"]]}
{"id":"53e68aa1d0","title":"与何光远赠荅诗 四","author":"明月潭龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉漏涓涓银汉清，","鹊桥新架路初成。","催妆既要裁篇咏，","凤吹鸾歌早会迎。"],"stanzas":[["玉漏涓涓银汉清，","鹊桥新架路初成。"],["催妆既要裁篇咏，","凤吹鸾歌早会迎。"]]}
{"id":"8319a8a9e4","title":"与何光远赠荅诗 五","author":"明月潭龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝车辗驻彩云开，","误到蓬莱顶上来。","琼室既登花得折，","永将凡骨逐风雷。"],"stanzas":[["宝车辗驻彩云开，","误到蓬莱顶上来。"],["琼室既登花得折，","永将凡骨逐风雷。"]]}
{"id":"09fc0128ca","title":"与何光远赠荅诗 六","author":"明月潭龙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["负妾当时寤寐求，","从兹粉面阻绸缪。","宫空月苦瑶云断，","寂寞巴江水自流。"],"stanzas":[["负妾当时寤寐求，","从兹粉面阻绸缪。"],["宫空月苦瑶云断，","寂寞巴江水自流。"]]}
{"id":"c527f45889","title":"寄紫盖阳居士","author":"黄陵美人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落叶栖鸦掩庙扉，","菟丝金缕旧罗衣。","渡头明月好携手，","独自待郎郎不归。"],"stanzas":[["落叶栖鸦掩庙扉，","菟丝金缕旧罗衣。"],["渡头明月好携手，","独自待郎郎不归。"]]}
{"id":"f5d6f4c371","title":"赠谢府君","author":"吴兴神女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉钗空中堕，","金钏色已歇。","独泣谢春风，","秋夜伤明月。"],"stanzas":[["玉钗空中堕，","金钏色已歇。"],["独泣谢春风，","秋夜伤明月。"]]}
{"id":"d0de6566b4","title":"冢上荅太宗","author":"慕容垂","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我昔胜君昔，","君今胜我今。","荣华各异代，","何用苦追寻。"],"stanzas":[["我昔胜君昔，","君今胜我今。"],["荣华各异代，","何用苦追寻。"]]}
{"id":"018f1d2470","title":"遗画工诗","author":"释明解","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["握手不能别，","抚膺聊自伤。","痛矣时阴短，","悲哉泉路长。","松林惊野吹，","荒隧落寒霜。","言离何以赠，","留心内典章。"],"stanzas":[["握手不能别，","抚膺聊自伤。"],["痛矣时阴短，","悲哉泉路长。"],["松林惊野吹，","荒隧落寒霜。"],["言离何以赠，","留心内典章。"]]}
{"id":"c87228530e","title":"夜吟","author":"巴峡鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋径填黄叶，","寒摧露草根。","猨声一叫断，","客泪数重痕。"],"stanzas":[["秋径填黄叶，","寒摧露草根。"],["猨声一叫断，","客泪数重痕。"]]}
{"id":"f188b5a7a6","title":"媿谢诗","author":"河[湄]鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我本邯郸士，","祇役死河湄。","不得家人哭，","劳君行路悲。"],"stanzas":[["我本邯郸士，","祇役死河湄。"],["不得家人哭，","劳君行路悲。"]]}
{"id":"044d33da3c","title":"掷裴武公诗","author":"介胄鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["屡策羸骖历乱峋，","丛岚映日昼如曛。","长桥驾险浮天汉，","危栈通岐触岫云。","却念淮阴空得计，","又嗟忠武不堪闻。","废兴尽系前生数，","休衒英雄勇冠军。"],"stanzas":[["屡策羸骖历乱峋，","丛岚映日昼如曛。"],["长桥驾险浮天汉，","危栈通岐触岫云。"],["却念淮阴空得计，","又嗟忠武不堪闻。"],["废兴尽系前生数，","休衒英雄勇冠军。"]]}
{"id":"ddb9b83ae1","title":"死后诗","author":"李叔霁","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忽作无期别，","沈冥恨有余。","长安虽不远，","无信可传书。"],"stanzas":[["忽作无期别，","沈冥恨有余。"],["长安虽不远，","无信可传书。"]]}
{"id":"e04e779437","title":"洋州馆夜吟","author":"窦裕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门依楚水岸，","身寄洋州馆。","望月独相思，","尘襟泪痕满。"],"stanzas":[["门依楚水岸，","身寄洋州馆。"],["望月独相思，","尘襟泪痕满。"]]}
{"id":"c08ae5669a","title":"献元载","author":"书生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["城东城西旧居处，","城里飞花乱如絮。","海燕衔泥欲下来，","屋里无人却飞去。"],"stanzas":[["城东城西旧居处，","城里飞花乱如絮。"],["海燕衔泥欲下来，","屋里无人却飞去。"]]}
{"id":"bbcfc17897","title":"诗二首 一","author":"虎丘山石壁鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高松多悲风，","萧萧清且哀。","南山接幽垅，","幽垅空崔嵬。","白日徒昭昭，","不照长夜台。","虽知生者乐，","魂魄安能回。","况复念所亲，","恸哭心肝摧。","恸哭更何言，","哀哉复哀哉。"],"stanzas":[["高松多悲风，","萧萧清且哀。"],["南山接幽垅，","幽垅空崔嵬。"],["白日徒昭昭，","不照长夜台。"],["虽知生者乐，","魂魄安能回。"],["况复念所亲，","恸哭心肝摧。"],["恸哭更何言，","哀哉复哀哉。"]]}
{"id":"b4fb3c1496","title":"诗二首 二","author":"虎丘山石壁鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["神仙不可学，","形化空游魂。","白日非我朝，","青松为我门。","虽复隔幽显，","犹知念子孙。","何以遣悲惋，","万物归其根。","寄语世上人，","莫厌临芳尊。","庄生问枯骨，","三乐成虚言。"],"stanzas":[["神仙不可学，","形化空游魂。"],["白日非我朝，","青松为我门。"],["虽复隔幽显，","犹知念子孙。"],["何以遣悲惋，","万物归其根。"],["寄语世上人，","莫厌临芳尊。"],["庄生问枯骨，","三乐成虚言。"]]}
{"id":"0b94712d2d","title":"祭后见石上诗","author":"虎丘山石壁鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽明虽异路，","平昔忝攻文。","欲知潜昧处，","山北两孤坟。"],"stanzas":[["幽明虽异路，","平昔忝攻文。"],["欲知潜昧处，","山北两孤坟。"]]}
{"id":"e4b0b64bbf","title":"咏浮云","author":"陆凭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虚虚复空空，","瞬息天地中。","假合成此像，","吾亦非吾躬。"],"stanzas":[["虚虚复空空，","瞬息天地中。"],["假合成此像，","吾亦非吾躬。"]]}
{"id":"9179df3aa9","title":"呈李续","author":"韩弇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我有敌国讐，","无人可为雪。","每至秦陇头，","游魂自呜咽。"],"stanzas":[["我有敌国讐，","无人可为雪。"],["每至秦陇头，","游魂自呜咽。"]]}
{"id":"4b661d4c60","title":"和崔侍御","author":"尉佗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千岁荒台隳路隅，","一烦太守重椒涂。","感君拂拭意何极，","赠尔美妇与明珠。"],"stanzas":[["千岁荒台隳路隅，","一烦太守重椒涂。"],["感君拂拭意何极，","赠尔美妇与明珠。"]]}
{"id":"bc9f77a9ef","title":"赠窦丞","author":"刘溉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冥路杳杳人不知，","不用苦说使人悲。","喜得逢君传家信，","后会茫茫何处期。"],"stanzas":[["冥路杳杳人不知，","不用苦说使人悲。"],["喜得逢君传家信，","后会茫茫何处期。"]]}
{"id":"a04c33a8d5","title":"叙幽冤","author":"郑琼罗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["痛填心兮不能语，","寸断肠兮诉何处。","春生万物妾不生，","更恨香魂不相遇。"],"stanzas":[["痛填心兮不能语，","寸断肠兮诉何处。"],["春生万物妾不生，","更恨香魂不相遇。"]]}
{"id":"19c4a1fbbe","title":"过台城感旧","author":"沈青箱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六代旧山川，","兴亡几百年。","繁华今寂寞，","朝市昔諠阗。","夜月琉璃水，","春风卵色天。","伤时与怀古，","垂泪国门前。"],"stanzas":[["六代旧山川，","兴亡几百年。"],["繁华今寂寞，","朝市昔諠阗。"],["夜月琉璃水，","春风卵色天。"],["伤时与怀古，","垂泪国门前。"]]}
{"id":"ce73486514","title":"诗","author":"襄阳旅殡举人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流水涓涓芹努芽，","织乌西飞客还家。","荒村无人作寒食，","殡宫空对棠棃花。"],"stanzas":[["流水涓涓芹努芽，","织乌西飞客还家。"],["荒村无人作寒食，","殡宫空对棠棃花。"]]}
{"id":"c7556a2396","title":"踏歌","author":"河中鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河水流溷溷，","山头种荞麦。","两个胡孙门底来，","东家阿嫂决一百。"],"stanzas":[["河水流溷溷，","山头种荞麦。"],["两个胡孙门底来，","东家阿嫂决一百。"]]}
{"id":"d411296ad5","title":"题少陵别墅","author":"萧微","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新构茅斋野涧东，","松楸交影足悲风。","人间岁月如流水，","何事频行此路中。"],"stanzas":[["新构茅斋野涧东，","松楸交影足悲风。"],["人间岁月如流水，","何事频行此路中。"]]}
{"id":"77b3620e6b","title":"梦张垂赠诗","author":"张省躬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戚戚复戚戚，","秋堂百年色。","而我独茫茫，","荒郊遇寒食。"],"stanzas":[["戚戚复戚戚，","秋堂百年色。"],["而我独茫茫，","荒郊遇寒食。"]]}
{"id":"81ffc09748","title":"秋月联句","author":"商山三丈夫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋月圆如镜，","秋风利似刀。","秋云轻比絮，","秋草细如毛。"],"stanzas":[["秋月圆如镜，","秋风利似刀。"],["秋云轻比絮，","秋草细如毛。"]]}
{"id":"af3aaa0745","title":"天明联句","author":"商山三丈夫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽树高高影，","山花寂寂香。","山天遥历历，","山水急汤汤。"],"stanzas":[["幽树高高影，","山花寂寂香。"],["山天遥历历，","山水急汤汤。"]]}
{"id":"ee66ea2a87","title":"赠张珽","author":"郑适","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔为吟风啸月人，","今为吟风啸月身。","冢坏路边吟啸罢，","安知今日又劳神。"],"stanzas":[["昔为吟风啸月人，","今为吟风啸月身。"],["冢坏路边吟啸罢，","安知今日又劳神。"]]}
{"id":"474841a3cd","title":"西轩诗 一","author":"甘露寺鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赵壹能为赋，","邹阳解献书。","可惜西江水，","不救辙中鱼。"],"stanzas":[["赵壹能为赋，","邹阳解献书。"],["可惜西江水，","不救辙中鱼。"]]}
{"id":"5ba710ea81","title":"西轩诗 二","author":"甘露寺鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伟哉横海鳞，","壮矣垂天翼。","一旦失风水，","翻为蝼蚁食。"],"stanzas":[["伟哉横海鳞，","壮矣垂天翼。"],["一旦失风水，","翻为蝼蚁食。"]]}
{"id":"854541de3c","title":"西轩诗 三","author":"甘露寺鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["功遂侔昔人，","保退无智力。","既涉太行险，","兹路信难陟。"],"stanzas":[["功遂侔昔人，","保退无智力。"],["既涉太行险，","兹路信难陟。"]]}
{"id":"d4e0cdcf4d","title":"西轩诗 四","author":"甘露寺鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["握里龙蛇纸上鸾，","逡巡千幅不将难。","顾云已往罗隐耄，","更有何人逞笔端。"],"stanzas":[["握里龙蛇纸上鸾，","逡巡千幅不将难。"],["顾云已往罗隐耄，","更有何人逞笔端。"]]}
{"id":"46c29e0823","title":"降巫诗","author":"邵谒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青山山下少年郎，","失意当时别故乡。","惆怅不堪回首望，","隔溪遥见旧书堂。"],"stanzas":[["青山山下少年郎，","失意当时别故乡。"],["惆怅不堪回首望，","隔溪遥见旧书堂。"]]}
{"id":"9966714a24","title":"赠雷殿直。","author":"石恪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["衡阳去此正三年，","一路程途甚坦然。","深邃门墙三楚外，","清风池馆五峰前。","西边市井来商客，","东岸汀洲簇钓船。","公退只应无别事，","朱陵后洞看神仙。"],"stanzas":[["衡阳去此正三年，","一路程途甚坦然。"],["深邃门墙三楚外，","清风池馆五峰前。"],["西边市井来商客，","东岸汀洲簇钓船。"],["公退只应无别事，","朱陵后洞看神仙。"]]}
{"id":"aa009a61fa","title":"吟","author":"富春沙际鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陊江三十年，","潮打形骸朽。","家人都不知，","何处奠杯酒。"],"stanzas":[["陊江三十年，","潮打形骸朽。"],["家人都不知，","何处奠杯酒。"]]}
{"id":"749edb25b3","title":"又吟","author":"富春沙际鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫问我姓名，","向君言亦空。","潮生沙骨冷，","魂魄悲秋风。"],"stanzas":[["莫问我姓名，","向君言亦空。"],["潮生沙骨冷，","魂魄悲秋风。"]]}
{"id":"2265a207d6","title":"献高骈","author":"赵𤰳","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我昔胜君昔，","君今胜我今。","人生一世事，","何用苦相侵。"],"stanzas":[["我昔胜君昔，","君今胜我今。"],["人生一世事，","何用苦相侵。"]]}
{"id":"fbfca4d7dd","title":"吟","author":"九华山白衣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["涧水潺潺声不绝，","溪垅茫茫野花发。","自去自来人不知，","归时唯对空山月。"],"stanzas":[["涧水潺潺声不绝，","溪垅茫茫野花发。"],["自去自来人不知，","归时唯对空山月。"]]}
{"id":"5078129f35","title":"诗","author":"田达诚借宅鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天然与我一灵通，","还与人间事不同。","要识吾家真姓字，","天地南头一段红。"],"stanzas":[["天然与我一灵通，","还与人间事不同。"],["要识吾家真姓字，","天地南头一段红。"]]}
{"id":"59b093c6c5","title":"秋夜吟","author":"长安中鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六街鼓歇行人绝，","九衢茫茫室有月。","九衢生人何劳劳，","长安土尽槐根高。"],"stanzas":[["六街鼓歇行人绝，","九衢茫茫室有月。"],["九衢生人何劳劳，","长安土尽槐根高。"]]}
{"id":"fac1259fa7","title":"题窗上诗","author":"隔窗鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何人窗下读书声，","南斗阑干北斗横。","千里思家归不得，","春风肠断石头城。"],"stanzas":[["何人窗下读书声，","南斗阑干北斗横。"],["千里思家归不得，","春风肠断石头城。"]]}
{"id":"f2481b9f59","title":"柱上诗","author":"巴陵馆鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爷娘送我青枫根，","不记青枫几回落。","当时手刺衣上花，","今日为灰不堪著。"],"stanzas":[["爷娘送我青枫根，","不记青枫几回落。"],["当时手刺衣上花，","今日为灰不堪著。"]]}
{"id":"fdbe729175","title":"留别安凤","author":"徐侃","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君寄长安久，","耻不还故乡。","我别长安去，","切在慰高堂。","不意与离恨，","泉下亦难忘。"],"stanzas":[["君寄长安久，","耻不还故乡。"],["我别长安去，","切在慰高堂。"],["不意与离恨，","泉下亦难忘。"]]}
{"id":"078134c923","title":"安凤赠别徐侃","author":"徐侃","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一自离乡国，","十年在咸秦。","泣尽卞和血，","不逢一故人。","今日旧友别，","羞此漂泊身。","离情吟诗处，","麻衣掩泪频。","泪别各分袂，","且及来年春。"],"stanzas":[["一自离乡国，","十年在咸秦。"],["泣尽卞和血，","不逢一故人。"],["今日旧友别，","羞此漂泊身。"],["离情吟诗处，","麻衣掩泪频。"],["泪别各分袂，","且及来年春。"]]}
{"id":"10d8f9027a","title":"述怀 一","author":"商山客死书生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家住驿北路，","百里无四邻。","往来不相问，","寂寂山家春。"],"stanzas":[["家住驿北路，","百里无四邻。"],["往来不相问，","寂寂山家春。"]]}
{"id":"44f6ed8a34","title":"述怀 二","author":"商山客死书生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南冈夜萧萧，","青松与白杨。","家人应有梦，","远客已无肠。"],"stanzas":[["南冈夜萧萧，","青松与白杨。"],["家人应有梦，","远客已无肠。"]]}
{"id":"c44cbb4684","title":"述怀 三","author":"商山客死书生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白草寒露里，","乱山明月中。","是夕苦吟罢，","寒烛与君同。"],"stanzas":[["白草寒露里，","乱山明月中。"],["是夕苦吟罢，","寒烛与君同。"]]}
{"id":"fff304cd4e","title":"续郑郊吟","author":"冢中人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冢上两竿竹，","风吹常袅袅。","下有百年人，","长眠不知晓。"],"stanzas":[["冢上两竿竹，","风吹常袅袅。"],["下有百年人，","长眠不知晓。"]]}
{"id":"18c2e52e03","title":"题壁 一","author":"崇圣寺鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禁烟佳节同游此，","正值酴醿夹岸香。","缅首十年前往事，","强吟风景乱愁肠。"],"stanzas":[["禁烟佳节同游此，","正值酴醿夹岸香。"],["缅首十年前往事，","强吟风景乱愁肠。"]]}
{"id":"26f7f3764b","title":"题壁 二","author":"崇圣寺鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["策马暂寻原上路，","落花芳草尚依然。","家亡国破一场梦，","惆怅又逢寒食天。"],"stanzas":[["策马暂寻原上路，","落花芳草尚依然。"],["家亡国破一场梦，","惆怅又逢寒食天。"]]}
{"id":"d429f0d5ce","title":"血书诗","author":"任彦思家鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["物类易迁变，","我行人不见。","珍重任彦思，","相别日已远。"],"stanzas":[["物类易迁变，","我行人不见。"],["珍重任彦思，","相别日已远。"]]}
{"id":"fa59b69149","title":"赠马植","author":"峡中白衣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["截竹为筒作笛吹，","凤凰池上凤凰飞。","劳君更向黔南去，","即是陶钧万类时。"],"stanzas":[["截竹为筒作笛吹，","凤凰池上凤凰飞。"],["劳君更向黔南去，","即是陶钧万类时。"]]}
{"id":"4ffdfbdafb","title":"题芭蕉叶上","author":"张仁宝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒食家家尽禁烟，","野棠风坠小花钿。","如今空有孤魂梦，","半在嘉陵半锦川。"],"stanzas":[["寒食家家尽禁烟，","野棠风坠小花钿。"],["如今空有孤魂梦，","半在嘉陵半锦川。"]]}
{"id":"1e6a8203c1","title":"官坡馆联句","author":"崔常侍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["床头锦衾班复班，","架上朱衣殷复殷。","空庭朗月闲复闲，","夜长路远山复山。"],"stanzas":[["床头锦衾班复班，","架上朱衣殷复殷。"],["空庭朗月闲复闲，","夜长路远山复山。"]]}
{"id":"1f7e823496","title":"亡后见形诗","author":"李煜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["异国非所志，","烦劳殊清闲。","惊涛千万里，","无乃见钟山。"],"stanzas":[["异国非所志，","烦劳殊清闲。"],["惊涛千万里，","无乃见钟山。"]]}
{"id":"cf73d29f14","title":"同鹿门少年马绍隆冥游诗 一","author":"庞德公","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千年故国岁华奔，","一柱高台已断魂。","唯有岘亭清夜月，","与君长啸学苏门。"],"stanzas":[["千年故国岁华奔，","一柱高台已断魂。"],["唯有岘亭清夜月，","与君长啸学苏门。"]]}
{"id":"1019db622d","title":"同鹿门少年马绍隆冥游诗 二","author":"庞德公","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高名宋玉遗闲丽，","作赋兰成绝盛才。","谁似辽东千岁鹤，","倚天华表却归来。"],"stanzas":[["高名宋玉遗闲丽，","作赋兰成绝盛才。"],["谁似辽东千岁鹤，","倚天华表却归来。"]]}
{"id":"32b9576961","title":"贻常夷诗","author":"朱均","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平生游城郭，","殂没委荒榛。","自我辞人世，","不知秋与春。","牛羊久来牧，","松柏几成薪。","分绝车马好，","甘随狐兔群。","何处清风至，","君子幸为邻。","烈烈盛名德，","依依伫良宾。","千年何旦暮，","一室动人神。","乔木如在望，","通衢良易遵。","高门傥无隔，","向与析龙津。"],"stanzas":[["平生游城郭，","殂没委荒榛。"],["自我辞人世，","不知秋与春。"],["牛羊久来牧，","松柏几成薪。"],["分绝车马好，","甘随狐兔群。"],["何处清风至，","君子幸为邻。"],["烈烈盛名德，","依依伫良宾。"],["千年何旦暮，","一室动人神。"],["乔木如在望，","通衢良易遵。"],["高门傥无隔，","向与析龙津。"]]}
{"id":"f0e2ef8c58","title":"空馆夜歌 一","author":"夷陵女郎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明月清风，","良宵会同。","星河易翻，","欢娱不终。","绿樽翠杓，","为君斟酌。"],"stanzas":[["明月清风，","良宵会同。"],["星河易翻，","欢娱不终。"],["绿樽翠杓，","为君斟酌。"]]}
{"id":"4db674979f","title":"空馆夜歌 二","author":"夷陵女郎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳杨柳，","袅袅随风急。","西楼美人春梦长，","绣帘斜卷千条入。"],"stanzas":[["杨柳杨柳，","袅袅随风急。"],["西楼美人春梦长，","绣帘斜卷千条入。"]]}
{"id":"5336213764","title":"空馆夜歌 三","author":"夷陵女郎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["[玉]户金缸，","愿陪君王。","邯郸宫中，","金石丝簧。","卫女秦娥，","左右成行。","纨缟缤纷，","翠眉红妆。","王欢顾盼，","为王歌舞。","愿得君欢，","常无灾苦。"],"stanzas":[["[玉]户金缸，","愿陪君王。"],["邯郸宫中，","金石丝簧。"],["卫女秦娥，","左右成行。"],["纨缟缤纷，","翠眉红妆。"],["王欢顾盼，","为王歌舞。"],["愿得君欢，","常无灾苦。"]]}
{"id":"cf205d0389","title":"赠夫诗三首 一","author":"孔氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不忿成故人，","掩涕每盈巾。","死生今有隔，","相见永无因。"],"stanzas":[["不忿成故人，","掩涕每盈巾。"],["死生今有隔，","相见永无因。"]]}
{"id":"6631a8ca20","title":"赠夫诗三首 二","author":"孔氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["匣里残妆粉，","留将与后人。","黄泉无用处，","恨作冢中尘。"],"stanzas":[["匣里残妆粉，","留将与后人。"],["黄泉无用处，","恨作冢中尘。"]]}
{"id":"9d0818f80d","title":"赠夫诗三首 三","author":"孔氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有意怀男女，","无情亦任君。","欲知肠断处，","明月照孤坟。"],"stanzas":[["有意怀男女，","无情亦任君。"],["欲知肠断处，","明月照孤坟。"]]}
{"id":"9df7c135e4","title":"荅夫诗二首 一","author":"唐晅妻张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不分殊幽显，","那堪异古今。","阴阳徒自隔，","聚散两难心。"],"stanzas":[["不分殊幽显，","那堪异古今。"],["阴阳徒自隔，","聚散两难心。"]]}
{"id":"b9d8e46df6","title":"荅夫诗二首 二","author":"唐晅妻张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兰阶兔月斜，","银烛半含花。","自怜长夜客，","泉路以为家。"],"stanzas":[["兰阶兔月斜，","银烛半含花。"],["自怜长夜客，","泉路以为家。"]]}
{"id":"fd54833a65","title":"唐晅悼妻诗 一","author":"唐晅妻张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寝室悲长簟，","妆楼泣镜台。","独悲桃李节，","不共夜泉开。","魂兮若有感，","髣髴梦中来。"],"stanzas":[["寝室悲长簟，","妆楼泣镜台。"],["独悲桃李节，","不共夜泉开。"],["魂兮若有感，","髣髴梦中来。"]]}
{"id":"7fb50fa2fa","title":"唐晅悼妻诗 二","author":"唐晅妻张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["常时华堂静，","笑语度更筹。","恍惚人事改，","冥寞委荒丘。","阳原歌薤露，","阴壑惜藏舟。","清夜妆台月，","空想画眉愁。"],"stanzas":[["常时华堂静，","笑语度更筹。"],["恍惚人事改，","冥寞委荒丘。"],["阳原歌薤露，","阴壑惜藏舟。"],["清夜妆台月，","空想画眉愁。"]]}
{"id":"583f8fee00","title":"赠妻诗","author":"唐晅妻张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峄阳桐半死，","延津劒一沈。","如何宿昔内，","空负百年心。"],"stanzas":[["峄阳桐半死，","延津劒一沈。"],["如何宿昔内，","空负百年心。"]]}
{"id":"c733f835d1","title":"赠姊","author":"韦璜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["修短各有分，","浮华亦非真。","断肠泉壤下，","幽忧难具陈。","凄凄白杨风，","日暮堪愁人。"],"stanzas":[["修短各有分，","浮华亦非真。"],["断肠泉壤下，","幽忧难具陈。"],["凄凄白杨风，","日暮堪愁人。"]]}
{"id":"322592e41a","title":"赠夫二首 一","author":"韦璜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不得长相守，","青春夭蕣华。","旧游今永已，","泉路却为家。"],"stanzas":[["不得长相守，","青春夭蕣华。"],["旧游今永已，","泉路却为家。"]]}
{"id":"100f4068c5","title":"赠夫二首 二","author":"韦璜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早知离别切人心，","悔作从来恩爱深。","黄泉冥寞虽长逝，","白日屏帷还重寻。"],"stanzas":[["早知离别切人心，","悔作从来恩爱深。"],["黄泉冥寞虽长逝，","白日屏帷还重寻。"]]}
{"id":"144164a80e","title":"赠嫂","author":"韦璜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赤心用尽为相知，","虑后防前秖定疑。","案牍可申生节目，","桃符虽圣欲何为。"],"stanzas":[["赤心用尽为相知，","虑后防前秖定疑。"],["案牍可申生节目，","桃符虽圣欲何为。"]]}
{"id":"dd34995392","title":"与独孤穆冥会诗 一","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江都昔丧乱，","阙下多搆兵。","豺虎恣吞噬，","干戈日纵横。","逆徒自外至，","半夜开重城。","膏血浸宫殿，","刀枪倚簷楹。","今知从逆者，","廼是公与卿。","白刃汚黄屋，","邦家遂因倾。","疾风知劲草，","世乱识忠臣。","哀哀独孤公，","临死乃结缨。","天地既板荡，","云雷时未亨。","今者二百载，","幽怀犹未平。","山河风月古，","陵寝露烟青。","君子秉祖德，","方垂忠烈名。","华轩一惠顾，","土室以为荣。","丈夫立志操，","存没感其情。","求义若可托，","谁能抱幽贞。"],"stanzas":[["江都昔丧乱，","阙下多搆兵。"],["豺虎恣吞噬，","干戈日纵横。"],["逆徒自外至，","半夜开重城。"],["膏血浸宫殿，","刀枪倚簷楹。"],["今知从逆者，","廼是公与卿。"],["白刃汚黄屋，","邦家遂因倾。"],["疾风知劲草，","世乱识忠臣。"],["哀哀独孤公，","临死乃结缨。"],["天地既板荡，","云雷时未亨。"],["今者二百载，","幽怀犹未平。"],["山河风月古，","陵寝露烟青。"],["君子秉祖德，","方垂忠烈名。"],["华轩一惠顾，","土室以为荣。"],["丈夫立志操，","存没感其情。"],["求义若可托，","谁能抱幽贞。"]]}
{"id":"2a7207a841","title":"与独孤穆冥会诗 二","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皇天昔降祸，","隋室若缀旒。","患难在双阙，","干戈连九州。","出门皆凶竖，","所向多逆谋。","白日忽然暮，","颓波不可收。","望夷既结衅，","宗社亦贻羞。","温室兵始合，","宫闱血已流。","悯哉吹箫子，","悲啼下凤楼。","霜刃徒见逼，","玉笄不可求。","罗襦遗侍者，","粉黛成仇雠。","邦国已沦覆，","余生誓不留。","英英将军祖，","独以社稷忧。","丹血溅黼扆，","丰肌染戈矛。","今来见禾黍，","尽日悲宗周。","玉树已寂寞，","泉台千万秋。","感兹一顾重，","愿以死节酬。","幽显傥不昧，","终焉契绸缪。"],"stanzas":[["皇天昔降祸，","隋室若缀旒。"],["患难在双阙，","干戈连九州。"],["出门皆凶竖，","所向多逆谋。"],["白日忽然暮，","颓波不可收。"],["望夷既结衅，","宗社亦贻羞。"],["温室兵始合，","宫闱血已流。"],["悯哉吹箫子，","悲啼下凤楼。"],["霜刃徒见逼，","玉笄不可求。"],["罗襦遗侍者，","粉黛成仇雠。"],["邦国已沦覆，","余生誓不留。"],["英英将军祖，","独以社稷忧。"],["丹血溅黼扆，","丰肌染戈矛。"],["今来见禾黍，","尽日悲宗周。"],["玉树已寂寞，","泉台千万秋。"],["感兹一顾重，","愿以死节酬。"],["幽显傥不昧，","终焉契绸缪。"]]}
{"id":"10f59f8100","title":"与独孤穆冥会诗 三","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平阳县中树，","久作广陵尘。","不意何郎至，","黄泉重见春。"],"stanzas":[["平阳县中树，","久作广陵尘。"],["不意何郎至，","黄泉重见春。"]]}
{"id":"cd1207da8a","title":"与独孤穆冥会诗 四","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今闺久无主，","罗袂坐生尘。","愿作吹箫伴，","同为骑凤人。"],"stanzas":[["今闺久无主，","罗袂坐生尘。"],["愿作吹箫伴，","同为骑凤人。"]]}
{"id":"86cb7e80b0","title":"与独孤穆冥会诗 五","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱轩下长路，","青草启孤坟。","犹胜阳台上，","空看朝暮云。"],"stanzas":[["朱轩下长路，","青草启孤坟。"],["犹胜阳台上，","空看朝暮云。"]]}
{"id":"896e61100d","title":"与独孤穆冥会诗 六","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["露草芊芊，","颓茔未迁。","自我居此，","于今几年。","与君先祖，","畴昔恩波。","死生契阔，","忽此相过。","谁谓佳期，","寻当别离。","俟君之北，","携手同归。"],"stanzas":[["露草芊芊，","颓茔未迁。"],["自我居此，","于今几年。"],["与君先祖，","畴昔恩波。"],["死生契阔，","忽此相过。"],["谁谓佳期，","寻当别离。"],["俟君之北，","携手同归。"]]}
{"id":"ebe4d01008","title":"与独孤穆冥会诗 七","author":"临淄县主","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伊彼维扬，","在天一方。","驱马悠悠，","忽来异乡。","情通幽显，","获此相见。","义感畴昔，","言存缱绻。","清江桂洲，","可以遨游。","惟子之故，","不遑淹留。"],"stanzas":[["伊彼维扬，","在天一方。"],["驱马悠悠，","忽来异乡。"],["情通幽显，","获此相见。"],["义感畴昔，","言存缱绻。"],["清江桂洲，","可以遨游。"],["惟子之故，","不遑淹留。"]]}
{"id":"d5d89b2f69","title":"与李章武赠荅诗 一","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸳鸯绮，","知结几千丝。","别后寻交颈，","应伤未别时。"],"stanzas":[["鸳鸯绮，","知结几千丝。"],["别后寻交颈，","应伤未别时。"]]}
{"id":"8d9001570f","title":"与李章武赠荅诗 二","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["捻指环，","相思见环重相忆。","愿君永持玩，","循环无终极。"],"stanzas":[["捻指环，","相思见环重相忆。"],["愿君永持玩，","循环无终极。"]]}
{"id":"ef5718a0ba","title":"与李章武赠荅诗 三","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河汉已倾斜，","神魂欲超越。","愿郎更回抱，","终天从此诀。"],"stanzas":[["河汉已倾斜，","神魂欲超越。"],["愿郎更回抱，","终天从此诀。"]]}
{"id":"958b1c9539","title":"与李章武赠荅诗 四","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["分从幽显隔，","岂谓有佳期。","宁辞重重别，","所叹去何之。"],"stanzas":[["分从幽显隔，","岂谓有佳期。"],["宁辞重重别，","所叹去何之。"]]}
{"id":"2b64144b01","title":"与李章武赠荅诗 五","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔辞怀后会，","今别便终天。","新悲与旧恨，","千古闭穷泉。"],"stanzas":[["昔辞怀后会，","今别便终天。"],["新悲与旧恨，","千古闭穷泉。"]]}
{"id":"747abc40e8","title":"与李章武赠荅诗 六","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["后期杳无约，","前恨已相寻。","别路无行信，","何因得寄心。"],"stanzas":[["后期杳无约，","前恨已相寻。"],["别路无行信，","何因得寄心。"]]}
{"id":"49682c6493","title":"与李章武赠荅诗 七","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水不西归月暂圆，","令人惆怅古城边。","萧条明早分岐路，","知更相逢何岁年。"],"stanzas":[["水不西归月暂圆，","令人惆怅古城边。"],["萧条明早分岐路，","知更相逢何岁年。"]]}
{"id":"7ba199ae3c","title":"李助为章武赋","author":"王氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石沈辽海阔，","剑别楚天长。","会合知无日，","离心满夕阳。"],"stanzas":[["石沈辽海阔，","剑别楚天长。"],["会合知无日，","离心满夕阳。"]]}
{"id":"6d7f3c8e15","title":"与曾季衡冥会诗 一","author":"王丽真","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五原分袂真吴越，","燕拆莺离芳草歇。","年少烟花处处春，","北邙空恨清秋月。"],"stanzas":[["五原分袂真吴越，","燕拆莺离芳草歇。"],["年少烟花处处春，","北邙空恨清秋月。"]]}
{"id":"f5ff58e69e","title":"与曾季衡冥会诗 二","author":"王丽真","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莎草青青雁欲归，","玉腮珠泪洒临岐。","云鬟飘去香风尽，","愁见莺啼红树枝。"],"stanzas":[["莎草青青雁欲归，","玉腮珠泪洒临岐。"],["云鬟飘去香风尽，","愁见莺啼红树枝。"]]}
{"id":"a35552f2dc","title":"赠段何","author":"客户里女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乐广清羸经几年，","姹娘相托不论钱。","轻盈妙质归何处，","惆怅碧楼红玉钿。"],"stanzas":[["乐广清羸经几年，","姹娘相托不论钱。"],["轻盈妙质归何处，","惆怅碧楼红玉钿。"]]}
{"id":"54f66ae8dc","title":"湖城厅吟","author":"密陀僧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄帝上天时，","鼎湖元在兹。","七十二玉女，","化作黄金芝。"],"stanzas":[["黄帝上天时，","鼎湖元在兹。"],["七十二玉女，","化作黄金芝。"]]}
{"id":"80799af7c2","title":"谢王轩","author":"西施","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾自吴宫还越国，","素衣千载无人识。","当时心比金石坚，","今日为君坚不得。"],"stanzas":[["妾自吴宫还越国，","素衣千载无人识。"],["当时心比金石坚，","今日为君坚不得。"]]}
{"id":"e7ac65cf7c","title":"王轩题西施石诗","author":"西施","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岭上千峰秀，","江边细草春。","今逢浣纱石，","不见浣纱人。"],"stanzas":[["岭上千峰秀，","江边细草春。"],["今逢浣纱石，","不见浣纱人。"]]}
{"id":"219be15715","title":"轩诗","author":"西施","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳人去千载，","溪山久寂寞。","野水浮白烟，","岩花自开落。","猨鸟旧清音，","风月闲楼阁。","无语立斜阳，","幽情入天幕。"],"stanzas":[["佳人去千载，","溪山久寂寞。"],["野水浮白烟，","岩花自开落。"],["猨鸟旧清音，","风月闲楼阁。"],["无语立斜阳，","幽情入天幕。"]]}
{"id":"9dbc5d2d2b","title":"西施诗","author":"西施","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高花岩外晓相鲜，","幽鸟雨中啼不歇。","红云飞过大江西，","从此人间怨风月。"],"stanzas":[["高花岩外晓相鲜，","幽鸟雨中啼不歇。"],["红云飞过大江西，","从此人间怨风月。"]]}
{"id":"3aee41525a","title":"轩诗","author":"西施","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["当时计拙笑将军，","何事安邦赖美人。","一自仙葩入吴国，","从兹越国更无春。"],"stanzas":[["当时计拙笑将军，","何事安邦赖美人。"],["一自仙葩入吴国，","从兹越国更无春。"]]}
{"id":"c4c873a358","title":"西施诗","author":"西施","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云霞出没群峰外，","鸥鸟浮沉一水间。","一自越兵齐振地，","梦魂不到虎丘山。"],"stanzas":[["云霞出没群峰外，","鸥鸟浮沉一水间。"],["一自越兵齐振地，","梦魂不到虎丘山。"]]}
{"id":"692ef27b20","title":"与萧旷冥会诗 一","author":"甄后","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉筯凝腮忆魏宫，","朱弦一弄洗清风。","明晨追赏应愁寂，","沙渚烟销翠羽空。"],"stanzas":[["玉筯凝腮忆魏宫，","朱弦一弄洗清风。"],["明晨追赏应愁寂，","沙渚烟销翠羽空。"]]}
{"id":"ca836b8c28","title":"与萧旷冥会诗 二","author":"甄后","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["织绡泉底少欢娱，","更劝萧郎尽酒壶。","愁见玉琴弹别鹤，","又将清泪滴真珠。"],"stanzas":[["织绡泉底少欢娱，","更劝萧郎尽酒壶。"],["愁见玉琴弹别鹤，","又将清泪滴真珠。"]]}
{"id":"72255085b6","title":"与萧旷冥会诗 三","author":"甄后","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红兰吐艳间夭桃，","自喜寻芳数已遭。","珠珮鹤桥从此断，","遥天空恨碧云高。"],"stanzas":[["红兰吐艳间夭桃，","自喜寻芳数已遭。"],["珠珮鹤桥从此断，","遥天空恨碧云高。"]]}
{"id":"d6f4f7f10f","title":"五原夜吟","author":"沙碛女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云鬟消尽转蓬稀，","埋骨穷荒失所依。","牧马不嘶沙月白，","孤魂空逐雁南飞。"],"stanzas":[["云鬟消尽转蓬稀，","埋骨穷荒失所依。"],["牧马不嘶沙月白，","孤魂空逐雁南飞。"]]}
{"id":"33c12cd7a6","title":"与颜濬冥会诗 一","author":"陈宫妃嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋草荒台响夜蛩，","白杨凋尽减悲风。","彩笺曾擘欺江总，","绮阁尘消玉树空。"],"stanzas":[["秋草荒台响夜蛩，","白杨凋尽减悲风。"],["彩笺曾擘欺江总，","绮阁尘消玉树空。"]]}
{"id":"72d8645da0","title":"与颜濬冥会诗 二","author":"陈宫妃嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝阁排云称望仙，","五云高艳拥朝天。","清溪犹有当时月，","应照琼花绽绮筵。"],"stanzas":[["宝阁排云称望仙，","五云高艳拥朝天。"],["清溪犹有当时月，","应照琼花绽绮筵。"]]}
{"id":"2109e9d796","title":"与颜濬冥会诗 三","author":"陈宫妃嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["素魄初圆恨翠娥，","繁华浓艳竟如何。","南朝唯有长江水，","依旧门前作逝波。"],"stanzas":[["素魄初圆恨翠娥，","繁华浓艳竟如何。"],["南朝唯有长江水，","依旧门前作逝波。"]]}
{"id":"dcd153cf1f","title":"与颜濬冥会诗 四","author":"陈宫妃嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["箫管清吟怨丽华，","秋江寒月绮窗斜。","惭非后主题笺客，","得见临春阁上花。"],"stanzas":[["箫管清吟怨丽华，","秋江寒月绮窗斜。"],["惭非后主题笺客，","得见临春阁上花。"]]}
{"id":"c479c9c0a5","title":"驿楼诵诗","author":"湘中女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红树醉秋色，","碧溪弹夜弦。","佳期不可再，","风雨杳如年。"],"stanzas":[["红树醉秋色，","碧溪弹夜弦。"],["佳期不可再，","风雨杳如年。"]]}
{"id":"1763d56653","title":"赠杨蕴中","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉漏声长灯耿耿，","东墙西墙时见影。","月明窗外子规啼，","忍使孤魂愁夜永。"],"stanzas":[["玉漏声长灯耿耿，","东墙西墙时见影。"],["月明窗外子规啼，","忍使孤魂愁夜永。"]]}
{"id":"e552073bd9","title":"葬后见形诗","author":"孟蜀妃张太华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独卧经秋堕鬓蝉，","白杨风起不成眠。","寻思往日椒房宠，","泪湿衣襟损翠钿。"],"stanzas":[["独卧经秋堕鬓蝉，","白杨风起不成眠。"],["寻思往日椒房宠，","泪湿衣襟损翠钿。"]]}
{"id":"7eca06184b","title":"谢李若冲","author":"孟蜀妃张太华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["符吏匆匆叩夜扃，","便随金简出幽冥。","蒙师荐拔恩非浅，","领得生神九过经。"],"stanzas":[["符吏匆匆叩夜扃，","便随金简出幽冥。"],["蒙师荐拔恩非浅，","领得生神九过经。"]]}
{"id":"5e25cadfb1","title":"幽恨诗","author":"安邑坊女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卜得上峡日，","秋江风浪多。","巴陵一夜雨，","肠断木兰歌。"],"stanzas":[["卜得上峡日，","秋江风浪多。"],["巴陵一夜雨，","肠断木兰歌。"]]}
{"id":"734f2b7671","title":"和检诗","author":"韦检亡姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春雨蒙蒙不见天，","家家门外柳和烟。","如今肠断空垂泪，","欢笑重追别有年。"],"stanzas":[["春雨蒙蒙不见天，","家家门外柳和烟。"],["如今肠断空垂泪，","欢笑重追别有年。"]]}
{"id":"609eeb2941","title":"检悼亡姬诗","author":"韦检亡姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝劒化龙归碧落，","嫦娥随月下黄泉。","一杯酒向青春晚，","寂寞书窗恨独眠。"],"stanzas":[["宝劒化龙归碧落，","嫦娥随月下黄泉。"],["一杯酒向青春晚，","寂寞书窗恨独眠。"]]}
{"id":"69d47913b4","title":"梦后自题","author":"韦检亡姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白浪漫漫去不回，","浮云飞尽日西颓。","始皇陵上千年树，","银鸭金凫也变灰。"],"stanzas":[["白浪漫漫去不回，","浮云飞尽日西颓。"],["始皇陵上千年树，","银鸭金凫也变灰。"]]}
{"id":"0a08be410c","title":"与夫同咏诗 一","author":"苏检妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚水平如镜，","周回白鸟飞。","金陵几多地，","一去不知归。"],"stanzas":[["楚水平如镜，","周回白鸟飞。"],["金陵几多地，","一去不知归。"]]}
{"id":"a653d7f65d","title":"与夫同咏诗 二","author":"苏检妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["还吴东去过澄城，","楼上清风酒半醒。","想得到家春已暮，","海棠千树已凋零。"],"stanzas":[["还吴东去过澄城，","楼上清风酒半醒。"],["想得到家春已暮，","海棠千树已凋零。"]]}
{"id":"91e49f1dee","title":"冥会诗 一","author":"宫嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["争不逢人话此身，","此身长夜不知春。","自从国破家亡后，","陇上惟添芳草新。"],"stanzas":[["争不逢人话此身，","此身长夜不知春。"],["自从国破家亡后，","陇上惟添芳草新。"]]}
{"id":"b9b8aff814","title":"冥会诗 二","author":"宫嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["休说人间恨恋多，","况逢佳客此相过。","堂中纵有千般乐，","争及阳春一曲歌。"],"stanzas":[["休说人间恨恋多，","况逢佳客此相过。"],["堂中纵有千般乐，","争及阳春一曲歌。"]]}
{"id":"c26dcd1c5f","title":"冥会诗 三","author":"宫嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽谷穷花似妾身，","纵怀香艳吐无因。","多情公子能相访，","应解回风暂借春。"],"stanzas":[["幽谷穷花似妾身，","纵怀香艳吐无因。"],["多情公子能相访，","应解回风暂借春。"]]}
{"id":"51081f972f","title":"冥会诗 四","author":"宫嫔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恩情未足晓光催，","数朵眠花未得开。","却羡一双金扼臂，","得随人世出将来。"],"stanzas":[["恩情未足晓光催，","数朵眠花未得开。"],["却羡一双金扼臂，","得随人世出将来。"]]}
{"id":"7b31918cb5","title":"与谢翶赠荅诗 一","author":"金车美人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阳台后会杳无期，","碧树烟深玉漏迟。","半夜香风满庭月，","花前空赋别离诗。"],"stanzas":[["阳台后会杳无期，","碧树烟深玉漏迟。"],["半夜香风满庭月，","花前空赋别离诗。"]]}
{"id":"5ebdad252e","title":"与谢翶赠荅诗 二","author":"金车美人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相思无路莫相思，","风里花开只片时。","惆怅金闺却归去，","晓莺啼断绿杨枝。"],"stanzas":[["相思无路莫相思，","风里花开只片时。"],["惆怅金闺却归去，","晓莺啼断绿杨枝。"]]}
{"id":"40484a84ab","title":"与谢翶赠荅诗 三","author":"金车美人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一纸华笺洒碧云，","余香犹在墨犹新。","空添满目凄凉事，","不见三山缥缈人。","斜月照衣今夜梦，","落花啼鸟去年春。","红闺更有堪愁处，","窗上虫丝几上尘。"],"stanzas":[["一纸华笺洒碧云，","余香犹在墨犹新。"],["空添满目凄凉事，","不见三山缥缈人。"],["斜月照衣今夜梦，","落花啼鸟去年春。"],["红闺更有堪愁处，","窗上虫丝几上尘。"]]}
{"id":"02b1d88d04","title":"与谢翶赠荅诗 四","author":"金车美人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惆怅佳期一梦中，","武陵春色尽成空。","欲知离别偏堪恨，","只为音尘两不通。","愁态上眉凝浅绿，","泪痕侵脸落轻红。","双轮暂与王孙驻，","明日西驰又向东。"],"stanzas":[["惆怅佳期一梦中，","武陵春色尽成空。"],["欲知离别偏堪恨，","只为音尘两不通。"],["愁态上眉凝浅绿，","泪痕侵脸落轻红。"],["双轮暂与王孙驻，","明日西驰又向东。"]]}
{"id":"02d3afb7cd","title":"赠朋诗","author":"魏朋妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤坟临清江，","每覩白日晚。","松影摇长风，","蟾光落嵓甸。","故乡千里余，","亲戚罕相见。","望望空云山，","哀哀泪如霰。","恨为泉台客，","复此异乡县。","愿言敦畴昔，","勿以弃疵贱。"],"stanzas":[["孤坟临清江，","每覩白日晚。"],["松影摇长风，","蟾光落嵓甸。"],["故乡千里余，","亲戚罕相见。"],["望望空云山，","哀哀泪如霰。"],["恨为泉台客，","复此异乡县。"],["愿言敦畴昔，","勿以弃疵贱。"]]}
{"id":"c05b724693","title":"题明月堂二首 一","author":"刘氏亡妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蝉鬓惊秋华发新，","可怜红隙尽埃尘。","西山一梦何年觉，","明月堂前不见人。"],"stanzas":[["蝉鬓惊秋华发新，","可怜红隙尽埃尘。"],["西山一梦何年觉，","明月堂前不见人。"]]}
{"id":"c4cdf19ef8","title":"题明月堂二首 二","author":"刘氏亡妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉钩风急响丁东，","回首西山似梦中。","明月堂前人不到，","庭前一夜老秋风。"],"stanzas":[["玉钩风急响丁东，","回首西山似梦中。"],["明月堂前人不到，","庭前一夜老秋风。"]]}
{"id":"f98a7a3223","title":"诗","author":"故台城妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌罢玉楼月，","舞残金缕衣。","匀钿收迸节，","歛黛别重闱。","网断蛛犹织，","梁春燕不归。","那堪回首处，","江步野棠飞。"],"stanzas":[["歌罢玉楼月，","舞残金缕衣。"],["匀钿收迸节，","歛黛别重闱。"],["网断蛛犹织，","梁春燕不归。"],["那堪回首处，","江步野棠飞。"]]}
{"id":"c60d22267e","title":"金陵词","author":"故台城妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫中细草香红湿，","宫内纤腰碧窗泣。","唯有虹梁春燕雏，","犹傍珠帘玉钩立。"],"stanzas":[["宫中细草香红湿，","宫内纤腰碧窗泣。"],["唯有虹梁春燕雏，","犹傍珠帘玉钩立。"]]}
{"id":"4be5fcfce9","title":"示宋善威","author":"无名女鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月落三株树，","日映九重天。","良夜欢宴罢，","暂别庚申年。"],"stanzas":[["月落三株树，","日映九重天。"],["良夜欢宴罢，","暂别庚申年。"]]}
{"id":"18e993fa16","title":"诗 一","author":"无名鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江上樯竿一百尺，","山中楼台十二重。","山僧楼上望江上，","指点樯竿笑杀侬。"],"stanzas":[["江上樯竿一百尺，","山中楼台十二重。"],["山僧楼上望江上，","指点樯竿笑杀侬。"]]}
{"id":"616d5003bd","title":"诗 二","author":"无名鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙人未必便仙去，","还在人间人不知。","手把白须从两鹿，","相逢却问姓名谁。"],"stanzas":[["仙人未必便仙去，","还在人间人不知。"],["手把白须从两鹿，","相逢却问姓名谁。"]]}
{"id":"890113109b","title":"句","author":"秾华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柏堂新成乐未央，","回来回去绕裴郎。"],"stanzas":[["柏堂新成乐未央，","回来回去绕裴郎。"]]}
{"id":"1a67601cb6","title":"句","author":"张守中","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["薄命苏秦频去国，","多情潘岳旋兴悲。","今夜若栖芳草径，","为传幽意达王孙。"],"stanzas":[["薄命苏秦频去国，","多情潘岳旋兴悲。"],["今夜若栖芳草径，","为传幽意达王孙。"]]}
{"id":"fbeca22a94","title":"句","author":"无名鬼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芫花半落，","松风晚清。"],"stanzas":[["芫花半落，","松风晚清。"]]}
{"id":"8c4bbc5930","title":"浑家门客联句 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自与浑家邻，","馨香遂满身。","无心好清静，","人用去灰尘。"],"stanzas":[["自与浑家邻，","馨香遂满身。"],["无心好清静，","人用去灰尘。"]]}
{"id":"9b7fc16468","title":"浑家门客联句 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["终朝每去依烟火，","春至还归养子孙。","曾向苻王笔端坐，","尔来求食浑家门。"],"stanzas":[["终朝每去依烟火，","春至还归养子孙。"],["曾向苻王笔端坐，","尔来求食浑家门。"]]}
{"id":"2cb812d614","title":"长须国驸马咏妻","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花无叶不妍，","女无须亦丑。","丈人试遣惣无，","未必不如惣有。"],"stanzas":[["花无叶不妍，","女无须亦丑。"],["丈人试遣惣无，","未必不如惣有。"]]}
{"id":"3b114e049f","title":"原陵老翁吟","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野田荆棘春，","闺阁绮罗新。","出没头上日，","生死眼前人。","欲知我家在何处，","北邙松柏正为邻。","洛阳女儿罗绮多，","无奈孤翁老去何，","奈尔何。","正色鸿焘，","神思化伐。","穹施后承，","光负玄设。","呕沦吐萌，","垠倪散截。","迷肠郗曲，","䨴零霾曀。","雀毁龟水，","健驰御屈。","拿尾研动，","袾袾哳哳。","㳷用秘功，","以岭以穴。","柂薪伐药，","莽榤万茁。","呕律则祥，","佛伦惟萨。","牡虚无有，","颐咽蘂屑。","肇素未来，","晦明兴灭。","五行七曜，","成此闰余。","上帝降灵，","岁且涒徐。","蛇蜕其皮，","吾亦神摅。","九九六六，","束身天除。","何以充喉，","吐纳太虚。","何以蔽踝，","霞袂云袽。","哀尔浮生，","栉比荒墟。","吾复丽气，","还形之初。","在帝左右，","道济忽诸。"],"stanzas":[["野田荆棘春，","闺阁绮罗新。"],["出没头上日，","生死眼前人。"],["欲知我家在何处，","北邙松柏正为邻。"],["洛阳女儿罗绮多，","无奈孤翁老去何，","奈尔何。"],["正色鸿焘，","神思化伐。"],["穹施后承，","光负玄设。"],["呕沦吐萌，","垠倪散截。"],["迷肠郗曲，","䨴零霾曀。"],["雀毁龟水，","健驰御屈。"],["拿尾研动，","袾袾哳哳。"],["㳷用秘功，","以岭以穴。"],["柂薪伐药，","莽榤万茁。"],["呕律则祥，","佛伦惟萨。"],["牡虚无有，","颐咽蘂屑。"],["肇素未来，","晦明兴灭。"],["五行七曜，","成此闰余。"],["上帝降灵，","岁且涒徐。"],["蛇蜕其皮，","吾亦神摅。"],["九九六六，","束身天除。"],["何以充喉，","吐纳太虚。"],["何以蔽踝，","霞袂云袽。"],["哀尔浮生，","栉比荒墟。"],["吾复丽气，","还形之初。"],["在帝左右，","道济忽诸。"]]}
{"id":"ca793dab24","title":"严含质诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔为仙子今为虎，","流落阴崖足风雨。","更将斑毳被余身，","千载空山万般苦。"],"stanzas":[["昔为仙子今为虎，","流落阴崖足风雨。"],["更将斑毳被余身，","千载空山万般苦。"]]}
{"id":"49d6be5944","title":"严含质诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["下玄八千亿甲子，","丹飞先生严含质。","谪下中天被斑革，","六千甲子，","血食涧饮厕猨狖。","下浊界，","景云元纪升太一。"],"stanzas":[["下玄八千亿甲子，","丹飞先生严含质。"],["谪下中天被斑革，","六千甲子，","血食涧饮厕猨狖。"],["下浊界，","景云元纪升太一。"]]}
{"id":"53d901a3c3","title":"李微诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶因狂疾成殊类，","灾患相任不可逃。","今日爪牙谁敢敌，","当时声迹共相高。","我为异物蓬茅下，","君已乘轺气势豪。","此夕溪山对明月，","不成长啸但成嗥。"],"stanzas":[["偶因狂疾成殊类，","灾患相任不可逃。"],["今日爪牙谁敢敌，","当时声迹共相高。"],["我为异物蓬茅下，","君已乘轺气势豪。"],["此夕溪山对明月，","不成长啸但成嗥。"]]}
{"id":"54b05af670","title":"维扬空庄四怪联句","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["齐纨鲁缟如霜雪，","寥亮高声予所发。","嘉宾良会清夜时，","煌煌灯烛我能持。","清冷之泉候朝汲，","桑绠相牵常出入。","爨薪贮泉相煎熬，","充他口腹我为劳。"],"stanzas":[["齐纨鲁缟如霜雪，","寥亮高声予所发。"],["嘉宾良会清夜时，","煌煌灯烛我能持。"],["清冷之泉候朝汲，","桑绠相牵常出入。"],["爨薪贮泉相煎熬，","充他口腹我为劳。"]]}
{"id":"b170e26527","title":"柳藏经二绝句 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒水停园沼，","秋池满败荷。","杜门穷典籍，","所得事今多。"],"stanzas":[["寒水停园沼，","秋池满败荷。"],["杜门穷典籍，","所得事今多。"]]}
{"id":"4d8111f76b","title":"柳藏经二绝句 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁谓三才贵，","余观万化同。","心虚嫌蠹食，","年老怯狂风。"],"stanzas":[["谁谓三才贵，","余观万化同。"],["心虚嫌蠹食，","年老怯狂风。"]]}
{"id":"916a70425d","title":"太白山魔诳道士诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三秋稽颡叩真灵，","龙虎交时金液成。","绛雪既凝身可度，","蓬壶顶上彩云生。"],"stanzas":[["三秋稽颡叩真灵，","龙虎交时金液成。"],["绛雪既凝身可度，","蓬壶顶上彩云生。"]]}
{"id":"d7679dd6a5","title":"金缶魅诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["色分蓝叶青，","声比磬中鸣。","七月初七夜，","吾当示汝形。"],"stanzas":[["色分蓝叶青，","声比磬中鸣。"],["七月初七夜，","吾当示汝形。"]]}
{"id":"7024129ecf","title":"东阳夜怪诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁家扫雪满庭前，","万壑千峰在一拳。","吾心不觉侵衣冷，","曾向此中居几年。"],"stanzas":[["谁家扫雪满庭前，","万壑千峰在一拳。"],["吾心不觉侵衣冷，","曾向此中居几年。"]]}
{"id":"0c88fef0da","title":"东阳夜怪诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拥褐藏名无定踪，","流沙千里度衰容。","传得南宗心地后，","此身应便老双峰。"],"stanzas":[["拥褐藏名无定踪，","流沙千里度衰容。"],["传得南宗心地后，","此身应便老双峰。"]]}
{"id":"c01ebbad8b","title":"东阳夜怪诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为有阎浮珍重因，","远离西国赴咸秦。","自从无力休行道，","且作头陀不系身。"],"stanzas":[["为有阎浮珍重因，","远离西国赴咸秦。"],["自从无力休行道，","且作头陀不系身。"]]}
{"id":"ef32f45b24","title":"东阳夜怪诗 四","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安城东洛阳道，","车轮不息尘浩浩。","争利贪前竞著鞭，","相逢尽是尘中老。"],"stanzas":[["长安城东洛阳道，","车轮不息尘浩浩。"],["争利贪前竞著鞭，","相逢尽是尘中老。"]]}
{"id":"dcd2276b3c","title":"东阳夜怪诗 五","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日晚长川不计程，","离群独步不能鸣。","赖有青青河畔草，","春来犹得慰羁情。"],"stanzas":[["日晚长川不计程，","离群独步不能鸣。"],["赖有青青河畔草，","春来犹得慰羁情。"]]}
{"id":"ca84ca4c71","title":"东阳夜怪诗 六","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爱此飘飖六出公，","轻琼冷絮舞长空。","当时正逐秦丞相，","腾踯川原喜北风。"],"stanzas":[["爱此飘飖六出公，","轻琼冷絮舞长空。"],["当时正逐秦丞相，","腾踯川原喜北风。"]]}
{"id":"cd56f90bc0","title":"东阳夜怪诗 七","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["事君同乐义同忧，","那校糟糠满志休。","不是守株空待兔，","终当逐鹿出林丘。"],"stanzas":[["事君同乐义同忧，","那校糟糠满志休。"],["不是守株空待兔，","终当逐鹿出林丘。"]]}
{"id":"fa4f06938c","title":"东阳夜怪诗 八","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年长负饥鹰用，","内顾曾无宠鹤心。","秋草驱除思去宇，","平原毛血兴从禽。"],"stanzas":[["少年长负饥鹰用，","内顾曾无宠鹤心。"],["秋草驱除思去宇，","平原毛血兴从禽。"]]}
{"id":"6f70e48d64","title":"东阳夜怪诗 九","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舞镜争鸾彩，","临场定鹘拳。","正思仙仗日，","翘首仰楼前。"],"stanzas":[["舞镜争鸾彩，","临场定鹘拳。"],["正思仙仗日，","翘首仰楼前。"]]}
{"id":"4595bd1f5b","title":"东阳夜怪诗 十","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["养鬬形如木，","迎春质似泥。","信如风雨在，","何惮迹卑栖。"],"stanzas":[["养鬬形如木，","迎春质似泥。"],["信如风雨在，","何惮迹卑栖。"]]}
{"id":"617771a5a6","title":"东阳夜怪诗 十一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为脱田文难，","常怀纪渻恩。","欲知疎野态，","霜晓叫荒村。"],"stanzas":[["为脱田文难，","常怀纪渻恩。"],["欲知疎野态，","霜晓叫荒村。"]]}
{"id":"1a91ba619a","title":"东阳夜怪诗 十二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱鲁负虚名，","游秦感甯生。","候惊丞相喘，","用识葛卢鸣。","黍稷滋农具，","轩车乏道情。","近来筋力退，","一志在归耕。"],"stanzas":[["乱鲁负虚名，","游秦感甯生。"],["候惊丞相喘，","用识葛卢鸣。"],["黍稷滋农具，","轩车乏道情。"],["近来筋力退，","一志在归耕。"]]}
{"id":"546800c5f9","title":"东阳夜怪诗 十三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为慙食肉主恩深，","日晏蟠蜿卧锦衾。","且学志人知白黑，","那将好爵动吾心。"],"stanzas":[["为慙食肉主恩深，","日晏蟠蜿卧锦衾。"],["且学志人知白黑，","那将好爵动吾心。"]]}
{"id":"862703e0af","title":"东阳夜怪诗 十四","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸟鼠是家川，","周王昔猎贤。","一从离子卯，","应见海桑田。"],"stanzas":[["鸟鼠是家川，","周王昔猎贤。"],["一从离子卯，","应见海桑田。"]]}
{"id":"38ba064e90","title":"田四郎求婚联句","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一点红裳出翠微，","秋天云静月离离。","天曹使者徒回首，","何不从他九族卑。"],"stanzas":[["一点红裳出翠微，","秋天云静月离离。"],["天曹使者徒回首，","何不从他九族卑。"]]}
{"id":"23fca4df92","title":"黑驹别卢传素诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["既食丈人粟，","又饱丈人刍。","今日相偿了，","永离三恶途。"],"stanzas":[["既食丈人粟，","又饱丈人刍。"],["今日相偿了，","永离三恶途。"]]}
{"id":"30c8eeaec4","title":"笔精诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔荷蒙恬惠，","寻遭仲叔投。","夫君不指使，","何处觅银钩。"],"stanzas":[["昔荷蒙恬惠，","寻遭仲叔投。"],["夫君不指使，","何处觅银钩。"]]}
{"id":"bbde7a68f1","title":"笔精诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["学问从君有，","诗书自我传。","须知王逸少，","名价动千年。"],"stanzas":[["学问从君有，","诗书自我传。"],["须知王逸少，","名价动千年。"]]}
{"id":"11d484aaeb","title":"笔精诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["能令音信通千里，","解致龙蛇运八行。","惆怅江生不相赏，","应缘自负好文章。"],"stanzas":[["能令音信通千里，","解致龙蛇运八行。"],["惆怅江生不相赏，","应缘自负好文章。"]]}
{"id":"522bfc35d8","title":"二斑与甯茵赋诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓读云水静，","夜吟山月高。","焉能履虎尾，","岂用学牛刀。"],"stanzas":[["晓读云水静，","夜吟山月高。"],["焉能履虎尾，","岂用学牛刀。"]]}
{"id":"90a9773e00","title":"二斑与甯茵赋诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但得居林啸，","焉能当路蹲。","渡河何所适，","终是怯刘琨。"],"stanzas":[["但得居林啸，","焉能当路蹲。"],["渡河何所适，","终是怯刘琨。"]]}
{"id":"1ed4bf6c82","title":"二斑与甯茵赋诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无非悲甯戚，","终是怯庖丁。","若遇龚为守，","蹄涔向北溟。"],"stanzas":[["无非悲甯戚，","终是怯庖丁。"],["若遇龚为守，","蹄涔向北溟。"]]}
{"id":"ba195b23b3","title":"白田獭魅别村女诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["潮来逐潮上，","潮落在空滩。","有来终有去，","情易复情难。","肠断肠中子，","明月秋江寒。"],"stanzas":[["潮来逐潮上，","潮落在空滩。"],["有来终有去，","情易复情难。"],["肠断肠中子，","明月秋江寒。"]]}
{"id":"4459959718","title":"邢君才旧宅三怪诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔日炎炎徒自知，","今无烽灶欲何为。","可怜国柄全无用，","曾见家人下第时。"],"stanzas":[["昔日炎炎徒自知，","今无烽灶欲何为。"],["可怜国柄全无用，","曾见家人下第时。"]]}
{"id":"7bd02cc51f","title":"邢君才旧宅三怪诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["当时得意气填心，","一曲君前直万金。","今日不如庭下竹，","风来犹得学龙吟。"],"stanzas":[["当时得意气填心，","一曲君前直万金。"],["今日不如庭下竹，","风来犹得学龙吟。"]]}
{"id":"3e01f10cb1","title":"邢君才旧宅三怪诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["头焦鬓秃但心存，","力尽尘埃不复论。","莫笑今来同腐草，","曾经终日扫朱门。"],"stanzas":[["头焦鬓秃但心存，","力尽尘埃不复论。"],["莫笑今来同腐草，","曾经终日扫朱门。"]]}
{"id":"5f70ab209c","title":"维扬少年与孟氏赠荅诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可惜春时节，","依然独自游。","无端两行泪，","长祇对花流。"],"stanzas":[["可惜春时节，","依然独自游。"],["无端两行泪，","长祇对花流。"]]}
{"id":"15d66d81e0","title":"维扬少年与孟氏赠荅诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁家少年儿，","心中暗自欺。","不道终不可，","可即恐郎知。"],"stanzas":[["谁家少年儿，","心中暗自欺。"],["不道终不可，","可即恐郎知。"]]}
{"id":"c108f3a3be","title":"维扬少年与孟氏赠荅诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["神女得张硕，","文君遇长卿。","逢时两相得，","聊足慰多情。"],"stanzas":[["神女得张硕，","文君遇长卿。"],["逢时两相得，","聊足慰多情。"]]}
{"id":"105535df94","title":"胡志忠题户","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恃勇祸必婴，","恃强势必倾。","胡为万金子，","而与恶物争。","休将逝魄趋府庭，","止于此馆归冥冥。"],"stanzas":[["恃勇祸必婴，","恃强势必倾。"],["胡为万金子，","而与恶物争。"],["休将逝魄趋府庭，","止于此馆归冥冥。"]]}
{"id":"a776e9f6ed","title":"高侍郎诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危冠高袖楚宫妆，","独步闲庭逐夜凉。","自把玉簪敲砌竹，","清歌一曲月如霜。"],"stanzas":[["危冠高袖楚宫妆，","独步闲庭逐夜凉。"],["自把玉簪敲砌竹，","清歌一曲月如霜。"]]}
{"id":"538321f8a8","title":"吕氏宅妖誓师词","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天马斜飞度三止，","上将横行击四方。","辎车直入无回翔，","六甲次第不乖行。"],"stanzas":[["天马斜飞度三止，","上将横行击四方。"],["辎车直入无回翔，","六甲次第不乖行。"]]}
