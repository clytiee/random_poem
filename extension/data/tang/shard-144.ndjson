{"id":"6bbec86c9e","title":"偈","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人若憎时我亦憎，","逃名最要是无能。","后生乞汝残风月，","自作深林不语僧。"],"stanzas":[["人若憎时我亦憎，","逃名最要是无能。"],["后生乞汝残风月，","自作深林不语僧。"]]}
{"id":"9895c9eb83","title":"鹂","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不是流莺独占春，","林间彩翠四时新。","应知拟上屏风画，","偏坐横枝亦向人。"],"stanzas":[["不是流莺独占春，","林间彩翠四时新。"],["应知拟上屏风画，","偏坐横枝亦向人。"]]}
{"id":"45dde3f8ce","title":"白菊杂书四首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄昏寒立更披襟，","露浥清香悦道心。","却笑谁家扃绣户，","正薰龙麝暖鸳衾。"],"stanzas":[["黄昏寒立更披襟，","露浥清香悦道心。"],["却笑谁家扃绣户，","正薰龙麝暖鸳衾。"]]}
{"id":"308be81103","title":"白菊杂书四首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["四面云屏一带天，","是非断得自翛然。","此生只是偿诗债，","白菊开时最不眠。"],"stanzas":[["四面云屏一带天，","是非断得自翛然。"],["此生只是偿诗债，","白菊开时最不眠。"]]}
{"id":"038e81db41","title":"白菊杂书四首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["狂才不足自英雄，","仆妾驱令学贩舂。","侯印几人封万户，","侬家只办买孤峰。"],"stanzas":[["狂才不足自英雄，","仆妾驱令学贩舂。"],["侯印几人封万户，","侬家只办买孤峰。"]]}
{"id":"87340f92d4","title":"白菊杂书四首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄鹂啭处谁同听，","白菊开时且剩过。","漫道南朝足流品，","由来叔宝不宜多。"],"stanzas":[["黄鹂啭处谁同听，","白菊开时且剩过。"],["漫道南朝足流品，","由来叔宝不宜多。"]]}
{"id":"ce92ffc624","title":"漫题","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["经乱年年厌别离，","歌声喜似太平时。","词臣更有中兴颂，","磨取莲峰便作碑。"],"stanzas":[["经乱年年厌别离，","歌声喜似太平时。"],["词臣更有中兴颂，","磨取莲峰便作碑。"]]}
{"id":"48971e4ea6","title":"率题","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宦路前衔闲不记，","醉乡佳境兴方浓。","一林高竹长遮日，","四壁寒山更闰冬。"],"stanzas":[["宦路前衔闲不记，","醉乡佳境兴方浓。"],["一林高竹长遮日，","四壁寒山更闰冬。"]]}
{"id":"67e762b296","title":"磵户","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["磵户芳烟接水邨，","乱来归得道仍存。","数竿新竹当轩上，","不羡侯家立戟门。"],"stanzas":[["磵户芳烟接水邨，","乱来归得道仍存。"],["数竿新竹当轩上，","不羡侯家立戟门。"]]}
{"id":"545443b721","title":"故乡杏花","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寄花寄酒喜新开，","左把花枝右把杯。","欲问花枝与杯酒，","故人何得不同来。"],"stanzas":[["寄花寄酒喜新开，","左把花枝右把杯。"],["欲问花枝与杯酒，","故人何得不同来。"]]}
{"id":"590cf2d8dc","title":"华下二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故国春归未有涯，","小栏高槛别人家。","五更惆怅回孤枕，","犹自残灯照落花。"],"stanzas":[["故国春归未有涯，","小栏高槛别人家。"],["五更惆怅回孤枕，","犹自残灯照落花。"]]}
{"id":"f9d7ad67ea","title":"华下二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["关外风昏欲雨天，","荠花耕倒枕河壖。","邨南寂寞时回望，","一只鸳鸯下渡船。"],"stanzas":[["关外风昏欲雨天，","荠花耕倒枕河壖。"],["邨南寂寞时回望，","一只鸳鸯下渡船。"]]}
{"id":"0d0f7ba3e0","title":"梦中","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几多亲爱在人间，","上彻霞梯会却还。","须是蓬瀛长买得，","一家同占作家山。"],"stanzas":[["几多亲爱在人间，","上彻霞梯会却还。"],["须是蓬瀛长买得，","一家同占作家山。"]]}
{"id":"7cfb6fbd4d","title":"牓下","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三十功名志未伸，","初将文字竞通津。","春风漫折一枝桂，","烟阁英雄笑杀人。"],"stanzas":[["三十功名志未伸，","初将文字竞通津。"],["春风漫折一枝桂，","烟阁英雄笑杀人。"]]}
{"id":"690305124e","title":"涔阳渡","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚田人立带残晖，","驿逈邨幽客路微。","两岸芦花正萧飒，","渚烟深处白牛归。"],"stanzas":[["楚田人立带残晖，","驿逈邨幽客路微。"],["两岸芦花正萧飒，","渚烟深处白牛归。"]]}
{"id":"dfa35f1900","title":"偶作","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["索得身归未保闲，","乱来道在辱来顽。","留侯万户虽无分，","病骨应消一片山。"],"stanzas":[["索得身归未保闲，","乱来道在辱来顽。"],["留侯万户虽无分，","病骨应消一片山。"]]}
{"id":"a9eb454930","title":"寓居有感三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亦知世路薄忠贞，","不忍残年负圣明。","只待东封沾庆赐，","碑阴别刻老臣名。"],"stanzas":[["亦知世路薄忠贞，","不忍残年负圣明。"],["只待东封沾庆赐，","碑阴别刻老臣名。"]]}
{"id":"294d124f3c","title":"寓居有感三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不放残年却到家，","衔杯懒更问生涯。","河堤往往人相送，","一曲晴川隔蓼花。"],"stanzas":[["不放残年却到家，","衔杯懒更问生涯。"],["河堤往往人相送，","一曲晴川隔蓼花。"]]}
{"id":"a1ecfcf034","title":"寓居有感三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黑须寄在白须生，","一度秋风减几茎。","客处不堪频送别，","无多情绪更伤情。"],"stanzas":[["黑须寄在白须生，","一度秋风减几茎。"],["客处不堪频送别，","无多情绪更伤情。"]]}
{"id":"5ecf92763b","title":"淮西","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鼇冠三山安海浪，","龙盘九鼎镇皇都。","莫夸十万兵威盛，","消个忠良效顺无。"],"stanzas":[["鼇冠三山安海浪，","龙盘九鼎镇皇都。"],["莫夸十万兵威盛，","消个忠良效顺无。"]]}
{"id":"0a2e4965bf","title":"河湟有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一自萧关起战尘，","河湟隔断异乡春。","汉儿尽作胡儿语，","却向城头骂汉人。"],"stanzas":[["一自萧关起战尘，","河湟隔断异乡春。"],["汉儿尽作胡儿语，","却向城头骂汉人。"]]}
{"id":"df88cbec6f","title":"自䢵乡北归","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巴烟幂幂久萦恨，","楚柳绵绵今送归。","回避江边同去鴈，","莫教惊起错南飞。"],"stanzas":[["巴烟幂幂久萦恨，","楚柳绵绵今送归。"],["回避江边同去鴈，","莫教惊起错南飞。"]]}
{"id":"de77840cda","title":"青龙师安上人","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灾曜偏临许国人，","雨中衰菊病中身。","清香一炷知师意，","应为昭陵惜老臣。"],"stanzas":[["灾曜偏临许国人，","雨中衰菊病中身。"],["清香一炷知师意，","应为昭陵惜老臣。"]]}
{"id":"4a9849a9bb","title":"山中","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凡鸟爱喧人静处，","闲云似妬月明时。","世间万事非吾事，","只愧秋来未有诗。"],"stanzas":[["凡鸟爱喧人静处，","闲云似妬月明时。"],["世间万事非吾事，","只愧秋来未有诗。"]]}
{"id":"24b59175e8","title":"有感二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自古经纶足是非，","阴谋最忌夺天机。","留侯却粒商翁去，","甲第何人意气归。"],"stanzas":[["自古经纶足是非，","阴谋最忌夺天机。"],["留侯却粒商翁去，","甲第何人意气归。"]]}
{"id":"21064baea0","title":"有感二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古来贤俊共悲辛，","长是豪家拒要津。","从此当歌唯痛饮，","不须经世为闲人。"],"stanzas":[["古来贤俊共悲辛，","长是豪家拒要津。"],["从此当歌唯痛饮，","不须经世为闲人。"]]}
{"id":"f26d03b77b","title":"闲夜二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道侣难留为虐棋，","邻家闻说厌吟诗。","前峰月照分明见，","夜合香中露卧时。"],"stanzas":[["道侣难留为虐棋，","邻家闻说厌吟诗。"],["前峰月照分明见，","夜合香中露卧时。"]]}
{"id":"5d1072f80b","title":"闲夜二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此身闲得易为家，","业是吟诗与看花。","若使他生抛笔砚，","更应无事老烟霞。"],"stanzas":[["此身闲得易为家，","业是吟诗与看花。"],["若使他生抛笔砚，","更应无事老烟霞。"]]}
{"id":"727e93f543","title":"雨中","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["维摩居士陶居士，","尽说高情未足夸。","簷外莲峰堦下菊，","碧莲黄菊是吾家。"],"stanzas":[["维摩居士陶居士，","尽说高情未足夸。"],["簷外莲峰堦下菊，","碧莲黄菊是吾家。"]]}
{"id":"12963f37b1","title":"送道者二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞天真侣昔曾逢，","西岳今居第几峰。","峰顶他时教我认，","相招须把碧芙蓉。"],"stanzas":[["洞天真侣昔曾逢，","西岳今居第几峰。"],["峰顶他时教我认，","相招须把碧芙蓉。"]]}
{"id":"530b85a7f7","title":"送道者二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殷勤不为学烧金，","道侣惟应识此心。","雪里千山访君易，","微微鹿迹入深林。"],"stanzas":[["殷勤不为学烧金，","道侣惟应识此心。"],["雪里千山访君易，","微微鹿迹入深林。"]]}
{"id":"34366af9ab","title":"重阳阻雨","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重阳阻雨独衔杯，","移得山家菊未开。","犹胜登高闲望断，","孤烟残照马嘶回。"],"stanzas":[["重阳阻雨独衔杯，","移得山家菊未开。"],["犹胜登高闲望断，","孤烟残照马嘶回。"]]}
{"id":"a76da787e6","title":"省试","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["粉闱深锁唱同人，","正是终南雪霁春。","闲系长安千匹马，","今朝似减六街尘。"],"stanzas":[["粉闱深锁唱同人，","正是终南雪霁春。"],["闲系长安千匹马，","今朝似减六街尘。"]]}
{"id":"15c6e8e28c","title":"有赠","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有诗有酒有高歌，","春色年年奈我何。","试问羲和能驻否，","不劳频借鲁阳戈。"],"stanzas":[["有诗有酒有高歌，","春色年年奈我何。"],["试问羲和能驻否，","不劳频借鲁阳戈。"]]}
{"id":"66af6e847c","title":"证因亭","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峰北幽亭愿证因，","他生此地却容身。","上方僧在时应到，","笑认前衔记写真。"],"stanzas":[["峰北幽亭愿证因，","他生此地却容身。"],["上方僧在时应到，","笑认前衔记写真。"]]}
{"id":"4e8e8ab5c7","title":"顷年陪恩地赴甘棠之召感动留题","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去时憔悴青衿在，","归路凄凉绛帐空。","无限酬恩心未展，","又将孤劒别从公。"],"stanzas":[["去时憔悴青衿在，","归路凄凉绛帐空。"],["无限酬恩心未展，","又将孤劒别从公。"]]}
{"id":"06e6f1995a","title":"九月八日","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已是人间寂寞花，","解怜寂寞傍贫家。","老来不得登高看，","更甚残春惜岁华。"],"stanzas":[["已是人间寂寞花，","解怜寂寞傍贫家。"],["老来不得登高看，","更甚残春惜岁华。"]]}
{"id":"83ef938ea7","title":"敷溪桥院有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔岁攀游景物同，","药炉今在鹤归空。","青山满眼泪堪碧，","绛帐无人花自红。"],"stanzas":[["昔岁攀游景物同，","药炉今在鹤归空。"],["青山满眼泪堪碧，","绛帐无人花自红。"]]}
{"id":"b331c4a63f","title":"寺阁","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔岁登临未衰飒，","不知何事爱伤情。","今来揽镜翻堪喜，","乱后霜须长几茎。"],"stanzas":[["昔岁登临未衰飒，","不知何事爱伤情。"],["今来揽镜翻堪喜，","乱后霜须长几茎。"]]}
{"id":"e9be5643d9","title":"武陵路","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["橘岸舟间罾网挂，","茶坡日暖鹧鸪啼。","女郎指点行人笑，","知向花间路已迷。"],"stanzas":[["橘岸舟间罾网挂，","茶坡日暖鹧鸪啼。"],["女郎指点行人笑，","知向花间路已迷。"]]}
{"id":"50e2150756","title":"南北史感遇十首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨淋麟阁名臣画，","雪卧龙庭猛将碑。","不用黄金铸侯印，","尽输公子买蛾眉。"],"stanzas":[["雨淋麟阁名臣画，","雪卧龙庭猛将碑。"],["不用黄金铸侯印，","尽输公子买蛾眉。"]]}
{"id":"086e90cdec","title":"南北史感遇十首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉世频封万户侯，","云台空峻谢风流。","江南不有名儒相，","齿冷中原笑未休。"],"stanzas":[["汉世频封万户侯，","云台空峻谢风流。"],["江南不有名儒相，","齿冷中原笑未休。"]]}
{"id":"fc73716a9b","title":"南北史感遇十首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天风斡海怒长鲸，","永固南来百万兵。","若向沧洲犹笑傲，","江山虚有石头城。"],"stanzas":[["天风斡海怒长鲸，","永固南来百万兵。"],["若向沧洲犹笑傲，","江山虚有石头城。"]]}
{"id":"b7aedbdc70","title":"南北史感遇十首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花迷公子玉楼恩，","镜弄佳人红粉春。","不信关山劳远戍，","绮罗香外任行尘。"],"stanzas":[["花迷公子玉楼恩，","镜弄佳人红粉春。"],["不信关山劳远戍，","绮罗香外任行尘。"]]}
{"id":"fcd35f6a8d","title":"南北史感遇十首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兵围梁殿金瓯破，","火发陈宫玉树摧。","奸佞岂能惭误国，","空令怀古更徘徊。"],"stanzas":[["兵围梁殿金瓯破，","火发陈宫玉树摧。"],["奸佞岂能惭误国，","空令怀古更徘徊。"]]}
{"id":"4b7d4adc07","title":"南北史感遇十首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行乐最宜连夜景，","太平方觉有春风。","千金尽把酬歌舞，","犹胜三边赏战功。"],"stanzas":[["行乐最宜连夜景，","太平方觉有春风。"],["千金尽把酬歌舞，","犹胜三边赏战功。"]]}
{"id":"bf525183f9","title":"南北史感遇十首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桃芳李艳年年发，","羌管蛮弦处处多。","海上应无三岛路，","人间惟有一声歌。"],"stanzas":[["桃芳李艳年年发，","羌管蛮弦处处多。"],["海上应无三岛路，","人间惟有一声歌。"]]}
{"id":"cf6d327ec1","title":"南北史感遇十首 八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳人自折一枝红，","把唱新词曲未终。","惟向眼前怜易落，","不如抛掷任春风。"],"stanzas":[["佳人自折一枝红，","把唱新词曲未终。"],["惟向眼前怜易落，","不如抛掷任春风。"]]}
{"id":"f09b81236e","title":"南北史感遇十首 九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["景阳楼下花钿镜，","玄武湖边锦绣旗。","昔日繁华今日恨，","雉媒声晚草芳时。"],"stanzas":[["景阳楼下花钿镜，","玄武湖边锦绣旗。"],["昔日繁华今日恨，","雉媒声晚草芳时。"]]}
{"id":"35bf0a7042","title":"南北史感遇十首 十","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱后人间尽不平，","秦川花木最伤情。","无穷红艳红尘里，","骤马分香散入营。"],"stanzas":[["乱后人间尽不平，","秦川花木最伤情。"],["无穷红艳红尘里，","骤马分香散入营。"]]}
{"id":"14531becef","title":"狂题二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["草堂旧隐犹招我，","烟阁英才不见君。","惆怅故山归未得，","酒狂呌断暮天云。"],"stanzas":[["草堂旧隐犹招我，","烟阁英才不见君。"],["惆怅故山归未得，","酒狂呌断暮天云。"]]}
{"id":"5f0a7a2b6a","title":"狂题二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["须知世乱身难保，","莫喜天晴菊并开。","长短此身长是客，","黄花更助白头催。"],"stanzas":[["须知世乱身难保，","莫喜天晴菊并开。"],["长短此身长是客，","黄花更助白头催。"]]}
{"id":"42a571c0fb","title":"红茶花","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["景物诗人见即夸，","岂怜高韵说红茶。","牡丹枉用三春力，","开得方知不是花。"],"stanzas":[["景物诗人见即夸，","岂怜高韵说红茶。"],["牡丹枉用三春力，","开得方知不是花。"]]}
{"id":"766cf792f3","title":"秋燕","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["从扑香尘拂面飞，","怜渠只为解相依。","经冬好近深炉暖，","何必千岩万水归。"],"stanzas":[["从扑香尘拂面飞，","怜渠只为解相依。"],["经冬好近深炉暖，","何必千岩万水归。"]]}
{"id":"e562acd64c","title":"见后鴈有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["笑尔穷通亦似人，","高飞偶滞莫悲辛。","却缘风雪频相阻，","只向关中待得春。"],"stanzas":[["笑尔穷通亦似人，","高飞偶滞莫悲辛。"],["却缘风雪频相阻，","只向关中待得春。"]]}
{"id":"a301cbd7e7","title":"移桃栽","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独临官路易伤摧，","从遣春风恣意开。","禅客笑移山上看，","流莺直到槛前来。"],"stanzas":[["独临官路易伤摧，","从遣春风恣意开。"],["禅客笑移山上看，","流莺直到槛前来。"]]}
{"id":"426003abaf","title":"忆中条","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕辞旅舍人空在，","萤出疎篱菊正芳。","堪恨昔年联句地，","念经僧扫过重阳。"],"stanzas":[["燕辞旅舍人空在，","萤出疎篱菊正芳。"],["堪恨昔年联句地，","念经僧扫过重阳。"]]}
{"id":"3d9dbe214c","title":"乐府","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五更窗下簇妆台，","已怕堂前阿母催。","满鸭香薰鹦鹉睡，","隔帘灯照牡丹开。"],"stanzas":[["五更窗下簇妆台，","已怕堂前阿母催。"],["满鸭香薰鹦鹉睡，","隔帘灯照牡丹开。"]]}
{"id":"8318372fc0","title":"放龟二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["却为多知自不灵，","今朝教汝卜长生。","若求深处无深处，","只有依人会有情。"],"stanzas":[["却为多知自不灵，","今朝教汝卜长生。"],["若求深处无深处，","只有依人会有情。"]]}
{"id":"fa96ffdd9d","title":"放龟二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世外犹迷不死庭，","人间莫恃自无营。","本期沧海堪投迹，","却向朱门待放生。"],"stanzas":[["世外犹迷不死庭，","人间莫恃自无营。"],["本期沧海堪投迹，","却向朱门待放生。"]]}
{"id":"f5e816a5e4","title":"灯花三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀柳丝丝幂画楼，","窗尘满镜不梳头。","几时金鴈传归信，","剪断香魂一缕愁。"],"stanzas":[["蜀柳丝丝幂画楼，","窗尘满镜不梳头。"],["几时金鴈传归信，","剪断香魂一缕愁。"]]}
{"id":"a77370f46a","title":"灯花三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姊姊教人且抱儿，","逐他女伴卸头迟。","明朝鬬草多应喜，","剪得灯花自扫眉。"],"stanzas":[["姊姊教人且抱儿，","逐他女伴卸头迟。"],["明朝鬬草多应喜，","剪得灯花自扫眉。"]]}
{"id":"19ed2c47df","title":"灯花三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闰前小雪过经旬，","犹自依依向主人。","开尽菊花怜强舞，","与教弟子待新春。"],"stanzas":[["闰前小雪过经旬，","犹自依依向主人。"],["开尽菊花怜强舞，","与教弟子待新春。"]]}
{"id":"a5e02bb9da","title":"偶题三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浮世悠悠旋一空，","多情偏解挫英雄。","风光只在歌声里，","不必楼前万树红。"],"stanzas":[["浮世悠悠旋一空，","多情偏解挫英雄。"],["风光只在歌声里，","不必楼前万树红。"]]}
{"id":"c13b1b2900","title":"偶题三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小池随事有风荷，","烧酹倾壶一曲歌。","欲待秋塘擎露看，","自怜生意已无多。"],"stanzas":[["小池随事有风荷，","烧酹倾壶一曲歌。"],["欲待秋塘擎露看，","自怜生意已无多。"]]}
{"id":"65fec198c0","title":"偶题三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["辽阳音信近来稀，","纵有虚传逼节归。","永日无人新睡觉，","小窗晴暖螖虫飞。"],"stanzas":[["辽阳音信近来稀，","纵有虚传逼节归。"],["永日无人新睡觉，","小窗晴暖螖虫飞。"]]}
{"id":"cc416ae164","title":"华下对菊","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清香裛露对高斋，","泛酒偏能浣旅怀。","不似春风逞红艳，","镜前空坠玉人钗。"],"stanzas":[["清香裛露对高斋，","泛酒偏能浣旅怀。"],["不似春风逞红艳，","镜前空坠玉人钗。"]]}
{"id":"9aaa4362b7","title":"与都统参谋书有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惊鸾迸鹭尽归林，","弱羽低垂分独沈。","带病深山犹草檄，","昭陵应识老臣心。"],"stanzas":[["惊鸾迸鹭尽归林，","弱羽低垂分独沈。"],["带病深山犹草檄，","昭陵应识老臣心。"]]}
{"id":"00f3a72fd2","title":"漫题","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无宦无名拘逸兴，","有歌有酒任他乡。","看看万里休征戍，","莫向新词寄断肠。"],"stanzas":[["无宦无名拘逸兴，","有歌有酒任他乡。"],["看看万里休征戍，","莫向新词寄断肠。"]]}
{"id":"b52da839c9","title":"商山二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清溪一路照羸身，","不似云台画像人。","国史数行犹有志，","只将谈笑继英尘。"],"stanzas":[["清溪一路照羸身，","不似云台画像人。"],["国史数行犹有志，","只将谈笑继英尘。"]]}
{"id":"3b76bbfb3e","title":"商山二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["马上搜奇已数篇，","籍中犹愧是顽仙。","关头传说开元事，","指点多疑孟浩然。"],"stanzas":[["马上搜奇已数篇，","籍中犹愧是顽仙。"],["关头传说开元事，","指点多疑孟浩然。"]]}
{"id":"eaa226c030","title":"与伏牛长老偈二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不算菩提与阐提，","惟应执著便生迷。","无端指个清凉地，","冻杀胡僧雪岭西。"],"stanzas":[["不算菩提与阐提，","惟应执著便生迷。"],["无端指个清凉地，","冻杀胡僧雪岭西。"]]}
{"id":"077a797745","title":"与伏牛长老偈二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长绳不见系空虚，","半偈传心亦未疎。","推倒我山无一事，","莫将文字缚真如。"],"stanzas":[["长绳不见系空虚，","半偈传心亦未疎。"],["推倒我山无一事，","莫将文字缚真如。"]]}
{"id":"41055bd20b","title":"客中重九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚老相逢泪满衣，","片名薄宦已知非。","他乡不似人间路，","应共东流更不归。"],"stanzas":[["楚老相逢泪满衣，","片名薄宦已知非。"],["他乡不似人间路，","应共东流更不归。"]]}
{"id":"3799994fc0","title":"柳二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁家按舞傍池塘，","已见繁枝嫩眼黄。","漫说早梅先得意，","不知春力暗分张。"],"stanzas":[["谁家按舞傍池塘，","已见繁枝嫩眼黄。"],["漫说早梅先得意，","不知春力暗分张。"]]}
{"id":"e5d10e31af","title":"柳二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["似拟凌寒妬早梅，","无端弄色傍高台。","折来未有新枝长，","莫遣佳人更折来。"],"stanzas":[["似拟凌寒妬早梅，","无端弄色傍高台。"],["折来未有新枝长，","莫遣佳人更折来。"]]}
{"id":"4513e1d2ff","title":"光启丁未别山","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["草堂琴画已判烧，","犹托邻僧护燕巢。","此去不缘名利去，","若逢逋客莫相嘲。"],"stanzas":[["草堂琴画已判烧，","犹托邻僧护燕巢。"],["此去不缘名利去，","若逢逋客莫相嘲。"]]}
{"id":"8e1d1ef255","title":"石楠","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["客处偷闲未是闲，","石楠虽好懒频攀。","如何风叶西归路，","吹断寒云见故山。"],"stanzas":[["客处偷闲未是闲，","石楠虽好懒频攀。"],["如何风叶西归路，","吹断寒云见故山。"]]}
{"id":"921030ce91","title":"力疾马上走笔","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酿黍长添不尽杯，","只忧花尽客空回。","垂杨且为晴遮日，","留遇重阳即放开。"],"stanzas":[["酿黍长添不尽杯，","只忧花尽客空回。"],["垂杨且为晴遮日，","留遇重阳即放开。"]]}
{"id":"2f4ebd6838","title":"华阴县楼","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹霄能有几层梯，","懒更扬鞭耸翠蜺。","偶凭危栏且南望，","不劳高掌欲相携。"],"stanzas":[["丹霄能有几层梯，","懒更扬鞭耸翠蜺。"],["偶凭危栏且南望，","不劳高掌欲相携。"]]}
{"id":"abf3e111bc","title":"南至四首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今冬腊后无残日，","故国烧来有几家。","却恨早梅添旅思，","强偷春力报年华。"],"stanzas":[["今冬腊后无残日，","故国烧来有几家。"],["却恨早梅添旅思，","强偷春力报年华。"]]}
{"id":"87454c6477","title":"南至四首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花时不是偏愁我，","好事应难总取他。","已被诗魔长役思，","眼中莫厌早梅多。"],"stanzas":[["花时不是偏愁我，","好事应难总取他。"],["已被诗魔长役思，","眼中莫厌早梅多。"]]}
{"id":"9182c1e31e","title":"南至四首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年华乱后偏堪惜，","世路抛来已自生。","犹有玉真长命缕，","樽前时唱缓羇情。"],"stanzas":[["年华乱后偏堪惜，","世路抛来已自生。"],["犹有玉真长命缕，","樽前时唱缓羇情。"]]}
{"id":"da782b62a9","title":"南至四首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一任喧阗绕四邻，","闲忙皆是自由身。","人来客去还须议，","莫遣他人作主人。"],"stanzas":[["一任喧阗绕四邻，","闲忙皆是自由身。"],["人来客去还须议，","莫遣他人作主人。"]]}
{"id":"ba20804db9","title":"莲峰前轩","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人间上寿若能添，","只向人间也不嫌。","看著四邻花竞发，","高楼从此莫垂帘。"],"stanzas":[["人间上寿若能添，","只向人间也不嫌。"],["看著四邻花竞发，","高楼从此莫垂帘。"]]}
{"id":"4955354366","title":"步虚","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阿母亲教学步虚，","三元长遣下蓬壶。","云韶韵俗停瑶瑟，","鸾鹤飞低拂宝炉。"],"stanzas":[["阿母亲教学步虚，","三元长遣下蓬壶。"],["云韶韵俗停瑶瑟，","鸾鹤飞低拂宝炉。"]]}
{"id":"e21966867e","title":"劒器","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼下公孙昔擅场，","空教女子爱军装。","潼关一败吴儿喜，","簇马骊山看御汤。"],"stanzas":[["楼下公孙昔擅场，","空教女子爱军装。"],["潼关一败吴儿喜，","簇马骊山看御汤。"]]}
{"id":"9e0e73a55c","title":"乙丑人日","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自怪扶持七十身，","归来又见故乡春。","今朝人日逢人喜，","不料偷生作老人。"],"stanzas":[["自怪扶持七十身，","归来又见故乡春。"],["今朝人日逢人喜，","不料偷生作老人。"]]}
{"id":"1dbda59f51","title":"携仙箓九首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岳北秋空渭北川，","晴云渐薄薄如烟。","坐来还见微风起，","吹散残阳一片蝉。"],"stanzas":[["岳北秋空渭北川，","晴云渐薄薄如烟。"],["坐来还见微风起，","吹散残阳一片蝉。"]]}
{"id":"3803167211","title":"携仙箓九首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一半晴空一半云，","远笼仙掌日初曛。","洞天有路不知处，","绝顶异香难更闻。"],"stanzas":[["一半晴空一半云，","远笼仙掌日初曛。"],["洞天有路不知处，","绝顶异香难更闻。"]]}
{"id":"b394bd4d7f","title":"携仙箓九首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["决事还须更事酬，","清谭妙理一时休。","渔翁亦被机心误，","眼暗汀边结钓钩。"],"stanzas":[["决事还须更事酬，","清谭妙理一时休。"],["渔翁亦被机心误，","眼暗汀边结钓钩。"]]}
{"id":"e148954c00","title":"携仙箓九首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["迹不趋时分不侯，","功名身外最悠悠。","听君总画麒麟阁，","还我闲眠舴艋舟。"],"stanzas":[["迹不趋时分不侯，","功名身外最悠悠。"],["听君总画麒麟阁，","还我闲眠舴艋舟。"]]}
{"id":"f1b55b9f66","title":"携仙箓九首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙凡路阻两难留，","烟树人间一片秋。","若道阴功能济活，","且将方寸自焚修。"],"stanzas":[["仙凡路阻两难留，","烟树人间一片秋。"],["若道阴功能济活，","且将方寸自焚修。"]]}
{"id":"7a1e06bff7","title":"携仙箓九首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["若有阴功救未然，","玉皇品籍亦搜贤。","应知谭笑还高谢，","别就沧洲赞上仙。"],"stanzas":[["若有阴功救未然，","玉皇品籍亦搜贤。"],["应知谭笑还高谢，","别就沧洲赞上仙。"]]}
{"id":"ccff803dbd","title":"携仙箓九首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["英名何用苦搜奇，","不朽才销一句诗。","却赖风波阻三岛，","老臣犹得恋明时。"],"stanzas":[["英名何用苦搜奇，","不朽才销一句诗。"],["却赖风波阻三岛，","老臣犹得恋明时。"]]}
{"id":"304c5a166f","title":"携仙箓九首 八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["剪取红云剩写诗，","年年高会趂花时。","水精楼阁分明见，","只欠霞浆别着旗。"],"stanzas":[["剪取红云剩写诗，","年年高会趂花时。"],["水精楼阁分明见，","只欠霞浆别着旗。"]]}
{"id":"9b04555921","title":"携仙箓九首 九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此生得作太平人，","只向尘中便出尘。","移取碧桃花万树，","年年自乐故乡春。"],"stanzas":[["此生得作太平人，","只向尘中便出尘。"],["移取碧桃花万树，","年年自乐故乡春。"]]}
{"id":"464a6df8e0","title":"浪淘沙","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不必长漂玉洞花，","曲中偏爱浪淘沙。","黄河却胜天河水，","万里萦纡入汉家。"],"stanzas":[["不必长漂玉洞花，","曲中偏爱浪淘沙。"],["黄河却胜天河水，","万里萦纡入汉家。"]]}
{"id":"6a4486ea1a","title":"赠日东鉴禅师","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故国无心度海潮，","老禅方丈倚中条。","夜深雨绝松堂静，","一点飞萤照寂寥。"],"stanzas":[["故国无心度海潮，","老禅方丈倚中条。"],["夜深雨绝松堂静，","一点飞萤照寂寥。"]]}
{"id":"486c353ee9","title":"暮春对柳二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["萦愁惹恨奈杨花，","闭户垂帘亦满家。","恼得闲人作酒病，","刚须又扑越溪茶。"],"stanzas":[["萦愁惹恨奈杨花，","闭户垂帘亦满家。"],["恼得闲人作酒病，","刚须又扑越溪茶。"]]}
{"id":"24dbf9b4e5","title":"暮春对柳二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞中犹说看桃花，","轻絮狂飞自俗家。","正是阶前开远信，","小娥旋拂碾新茶。"],"stanzas":[["洞中犹说看桃花，","轻絮狂飞自俗家。"],["正是阶前开远信，","小娥旋拂碾新茶。"]]}
{"id":"696dc6f8ba","title":"戊午三月晦二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["随风逐浪剧蓬萍，","圆首何曾解最灵。","笔砚近来多自弃，","不关妖气暗文星。"],"stanzas":[["随风逐浪剧蓬萍，","圆首何曾解最灵。"],["笔砚近来多自弃，","不关妖气暗文星。"]]}
{"id":"28bc5a4432","title":"戊午三月晦二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牛夸棋品无勍敌，","谢占诗家作上流。","岂似小敷春水涨，","年年鸾鹤待仙舟。"],"stanzas":[["牛夸棋品无勍敌，","谢占诗家作上流。"],["岂似小敷春水涨，","年年鸾鹤待仙舟。"]]}
{"id":"145deb5baa","title":"偶书五首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["情知了得未如僧，","客处高楼莫强登。","莺也解啼花也发，","不关心事最堪憎。"],"stanzas":[["情知了得未如僧，","客处高楼莫强登。"],["莺也解啼花也发，","不关心事最堪憎。"]]}
{"id":"9b4bbe8a43","title":"偶书五首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自有池荷作扇摇，","不关风动爱芭蕉。","只怜直上抽红蘂，","似我丹心向本朝。"],"stanzas":[["自有池荷作扇摇，","不关风动爱芭蕉。"],["只怜直上抽红蘂，","似我丹心向本朝。"]]}
{"id":"c0b8221589","title":"偶书五首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾看轻舟渡远津，","无风著岸不经旬。","只缘命蹇须知命，","却是人争阻得人。"],"stanzas":[["曾看轻舟渡远津，","无风著岸不经旬。"],["只缘命蹇须知命，","却是人争阻得人。"]]}
{"id":"a24a92d6ca","title":"偶书五首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上谷何曾解有情，","有情人自惜君行。","证因池上今生愿，","的的他生作化生。"],"stanzas":[["上谷何曾解有情，","有情人自惜君行。"],["证因池上今生愿，","的的他生作化生。"]]}
{"id":"55f5ebd8cb","title":"偶书五首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新店南原后夜程，","黄河风浪信难平。","渡头杨柳知人意，","为惹官船莫放行。"],"stanzas":[["新店南原后夜程，","黄河风浪信难平。"],["渡头杨柳知人意，","为惹官船莫放行。"]]}
{"id":"19f28085ab","title":"喜山鹊初归三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠衿红觜便知机，","久避重罗稳处飞。","只为从来偏护惜，","窗前今贺主人归。"],"stanzas":[["翠衿红觜便知机，","久避重罗稳处飞。"],["只为从来偏护惜，","窗前今贺主人归。"]]}
{"id":"9bbc88d1a5","title":"喜山鹊初归三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山中只是惜珍禽，","语不分明识尔心。","若使解言天下事，","燕台今筑几千金。"],"stanzas":[["山中只是惜珍禽，","语不分明识尔心。"],["若使解言天下事，","燕台今筑几千金。"]]}
{"id":"cde8e86667","title":"喜山鹊初归三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阻他罗网到柴扉，","不奈偷仓雀转肥。","赖尔林塘添景趣，","剩留山果引教归。"],"stanzas":[["阻他罗网到柴扉，","不奈偷仓雀转肥。"],["赖尔林塘添景趣，","剩留山果引教归。"]]}
{"id":"b3305b12fe","title":"虞乡北原","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泽北邨贫烟火狞，","稚田冬旱倩牛耕。","老人惆怅逢人诉，","开尽黄花麦未金。"],"stanzas":[["泽北邨贫烟火狞，","稚田冬旱倩牛耕。"],["老人惆怅逢人诉，","开尽黄花麦未金。"]]}
{"id":"50080cfd05","title":"洛中三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋风团扇未惊心，","笑看妆台落叶侵。","绣鳯不教金缕暗，","青楼何处有寒砧。"],"stanzas":[["秋风团扇未惊心，","笑看妆台落叶侵。"],["绣鳯不教金缕暗，","青楼何处有寒砧。"]]}
{"id":"6a0e4e6fd8","title":"洛中三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不用频嗟世路难，","浮生各自系悲懽。","风霜一夜添羇思，","罗绮谁家待早寒。"],"stanzas":[["不用频嗟世路难，","浮生各自系悲懽。"],["风霜一夜添羇思，","罗绮谁家待早寒。"]]}
{"id":"9230de5719","title":"洛中三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕巢空后谁相伴，","鸳被缝来不忍薰。","薄命敢辞长滴泪，","倡家未必肯留君。"],"stanzas":[["燕巢空后谁相伴，","鸳被缝来不忍薰。"],["薄命敢辞长滴泪，","倡家未必肯留君。"]]}
{"id":"67ab6542d2","title":"寓笔","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年年镊鬓到花飘，","依旧花繁鬓易凋。","撩乱一塲人更恨，","春风谁道胜轻飙。"],"stanzas":[["年年镊鬓到花飘，","依旧花繁鬓易凋。"],["撩乱一塲人更恨，","春风谁道胜轻飙。"]]}
{"id":"7fc53f907f","title":"戏题试衫","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝班尽说人宜紫，","洞府应无鹤着绯。","从此玉皇须破例，","染霞裁赐地仙衣。"],"stanzas":[["朝班尽说人宜紫，","洞府应无鹤着绯。"],["从此玉皇须破例，","染霞裁赐地仙衣。"]]}
{"id":"d0bc3a7fd5","title":"汴柳半枯因悲柳中隐","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行人莫叹前朝树，","已占河堤几百春。","惆怅题诗柳中隐，","柳衰犹在自无身。"],"stanzas":[["行人莫叹前朝树，","已占河堤几百春。"],["惆怅题诗柳中隐，","柳衰犹在自无身。"]]}
{"id":"4dd99493b8","title":"上方","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花落更同悲木落，","莺声相续即蝉声。","荣枯了得无多事，","只是闲人漫系情。"],"stanzas":[["花落更同悲木落，","莺声相续即蝉声。"],["荣枯了得无多事，","只是闲人漫系情。"]]}
{"id":"2ba8ba2c05","title":"寄王赞学","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄卷不关兼济业，","青山自保老闲身。","一行万里纤尘静，","可要张仪更入秦。"],"stanzas":[["黄卷不关兼济业，","青山自保老闲身。"],["一行万里纤尘静，","可要张仪更入秦。"]]}
{"id":"820aa811a6","title":"新节","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["转悲新岁重于山，","不似轻鸥肯复还。","朱绂纵教金印换，","青云未胜白头闲。"],"stanzas":[["转悲新岁重于山，","不似轻鸥肯复还。"],["朱绂纵教金印换，","青云未胜白头闲。"]]}
{"id":"f07a80c2f1","title":"自河西归山二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一水悠悠一叶危，","往来长恨阻归期。","乡关不是无华表，","自为多惊独上迟。"],"stanzas":[["一水悠悠一叶危，","往来长恨阻归期。"],["乡关不是无华表，","自为多惊独上迟。"]]}
{"id":"fb9abbf961","title":"自河西归山二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水阔风惊去路危，","孤舟欲上更迟迟。","鹤群长扰三珠树，","不借人间一只骑。"],"stanzas":[["水阔风惊去路危，","孤舟欲上更迟迟。"],["鹤群长扰三珠树，","不借人间一只骑。"]]}
{"id":"828ff3f2c5","title":"王官二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风荷似醉和花舞，","沙鸟无情伴客闲。","总是此中皆有恨，","更堪微雨半遮山。"],"stanzas":[["风荷似醉和花舞，","沙鸟无情伴客闲。"],["总是此中皆有恨，","更堪微雨半遮山。"]]}
{"id":"1ae00b98f5","title":"王官二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荷塘烟罩小斋虚，","景物皆宜入画图。","尽日无人只高卧，","一双白鸟隔纱厨。"],"stanzas":[["荷塘烟罩小斋虚，","景物皆宜入画图。"],["尽日无人只高卧，","一双白鸟隔纱厨。"]]}
{"id":"0f59c542d1","title":"贺翰林侍郎二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太白东归鹤背吟，","镜湖空在酒船沈。","今朝忽见银台事，","早晚重征入翰林。"],"stanzas":[["太白东归鹤背吟，","镜湖空在酒船沈。"],["今朝忽见银台事，","早晚重征入翰林。"]]}
{"id":"dff2dcdaec","title":"贺翰林侍郎二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉版征书洞里看，","沈羲新拜侍郎官。","文星喜气连台曜，","圣主方知四海安。"],"stanzas":[["玉版征书洞里看，","沈羲新拜侍郎官。"],["文星喜气连台曜，","圣主方知四海安。"]]}
{"id":"bd8af25abb","title":"寄王十四舍人","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几年汶上约同游，","拟为莲峰别置楼。","今日凤皇池畔客，","五千仞雪不回头。"],"stanzas":[["几年汶上约同游，","拟为莲峰别置楼。"],["今日凤皇池畔客，","五千仞雪不回头。"]]}
{"id":"e1c2ef5eda","title":"纶阁有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风涛曾阻化鳞来，","谁料蓬瀛路却开。","欲去迟迟还自笑，","狂才应不是仙才。"],"stanzas":[["风涛曾阻化鳞来，","谁料蓬瀛路却开。"],["欲去迟迟还自笑，","狂才应不是仙才。"]]}
{"id":"f2d72b6dcc","title":"狂题十八首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫恨艰危日日多，","时情其奈幸门何。","貔貅睡稳蛟龙渴，","犹把烧残朽铁磨。"],"stanzas":[["莫恨艰危日日多，","时情其奈幸门何。"],["貔貅睡稳蛟龙渴，","犹把烧残朽铁磨。"]]}
{"id":"5a7a28e712","title":"狂题十八首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["别鹤凄凉指法存，","戴逵能耻近王门。","世间第一风流事，","借得王公玉枕痕。"],"stanzas":[["别鹤凄凉指法存，","戴逵能耻近王门。"],["世间第一风流事，","借得王公玉枕痕。"]]}
{"id":"14174dd29a","title":"狂题十八首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["交疎自古戒言深，","肝胆徒倾致铄金。","不是史迁书与说，","谁知孤负李陵心。"],"stanzas":[["交疎自古戒言深，","肝胆徒倾致铄金。"],["不是史迁书与说，","谁知孤负李陵心。"]]}
{"id":"94998cbe7e","title":"狂题十八首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南华落笔似荒唐，","若肯经纶亦不狂。","偶作客星侵帝座，","却应虚薄是严光。"],"stanzas":[["南华落笔似荒唐，","若肯经纶亦不狂。"],["偶作客星侵帝座，","却应虚薄是严光。"]]}
{"id":"2682db9501","title":"狂题十八首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不劳世路更相猜，","忍到须休惜得材。","几度懒乘风水便，","抝船折舵恐难回。"],"stanzas":[["不劳世路更相猜，","忍到须休惜得材。"],["几度懒乘风水便，","抝船折舵恐难回。"]]}
{"id":"abe12e3aa7","title":"狂题十八首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["由来相爱只诗僧，","怪石长松自得朋。","却怕他生还识字，","依前日下作孤灯。"],"stanzas":[["由来相爱只诗僧，","怪石长松自得朋。"],["却怕他生还识字，","依前日下作孤灯。"]]}
{"id":"ec22fabda1","title":"狂题十八首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老禅乘仗莫过身，","远岫孤云见亦频。","应是佛边犹怕闹，","信缘须作且闲人。"],"stanzas":[["老禅乘仗莫过身，","远岫孤云见亦频。"],["应是佛边犹怕闹，","信缘须作且闲人。"]]}
{"id":"4c8671f0a0","title":"狂题十八首 八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["止竟闲人不爱闲，","只偷无事闭柴关。","轰霆搅破蛟龙窟，","也被狂风卷出山。"],"stanzas":[["止竟闲人不爱闲，","只偷无事闭柴关。"],["轰霆搅破蛟龙窟，","也被狂风卷出山。"]]}
{"id":"608236cc86","title":"狂题十八首 九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地下修文著作郎，","生前饥处倒空墙。","何如神爽骑星去，","犹自研几助玉皇。"],"stanzas":[["地下修文著作郎，","生前饥处倒空墙。"],["何如神爽骑星去，","犹自研几助玉皇。"]]}
{"id":"10067b4394","title":"狂题十八首 十","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨洗芭蕉叶上诗，","独来凭槛晚晴时。","故园虽恨风荷腻，","新句闲题亦满池。"],"stanzas":[["雨洗芭蕉叶上诗，","独来凭槛晚晴时。"],["故园虽恨风荷腻，","新句闲题亦满池。"]]}
{"id":"dec00209a0","title":"狂题十八首 十一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["初时拄杖向邻村，","渐到清明亦杜门。","三十年来辞病表，","今朝卧病感皇恩。"],"stanzas":[["初时拄杖向邻村，","渐到清明亦杜门。"],["三十年来辞病表，","今朝卧病感皇恩。"]]}
{"id":"5291a8c3c4","title":"狂题十八首 十二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["来时虽恨失青氊，","自见芭蕉几十篇。","应是阿刘还宿债，","剩拼才思折供钱。"],"stanzas":[["来时虽恨失青氊，","自见芭蕉几十篇。"],["应是阿刘还宿债，","剩拼才思折供钱。"]]}
{"id":"5a976382e9","title":"狂题十八首 十三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芭蕉丛畔碧婵娟，","免更悠悠扰蜀川。","应到去时题不尽，","不劳分寄校书牋。"],"stanzas":[["芭蕉丛畔碧婵娟，","免更悠悠扰蜀川。"],["应到去时题不尽，","不劳分寄校书牋。"]]}
{"id":"ade372d7ff","title":"狂题十八首 十四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自伤衰病渐难平，","永夜禅床雨滴声。","闻道虎疮仍带镞，","吼来和痛亦横行。"],"stanzas":[["自伤衰病渐难平，","永夜禅床雨滴声。"],["闻道虎疮仍带镞，","吼来和痛亦横行。"]]}
{"id":"47bdbe6459","title":"狂题十八首 十五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日流莺今日蝉，","起来又是夕阳天。","六龙飞辔长相窘，","更忍乘危自着鞭。"],"stanzas":[["昨日流莺今日蝉，","起来又是夕阳天。"],["六龙飞辔长相窘，","更忍乘危自着鞭。"]]}
{"id":"fdbaa0ab52","title":"狂题十八首 十六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有是有非还有虑，","无心无迹亦无猜。","不平便激风波险，","莫向安时稔祸胎。"],"stanzas":[["有是有非还有虑，","无心无迹亦无猜。"],["不平便激风波险，","莫向安时稔祸胎。"]]}
{"id":"8147736943","title":"狂题十八首 十七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十年三署让官频，","认得无才又索身。","莫道太行同一路，","大都安稳属闲人。"],"stanzas":[["十年三署让官频，","认得无才又索身。"],["莫道太行同一路，","大都安稳属闲人。"]]}
{"id":"c4dadb2ed5","title":"狂题十八首 十八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾闻劫火到蓬壶，","缩尽鼇头海亦枯。","今日家山同此恨，","人归未得鹤归无。"],"stanzas":[["曾闻劫火到蓬壶，","缩尽鼇头海亦枯。"],["今日家山同此恨，","人归未得鹤归无。"]]}
{"id":"a15750c691","title":"游仙二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛾眉新画觉婵娟，","鬬走将花阿母边。","仙曲教成慵不理，","玉阶相簇打金钱。"],"stanzas":[["蛾眉新画觉婵娟，","鬬走将花阿母边。"],["仙曲教成慵不理，","玉阶相簇打金钱。"]]}
{"id":"12e3360a9b","title":"游仙二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["刘郎相约事难谐，","雨散云飞自此乖。","月姊殷勤留不住，","碧空遗下水精钗。"],"stanzas":[["刘郎相约事难谐，","雨散云飞自此乖。"],["月姊殷勤留不住，","碧空遗下水精钗。"]]}
{"id":"bdbd1e3682","title":"漫书五首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长拟求闲未得闲，","又劳行役出秦关。","逢人渐觉乡音异，","却恨莺声似故山。"],"stanzas":[["长拟求闲未得闲，","又劳行役出秦关。"],["逢人渐觉乡音异，","却恨莺声似故山。"]]}
{"id":"e7a60adc48","title":"漫书五首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溪边随事有桑麻，","尽日山程十数家。","莫怪行人频怅望，","杜鹃不是故乡花。"],"stanzas":[["溪边随事有桑麻，","尽日山程十数家。"],["莫怪行人频怅望，","杜鹃不是故乡花。"]]}
{"id":"6b5b39d32f","title":"漫书五首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海上昔闻麋爱鹤，","山中今日鹿憎龟。","爱憎止竟须关分，","莫把微才望所知。"],"stanzas":[["海上昔闻麋爱鹤，","山中今日鹿憎龟。"],["爱憎止竟须关分，","莫把微才望所知。"]]}
{"id":"1b487f5c1f","title":"漫书五首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世路快心无好事，","恩门嘉话合书绅。","神藏鬼伏能千变，","亦胜忘机避要津。"],"stanzas":[["世路快心无好事，","恩门嘉话合书绅。"],["神藏鬼伏能千变，","亦胜忘机避要津。"]]}
{"id":"592dde341f","title":"漫书五首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["四翁识势保安闲，","须为生灵暂出山。","一种老人能算度，","磻溪心迹愧商颜。"],"stanzas":[["四翁识势保安闲，","须为生灵暂出山。"],["一种老人能算度，","磻溪心迹愧商颜。"]]}
{"id":"f699ec1935","title":"偶诗五首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲韵虽高不衒才，","偶抛猨鸟乍归来。","夕阳照个新红叶，","似要题诗落砚台。"],"stanzas":[["闲韵虽高不衒才，","偶抛猨鸟乍归来。"],["夕阳照个新红叶，","似要题诗落砚台。"]]}
{"id":"523e7cb338","title":"偶诗五首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芙蓉骚客空留怨，","芍药诗家只寄情。","谁似天才李山甫，","牡丹属思亦纵横。"],"stanzas":[["芙蓉骚客空留怨，","芍药诗家只寄情。"],["谁似天才李山甫，","牡丹属思亦纵横。"]]}
{"id":"ebc62b0a77","title":"偶诗五首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贤豪出处尽沉吟，","白日高悬只照心。","一掬信陵坟上土，","便如碣石累千金。"],"stanzas":[["贤豪出处尽沉吟，","白日高悬只照心。"],["一掬信陵坟上土，","便如碣石累千金。"]]}
{"id":"6682ea2671","title":"偶诗五首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["声貌由来固绝伦，","今朝共许占残春。","当歌莫怪频垂泪，","得地翻惭早失身。"],"stanzas":[["声貌由来固绝伦，","今朝共许占残春。"],["当歌莫怪频垂泪，","得地翻惭早失身。"]]}
{"id":"36d4d0265b","title":"偶诗五首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中宵茶鼎沸时惊，","正是寒窗竹雪明。","甘得寂寥能到老，","一生心地亦应平。"],"stanzas":[["中宵茶鼎沸时惊，","正是寒窗竹雪明。"],["甘得寂寥能到老，","一生心地亦应平。"]]}
{"id":"7b2a6d74a4","title":"杂题二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["先知左袒始同行，","须待龙楼羽翼成。","若使只凭三杰力，","犹应汉鼎一毫轻。"],"stanzas":[["先知左袒始同行，","须待龙楼羽翼成。"],["若使只凭三杰力，","犹应汉鼎一毫轻。"]]}
{"id":"4c817422e7","title":"杂题二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼在枯池鸟在林，","四时无奈雪霜侵。","若教激劝由真宰，","亦奖青松径寸心。"],"stanzas":[["鱼在枯池鸟在林，","四时无奈雪霜侵。"],["若教激劝由真宰，","亦奖青松径寸心。"]]}
{"id":"6b735a4716","title":"光化踏青有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["引得车回莫认恩，","却成寂寞与谁论。","到头不是君王意，","羞插垂杨更傍门。"],"stanzas":[["引得车回莫认恩，","却成寂寞与谁论。"],["到头不是君王意，","羞插垂杨更傍门。"]]}
{"id":"ddb68bed72","title":"丑年冬","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["醉日昔闻都下酒，","何如今喜折新茶。","不堪病渴仍多虑，","好向㴩湖便出家。"],"stanzas":[["醉日昔闻都下酒，","何如今喜折新茶。"],["不堪病渴仍多虑，","好向㴩湖便出家。"]]}
{"id":"1255abd4b4","title":"白菊三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人间万恨已难平，","栽得垂[杨]更系情。","犹喜闰前霜未下，","菊边依旧舞身轻。"],"stanzas":[["人间万恨已难平，","栽得垂[杨]更系情。"],["犹喜闰前霜未下，","菊边依旧舞身轻。"]]}
{"id":"c06b910677","title":"白菊三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫惜西风又起来，","犹能婀娜傍池台。","不辞暂被霜寒挫，","舞袖招香即却回。"],"stanzas":[["莫惜西风又起来，","犹能婀娜傍池台。"],["不辞暂被霜寒挫，","舞袖招香即却回。"]]}
{"id":"43d42fedc4","title":"白菊三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为报繁霜且莫催，","穷秋须到自低垂。","横拖长袖招人别，","只待春风却舞来。"],"stanzas":[["为报繁霜且莫催，","穷秋须到自低垂。"],["横拖长袖招人别，","只待春风却舞来。"]]}
{"id":"828be6729b","title":"扇","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珍重逢秋莫弃捐，","依依只仰故人怜。","有时池上遮残日，","承得霜林几个蝉。"],"stanzas":[["珍重逢秋莫弃捐，","依依只仰故人怜。"],["有时池上遮残日，","承得霜林几个蝉。"]]}
{"id":"b8bbea99c2","title":"修史亭三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山前邻叟去纷纷，","独强衰羸爱杜门。","渐觉一家看冷落，","地炉生火自温存。"],"stanzas":[["山前邻叟去纷纷，","独强衰羸爱杜门。"],["渐觉一家看冷落，","地炉生火自温存。"]]}
{"id":"d6fb559f58","title":"修史亭三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["甘心七十且酣歌，","自算平生幸已多。","不似香山白居士，","晚将心地著禅魔。"],"stanzas":[["甘心七十且酣歌，","自算平生幸已多。"],["不似香山白居士，","晚将心地著禅魔。"]]}
{"id":"ad2475bdc0","title":"修史亭三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乌纱巾上是青天，","检束酬知四十年。","谁料平生臂鹰手，","挑灯自送佛前钱。"],"stanzas":[["乌纱巾上是青天，","检束酬知四十年。"],["谁料平生臂鹰手，","挑灯自送佛前钱。"]]}
{"id":"7f362ef074","title":"力疾山下吴邨看杏花十九首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春来渐觉一川明，","马上繁花作阵迎。","掉臂只将诗酒敌，","不劳金鼓助横行。"],"stanzas":[["春来渐觉一川明，","马上繁花作阵迎。"],["掉臂只将诗酒敌，","不劳金鼓助横行。"]]}
{"id":"fc7c1e56e6","title":"力疾山下吴邨看杏花十九首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阊阖曾排捧御炉，","犹看晓月认金铺。","羸形不画凌烟阁，","只为微才激壮图。"],"stanzas":[["阊阖曾排捧御炉，","犹看晓月认金铺。"],["羸形不画凌烟阁，","只为微才激壮图。"]]}
{"id":"25008d142c","title":"力疾山下吴邨看杏花十九首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["镜留雪鬓暖消无，","春到棃花日又晡。","移取扶桑堦下种，","年年看长碍金乌。"],"stanzas":[["镜留雪鬓暖消无，","春到棃花日又晡。"],["移取扶桑堦下种，","年年看长碍金乌。"]]}
{"id":"b33c6f322d","title":"力疾山下吴邨看杏花十九首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["折来未尽不须休，","年少争来莫与留。","更愿狂风知我意，","一时吹向海西头。"],"stanzas":[["折来未尽不须休，","年少争来莫与留。"],["更愿狂风知我意，","一时吹向海西头。"]]}
{"id":"4e9adff2a6","title":"力疾山下吴邨看杏花十九首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["才情百巧鬬风光，","却笑雕花刻叶忙。","熨帖新巾来与裹，","犹看腾踏少年场。"],"stanzas":[["才情百巧鬬风光，","却笑雕花刻叶忙。"],["熨帖新巾来与裹，","犹看腾踏少年场。"]]}
{"id":"cae50583aa","title":"力疾山下吴邨看杏花十九首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浮世荣枯总不知，","且忧花阵被风欺。","侬家自有麒麟阁，","第一功名只赏诗。"],"stanzas":[["浮世荣枯总不知，","且忧花阵被风欺。"],["侬家自有麒麟阁，","第一功名只赏诗。"]]}
{"id":"0449561092","title":"力疾山下吴邨看杏花十九首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白衫裁袖本教宽，","朱紫由来亦一般。","王老小儿吹笛看，","我侬试舞尔侬看。"],"stanzas":[["白衫裁袖本教宽，","朱紫由来亦一般。"],["王老小儿吹笛看，","我侬试舞尔侬看。"]]}
{"id":"740bfc96c7","title":"力疾山下吴邨看杏花十九首 八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["单床薄被又羁栖，","待到花开亦甚迷。","若道折多还有罪，","只应莺啭是金鸡。"],"stanzas":[["单床薄被又羁栖，","待到花开亦甚迷。"],["若道折多还有罪，","只应莺啭是金鸡。"]]}
{"id":"da24302e17","title":"力疾山下吴邨看杏花十九首 九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["近来桃李半烧枯，","归卧乡园只老夫。","莫算明年人在否，","不知花得更开无。"],"stanzas":[["近来桃李半烧枯，","归卧乡园只老夫。"],["莫算明年人在否，","不知花得更开无。"]]}
{"id":"fb317e65d4","title":"力疾山下吴邨看杏花十九首 十","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉王何事损精神，","花满深宫不见春。","秾艳三千临粉镜，","独悲掩面李夫人。"],"stanzas":[["汉王何事损精神，","花满深宫不见春。"],["秾艳三千临粉镜，","独悲掩面李夫人。"]]}
{"id":"2a41438fd8","title":"力疾山下吴邨看杏花十九首 十一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["能艳能芳自一家，","胜鸾胜凤胜烟霞。","客来须共醒醒看，","碾尽明昌几角茶。"],"stanzas":[["能艳能芳自一家，","胜鸾胜凤胜烟霞。"],["客来须共醒醒看，","碾尽明昌几角茶。"]]}
{"id":"d980d76fda","title":"力疾山下吴邨看杏花十九首 十二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["造化无端欲自神，","裁红剪翠为新春。","不如分减闲心力，","更助英豪济活人。"],"stanzas":[["造化无端欲自神，","裁红剪翠为新春。"],["不如分减闲心力，","更助英豪济活人。"]]}
{"id":"982409de94","title":"力疾山下吴邨看杏花十九首 十三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["徘徊自劝莫沾缨，","分付年年谷口莺。","却赖无情容易别，","有情早个不胜情。"],"stanzas":[["徘徊自劝莫沾缨，","分付年年谷口莺。"],["却赖无情容易别，","有情早个不胜情。"]]}
{"id":"16f0f183b1","title":"力疾山下吴邨看杏花十九首 十四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲步偏宜舞袖迎，","春光何事独无情。","垂杨合是诗家物，","只爱敷溪道北生。"],"stanzas":[["闲步偏宜舞袖迎，","春光何事独无情。"],["垂杨合是诗家物，","只爱敷溪道北生。"]]}
{"id":"e0697959b7","title":"力疾山下吴邨看杏花十九首 十五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亦知王大是昌龄，","杜二其如律韵清。","还有酸寒堪笑处，","拟夸朱绂更峥嵘。"],"stanzas":[["亦知王大是昌龄，","杜二其如律韵清。"],["还有酸寒堪笑处，","拟夸朱绂更峥嵘。"]]}
{"id":"89df5f3c61","title":"力疾山下吴邨看杏花十九首 十六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["潘郎爱说是诗家，","枉占河阳一县花。","千载几人搜警句，","补方金字爱晴霞。"],"stanzas":[["潘郎爱说是诗家，","枉占河阳一县花。"],["千载几人搜警句，","补方金字爱晴霞。"]]}
{"id":"409b6945fb","title":"力疾山下吴邨看杏花十九首 十七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行乐溪边步转迟，","出山渐减探花期。","去年四度今三度，","恐到凭人折去时。"],"stanzas":[["行乐溪边步转迟，","出山渐减探花期。"],["去年四度今三度，","恐到凭人折去时。"]]}
{"id":"8faf406f46","title":"力疾山下吴邨看杏花十九首 十八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此身衰病转堪嗟，","长忍春寒独惜花。","更恨新诗无纸写，","蜀牋堆积是谁家。"],"stanzas":[["此身衰病转堪嗟，","长忍春寒独惜花。"],["更恨新诗无纸写，","蜀牋堆积是谁家。"]]}
{"id":"81bb2d946b","title":"力疾山下吴邨看杏花十九首 十九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日黄昏始看回，","梦中相约又衔杯。","起来闻到风飘却，","犹拟教人扫取来。"],"stanzas":[["昨日黄昏始看回，","梦中相约又衔杯。"],["起来闻到风飘却，","犹拟教人扫取来。"]]}
{"id":"d426197420","title":"少仪","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日登班缀柏台，","更惭起草属微才。","锦窠不是寻常锦，","兼向丘迟夺得来。"],"stanzas":[["昨日登班缀柏台，","更惭起草属微才。"],["锦窠不是寻常锦，","兼向丘迟夺得来。"]]}
{"id":"b9af8e63be","title":"重阳四首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["簷前减燕菊添芳，","燕尽庭前菊又荒。","老大比他年少少，","每逢佳节更悲凉。"],"stanzas":[["簷前减燕菊添芳，","燕尽庭前菊又荒。"],["老大比他年少少，","每逢佳节更悲凉。"]]}
{"id":"90046df19a","title":"重阳四首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨寒莫待菊花催，","须怕晴空暖并开。","开却一枝开却尽，","且随幽蝶更徘徊。"],"stanzas":[["雨寒莫待菊花催，","须怕晴空暖并开。"],["开却一枝开却尽，","且随幽蝶更徘徊。"]]}
{"id":"115db4151e","title":"重阳四首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青娥懒唱无衣换，","黄菊新开乞酒难。","长有长亭惆怅事，","隔河更得对凭栏。"],"stanzas":[["青娥懒唱无衣换，","黄菊新开乞酒难。"],["长有长亭惆怅事，","隔河更得对凭栏。"]]}
{"id":"d431e32337","title":"重阳四首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白发怕寒梳更懒，","黄花晴日照初开。","篱头应是蝶相报，","已被邻家携酒来。"],"stanzas":[["白发怕寒梳更懒，","黄花晴日照初开。"],["篱头应是蝶相报，","已被邻家携酒来。"]]}
{"id":"a28dacc99a","title":"长命缕","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["他乡处处堪悲事，","残照依依惜别天。","此去知名长命缕，","殷勤为我唱花前。"],"stanzas":[["他乡处处堪悲事，","残照依依惜别天。"],["此去知名长命缕，","殷勤为我唱花前。"]]}
{"id":"aabad18ff3","title":"柏东","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冥得机心岂在僧，","柏东闲步爱腾腾。","免教世路人相忌，","逢着村醪亦不憎。"],"stanzas":[["冥得机心岂在僧，","柏东闲步爱腾腾。"],["免教世路人相忌，","逢着村醪亦不憎。"]]}
{"id":"7764374cf9","title":"歌者十二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["追逐翻嫌傍管弦，","金钗击节自当筵。","风霜一夜燕鸿断，","唱作江南袚禊天。"],"stanzas":[["追逐翻嫌傍管弦，","金钗击节自当筵。"],["风霜一夜燕鸿断，","唱作江南袚禊天。"]]}
{"id":"b5ff2c1eb8","title":"歌者十二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉树花飘凤失栖，","一声初压管弦低。","清回烦署成潇洒，","艳逐寒云变惨凄。"],"stanzas":[["玉树花飘凤失栖，","一声初压管弦低。"],["清回烦署成潇洒，","艳逐寒云变惨凄。"]]}
{"id":"0d9af48ef3","title":"歌者十二首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十斛明珠亦易拼，","欲兼人艺古来难。","五云合是新声染，","镕作琼浆洒露盘。"],"stanzas":[["十斛明珠亦易拼，","欲兼人艺古来难。"],["五云合是新声染，","镕作琼浆洒露盘。"]]}
{"id":"a1b772f51d","title":"歌者十二首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不似新声唱亦新，","旋调玉管旋生春。","愁肠隔断珠帘外，","只为今宵共听人。"],"stanzas":[["不似新声唱亦新，","旋调玉管旋生春。"],["愁肠隔断珠帘外，","只为今宵共听人。"]]}
