{"id":"48bb531387","title":"题弋阳馆","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一叶飘然下弋阳，","残霞昏日树苍苍。","吴溪漫淬干将剑，","却是猨声断客肠。"],"stanzas":[["一叶飘然下弋阳，","残霞昏日树苍苍。"],["吴溪漫淬干将剑，","却是猨声断客肠。"]]}
{"id":"b556dda7dd","title":"题秀师影堂","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阴阴古寺杉松下，","记得长明一焰灯。","尽日看山人不会，","影堂中是别来僧。"],"stanzas":[["阴阴古寺杉松下，","记得长明一焰灯。"],["尽日看山人不会，","影堂中是别来僧。"]]}
{"id":"657b1c443c","title":"赠李修源","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岳阳新尉晓衙参，","却是傍人意未甘。","昨夜与君思贾谊，","长沙犹在洞庭南。"],"stanzas":[["岳阳新尉晓衙参，","却是傍人意未甘。"],["昨夜与君思贾谊，","长沙犹在洞庭南。"]]}
{"id":"0374868fbd","title":"瓜洲闻晓角","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒耿稀星照碧霄，","月楼吹角夜江遥。","五更人起烟霜静，","一曲残声遍落潮。"],"stanzas":[["寒耿稀星照碧霄，","月楼吹角夜江遥。"],["五更人起烟霜静，","一曲残声遍落潮。"]]}
{"id":"3018aaa04f","title":"元日仗","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文武千官岁仗兵，","万方同轨奏升平。","上皇一御含元殿，","丹凤门开白日明。"],"stanzas":[["文武千官岁仗兵，","万方同轨奏升平。"],["上皇一御含元殿，","丹凤门开白日明。"]]}
{"id":"6dd7215f57","title":"连昌宫","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙虎旌旗雨露飘，","玉楼歌断碧山遥。","玄宗上马太真去，","红树满园香自销。"],"stanzas":[["龙虎旌旗雨露飘，","玉楼歌断碧山遥。"],["玄宗上马太真去，","红树满园香自销。"]]}
{"id":"cdd3d299d8","title":"正月十五夜灯","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千门开锁万灯名，","正月中旬动帝京。","三百内人连袖舞，","一时天上著词声。"],"stanzas":[["千门开锁万灯名，","正月中旬动帝京。"],["三百内人连袖舞，","一时天上著词声。"]]}
{"id":"f63573405e","title":"上巳乐","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猩猩血彩系头标，","天上齐声举画桡。","却是内人争意切，","六宫红袖一时招。"],"stanzas":[["猩猩血彩系头标，","天上齐声举画桡。"],["却是内人争意切，","六宫红袖一时招。"]]}
{"id":"2ead48b7dc","title":"千秋乐","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八月平时花蕚楼，","万方同乐奏千秋。","倾城人看长竿出，","一伎初成赵解愁。"],"stanzas":[["八月平时花蕚楼，","万方同乐奏千秋。"],["倾城人看长竿出，","一伎初成赵解愁。"]]}
{"id":"e51e64dd5a","title":"春莺啭","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兴庆池南柳未开，","太真先把一枝梅。","内人已唱春莺啭，","花下傞傞软舞来。"],"stanzas":[["兴庆池南柳未开，","太真先把一枝梅。"],["内人已唱春莺啭，","花下傞傞软舞来。"]]}
{"id":"2f2eeaf8ee","title":"大酺乐二首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["车架东来值太平，","大酺三日洛阳城。","小儿一伎竿头绝，","天下传呼万岁声。"],"stanzas":[["车架东来值太平，","大酺三日洛阳城。"],["小儿一伎竿头绝，","天下传呼万岁声。"]]}
{"id":"171b013d7d","title":"大酺乐二首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫陌酺归日欲斜，","红尘开路薛王家。","双鬟笑说楼前鼓，","两仗争轮好落花。"],"stanzas":[["紫陌酺归日欲斜，","红尘开路薛王家。"],["双鬟笑说楼前鼓，","两仗争轮好落花。"]]}
{"id":"6711e9c108","title":"邠王小管","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虢国潜行韩国随，","宜春深院映花枝。","金舆远幸无人见，","偷把邠王小管吹。"],"stanzas":[["虢国潜行韩国随，","宜春深院映花枝。"],["金舆远幸无人见，","偷把邠王小管吹。"]]}
{"id":"37bd523ff9","title":"李谟笛","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平时东幸洛阳城，","天乐宫中夜彻明。","无奈李谟偷曲谱，","酒楼吹笛是新声。"],"stanzas":[["平时东幸洛阳城，","天乐宫中夜彻明。"],["无奈李谟偷曲谱，","酒楼吹笛是新声。"]]}
{"id":"00b7808f77","title":"宁哥来","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日映宫城雾半开，","太真帘下畏人猜。","黄翻绰指向西树，","不信宁哥回马来。"],"stanzas":[["日映宫城雾半开，","太真帘下畏人猜。"],["黄翻绰指向西树，","不信宁哥回马来。"]]}
{"id":"9ecd90817c","title":"丁巳年仲冬月江上作","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南来驱马渡江𣸣，","消息前年此月闻。","唯是贾先生恸哭，","不堪天意重阴云。"],"stanzas":[["南来驱马渡江𣸣，","消息前年此月闻。"],["唯是贾先生恸哭，","不堪天意重阴云。"]]}
{"id":"ca53e615e8","title":"邺中怀古","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["邺中城下漳河水，","日夜东流莫记春。","肠断宫中望陵处，","不堪台上也无人。"],"stanzas":[["邺中城下漳河水，","日夜东流莫记春。"],["肠断宫中望陵处，","不堪台上也无人。"]]}
{"id":"21aa9c0bb6","title":"读池州杜员外杜秋娘诗","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年少多情杜牧之，","风流仍作杜秋诗。","可知不是长门闭，","也得相如第一词。"],"stanzas":[["年少多情杜牧之，","风流仍作杜秋诗。"],["可知不是长门闭，","也得相如第一词。"]]}
{"id":"fd14fa1697","title":"杭州开元寺牡丹","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浓艳初开小药栏，","人人惆怅出长安。","风流却是钱塘寺，","不踏红尘见牡丹。"],"stanzas":[["浓艳初开小药栏，","人人惆怅出长安。"],["风流却是钱塘寺，","不踏红尘见牡丹。"]]}
{"id":"49dd665244","title":"招徐宗偃画松石","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["咫尺云山便出尘，","我生长日自因循。","凭君画取江南胜，","留向东斋伴老身。"],"stanzas":[["咫尺云山便出尘，","我生长日自因循。"],["凭君画取江南胜，","留向东斋伴老身。"]]}
{"id":"672c9df545","title":"平阴夏日作","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西来渐觉细尘红，","扰扰舟车路向东。","可惜夏天明月夜，","土山前面障南风。"],"stanzas":[["西来渐觉细尘红，","扰扰舟车路向东。"],["可惜夏天明月夜，","土山前面障南风。"]]}
{"id":"e45ab6c9b6","title":"赠处士","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小径上山山甚小，","每怜僧院笑僧禅。","人间莫道无难事，","二十年来已是玄。"],"stanzas":[["小径上山山甚小，","每怜僧院笑僧禅。"],["人间莫道无难事，","二十年来已是玄。"]]}
{"id":"d1b78aa7a5","title":"邠娘羯鼓","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新教邠娘羯鼓成，","大酺初日最先呈。","冬儿指向贞贞说，","一曲干鸣两杖轻。"],"stanzas":[["新教邠娘羯鼓成，","大酺初日最先呈。"],["冬儿指向贞贞说，","一曲干鸣两杖轻。"]]}
{"id":"b3488afde7","title":"退宫人二首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["开元皇帝掌中怜，","流落人间二十年。","长说承天门上宴，","百官楼下拾金钱。"],"stanzas":[["开元皇帝掌中怜，","流落人间二十年。"],["长说承天门上宴，","百官楼下拾金钱。"]]}
{"id":"8a19e98774","title":"退宫人二首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌喉渐退出宫闱，","泣话伶官上许归。","犹说入时欢圣寿，","内人初著五方衣。"],"stanzas":[["歌喉渐退出宫闱，","泣话伶官上许归。"],["犹说入时欢圣寿，","内人初著五方衣。"]]}
{"id":"b6558fc6c6","title":"耍娘歌","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宜春花夜雪千枝，","妃子偷行上密随。","便唤耍娘歌一曲，","六宫生老是蛾眉。"],"stanzas":[["宜春花夜雪千枝，","妃子偷行上密随。"],["便唤耍娘歌一曲，","六宫生老是蛾眉。"]]}
{"id":"2cad4e5c9b","title":"悖拏儿舞","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风南内百花时，","道唱梁州急遍吹。","揭手便拈金椀舞，","上皇惊笑悖拏儿。"],"stanzas":[["春风南内百花时，","道唱梁州急遍吹。"],["揭手便拈金椀舞，","上皇惊笑悖拏儿。"]]}
{"id":"330dc4ade8","title":"题灵彻上人旧房","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寞空门支道林，","满堂诗板旧知音。","秋风吹叶古廊下，","一半绳床灯影深。"],"stanzas":[["寂寞空门支道林，","满堂诗板旧知音。"],["秋风吹叶古廊下，","一半绳床灯影深。"]]}
{"id":"4daf8a9efa","title":"晚秋潼关西门作","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日落寒郊烟物清，","古槐阴黑少人行。","关门西去华山色，","秦地东来河水声。"],"stanzas":[["日落寒郊烟物清，","古槐阴黑少人行。"],["关门西去华山色，","秦地东来河水声。"]]}
{"id":"e44ca907f9","title":"赠内人","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禁门宫树月痕过，","媚眼唯看宿燕窠。","斜拔玉钗灯影畔，","剔开红焰救飞蛾。"],"stanzas":[["禁门宫树月痕过，","媚眼唯看宿燕窠。"],["斜拔玉钗灯影畔，","剔开红焰救飞蛾。"]]}
{"id":"27e2ead728","title":"洛中作","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["元和天子昔平戎，","惆怅金舆尚未通。","尽日洛桥闲处看，","秋风时节上阳宫。"],"stanzas":[["元和天子昔平戎，","惆怅金舆尚未通。"],["尽日洛桥闲处看，","秋风时节上阳宫。"]]}
{"id":"776bd6a46a","title":"折杨柳枝二首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫折宫前杨柳枝，","玄宗曾向笛中吹。","伤心日暮烟霞起，","无限春愁生翠眉。"],"stanzas":[["莫折宫前杨柳枝，","玄宗曾向笛中吹。"],["伤心日暮烟霞起，","无限春愁生翠眉。"]]}
{"id":"778e260f9d","title":"折杨柳枝二首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凝碧池边敛翠眉，","景阳楼下绾青丝。","那胜妃子朝元阁，","玉手和烟弄一枝。"],"stanzas":[["凝碧池边敛翠眉，","景阳楼下绾青丝。"],["那胜妃子朝元阁，","玉手和烟弄一枝。"]]}
{"id":"fb14ded18e","title":"华清宫四首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风树离离月稍明，","九天龙气在华清。","宫门深锁无人觉，","半夜云中羯鼓声。"],"stanzas":[["风树离离月稍明，","九天龙气在华清。"],["宫门深锁无人觉，","半夜云中羯鼓声。"]]}
{"id":"7f96c46e05","title":"华清宫四首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天阙沈沈夜未央，","碧云仙曲舞霓裳。","一声玉笛向空尽，","月满骊山宫漏长。"],"stanzas":[["天阙沈沈夜未央，","碧云仙曲舞霓裳。"],["一声玉笛向空尽，","月满骊山宫漏长。"]]}
{"id":"349b8e8a9d","title":"华清宫四首 三","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红树萧萧阁半开，","上皇曾幸此宫来。","至今风俗骊山下，","村笛犹吹阿滥堆。"],"stanzas":[["红树萧萧阁半开，","上皇曾幸此宫来。"],["至今风俗骊山下，","村笛犹吹阿滥堆。"]]}
{"id":"18d2fc6c81","title":"华清宫四首 四","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水绕宫墙处处声，","残红长绿露华清。","武皇一夕梦不觉，","十二玉楼空月明。"],"stanzas":[["水绕宫墙处处声，","残红长绿露华清。"],["武皇一夕梦不觉，","十二玉楼空月明。"]]}
{"id":"618f98a38e","title":"赠窦家小儿","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深绿衣裳小小人，","每来听里解相亲。","天生合去云霄上，","一尺松栽已出尘。"],"stanzas":[["深绿衣裳小小人，","每来听里解相亲。"],["天生合去云霄上，","一尺松栽已出尘。"]]}
{"id":"50d65722dc","title":"听崔莒侍御叶家歌","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宛罗重縠起歌筵，","活凤生花动碧烟。","一声唱断无人和，","触破秋云直上天。"],"stanzas":[["宛罗重縠起歌筵，","活凤生花动碧烟。"],["一声唱断无人和，","触破秋云直上天。"]]}
{"id":"abace6870c","title":"长门怨","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日映宫墙柳色寒，","笙歌遥指碧云端。","珠铅滴尽无心语，","强把花枝冷笑看。"],"stanzas":[["日映宫墙柳色寒，","笙歌遥指碧云端。"],["珠铅滴尽无心语，","强把花枝冷笑看。"]]}
{"id":"e0202b96e3","title":"读老庄","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["等闲缉缀闲言语，","夸向诗人唤作诗。","昨日偶拈庄老读，","万寻山上一毫厘。"],"stanzas":[["等闲缉缀闲言语，","夸向诗人唤作诗。"],["昨日偶拈庄老读，","万寻山上一毫厘。"]]}
{"id":"f005d4b5e4","title":"偶题","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古来名下岂虚为，","李白颠狂自称时。","唯恨世间无贺老，","谪仙长在没人知。"],"stanzas":[["古来名下岂虚为，","李白颠狂自称时。"],["唯恨世间无贺老，","谪仙长在没人知。"]]}
{"id":"da720b3b5b","title":"别玉华僊侣","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绕舍烟霞为四邻，","寒泉白石日相亲。","尘机不尽住不得，","珍重玉山山上人。"],"stanzas":[["绕舍烟霞为四邻，","寒泉白石日相亲。"],["尘机不尽住不得，","珍重玉山山上人。"]]}
{"id":"40ed2e30c9","title":"汴上送客","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河流西下鴈南飞，","楚客相逢泪湿衣。","张翰思归何太切，","扁舟不住又东归。"],"stanzas":[["河流西下鴈南飞，","楚客相逢泪湿衣。"],["张翰思归何太切，","扁舟不住又东归。"]]}
{"id":"15b0a92357","title":"邮亭残花","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云暗山横日欲斜，","邮亭下马对残花。","自从身逐征西府，","每到花时不在家。"],"stanzas":[["云暗山横日欲斜，","邮亭下马对残花。"],["自从身逐征西府，","每到花时不在家。"]]}
{"id":"f1e68d5ddd","title":"秋时送郑侍御","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["离鸿声怨碧云净，","楚瑟调高清晓天。","尽日相看俱不语，","西风摇落数枝莲。"],"stanzas":[["离鸿声怨碧云净，","楚瑟调高清晓天。"],["尽日相看俱不语，","西风摇落数枝莲。"]]}
{"id":"e9ea0d5380","title":"宿武牢关","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行人候晓久裴徊，","不待鸡鸣未得开。","堪羡寒溪自无事，","潺潺一夜宿关来。"],"stanzas":[["行人候晓久裴徊，","不待鸡鸣未得开。"],["堪羡寒溪自无事，","潺潺一夜宿关来。"]]}
{"id":"2245e5d038","title":"夜宿湓浦逢崔升","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江流不动月西沈，","南北行人万里心。","况是相逢鴈天夕，","星河寥落水云深。"],"stanzas":[["江流不动月西沈，","南北行人万里心。"],["况是相逢鴈天夕，","星河寥落水云深。"]]}
{"id":"6e5249975d","title":"京城寓怀","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三十年持一钓竿，","偶随书荐入长安。","由来不是求名者，","唯待春风看牡丹。"],"stanzas":[["三十年持一钓竿，","偶随书荐入长安。"],["由来不是求名者，","唯待春风看牡丹。"]]}
{"id":"35f5f7c2d8","title":"集灵台二首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日光斜照集灵台，","红树花迎晓露开。","昨夜上皇新授箓，","太真含笑入帘来。"],"stanzas":[["日光斜照集灵台，","红树花迎晓露开。"],["昨夜上皇新授箓，","太真含笑入帘来。"]]}
{"id":"7bd06eb487","title":"集灵台二首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虢国夫人承主恩，","平明骑马入宫门。","却嫌脂粉汚颜色，","淡扫蛾眉朝至尊。"],"stanzas":[["虢国夫人承主恩，","平明骑马入宫门。"],["却嫌脂粉汚颜色，","淡扫蛾眉朝至尊。"]]}
{"id":"96781b3b4d","title":"感归","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行却江南路几千，","归来不把一文钱。","乡人笑我穷寒鬼，","还似襄阳孟浩然。"],"stanzas":[["行却江南路几千，","归来不把一文钱。"],["乡人笑我穷寒鬼，","还似襄阳孟浩然。"]]}
{"id":"6aa8cac58b","title":"偶作","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["徧识青霄路上人，","相逢秖是语逡巡。","可胜饮尽江南酒，","岁月犹残李白身。"],"stanzas":[["徧识青霄路上人，","相逢秖是语逡巡。"],["可胜饮尽江南酒，","岁月犹残李白身。"]]}
{"id":"5e561f6eed","title":"劝饮酒","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烧得硫黄漫学仙，","未胜长付酒家钱。","窦常不吃齐推乐，","却在人间八十年。"],"stanzas":[["烧得硫黄漫学仙，","未胜长付酒家钱。"],["窦常不吃齐推乐，","却在人间八十年。"]]}
{"id":"53bf829673","title":"阿䳰汤","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月照宫城红树芳，","绿窗灯影在雕梁。","金舆未到长生殿，","妃子偷寻阿䳰汤。"],"stanzas":[["月照宫城红树芳，","绿窗灯影在雕梁。"],["金舆未到长生殿，","妃子偷寻阿䳰汤。"]]}
{"id":"85d794b4f4","title":"马嵬坡","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旌旗不整奈君何，","南去人稀北去多。","尘土已残香粉艳，","荔枝犹到马嵬坡。"],"stanzas":[["旌旗不整奈君何，","南去人稀北去多。"],["尘土已残香粉艳，","荔枝犹到马嵬坡。"]]}
{"id":"18a890b3e1","title":"太真香囊子","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蹙金妃子小花囊，","销耗胸前结旧香。","谁为君王重解得，","一生遗恨系心肠。"],"stanzas":[["蹙金妃子小花囊，","销耗胸前结旧香。"],["谁为君王重解得，","一生遗恨系心肠。"]]}
{"id":"c49fcc2753","title":"雨霖铃","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨霖铃夜却归秦，","犹见张徽一曲新。","长说上皇和泪教，","月明南内更无人。"],"stanzas":[["雨霖铃夜却归秦，","犹见张徽一曲新。"],["长说上皇和泪教，","月明南内更无人。"]]}
{"id":"079f02d122","title":"听歌二首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["儿郎漫说转喉轻，","须待情来意自生。","只是眼前丝竹和，","大家声里唱新声。"],"stanzas":[["儿郎漫说转喉轻，","须待情来意自生。"],["只是眼前丝竹和，","大家声里唱新声。"]]}
{"id":"0089f36ccd","title":"听歌二首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十二年前边塞行，","坐中无语叹歌情。","不堪昨夜先垂泪，","西去阳关第一声。"],"stanzas":[["十二年前边塞行，","坐中无语叹歌情。"],["不堪昨夜先垂泪，","西去阳关第一声。"]]}
{"id":"a4df01dc8a","title":"听筝","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十指纤纤玉笋红，","鴈行轻遏翠弦中。","分明似说长城苦，","水咽云寒一夜风。"],"stanzas":[["十指纤纤玉笋红，","鴈行轻遏翠弦中。"],["分明似说长城苦，","水咽云寒一夜风。"]]}
{"id":"a9397b002e","title":"王家琵琶","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金屑檀槽玉腕明，","子弦轻撚为多情。","只愁拍尽凉州破，","画出风雷是拨声。"],"stanzas":[["金屑檀槽玉腕明，","子弦轻撚为多情。"],["只愁拍尽凉州破，","画出风雷是拨声。"]]}
{"id":"eec92be3c4","title":"李家柘枝","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红铅拂脸细腰人，","金绣罗衫软著身。","长恐舞时残拍尽，","却思云雨更无因。"],"stanzas":[["红铅拂脸细腰人，","金绣罗衫软著身。"],["长恐舞时残拍尽，","却思云雨更无因。"]]}
{"id":"362f640c5b","title":"楚州韦中丞箜篌","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千重钩锁撼金铃，","万颗真珠泻玉瓶。","恰值满堂人欲醉，","甲光才触一时醒。"],"stanzas":[["千重钩锁撼金铃，","万颗真珠泻玉瓶。"],["恰值满堂人欲醉，","甲光才触一时醒。"]]}
{"id":"8d25cdb35f","title":"边上逢歌者","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["垂老秋歌出塞庭，","遏云相付旧秦青。","少年翻掷新声尽，","却向人前侧耳听。"],"stanzas":[["垂老秋歌出塞庭，","遏云相付旧秦青。"],["少年翻掷新声尽，","却向人前侧耳听。"]]}
{"id":"2dfb49b49e","title":"马嵬归","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云愁鸟恨驿坡前，","孑孑龙旗指望贤。","无复一生重语事，","柘黄衫袖掩潸然。"],"stanzas":[["云愁鸟恨驿坡前，","孑孑龙旗指望贤。"],["无复一生重语事，","柘黄衫袖掩潸然。"]]}
{"id":"109c2052b1","title":"塞上闻笛","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一夜梅花笛里飞，","冷沙晴槛月光辉。","北风吹尽向何处，","高入塞云燕鴈稀。"],"stanzas":[["一夜梅花笛里飞，","冷沙晴槛月光辉。"],["北风吹尽向何处，","高入塞云燕鴈稀。"]]}
{"id":"083c2fe392","title":"经旧游","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去年来送行人处，","依旧虫声古岸南。","斜日照溪云影断，","水葓花穗倒空潭。"],"stanzas":[["去年来送行人处，","依旧虫声古岸南。"],["斜日照溪云影断，","水葓花穗倒空潭。"]]}
{"id":"bc65a24c8b","title":"东山寺","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒色苍苍老栢风，","石苔清滑露光融。","半夜四山钟磬尽，","水精宫殿月玲珑。"],"stanzas":[["寒色苍苍老栢风，","石苔清滑露光融。"],["半夜四山钟磬尽，","水精宫殿月玲珑。"]]}
{"id":"98547e448f","title":"峰顶寺","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月明如水山头寺，","仰面看天石上行。","夜半深廊人语定，","一枝松动鹤来声。"],"stanzas":[["月明如水山头寺，","仰面看天石上行。"],["夜半深廊人语定，","一枝松动鹤来声。"]]}
{"id":"7b9047ad3d","title":"题润州鹤林寺","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古寺名僧多异时，","道情虚遣俗情悲。","千年鹤在市朝变，","来去旧山人不知。"],"stanzas":[["古寺名僧多异时，","道情虚遣俗情悲。"],["千年鹤在市朝变，","来去旧山人不知。"]]}
{"id":"9f1fafedd0","title":"题胜上人山房","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清昼房廊山半开，","一瓶新汲洒莓苔。","古松百尺始生叶，","飒飒风声天上来。"],"stanzas":[["清昼房廊山半开，","一瓶新汲洒莓苔。"],["古松百尺始生叶，","飒飒风声天上来。"]]}
{"id":"76668a8223","title":"李夫人词","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["延年不语望三星，","莫说夫人上涕零。","争奈世间惆怅在，","甘泉宫夜看图形。"],"stanzas":[["延年不语望三星，","莫说夫人上涕零。"],["争奈世间惆怅在，","甘泉宫夜看图形。"]]}
{"id":"9fb639c40a","title":"题金陵渡","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金陵津渡小山楼，","一宿行人自可愁。","潮落夜江斜月里，","两三星火是瓜州。"],"stanzas":[["金陵津渡小山楼，","一宿行人自可愁。"],["潮落夜江斜月里，","两三星火是瓜州。"]]}
{"id":"91f20b0aa3","title":"过阴陵","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["壮士凄惶到山下，","行人惆怅上山头。","生前此路已迷失，","寂寞孤魂何处游。"],"stanzas":[["壮士凄惶到山下，","行人惆怅上山头。"],["生前此路已迷失，","寂寞孤魂何处游。"]]}
{"id":"989d8d68b9","title":"纵游淮南","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十里长街市井连，","月明桥上看神仙。","人生只合扬州死，","禅智山光好墓田。"],"stanzas":[["十里长街市井连，","月明桥上看神仙。"],["人生只合扬州死，","禅智山光好墓田。"]]}
{"id":"95f1e9ab00","title":"登乐游原","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几年诗酒滞江干，","水积云重思万端。","今日南方惆怅尽，","乐游原上见长安。"],"stanzas":[["几年诗酒滞江干，","水积云重思万端。"],["今日南方惆怅尽，","乐游原上见长安。"]]}
{"id":"b2fc8f4d61","title":"过石头城","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["累累墟墓葬西原，","六代同归蔓草根。","唯是岁华流尽处，","石头城下水千痕。"],"stanzas":[["累累墟墓葬西原，","六代同归蔓草根。"],["唯是岁华流尽处，","石头城下水千痕。"]]}
{"id":"e041a6f2e9","title":"黄蜀葵花","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名花八叶嫩黄金，","色照书窗透竹林。","无奈美人闲把嗅，","直疑檀口印中心。"],"stanzas":[["名花八叶嫩黄金，","色照书窗透竹林。"],["无奈美人闲把嗅，","直疑檀口印中心。"]]}
{"id":"3cd0c23c74","title":"杨花","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["散乱随风处处匀，","庭前几日雪花新。","无端惹著潘郎鬓，","惊杀绿窗红粉人。"],"stanzas":[["散乱随风处处匀，","庭前几日雪花新。"],["无端惹著潘郎鬓，","惊杀绿窗红粉人。"]]}
{"id":"bb4587418a","title":"蔷薇花","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓风抹尽燕支颗，","夜雨催成蜀锦机。","当昼开时正明媚，","故乡疑是买臣归。"],"stanzas":[["晓风抹尽燕支颗，","夜雨催成蜀锦机。"],["当昼开时正明媚，","故乡疑是买臣归。"]]}
{"id":"6c97cb7656","title":"戏颜郎中猎","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忽闻射猎出军城，","人著戎衣马带缨。","倒把角弓呈一箭，","满川狐兔当头行。"],"stanzas":[["忽闻射猎出军城，","人著戎衣马带缨。"],["倒把角弓呈一箭，","满川狐兔当头行。"]]}
{"id":"86d005e03e","title":"江上旅泊呈杜员外","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牛渚南来沙岸长，","远吟佳句望池阳。","野人未必非毛遂，","太守还须是孟尝。"],"stanzas":[["牛渚南来沙岸长，","远吟佳句望池阳。"],["野人未必非毛遂，","太守还须是孟尝。"]]}
{"id":"dbcb936c4f","title":"容儿钵头","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["争走金车叱鞅牛，","笑声唯是说千秋。","两边角子羊门里，","犹学容儿弄钵头。"],"stanzas":[["争走金车叱鞅牛，","笑声唯是说千秋。"],["两边角子羊门里，","犹学容儿弄钵头。"]]}
{"id":"8a8a3cf185","title":"热戏乐","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["热戏争心剧火烧，","铜槌暗热不相饶。","上皇失喜宁王笑，","百尺幢竿果动摇。"],"stanzas":[["热戏争心剧火烧，","铜槌暗热不相饶。"],["上皇失喜宁王笑，","百尺幢竿果动摇。"]]}
{"id":"e61a083e36","title":"玉环琵琶","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫楼一曲琵琶声，","满眼云山是去程。","回顾段师非汝意，","玉环休把恨分明。"],"stanzas":[["宫楼一曲琵琶声，","满眼云山是去程。"],["回顾段师非汝意，","玉环休把恨分明。"]]}
{"id":"8b1826e04d","title":"题酸枣驿前碑","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍苔古涩自雕疎，","谁道中郎笔力余。","长爱当时遇王粲，","每来碑下不关书。"],"stanzas":[["苍苔古涩自雕疎，","谁道中郎笔力余。"],["长爱当时遇王粲，","每来碑下不关书。"]]}
{"id":"f422787c50","title":"题朱兵曹山居","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱氏西斋万卷书，","水门山阔自高疎。","我来穿穴非无意，","愿向君家作壁鱼。"],"stanzas":[["朱氏西斋万卷书，","水门山阔自高疎。"],["我来穿穴非无意，","愿向君家作壁鱼。"]]}
{"id":"0f40045117","title":"题画僧二首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["骨峭情高彼岸人，","一杯长泛海为津。","僧仪又入清流品，","却恐前生是许询。"],"stanzas":[["骨峭情高彼岸人，","一杯长泛海为津。"],["僧仪又入清流品，","却恐前生是许询。"]]}
{"id":"92b9584eaa","title":"题画僧二首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瘦颈隆肩碧眼生，","翰林亲赞虎头能。","终年不语看如意，","似证禅心入大乘。"],"stanzas":[["瘦颈隆肩碧眼生，","翰林亲赞虎头能。"],["终年不语看如意，","似证禅心入大乘。"]]}
{"id":"d6a5cedeb4","title":"送走马使","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新样花文配蜀罗，","同心双带蹙金蛾。","惯将喉舌传军好，","马迹铃声遍两河。"],"stanzas":[["新样花文配蜀罗，","同心双带蹙金蛾。"],["惯将喉舌传军好，","马迹铃声遍两河。"]]}
{"id":"1eb02a08c3","title":"题御沟","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万树垂杨拂御沟，","溶溶漾漾绕神州。","都缘济物心无阻，","从此恩波处处流。"],"stanzas":[["万树垂杨拂御沟，","溶溶漾漾绕神州。"],["都缘济物心无阻，","从此恩波处处流。"]]}
{"id":"72c8e10dd3","title":"题青龙寺","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二十年沈沧海间，","一游京国也应闲。","人人尽到求名处，","独向青龙寺看山。"],"stanzas":[["二十年沈沧海间，","一游京国也应闲。"],["人人尽到求名处，","独向青龙寺看山。"]]}
{"id":"1715c482e5","title":"硫黄","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一粒硫黄入贵门，","寝堂深处问玄言。","时人尽说韦山甫，","昨日余干吊子孙。"],"stanzas":[["一粒硫黄入贵门，","寝堂深处问玄言。"],["时人尽说韦山甫，","昨日余干吊子孙。"]]}
{"id":"eb0a6f7718","title":"散花楼","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦江城外锦城头，","回望秦川上轸忧。","正值血魂来梦里，","杜鹃声在散花楼。"],"stanzas":[["锦江城外锦城头，","回望秦川上轸忧。"],["正值血魂来梦里，","杜鹃声在散花楼。"]]}
{"id":"1d0f9ab552","title":"王家五弦","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五条弦出万端情，","撚拨间关漫态生。","唯羡风流田太守，","小金铃子耳边鸣。"],"stanzas":[["五条弦出万端情，","撚拨间关漫态生。"],["唯羡风流田太守，","小金铃子耳边鸣。"]]}
{"id":"ff7072064f","title":"听薛阳陶吹芦管","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫清人下薛阳陶，","末曲新笳调更高。","无奈一声天外绝，","百年已死断肠刀。"],"stanzas":[["紫清人下薛阳陶，","末曲新笳调更高。"],["无奈一声天外绝，","百年已死断肠刀。"]]}
{"id":"cba6a76f1f","title":"过汾水关","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千里南来背日行，","关门无事一侯嬴。","山根百尺路前去，","十夜耳中汾水声。"],"stanzas":[["千里南来背日行，","关门无事一侯嬴。"],["山根百尺路前去，","十夜耳中汾水声。"]]}
{"id":"f9324c98a1","title":"樱桃","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石榴未拆梅犹小，","爱此山花四五株。","斜日庭前风嬝嬝，","碧油千片漏红珠。"],"stanzas":[["石榴未拆梅犹小，","爱此山花四五株。"],["斜日庭前风嬝嬝，","碧油千片漏红珠。"]]}
{"id":"3ced82d0b7","title":"酬凌秀才惠枕","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八寸黄杨惠不轻，","虎头光照簟文清。","空心想此缘成梦，","拔剑灯前一夜行。"],"stanzas":[["八寸黄杨惠不轻，","虎头光照簟文清。"],["空心想此缘成梦，","拔剑灯前一夜行。"]]}
{"id":"5391831e39","title":"感春申君","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["薄俗何心议感恩，","谄容卑迹赖君门。","春申还道三千客，","寂寞无人杀李园。"],"stanzas":[["薄俗何心议感恩，","谄容卑迹赖君门。"],["春申还道三千客，","寂寞无人杀李园。"]]}
{"id":"9b050e6777","title":"孟才人叹","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶因歌态咏娇嚬，","传唱宫中十二春。","却为一声河满子，","下泉须吊旧才人。"],"stanzas":[["偶因歌态咏娇嚬，","传唱宫中十二春。"],["却为一声河满子，","下泉须吊旧才人。"]]}
{"id":"e0a8bf609a","title":"听简上人吹芦管三首 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀国僧吹芦一枝，","陇西游客泪先垂。","至今留得新声在，","却为中原人不知。"],"stanzas":[["蜀国僧吹芦一枝，","陇西游客泪先垂。"],["至今留得新声在，","却为中原人不知。"]]}
{"id":"fdcb2ebfd7","title":"听简上人吹芦管三首 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细芦僧管夜沈沈，","越鸟巴猨寄恨吟。","吹到耳边声尽处，","一条丝断碧云心。"],"stanzas":[["细芦僧管夜沈沈，","越鸟巴猨寄恨吟。"],["吹到耳边声尽处，","一条丝断碧云心。"]]}
{"id":"7c5c5f9951","title":"听简上人吹芦管三首 三","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月落江城树绕鸦，","一声芦管是天涯。","分明西国人来说，","赤佛堂西是汉家。"],"stanzas":[["月落江城树绕鸦，","一声芦管是天涯。"],["分明西国人来说，","赤佛堂西是汉家。"]]}
{"id":"d72a70aee3","title":"听岳州徐员外弹琴","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉律潜符一古琴，","哲人心见圣人心。","尽日南风似遗意，","九疑猨鸟满山吟。"],"stanzas":[["玉律潜符一古琴，","哲人心见圣人心。"],["尽日南风似遗意，","九疑猨鸟满山吟。"]]}
{"id":"7e58e3f5f1","title":"钩弋夫人词","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惆怅云陵事不回，","万金重更筑仙台。","莫言天上无消息，","犹是夫人作鸟来。"],"stanzas":[["惆怅云陵事不回，","万金重更筑仙台。"],["莫言天上无消息，","犹是夫人作鸟来。"]]}
{"id":"53a6ac99be","title":"鸿沟","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙蛇百战争天下，","各制雄心指此沟。","宁似九州分国土，","地图初割海中流。"],"stanzas":[["龙蛇百战争天下，","各制雄心指此沟。"],["宁似九州分国土，","地图初割海中流。"]]}
{"id":"2415a80842","title":"悲纳铁","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长闻为政古诸侯，","使佩刀人尽佩牛。","谁谓今来正耕垦，","却销农器作戈矛。"],"stanzas":[["长闻为政古诸侯，","使佩刀人尽佩牛。"],["谁谓今来正耕垦，","却销农器作戈矛。"]]}
{"id":"17cc46bf92","title":"胡渭州","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亭亭孤月照行舟，","寂寂长江万里流。","乡国不知何处是，","云山漫漫使人愁。"],"stanzas":[["亭亭孤月照行舟，","寂寂长江万里流。"],["乡国不知何处是，","云山漫漫使人愁。"]]}
{"id":"73e740a55d","title":"破阵乐","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋风四面足风沙，","塞外征人暂别家。","千里不辞行路远，","时光早晚到天涯。"],"stanzas":[["秋风四面足风沙，","塞外征人暂别家。"],["千里不辞行路远，","时光早晚到天涯。"]]}
{"id":"5cc025d094","title":"枫桥","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长洲苑外草萧萧，","却算游城岁月遥。","唯有别时今不忘，","暮烟疎雨过枫桥。"],"stanzas":[["长洲苑外草萧萧，","却算游城岁月遥。"],["唯有别时今不忘，","暮烟疎雨过枫桥。"]]}
{"id":"7456f1c690","title":"句","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万国见清道，","一身成白头。","此地荣辱盛，","岂宜山中人。","椿儿绕树春园里，","桂子寻花夜月中。","一身扶杖二儿随。","夏雨莲苞破，","秋风桂子雕。","杜鹃花发杜鹃叫，","乌臼花生乌臼啼。","茶风无奈笔，","酒秃不胜簪。"],"stanzas":[["万国见清道，","一身成白头。"],["此地荣辱盛，","岂宜山中人。"],["椿儿绕树春园里，","桂子寻花夜月中。"],["一身扶杖二儿随。"],["夏雨莲苞破，","秋风桂子雕。"],["杜鹃花发杜鹃叫，","乌臼花生乌臼啼。"],["茶风无奈笔，","酒秃不胜簪。"]]}
{"id":"93ed3a98b4","title":"荅李昌期","author":"杨洵美","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三山载群仙，","峨峨咸浪中。","云衣剪不得，","此路安可从。","我生亦何事，","出门如飞蓬。","白日又黄昏，","所悲瑶草空。","虫声故乡梦，","枕上禾黍风。"],"stanzas":[["三山载群仙，","峨峨咸浪中。"],["云衣剪不得，","此路安可从。"],["我生亦何事，","出门如飞蓬。"],["白日又黄昏，","所悲瑶草空。"],["虫声故乡梦，","枕上禾黍风。"]]}
{"id":"11322c5520","title":"宫词","author":"长孙翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一道甘泉接御沟，","上皇行处不曾秋。","谁言水是无情物，","也到宫前咽不流。"],"stanzas":[["一道甘泉接御沟，","上皇行处不曾秋。"],["谁言水是无情物，","也到宫前咽不流。"]]}
{"id":"f397ae93ee","title":"和于中丞登越王楼见寄","author":"卢求","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高情推谢守，","善政属绵州。","未落紫泥诏，","闲登白雪楼。","晴江如送日，","寒岭镇迎秋。","满壁朝天士，","唯予不系舟。"],"stanzas":[["高情推谢守，","善政属绵州。"],["未落紫泥诏，","闲登白雪楼。"],["晴江如送日，","寒岭镇迎秋。"],["满壁朝天士，","唯予不系舟。"]]}
{"id":"b775917376","title":"雨","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细雨弄春阴，","余寒入昼深。","山姿轻薄雾，","烟色澹幽林。","鹿践莓苔滑，","鱼牵水荇沈。","怀情方未已，","清酒漫须斟。"],"stanzas":[["细雨弄春阴，","余寒入昼深。"],["山姿轻薄雾，","烟色澹幽林。"],["鹿践莓苔滑，","鱼牵水荇沈。"],["怀情方未已，","清酒漫须斟。"]]}
{"id":"80ef055a39","title":"田家","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黯黯日将夕，","牛羊村外来。","岩阿青气发，","篱落杏花开。","草木应初感，","鸧鹒亦已催。","晚间春作好，","行乐不须猜。"],"stanzas":[["黯黯日将夕，","牛羊村外来。"],["岩阿青气发，","篱落杏花开。"],["草木应初感，","鸧鹒亦已催。"],["晚间春作好，","行乐不须猜。"]]}
{"id":"87b629911e","title":"神光寺","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["香刹悬青磴，","飞楼界碧空。","石门栖怖鸽，","慈塔绕归鸿。","有法将心镜，","无名属性通。","从来乐幽寂，","寻觅未能穷。"],"stanzas":[["香刹悬青磴，","飞楼界碧空。"],["石门栖怖鸽，","慈塔绕归鸿。"],["有法将心镜，","无名属性通。"],["从来乐幽寂，","寻觅未能穷。"]]}
{"id":"e2768d9341","title":"和项斯游头陀寺上方","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["步入桃源里，","晴花更满枝。","峰回山意旷，","林杳竹光迟。","远寺寻龙藏，","名香发雁池。","间能将远语，","况及上阳时。"],"stanzas":[["步入桃源里，","晴花更满枝。"],["峰回山意旷，","林杳竹光迟。"],["远寺寻龙藏，","名香发雁池。"],["间能将远语，","况及上阳时。"]]}
{"id":"5da42e4fad","title":"秦原道中","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["分险架长澜，","斜梁控夕峦。","宿云依岭断，","初月入江寒。","缁化秦裘敝，","尘惊汉策残。","无言倦行旅，","遥路属时难。"],"stanzas":[["分险架长澜，","斜梁控夕峦。"],["宿云依岭断，","初月入江寒。"],["缁化秦裘敝，","尘惊汉策残。"],["无言倦行旅，","遥路属时难。"]]}
{"id":"a2ae2655cd","title":"月峰寺忆理公","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共来江海上，","清论一宵同。","禅榻浑依旧，","心期浩已空。","惊春花落树，","闻梵涧摇风。","二谛欣咨启，","还应梦寐通。"],"stanzas":[["共来江海上，","清论一宵同。"],["禅榻浑依旧，","心期浩已空。"],["惊春花落树，","闻梵涧摇风。"],["二谛欣咨启，","还应梦寐通。"]]}
{"id":"4a516d88e7","title":"寄陈去疾进士","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["放迹疑辞垢，","栖心亦道门。","玄言萝幌馥，","诗思竹炉温。","解带摇花落，","弹琴散鸟喧。","江山兹夕意，","唯有素交存。"],"stanzas":[["放迹疑辞垢，","栖心亦道门。"],["玄言萝幌馥，","诗思竹炉温。"],["解带摇花落，","弹琴散鸟喧。"],["江山兹夕意，","唯有素交存。"]]}
{"id":"71c5583aff","title":"听郢客歌阳春白雪","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂听郢中人，","高歌已绝伦。","临风飘白雪，","向日奏阳春。","调雅偏盈耳，","声长杳入神。","连连贯珠并，","嬝嬝遏云频。","度曲知难和，","凝情想任真。","周郎如赏羡，","莫使滞芳晨。"],"stanzas":[["寂听郢中人，","高歌已绝伦。"],["临风飘白雪，","向日奏阳春。"],["调雅偏盈耳，","声长杳入神。"],["连连贯珠并，","嬝嬝遏云频。"],["度曲知难和，","凝情想任真。"],["周郎如赏羡，","莫使滞芳晨。"]]}
{"id":"7d8a5b932e","title":"南涧寺","author":"欧阳衮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春寺无人乱鸟啼，","藤萝阴磴野僧迷。","云藏古壁遗龙象，","草没香台抱鹿麛。","松籁泠泠疑梵呗，","柳烟历历见招提。","为耽寂乐亲禅侣，","莫怪闲行费马蹄。"],"stanzas":[["春寺无人乱鸟啼，","藤萝阴磴野僧迷。"],["云藏古壁遗龙象，","草没香台抱鹿麛。"],["松籁泠泠疑梵呗，","柳烟历历见招提。"],["为耽寂乐亲禅侣，","莫怪闲行费马蹄。"]]}
{"id":"52dd0267ac","title":"献岁书情","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白发添双鬓，","空宫又一年。","音书鸿不到，","梦寐兔空悬。","地远星辰侧，","天高雨露偏。","圣期知有感，","云海漫相连。"],"stanzas":[["白发添双鬓，","空宫又一年。"],["音书鸿不到，","梦寐兔空悬。"],["地远星辰侧，","天高雨露偏。"],["圣期知有感，","云海漫相连。"]]}
{"id":"bdd90eec65","title":"奉和大梁相公重九日军中宴会之什","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今古同嘉节，","欢娱但异名。","陶公缘绿醑，","谢傅为苍生。","酒泛金英丽，","诗通玉律清。","何言辞物累，","方系万人情。"],"stanzas":[["今古同嘉节，","欢娱但异名。"],["陶公缘绿醑，","谢傅为苍生。"],["酒泛金英丽，","诗通玉律清。"],["何言辞物累，","方系万人情。"]]}
{"id":"0da70d58cf","title":"奉和大梁相公同张员外重九日宴集","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重九思嘉节，","追欢从谢公。","酒清欺玉露，","菊盛愧金风。","不待秋蟾白，","须沉落照红。","更将门下客，","酬和管弦中。"],"stanzas":[["重九思嘉节，","追欢从谢公。"],["酒清欺玉露，","菊盛愧金风。"],["不待秋蟾白，","须沉落照红。"],["更将门下客，","酬和管弦中。"]]}
{"id":"8fd9ea61ff","title":"同乐天中秋夜洛河玩月二首 一","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清洛半秋悬璧月，","彩船当夕泛银河。","苍龙颔底珠皆没，","白帝心边镜乍磨。","海上几时霜雪积，","人间此夜管弦多。","须知天地为𬬻意，","尽取黄金铸作波。"],"stanzas":[["清洛半秋悬璧月，","彩船当夕泛银河。"],["苍龙颔底珠皆没，","白帝心边镜乍磨。"],["海上几时霜雪积，","人间此夜管弦多。"],["须知天地为𬬻意，","尽取黄金铸作波。"]]}
{"id":"5d4e58c885","title":"同乐天中秋夜洛河玩月二首 二","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不热不寒三五夕，","晴川明月正相临。","千珠竞没苍龙颔，","一镜高悬白帝心。","几处凄凉缘地远，","有时惆怅值云阴。","如何清洛如清昼，","共见初升又见沈。"],"stanzas":[["不热不寒三五夕，","晴川明月正相临。"],["千珠竞没苍龙颔，","一镜高悬白帝心。"],["几处凄凉缘地远，","有时惆怅值云阴。"],["如何清洛如清昼，","共见初升又见沈。"]]}
{"id":"5238e4cb62","title":"和邢郎中病中重阳强游乐游原","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嘉晨令节共陶陶，","风景牵情并不劳。","晓日整冠兰室静，","秋原骑马菊花高。","晴光一一呈金刹，","诗思浸浸逼水曹。","何必销忧凭外物，","祗将清韵敌春醪。"],"stanzas":[["嘉晨令节共陶陶，","风景牵情并不劳。"],["晓日整冠兰室静，","秋原骑马菊花高。"],["晴光一一呈金刹，","诗思浸浸逼水曹。"],["何必销忧凭外物，","祗将清韵敌春醪。"]]}
{"id":"7a8a4cc702","title":"观淬龙泉劒","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欧冶将成器，","风胡幸见逢。","发硎思剸玉，","投水化为龙。","讵肯藏深匣，","终朝用刜钟。","莲花生宝锷，","秋日励霜锋。","炼质才三尺，","吹毛过百重。","击磨如不倦，","提握愿长从。"],"stanzas":[["欧冶将成器，","风胡幸见逢。"],["发硎思剸玉，","投水化为龙。"],["讵肯藏深匣，","终朝用刜钟。"],["莲花生宝锷，","秋日励霜锋。"],["炼质才三尺，","吹毛过百重。"],["击磨如不倦，","提握愿长从。"]]}
{"id":"74f2972d89","title":"春色满皇州","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒销山水地，","春遍帝王州。","北阙晴光动，","南山喜气浮。","夭红粧暖树，","急绿走阴沟。","思妇开香阁，","王孙上玉楼。","氛氲直城北，","骀荡曲江头。","今日灵台下，","翻然却是愁。"],"stanzas":[["寒销山水地，","春遍帝王州。"],["北阙晴光动，","南山喜气浮。"],["夭红粧暖树，","急绿走阴沟。"],["思妇开香阁，","王孙上玉楼。"],["氛氲直城北，","骀荡曲江头。"],["今日灵台下，","翻然却是愁。"]]}
{"id":"0c1413a140","title":"亚夫碎玉斗","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雄谋竟不决，","宝玉终不爱。","倏尔霜刃挥，","飒然春冰碎。","飞光动旗帜，","散响惊环珮。","霜洒绣障前，","星流锦筵内。","图王业已失，","为虏言空悔。","独有青史中，","英风观千载。"],"stanzas":[["雄谋竟不决，","宝玉终不爱。"],["倏尔霜刃挥，","飒然春冰碎。"],["飞光动旗帜，","散响惊环珮。"],["霜洒绣障前，","星流锦筵内。"],["图王业已失，","为虏言空悔。"],["独有青史中，","英风观千载。"]]}
{"id":"5db1ec37c9","title":"水亭","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岁律行将变，","君恩竟未回。","门前即潮水，","朝去暮常来。"],"stanzas":[["岁律行将变，","君恩竟未回。"],["门前即潮水，","朝去暮常来。"]]}
{"id":"c882d24b62","title":"扬州寄诸子","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千里隔烟波，","孤舟宿何处？","遥思耿不眠，","淮南夜风雨。"],"stanzas":[["千里隔烟波，","孤舟宿何处？","遥思耿不眠，","淮南夜风雨。"]]}
{"id":"c87de05e95","title":"酬卢郎中游寺见招不遇","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶出送山客，","不知游梵宫。","秋光古松下，","谁伴一仙翁。"],"stanzas":[["偶出送山客，","不知游梵宫。"],["秋光古松下，","谁伴一仙翁。"]]}
{"id":"6f546c37c7","title":"寓言","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋树却逢暖，","未凋能几时。","何须尚松桂，","摇动暂青枝。"],"stanzas":[["秋树却逢暖，","未凋能几时。"],["何须尚松桂，","摇动暂青枝。"]]}
{"id":"10c4a8d4fb","title":"唁人丧侍儿","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜情河耿耿，","春恨草绵绵。","唯有嫦娥月，","从今照墓田。"],"stanzas":[["夜情河耿耿，","春恨草绵绵。"],["唯有嫦娥月，","从今照墓田。"]]}
{"id":"903cbb08ea","title":"席上夜别张主簿","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红烛剪还明，","绿尊添又满。","不愁前路长，","只畏今宵短。"],"stanzas":[["红烛剪还明，","绿尊添又满。"],["不愁前路长，","只畏今宵短。"]]}
{"id":"addd6bebe7","title":"方丈泉","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["循涯不知浅，","见底似非深。","永日无波浪，","澄澄照我心。"],"stanzas":[["循涯不知浅，","见底似非深。"],["永日无波浪，","澄澄照我心。"]]}
{"id":"2a0bd370d4","title":"晚望","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日下夕阴长，","前山凝积翠。","白鸟一行飞，","联联粉书字。"],"stanzas":[["日下夕阴长，","前山凝积翠。"],["白鸟一行飞，","联联粉书字。"]]}
{"id":"9445090da8","title":"前山","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["只谓一苍翠，","不知犹数重。","晚来云映处，","更见两三峰。"],"stanzas":[["只谓一苍翠，","不知犹数重。"],["晚来云映处，","更见两三峰。"]]}
{"id":"1c473239e1","title":"发交州日留题解炼师房","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["久喜房廊接，","今成道路赊。","明朝回首处，","此地是天涯。"],"stanzas":[["久喜房廊接，","今成道路赊。"],["明朝回首处，","此地是天涯。"]]}
{"id":"23fbc82907","title":"令和州买松","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好觅凌霜质，","仍须带雨栽。","须知剖竹日，","便是看松来。"],"stanzas":[["好觅凌霜质，","仍须带雨栽。"],["须知剖竹日，","便是看松来。"]]}
{"id":"6ef8c54667","title":"题断金集后","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一览断金集，","再悲埋玉人。","牙弦千古绝，","珠泪万行新。"],"stanzas":[["一览断金集，","再悲埋玉人。"],["牙弦千古绝，","珠泪万行新。"]]}
{"id":"38780aadf5","title":"晚凉","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["簷前蔽日多高树，","竹下添池有小渠。","山客野僧归去后，","晚凉移案独临书。"],"stanzas":[["簷前蔽日多高树，","竹下添池有小渠。"],["山客野僧归去后，","晚凉移案独临书。"]]}
{"id":"31cdec0cd0","title":"和周侍御洛城雪","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天街飞辔踏琼英，","四顾全疑在玉京。","一种相如抽秘思，","兔园那比凤凰城。"],"stanzas":[["天街飞辔踏琼英，","四顾全疑在玉京。"],["一种相如抽秘思，","兔园那比凤凰城。"]]}
{"id":"d342f182ad","title":"奉和大梁相公送人二首 一","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢公日日伤离别，","又向西堂送阿连。","想到越中秋已尽，","镜河应羡月团圆。"],"stanzas":[["谢公日日伤离别，","又向西堂送阿连。"],["想到越中秋已尽，","镜河应羡月团圆。"]]}
{"id":"04f3f8146e","title":"奉和大梁相公送人二首 二","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北津杨柳迎烟绿，","南岸阑干映水红。","君到襄阳渡江处，","始应回首忆羊公。"],"stanzas":[["北津杨柳迎烟绿，","南岸阑干映水红。"],["君到襄阳渡江处，","始应回首忆羊公。"]]}
{"id":"fcad77ea39","title":"酬唐仁烈相别后喜阻风未发见寄","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["离心一起泪双流，","春浪无情也白头。","风若有知须放去，","莫教重别又重愁。"],"stanzas":[["离心一起泪双流，","春浪无情也白头。"],["风若有知须放去，","莫教重别又重愁。"]]}
{"id":"22a4f8152e","title":"秦中卧病思归","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["索索凉风满树头，","破窗残月五更秋。","病身归处吴江上，","一寸心中万里愁。"],"stanzas":[["索索凉风满树头，","破窗残月五更秋。"],["病身归处吴江上，","一寸心中万里愁。"]]}
{"id":"fc2571913c","title":"送王缋","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠羽长将玉树期，","偶然飞下肯多时。","翩翩一路岚阴晚，","却入青葱宿旧枝。"],"stanzas":[["翠羽长将玉树期，","偶然飞下肯多时。"],["翩翩一路岚阴晚，","却入青葱宿旧枝。"]]}
{"id":"e708f10106","title":"赠美人琴弦","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["应从玉指到金徽，","万态千情料可知。","今夜灯前湘水怨，","殷勤封在七条丝。"],"stanzas":[["应从玉指到金徽，","万态千情料可知。"],["今夜灯前湘水怨，","殷勤封在七条丝。"]]}
{"id":"2946384c97","title":"病中知皇子陂荷花盛发寄王缋","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十里莲塘路不赊，","病来帘外是天涯。","烦君四句遥相寄，","应得诗中便看花。"],"stanzas":[["十里莲塘路不赊，","病来帘外是天涯。"],["烦君四句遥相寄，","应得诗中便看花。"]]}
{"id":"46913c7f0b","title":"戏唐仁烈","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自知年几偏应少，","先把屠苏不让春。","傥更数年逢此日，","还应惆怅羡他人。"],"stanzas":[["自知年几偏应少，","先把屠苏不让春。"],["傥更数年逢此日，","还应惆怅羡他人。"]]}
{"id":"49b8d3eb3e","title":"上下七盘二首 一","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斗回山路掩皇州，","二载欢娱一望休。","从此万重青嶂合，","无因更得重回头。"],"stanzas":[["斗回山路掩皇州，","二载欢娱一望休。"],["从此万重青嶂合，","无因更得重回头。"]]}
{"id":"031c9b9567","title":"上下七盘二首 二","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["商山半月雨漫漫，","偶值新晴下七盘。","山似换来天似洗，","可怜风日到长安。"],"stanzas":[["商山半月雨漫漫，","偶值新晴下七盘。"],["山似换来天似洗，","可怜风日到长安。"]]}
{"id":"d32b9ec83c","title":"八月十五日夜","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去年今夜在商州，","还为清光上驿楼。","宛是依依旧颜色，","自怜人换几般愁。"],"stanzas":[["去年今夜在商州，","还为清光上驿楼。"],["宛是依依旧颜色，","自怜人换几般愁。"]]}
{"id":"c152e123e8","title":"南诏朱藤杖","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六节南藤色似朱，","拄行阶砌胜人扶。","会须将入深山去，","倚看云泉作老夫。"],"stanzas":[["六节南藤色似朱，","拄行阶砌胜人扶。"],["会须将入深山去，","倚看云泉作老夫。"]]}
{"id":"48ede415f9","title":"夜意","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["萧疎尽地林无影，","浩荡连天月有波。","独立空亭人睡后，","洛桥风便水声多。"],"stanzas":[["萧疎尽地林无影，","浩荡连天月有波。"],["独立空亭人睡后，","洛桥风便水声多。"]]}
{"id":"7056372f6e","title":"漫作","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月色莫来孤寝处，","春风又向别人家。","梁园桃李虽无数，","断定今年不看花。"],"stanzas":[["月色莫来孤寝处，","春风又向别人家。"],["梁园桃李虽无数，","断定今年不看花。"]]}
{"id":"54a96be2fa","title":"访刘君","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扰扰驰蹄又走轮，","五更飞尽九衢尘。","灵芝破观深松院，","还有斋时未起人。"],"stanzas":[["扰扰驰蹄又走轮，","五更飞尽九衢尘。"],["灵芝破观深松院，","还有斋时未起人。"]]}
{"id":"e016e39373","title":"杨柳枝词","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已作绿丝笼晓日，","又成飞絮扑晴波。","隋家不合栽杨柳，","长遣行人春恨多。"],"stanzas":[["已作绿丝笼晓日，","又成飞絮扑晴波。"],["隋家不合栽杨柳，","长遣行人春恨多。"]]}
{"id":"60dcd4f792","title":"寄杭州崔使君","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝下归来只闭关，","羡君高步出人寰。","三年不见尘中事，","满眼江涛送雪山。"],"stanzas":[["朝下归来只闭关，","羡君高步出人寰。"],["三年不见尘中事，","满眼江涛送雪山。"]]}
{"id":"4fea7ace17","title":"穷冬曲江闲步","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪尽南坡鴈北飞，","草根春意胜春晖。","曲江永日无人到，","独绕寒池又独归。"],"stanzas":[["雪尽南坡鴈北飞，","草根春意胜春晖。"],["曲江永日无人到，","独绕寒池又独归。"]]}
{"id":"77db027bb9","title":"省中题新植双松","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["端坐高宫起远心，","云高水阔共幽沈。","更堂寓直将谁语，","自种双松伴夜吟。"],"stanzas":[["端坐高宫起远心，","云高水阔共幽沈。"],["更堂寓直将谁语，","自种双松伴夜吟。"]]}
{"id":"c82efb97d0","title":"崇山郡","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地尽炎荒瘴海头，","圣朝今又放驩兜。","交州已在南天外，","更过交州四五州。"],"stanzas":[["地尽炎荒瘴海头，","圣朝今又放驩兜。"],["交州已在南天外，","更过交州四五州。"]]}
{"id":"0b4db61dc0","title":"临水","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一见心原断百忧，","益知身世两悠悠。","江亭独倚阑干处，","人亦无言水自流。"],"stanzas":[["一见心原断百忧，","益知身世两悠悠。"],["江亭独倚阑干处，","人亦无言水自流。"]]}
{"id":"2a082693c6","title":"题江上柳寄李使君","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桂江南渡无杨柳，","见此令人眼暂明。","应学郡中贤太守，","依依相向许多情。"],"stanzas":[["桂江南渡无杨柳，","见此令人眼暂明。"],["应学郡中贤太守，","依依相向许多情。"]]}
{"id":"e563e5f91b","title":"江上见月怀古","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月上江平夜不风，","伏波遗迹半成空。","今宵倍欲悲陵谷，","铜柱分明在水中。"],"stanzas":[["月上江平夜不风，","伏波遗迹半成空。"],["今宵倍欲悲陵谷，","铜柱分明在水中。"]]}
{"id":"a772a11325","title":"鹦鹉","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劝尔莫移禽鸟性，","翠毛红觜任天真。","如今漫学人言巧，","解语终须累尔身。"],"stanzas":[["劝尔莫移禽鸟性，","翠毛红觜任天真。"],["如今漫学人言巧，","解语终须累尔身。"]]}
{"id":"ffd7b37d99","title":"寄婺州李给事二首 一","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心尽玉皇恩已远，","迹留江郡宦应孤。","不知壮气今何似，","犹得凌云贯日无。"],"stanzas":[["心尽玉皇恩已远，","迹留江郡宦应孤。"],["不知壮气今何似，","犹得凌云贯日无。"]]}
{"id":"7ad4f3570f","title":"寄婺州李给事二首 二","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瘴鬼翻能念直心，","五年相遇不相侵。","目前唯有思君病，","无底沧溟未是深。"],"stanzas":[["瘴鬼翻能念直心，","五年相遇不相侵。"],["目前唯有思君病，","无底沧溟未是深。"]]}
{"id":"29da574be2","title":"秋日","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六眸龟北凉应早，","三足乌南日正长。","常记京关怨摇落，","如今目断满林霜。"],"stanzas":[["六眸龟北凉应早，","三足乌南日正长。"],["常记京关怨摇落，","如今目断满林霜。"]]}
{"id":"432fc3540c","title":"遣意","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梧桐坠露悲先朽，","松桂凌霜倚后枯。","不是世间长在物，","蹔分贞脆竟何殊。"],"stanzas":[["梧桐坠露悲先朽，","松桂凌霜倚后枯。"],["不是世间长在物，","蹔分贞脆竟何殊。"]]}
{"id":"f29b683732","title":"戏酬惟赏上人","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师是浮云无著身，","我居尘网敢相亲。","应从海上秋风便，","偶自飞来不为人。"],"stanzas":[["师是浮云无著身，","我居尘网敢相亲。"],["应从海上秋风便，","偶自飞来不为人。"]]}
{"id":"223bf05d66","title":"寓言","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流水颓阳不暂停，","东流西落两无情。","不是世间人自老，","古来华发此中生。"],"stanzas":[["流水颓阳不暂停，","东流西落两无情。"],["不是世间人自老，","古来华发此中生。"]]}
{"id":"34cd3e8df0","title":"忆家","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天海相连无尽处，","梦魂来往尚应难。","谁言南海无霜雪，","试向愁人两鬓看。"],"stanzas":[["天海相连无尽处，","梦魂来往尚应难。"],["谁言南海无霜雪，","试向愁人两鬓看。"]]}
{"id":"ff61d8dc72","title":"留客","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青梅欲熟笋初长，","嫩绿新阴绕砌凉。","湖馆翛然无俗客，","白衣居士且匡床。"],"stanzas":[["青梅欲熟笋初长，","嫩绿新阴绕砌凉。"],["湖馆翛然无俗客，","白衣居士且匡床。"]]}
{"id":"087c685501","title":"别蕲春王判官","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["四十年来[真]久故，","三千里外暂相逢。","今日一杯成远别，","烟波眇眇恨重重。"],"stanzas":[["四十年来[真]久故，","三千里外暂相逢。"],["今日一杯成远别，","烟波眇眇恨重重。"]]}
{"id":"249fdcb930","title":"将发循州社日于所居馆宴送","author":"裴夷直","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浪花如雪叠江风，","社过高秋万恨中。","明日便随江燕去，","依依俱是故巢空。"],"stanzas":[["浪花如雪叠江风，","社过高秋万恨中。"],["明日便随江燕去，","依依俱是故巢空。"]]}
{"id":"605ce8f434","title":"泛溪","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曲渚回花舫，","生衣卧向风。","鸟飞溪色里，","人语棹声中。","余卉才分影，","新蒲自作丛。","前湾更幽绝，","虽浅去犹通。"],"stanzas":[["曲渚回花舫，","生衣卧向风。"],["鸟飞溪色里，","人语棹声中。"],["余卉才分影，","新蒲自作丛。"],["前湾更幽绝，","虽浅去犹通。"]]}
{"id":"def853f4fd","title":"宿陈处士书斋","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["结茅当此地，","下马见高情。","菰叶寒塘晚，","杉阴白石明。","向炉新茗色，","隔雪远钟声。","闲得相逢少，","吟多寐不成。"],"stanzas":[["结茅当此地，","下马见高情。"],["菰叶寒塘晚，","杉阴白石明。"],["向炉新茗色，","隔雪远钟声。"],["闲得相逢少，","吟多寐不成。"]]}
{"id":"1a533c7c6a","title":"上宣州沈大夫","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["科名继世古来稀，","高步何年下紫微。","帝命几曾移重镇，","时清犹望领春闱。","登朝旧友常思见，","开幕贤人并望归。","今日得游风化地，","却回沧海有光辉。"],"stanzas":[["科名继世古来稀，","高步何年下紫微。"],["帝命几曾移重镇，","时清犹望领春闱。"],["登朝旧友常思见，","开幕贤人并望归。"],["今日得游风化地，","却回沧海有光辉。"]]}
{"id":"7b20c33c7d","title":"杭州送萧宝校书","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["马识青山路，","人随白浪船。","别君犹有泪，","学道谩经年。"],"stanzas":[["马识青山路，","人随白浪船。"],["别君犹有泪，","学道谩经年。"]]}
{"id":"5a0ae245c4","title":"送盛长史","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫辞东路远，","此别岂闲行。","职处中军要，","官兼上佐荣。","野亭枫叶暗，","秋水藕花明。","拜省期将近，","孤舟促去程。"],"stanzas":[["莫辞东路远，","此别岂闲行。"],["职处中军要，","官兼上佐荣。"],["野亭枫叶暗，","秋水藕花明。"],["拜省期将近，","孤舟促去程。"]]}
{"id":"b27797d365","title":"宿道士观","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堂闭僊人影，","空坛月露初。","闲听道家子，","盥漱读灵书。"],"stanzas":[["堂闭僊人影，","空坛月露初。"],["闲听道家子，","盥漱读灵书。"]]}
{"id":"ca6d6662e6","title":"湖州韩使君置宴","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老大成名仍足病，","纵听丝竹也无欢。","高情太守容闲坐，","借与青山尽日看。"],"stanzas":[["老大成名仍足病，","纵听丝竹也无欢。"],["高情太守容闲坐，","借与青山尽日看。"]]}
{"id":"0e6153b239","title":"题僊游寺","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石抱龙堂藓石干，","山遮白日寺门寒。","长松瀑布饶奇状，","曾有仙人驻鹤看。"],"stanzas":[["石抱龙堂藓石干，","山遮白日寺门寒。"],["长松瀑布饶奇状，","曾有仙人驻鹤看。"]]}
{"id":"c97a4b2fed","title":"宫词","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寂花时闭院门，","美人相并立琼轩。","含情欲说宫中事，","鹦鹉前头不敢言。"],"stanzas":[["寂寂花时闭院门，","美人相并立琼轩。"],["含情欲说宫中事，","鹦鹉前头不敢言。"]]}
{"id":"ff2e94eb55","title":"公子行","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲从结客冶游时，","忘却红楼薄暮期。","醉上黄金堤上去，","马鞭捎断绿杨丝。"],"stanzas":[["闲从结客冶游时，","忘却红楼薄暮期。"],["醉上黄金堤上去，","马鞭捎断绿杨丝。"]]}
{"id":"b449d5782e","title":"送陈摽","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满酌劝童仆，","好随郎马蹄。","春风慎行李，","莫上白铜鞮。"],"stanzas":[["满酌劝童仆，","好随郎马蹄。"],["春风慎行李，","莫上白铜鞮。"]]}
{"id":"bda593d2d1","title":"寻古观","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["僊观曾过知不远，","花藏石室杳难寻。","泉边白鹿闻人语，","看过天坛渐入深。"],"stanzas":[["僊观曾过知不远，","花藏石室杳难寻。"],["泉边白鹿闻人语，","看过天坛渐入深。"]]}
{"id":"25d2f8ac1d","title":"南岭路","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越岭向南风景异，","人人传说到京城。","经冬来往不踏雪，","尽在刺桐花下行。"],"stanzas":[["越岭向南风景异，","人人传说到京城。"],["经冬来往不踏雪，","尽在刺桐花下行。"]]}
{"id":"7017f96a24","title":"陪江州李使君重阳宴百花亭","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲携九日酒，","共到百花亭。","醉里求诗境，","回看岛屿青。"],"stanzas":[["闲携九日酒，","共到百花亭。"],["醉里求诗境，","回看岛屿青。"]]}
{"id":"d14d2b9eb5","title":"上张水部","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["出入门阑久，","儿童亦有情。","不忘将姓字，","常说向公卿。","每许连床坐，","仍容并马行。","恩深转无语，","怀抱甚分明。"],"stanzas":[["出入门阑久，","儿童亦有情。"],["不忘将姓字，","常说向公卿。"],["每许连床坐，","仍容并马行。"],["恩深转无语，","怀抱甚分明。"]]}
{"id":"f5b53aafe5","title":"凤翔西池与贾岛纳凉","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["四面无炎气，","清池阔复深。","蝶飞逢草住，","鱼戏见人沉。","拂石安茶器，","移床选树阴。","几回同到此，","尽日得闲吟。"],"stanzas":[["四面无炎气，","清池阔复深。"],["蝶飞逢草住，","鱼戏见人沉。"],["拂石安茶器，","移床选树阴。"],["几回同到此，","尽日得闲吟。"]]}
{"id":"107b1c3c26","title":"上汴州令狐相公","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["罢相恩犹在，","那容处静司。","政严初领节，","名重更因诗。","公事巡营外，","戎装拜勅时。","恭闻长与善，","应念出身迟。"],"stanzas":[["罢相恩犹在，","那容处静司。"],["政严初领节，","名重更因诗。"],["公事巡营外，","戎装拜勅时。"],["恭闻长与善，","应念出身迟。"]]}
{"id":"cc2a7835c1","title":"送于中丞入蕃册立","author":"朱庆余","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上马生边思，","戎装别众僚。","双旌衔命重，","空碛去程遥。","迥没沙中树，","孤飞雪外雕。","蕃庭过册礼，","几日却回朝。"],"stanzas":[["上马生边思，","戎装别众僚。"],["双旌衔命重，","空碛去程遥。"],["迥没沙中树，","孤飞雪外雕。"],["蕃庭过册礼，","几日却回朝。"]]}
