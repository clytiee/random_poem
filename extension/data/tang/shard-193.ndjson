{"id":"5f885c12de","title":"句","author":"杨义方","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海边红日半离水，","天外暖风轻到花。","雨声鞭自禁门出，","一簇人从天上来。"],"stanzas":[["海边红日半离水，","天外暖风轻到花。"],["雨声鞭自禁门出，","一簇人从天上来。"]]}
{"id":"71fba1e0ec","title":"句","author":"王廷珪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十字水中分岛屿，","数重花外见楼台。"],"stanzas":[["十字水中分岛屿，","数重花外见楼台。"]]}
{"id":"11f5b31b37","title":"句","author":"欧阳彬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无钱将乞樊知客，","名纸生毛不为通。","桑柘残阳里，","儿孙落叶中。"],"stanzas":[["无钱将乞樊知客，","名纸生毛不为通。"],["桑柘残阳里，","儿孙落叶中。"]]}
{"id":"0e13dc8897","title":"句","author":"李尧夫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["向外疑无地，","其中别有天。","方外共推为道友，","关中独自占诗家。","炎暑郁蒸无处避，","凉风消息几时来。"],"stanzas":[["向外疑无地，","其中别有天。"],["方外共推为道友，","关中独自占诗家。"],["炎暑郁蒸无处避，","凉风消息几时来。"]]}
{"id":"9f9c290a6f","title":"句","author":"石文德","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月沈湘浦冷，","花谢汉宫秋。"],"stanzas":[["月沈湘浦冷，","花谢汉宫秋。"]]}
{"id":"419302935d","title":"句","author":"戴偃","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["须把咽喉吞世界，","盖因奢侈致危亡。","若须抛却便抛却，","莫待风高更亦深。"],"stanzas":[["须把咽喉吞世界，","盖因奢侈致危亡。"],["若须抛却便抛却，","莫待风高更亦深。"]]}
{"id":"00e2c937a5","title":"句","author":"张迥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜长灯影灭，","天绕鹤声孤。"],"stanzas":[["夜长灯影灭，","天绕鹤声孤。"]]}
{"id":"d22cd7d832","title":"句","author":"钟元章","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金筈离弦三尺电，","星髇破的一声雷。"],"stanzas":[["金筈离弦三尺电，","星髇破的一声雷。"]]}
{"id":"ada7d8f923","title":"句","author":"杨凫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["背日流泉生冻早，","逆风归鸟入巢迟。"],"stanzas":[["背日流泉生冻早，","逆风归鸟入巢迟。"]]}
{"id":"ac1f71f8ca","title":"句","author":"王俊","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["胜日登楼望，","山川一半春。"],"stanzas":[["胜日登楼望，","山川一半春。"]]}
{"id":"d0f60346ae","title":"句","author":"薛沆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["也知别有风光主，","花蕾枝枝似去年。"],"stanzas":[["也知别有风光主，","花蕾枝枝似去年。"]]}
{"id":"22b749bd5d","title":"句","author":"张𫖮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金殿圣人看纵笔，","玉堂词客尽裁诗。"],"stanzas":[["金殿圣人看纵笔，","玉堂词客尽裁诗。"]]}
{"id":"301bced50a","title":"句","author":"张林","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["菱叶乍翻人采后，","芰荷初没舸行时。"],"stanzas":[["菱叶乍翻人采后，","芰荷初没舸行时。"]]}
{"id":"ac4886c566","title":"句","author":"卢休","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春寒酒力迟，","冉冉生微红。","自然草木姓，","谁祝元化功。","湓浦风生破胆愁，","血染剑花明帐幕。","三千车马出渔阳，","入门堪笑复堪怜。","三径苔荒一钓船。"],"stanzas":[["春寒酒力迟，","冉冉生微红。"],["自然草木姓，","谁祝元化功。"],["湓浦风生破胆愁，","血染剑花明帐幕。"],["三千车马出渔阳，","入门堪笑复堪怜。"],["三径苔荒一钓船。"]]}
{"id":"ca134dddd5","title":"句","author":"陈峤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小桥风月年年事，","争奈潘郎去□何。"],"stanzas":[["小桥风月年年事，","争奈潘郎去□何。"]]}
{"id":"70fe86e892","title":"句","author":"李范","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清猨啼远木，","白鸟下前滩。","鹤归秋汉远，","人去草堂空。","虽当南北路，","不碍往来人。","钓叟无机沙鸟睡，","禅师入定白牛闲。","天涯故友无来信，","窗外拒霜空落花。"],"stanzas":[["清猨啼远木，","白鸟下前滩。"],["鹤归秋汉远，","人去草堂空。"],["虽当南北路，","不碍往来人。"],["钓叟无机沙鸟睡，","禅师入定白牛闲。"],["天涯故友无来信，","窗外拒霜空落花。"]]}
{"id":"fbdeefc048","title":"句","author":"卞震","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨壁长秋菌，","风枝落病蝉。","老筇搘瘦影，","寒木凭吟身。","诗债到春无处避，","离愁因醉暂时无。","茶香解睡磨铛煮，","山色牵怀著屐登。"],"stanzas":[["雨壁长秋菌，","风枝落病蝉。"],["老筇搘瘦影，","寒木凭吟身。"],["诗债到春无处避，","离愁因醉暂时无。"],["茶香解睡磨铛煮，","山色牵怀著屐登。"]]}
{"id":"b9231296c4","title":"句","author":"林楚才","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身闲不恨辞官早，","诗好常甘得句迟。"],"stanzas":[["身闲不恨辞官早，","诗好常甘得句迟。"]]}
{"id":"43a60ce648","title":"句","author":"孟不疑","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白日故乡远，","青山佳句中。"],"stanzas":[["白日故乡远，","青山佳句中。"]]}
{"id":"0e0e3a4f0b","title":"句","author":"庞季子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冥云生易满，","秋草长难高。"],"stanzas":[["冥云生易满，","秋草长难高。"]]}
{"id":"ec0396659b","title":"句","author":"郭思","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落星一石几千年，","门外何人扣汉川。"],"stanzas":[["落星一石几千年，","门外何人扣汉川。"]]}
{"id":"a439559f89","title":"句","author":"卢载","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五千里地望皆见，","七十二峰中最高。"],"stanzas":[["五千里地望皆见，","七十二峰中最高。"]]}
{"id":"feb01a2b5e","title":"句","author":"郑翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花烧落第眼，","雨破到家程。"],"stanzas":[["花烧落第眼，","雨破到家程。"]]}
{"id":"edcea3099a","title":"句","author":"郑说","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["架上紫衣闲不著，","案头金字坐长看。"],"stanzas":[["架上紫衣闲不著，","案头金字坐长看。"]]}
{"id":"fd2cac39f5","title":"句","author":"史瑜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溪从沮水流嶓冢，","岭接青泥入剑天。"],"stanzas":[["溪从沮水流嶓冢，","岭接青泥入剑天。"]]}
{"id":"a31fae2dda","title":"句","author":"贺公","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但存方寸地，","留与子孙耕。"],"stanzas":[["但存方寸地，","留与子孙耕。"]]}
{"id":"0dd9e773d6","title":"句","author":"米都知","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小旗村店酒，","微雨野塘花。"],"stanzas":[["小旗村店酒，","微雨野塘花。"]]}
{"id":"622628cc8c","title":"句","author":"陈秀才","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地偏云自起，","日暮山更深。"],"stanzas":[["地偏云自起，","日暮山更深。"]]}
{"id":"4b0298370d","title":"句","author":"崔李二生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恰似传花人饮散，","空抛床下最繁枝。","艳魄香魂如有在，","还应羞见堕楼人。"],"stanzas":[["恰似传花人饮散，","空抛床下最繁枝。"],["艳魄香魂如有在，","还应羞见堕楼人。"]]}
{"id":"193d4f15b7","title":"句","author":"范氏子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扫叶随风便，","浇花趁日阴。","闲云生不雨，","病叶落非秋。"],"stanzas":[["扫叶随风便，","浇花趁日阴。"],["闲云生不雨，","病叶落非秋。"]]}
{"id":"89c3280a7f","title":"句","author":"临川小吏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三月能辞千日醉，","一生能得几回看。"],"stanzas":[["三月能辞千日醉，","一生能得几回看。"]]}
{"id":"d915ed7f3c","title":"句","author":"韩熙载客","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["最是五更留不住，","向人枕畔著衣裳。"],"stanzas":[["最是五更留不住，","向人枕畔著衣裳。"]]}
{"id":"5309b2b331","title":"句","author":"段义宗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悬心秋夜月，","万里照乡关。","玉排复道珊瑚殿，","金错危椆翡翠楼。","此花不与众花同，","为感高僧护法功。"],"stanzas":[["悬心秋夜月，","万里照乡关。"],["玉排复道珊瑚殿，","金错危椆翡翠楼。"],["此花不与众花同，","为感高僧护法功。"]]}
{"id":"372c870388","title":"离别难","author":"武后宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此别难重陈，","花飞复恋人。","来时梅覆雪，","去日柳含春。","物候催行客，","归途淑气新。","剡川今已远，","魂梦暗相亲。"],"stanzas":[["此别难重陈，","花飞复恋人。"],["来时梅覆雪，","去日柳含春。"],["物候催行客，","归途淑气新。"],["剡川今已远，","魂梦暗相亲。"]]}
{"id":"a97ecf7954","title":"袍中诗","author":"开元宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沙场征戍客，","寒苦若为眠。","战袍经手作，","知落阿谁边。","蓄意多添线，","含情更著绵。","今生已过也，","结取后生缘。"],"stanzas":[["沙场征戍客，","寒苦若为眠。"],["战袍经手作，","知落阿谁边。"],["蓄意多添线，","含情更著绵。"],["今生已过也，","结取后生缘。"]]}
{"id":"cbdaeaed1a","title":"题洛苑梧叶上","author":"天宝宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旧宠悲秋扇，","新恩寄早春。","聊题一片叶，","将寄接流人。"],"stanzas":[["旧宠悲秋扇，","新恩寄早春。"],["聊题一片叶，","将寄接流人。"]]}
{"id":"84847db7aa","title":"又题洛苑梧叶上","author":"天宝宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一叶题诗出禁城，","谁人酬和独含情。","自嗟不及波中叶，","荡漾乘春取次行。"],"stanzas":[["一叶题诗出禁城，","谁人酬和独含情。"],["自嗟不及波中叶，","荡漾乘春取次行。"]]}
{"id":"8c026e17a1","title":"题花叶诗","author":"德宗宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一入深宫里，","无由得见春。","题诗花叶上，","寄与接流人。"],"stanzas":[["一入深宫里，","无由得见春。"],["题诗花叶上，","寄与接流人。"]]}
{"id":"a5c094f4f6","title":"题红叶","author":"宣宗宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流水何太急，","深宫尽日闲。","殷勤谢红叶，","好去到人间。"],"stanzas":[["流水何太急，","深宫尽日闲。"],["殷勤谢红叶，","好去到人间。"]]}
{"id":"3e4dcf52d3","title":"金锁诗","author":"僖宗宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉烛制袍夜，","金刀呵手裁。","锁寄千里客，","锁心终不开。"],"stanzas":[["玉烛制袍夜，","金刀呵手裁。"],["锁寄千里客，","锁心终不开。"]]}
{"id":"d446967b45","title":"随驾游青城","author":"李舜弦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["因随八马上仙山，","顿隔尘埃物象闲。","只恐西追王母宴，","却忧难得到人间。"],"stanzas":[["因随八马上仙山，","顿隔尘埃物象闲。"],["只恐西追王母宴，","却忧难得到人间。"]]}
{"id":"6c9bba13fb","title":"蜀宫应制","author":"李舜弦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浓树禁花开后庭，","饮筵中散酒微醒。","蒙蒙雨草瑶阶湿，","钟晓愁吟独倚屏。"],"stanzas":[["浓树禁花开后庭，","饮筵中散酒微醒。"],["蒙蒙雨草瑶阶湿，","钟晓愁吟独倚屏。"]]}
{"id":"16c55817ed","title":"钓鱼不得","author":"李舜弦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尽日池边钓锦鳞，","芰荷香里暗消魂。","依稀纵有寻香饵，","知是金钩不肯吞。"],"stanzas":[["尽日池边钓锦鳞，","芰荷香里暗消魂。"],["依稀纵有寻香饵，","知是金钩不肯吞。"]]}
{"id":"3c60fe6cb6","title":"宫词","author":"李玉箫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸳鸯瓦上瞥然声，","昼寝宫娥梦里惊。","元是我王金弹子，","海棠花下打流莺。"],"stanzas":[["鸳鸯瓦上瞥然声，","昼寝宫娥梦里惊。"],["元是我王金弹子，","海棠花下打流莺。"]]}
{"id":"5e8e820f99","title":"太平诗","author":"金真德","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大唐开鸿业，","巍巍皇猷昌。","止戈戎衣定，","修文继百王。","统天崇雨施，","理物体含章。","深仁谐日月，","抚运迈时康。","幡旗既赫赫，","钲鼓何锽锽。","外夷违命者，","翦覆被大殃。","和风凝宇宙，","遐迩竞呈祥。","四时调玉烛，","七曜巡万方。","维岳降宰辅，","维帝用忠良。","三五咸一德，","昭我皇家唐。"],"stanzas":[["大唐开鸿业，","巍巍皇猷昌。"],["止戈戎衣定，","修文继百王。"],["统天崇雨施，","理物体含章。"],["深仁谐日月，","抚运迈时康。"],["幡旗既赫赫，","钲鼓何锽锽。"],["外夷违命者，","翦覆被大殃。"],["和风凝宇宙，","遐迩竞呈祥。"],["四时调玉烛，","七曜巡万方。"],["维岳降宰辅，","维帝用忠良。"],["三五咸一德，","昭我皇家唐。"]]}
{"id":"14c2276f59","title":"句","author":"宝历宫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝帐香重重，","一双红芙蓉。"],"stanzas":[["宝帐香重重，","一双红芙蓉。"]]}
{"id":"5e60208b9a","title":"宫词 一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五云楼阁凤城间，","花木长新日月闲。","三十六宫连内苑，","太平天子住昆山。"],"stanzas":[["五云楼阁凤城间，","花木长新日月闲。"],["三十六宫连内苑，","太平天子住昆山。"]]}
{"id":"b788abb96b","title":"宫词 二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["会真广殿约宫墙，","楼阁相扶倚太阳。","净甃玉阶横水岸，","御炉香气扑龙床。"],"stanzas":[["会真广殿约宫墙，","楼阁相扶倚太阳。"],["净甃玉阶横水岸，","御炉香气扑龙床。"]]}
{"id":"ae76b7cc86","title":"宫词 三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙池九曲远相通，","杨柳丝牵两岸风。","长似江南好风景，","画船来去碧波中。"],"stanzas":[["龙池九曲远相通，","杨柳丝牵两岸风。"],["长似江南好风景，","画船来去碧波中。"]]}
{"id":"6eddc54698","title":"宫词 四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东内斜将紫禁通，","龙池凤苑夹城中。","晓钟声断严妆罢，","院院纱窗海日红。"],"stanzas":[["东内斜将紫禁通，","龙池凤苑夹城中。"],["晓钟声断严妆罢，","院院纱窗海日红。"]]}
{"id":"fc6c491bde","title":"宫词 五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿名新立号重光，","岛上亭台尽改张。","但是一人行幸处，","黄金阁子锁牙床。"],"stanzas":[["殿名新立号重光，","岛上亭台尽改张。"],["但是一人行幸处，","黄金阁子锁牙床。"]]}
{"id":"9b05ce487d","title":"宫词 六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夹城门与内门通，","朝罢巡游到苑中。","每日日高祗候处，","满堤红艳立春风。"],"stanzas":[["夹城门与内门通，","朝罢巡游到苑中。"],["每日日高祗候处，","满堤红艳立春风。"]]}
{"id":"648ec4abbe","title":"宫词 七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["厨船进食簇时新，","侍宴无非列近臣。","日午殿头宣索鲙，","隔花催唤打鱼人。"],"stanzas":[["厨船进食簇时新，","侍宴无非列近臣。"],["日午殿头宣索鲙，","隔花催唤打鱼人。"]]}
{"id":"d0acc84ef8","title":"宫词 八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["立春日进内园花，","红蕊轻轻嫩浅霞。","跪到玉阶犹带露，","一时宣赐与宫娃。"],"stanzas":[["立春日进内园花，","红蕊轻轻嫩浅霞。"],["跪到玉阶犹带露，","一时宣赐与宫娃。"]]}
{"id":"9af549d22a","title":"宫词 九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三面宫城尽夹墙，","苑中池水白茫茫。","直从狮子门前入，","旋见亭台绕岸傍。"],"stanzas":[["三面宫城尽夹墙，","苑中池水白茫茫。"],["直从狮子门前入，","旋见亭台绕岸傍。"]]}
{"id":"b2d500166d","title":"宫词 十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["离宫别院绕宫城，","金版轻敲合凤笙。","夜夜月明花树底，","傍池长有按歌声。"],"stanzas":[["离宫别院绕宫城，","金版轻敲合凤笙。"],["夜夜月明花树底，","傍池长有按歌声。"]]}
{"id":"32bf0200cd","title":"宫词 十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御制新翻曲子成，","六宫才唱未知名。","尽将觱篥来抄谱，","先按君王玉笛声。"],"stanzas":[["御制新翻曲子成，","六宫才唱未知名。"],["尽将觱篥来抄谱，","先按君王玉笛声。"]]}
{"id":"78f0d9c3f6","title":"宫词 十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旋移红树斲新苔，","宣使龙池更凿开。","展得绿波宽似海，","水心楼殿胜蓬莱。"],"stanzas":[["旋移红树斲新苔，","宣使龙池更凿开。"],["展得绿波宽似海，","水心楼殿胜蓬莱。"]]}
{"id":"cd142235da","title":"宫词 十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太虚高阁凌虚殿，","背倚城墙面枕池。","诸院各分娘子位，","羊车到处不教知。"],"stanzas":[["太虚高阁凌虚殿，","背倚城墙面枕池。"],["诸院各分娘子位，","羊车到处不教知。"]]}
{"id":"1a1df72fef","title":"宫词 十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["修仪承宠住龙池，","扫地焚香日午时。","等候大家来院里，","看教鹦鹉念新诗。"],"stanzas":[["修仪承宠住龙池，","扫地焚香日午时。"],["等候大家来院里，","看教鹦鹉念新诗。"]]}
{"id":"90cfac1cec","title":"宫词 十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["才人出入每参随，","笔砚将行绕曲池。","能向彩笺书大字，","忽防御制写新诗。"],"stanzas":[["才人出入每参随，","笔砚将行绕曲池。"],["能向彩笺书大字，","忽防御制写新诗。"]]}
{"id":"e7e33303e6","title":"宫词 十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六宫官职总新除，","宫女安排入画图。","二十四司分六局，","御前频见错相呼。"],"stanzas":[["六宫官职总新除，","宫女安排入画图。"],["二十四司分六局，","御前频见错相呼。"]]}
{"id":"a82797a10a","title":"宫词 十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风一面晓妆成，","偷折花枝傍水行。","却被内监遥觑见，","故将红豆打黄莺。"],"stanzas":[["春风一面晓妆成，","偷折花枝傍水行。"],["却被内监遥觑见，","故将红豆打黄莺。"]]}
{"id":"24c64ff956","title":"宫词 十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿前排宴赏花开，","宫女侵晨探几回。","斜望花开遥举袖，","传声宣唤近臣来。"],"stanzas":[["殿前排宴赏花开，","宫女侵晨探几回。"],["斜望花开遥举袖，","传声宣唤近臣来。"]]}
{"id":"6fbfa96318","title":"宫词 十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小毬场近曲池头，","宣唤勋臣试打毬。","先向画楼排御幄，","管弦声动立浮油。"],"stanzas":[["小毬场近曲池头，","宣唤勋臣试打毬。"],["先向画楼排御幄，","管弦声动立浮油。"]]}
{"id":"0fa3791d79","title":"宫词 二十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["供奉头筹不敢争，","上棚等唤近臣名。","内人酌酒才宣赐，","马上齐呼万岁声。"],"stanzas":[["供奉头筹不敢争，","上棚等唤近臣名。"],["内人酌酒才宣赐，","马上齐呼万岁声。"]]}
{"id":"3db9953df4","title":"宫词 二十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿前宫女总纤腰，","初学乘骑怯又娇。","上得马来才欲走，","几回抛鞚抱鞍桥。"],"stanzas":[["殿前宫女总纤腰，","初学乘骑怯又娇。"],["上得马来才欲走，","几回抛鞚抱鞍桥。"]]}
{"id":"37ca58d1e0","title":"宫词 二十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自教宫娥学打毬，","玉鞍初跨柳腰柔。","上棚知是官家认，","遍遍长赢第一筹。"],"stanzas":[["自教宫娥学打毬，","玉鞍初跨柳腰柔。"],["上棚知是官家认，","遍遍长赢第一筹。"]]}
{"id":"9fd4650f0e","title":"宫词 二十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翔鸾阁外夕阳天，","树影花光远接连。","望见内家来往处，","水门斜过罨楼船。"],"stanzas":[["翔鸾阁外夕阳天，","树影花光远接连。"],["望见内家来往处，","水门斜过罨楼船。"]]}
{"id":"4d0ff22668","title":"宫词 二十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内家追逐采莲时，","惊起沙欧两岸飞。","兰棹把来齐拍水，","并船相鬬湿罗衣。"],"stanzas":[["内家追逐采莲时，","惊起沙欧两岸飞。"],["兰棹把来齐拍水，","并船相鬬湿罗衣。"]]}
{"id":"f012823c64","title":"宫词 二十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新秋女伴各相逢，","罨画船飞别浦中。","旋折荷花伴歌舞，","夕阳斜照满衣红。"],"stanzas":[["新秋女伴各相逢，","罨画船飞别浦中。"],["旋折荷花伴歌舞，","夕阳斜照满衣红。"]]}
{"id":"815d2321cb","title":"宫词 二十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年相逐采莲回，","罗帽罗衫巧制裁。","每到岸头长拍水，","竞提纤手出船来。"],"stanzas":[["少年相逐采莲回，","罗帽罗衫巧制裁。"],["每到岸头长拍水，","竞提纤手出船来。"]]}
{"id":"af46bdf1de","title":"宫词 二十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早春杨柳引长条，","倚岸沿堤一面高。","称与画船牵锦缆，","暖风搓出彩丝绦。"],"stanzas":[["早春杨柳引长条，","倚岸沿堤一面高。"],["称与画船牵锦缆，","暖风搓出彩丝绦。"]]}
{"id":"abc2e4d90e","title":"宫词 二十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内家宣锡生辰宴，","隔夜诸宫进御花。","后殿未闻宫主入，","东门先报下金车。"],"stanzas":[["内家宣锡生辰宴，","隔夜诸宫进御花。"],["后殿未闻宫主入，","东门先报下金车。"]]}
{"id":"b7632341c6","title":"宫词 二十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["端午生衣进御床，","赭黄罗帕覆金箱。","美人捧入南薰殿，","玉腕斜封彩缕长。"],"stanzas":[["端午生衣进御床，","赭黄罗帕覆金箱。"],["美人捧入南薰殿，","玉腕斜封彩缕长。"]]}
{"id":"a05afd0cb6","title":"宫词 三十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["选进仙韶第一人，","才胜罗绮不胜春。","重教按舞桃花下，","只踏残红作地裀。"],"stanzas":[["选进仙韶第一人，","才胜罗绮不胜春。"],["重教按舞桃花下，","只踏残红作地裀。"]]}
{"id":"470c480015","title":"宫词 三十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侍女争挥玉弹弓，","金丸飞入乱花中。","一时惊起流莺散，","踏落残花满地红。"],"stanzas":[["侍女争挥玉弹弓，","金丸飞入乱花中。"],["一时惊起流莺散，","踏落残花满地红。"]]}
{"id":"12ba024837","title":"宫词 三十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["七宝阑干白玉除，","新开凉殿幸金舆。","一沟泛碧流春水，","四面琼钩搭绮疏。"],"stanzas":[["七宝阑干白玉除，","新开凉殿幸金舆。"],["一沟泛碧流春水，","四面琼钩搭绮疏。"]]}
{"id":"40c53355a1","title":"宫词 三十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山楼彩凤栖寒月，","宴殿金麟吐御香。","蜀锦地衣呈队舞，","教头先出拜君王。"],"stanzas":[["山楼彩凤栖寒月，","宴殿金麟吐御香。"],["蜀锦地衣呈队舞，","教头先出拜君王。"]]}
{"id":"9b0e70a9fa","title":"宫词 三十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天外明河翻玉浪，","楼西凉月涌金盆。","香销甲乙床前帐，","宫锁玲珑闭殿门。"],"stanzas":[["天外明河翻玉浪，","楼西凉月涌金盆。"],["香销甲乙床前帐，","宫锁玲珑闭殿门。"]]}
{"id":"7c08b6e70d","title":"宫词 三十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细风攲叶撼宫梧，","早怯秋寒著绣𦈡。","玉宇无人双燕去，","一弯新月上金枢。"],"stanzas":[["细风攲叶撼宫梧，","早怯秋寒著绣𦈡。"],["玉宇无人双燕去，","一弯新月上金枢。"]]}
{"id":"07b8cd71ac","title":"宫词 三十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜寒金屋篆烟飞，","灯烛分明在紫微。","漏永禁宫三十六，","燕回争踏月轮归。"],"stanzas":[["夜寒金屋篆烟飞，","灯烛分明在紫微。"],["漏永禁宫三十六，","燕回争踏月轮归。"]]}
{"id":"0a50e1c471","title":"宫词 三十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓吹翩翩动翠旗，","炉烟千叠瑞云飞。","何人奏对偏移刻，","御史天香隔绣衣。"],"stanzas":[["晓吹翩翩动翠旗，","炉烟千叠瑞云飞。"],["何人奏对偏移刻，","御史天香隔绣衣。"]]}
{"id":"7c5204605d","title":"宫词 三十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金井秋啼络纬声，","出花宫漏报严更。","不知谁是金銮直，","玉宇沈沈夜气清。"],"stanzas":[["金井秋啼络纬声，","出花宫漏报严更。"],["不知谁是金銮直，","玉宇沈沈夜气清。"]]}
{"id":"fa60445ab8","title":"宫词 三十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内庭秋燕玉池东，","香散荷花水殿风。","阿监采菱牵锦缆，","月明犹在画船中。"],"stanzas":[["内庭秋燕玉池东，","香散荷花水殿风。"],["阿监采菱牵锦缆，","月明犹在画船中。"]]}
{"id":"19e3c17b4e","title":"宫词 四十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东宫花烛彩楼新，","天上仙桥上锁春。","偏出六宫歌舞奏，","嫦娥初到月虚轮。"],"stanzas":[["东宫花烛彩楼新，","天上仙桥上锁春。"],["偏出六宫歌舞奏，","嫦娥初到月虚轮。"]]}
{"id":"9fee333f47","title":"宫词 四十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["纱幔薄垂金麦穗，","帘钩纤挂玉葱条。","楼西别起长春殿，","香碧红泥透蜀椒。"],"stanzas":[["纱幔薄垂金麦穗，","帘钩纤挂玉葱条。"],["楼西别起长春殿，","香碧红泥透蜀椒。"]]}
{"id":"964e6903fc","title":"宫词 四十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠华香重玉炉添，","双凤楼头晓日暹。","扇掩红鸾金殿悄，","一声清跸卷珠帘。"],"stanzas":[["翠华香重玉炉添，","双凤楼头晓日暹。"],["扇掩红鸾金殿悄，","一声清跸卷珠帘。"]]}
{"id":"47f9e25692","title":"宫词 四十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金作蟠龙绣作麟，","壶中楼阁禁中春。","君王避暑来游幸，","风月横秋气象新。"],"stanzas":[["金作蟠龙绣作麟，","壶中楼阁禁中春。"],["君王避暑来游幸，","风月横秋气象新。"]]}
{"id":"95416e6e9d","title":"宫词 四十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清晓自倾花上露，","冷侵宫殿玉蟾蜍。","擘开五色销金纸，","碧锁窗前学草书。"],"stanzas":[["清晓自倾花上露，","冷侵宫殿玉蟾蜍。"],["擘开五色销金纸，","碧锁窗前学草书。"]]}
{"id":"42262371fe","title":"宫词 四十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠钿贴靥轻如笑，","玉凤雕钗褭欲飞。","拂晓贺春皇帝阁，","彩衣金胜近龙衣。"],"stanzas":[["翠钿贴靥轻如笑，","玉凤雕钗褭欲飞。"],["拂晓贺春皇帝阁，","彩衣金胜近龙衣。"]]}
{"id":"08df28c1f5","title":"宫词 四十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["璅声金彻合门环，","帘卷珍珠十二间。","别殿春风呼万岁，","中丞新押散朝班。"],"stanzas":[["璅声金彻合门环，","帘卷珍珠十二间。"],["别殿春风呼万岁，","中丞新押散朝班。"]]}
{"id":"ef5f15bbdf","title":"宫词 四十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸡人报晓传三唱，","玉井金床转辘轳。","烟引御炉香绕殿，","漏签初刻上铜壶。"],"stanzas":[["鸡人报晓传三唱，","玉井金床转辘轳。"],["烟引御炉香绕殿，","漏签初刻上铜壶。"]]}
{"id":"981ebd4b42","title":"宫词 四十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御按横金殿幄红，","扇开云表露天容。","太常奏备三千曲，","乐府新调十二钟。"],"stanzas":[["御按横金殿幄红，","扇开云表露天容。"],["太常奏备三千曲，","乐府新调十二钟。"]]}
{"id":"4c5841a7a4","title":"宫词 四十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫女熏香进御衣，","殿门开锁请金匙。","朝阳初上黄金屋，","禁夜春深昼漏迟。"],"stanzas":[["宫女熏香进御衣，","殿门开锁请金匙。"],["朝阳初上黄金屋，","禁夜春深昼漏迟。"]]}
{"id":"717e415ca6","title":"宫词 五十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三月金明柳絮飞，","岸花堤草弄春时。","楼船百戏催宣赐，","御辇今年不上池。"],"stanzas":[["三月金明柳絮飞，","岸花堤草弄春时。"],["楼船百戏催宣赐，","御辇今年不上池。"]]}
{"id":"7a94af8df2","title":"宫词 五十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内人稀见水秋千，","争擘珠帘帐殿前。","第一锦标谁夺得，","右军输却小龙船。"],"stanzas":[["内人稀见水秋千，","争擘珠帘帐殿前。"],["第一锦标谁夺得，","右军输却小龙船。"]]}
{"id":"3e628ce1a9","title":"宫词 五十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜色楼台月数层，","金猊烟穗绕觚棱。","重廊屈折连三殿，","密上真珠百宝灯。"],"stanzas":[["夜色楼台月数层，","金猊烟穗绕觚棱。"],["重廊屈折连三殿，","密上真珠百宝灯。"]]}
{"id":"b1c15123e9","title":"宫词 五十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天门晏闭九重关，","楼倚银河气象间。","一点星毬垂绛阙，","五云仙仗下蓬山。"],"stanzas":[["天门晏闭九重关，","楼倚银河气象间。"],["一点星毬垂绛阙，","五云仙仗下蓬山。"]]}
{"id":"2a4f716968","title":"宫词 五十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禁里春浓蝶自飞，","御蚕眠处弄新丝。","碧窗尽日教鹦鹉，","念得君王数首诗。"],"stanzas":[["禁里春浓蝶自飞，","御蚕眠处弄新丝。"],["碧窗尽日教鹦鹉，","念得君王数首诗。"]]}
{"id":"6728353bb8","title":"宫词 五十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鬬草深宫玉槛前，","春蒲如箭荇如钱。","不如红药阑干曲，","日暮何人落翠钿。"],"stanzas":[["鬬草深宫玉槛前，","春蒲如箭荇如钱。"],["不如红药阑干曲，","日暮何人落翠钿。"]]}
{"id":"d43cc8cc1d","title":"宫词 五十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太液波清水殿凉，","画船惊起宿鸳鸯。","翠眉不及池边柳，","取次飞花入建章。"],"stanzas":[["太液波清水殿凉，","画船惊起宿鸳鸯。"],["翠眉不及池边柳，","取次飞花入建章。"]]}
{"id":"c7099cddf2","title":"宫词 五十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御座垂帘绣额单，","冰山重叠贮金盘。","玉清迢遰无尘到，","殿角东西五月寒。"],"stanzas":[["御座垂帘绣额单，","冰山重叠贮金盘。"],["玉清迢遰无尘到，","殿角东西五月寒。"]]}
{"id":"97e24b133d","title":"宫词 五十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春心滴破花边漏，","晓梦敲回禁里钟。","十二楚山何处是，","御楼曾见两三峰。"],"stanzas":[["春心滴破花边漏，","晓梦敲回禁里钟。"],["十二楚山何处是，","御楼曾见两三峰。"]]}
{"id":"ea94d3b522","title":"宫词 五十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["博山夜宿沉香火，","帐外时闻暖凤笙。","理遍从头新上曲，","殿前龙直未交更。"],"stanzas":[["博山夜宿沉香火，","帐外时闻暖凤笙。"],["理遍从头新上曲，","殿前龙直未交更。"]]}
{"id":"c522d3cc34","title":"宫词 六十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春殿千官宴却归，","上林莺舌报花时。","宣徽旋进新裁曲，","学士争吟应诏诗。"],"stanzas":[["春殿千官宴却归，","上林莺舌报花时。"],["宣徽旋进新裁曲，","学士争吟应诏诗。"]]}
{"id":"ff0e64a6f4","title":"宫词 六十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钓线沈波漾彩舟，","鱼争芳饵上龙钩。","内人急捧金盘接，","拨刺红鳞跃未休。"],"stanzas":[["钓线沈波漾彩舟，","鱼争芳饵上龙钩。"],["内人急捧金盘接，","拨刺红鳞跃未休。"]]}
{"id":"01033db299","title":"宫词 六十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蕙炷香销烛影残，","御衣熏尽輙更阑。","归来困顿眠红帐，","一枕西风梦里寒。"],"stanzas":[["蕙炷香销烛影残，","御衣熏尽輙更阑。"],["归来困顿眠红帐，","一枕西风梦里寒。"]]}
{"id":"8df7732a52","title":"宫词 六十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东宫降诞挺佳辰，","少海星边拥瑞云。","中尉传闻三日宴，","翰林当撰洗儿文。"],"stanzas":[["东宫降诞挺佳辰，","少海星边拥瑞云。"],["中尉传闻三日宴，","翰林当撰洗儿文。"]]}
{"id":"ec705e1807","title":"宫词 六十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒库新修近水傍，","泼醅初熟五云浆。","殿前供御频宣索，","追入花间一阵香。"],"stanzas":[["酒库新修近水傍，","泼醅初熟五云浆。"],["殿前供御频宣索，","追入花间一阵香。"]]}
{"id":"e6eada2d3d","title":"宫词 六十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白藤花限白银花，","合子门当寝殿斜。","近被宫中知了事，","每来随驾使煎茶。"],"stanzas":[["白藤花限白银花，","合子门当寝殿斜。"],["近被宫中知了事，","每来随驾使煎茶。"]]}
{"id":"c426e5485b","title":"宫词 六十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西毬场里打毬回，","御宴先于苑内开。","宣索教坊诸伎乐，","傍池催唤入船来。"],"stanzas":[["西毬场里打毬回，","御宴先于苑内开。"],["宣索教坊诸伎乐，","傍池催唤入船来。"]]}
{"id":"4422374ada","title":"宫词 六十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昭仪侍宴足精神，","玉烛抽看记饮巡。","倚赖识书为录事，","灯前时复错瞒人。"],"stanzas":[["昭仪侍宴足精神，","玉烛抽看记饮巡。"],["倚赖识书为录事，","灯前时复错瞒人。"]]}
{"id":"9bcd44b9e9","title":"宫词 六十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["后宫阿监裹罗巾，","出入经过苑囿频。","承奉圣颜忧悮失，","就中长怕内夫人。"],"stanzas":[["后宫阿监裹罗巾，","出入经过苑囿频。"],["承奉圣颜忧悮失，","就中长怕内夫人。"]]}
{"id":"a79951fbfa","title":"宫词 六十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["管弦声急满龙池，","宫女藏钩夜宴时。","好是圣人亲捉得，","便将浓墨扫双眉。"],"stanzas":[["管弦声急满龙池，","宫女藏钩夜宴时。"],["好是圣人亲捉得，","便将浓墨扫双眉。"]]}
{"id":"e021eaa4d3","title":"宫词 七十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["密室红泥地火炉，","内人冬日晚传呼。","今宵驾幸池头宿，","排比椒房得煖无。"],"stanzas":[["密室红泥地火炉，","内人冬日晚传呼。"],["今宵驾幸池头宿，","排比椒房得煖无。"]]}
{"id":"c2d2da37ce","title":"宫词 七十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["画船花舫总新妆，","进入池心近岛傍。","松柏楼窗楠木板，","暖风吹过一团香。"],"stanzas":[["画船花舫总新妆，","进入池心近岛傍。"],["松柏楼窗楠木板，","暖风吹过一团香。"]]}
{"id":"2805fe0325","title":"宫词 七十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三清台近苑墙东，","楼槛层层映水红。","尽日绮罗人度曲，","管弦声在半天中。"],"stanzas":[["三清台近苑墙东，","楼槛层层映水红。"],["尽日绮罗人度曲，","管弦声在半天中。"]]}
{"id":"c797a8fdd6","title":"宫词 七十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["安排诸院接行廊，","外槛周回十里强。","青锦地衣红绣毯，","尽铺龙脑郁金香。"],"stanzas":[["安排诸院接行廊，","外槛周回十里强。"],["青锦地衣红绣毯，","尽铺龙脑郁金香。"]]}
{"id":"54d8c26833","title":"宫词 七十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["安排竹栅与笆篱，","养得新生鹁鸽儿。","宣受内家专喂饲，","花毛间看总皆知。"],"stanzas":[["安排竹栅与笆篱，","养得新生鹁鸽儿。"],["宣受内家专喂饲，","花毛间看总皆知。"]]}
{"id":"46240aea82","title":"宫词 七十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年初十五最风流，","新赐云鬟便上头。","按罢霓裳归院里，","画楼云阁总重修。"],"stanzas":[["年初十五最风流，","新赐云鬟便上头。"],["按罢霓裳归院里，","画楼云阁总重修。"]]}
{"id":"26c0f0cd53","title":"宫词 七十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金画香台出露盘，","黄龙雕刻绕朱阑。","焚修每遇三元节，","天子亲簪白玉冠。"],"stanzas":[["金画香台出露盘，","黄龙雕刻绕朱阑。"],["焚修每遇三元节，","天子亲簪白玉冠。"]]}
{"id":"96ce783be5","title":"宫词 七十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六宫一例鸡冠子，","新样交镌白玉花。","欲试澹妆兼道服，","面前宣与唾盂家。"],"stanzas":[["六宫一例鸡冠子，","新样交镌白玉花。"],["欲试澹妆兼道服，","面前宣与唾盂家。"]]}
{"id":"036ee12a8c","title":"宫词 七十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三月樱桃乍熟时，","内人相引看红枝。","回头索取黄金弹，","绕树藏身打雀儿。"],"stanzas":[["三月樱桃乍熟时，","内人相引看红枝。"],["回头索取黄金弹，","绕树藏身打雀儿。"]]}
{"id":"ce8256741d","title":"宫词 七十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小小宫娥到内园，","未梳云鬓脸如莲。","自从配与夫人后，","不使寻花乱入船。"],"stanzas":[["小小宫娥到内园，","未梳云鬓脸如莲。"],["自从配与夫人后，","不使寻花乱入船。"]]}
{"id":"dc84fafc85","title":"宫词 八十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦城上起凝烟阁，","拥殿遮楼一向高。","认得圣颜遥望见，","碧阑干映赭黄袍。"],"stanzas":[["锦城上起凝烟阁，","拥殿遮楼一向高。"],["认得圣颜遥望见，","碧阑干映赭黄袍。"]]}
{"id":"d2fca15ae5","title":"宫词 八十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水车踏水上宫城，","寝殿簷头滴滴鸣。","助得圣人高枕兴，","夜凉长作远滩声。"],"stanzas":[["水车踏水上宫城，","寝殿簷头滴滴鸣。"],["助得圣人高枕兴，","夜凉长作远滩声。"]]}
{"id":"73b0eed133","title":"宫词 八十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平头船子小龙床，","多少神仙立御旁。","旋刺篙竿令过岸，","满池春水蘸红妆。"],"stanzas":[["平头船子小龙床，","多少神仙立御旁。"],["旋刺篙竿令过岸，","满池春水蘸红妆。"]]}
{"id":"3a4cfff5a7","title":"宫词 八十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苑东天子爱巡游，","御岸花堤枕碧流。","新教内人供射鸭，","长将弓箭绕池头。"],"stanzas":[["苑东天子爱巡游，","御岸花堤枕碧流。"],["新教内人供射鸭，","长将弓箭绕池头。"]]}
{"id":"fbcfd532a7","title":"宫词 八十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["罗衫玉带最风流，","斜插银箆慢裹头。","闲向殿前骑御马，","挥鞭横过小红楼。"],"stanzas":[["罗衫玉带最风流，","斜插银箆慢裹头。"],["闲向殿前骑御马，","挥鞭横过小红楼。"]]}
{"id":"4e6d6ee309","title":"宫词 八十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沉香亭子傍池斜，","夏日巡游歇翠华。","帘畔玉盆盛净水，","内人手里剖银瓜。"],"stanzas":[["沉香亭子傍池斜，","夏日巡游歇翠华。"],["帘畔玉盆盛净水，","内人手里剖银瓜。"]]}
{"id":"86203353b6","title":"宫词 八十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["薄罗衫子透肌肤，","夏日初长板阁虚。","独自凭阑无一事，","水风凉处读文书。"],"stanzas":[["薄罗衫子透肌肤，","夏日初长板阁虚。"],["独自凭阑无一事，","水风凉处读文书。"]]}
{"id":"34280920a4","title":"宫词 八十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["婕妤生长帝王家，","常近龙颜逐翠华。","杨柳岸长春日暮，","傍池行困倚桃花。"],"stanzas":[["婕妤生长帝王家，","常近龙颜逐翠华。"],["杨柳岸长春日暮，","傍池行困倚桃花。"]]}
{"id":"4e9f9b432d","title":"宫词 八十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月头支给买花钱，","满殿宫人近数千。","遇著唱名多不语，","含羞走过御床前。"],"stanzas":[["月头支给买花钱，","满殿宫人近数千。"],["遇著唱名多不语，","含羞走过御床前。"]]}
{"id":"e9a59fa2a6","title":"宫词 八十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小雨霏微润绿苔，","石楠红杏傍池开。","一枝插向金瓶里，","捧进君王玉殿来。"],"stanzas":[["小雨霏微润绿苔，","石楠红杏傍池开。"],["一枝插向金瓶里，","捧进君王玉殿来。"]]}
{"id":"5a8cef8d0d","title":"宫词 九十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦鳞跃水出浮萍，","荇草牵风翠带横。","恰似金梭撺碧沼，","好题幽恨写闺情。"],"stanzas":[["锦鳞跃水出浮萍，","荇草牵风翠带横。"],["恰似金梭撺碧沼，","好题幽恨写闺情。"]]}
{"id":"17ba548089","title":"宫词 九十一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春天睡起晓妆成，","随侍君王触处行。","画得自家梳洗样，","相凭女伴把来呈。"],"stanzas":[["春天睡起晓妆成，","随侍君王触处行。"],["画得自家梳洗样，","相凭女伴把来呈。"]]}
{"id":"a771d39934","title":"宫词 九十二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舞头皆著画罗衣，","唱得新翻御制词。","每日内庭闻教队，","乐声飞上到龙墀。"],"stanzas":[["舞头皆著画罗衣，","唱得新翻御制词。"],["每日内庭闻教队，","乐声飞上到龙墀。"]]}
{"id":"32d77389b0","title":"宫词 九十三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春早寻花入内园，","竞传宣旨欲黄昏。","明朝驾幸游蚕市，","暗使氊车就苑门。"],"stanzas":[["春早寻花入内园，","竞传宣旨欲黄昏。"],["明朝驾幸游蚕市，","暗使氊车就苑门。"]]}
{"id":"88ddf92b73","title":"宫词 九十四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["半夜摇船载内家，","水门红蜡一行斜。","圣人正在宫中饮，","宣使池头旋折花。"],"stanzas":[["半夜摇船载内家，","水门红蜡一行斜。"],["圣人正在宫中饮，","宣使池头旋折花。"]]}
{"id":"4080184b8a","title":"宫词 九十五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春日龙池小宴开，","岸边亭子号流杯。","沈檀刻作神仙女，","对捧金尊水上来。"],"stanzas":[["春日龙池小宴开，","岸边亭子号流杯。"],["沈檀刻作神仙女，","对捧金尊水上来。"]]}
{"id":"9f67e31c8d","title":"宫词 九十六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梨园子弟簇池头，","小乐携来候宴游。","旋炙银笙先按拍，","海棠花下合梁州。"],"stanzas":[["梨园子弟簇池头，","小乐携来候宴游。"],["旋炙银笙先按拍，","海棠花下合梁州。"]]}
{"id":"8341b76beb","title":"宫词 九十七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["慢梳鬟髻著轻红，","春早争求芍药丛。","近日承恩移住处，","夹城里面占新宫。"],"stanzas":[["慢梳鬟髻著轻红，","春早争求芍药丛。"],["近日承恩移住处，","夹城里面占新宫。"]]}
{"id":"eb0d6a4e31","title":"宫词 九十八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["别色官司御辇家，","黄衫束带脸如花。","深宫内院参承惯，","常从金舆到日斜。"],"stanzas":[["别色官司御辇家，","黄衫束带脸如花。"],["深宫内院参承惯，","常从金舆到日斜。"]]}
{"id":"4dd181e861","title":"宫词 九十九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日高房里学围碁，","等候官家未出时。","为赌金钱争路数，","专忧女伴怪来迟。"],"stanzas":[["日高房里学围碁，","等候官家未出时。"],["为赌金钱争路数，","专忧女伴怪来迟。"]]}
{"id":"717693abfb","title":"宫词 一百","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["摴蒱冷澹学投壶，","箭倚腰身约画图。","尽对君王称妙手，","一人来射一人输。"],"stanzas":[["摴蒱冷澹学投壶，","箭倚腰身约画图。"],["尽对君王称妙手，","一人来射一人输。"]]}
{"id":"9098500db5","title":"宫词 一百一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["慢揎红袖指纤纤，","学钓池鱼傍水边。","忍冷不禁还自去，","钓竿常被别人牵。"],"stanzas":[["慢揎红袖指纤纤，","学钓池鱼傍水边。"],["忍冷不禁还自去，","钓竿常被别人牵。"]]}
{"id":"285ca01e1a","title":"宫词 一百二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宣城院约池南岸，","粉壁红窗画不成。","总是一人行幸处，","彻宵闻奏管弦声。"],"stanzas":[["宣城院约池南岸，","粉壁红窗画不成。"],["总是一人行幸处，","彻宵闻奏管弦声。"]]}
{"id":"5371c8a4b8","title":"宫词 一百三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹霞亭浸池心冷，","曲沼门含水脚清。","傍岸鸳鸯皆著对，","时时出向浅沙行。"],"stanzas":[["丹霞亭浸池心冷，","曲沼门含水脚清。"],["傍岸鸳鸯皆著对，","时时出向浅沙行。"]]}
{"id":"e3acdbfa19","title":"宫词 一百四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳阴中引御沟，","碧梧桐树拥朱楼。","金陵城共滕王阁，","画向丹青也合羞。"],"stanzas":[["杨柳阴中引御沟，","碧梧桐树拥朱楼。"],["金陵城共滕王阁，","画向丹青也合羞。"]]}
{"id":"d093b700f6","title":"宫词 一百五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚来随驾上城游，","行到东西百子楼。","回望苑中花柳色，","绿阴红艳满池头。"],"stanzas":[["晚来随驾上城游，","行到东西百子楼。"],["回望苑中花柳色，","绿阴红艳满池头。"]]}
{"id":"e5990b8df9","title":"宫词 一百六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牡丹移向苑中栽，","尽是藩方进入来。","未到末春缘地暖，","数般颜色一时开。"],"stanzas":[["牡丹移向苑中栽，","尽是藩方进入来。"],["未到末春缘地暖，","数般颜色一时开。"]]}
{"id":"cb80a25c1d","title":"宫词 一百七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明朝腊日官家出，","随驾先须点内人。","回鹘衣装回鹘马，","就中偏称小腰身。"],"stanzas":[["明朝腊日官家出，","随驾先须点内人。"],["回鹘衣装回鹘马，","就中偏称小腰身。"]]}
{"id":"65d5b811d0","title":"宫词 一百八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盘凤鞍鞯闪色妆，","黄金压胯紫游缰。","自从拣得真龙种，","别置东头小马坊。"],"stanzas":[["盘凤鞍鞯闪色妆，","黄金压胯紫游缰。"],["自从拣得真龙种，","别置东头小马坊。"]]}
{"id":"e3c392e77d","title":"宫词 一百九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠辇每从城畔出，","内人相次簇池隈。","嫩荷花里摇船去，","一阵香风逐水来。"],"stanzas":[["翠辇每从城畔出，","内人相次簇池隈。"],["嫩荷花里摇船去，","一阵香风逐水来。"]]}
{"id":"a6bed9f6c3","title":"宫词 一百一十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高烧红烛点银灯，","秋晚花池景色澄。","今夜圣人新殿宿，","后宫相竞觅祇承。"],"stanzas":[["高烧红烛点银灯，","秋晚花池景色澄。"],["今夜圣人新殿宿，","后宫相竞觅祇承。"]]}
{"id":"1ffc660692","title":"宫词 一一一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苑中排比宴秋宵，","弦管挣摐各自调。","日晚阁门传圣旨，","明朝尽放紫宸朝。"],"stanzas":[["苑中排比宴秋宵，","弦管挣摐各自调。"],["日晚阁门传圣旨，","明朝尽放紫宸朝。"]]}
{"id":"759b8b3ef1","title":"宫词 一一二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜深饮散月初斜，","无限宫嫔乱插花。","近侍婕妤先过水，","遥闻隔岸唤船家。"],"stanzas":[["夜深饮散月初斜，","无限宫嫔乱插花。"],["近侍婕妤先过水，","遥闻隔岸唤船家。"]]}
{"id":"cfa1d5d7a2","title":"宫词 一一三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫娥小小艳红妆，","唱得歌声绕画梁。","缘是太妃新进入，","座前颁赐小罗箱。"],"stanzas":[["宫娥小小艳红妆，","唱得歌声绕画梁。"],["缘是太妃新进入，","座前颁赐小罗箱。"]]}
{"id":"fd028ae028","title":"宫词 一一四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["池心小样钓鱼船，","入玩偏宜向晚天。","挂得彩帆教便放，","急风吹过水门前。"],"stanzas":[["池心小样钓鱼船，","入玩偏宜向晚天。"],["挂得彩帆教便放，","急风吹过水门前。"]]}
{"id":"f3c5b297ab","title":"宫词 一一五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["傍池居住有渔家，","收网摇船到浅沙。","预进活鱼供日料，","满筐跳跃白银花。"],"stanzas":[["傍池居住有渔家，","收网摇船到浅沙。"],["预进活鱼供日料，","满筐跳跃白银花。"]]}
{"id":"b9b1cee903","title":"宫词 一一六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋晚红妆傍水行，","竞将衣袖扑蜻蜓。","回头瞥见宫中唤，","几度藏身入画屏。"],"stanzas":[["秋晚红妆傍水行，","竞将衣袖扑蜻蜓。"],["回头瞥见宫中唤，","几度藏身入画屏。"]]}
{"id":"35c02a3076","title":"宫词 一一七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御沟春水碧于天，","宫女寻花入内园。","汗湿红妆行渐困，","岸头相唤洗花钿。"],"stanzas":[["御沟春水碧于天，","宫女寻花入内园。"],["汗湿红妆行渐困，","岸头相唤洗花钿。"]]}
{"id":"d6a0d93f93","title":"宫词 一一八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亭高百尺立春风，","引得君王到此中。","床上翠屏开六扇，","折枝花绽牡丹红。"],"stanzas":[["亭高百尺立春风，","引得君王到此中。"],["床上翠屏开六扇，","折枝花绽牡丹红。"]]}
{"id":"eb6f134fe2","title":"宫词 一一九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内人承宠赐新房，","红纸泥窗绕画廊。","种得海柑才结子，","乞求自送与君王。"],"stanzas":[["内人承宠赐新房，","红纸泥窗绕画廊。"],["种得海柑才结子，","乞求自送与君王。"]]}
{"id":"ed185436e6","title":"宫词 一百二十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翡翠帘前日影斜，","御沟春水浸成霞。","侍臣向晚随天步，","共看池头满树花。"],"stanzas":[["翡翠帘前日影斜，","御沟春水浸成霞。"],["侍臣向晚随天步，","共看池头满树花。"]]}
{"id":"13d31c9a0d","title":"宫词 一二一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金碧阑干倚岸边，","卷帘初听一声蝉。","殿头日午摇纨扇，","宫女争来玉座前。"],"stanzas":[["金碧阑干倚岸边，","卷帘初听一声蝉。"],["殿头日午摇纨扇，","宫女争来玉座前。"]]}
{"id":"dba00afbdc","title":"宫词 一二二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嫩荷香扑钓鱼亭，","水面文鱼作队行。","宫女齐来池畔看，","傍帘呼唤勿高声。"],"stanzas":[["嫩荷香扑钓鱼亭，","水面文鱼作队行。"],["宫女齐来池畔看，","傍帘呼唤勿高声。"]]}
{"id":"4bd530b000","title":"宫词 一二三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新翻酒令著词章，","侍宴初闻忆却忙。","宣使近臣传赐本，","书家院里徧抄将。"],"stanzas":[["新翻酒令著词章，","侍宴初闻忆却忙。"],["宣使近臣传赐本，","书家院里徧抄将。"]]}
{"id":"b326e6ffad","title":"宫词 一二四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒食清明小殿旁，","彩楼双夹鬬鸡场。","内人对御分明看，","先赌红罗被十床。"],"stanzas":[["寒食清明小殿旁，","彩楼双夹鬬鸡场。"],["内人对御分明看，","先赌红罗被十床。"]]}
{"id":"4613a19b09","title":"宫词 一二五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寝殿门前晓色开，","红泥药树间花栽。","君王未起翠帘卷，","又发宫人上直来。"],"stanzas":[["寝殿门前晓色开，","红泥药树间花栽。"],["君王未起翠帘卷，","又发宫人上直来。"]]}
{"id":"ded6695bff","title":"宫词 一二六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海棠花发盛春天，","游赏无时引御筵。","绕岸结成红锦帐，","暖枝犹拂画楼船。"],"stanzas":[["海棠花发盛春天，","游赏无时引御筵。"],["绕岸结成红锦帐，","暖枝犹拂画楼船。"]]}
{"id":"c54e13ef10","title":"宫词 一二七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日晚宫人外按回，","自牵骢马出林隈。","御前接得高叉手，","射得山鸡喜进来。"],"stanzas":[["日晚宫人外按回，","自牵骢马出林隈。"],["御前接得高叉手，","射得山鸡喜进来。"]]}
{"id":"8d001b8891","title":"宫词 一二八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱雀门高花外开，","毬场空阔净尘埃。","预排白兔兼苍狗，","等候君王按鹘来。"],"stanzas":[["朱雀门高花外开，","毬场空阔净尘埃。"],["预排白兔兼苍狗，","等候君王按鹘来。"]]}
{"id":"625540ac53","title":"宫词 一二九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["会仙观内玉清坛，","新点宫人作女冠。","每度驾来羞不出，","羽衣初著怕人看。"],"stanzas":[["会仙观内玉清坛，","新点宫人作女冠。"],["每度驾来羞不出，","羽衣初著怕人看。"]]}
{"id":"2ca9707678","title":"宫词 一百三十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老大初教学道人，","鹿皮冠子澹黄裙。","后宫歌舞今抛掷，","每日焚香事老君。"],"stanzas":[["老大初教学道人，","鹿皮冠子澹黄裙。"],["后宫歌舞今抛掷，","每日焚香事老君。"]]}
{"id":"02fa54400e","title":"宫词 一三一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["法云寺里中元节，","又是官家诞降辰。","满殿香花争供养，","内园先占得铺陈。"],"stanzas":[["法云寺里中元节，","又是官家诞降辰。"],["满殿香花争供养，","内园先占得铺陈。"]]}
{"id":"7a1e8f7c69","title":"宫词 一三二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金章紫绶选高班，","每每东头近圣颜。","才艺足当恩宠别，","只堪供奉一场闲。"],"stanzas":[["金章紫绶选高班，","每每东头近圣颜。"],["才艺足当恩宠别，","只堪供奉一场闲。"]]}
{"id":"96e556a85e","title":"宫词 一三三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内人深夜学迷藏，","徧绕花丛水岸傍。","乘兴忽来仙洞里，","大家寻觅一时忙。"],"stanzas":[["内人深夜学迷藏，","徧绕花丛水岸傍。"],["乘兴忽来仙洞里，","大家寻觅一时忙。"]]}
{"id":"c9c8a710b8","title":"宫词 一三四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小院珠帘著地垂，","院中排比不相知。","羡他鹦鹉能言语，","窗里偷教鸜鹆儿。"],"stanzas":[["小院珠帘著地垂，","院中排比不相知。"],["羡他鹦鹉能言语，","窗里偷教鸜鹆儿。"]]}
{"id":"46ffbc88af","title":"宫词 一三五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岛树高低约浪痕，","苑中斜日欲黄昏。","树头木刻双飞鹤，","荡起晴空映水门。"],"stanzas":[["岛树高低约浪痕，","苑中斜日欲黄昏。"],["树头木刻双飞鹤，","荡起晴空映水门。"]]}
{"id":"8a56b6d917","title":"宫词 一三六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大臣承宠赐新庄，","栀子园东柳岸傍。","今日圣恩亲幸到，","板桥头是读书堂。"],"stanzas":[["大臣承宠赐新庄，","栀子园东柳岸傍。"],["今日圣恩亲幸到，","板桥头是读书堂。"]]}
{"id":"f85bcbe85b","title":"宫词 一三七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["树叶初成鸟护窠，","石榴花里笑声多。","众中遗却金钗子，","拾得从他要赎么。"],"stanzas":[["树叶初成鸟护窠，","石榴花里笑声多。"],["众中遗却金钗子，","拾得从他要赎么。"]]}
{"id":"de8148ab6b","title":"宫词 一三八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小殿初成粉未干，","贵妃姊妹自来看。","为逢好日先移入，","续向街西索牡丹。"],"stanzas":[["小殿初成粉未干，","贵妃姊妹自来看。"],["为逢好日先移入，","续向街西索牡丹。"]]}
{"id":"983f66e557","title":"宫词 一三九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内人相续报花开，","准拟君王便看来。","逢著五弦琴绣袋，","宜春院里按歌回。"],"stanzas":[["内人相续报花开，","准拟君王便看来。"],["逢著五弦琴绣袋，","宜春院里按歌回。"]]}
{"id":"0f8d02b6f6","title":"宫词 一百四十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巡吹慢遍不相和，","暗数看谁曲校多。","明日梨花园里见，","先须逐得内家歌。"],"stanzas":[["巡吹慢遍不相和，","暗数看谁曲校多。"],["明日梨花园里见，","先须逐得内家歌。"]]}
{"id":"5bcfeb5813","title":"宫词 一四一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄金合里盛红雪，","重结香罗四出花。","一一傍边书勑字，","中官送与大臣家。"],"stanzas":[["黄金合里盛红雪，","重结香罗四出花。"],["一一傍边书勑字，","中官送与大臣家。"]]}
{"id":"ebcbdcb00a","title":"宫词 一四二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫人早起笑相呼，","不识堦前扫地夫。","乞与金钱争借问，","外头还似此间无。"],"stanzas":[["宫人早起笑相呼，","不识堦前扫地夫。"],["乞与金钱争借问，","外头还似此间无。"]]}
{"id":"cb90ea9624","title":"宫词 一四三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小随阿姊学吹笙，","见好君王赐与名。","夜拂玉床朝把镜，","黄金殿外不教行。"],"stanzas":[["小随阿姊学吹笙，","见好君王赐与名。"],["夜拂玉床朝把镜，","黄金殿外不教行。"]]}
{"id":"6b8aa9a374","title":"宫词 一四四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日高殿里有香烟，","万岁声长动九天。","妃子院中初降诞，","内人争乞洗儿钱。"],"stanzas":[["日高殿里有香烟，","万岁声长动九天。"],["妃子院中初降诞，","内人争乞洗儿钱。"]]}
{"id":"5ecae0df95","title":"宫词 一四五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫花不共外花同，","正月长生一半红。","供御樱桃看守别，","直无鸦鹊到园中。"],"stanzas":[["宫花不共外花同，","正月长生一半红。"],["供御樱桃看守别，","直无鸦鹊到园中。"]]}
{"id":"9b0d89429c","title":"宫词 一四六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿前铺设两边楼，","寒食宫人步打毬。","一半走来争跪拜，","上棚先谢得头筹。"],"stanzas":[["殿前铺设两边楼，","寒食宫人步打毬。"],["一半走来争跪拜，","上棚先谢得头筹。"]]}
{"id":"93d88dc5b3","title":"宫词 一四七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大仪前日暖房来，","嘱向朝阳乞药栽。","勑赐一窠红踯躅，","谢恩未了奏花开。"],"stanzas":[["大仪前日暖房来，","嘱向朝阳乞药栽。"],["勑赐一窠红踯躅，","谢恩未了奏花开。"]]}
{"id":"7bff99ddc5","title":"宫词 一四八","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御前新赐紫罗襦，","步步金堦上软舆。","宫局总来为喜乐，","院中新拜内尚书。"],"stanzas":[["御前新赐紫罗襦，","步步金堦上软舆。"],["宫局总来为喜乐，","院中新拜内尚书。"]]}
{"id":"2d7887259f","title":"宫词 一四九","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹦鹉谁教转舌关，","内人手里养来奸。","语多更觉承恩泽，","数对君王忆陇山。"],"stanzas":[["鹦鹉谁教转舌关，","内人手里养来奸。"],["语多更觉承恩泽，","数对君王忆陇山。"]]}
{"id":"b92cd06fa1","title":"宫词 一百五十","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["分朋闲坐赌樱桃，","收却投壶玉腕劳。","各把沉香双陆子，","局中鬬累阿谁高。"],"stanzas":[["分朋闲坐赌樱桃，","收却投壶玉腕劳。"],["各把沉香双陆子，","局中鬬累阿谁高。"]]}
{"id":"f1d82c6e1b","title":"宫词 一五一","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禁寺红楼内里通，","笙歌引驾夹城东。","裹头宫监堂前立，","手把牙鞘竹弹弓。"],"stanzas":[["禁寺红楼内里通，","笙歌引驾夹城东。"],["裹头宫监堂前立，","手把牙鞘竹弹弓。"]]}
{"id":"66a6cfe923","title":"宫词 一五二","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舞来汗湿罗衣彻，","楼上人扶下玉梯。","归到院中重洗面，","金花盆里泼银泥。"],"stanzas":[["舞来汗湿罗衣彻，","楼上人扶下玉梯。"],["归到院中重洗面，","金花盆里泼银泥。"]]}
{"id":"721c00b09f","title":"宫词 一五三","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宿妆残粉未明天，","总立昭阳花树边。","寒食内人长白打，","库中先散与金钱。"],"stanzas":[["宿妆残粉未明天，","总立昭阳花树边。"],["寒食内人长白打，","库中先散与金钱。"]]}
{"id":"aa20180cf9","title":"宫词 一五四","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["众中偏得君王笑，","偷把金箱笔砚开。","书破红蛮隔子上，","旋推当直美人来。"],"stanzas":[["众中偏得君王笑，","偷把金箱笔砚开。"],["书破红蛮隔子上，","旋推当直美人来。"]]}
