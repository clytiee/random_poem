{"id":"ea4d307c85","title":"袁少年诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风波千里阔，","台榭半天高。","此兴将何比，","身知插羽毛。"],"stanzas":[["风波千里阔，","台榭半天高。"],["此兴将何比，","身知插羽毛。"]]}
{"id":"9ab1eb7a61","title":"袁少年诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峰峦多秀色，","松桂足清声。","自有山林趣，","全忘城阙情。"],"stanzas":[["峰峦多秀色，","松桂足清声。"],["自有山林趣，","全忘城阙情。"]]}
{"id":"84bde807e2","title":"袁少年诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["罗浮南海外，","昔日已闻之。","千里来游览，","幽情我自知。"],"stanzas":[["罗浮南海外，","昔日已闻之。"],["千里来游览，","幽情我自知。"]]}
{"id":"4a11414b06","title":"东柯院妖谑杜令 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虽共蒿兰伍，","南朝有宗祖。","莫打绿袍人，","空中且歌舞。"],"stanzas":[["虽共蒿兰伍，","南朝有宗祖。"],["莫打绿袍人，","空中且歌舞。"]]}
{"id":"1345204353","title":"东柯院妖谑杜令 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堪怜木边土，","非儿不似女。","瘦马上高山，","登临何自苦。"],"stanzas":[["堪怜木边土，","非儿不似女。"],["瘦马上高山，","登临何自苦。"]]}
{"id":"aa93b0869f","title":"嵩山小儿吟","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我本长生深山内，","更何入他不二门。","争如访取旧时伴，","休更朝夕劳神魂。"],"stanzas":[["我本长生深山内，","更何入他不二门。"],["争如访取旧时伴，","休更朝夕劳神魂。"]]}
{"id":"97db32a996","title":"鱼腹丹书","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九登龙门山，","三饮太湖水。","毕竟不成龙，","命负张胡子。"],"stanzas":[["九登龙门山，","三饮太湖水。"],["毕竟不成龙，","命负张胡子。"]]}
{"id":"ff674fd3a4","title":"鱼身字","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三度过海，","两度上汉。","行至勒漠，","命属柏君。"],"stanzas":[["三度过海，","两度上汉。"],["行至勒漠，","命属柏君。"]]}
{"id":"df5a8b52ae","title":"马作人语","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芦荻花，","此花开后路无家。"],"stanzas":[["芦荻花，","此花开后路无家。"]]}
{"id":"99cb848217","title":"孙长史女与焦封赠荅诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾失鸳鸯伴，","君方萍梗游。","少年懽醉后，","只恐苦相留。"],"stanzas":[["妾失鸳鸯伴，","君方萍梗游。"],["少年懽醉后，","只恐苦相留。"]]}
{"id":"f69f77f9fe","title":"孙长史女与焦封赠荅诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心常名宦外，","终不耻狂游。","误入桃源里，","仙家争肯留。"],"stanzas":[["心常名宦外，","终不耻狂游。"],["误入桃源里，","仙家争肯留。"]]}
{"id":"fcdccde147","title":"孙长史女与焦封赠荅诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹊桥织女会，","也是不多时。","今日送君处，","羞言连理枝。"],"stanzas":[["鹊桥织女会，","也是不多时。"],["今日送君处，","羞言连理枝。"]]}
{"id":"e5851a6fdf","title":"孙长史女与焦封赠荅诗 四","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但保同心结，","无劳织锦诗。","苏秦求富贵，","自有一回时。"],"stanzas":[["但保同心结，","无劳织锦诗。"],["苏秦求富贵，","自有一回时。"]]}
{"id":"9820e82a35","title":"石瓮寺灯魅诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凉风暮起骊山空，","长生殿鏁霜叶红。","朝来试入华清宫，","分明忆得开元中。"],"stanzas":[["凉风暮起骊山空，","长生殿鏁霜叶红。"],["朝来试入华清宫，","分明忆得开元中。"]]}
{"id":"0fd5ecf70a","title":"石瓮寺灯魅诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金殿不胜秋，","月斜石楼冷。","谁是相顾人，","褰帷吊孤影。"],"stanzas":[["金殿不胜秋，","月斜石楼冷。"],["谁是相顾人，","褰帷吊孤影。"]]}
{"id":"c89c9434fc","title":"石瓮寺灯魅诗 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟灭石楼空，","悠悠永夜中。","虚心怯秋雨，","艳质畏飘风。","向壁残花碎，","侵堦坠叶红。","还如失群鹤，","饮恨在雕笼。"],"stanzas":[["烟灭石楼空，","悠悠永夜中。"],["虚心怯秋雨，","艳质畏飘风。"],["向壁残花碎，","侵堦坠叶红。"],["还如失群鹤，","饮恨在雕笼。"]]}
{"id":"473d1af20d","title":"洛下女郎歌 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皎洁玉颜胜白雪，","况乃当年对风月。","沉吟不敢怨春风，","自叹容华暗消歇。"],"stanzas":[["皎洁玉颜胜白雪，","况乃当年对风月。"],["沉吟不敢怨春风，","自叹容华暗消歇。"]]}
{"id":"f31f9ef398","title":"洛下女郎歌 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绛衣披拂露盈盈，","淡染胭脂一朵轻。","自恨红颜留不住，","莫怨春风道薄情。"],"stanzas":[["绛衣披拂露盈盈，","淡染胭脂一朵轻。"],["自恨红颜留不住，","莫怨春风道薄情。"]]}
{"id":"4c1f9958d5","title":"袁长官女诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["彼见是忘忧，","此看同腐草。","青山与白云，","方展我怀抱。"],"stanzas":[["彼见是忘忧，","此看同腐草。"],["青山与白云，","方展我怀抱。"]]}
{"id":"7ea7ede12e","title":"袁长官女诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["刚被恩情役此心，","无端变化几湮沈。","不知逐伴归山去，","长笑一声烟雾深。"],"stanzas":[["刚被恩情役此心，","无端变化几湮沈。"],["不知逐伴归山去，","长笑一声烟雾深。"]]}
{"id":"2e2194c5f9","title":"真符女与申屠澄赠和诗 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一尉慙梅福，","三年媿孟光。","此情何所喻，","川上有鸳鸯。"],"stanzas":[["一尉慙梅福，","三年媿孟光。"],["此情何所喻，","川上有鸳鸯。"]]}
{"id":"87fd7f7dd8","title":"真符女与申屠澄赠和诗 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琴瑟情虽重，","山林志自深。","常忧时节变，","辜负百年心。"],"stanzas":[["琴瑟情虽重，","山林志自深。"],["常忧时节变，","辜负百年心。"]]}
{"id":"f1adb45b78","title":"夭桃诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["铅华久御向人间，","欲舍铅华更惨颜。","纵有青丘吟夜月，","无因重照旧云鬟。"],"stanzas":[["铅华久御向人间，","欲舍铅华更惨颜。"],["纵有青丘吟夜月，","无因重照旧云鬟。"]]}
{"id":"e933c56874","title":"青衣春条诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽室锁妖艳，","无人兰蕙芳。","春风三十载，","不尽罗衣香。"],"stanzas":[["幽室锁妖艳，","无人兰蕙芳。"],["春风三十载，","不尽罗衣香。"]]}
{"id":"4897ea85bd","title":"明器婢诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独持巾栉掩玄关，","小帐无人烛影残。","昔日罗衣今化尽，","白杨风起陇头寒。"],"stanzas":[["独持巾栉掩玄关，","小帐无人烛影残。"],["昔日罗衣今化尽，","白杨风起陇头寒。"]]}
{"id":"4191f241da","title":"妙香词","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劝君酒莫辞，","花落抛旧枝。","只有北邙山下月，","清光到死也相随。"],"stanzas":[["劝君酒莫辞，","花落抛旧枝。"],["只有北邙山下月，","清光到死也相随。"]]}
{"id":"0e243dd419","title":"庐山女赠朱朴 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但持冰洁心，","不识风霜冷。","任是怀礼容，","无人顾形影。"],"stanzas":[["但持冰洁心，","不识风霜冷。"],["任是怀礼容，","无人顾形影。"]]}
{"id":"6855e56691","title":"庐山女赠朱朴 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["知君久积池塘梦，","遣我方思变动来。","操执若同颜叔子，","今宵宁免泪盈顋。"],"stanzas":[["知君久积池塘梦，","遣我方思变动来。"],["操执若同颜叔子，","今宵宁免泪盈顋。"]]}
{"id":"5a3cf9eeef","title":"青萝帐女赠穆郎","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["团圆今夕色光辉，","结了同心翠带垂。","此后莫教尘点染，","他年长照岁寒姿。"],"stanzas":[["团圆今夕色光辉，","结了同心翠带垂。"],["此后莫教尘点染，","他年长照岁寒姿。"]]}
{"id":"2841c18030","title":"青萝帐女赠穆郎 褰帐","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["揉蓝绿色曲尘开，","静见三星入坐来。","桂影已圆攀折后，","子孙长作栋梁材。"],"stanzas":[["揉蓝绿色曲尘开，","静见三星入坐来。"],["桂影已圆攀折后，","子孙长作栋梁材。"]]}
{"id":"6253498edb","title":"青萝帐女赠穆郎 题碧花牋","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珠露素中书缱绻，","青萝帐里寄鸳鸯。","自怜孤影清秋夕，","洒泪裴回滴冷光。"],"stanzas":[["珠露素中书缱绻，","青萝帐里寄鸳鸯。"],["自怜孤影清秋夕，","洒泪裴回滴冷光。"]]}
{"id":"e2d0645ae7","title":"白苹洲碧衣女子吟","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧水色堪染，","白莲香正浓。","分飞俱有恨，","此别几时逢。","藕隐玲珑玉，","花藏缥缈容。","何当假双翼，","声影暂相从。"],"stanzas":[["碧水色堪染，","白莲香正浓。"],["分飞俱有恨，","此别几时逢。"],["藕隐玲珑玉，","花藏缥缈容。"],["何当假双翼，","声影暂相从。"]]}
{"id":"e7aecb9309","title":"新林驿女吟示欧阳训","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月明阶悄悄，","影只腰身小。","谁是𬸣翔人，","愿为比翼鸟。"],"stanzas":[["月明阶悄悄，","影只腰身小。"],["谁是𬸣翔人，","愿为比翼鸟。"]]}
{"id":"628378b739","title":"新林驿女吟示欧阳训 击盘歌送欧阳训酒","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飞燕身轻未是轻，","枉将弱质在岩扃。","今来不得同鸳枕，","相伴神魂入杳冥。"],"stanzas":[["飞燕身轻未是轻，","枉将弱质在岩扃。"],["今来不得同鸳枕，","相伴神魂入杳冥。"]]}
{"id":"405a7da7f4","title":"白衣女子木叶上诗","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桃花洞口开，","香蘂落莓苔。","佳景虽堪玩，","萧郎殊未来。"],"stanzas":[["桃花洞口开，","香蘂落莓苔。"],["佳景虽堪玩，","萧郎殊未来。"]]}
{"id":"46f4338a5a","title":"白衣女子木叶上诗 席上歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞府深沉春日长，","山花无主自芬芳。","凭阑寂寂看明月，","欲种桃花待阮郎。"],"stanzas":[["洞府深沉春日长，","山花无主自芬芳。"],["凭阑寂寂看明月，","欲种桃花待阮郎。"]]}
{"id":"81fb9ac892","title":"凤皇台怪和歌四首 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深闺闲锁难成梦，","那得同衾共绣床。","一自与郎江上别，","霜天更自觉宵长。"],"stanzas":[["深闺闲锁难成梦，","那得同衾共绣床。"],["一自与郎江上别，","霜天更自觉宵长。"]]}
{"id":"52dd6c5f8a","title":"凤皇台怪和歌四首 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁听黄莺唤友声，","空闺曙色梦初成。","窗间总有花牋纸，","难寄妾心字字明。"],"stanzas":[["愁听黄莺唤友声，","空闺曙色梦初成。"],["窗间总有花牋纸，","难寄妾心字字明。"]]}
{"id":"fa3b5f080e","title":"凤皇台怪和歌四首 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂静璇闺度岁年，","竝头莲叶又如钱。","愁人独处那堪此，","安得君来独枕眠。"],"stanzas":[["寂静璇闺度岁年，","竝头莲叶又如钱。"],["愁人独处那堪此，","安得君来独枕眠。"]]}
{"id":"0ff66ab1c8","title":"凤皇台怪和歌四首 四","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卧病匡床香屡添，","夜深犹有一丝烟。","怀君无计能成梦，","更恨砧声到枕边。"],"stanzas":[["卧病匡床香屡添，","夜深犹有一丝烟。"],["怀君无计能成梦，","更恨砧声到枕边。"]]}
{"id":"f25d20d8c7","title":"梦丹书","author":"肃宗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["厥不云乎，","惟其惟时。","上天所保，","福禄不亏。"],"stanzas":[["厥不云乎，","惟其惟时。"],["上天所保，","福禄不亏。"]]}
{"id":"10cbc00c62","title":"梦黄衣童子歌","author":"代宗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中五之德方峨峨，","胡胡呼呼何奈何。"],"stanzas":[["中五之德方峨峨，","胡胡呼呼何奈何。"]]}
{"id":"4f9766161d","title":"梦扬州乐妓和诗","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花作婵娟玉作妆，","风流争似旧徐娘。","夜深曲曲湾湾月，","万里随君一寸肠。"],"stanzas":[["花作婵娟玉作妆，","风流争似旧徐娘。"],["夜深曲曲湾湾月，","万里随君一寸肠。"]]}
{"id":"3496d8baf9","title":"梦中美人歌","author":"邢凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安少女踏春阳，","何处春阳不断肠？","舞袖弓弯浑忘却，","罗衣空换九秋霜。"],"stanzas":[["长安少女踏春阳，","何处春阳不断肠？","舞袖弓弯浑忘却，","罗衣空换九秋霜。"]]}
{"id":"68b08e414b","title":"梦中诗","author":"石季武","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["耸辔排金阙，","乘轩上汉槎。","浮名何足恋，","高举入烟霞。"],"stanzas":[["耸辔排金阙，","乘轩上汉槎。"],["浮名何足恋，","高举入烟霞。"]]}
{"id":"ae1370b352","title":"葬西施挽歌","author":"王炎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西望吴王国，","云书凤字牌。","连江起珠帐，","择地葬金钗。","满地红心草，","三层碧玉阶。","春风无处所，","凄恨不胜怀。"],"stanzas":[["西望吴王国，","云书凤字牌。"],["连江起珠帐，","择地葬金钗。"],["满地红心草，","三层碧玉阶。"],["春风无处所，","凄恨不胜怀。"]]}
{"id":"d5a54f7114","title":"秦梦诗三首 一","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泣葬一枝红，","生同死不同。","金钿坠芳草，","香绣满春风。","旧日闻箫处，","高楼当月中。","梨花寒食夜，","深闭翠微宫。"],"stanzas":[["泣葬一枝红，","生同死不同。"],["金钿坠芳草，","香绣满春风。"],["旧日闻箫处，","高楼当月中。"],["梨花寒食夜，","深闭翠微宫。"]]}
{"id":"ab77606627","title":"秦梦诗三首 二","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["击髆舞，","恨满烟光无处所。","泪如雨，","欲拟著辞不成语。","金凤衔红旧绣衣，","几度宫中同看舞。","人间春日正欢乐，","日暮东风何处去。"],"stanzas":[["击髆舞，","恨满烟光无处所。"],["泪如雨，","欲拟著辞不成语。"],["金凤衔红旧绣衣，","几度宫中同看舞。"],["人间春日正欢乐，","日暮东风何处去。"]]}
{"id":"38a3a978a8","title":"秦梦诗三首 三","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君王多感放东归，","从此秦宫不复期。","春景似伤秦丧主，","落花如雨泪燕脂。"],"stanzas":[["君王多感放东归，","从此秦宫不复期。"],["春景似伤秦丧主，","落花如雨泪燕脂。"]]}
{"id":"7b1b1d0004","title":"梦中诗","author":"卢献卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卜筑郊原古，","青山无四邻。","扶疎绕屋树，","寂寞独归人。"],"stanzas":[["卜筑郊原古，","青山无四邻。"],["扶疎绕屋树，","寂寞独归人。"]]}
{"id":"0aa8175eac","title":"梦为吴泰伯作胜儿歌","author":"刘景复","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["繁弦已停杂吹歇，","胜儿调弄逻娑拨。","四弦拢撚三五声，","唤起边风驻明月。","大声嘈嘈奔淈淈，","浪蹙波翻倒溟渤。","小弦切切怨飔飔，","鬼哭神悲秋窸窣。","倒腕斜挑挚流电，","春雷直戛腾秋鹘。","汉妃徒得端正名，","秦女虚夸有仙骨。","我闻天宝十年前，","凉州未作西戎窟。","麻衣右衽皆汉民，","不省胡尘暂蓬勃。","太平之末狂胡乱，","犬豕崩腾恣唐突。","玄宗未到万里桥，","东洛西京一时没。","汉土民皆没为虏，","饮恨吞声空嗢咽。","时看汉月望汉天，","怨气冲星成彗孛。","国门之西八九镇，","高城深垒闭闲卒。","河湟咫尺不能收，","挽粟推车徒兀兀。","今朝闻奏凉州曲，","使我心神暗超忽。","胜儿若向边塞弹，","征人泪血应阑干。"],"stanzas":[["繁弦已停杂吹歇，","胜儿调弄逻娑拨。"],["四弦拢撚三五声，","唤起边风驻明月。"],["大声嘈嘈奔淈淈，","浪蹙波翻倒溟渤。"],["小弦切切怨飔飔，","鬼哭神悲秋窸窣。"],["倒腕斜挑挚流电，","春雷直戛腾秋鹘。"],["汉妃徒得端正名，","秦女虚夸有仙骨。"],["我闻天宝十年前，","凉州未作西戎窟。"],["麻衣右衽皆汉民，","不省胡尘暂蓬勃。"],["太平之末狂胡乱，","犬豕崩腾恣唐突。"],["玄宗未到万里桥，","东洛西京一时没。"],["汉土民皆没为虏，","饮恨吞声空嗢咽。"],["时看汉月望汉天，","怨气冲星成彗孛。"],["国门之西八九镇，","高城深垒闭闲卒。"],["河湟咫尺不能收，","挽粟推车徒兀兀。"],["今朝闻奏凉州曲，","使我心神暗超忽。"],["胜儿若向边塞弹，","征人泪血应阑干。"]]}
{"id":"3c9e83e488","title":"梦中辞","author":"郭仁表","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飘风暴雨可思惟，","鹤望巢门歛翅飞，","吾道之宗正可依。"],"stanzas":[["飘风暴雨可思惟，","鹤望巢门歛翅飞，","吾道之宗正可依。"]]}
{"id":"26dafc48cf","title":"梦崔嘏妻诗","author":"国邵南","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫以真留妾，","从他理管弦。","容华难久驻，","知得几多年。"],"stanzas":[["莫以真留妾，","从他理管弦。"],["容华难久驻，","知得几多年。"]]}
{"id":"905171df17","title":"梦白衣妇人歌词 一","author":"卢绛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉京人去秋箫索，","画簷鹊起梧桐落。","欹枕悄无言，","月和残梦圆。","背灯惟暗泣，","甚处碪声急。","眉黛小山攒，","芭蕉生暮寒。"],"stanzas":[["玉京人去秋箫索，","画簷鹊起梧桐落。"],["欹枕悄无言，","月和残梦圆。"],["背灯惟暗泣，","甚处碪声急。"],["眉黛小山攒，","芭蕉生暮寒。"]]}
{"id":"150cd650ab","title":"梦白衣妇人歌词 二","author":"卢绛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清风明月夜深时，","箕箒卢郎恨已迟。","他日孟家坡上约，","再来相见是佳期。"],"stanzas":[["清风明月夜深时，","箕箒卢郎恨已迟。"],["他日孟家坡上约，","再来相见是佳期。"]]}
{"id":"e21ca254d6","title":"梦舜抚琴歌","author":"张生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南风薰薰兮草芊芊，","妙有之音兮归清弦。","荡荡之教兮由自然，","熈熈之化兮吾道全，","薰薰兮思何传。"],"stanzas":[["南风薰薰兮草芊芊，","妙有之音兮归清弦。"],["荡荡之教兮由自然，","熈熈之化兮吾道全，","薰薰兮思何传。"]]}
{"id":"cda13d900c","title":"梦康仙示诗","author":"漳郡守","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卖药因循未得还，","却因耽酒到人间。","有心只恋琵琶坂，","无意更登山上山。"],"stanzas":[["卖药因循未得还，","却因耽酒到人间。"],["有心只恋琵琶坂，","无意更登山上山。"]]}
{"id":"1f1f1b8862","title":"梦中歌","author":"独孤遐叔妻白氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今夕何夕，","存耶没耶。","良人去兮天之涯，","园树伤心兮三见花。"],"stanzas":[["今夕何夕，","存耶没耶。"],["良人去兮天之涯，","园树伤心兮三见花。"]]}
{"id":"348b267202","title":"梦中歌 一","author":"张生妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叹衰草，","络纬声切切。","良人一去不复还，","今夕坐愁鬓如雪。"],"stanzas":[["叹衰草，","络纬声切切。"],["良人一去不复还，","今夕坐愁鬓如雪。"]]}
{"id":"2b49df18ad","title":"梦中歌 二","author":"张生妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劝君酒，","君莫辞。","落花徒绕枝，","流水无返期。"],"stanzas":[["劝君酒，","君莫辞。"],["落花徒绕枝，","流水无返期。"]]}
{"id":"28296e84e2","title":"梦中歌 三","author":"张生妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["怨空闺，","秋日亦难暮。","夫壻断音书，","遥天鴈空度。"],"stanzas":[["怨空闺，","秋日亦难暮。"],["夫壻断音书，","遥天鴈空度。"]]}
{"id":"26a0c541b9","title":"梦中歌 四","author":"张生妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["切切夕风急，","露滋庭草湿。","良人去不回，","焉知掩闺泣。"],"stanzas":[["切切夕风急，","露滋庭草湿。"],["良人去不回，","焉知掩闺泣。"]]}
{"id":"7a6f978a76","title":"梦中歌 五","author":"张生妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["萤火穿白杨，","悲风入荒草。","疑是梦中游，","愁迷故园道。"],"stanzas":[["萤火穿白杨，","悲风入荒草。"],["疑是梦中游，","愁迷故园道。"]]}
{"id":"496a8407a2","title":"梦中歌 六","author":"张生妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花前始相见，","花下又相送。","何必言梦中，","人生尽如梦。"],"stanzas":[["花前始相见，","花下又相送。"],["何必言梦中，","人生尽如梦。"]]}
{"id":"1d79afa216","title":"梦王尚书口授吟","author":"张氏女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鬟梳闹扫学宫妆，","独立闲庭纳夜凉。","手把玉簪敲砌竹，","清歌一曲月如霜。"],"stanzas":[["鬟梳闹扫学宫妆，","独立闲庭纳夜凉。"],["手把玉簪敲砌竹，","清歌一曲月如霜。"]]}
{"id":"824bb4674d","title":"歌 一","author":"病狂人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["踏阳春，","人间三月雨和尘。","阳春踏，","秋风起，","肠断人间白发人。"],"stanzas":[["踏阳春，","人间三月雨和尘。"],["阳春踏，","秋风起，","肠断人间白发人。"]]}
{"id":"017495bb33","title":"歌 二","author":"病狂人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五灵华，","晓玲珑，","天府由来汝府中。","惆怅此情言不尽，","一丸萝卜火吾宫。"],"stanzas":[["五灵华，","晓玲珑，","天府由来汝府中。"],["惆怅此情言不尽，","一丸萝卜火吾宫。"]]}
{"id":"cd82dc1613","title":"题禅窟兰若","author":"陈季卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霜钟鸣时夕风急，","乱鸦又望寒林集。","此时辍櫂悲且吟，","独向莲华一峰立。"],"stanzas":[["霜钟鸣时夕风急，","乱鸦又望寒林集。"],["此时辍櫂悲且吟，","独向莲华一峰立。"]]}
{"id":"d69e5a7605","title":"题潼关普通院门","author":"陈季卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["度关悲失志，","万绪乱心机。","下坂马无力，","扫门尘满衣。","计谋多不就，","心口自相违。","已作羞归计，","还胜羞不归。"],"stanzas":[["度关悲失志，","万绪乱心机。"],["下坂马无力，","扫门尘满衣。"],["计谋多不就，","心口自相违。"],["已作羞归计，","还胜羞不归。"]]}
{"id":"97f6f91644","title":"江亭晚望题书斋","author":"陈季卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["立向江亭满目愁，","十年前事信悠悠。","田园已逐浮云散，","乡里半随逝水流。","川上莫逢诸钓叟，","浦边难得旧沙鸥。","不缘齿发未迟暮，","吟对远山堪白头。"],"stanzas":[["立向江亭满目愁，","十年前事信悠悠。"],["田园已逐浮云散，","乡里半随逝水流。"],["川上莫逢诸钓叟，","浦边难得旧沙鸥。"],["不缘齿发未迟暮，","吟对远山堪白头。"]]}
{"id":"6e66968481","title":"别妻","author":"陈季卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月斜寒露白，","此夕去留心。","酒至添愁饮，","诗成和泪吟。","离歌凄凤管，","别鹤怨瑶琴。","明夜相思处，","秋风吹半衾。"],"stanzas":[["月斜寒露白，","此夕去留心。"],["酒至添愁饮，","诗成和泪吟。"],["离歌凄凤管，","别鹤怨瑶琴。"],["明夜相思处，","秋风吹半衾。"]]}
{"id":"8c0870548a","title":"别兄弟","author":"陈季卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谋身非不早，","其奈命来迟。","旧友皆霄汉，","此身犹路岐。","北风微雪后，","晚景有云时。","惆怅清江上，","区区趁试期。"],"stanzas":[["谋身非不早，","其奈命来迟。"],["旧友皆霄汉，","此身犹路岐。"],["北风微雪后，","晚景有云时。"],["惆怅清江上，","区区趁试期。"]]}
{"id":"2f6ab7a291","title":"梦中句","author":"周延翰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫髯之伴有丹砂。"],"stanzas":[["紫髯之伴有丹砂。"]]}
{"id":"385cc4df33","title":"梦中和句","author":"任玠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故国路遥归去来，","春风天远望不尽。"],"stanzas":[["故国路遥归去来，","春风天远望不尽。"]]}
{"id":"ce1aaaa15a","title":"梦中语","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["辞春不及秋，","昆脚与皆头。"],"stanzas":[["辞春不及秋，","昆脚与皆头。"]]}
{"id":"f4b28498a1","title":"梦中诗","author":"胥偃","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔作树头花，","今为冢中骨。"],"stanzas":[["昔作树头花，","今为冢中骨。"]]}
{"id":"18921ed36f","title":"梦中语","author":"曾崇范妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["田头有鹿迹，","由尾著日炙。"],"stanzas":[["田头有鹿迹，","由尾著日炙。"]]}
{"id":"610fc4d8dd","title":"纪梦句","author":"张孜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上天知我忆其人，","使向人间梦中见。"],"stanzas":[["上天知我忆其人，","使向人间梦中见。"]]}
{"id":"bbcd7f49c8","title":"嘲苏世长","author":"高祖","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名长意短，","口正心邪。","弃忠贞于郑国，","忘信义于吾家。"],"stanzas":[["名长意短，","口正心邪。"],["弃忠贞于郑国，","忘信义于吾家。"]]}
{"id":"6bcbf0268e","title":"戏题画","author":"睿宗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["唤出眼，","何用苦深藏。","缩却鼻，","何畏不闻香。"],"stanzas":[["唤出眼，","何用苦深藏。"],["缩却鼻，","何畏不闻香。"]]}
{"id":"e3149ec7f7","title":"嘲萧瑀射","author":"欧阳询","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["急风吹缓箭，","弱手驭强弓。","欲高飜复下，","应西还更东。","十回俱著地，","两手并擎空。","借问谁为此，","乃应是宋公。"],"stanzas":[["急风吹缓箭，","弱手驭强弓。"],["欲高飜复下，","应西还更东。"],["十回俱著地，","两手并擎空。"],["借问谁为此，","乃应是宋公。"]]}
{"id":"8c22d33ae0","title":"与欧阳询互嘲 一","author":"长孙无忌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["耸膊成山字，","埋肩不出头。","谁家麟角上，","画此一猕猴。"],"stanzas":[["耸膊成山字，","埋肩不出头。"],["谁家麟角上，","画此一猕猴。"]]}
{"id":"def85bb7dd","title":"与欧阳询互嘲 二","author":"长孙无忌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["索头连背暖，","漫裆畏肚寒。","只因心浑浑，","所以面团团。"],"stanzas":[["索头连背暖，","漫裆畏肚寒。"],["只因心浑浑，","所以面团团。"]]}
{"id":"7e892de3d3","title":"为温仆射嘲竹","author":"裴略","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹，","风吹青肃肃，","凌冬叶不凋，","经春子不熟。","虚心未得待国士，","皮上何湏生节目。"],"stanzas":[["竹，","风吹青肃肃，","凌冬叶不凋，","经春子不熟。"],["虚心未得待国士，","皮上何湏生节目。"]]}
{"id":"ac38f5f828","title":"又嘲屏墙","author":"裴略","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高下八九尺，","东西六七步。","突兀当厅坐，","几许遮贤路。"],"stanzas":[["高下八九尺，","东西六七步。"],["突兀当厅坐，","几许遮贤路。"]]}
{"id":"1499cb5366","title":"嘲崔左丞","author":"省吏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["崔子曲如钩，","随例得封侯。","髆上全无项，","胸前别有头。"],"stanzas":[["崔子曲如钩，","随例得封侯。"],["髆上全无项，","胸前别有头。"]]}
{"id":"a14183d945","title":"嘲高士廉木履","author":"选人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["刺鼻何曾嚏，","蹋面不知嗔。","高生两个齿，","自谓得胜人。"],"stanzas":[["刺鼻何曾嚏，","蹋面不知嗔。"],["高生两个齿，","自谓得胜人。"]]}
{"id":"57314b03a4","title":"书化度藏院壁","author":"裴玄智","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["将肉遣狼守，","置骨向狗头。","自非阿罗汉，","焉能免得偷。"],"stanzas":[["将肉遣狼守，","置骨向狗头。"],["自非阿罗汉，","焉能免得偷。"]]}
{"id":"093bccc176","title":"嘲许子儒","author":"窦昉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不能专习礼，","虚心强觅阶。","一年辞爵弁，","半岁履麻鞋。","瓦恶频蒙𢸗，","墙虚屡被扠。","映树便侧睡，","过匮即放乖。","岁暮良工毕，","言是越朋侪。","今日纶言降，","方知愚计㖞。"],"stanzas":[["不能专习礼，","虚心强觅阶。"],["一年辞爵弁，","半岁履麻鞋。"],["瓦恶频蒙𢸗，","墙虚屡被扠。"],["映树便侧睡，","过匮即放乖。"],["岁暮良工毕，","言是越朋侪。"],["今日纶言降，","方知愚计㖞。"]]}
{"id":"98f600f679","title":"与赵神德互嘲","author":"梁宝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赵神德，","天上既无云，","闪电何以无准则。","向者入门来，","案后惟见一挺墨。","官里料朱砂，","半眼供一国。","磨公小拇指，","涂得太社北。"],"stanzas":[["赵神德，","天上既无云，","闪电何以无准则。"],["向者入门来，","案后惟见一挺墨。"],["官里料朱砂，","半眼供一国。"],["磨公小拇指，","涂得太社北。"]]}
{"id":"0b66bc276d","title":"与讲师互谑","author":"释元康","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["甘桃不结实，","苦李压低枝。","轮王千个子，","巷伯勿孙儿。"],"stanzas":[["甘桃不结实，","苦李压低枝。"],["轮王千个子，","巷伯勿孙儿。"]]}
{"id":"f72b3ffc2f","title":"咏兴善寺佛殿灾","author":"李荣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道善何曾善，","言兴且不兴。","如来烧赤尽，","惟有一群僧。"],"stanzas":[["道善何曾善，","言兴且不兴。"],["如来烧赤尽，","惟有一群僧。"]]}
{"id":"bb3118ecc2","title":"叙可笑事","author":"张元一","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱前疑著绿，","逯仁杰著朱。","阎知微骑马，","马吉甫骑驴。","将名作姓李千里，","将姓作名吴栖梧。","左台胡御史，","右台御史胡。"],"stanzas":[["朱前疑著绿，","逯仁杰著朱。"],["阎知微骑马，","马吉甫骑驴。"],["将名作姓李千里，","将姓作名吴栖梧。"],["左台胡御史，","右台御史胡。"]]}
{"id":"9d447de6f6","title":"嘲武懿宗","author":"张元一","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长弓短度箭，","蜀马临阶騗。","去贼七百里，","隈墙独自战。","忽然逢著贼，","骑猪向南𧾩。"],"stanzas":[["长弓短度箭，","蜀马临阶騗。"],["去贼七百里，","隈墙独自战。"],["忽然逢著贼，","骑猪向南𧾩。"]]}
{"id":"80ee4e3db8","title":"又嘲武懿宗","author":"张元一","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["裹头极草草，","掠鬓不菶菶。","未见桃花面皮，","漫作杏子眼孔。"],"stanzas":[["裹头极草草，","掠鬓不菶菶。"],["未见桃花面皮，","漫作杏子眼孔。"]]}
{"id":"9b2d87cde5","title":"咏静乐县主","author":"张元一","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["马带桃花锦，","帬衔绿草罗。","定知帏帽底，","仪容似大哥。"],"stanzas":[["马带桃花锦，","帬衔绿草罗。"],["定知帏帽底，","仪容似大哥。"]]}
{"id":"a9bd19d85c","title":"嘲格辅元","author":"杜易简","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有耻宿龙门，","精彩先瞰浑。","眼瘦呈近店，","睡响彻遥林。","埒囊将旧识，","制被异新婚。","谁言骢马使，","飜作蛰熊蹲。"],"stanzas":[["有耻宿龙门，","精彩先瞰浑。"],["眼瘦呈近店，","睡响彻遥林。"],["埒囊将旧识，","制被异新婚。"],["谁言骢马使，","飜作蛰熊蹲。"]]}
{"id":"35d7d9a2ad","title":"始平谐诗","author":"石抱忠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平明发始平，","薄暮至何城。","库墖朝云上，","晃池夜月明。","略彴桥头逢长史，","櫺星门外揖司兵。","一群县尉驴骡骤，","数个参军鹅鸭行。"],"stanzas":[["平明发始平，","薄暮至何城。"],["库墖朝云上，","晃池夜月明。"],["略彴桥头逢长史，","櫺星门外揖司兵。"],["一群县尉驴骡骤，","数个参军鹅鸭行。"]]}
{"id":"60fb10d963","title":"咏傅岩监祠","author":"梁载言","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻道监中霤，","初言是大祠。","很傍索传马，","𬾠动出安徽。","卫司无帟幕，","供膳乏鲜肥。","形容消瘦尽，","空往复空归。"],"stanzas":[["闻道监中霤，","初言是大祠。"],["很傍索传马，","𬾠动出安徽。"],["卫司无帟幕，","供膳乏鲜肥。"],["形容消瘦尽，","空往复空归。"]]}
{"id":"3a455387d5","title":"嘲崔生","author":"刘行敏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["崔生犯夜行，","武候正严更。","幞头拳下落，","高髻掌中擎。","杖迹胸前出，","绳文腕后生。","愁人不惜夜，","随意晓参横。"],"stanzas":[["崔生犯夜行，","武候正严更。"],["幞头拳下落，","高髻掌中擎。"],["杖迹胸前出，","绳文腕后生。"],["愁人不惜夜，","随意晓参横。"]]}
{"id":"576325ed40","title":"又嘲杨文瓘","author":"刘行敏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武陵敬爱客，","终宴不知疲。","遣共浑王饮，","错宴延陀儿。","始被鸿胪识，","终蒙御史知。","精神既如此，","长叹复何为。"],"stanzas":[["武陵敬爱客，","终宴不知疲。"],["遣共浑王饮，","错宴延陀儿。"],["始被鸿胪识，","终蒙御史知。"],["精神既如此，","长叹复何为。"]]}
{"id":"61f860a7f7","title":"嘲李叔慎贺兰僧伽杜善贤","author":"刘行敏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叔慎骑乌马，","僧伽把漆弓。","唤取长安令，","共猎北山熊。"],"stanzas":[["叔慎骑乌马，","僧伽把漆弓。"],["唤取长安令，","共猎北山熊。"]]}
{"id":"271f357afc","title":"嘲父","author":"陆子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陆余庆，","笔头无力觜头硬。","一朝受辞讼，","十日判不竟。"],"stanzas":[["陆余庆，","笔头无力觜头硬。"],["一朝受辞讼，","十日判不竟。"]]}
{"id":"1f3f1449d0","title":"回波词","author":"杨廷玉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回波尔时廷玉，","打獠取钱未足。","阿姑婆见作天子，","傍人不得枨触。"],"stanzas":[["回波尔时廷玉，","打獠取钱未足。"],["阿姑婆见作天子，","傍人不得枨触。"]]}
{"id":"389bc069df","title":"回波词","author":"中宗朝优人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回波尔时栲栳，","怕妇也是大好。","外边祗有裴谈，","内里无过李老。"],"stanzas":[["回波尔时栲栳，","怕妇也是大好。"],["外边祗有裴谈，","内里无过李老。"]]}
{"id":"e1001c49ff","title":"乞金鱼词","author":"崔日用","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["台中鼠子直须谙，","信足跳梁上壁龛。","倚飜灯脂汚张五，","还来啮带报韩三。","莫浪语，","直王相，","大家必若赐金龟，","卖却猫儿相报赏。"],"stanzas":[["台中鼠子直须谙，","信足跳梁上壁龛。"],["倚飜灯脂汚张五，","还来啮带报韩三。"],["莫浪语，","直王相，","大家必若赐金龟，","卖却猫儿相报赏。"]]}
{"id":"a2e4427d4b","title":"又赐宴自歌","author":"崔日用","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东馆总是鹓鸾，","南台自多杞梓。","日用读书万卷，","何忍不蒙学士。","墨制帘下出来，","微臣眼看喜死。"],"stanzas":[["东馆总是鹓鸾，","南台自多杞梓。"],["日用读书万卷，","何忍不蒙学士。"],["墨制帘下出来，","微臣眼看喜死。"]]}
{"id":"0a4e4f45bf","title":"咏痴","author":"吴人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["榆儿复榆妇，","造屋兼造车。","十七八九夜，","还书复借书。"],"stanzas":[["榆儿复榆妇，","造屋兼造车。"],["十七八九夜，","还书复借书。"]]}
{"id":"923f3452ad","title":"歇后","author":"封抱一","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["面作天地玄，","鼻有雁门紫。","既无左达承，","何劳罔谈彼。"],"stanzas":[["面作天地玄，","鼻有雁门紫。"],["既无左达承，","何劳罔谈彼。"]]}
{"id":"5d8eb2e4c3","title":"送司功入京","author":"曲崇裕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["崇裕有幸会，","得遇明流行。","司士向京去，","旷野哭声哀。"],"stanzas":[["崇裕有幸会，","得遇明流行。"],["司士向京去，","旷野哭声哀。"]]}
{"id":"c897841508","title":"岭南归后献诗","author":"权龙褒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙褒有何罪，","天恩放岭南。","敕知无罪过，","追来与将军。"],"stanzas":[["龙褒有何罪，","天恩放岭南。"],["敕知无罪过，","追来与将军。"]]}
{"id":"29406a570f","title":"初到沧州呈州官","author":"权龙褒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["遥看沧海城，","杨柳郁青青。","中央一群汉，","聚坐打杯觥。"],"stanzas":[["遥看沧海城，","杨柳郁青青。"],["中央一群汉，","聚坐打杯觥。"]]}
{"id":"f8b27822c9","title":"秋日述怀","author":"权龙褒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["檐前飞七百，","雪白后园彊。","饱食房里侧，","家粪集野蜋。"],"stanzas":[["檐前飞七百，","雪白后园彊。"],["饱食房里侧，","家粪集野蜋。"]]}
{"id":"50ed4eda66","title":"喜雨","author":"权龙褒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暗去也没雨，","明来也没云。","日头赫赤出，","地上绿氤氲。"],"stanzas":[["暗去也没雨，","明来也没云。"],["日头赫赤出，","地上绿氤氲。"]]}
{"id":"360d44de53","title":"皇太子夏日赐宴诗","author":"权龙褒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["严霜白浩浩，","明月赤团团。"],"stanzas":[["严霜白浩浩，","明月赤团团。"]]}
{"id":"bbb5d99d63","title":"哭李峤诗","author":"崔泰之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["台阁神仙地，","衣冠君子乡。","昨朝犹对坐，","今日忽云亡。","魂随司命鬼，","魄逐见阎王。","此时罢欢笑，","无复向朝堂。"],"stanzas":[["台阁神仙地，","衣冠君子乡。"],["昨朝犹对坐，","今日忽云亡。"],["魂随司命鬼，","魄逐见阎王。"],["此时罢欢笑，","无复向朝堂。"]]}
{"id":"001042268d","title":"咏尹字","author":"苏颋","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丑虽有足，","甲不全身。","见君无口，","知伊少人。"],"stanzas":[["丑虽有足，","甲不全身。"],["见君无口，","知伊少人。"]]}
{"id":"3935d0f866","title":"咏王主敬","author":"张敬忠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有意嫌兵部，","专心望考功。","谁知脚踜蹬，","却落省墙东。"],"stanzas":[["有意嫌兵部，","专心望考功。"],["谁知脚踜蹬，","却落省墙东。"]]}
{"id":"1f1d038349","title":"嘲邵景萧嵩","author":"韦铿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一双胡子著绯袍，","一个须多一鼻高。","相对厅前捺且立，","自慙身品世间毛。"],"stanzas":[["一双胡子著绯袍，","一个须多一鼻高。"],["相对厅前捺且立，","自慙身品世间毛。"]]}
{"id":"bd330073ba","title":"嘲韦铿","author":"邵景","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飘风忽起团团旋，","倒地还如著脚䭔。","莫怪殿上空行事，","却为元非五品才。"],"stanzas":[["飘风忽起团团旋，","倒地还如著脚䭔。"],["莫怪殿上空行事，","却为元非五品才。"]]}
{"id":"066dbfeef7","title":"咏毁天枢","author":"李休烈","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天门街上倒天枢，","火急先须卸火珠。","计合一条麻线挽，","何劳两县索人夫。"],"stanzas":[["天门街上倒天枢，","火急先须卸火珠。"],["计合一条麻线挽，","何劳两县索人夫。"]]}
{"id":"76e4fb6f61","title":"与李全交诗","author":"石惠泰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御史非常任，","参军不久居。","待君迁转后，","此职还到余。"],"stanzas":[["御史非常任，","参军不久居。"],["待君迁转后，","此职还到余。"]]}
{"id":"1adf74e880","title":"嘲刘文树","author":"黄幡绰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可怜好个刘文树，","髭须共颏颐别住。","文树面孔不似猢狲，","猢狲面孔强似文树。"],"stanzas":[["可怜好个刘文树，","髭须共颏颐别住。"],["文树面孔不似猢狲，","猢狲面孔强似文树。"]]}
{"id":"7bb009a39a","title":"尚书省门吟","author":"祖咏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落去他，","两两三三戴帽子。","日暮祖侯吟一声，","长安竹柏皆枯死。"],"stanzas":[["落去他，","两两三三戴帽子。"],["日暮祖侯吟一声，","长安竹柏皆枯死。"]]}
{"id":"0c347fb650","title":"上马当山神","author":"王昌龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青骢一匹昆仑牵，","奏上大王不取钱。","直为猛风波滚骤，","莫怪昌龄不下船。"],"stanzas":[["青骢一匹昆仑牵，","奏上大王不取钱。"],["直为猛风波滚骤，","莫怪昌龄不下船。"]]}
{"id":"f0e1e379d9","title":"窃李义府诗","author":"张怀庆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["生情镂月为歌扇，","出性裁云作舞衣。","照镜自怜回雪影，","来时好取洛川归。"],"stanzas":[["生情镂月为歌扇，","出性裁云作舞衣。"],["照镜自怜回雪影，","来时好取洛川归。"]]}
{"id":"6389ad92f2","title":"荅朝士","author":"贺知章","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钑镂银盘盛蛤蜊，","镜湖莼菜乱如丝。","乡曲近来佳此味，","遮渠不道是吴儿。"],"stanzas":[["钑镂银盘盛蛤蜊，","镜湖莼菜乱如丝。"],["乡曲近来佳此味，","遮渠不道是吴儿。"]]}
{"id":"34b6ca0114","title":"和知章诗","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钑镂银盘盛炒鰕，","镜湖莼菜乱如麻。","汉儿女嫁吴儿妇，","吴儿尽是汉儿爷。"],"stanzas":[["钑镂银盘盛炒鰕，","镜湖莼菜乱如麻。"],["汉儿女嫁吴儿妇，","吴儿尽是汉儿爷。"]]}
{"id":"ae253f4f3a","title":"续茅山秀才吟","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["驻马上山阿，","风来屎气多。"],"stanzas":[["驻马上山阿，","风来屎气多。"]]}
{"id":"06729cf25b","title":"樱桃子诗","author":"史思明","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["樱桃子，","半赤半已黄。","一半与怀王，","一半与周至。"],"stanzas":[["樱桃子，","半赤半已黄。"],["一半与怀王，","一半与周至。"]]}
{"id":"892a4b4862","title":"讥元载诗","author":"高亭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上元官吏务剥削，","江淮之人皆白著。"],"stanzas":[["上元官吏务剥削，","江淮之人皆白著。"]]}
{"id":"df421f9a59","title":"嘲赵谦光","author":"贺遂涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["员外由来美，","郎中望亦优。","宁知粉署里，","飜作土山头。"],"stanzas":[["员外由来美，","郎中望亦优。"],["宁知粉署里，","飜作土山头。"]]}
{"id":"3020973ef3","title":"荅贺遂涉","author":"赵谦光","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦帐随情设，","金炉任意熏。","唯愁员外置，","不应列星文。"],"stanzas":[["锦帐随情设，","金炉任意熏。"],["唯愁员外置，","不应列星文。"]]}
{"id":"1d4ae387e8","title":"上浙东孟尚书","author":"孔颙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有个将军不得名，","唯教健卒喝书生。","尚书近日清如镜，","天子官街不许行。"],"stanzas":[["有个将军不得名，","唯教健卒喝书生。"],["尚书近日清如镜，","天子官街不许行。"]]}
{"id":"43e91a8563","title":"嘲柳州柳子厚","author":"吕温","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳州柳刺史，","种柳柳江边。","柳管依然在，","千秋柳拂天。"],"stanzas":[["柳州柳刺史，","种柳柳江边。"],["柳管依然在，","千秋柳拂天。"]]}
{"id":"c80bb35a8d","title":"嘲黔南观察南卓","author":"吕温","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["终南南太守，","南郡在云南。","闲向南亭醉，","南风变俗谈。"],"stanzas":[["终南南太守，","南郡在云南。"],["闲向南亭醉，","南风变俗谈。"]]}
{"id":"08856cdbc8","title":"戏简朱坛诗","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔人有玉盌，","击之千里鸣。","今日覩斯文，","盌有当时声。"],"stanzas":[["昔人有玉盌，","击之千里鸣。"],["今日覩斯文，","盌有当时声。"]]}
{"id":"1cc0b81d24","title":"戏颜郎官骑猎诗","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忽闻射猎出军城，","人著戎衣马带缨。","倒把角弓呈一箭，","满山狐兔当头行。"],"stanzas":[["忽闻射猎出军城，","人著戎衣马带缨。"],["倒把角弓呈一箭，","满山狐兔当头行。"]]}
{"id":"3d15152b1d","title":"嘲张祜","author":"朱冲和","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白在东都元已薨，","兰台凤阁少人登。","冬瓜堰下逢张祜，","牛屎堆旁说我能。"],"stanzas":[["白在东都元已薨，","兰台凤阁少人登。"],["冬瓜堰下逢张祜，","牛屎堆旁说我能。"]]}
{"id":"aa75c89d7b","title":"嘲妓 一","author":"崔涯","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虽得苏方木，","犹贪玳瑁皮。","怀胎十个月，","生下昆仑儿。"],"stanzas":[["虽得苏方木，","犹贪玳瑁皮。"],["怀胎十个月，","生下昆仑儿。"]]}
{"id":"56916e9a46","title":"嘲妓 二","author":"崔涯","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["布袍披袄火烧毡，","纸补箜篌麻接弦。","更著一双皮屐子，","纥梯纥榻出门前。"],"stanzas":[["布袍披袄火烧毡，","纸补箜篌麻接弦。"],["更著一双皮屐子，","纥梯纥榻出门前。"]]}
{"id":"681a002ca7","title":"嘲李端端 一","author":"崔涯","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄昏不语不知行，","鼻似烟窗耳似铛。","独把象牙梳插鬓，","昆仑山上月初明。"],"stanzas":[["黄昏不语不知行，","鼻似烟窗耳似铛。"],["独把象牙梳插鬓，","昆仑山上月初明。"]]}
{"id":"ffe976d612","title":"嘲李端端 二","author":"崔涯","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["觅得黄骝鞁绣鞍，","善和坊里取端端。","扬州近日浑成差，","一朵能行白牡丹。"],"stanzas":[["觅得黄骝鞁绣鞍，","善和坊里取端端。"],["扬州近日浑成差，","一朵能行白牡丹。"]]}
{"id":"23aaaefcd1","title":"咏崔云娘","author":"李宣古","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何事最堪悲，","云娘只首奇。","瘦拳抛令急，","长啸出歌迟。","只见肩侵鬓，","唯忧骨透皮。","不须当户立，","头上有锺馗。"],"stanzas":[["何事最堪悲，","云娘只首奇。"],["瘦拳抛令急，","长啸出歌迟。"],["只见肩侵鬓，","唯忧骨透皮。"],["不须当户立，","头上有锺馗。"]]}
{"id":"fbc325b508","title":"嘲妓","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盘古当时有远孙，","尚令今日逞家门。","一车白土将泥项，","十幅红旗补破裩。","瓦官寺里逢行迹，","华岳山前见掌痕。","不须惆怅忧难嫁，","待与将书问乐坤。"],"stanzas":[["盘古当时有远孙，","尚令今日逞家门。"],["一车白土将泥项，","十幅红旗补破裩。"],["瓦官寺里逢行迹，","华岳山前见掌痕。"],["不须惆怅忧难嫁，","待与将书问乐坤。"]]}
{"id":"ade20ecf49","title":"嘲游使君","author":"卢肇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白帝城头二月时，","忍教清醒看花枝。","莫言世上无袁许，","客子由来是相师。"],"stanzas":[["白帝城头二月时，","忍教清醒看花枝。"],["莫言世上无袁许，","客子由来是相师。"]]}
{"id":"72ba37a163","title":"嘲李玚题名","author":"韦蟾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渭水秦山照眼明，","希仁何事寡诗情。","只因学得虞姬壻，","书字才能记姓名。"],"stanzas":[["渭水秦山照眼明，","希仁何事寡诗情。"],["只因学得虞姬壻，","书字才能记姓名。"]]}
{"id":"17ab295ece","title":"闻鹿鸣互谑","author":"严震","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["釜戴山中鹿又鸣，","此际多应到表兄。","表兄不是严家子，","合是三兄与四兄。"],"stanzas":[["釜戴山中鹿又鸣，","此际多应到表兄。"],["表兄不是严家子，","合是三兄与四兄。"]]}
{"id":"cd4135e72b","title":"及第后寄李绅","author":"章孝标","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["及第全胜十政官，","金鞍镀了出长安。","马头渐入扬州郭，","为报时人洗眼看。"],"stanzas":[["及第全胜十政官，","金鞍镀了出长安。"],["马头渐入扬州郭，","为报时人洗眼看。"]]}
{"id":"a9ff7de851","title":"荅章孝标","author":"李绅","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["假金只用真金镀，","若是真金不镀金。","十载长安得一第，","何须空腹用高心。"],"stanzas":[["假金只用真金镀，","若是真金不镀金。"],["十载长安得一第，","何须空腹用高心。"]]}
{"id":"fa60285dfd","title":"戏柳棠","author":"杨汝士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文章漫道能吞凤，","杯酒何曾解吃鱼。","今日梓州张社会，","应须遭这老尚书。"],"stanzas":[["文章漫道能吞凤，","杯酒何曾解吃鱼。"],["今日梓州张社会，","应须遭这老尚书。"]]}
{"id":"a8eecc7acc","title":"又忤杨尚书诗","author":"柳棠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫言名位未相俦，","风月何曾阻献酬。","前辈不须轻后辈，","靖安今日在衡州。"],"stanzas":[["莫言名位未相俦，","风月何曾阻献酬。"],["前辈不须轻后辈，","靖安今日在衡州。"]]}
{"id":"ed87966eb3","title":"嘲郭凝素","author":"朱泽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三春桃李本无言，","苦被残阳鸟雀喧。","借问东邻效西子，","何如郭素拟王轩。"],"stanzas":[["三春桃李本无言，","苦被残阳鸟雀喧。"],["借问东邻效西子，","何如郭素拟王轩。"]]}
{"id":"4a1fe1fc66","title":"纪中表试案","author":"郑光业","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新糊案子，","其白如银。","入试出试，","千春万春。"],"stanzas":[["新糊案子，","其白如银。"],["入试出试，","千春万春。"]]}
{"id":"da7bbcfc97","title":"醉题广州使院","author":"郑愚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数年百姓受饥荒，","太守贪残似虎狼。","今日海隅鱼米贱，","大须慙媿石榴黄。"],"stanzas":[["数年百姓受饥荒，","太守贪残似虎狼。"],["今日海隅鱼米贱，","大须慙媿石榴黄。"]]}
{"id":"a56fb6cc30","title":"拟权龙褒体赠鄠县李令及寄朝右","author":"郑愚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鄠县李长官，","横琴膝上弄。","不闻有政声，","但见手子动。"],"stanzas":[["鄠县李长官，","横琴膝上弄。"],["不闻有政声，","但见手子动。"]]}
{"id":"7337a979fd","title":"题沧浪峡牓","author":"郑仁表","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["分峡东西路正长，","行人名利火然汤。","路傍著板沧浪峡，","真是将闲搅撩忙。"],"stanzas":[["分峡东西路正长，","行人名利火然汤。"],["路傍著板沧浪峡，","真是将闲搅撩忙。"]]}
{"id":"01ef91edee","title":"戏妻族语不正","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["呼十却为石，","唤针将作真。","忽然云雨至，","总道是天因。"],"stanzas":[["呼十却为石，","唤针将作真。"],["忽然云雨至，","总道是天因。"]]}
{"id":"557211e546","title":"婢仆诗 一","author":"李昌符","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春娘爱上酒家楼，","不怕归迟总不忧。","推道那家娘子卧，","且留教住待梳头。"],"stanzas":[["春娘爱上酒家楼，","不怕归迟总不忧。"],["推道那家娘子卧，","且留教住待梳头。"]]}
{"id":"c8e81e0a52","title":"婢仆诗 二","author":"李昌符","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不论秋菊与春花，","个个能噇空腹茶。","无事莫教频入库，","一名闲物要些些。"],"stanzas":[["不论秋菊与春花，","个个能噇空腹茶。"],["无事莫教频入库，","一名闲物要些些。"]]}
{"id":"3aa40f9408","title":"嘲郑傪妓","author":"孙子多","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相公经文复经武，","常侍好今兼好古。","昔人曾闻阿武婆，","今日亲见阿婆舞。"],"stanzas":[["相公经文复经武，","常侍好今兼好古。"],["昔人曾闻阿武婆，","今日亲见阿婆舞。"]]}
{"id":"b461cfbf6e","title":"嘲赵璘 一","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巡关每傍摴蒲局，","望月还登乞巧楼。","第一莫教娇太过，","缘人衣带上人头。"],"stanzas":[["巡关每傍摴蒲局，","望月还登乞巧楼。"],["第一莫教娇太过，","缘人衣带上人头。"]]}
{"id":"9c5af75166","title":"嘲赵璘 二","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不知原在鞍轿里，","将谓空驮席帽归。"],"stanzas":[["不知原在鞍轿里，","将谓空驮席帽归。"]]}
{"id":"4fa24db8b5","title":"嘲赵璘 三","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["火炉床上平身立，","便与夫人作镜台。"],"stanzas":[["火炉床上平身立，","便与夫人作镜台。"]]}
{"id":"d34319b7ab","title":"口号","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["素脊鸣秋杖，","乌鞾响暮厅。","刃飞三尺雪，","白日落文星。"],"stanzas":[["素脊鸣秋杖，","乌鞾响暮厅。"],["刃飞三尺雪，","白日落文星。"]]}
{"id":"5a7840f71b","title":"嘲归仁绍龟诗","author":"皮日休","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["硬骨残形知几秋，","尸骸终是不风流。","顽皮死后钻须徧，","都为平生不出头。"],"stanzas":[["硬骨残形知几秋，","尸骸终是不风流。"],["顽皮死后钻须徧，","都为平生不出头。"]]}
{"id":"f76ccc48fe","title":"咏螃蟹呈浙西从事","author":"皮日休","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未游沧海早知名，","有骨还从肉上生。","莫道无心畏雷电，","海龙王处也横行。"],"stanzas":[["未游沧海早知名，","有骨还从肉上生。"],["莫道无心畏雷电，","海龙王处也横行。"]]}
{"id":"6d336429f6","title":"题中书壁","author":"郑綮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侧坡蛆蜫蜦，","蚁子竞来拖。","一朝白雨中，","无钝无喽罗。"],"stanzas":[["侧坡蛆蜫蜦，","蚁子竞来拖。"],["一朝白雨中，","无钝无喽罗。"]]}
{"id":"16cdb2d79c","title":"别庐州郡人","author":"郑綮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["唯有两行公廨泪，","一时洒向渡头风。"],"stanzas":[["唯有两行公廨泪，","一时洒向渡头风。"]]}
{"id":"51aad87f8a","title":"戏荅成汭","author":"徐彦若","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南海黄茅瘴，","不死成和尚。"],"stanzas":[["南海黄茅瘴，","不死成和尚。"]]}
{"id":"03580a8324","title":"醉中谑浙江廉使","author":"崔立言","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山夫留意向丹梯，","连帅邀来出药畦。","常见浙东夸镜水，","镜湖元在浙江西。"],"stanzas":[["山夫留意向丹梯，","连帅邀来出药畦。"],["常见浙东夸镜水，","镜湖元在浙江西。"]]}
{"id":"43cf6e62f0","title":"戏题盱眙邵明府壁","author":"韦鹏翼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岂肯闲寻竹径行，","却嫌丝管好蛙声。","自从煮鹤烧琴后，","背却青山卧月明。"],"stanzas":[["岂肯闲寻竹径行，","却嫌丝管好蛙声。"],["自从煮鹤烧琴后，","背却青山卧月明。"]]}
{"id":"7044fdf1c1","title":"题大梁临汴驿","author":"姚嵘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["近日侯门不重才，","莫将文艺拟为媒。","相逢若要如胶漆，","不是红妆即拨灰。"],"stanzas":[["近日侯门不重才，","莫将文艺拟为媒。"],["相逢若要如胶漆，","不是红妆即拨灰。"]]}
{"id":"7a2e2c77ca","title":"题仙娥驿","author":"李日新","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["商山食店大悠悠，","陈鹖䭔锣古䭃头。","更有台中牛肉炙，","尚盘数脔紫光毬。"],"stanzas":[["商山食店大悠悠，","陈鹖䭔锣古䭃头。"],["更有台中牛肉炙，","尚盘数脔紫光毬。"]]}
{"id":"29db307450","title":"嘲染家","author":"柳逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫绿终朝染，","因何不识非。","莆田竹木贵，","背负十柴归。"],"stanzas":[["紫绿终朝染，","因何不识非。"],["莆田竹木贵，","背负十柴归。"]]}
{"id":"aed1750fc2","title":"赠漳州崔使君乡饮飜韵诗","author":"黎瓘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惯向溪边折柳杨，","因循行客到州漳。","无端触忤王衙押，","不得今朝看饮乡。"],"stanzas":[["惯向溪边折柳杨，","因循行客到州漳。"],["无端触忤王衙押，","不得今朝看饮乡。"]]}
{"id":"01c7e43ea7","title":"示妓牓子","author":"张保胤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿罗帬下标三棒，","红粉顋边泪两行。","叉手向前咨大使，","这回不敢恼儿郎。"],"stanzas":[["绿罗帬下标三棒，","红粉顋边泪两行。"],["叉手向前咨大使，","这回不敢恼儿郎。"]]}
{"id":"7316a7c6b2","title":"又留别同院","author":"张保胤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忆昔当年富贵时，","如今头脑尚依稀。","布袍破后思宫内，","锦袴穿时忆御衣。","鹘子背钻高力士，","婵娟飜画太真妃。","如今顦顇离南海，","恰似当时幸蜀时。"],"stanzas":[["忆昔当年富贵时，","如今头脑尚依稀。"],["布袍破后思宫内，","锦袴穿时忆御衣。"],["鹘子背钻高力士，","婵娟飜画太真妃。"],["如今顦顇离南海，","恰似当时幸蜀时。"]]}
{"id":"ced56ab8f7","title":"桂州筵上赠胡予女","author":"陆岩梦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自道风流不可攀，","却堪蹙额更颓颜。","眼睛深却湘江水，","鼻孔高于华岳山。","舞态固难居掌上，","歌声应不绕梁间。","孟阳死后欲千载，","犹在佳人觅往还。"],"stanzas":[["自道风流不可攀，","却堪蹙额更颓颜。"],["眼睛深却湘江水，","鼻孔高于华岳山。"],["舞态固难居掌上，","歌声应不绕梁间。"],["孟阳死后欲千载，","犹在佳人觅往还。"]]}
{"id":"5309ef7965","title":"戏荅朝士","author":"李都","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华缄千里到荆门，","章草纵横任意论。","应笑钟张虚用力，","却教羲献枉劳魂。","惟堪爱惜为珍宝，","不敢传留误子孙。","深荷故人相厚处，","天行时气许教吞。"],"stanzas":[["华缄千里到荆门，","章草纵横任意论。"],["应笑钟张虚用力，","却教羲献枉劳魂。"],["惟堪爱惜为珍宝，","不敢传留误子孙。"],["深荷故人相厚处，","天行时气许教吞。"]]}
{"id":"78e0d984d9","title":"嘲僧惟恭","author":"荆人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵岿作尽业，","惟恭继其迹。","地狱千万重，","莫厌排头人。"],"stanzas":[["灵岿作尽业，","惟恭继其迹。"],["地狱千万重，","莫厌排头人。"]]}
{"id":"864daec7e5","title":"题酒户修孔庙状","author":"冯道幕客","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["槐影参差覆杏坛，","儒门子弟尽高官。","却教酒户重修庙，","觅我惭惶也不难。"],"stanzas":[["槐影参差覆杏坛，","儒门子弟尽高官。"],["却教酒户重修庙，","觅我惭惶也不难。"]]}
{"id":"acbb04425e","title":"孔庙口号","author":"李花开","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["破落三间屋，","萧条一旅人。","不知负何事，","生死厄于陈。"],"stanzas":[["破落三间屋，","萧条一旅人。"],["不知负何事，","生死厄于陈。"]]}
{"id":"683ad0da2a","title":"荅妻","author":"冯晖","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["休说办不办，","且看瓮里飞出雁。"],"stanzas":[["休说办不办，","且看瓮里飞出雁。"]]}
{"id":"c650a49df4","title":"题僧院","author":"李涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["走却坐禅客，","移将不动尊。","世间颠倒事，","八万四千门。"],"stanzas":[["走却坐禅客，","移将不动尊。"],["世间颠倒事，","八万四千门。"]]}
{"id":"91206d6773","title":"咏垂丝蜘蛛嘲云辨僧","author":"杨苎萝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吃得肚婴撑，","寻思绕寺行。","空中设罗网，","只待杀众生。"],"stanzas":[["吃得肚婴撑，","寻思绕寺行。"],["空中设罗网，","只待杀众生。"]]}
{"id":"9149b22564","title":"自嘲绝句","author":"冯涓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["取水郎中何日了，","破柴员外几时休。","早知蜀地区娵与，","悔不长安大比丘。"],"stanzas":[["取水郎中何日了，","破柴员外几时休。"],["早知蜀地区娵与，","悔不长安大比丘。"]]}
{"id":"acfe08e697","title":"哭亡将诗","author":"卢延让","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自是碙砂发，","非干骇石伤。","牒高身上职，","盌大背边创。"],"stanzas":[["自是碙砂发，","非干骇石伤。"],["牒高身上职，","盌大背边创。"]]}
{"id":"0bcd825894","title":"咏王给事","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["厥父元非道郡奴，","允光何事太侏儒。","可中与个皮裩著，","擎得天王左脚无。"],"stanzas":[["厥父元非道郡奴，","允光何事太侏儒。"],["可中与个皮裩著，","擎得天王左脚无。"]]}
{"id":"e85d74264e","title":"咏金刚","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扬眉斗目恶精神，","揑合将来恰似真。","刚被时流借拳势，","不知身自是泥人。"],"stanzas":[["扬眉斗目恶精神，","揑合将来恰似真。"],["刚被时流借拳势，","不知身自是泥人。"]]}
{"id":"bd9ecb09b4","title":"咏伛背子","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["出得门来背拄天，","同行难可与差肩。","若教倚向闲牕下，","恰似箜篌不著弦。"],"stanzas":[["出得门来背拄天，","同行难可与差肩。"],["若教倚向闲牕下，","恰似箜篌不著弦。"]]}
{"id":"36a36b1263","title":"咏安仁宰捣蒜","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["安仁县令好诛求，","百姓脂膏满面流。","半破磁缸成醋酒，","死牛肠肚作馒头。","帐生岁取餐三顿，","乡老盘庚犯五瓯。","半醉半醒齐出县，","共伤涂炭不胜愁。"],"stanzas":[["安仁县令好诛求，","百姓脂膏满面流。"],["半破磁缸成醋酒，","死牛肠肚作馒头。"],["帐生岁取餐三顿，","乡老盘庚犯五瓯。"],["半醉半醒齐出县，","共伤涂炭不胜愁。"]]}
{"id":"d891479de8","title":"五门街望有题","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我皇开国十余年，","一辈超升炙手欢。","闲向五门楼下望，","衙官骑马使衙官。"],"stanzas":[["我皇开国十余年，","一辈超升炙手欢。"],["闲向五门楼下望，","衙官骑马使衙官。"]]}
{"id":"f10da49469","title":"谢郎中惠茶","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三斤绿茗赐贻恭，","一种颁沾事不同。","想料肠怀无荅处，","披毛戴角谢郎中。"],"stanzas":[["三斤绿茗赐贻恭，","一种颁沾事不同。"],["想料肠怀无荅处，","披毛戴角谢郎中。"]]}
{"id":"290bd10239","title":"咏虾蟆","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坐卧兼行总一般，","向人努眼太无端。","欲知自己形骸小，","试就蹄涔照影看。"],"stanzas":[["坐卧兼行总一般，","向人努眼太无端。"],["欲知自己形骸小，","试就蹄涔照影看。"]]}
{"id":"f6b049f9ac","title":"住名山日陈情上府主高太保","author":"蒋贻恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名山主簿实堪愁，","难齩他家大骨头。","米纳功南钱纳府，","祗看江面水东流。"],"stanzas":[["名山主簿实堪愁，","难齩他家大骨头。"],["米纳功南钱纳府，","祗看江面水东流。"]]}
{"id":"2053df2c84","title":"咏刺猬","author":"李贞白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行似针毡动，","卧若栗毬圆。","莫欺如此大，","谁敢便行拳。"],"stanzas":[["行似针毡动，","卧若栗毬圆。"],["莫欺如此大，","谁敢便行拳。"]]}
{"id":"91de54bff1","title":"谒贵公子不礼书格子屏风","author":"李贞白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道格何曾格，","言糊又不糊。","浑身总是眼，","还解识人无。"],"stanzas":[["道格何曾格，","言糊又不糊。"],["浑身总是眼，","还解识人无。"]]}
{"id":"209192cbbc","title":"咏月","author":"李贞白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["当涂当涂见，","芜湖芜湖见。","八月十五夜，","一似没柄扇。"],"stanzas":[["当涂当涂见，","芜湖芜湖见。"],["八月十五夜，","一似没柄扇。"]]}
{"id":"9821650a37","title":"咏狗蚤","author":"李贞白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["与虱都来不较多，","㩧挑筋斗太喽啰。","忽然管著一篮子，","有甚心情那你何。"],"stanzas":[["与虱都来不较多，","㩧挑筋斗太喽啰。"],["忽然管著一篮子，","有甚心情那你何。"]]}
