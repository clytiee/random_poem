{"id":"6defeb5466","title":"崔驸马宅咏画山水扇","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["画扇出秦楼，","谁家赠列侯。","小含吴剡县，","轻带楚扬州。","揜作山云暮，","摇成陇树秋。","坐来传与客，","汉水又回流。"],"stanzas":[["画扇出秦楼，","谁家赠列侯。"],["小含吴剡县，","轻带楚扬州。"],["揜作山云暮，","摇成陇树秋。"],["坐来传与客，","汉水又回流。"]]}
{"id":"5d63cd891f","title":"观王美人海图障子","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宋玉东家女，","常怀物外多。","自从图渤海，","谁为觅湘娥。","白鹭栖脂粉，","赪鲂跃绮罗。","仍怜转娇眼，","别恨一横波。"],"stanzas":[["宋玉东家女，","常怀物外多。"],["自从图渤海，","谁为觅湘娥。"],["白鹭栖脂粉，","赪鲂跃绮罗。"],["仍怜转娇眼，","别恨一横波。"]]}
{"id":"94f188f015","title":"闻百舌鸟","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百舌闻他郡，","间关媚物华。","敛形藏一叶，","分响出千花。","坐爱时褰幌，","行藏或驻车。","不须应独感，","三载已辞家。"],"stanzas":[["百舌闻他郡，","间关媚物华。"],["敛形藏一叶，","分响出千花。"],["坐爱时褰幌，","行藏或驻车。"],["不须应独感，","三载已辞家。"]]}
{"id":"5d43516a55","title":"省试方士进恒春草","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东吴有灵草，","生彼剡溪傍。","既乱莓苔色，","仍连菡萏香。","掇之称远士，","持以奉明王。","北阙颜弥驻，","南山寿更长。","金膏徒骋妙，","石髓莫矜良。","倘使沾涓滴，","还游不死方。"],"stanzas":[["东吴有灵草，","生彼剡溪傍。"],["既乱莓苔色，","仍连菡萏香。"],["掇之称远士，","持以奉明王。"],["北阙颜弥驻，","南山寿更长。"],["金膏徒骋妙，","石髓莫矜良。"],["倘使沾涓滴，","还游不死方。"]]}
{"id":"f515d3c083","title":"代征人妻喜夫还","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["征夫走马发渔阳，","少妇含娇开洞房。","千日废台还挂镜，","数年尘面再新妆。","春风喜出今朝户，","明日虚眠昨夜床。","莫道幽闺书信隔，","还衣总是旧时香。"],"stanzas":[["征夫走马发渔阳，","少妇含娇开洞房。"],["千日废台还挂镜，","数年尘面再新妆。"],["春风喜出今朝户，","明日虚眠昨夜床。"],["莫道幽闺书信隔，","还衣总是旧时香。"]]}
{"id":"8c2225c6e1","title":"赠李中华","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫向嵩山去，","神仙多误人。","不如朝魏阙，","天子重贤臣。"],"stanzas":[["莫向嵩山去，","神仙多误人。"],["不如朝魏阙，","天子重贤臣。"]]}
{"id":"1ae7dba1aa","title":"咏木老人","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["刻木牵丝作老翁，","鸡皮鹤发与真同。","须臾弄罢寂无事，","还似人生一梦中。"],"stanzas":[["刻木牵丝作老翁，","鸡皮鹤发与真同。"],["须臾弄罢寂无事，","还似人生一梦中。"]]}
{"id":"f644b18559","title":"句","author":"梁锽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堂高凭上望，","宅广乘车行。"],"stanzas":[["堂高凭上望，","宅广乘车行。"]]}
{"id":"1dde0e0bef","title":"客中作","author":"杜俨","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["书劒催人不暂闲，","洛阳羁旅复秦关。","容颜岁岁愁边改，","乡国时时梦里还。"],"stanzas":[["书劒催人不暂闲，","洛阳羁旅复秦关。"],["容颜岁岁愁边改，","乡国时时梦里还。"]]}
{"id":"99abc4f7f6","title":"三月三日曲江侍宴","author":"赵良器","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣祖发神谋，","灵符叶帝求。","一人光锡命，","万国荷时休。","雷解圜丘毕，","云需曲水游。","岸花迎步辇，","仙仗拥行舟。","睿藻天中降，","恩波海外流。","小臣同品物，","陪此乐皇猷。"],"stanzas":[["圣祖发神谋，","灵符叶帝求。"],["一人光锡命，","万国荷时休。"],["雷解圜丘毕，","云需曲水游。"],["岸花迎步辇，","仙仗拥行舟。"],["睿藻天中降，","恩波海外流。"],["小臣同品物，","陪此乐皇猷。"]]}
