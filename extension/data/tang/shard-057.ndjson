{"id":"fef7b722b3","title":"韩信庙","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["将略兵机命世雄，","苍黄钟室叹良弓。","遂令后代登坛者，","每一寻思怕立功。"],"stanzas":[["将略兵机命世雄，","苍黄钟室叹良弓。"],["遂令后代登坛者，","每一寻思怕立功。"]]}
{"id":"62338505d1","title":"李贾二大夫谏拜命后寄杨八寿州","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谏省新登二直臣，","万方惊喜捧丝纶。","则知天子明如日，","肯放淮南高卧人。"],"stanzas":[["谏省新登二直臣，","万方惊喜捧丝纶。"],["则知天子明如日，","肯放淮南高卧人。"]]}
{"id":"b98e95e201","title":"美温尚书镇定兴元以诗寄贺","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旌旗入境犬无声，","戮尽鲸鲵汉水清。","从此世人开耳目，","始知名将出书生。"],"stanzas":[["旌旗入境犬无声，","戮尽鲸鲵汉水清。"],["从此世人开耳目，","始知名将出书生。"]]}
{"id":"2716c43818","title":"酬瑞州吴大夫夜泊湘川见寄一绝","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜泊湘川逐客心，","月明猿苦血沾襟。","湘妃旧竹痕犹浅，","从此因君染更深。"],"stanzas":[["夜泊湘川逐客心，","月明猿苦血沾襟。"],["湘妃旧竹痕犹浅，","从此因君染更深。"]]}
{"id":"288313e96e","title":"征还京师见旧番官冯叔达","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前者匆匆襆被行，","十年憔悴到京城。","南宫旧吏来相问，","何处淹留白发生。"],"stanzas":[["前者匆匆襆被行，","十年憔悴到京城。"],["南宫旧吏来相问，","何处淹留白发生。"]]}
{"id":"d86a5c621b","title":"与歌者何戡","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二十余年别帝京，","重闻天乐不胜情。","旧人唯有何戡在，","更与殷勤唱渭城。"],"stanzas":[["二十余年别帝京，","重闻天乐不胜情。"],["旧人唯有何戡在，","更与殷勤唱渭城。"]]}
{"id":"af66974551","title":"与歌童田顺郎","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天下能歌御史娘，","花前叶底奉君王。","九重深处无人见，","分付新声与顺郎。"],"stanzas":[["天下能歌御史娘，","花前叶底奉君王。"],["九重深处无人见，","分付新声与顺郎。"]]}
{"id":"01c05056c9","title":"燕尔馆破屏风所画至精人多叹赏题之","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["画时应遇空亡日，","卖处难逢识别人。","唯有多情往来客，","强将衫袖拂埃尘。"],"stanzas":[["画时应遇空亡日，","卖处难逢识别人。"],["唯有多情往来客，","强将衫袖拂埃尘。"]]}
{"id":"13b6cf0ca1","title":"赏牡丹","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庭前芍药妖无格，","池上芙蕖净少情。","唯有牡丹真国色，","花开时节动京城。"],"stanzas":[["庭前芍药妖无格，","池上芙蕖净少情。"],["唯有牡丹真国色，","花开时节动京城。"]]}
{"id":"87125437f3","title":"题欹器图","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦国功成思税驾，","晋臣名遂叹危机。","无因上蔡牵黄犬，","愿作丹徒一布衣。"],"stanzas":[["秦国功成思税驾，","晋臣名遂叹危机。"],["无因上蔡牵黄犬，","愿作丹徒一布衣。"]]}
{"id":"6fc34c41f4","title":"伤桃源薛道士","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坛边松在鹤巢空，","白鹿闲行旧径中。","手植红桃千树发，","满山无主任春风。"],"stanzas":[["坛边松在鹤巢空，","白鹿闲行旧径中。"],["手植红桃千树发，","满山无主任春风。"]]}
{"id":"c30450ff4c","title":"王思道碑堂下作","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍苍宰树起寒烟，","尚有威名海内传。","四府旧闻多故吏，","几人垂泪拜碑前。"],"stanzas":[["苍苍宰树起寒烟，","尚有威名海内传。"],["四府旧闻多故吏，","几人垂泪拜碑前。"]]}
{"id":"fcd503b056","title":"伤愚溪三首 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溪水悠悠春自来，","草堂无主燕飞回。","隔帘惟见中庭草，","一树山榴依旧开。"],"stanzas":[["溪水悠悠春自来，","草堂无主燕飞回。"],["隔帘惟见中庭草，","一树山榴依旧开。"]]}
{"id":"89c23eb343","title":"伤愚溪三首 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["草圣数行留坏壁，","木奴千树属邻家。","唯见里门通德牓，","残阳寂寞出樵车。"],"stanzas":[["草圣数行留坏壁，","木奴千树属邻家。"],["唯见里门通德牓，","残阳寂寞出樵车。"]]}
{"id":"6569c067db","title":"伤愚溪三首 三","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳门竹巷依依在，","野草青苔日日多。","纵有邻人解吹笛，","山阳旧侣更谁过。"],"stanzas":[["柳门竹巷依依在，","野草青苔日日多。"],["纵有邻人解吹笛，","山阳旧侣更谁过。"]]}
{"id":"e98b0c814f","title":"伤循州浑尚书","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贵人沦落路人衰，","碧海连天丹旐回。","遥想长安此时节，","朱门深巷百花开。"],"stanzas":[["贵人沦落路人衰，","碧海连天丹旐回。"],["遥想长安此时节，","朱门深巷百花开。"]]}
{"id":"1a366a7f0a","title":"代靖安佳人怨二首 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝马鸣珂踏晓尘，","鱼文匕首犯车茵。","适来行哭里门外，","昨夜华堂歌舞人。"],"stanzas":[["宝马鸣珂踏晓尘，","鱼文匕首犯车茵。"],["适来行哭里门外，","昨夜华堂歌舞人。"]]}
{"id":"a21d8fb209","title":"代靖安佳人怨二首 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秉烛朝天遂不回，","路人弹指望高台。","墙东便是伤心地，","夜夜流萤飞去来。"],"stanzas":[["秉烛朝天遂不回，","路人弹指望高台。"],["墙东便是伤心地，","夜夜流萤飞去来。"]]}
{"id":"465f7bb22a","title":"碧涧寺见元九侍御和展上人诗有三生之句因以和","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["廊下题诗满壁尘，","塔前松树已皴鳞。","古来唯有王文度，","重见平生竺道人。"],"stanzas":[["廊下题诗满壁尘，","塔前松树已皴鳞。"],["古来唯有王文度，","重见平生竺道人。"]]}
{"id":"0755d1502f","title":"思黯南墅赏牡丹","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶然相遇人间世，","合在增城阿姥家。","有此倾城好颜色，","天教晚发赛诸花。"],"stanzas":[["偶然相遇人间世，","合在增城阿姥家。"],["有此倾城好颜色，","天教晚发赛诸花。"]]}
{"id":"e1dd8352f0","title":"和浙西尚书闻常州杨给事制新楼因寄之作","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文昌星象尽东来，","油幕朱门次第开。","且上新楼看风月，","会乘云雨一时回。"],"stanzas":[["文昌星象尽东来，","油幕朱门次第开。"],["且上新楼看风月，","会乘云雨一时回。"]]}
{"id":"7611352e5a","title":"从梁宣明二帝碑堂下作","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉马朝周从此辞，","园陵寂寞对丰碑。","千行宰树荆州道，","暮雨萧萧闻子规。"],"stanzas":[["玉马朝周从此辞，","园陵寂寞对丰碑。"],["千行宰树荆州道，","暮雨萧萧闻子规。"]]}
{"id":"a4c284256d","title":"赠李司空妓","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高髻云鬟宫样妆，","春风一曲杜韦娘。","司空见惯浑闲事，","断尽苏州刺史肠。"],"stanzas":[["高髻云鬟宫样妆，","春风一曲杜韦娘。"],["司空见惯浑闲事，","断尽苏州刺史肠。"]]}
{"id":"9e0fd396b8","title":"赠李司空妓","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["髪鬓梳头宫様妆，","春风一曲杜韦娘。","司空见惯浑闲事，","断尽苏州刺史肠。"],"stanzas":[["髪鬓梳头宫様妆，","春风一曲杜韦娘。"],["司空见惯浑闲事，","断尽苏州刺史肠。"]]}
{"id":"c42b0b3f8d","title":"和西川李尚书伤孔雀及薛涛之什","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉儿已逐金镮葬，","翠羽先随秋草萎。","唯见芙蓉含晓露，","数行红泪滴清池。"],"stanzas":[["玉儿已逐金镮葬，","翠羽先随秋草萎。"],["唯见芙蓉含晓露，","数行红泪滴清池。"]]}
{"id":"81a222d8dc","title":"同乐天登栖灵寺塔","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["步步相携不觉难，","九层云外倚阑干。","忽然笑语半天上，","无限游人举眼看。"],"stanzas":[["步步相携不觉难，","九层云外倚阑干。"],["忽然笑语半天上，","无限游人举眼看。"]]}
{"id":"2aae69d0ea","title":"同乐天登栖灵寺塔","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["步步相㩦不觉难，","九霄云外倚栏杆。","忽然语笑半天上，","无限游人举眼看。"],"stanzas":[["步步相㩦不觉难，","九霄云外倚栏杆。"],["忽然语笑半天上，","无限游人举眼看。"]]}
{"id":"581c40002d","title":"有所嗟二首 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庾令楼中初见时，","武昌春柳似腰肢。","相逢相笑尽如梦，","为雨为云今不知。"],"stanzas":[["庾令楼中初见时，","武昌春柳似腰肢。"],["相逢相笑尽如梦，","为雨为云今不知。"]]}
{"id":"ce0849a867","title":"有所嗟二首 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鄂渚蒙蒙烟雨微，","女郎魂逐暮云归。","只应长在汉阳渡，","化作鸳鸯一只飞。"],"stanzas":[["鄂渚蒙蒙烟雨微，","女郎魂逐暮云归。"],["只应长在汉阳渡，","化作鸳鸯一只飞。"]]}
{"id":"62c86a0a80","title":"和裴相公傍水闲行","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为爱逍遥第一篇，","时时闲步赏风烟。","看花临水心无事，","功业成来二十年。"],"stanzas":[["为爱逍遥第一篇，","时时闲步赏风烟。"],["看花临水心无事，","功业成来二十年。"]]}
{"id":"7e1c011492","title":"杏园花下酬乐天见赠","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二十余年作逐臣，","归来还见曲江春。","游人莫笑白头醉，","老醉花间有几人。"],"stanzas":[["二十余年作逐臣，","归来还见曲江春。"],["游人莫笑白头醉，","老醉花间有几人。"]]}
{"id":"2ea134ddbd","title":"和乐天春词","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新妆面面下朱楼，","深锁春光一院愁。","行到中庭数花朵，","蜻蜓飞上玉搔头。"],"stanzas":[["新妆面面下朱楼，","深锁春光一院愁。"],["行到中庭数花朵，","蜻蜓飞上玉搔头。"]]}
{"id":"92b038c7f3","title":"和严给事闻唐昌观玉蘂花下有游仙二绝 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉女来看玉蘂花，","异香先引七香车。","攀枝弄雪时廻顾，","惊怪人间日易斜。"],"stanzas":[["玉女来看玉蘂花，","异香先引七香车。"],["攀枝弄雪时廻顾，","惊怪人间日易斜。"]]}
{"id":"b150a431a5","title":"和严给事闻唐昌观玉蘂花下有游仙二绝 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪蘂琼丝满院春，","衣轻步步不生尘。","君平帘下徒相问，","长伴吹箫别有人。"],"stanzas":[["雪蘂琼丝满院春，","衣轻步步不生尘。"],["君平帘下徒相问，","长伴吹箫别有人。"]]}
{"id":"4a21b5d904","title":"忆乐天","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寻常相见意殷勤，","别后相思梦更频。","每遇登临好风景，","羡他天性少情人。"],"stanzas":[["寻常相见意殷勤，","别后相思梦更频。"],["每遇登临好风景，","羡他天性少情人。"]]}
{"id":"5a45b059b0","title":"醉答乐天","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洛城洛城何日归，","故人故人今转稀。","莫嗟雪里暂时别，","终拟云间相逐飞。"],"stanzas":[["洛城洛城何日归，","故人故人今转稀。"],["莫嗟雪里暂时别，","终拟云间相逐飞。"]]}
{"id":"a78a52db3f","title":"虎丘寺见元相公二年前题名怆然有咏","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浐水送君君不还，","见君题字虎丘山。","因知早贵兼才子，","不得多时在世间。"],"stanzas":[["浐水送君君不还，","见君题字虎丘山。"],["因知早贵兼才子，","不得多时在世间。"]]}
{"id":"65bd490270","title":"寄赠小樊","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花面丫头十三四，","春来绰约向人时。","终须买取名春草，","处处将行步步随。"],"stanzas":[["花面丫头十三四，","春来绰约向人时。"],["终须买取名春草，","处处将行步步随。"]]}
{"id":"bb4f7393c3","title":"吟乐天自问怆然有作","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亲友关心皆不见，","风光满眼倍伤神。","洛阳城里多池馆，","几处花开有主人。"],"stanzas":[["亲友关心皆不见，","风光满眼倍伤神。"],["洛阳城里多池馆，","几处花开有主人。"]]}
{"id":"42d5d287ac","title":"和令狐相公别牡丹","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平章宅里一栏花，","临到开时不在家。","莫道两京非远别，","春明门外即天涯。"],"stanzas":[["平章宅里一栏花，","临到开时不在家。"],["莫道两京非远别，","春明门外即天涯。"]]}
{"id":"542a6ef183","title":"和令狐相公闻思帝乡有感","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["当初造曲者为谁，","说得思乡恋阙时。","沧海西头旧丞相，","停杯处分不须吹。"],"stanzas":[["当初造曲者为谁，","说得思乡恋阙时。"],["沧海西头旧丞相，","停杯处分不须吹。"]]}
{"id":"360b2dd570","title":"酬令狐相公见寄","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["群玉山头住四年，","每闻笙鹤看诸仙。","何时得把浮丘袖，","白日将升第九天。"],"stanzas":[["群玉山头住四年，","每闻笙鹤看诸仙。"],["何时得把浮丘袖，","白日将升第九天。"]]}
{"id":"cf9dc1f18d","title":"令狐相公春思见寄","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一纸书封四句诗，","芳晨对酒远相思。","长吟尽日西南望，","犹及残春花落时。"],"stanzas":[["一纸书封四句诗，","芳晨对酒远相思。"],["长吟尽日西南望，","犹及残春花落时。"]]}
{"id":"3e2270fa3b","title":"城内花园颇曾游玩令公居守亦有素期适春霜一夕委谢书实以荅令狐相公见谑","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼下芳园最占春，","年年结侣采花频。","繁霜一夜相撩治，","不似佳人似老人。"],"stanzas":[["楼下芳园最占春，","年年结侣采花频。"],["繁霜一夜相撩治，","不似佳人似老人。"]]}
{"id":"d725579db0","title":"奉和裴晋公凉风亭睡觉","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["骊龙睡后珠元在，","仙鹤行时步又轻。","方寸莹然无一事，","水声来似玉琴声。"],"stanzas":[["骊龙睡后珠元在，","仙鹤行时步又轻。"],["方寸莹然无一事，","水声来似玉琴声。"]]}
{"id":"09296fd2f8","title":"荅裴令公雪中讶白二十二与诸公不相访之什","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉树琼楼满眼新，","的知开合待诸宾。","迟迟未去非无意，","拟作梁园坐右人。"],"stanzas":[["玉树琼楼满眼新，","的知开合待诸宾。"],["迟迟未去非无意，","拟作梁园坐右人。"]]}
{"id":"dc2b9c9233","title":"吴方之见示听江西故吏朱幼恭歌三篇颇有怀故林之想吟讽不足因而和之","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侯家故吏歌声发，","逸处能高怨处低。","今岁洛中无雨雪，","眼前风景是江西。"],"stanzas":[["侯家故吏歌声发，","逸处能高怨处低。"],["今岁洛中无雨雪，","眼前风景是江西。"]]}
{"id":"cc49417b01","title":"裴令公见示诮乐天寄奴买马绝句斐言仰和且戏乐天","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["常奴安得似方回，","争望追风绝足来。","若把翠娥酬𫘧耳，","始知天下有奇才。"],"stanzas":[["常奴安得似方回，","争望追风绝足来。"],["若把翠娥酬𫘧耳，","始知天下有奇才。"]]}
{"id":"7fb74c2c31","title":"酬思黯代书见戏","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["官冷如浆病满身，","凌寒不易过天津。","少年留取多情兴，","请待花时作主人。"],"stanzas":[["官冷如浆病满身，","凌寒不易过天津。"],["少年留取多情兴，","请待花时作主人。"]]}
{"id":"b5b7155a42","title":"荅张侍御贾喜再登科后自洛赴上都赠别","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["又被时人写姓名，","春风引路入京城。","知君忆得前身事，","分付莺花与后生。"],"stanzas":[["又被时人写姓名，","春风引路入京城。"],["知君忆得前身事，","分付莺花与后生。"]]}
{"id":"3e79c51053","title":"赴连州途经洛阳诸公置酒相送张员外贾以诗见赠率尔酬之","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谪在三湘最远州，","边鸿不到水南流。","如今暂寄罇前笑，","明日辞君步步愁。"],"stanzas":[["谪在三湘最远州，","边鸿不到水南流。"],["如今暂寄罇前笑，","明日辞君步步愁。"]]}
{"id":"4fc53c9b11","title":"赠元九侍御文石枕以诗奖之","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文章似锦气如虹，","宜荐华簪绿殿中。","纵使凉飙生旦夕，","犹堪拂拭愈头风。"],"stanzas":[["文章似锦气如虹，","宜荐华簪绿殿中。"],["纵使凉飙生旦夕，","犹堪拂拭愈头风。"]]}
{"id":"ea0dd286c7","title":"酬元九院长自江陵见寄","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无事寻花至仙境，","等闲栽树比封君。","金门通籍真多士，","黄纸除书每日闻。"],"stanzas":[["无事寻花至仙境，","等闲栽树比封君。"],["金门通籍真多士，","黄纸除书每日闻。"]]}
{"id":"a17dad2e2e","title":"酬杨侍郎凭见寄","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翔鸾阙底谢皇恩，","缨上沧浪旧水痕。","疎傅挥金忽相忆，","远擎长句与招魂。"],"stanzas":[["翔鸾阙底谢皇恩，","缨上沧浪旧水痕。"],["疎傅挥金忽相忆，","远擎长句与招魂。"]]}
{"id":"987349b77c","title":"酬马大夫登洭口戍见寄","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新辞将印拂朝缨，","临水登山四体轻。","犹念天涯未归客，","瘴云深处守孤城。"],"stanzas":[["新辞将印拂朝缨，","临水登山四体轻。"],["犹念天涯未归客，","瘴云深处守孤城。"]]}
{"id":"3ba8553224","title":"荅杨八敬之绝句","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["饱霜孤竹声偏切，","带火焦桐韵本悲。","今日知音一留听，","是君心事不平时。"],"stanzas":[["饱霜孤竹声偏切，","带火焦桐韵本悲。"],["今日知音一留听，","是君心事不平时。"]]}
{"id":"af1bb1716b","title":"重寄表臣二首 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["对酒临流奈别何，","君今已醉我蹉跎。","分明记取星星鬓，","他日相逢应更多。"],"stanzas":[["对酒临流奈别何，","君今已醉我蹉跎。"],["分明记取星星鬓，","他日相逢应更多。"]]}
{"id":"70c5728f43","title":"重寄表臣二首 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世间人事有何穷，","过后思量尽是空。","早晚同归洛阳陌，","卜隣须近祝鸡翁。"],"stanzas":[["世间人事有何穷，","过后思量尽是空。"],["早晚同归洛阳陌，","卜隣须近祝鸡翁。"]]}
{"id":"0cc67c4fbe","title":"重寄绝句","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["淮西既是平安地，","鸦路今无羽檄飞。","闻道唐州最清静，","战场耕尽野花稀。"],"stanzas":[["淮西既是平安地，","鸦路今无羽檄飞。"],["闻道唐州最清静，","战场耕尽野花稀。"]]}
{"id":"109e04efd3","title":"酬杨八副使将赴湖南途中见寄一绝","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["知逐征南冠楚材，","远劳书信到阳台。","明朝若上君山上，","一道巴江自此来。"],"stanzas":[["知逐征南冠楚材，","远劳书信到阳台。"],["明朝若上君山上，","一道巴江自此来。"]]}
{"id":"7b976a0fd6","title":"遥和韩睦州元相公二君子","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉人紫绶相辉映，","却要霜须一两茎。","其奈无成空老去，","每临明镜若为情。"],"stanzas":[["玉人紫绶相辉映，","却要霜须一两茎。"],["其奈无成空老去，","每临明镜若为情。"]]}
{"id":"0b1a3a46e1","title":"吴兴敬郎中见惠斑竹杖兼示一绝聊以谢之","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一茎炯炯琅玕色，","数节重重玳瑁文。","挂到高山未登处，","青云路上愿逢君。"],"stanzas":[["一茎炯炯琅玕色，","数节重重玳瑁文。"],["挂到高山未登处，","青云路上愿逢君。"]]}
{"id":"b850a1b462","title":"奉和裴令公夜宴","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天下苍生望不休，","东山虽有但时游。","从来海上仙桃树，","肯逐人间风露秋。"],"stanzas":[["天下苍生望不休，","东山虽有但时游。"],["从来海上仙桃树，","肯逐人间风露秋。"]]}
{"id":"e3fbf9c700","title":"秋夜安国观闻笙","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["织女分明银汉秋，","桂枝梧叶共飕飗。","月露满庭人寂寂，","霓裳一曲在高楼。"],"stanzas":[["织女分明银汉秋，","桂枝梧叶共飕飗。"],["月露满庭人寂寂，","霓裳一曲在高楼。"]]}
{"id":"942a332d50","title":"酬仆射牛相公晋国池上别后至甘棠馆忽梦同游因成口号见寄","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已嗟池上别魂惊，","忽报梦中携手行。","此夜独归还乞梦，","老人无睡到天明。"],"stanzas":[["已嗟池上别魂惊，","忽报梦中携手行。"],["此夜独归还乞梦，","老人无睡到天明。"]]}
{"id":"637173d918","title":"裴侍郎大尹雪中遗酒一壶兼示眼疾平一绝有闲行把酒之句斐然仰酬","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卷尽轻云月更明，","金箆不用且闲行。","若倾家酿招来客，","何必池塘春草生。"],"stanzas":[["卷尽轻云月更明，","金箆不用且闲行。"],["若倾家酿招来客，","何必池塘春草生。"]]}
{"id":"e862f90c07","title":"和滑州李尚书上巳忆江南禊事","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白马津头春日迟，","沙州归鴈拂旌旗。","柳营唯有军中戏，","不似江南三月时。"],"stanzas":[["白马津头春日迟，","沙州归鴈拂旌旗。"],["柳营唯有军中戏，","不似江南三月时。"]]}
{"id":"755ae6d1ad","title":"酬柳柳州家鸡之赠","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日日临池弄小雏，","还思写论付官奴。","柳家新样元和脚，","且尽畺芽歛手徒。"],"stanzas":[["日日临池弄小雏，","还思写论付官奴。"],["柳家新样元和脚，","且尽畺芽歛手徒。"]]}
{"id":"356d9f9406","title":"荅前篇","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小儿弄笔不能嗔，","涴壁书窗且当勤。","闻彼梦熊犹未兆，","女中谁是卫夫人。"],"stanzas":[["小儿弄笔不能嗔，","涴壁书窗且当勤。"],["闻彼梦熊犹未兆，","女中谁是卫夫人。"]]}
{"id":"026015a9f4","title":"荅后篇","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔日慵工记姓名，","远劳辛苦写西京。","近来渐有临池兴，","为报元常欲抗行。"],"stanzas":[["昔日慵工记姓名，","远劳辛苦写西京。"],["近来渐有临池兴，","为报元常欲抗行。"]]}
{"id":"37aff1932a","title":"重荅柳柳州","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弱冠同怀长者忧，","临岐回想尽悠悠。","耦耕若便遗身老，","黄发相看万事休。"],"stanzas":[["弱冠同怀长者忧，","临岐回想尽悠悠。"],["耦耕若便遗身老，","黄发相看万事休。"]]}
{"id":"73890b94d6","title":"登清晖楼","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浔阳江色潮添满，","彭蠡秋声鴈送来。","南望庐山千万仞，","共夸新出栋梁材。"],"stanzas":[["浔阳江色潮添满，","彭蠡秋声鴈送来。"],["南望庐山千万仞，","共夸新出栋梁材。"]]}
{"id":"b221cb47e5","title":"赴和州于武昌县再遇毛仙翁十八兄因成一绝","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武昌山下蜀江东，","重向仙舟见葛洪。","又得案前亲礼拜，","大罗天诀玉函封。"],"stanzas":[["武昌山下蜀江东，","重向仙舟见葛洪。"],["又得案前亲礼拜，","大罗天诀玉函封。"]]}
{"id":"81fe263ad0","title":"寄毘陵杨给事三首 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["挥毫起制来东省，","蹑足修名谒外台。","好著櫜鞬莫惆怅，","出文入武是全才。"],"stanzas":[["挥毫起制来东省，","蹑足修名谒外台。"],["好著櫜鞬莫惆怅，","出文入武是全才。"]]}
{"id":"fb9ed5bae3","title":"寄毘陵杨给事三首 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾主鱼书轻刺史，","今朝自请左鱼来。","青云直上无多地，","却要斜飞取势回。"],"stanzas":[["曾主鱼书轻刺史，","今朝自请左鱼来。"],["青云直上无多地，","却要斜飞取势回。"]]}
{"id":"86e777c24b","title":"寄毘陵杨给事三首 三","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东城南陌昔同游，","坐上无人第二流。","屈指如今已零落，","且须欢喜作邻州。"],"stanzas":[["东城南陌昔同游，","坐上无人第二流。"],["屈指如今已零落，","且须欢喜作邻州。"]]}
{"id":"eda4cd4327","title":"陪崔大尚书及诸阁老宴杏园","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["更将何面上春台，","白事无成老又催。","唯有落花无俗态，","不嫌憔悴满头来。"],"stanzas":[["更将何面上春台，","白事无成老又催。"],["唯有落花无俗态，","不嫌憔悴满头来。"]]}
{"id":"9c43712e1c","title":"曹刚","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大弦嘈囋小弦清，","喷雪含风意思生。","一听曹刚弹薄媚，","人生不合出京城。"],"stanzas":[["大弦嘈囋小弦清，","喷雪含风意思生。"],["一听曹刚弹薄媚，","人生不合出京城。"]]}
{"id":"e8e88822f6","title":"寄湖州韩中丞","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老郎日日忧苍鬓，","远守年年厌白苹。","终日相思不相见，","长频相见是何人。"],"stanzas":[["老郎日日忧苍鬓，","远守年年厌白苹。"],["终日相思不相见，","长频相见是何人。"]]}
{"id":"ec75046557","title":"杨柳枝","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨子江头烟景迷，","隋家宫树拂金堤。","嵯峨犹有当时色，","半蘸波中水鸟栖。"],"stanzas":[["杨子江头烟景迷，","隋家宫树拂金堤。"],["嵯峨犹有当时色，","半蘸波中水鸟栖。"]]}
{"id":"57f562bada","title":"田顺郎歌","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清歌不是世间音，","玉殿尝闻称主心。","唯有顺郎全学得，","一声飞出九重深。"],"stanzas":[["清歌不是世间音，","玉殿尝闻称主心。"],["唯有顺郎全学得，","一声飞出九重深。"]]}
{"id":"52c166a379","title":"夜闻商人船中筝","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大艑高帆一百尺，","新声促柱十三弦。","扬州市里商人女，","来占江西明月天。"],"stanzas":[["大艑高帆一百尺，","新声促柱十三弦。"],["扬州市里商人女，","来占江西明月天。"]]}
{"id":"1505f6fce2","title":"闻道士弹思归引","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙公一奏思归引，","逐客初闻自泫然。","莫怪殷勤悲此曲，","越声长苦已三年。"],"stanzas":[["仙公一奏思归引，","逐客初闻自泫然。"],["莫怪殷勤悲此曲，","越声长苦已三年。"]]}
{"id":"a5e70d9a31","title":"喜康将军见访","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谪君愁寂似幽栖，","百草当门茅舍低。","夜猎将军忽相访，","鹧鸪惊起绕篱啼。"],"stanzas":[["谪君愁寂似幽栖，","百草当门茅舍低。"],["夜猎将军忽相访，","鹧鸪惊起绕篱啼。"]]}
{"id":"99750113ad","title":"赠刘景擢第","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湘中才子是刘郎，","望在长沙住桂阳。","昨日鸿都新上第，","五陵年少让清光。"],"stanzas":[["湘中才子是刘郎，","望在长沙住桂阳。"],["昨日鸿都新上第，","五陵年少让清光。"]]}
{"id":"81dcc578ee","title":"赴连山途次德宗山陵寄张员外","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["常时并冕奉天颜，","委佩低簪彩仗间。","今日独来张乐地，","万重云水望桥山。"],"stanzas":[["常时并冕奉天颜，","委佩低簪彩仗间。"],["今日独来张乐地，","万重云水望桥山。"]]}
{"id":"dd40843d69","title":"尝茶","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["生拍芳丛鹰觜芽，","老郎封寄谪仙家。","今宵更有湘江月，","照出菲菲满盌花。"],"stanzas":[["生拍芳丛鹰觜芽，","老郎封寄谪仙家。"],["今宵更有湘江月，","照出菲菲满盌花。"]]}
{"id":"0c8f7bc44c","title":"梁国祠","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梁国三郎威德尊，","女巫箫鼓走乡村。","万家长见空山上，","雨气苍茫生庙门。"],"stanzas":[["梁国三郎威德尊，","女巫箫鼓走乡村。"],["万家长见空山上，","雨气苍茫生庙门。"]]}
{"id":"44012b2dc9","title":"望洞庭","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湖光秋月两相和，","潭面无风镜未磨。","遥望洞庭山水翠，","白银盘里一青螺。"],"stanzas":[["湖光秋月两相和，","潭面无风镜未磨。"],["遥望洞庭山水翠，","白银盘里一青螺。"]]}
{"id":"ef0304c42a","title":"杨柳枝","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春江一曲柳千条，","二十年前旧板桥。","曾与美人桥上别，","恨无消息到今朝。"],"stanzas":[["春江一曲柳千条，","二十年前旧板桥。"],["曾与美人桥上别，","恨无消息到今朝。"]]}
{"id":"2938507e32","title":"楼上","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江上楼高二十梯，","梯梯登徧与云齐。","人从别浦经年去，","天向平芜尽处低。"],"stanzas":[["江上楼高二十梯，","梯梯登徧与云齐。"],["人从别浦经年去，","天向平芜尽处低。"]]}
{"id":"504ef54817","title":"洛滨病卧户部李侍郎见惠药物谑以文星之句斐然仰谢","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["隐几支颐对落晖，","故人书信到柴扉。","周南留滞商山老，","星象如今属少微。"],"stanzas":[["隐几支颐对落晖，","故人书信到柴扉。"],["周南留滞商山老，","星象如今属少微。"]]}
{"id":"1cc8786a11","title":"故洛城古墙","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["粉落椒飞知几春，","风吹雨洒旋成尘。","莫言一片危基在，","犹过无穷来往人。"],"stanzas":[["粉落椒飞知几春，","风吹雨洒旋成尘。"],["莫言一片危基在，","犹过无穷来往人。"]]}
{"id":"1859979070","title":"句","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湖上收宿雨，","故国思如此。","若为天外心，","东屯沧海阔。","南让洞庭宽，","翠粒照晴露。","银花垂院牓，","翠羽撼绦铃。"],"stanzas":[["湖上收宿雨，","故国思如此。"],["若为天外心，","东屯沧海阔。"],["南让洞庭宽，","翠粒照晴露。"],["银花垂院牓，","翠羽撼绦铃。"]]}
{"id":"0027fd99a2","title":"山亭怀古","author":"张弘靖","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丛石依古城，","悬泉洒清池。","高低袤丈内，","衡霍相蔽亏。","归田竟何因，","为郡岂所宜。","谁能辨人野，","寄适聊在斯。"],"stanzas":[["丛石依古城，","悬泉洒清池。"],["高低袤丈内，","衡霍相蔽亏。"],["归田竟何因，","为郡岂所宜。"],["谁能辨人野，","寄适聊在斯。"]]}
{"id":"bf80d44303","title":"和张相公太原山亭怀古诗","author":"韩察","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["公府政多暇，","思与仁智全。","为山想岩穴，","引水听潺湲。","轩冕迹自逸，","尘俗无由牵。","苍生方瞩望，","讵得赋归田。"],"stanzas":[["公府政多暇，","思与仁智全。"],["为山想岩穴，","引水听潺湲。"],["轩冕迹自逸，","尘俗无由牵。"],["苍生方瞩望，","讵得赋归田。"]]}
{"id":"616ecd192f","title":"和张相公太原山亭怀古诗","author":"崔恭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高情乐闲放，","寄迹山水中。","朝霞铺座右，","虚白贮清风。","潜窦激飞泉，","石路跻且崇。","步武有胜概，","不与俗情同。"],"stanzas":[["高情乐闲放，","寄迹山水中。"],["朝霞铺座右，","虚白贮清风。"],["潜窦激飞泉，","石路跻且崇。"],["步武有胜概，","不与俗情同。"]]}
{"id":"e20f8b309e","title":"和张相公太原山亭怀古诗","author":"陆瀍","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["激水泻飞瀑，","寄怀良在兹。","如何谢安石，","要结东山期。","入座兰蕙馥，","当轩松桂滋。","于焉悟幽道，","境寂心自怡。"],"stanzas":[["激水泻飞瀑，","寄怀良在兹。"],["如何谢安石，","要结东山期。"],["入座兰蕙馥，","当轩松桂滋。"],["于焉悟幽道，","境寂心自怡。"]]}
{"id":"f7f8a7d6bb","title":"和张相公太原亭怀古诗","author":"胡[证]","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飞泉天台状，","峭石蓬莱姿。","潺湲与青翠，","咫尺当幽奇。","居然尽精道，","得以书妍词。","岂无他山胜，","懿此清轩墀。"],"stanzas":[["飞泉天台状，","峭石蓬莱姿。"],["潺湲与青翠，","咫尺当幽奇。"],["居然尽精道，","得以书妍词。"],["岂无他山胜，","懿此清轩墀。"]]}
{"id":"d3780f3df0","title":"句","author":"胡[证]","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗书入京国，","旌斾过乡关。"],"stanzas":[["诗书入京国，","旌斾过乡关。"]]}
{"id":"50ce541fed","title":"和太原山亭怀古诗","author":"张贾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中庭起崖谷，","漱玉下涟漪。","丹丘谁云远，","寓象得心期。","岂不贵钟鼎，","至怀在希夷。","唯当蓬莱阁，","灵凤复来仪。"],"stanzas":[["中庭起崖谷，","漱玉下涟漪。"],["丹丘谁云远，","寓象得心期。"],["岂不贵钟鼎，","至怀在希夷。"],["唯当蓬莱阁，","灵凤复来仪。"]]}
{"id":"61fcc7168f","title":"和裴司空答张秘书赠马诗","author":"张贾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阁下从容旧客卿，","寄来骏马赏高情。","任追烟景骑仍醉，","知有文章倚便成。","步步自怜春日影，","萧萧犹起朔风声。","须知上宰吹嘘意，","送入天门上路行。"],"stanzas":[["阁下从容旧客卿，","寄来骏马赏高情。"],["任追烟景骑仍醉，","知有文章倚便成。"],["步步自怜春日影，","萧萧犹起朔风声。"],["须知上宰吹嘘意，","送入天门上路行。"]]}
{"id":"0b84641102","title":"句","author":"张贾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夫子生知者，","相期妙理中。"],"stanzas":[["夫子生知者，","相期妙理中。"]]}
{"id":"683be511a0","title":"吴兴三绝","author":"张文规","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苹洲须觉池沼俗，","苎布直胜罗纨轻。","清风楼下草初出，","明月峡中茶始生。","吴兴三绝不可舍，","劝子强为吴会行。"],"stanzas":[["苹洲须觉池沼俗，","苎布直胜罗纨轻。"],["清风楼下草初出，","明月峡中茶始生。"],["吴兴三绝不可舍，","劝子强为吴会行。"]]}
{"id":"11c5a6ca3a","title":"湖州贡焙新茶","author":"张文规","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤辇寻春半醉回，","僊娥进水御帘开。","牡丹花笑金钿动，","传奏吴兴紫笋来。"],"stanzas":[["凤辇寻春半醉回，","僊娥进水御帘开。"],["牡丹花笑金钿动，","传奏吴兴紫笋来。"]]}
{"id":"d0ebad8ea8","title":"句","author":"张文规","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁云隼旟吏，","长对虎头岩。"],"stanzas":[["谁云隼旟吏，","长对虎头岩。"]]}
{"id":"077e449094","title":"缑山鹤","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["羽客骖仙鹤，","将飞驻碧山。","映松残雪在，","度岭片云还。","清唳因风远，","高姿对水闲。","笙歌忆天上，","城郭叹人间。","几变霜毛洁，","方殊藻质斑。","迢迢烟路逸，","奋翮讵能攀。"],"stanzas":[["羽客骖仙鹤，","将飞驻碧山。"],["映松残雪在，","度岭片云还。"],["清唳因风远，","高姿对水闲。"],["笙歌忆天上，","城郭叹人间。"],["几变霜毛洁，","方殊藻质斑。"],["迢迢烟路逸，","奋翮讵能攀。"]]}
{"id":"f9bc754608","title":"夜闻洛滨吹笙","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["王子千年后，","笙音五夜闻。","逶迤绕清洛，","断续下仙云。","泄泄飘难定，","啾啾曲未分。","松风助幽律，","波月动轻文。","凤管听何远，","鸾声若在群。","暗空思羽盖，","余气自氛氲。"],"stanzas":[["王子千年后，","笙音五夜闻。"],["逶迤绕清洛，","断续下仙云。"],["泄泄飘难定，","啾啾曲未分。"],["松风助幽律，","波月动轻文。"],["凤管听何远，","鸾声若在群。"],["暗空思羽盖，","余气自氛氲。"]]}
{"id":"1452213223","title":"上元日听太清宫步虚","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙客开金箓，","元辰会玉京。","灵歌宾紫府，","雅韵出层城。","磬杂音徐彻，","风飘响更清。","纡余空外尽，","断续听中生。","舞鹤纷将集，","流云住未行。","谁知九陌上，","尘俗仰遗声。"],"stanzas":[["仙客开金箓，","元辰会玉京。"],["灵歌宾紫府，","雅韵出层城。"],["磬杂音徐彻，","风飘响更清。"],["纡余空外尽，","断续听中生。"],["舞鹤纷将集，","流云住未行。"],["谁知九陌上，","尘俗仰遗声。"]]}
{"id":"09d8889404","title":"玉绳低建章","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["迢迢玉绳下，","芒彩正阑干。","稍复临鳷鹊，","方疑近露寒。","微明连粉堞，","的皪映仙盘。","横接河流照，","低将夜色残。","天榆随影没，","宫树与光攒。","遐想西垣客，","长吟欲罢难。"],"stanzas":[["迢迢玉绳下，","芒彩正阑干。"],["稍复临鳷鹊，","方疑近露寒。"],["微明连粉堞，","的皪映仙盘。"],["横接河流照，","低将夜色残。"],["天榆随影没，","宫树与光攒。"],["遐想西垣客，","长吟欲罢难。"]]}
{"id":"60a6996700","title":"寒云轻重色","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳期当可许，","托思望云端。","鳞影朝犹落，","繁阴暮自寒。","因风方袅袅，","间石已漫漫。","隐映看鸿度，","霏微觉树攒。","凝空多似黛，","引素乍如纨。","每向愁中览，","含毫欲状难。"],"stanzas":[["佳期当可许，","托思望云端。"],["鳞影朝犹落，","繁阴暮自寒。"],["因风方袅袅，","间石已漫漫。"],["隐映看鸿度，","霏微觉树攒。"],["凝空多似黛，","引素乍如纨。"],["每向愁中览，","含毫欲状难。"]]}
{"id":"867f5e51a9","title":"圣明乐","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九陌祥烟合，","千春瑞月明。","宫花将苑柳，","先发凤皇城。"],"stanzas":[["九陌祥烟合，","千春瑞月明。"],["宫花将苑柳，","先发凤皇城。"]]}
{"id":"fab429b39c","title":"献寿词","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉帛殊方至，","歌钟比屋闻。","华夷今一贯，","同贺圣朝君。"],"stanzas":[["玉帛殊方至，","歌钟比屋闻。"],["华夷今一贯，","同贺圣朝君。"]]}
{"id":"0669de6831","title":"宫中乐五首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["网户交如绮，","纱窗薄似烟。","乐吹天上曲，","人是月中仙。"],"stanzas":[["网户交如绮，","纱窗薄似烟。"],["乐吹天上曲，","人是月中仙。"]]}
{"id":"ea01507f29","title":"宫中乐五首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠匣开寒镜，","珠钗挂步摇。","妆成祗畏晓，","更漏促春宵。"],"stanzas":[["翠匣开寒镜，","珠钗挂步摇。"],["妆成祗畏晓，","更漏促春宵。"]]}
{"id":"fab49b7aa2","title":"宫中乐五首 三","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红果瑶池实，","金盘露井冰。","甘泉将避暑，","台殿晓光凝。"],"stanzas":[["红果瑶池实，","金盘露井冰。"],["甘泉将避暑，","台殿晓光凝。"]]}
{"id":"9c037c281c","title":"宫中乐五首 四","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月采浮鸾殿，","砧声隔凤楼。","笙歌临水槛，","红烛乍迎秋。"],"stanzas":[["月采浮鸾殿，","砧声隔凤楼。"],["笙歌临水槛，","红烛乍迎秋。"]]}
{"id":"4f6259e84c","title":"宫中乐五首 五","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["奇树留寒翠，","神池结夕波。","黄山一夜雪，","渭水泻声多。"],"stanzas":[["奇树留寒翠，","神池结夕波。"],["黄山一夜雪，","渭水泻声多。"]]}
{"id":"8d6922e153","title":"春游曲三首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟柳飞轻絮，","风榆落小钱。","蒙蒙百花里，","罗绮竞秋千。"],"stanzas":[["烟柳飞轻絮，","风榆落小钱。"],["蒙蒙百花里，","罗绮竞秋千。"]]}
{"id":"5f6979cac6","title":"春游曲三首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["骋望登香阁，","争高下砌台。","林间踏青去，","席上寄牋来。"],"stanzas":[["骋望登香阁，","争高下砌台。"],["林间踏青去，","席上寄牋来。"]]}
{"id":"4dfef8e3e7","title":"春游曲三首 三","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行乐三春节，","林花百和香。","当年重意气，","先占鬬鸡场。"],"stanzas":[["行乐三春节，","林花百和香。"],["当年重意气，","先占鬬鸡场。"]]}
{"id":"181308f5e4","title":"春闺思","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["袅袅城边柳，","青青陌上桑。","提笼忘采叶，","昨夜梦渔阳。"],"stanzas":[["袅袅城边柳，","青青陌上桑。"],["提笼忘采叶，","昨夜梦渔阳。"]]}
{"id":"9dd241381a","title":"春江曲二首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家寄征河岸，","征人几岁游。","不如潮水信，","每日到沙头。"],"stanzas":[["家寄征河岸，","征人几岁游。"],["不如潮水信，","每日到沙头。"]]}
{"id":"d431e65f7e","title":"春江曲二首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乘晓南湖去，","参差叠浪横。","前洲在何处，","霜里鴈嘤嘤。"],"stanzas":[["乘晓南湖去，","参差叠浪横。"],["前洲在何处，","霜里鴈嘤嘤。"]]}
{"id":"b8242715d6","title":"太平词","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣德超千古，","皇威静四方。","苍生今息战，","无事觉时良。"],"stanzas":[["圣德超千古，","皇威静四方。"],["苍生今息战，","无事觉时良。"]]}
{"id":"7ff0215f07","title":"陇上行","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行到黄云陇，","唯闻羌戍鼙。","不如山下水，","犹得任东西。"],"stanzas":[["行到黄云陇，","唯闻羌戍鼙。"],["不如山下水，","犹得任东西。"]]}
{"id":"cdd568020e","title":"思君恩","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫禁香如雾，","青天月似霜。","云韶何处奏，","祗是在朝阳。"],"stanzas":[["紫禁香如雾，","青天月似霜。"],["云韶何处奏，","祗是在朝阳。"]]}
{"id":"819ce118f9","title":"王昭君","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙娥今下嫁，","骄子自同和。","劒戟归田尽，","牛羊绕塞多。"],"stanzas":[["仙娥今下嫁，","骄子自同和。"],["劒戟归田尽，","牛羊绕塞多。"]]}
{"id":"4e1976872a","title":"秋夜曲","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丁丁漏水夜何长，","漫漫轻云露月光。","秋逼暗虫通夕响，","征衣未寄莫飞霜。"],"stanzas":[["丁丁漏水夜何长，","漫漫轻云露月光。"],["秋逼暗虫通夕响，","征衣未寄莫飞霜。"]]}
{"id":"310ca5746b","title":"秋思赠远","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["博山沉燎绝余香，","兰烬金檠怨夜长。","为问青青河畔草，","几回经雨复经霜。"],"stanzas":[["博山沉燎绝余香，","兰烬金檠怨夜长。"],["为问青青河畔草，","几回经雨复经霜。"]]}
{"id":"aca2272494","title":"塞上曲","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卷斾生风喜气新，","早持龙节静边尘。","汉家天子图麟阁，","身是当今第一人。"],"stanzas":[["卷斾生风喜气新，","早持龙节静边尘。"],["汉家天子图麟阁，","身是当今第一人。"]]}
{"id":"c4d2791c4b","title":"塞下曲五首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三戍渔阳再渡辽，","骍弓在臂劒横腰。","匈奴似若知名姓，","休傍阴山更射雕。"],"stanzas":[["三戍渔阳再渡辽，","骍弓在臂劒横腰。"],["匈奴似若知名姓，","休傍阴山更射雕。"]]}
{"id":"9bee81493d","title":"塞下曲五首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猎马千行鴈几双，","燕然山下碧油幢。","传声漠北单于破，","火照旌旗夜受降。"],"stanzas":[["猎马千行鴈几双，","燕然山下碧油幢。"],["传声漠北单于破，","火照旌旗夜受降。"]]}
{"id":"aade9704e3","title":"塞下曲五首 三","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朔雪飘飘开鴈门，","平沙历乱卷蓬根。","功名耻计擒生数，","直斩楼兰报国恩。"],"stanzas":[["朔雪飘飘开鴈门，","平沙历乱卷蓬根。"],["功名耻计擒生数，","直斩楼兰报国恩。"]]}
{"id":"08791a27fb","title":"塞下曲五首 四","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陇水潺湲陇树秋，","征人到此泪双流。","乡关万里无因见，","西戍河源早晚休。"],"stanzas":[["陇水潺湲陇树秋，","征人到此泪双流。"],["乡关万里无因见，","西戍河源早晚休。"]]}
{"id":"b8bba4ee0c","title":"塞下曲五首 五","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阴碛茫茫塞草肥，","桔槔烽上暮云飞。","交河北望天连海，","苏武曾将汉节归。"],"stanzas":[["阴碛茫茫塞草肥，","桔槔烽上暮云飞。"],["交河北望天连海，","苏武曾将汉节归。"]]}
{"id":"ff70d19b4f","title":"秋思二首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧窗斜日蔼深晖，","愁听寒螀泪湿衣。","梦里分明见关塞，","不知何路向金微。"],"stanzas":[["碧窗斜日蔼深晖，","愁听寒螀泪湿衣。"],["梦里分明见关塞，","不知何路向金微。"]]}
{"id":"a47d938ba5","title":"秋思二首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋天一夜静无云，","断续鸿声到晓闻。","欲寄征衣问消息，","居延城外又移军。"],"stanzas":[["秋天一夜静无云，","断续鸿声到晓闻。"],["欲寄征衣问消息，","居延城外又移军。"]]}
{"id":"9b4adad19e","title":"汉苑行二首","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回鴈高飞太液池，","新花低发上林枝。","年光到处皆堪赏，","春色人间总不知。"],"stanzas":[["回鴈高飞太液池，","新花低发上林枝。"],["年光到处皆堪赏，","春色人间总不知。"]]}
{"id":"5d3b99a38b","title":"汉苑行二首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风淡荡景悠悠，","莺啭高枝燕入楼。","千步回廊闻凤吹，","珠帘处处上银钩。"],"stanzas":[["春风淡荡景悠悠，","莺啭高枝燕入楼。"],["千步回廊闻凤吹，","珠帘处处上银钩。"]]}
{"id":"d528646656","title":"天马辞二首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天马初从渥水来，","郊歌曾唱得龙媒。","不知玉塞沙中路，","苜蓿残花几处开。"],"stanzas":[["天马初从渥水来，","郊歌曾唱得龙媒。"],["不知玉塞沙中路，","苜蓿残花几处开。"]]}
{"id":"3fa7c38c5c","title":"天马辞二首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["躞蹀宛驹齿未齐，","摐金喷玉向风嘶。","来时欲尽金河道，","猎猎轻风在碧蹄。"],"stanzas":[["躞蹀宛驹齿未齐，","摐金喷玉向风嘶。"],["来时欲尽金河道，","猎猎轻风在碧蹄。"]]}
{"id":"73b522599b","title":"燕子楼诗三首 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼上残灯伴晓霜，","独眠人起合欢床。","相思一夜情多少，","地角天涯不是长。"],"stanzas":[["楼上残灯伴晓霜，","独眠人起合欢床。"],["相思一夜情多少，","地角天涯不是长。"]]}
{"id":"04db6fd4ec","title":"燕子楼诗三首 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北邙松栢锁愁烟，","燕子楼人思悄然。","自埋劒履歌尘散，","红袖香消已十年。"],"stanzas":[["北邙松栢锁愁烟，","燕子楼人思悄然。"],["自埋劒履歌尘散，","红袖香消已十年。"]]}
{"id":"456cc4dab2","title":"燕子楼诗三首 三","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["适看鸿鴈岳阳回，","又覩玄禽逼社来。","瑶瑟玉箫无意绪，","任从蛛网任从灰。"],"stanzas":[["适看鸿鴈岳阳回，","又覩玄禽逼社来。"],["瑶瑟玉箫无意绪，","任从蛛网任从灰。"]]}
{"id":"c85711c1b6","title":"赋得冬日可爱","author":"庾承宣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宿雾开天霁，","寒郊见初日。","林疎照逾远，","冰轻影微出。","岂假阳和气，","暂忘玄冬律。","愁抱望自宽，","羁情就如失。","欣欣事几许，","曈曈状非一。","倾心倘知期，","良愿自兹毕。"],"stanzas":[["宿雾开天霁，","寒郊见初日。"],["林疎照逾远，","冰轻影微出。"],["岂假阳和气，","暂忘玄冬律。"],["愁抱望自宽，","羁情就如失。"],["欣欣事几许，","曈曈状非一。"],["倾心倘知期，","良愿自兹毕。"]]}
{"id":"6ffa19ad5d","title":"赠毛仙翁","author":"郑澣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至道无名，","至人长生。","爰观绘事，","以挹真形。","方口渥丹，","浓眉刷青。","松姿本秀，","鹤质自轻。","道德神仙，","内蕴心灵。","红肌丝发，","外彰华精。","色如含芳，","貌若和光。","胚浑造化，","含吐阴阳。","吾闻安期，","隐见不常。","或在世间，","或游上苍。","猗欤真人，","得非后身。","写此仙骨，","久而不磷。","皎皎明眸，","了然如新。","蔼蔼童颜，","的然如春。","金石可并，","丹青不冺。","通天台上，","有见常人。","俗士观瞻，","方悟幽尘。","君子图之，","敬兮如神。"],"stanzas":[["至道无名，","至人长生。"],["爰观绘事，","以挹真形。"],["方口渥丹，","浓眉刷青。"],["松姿本秀，","鹤质自轻。"],["道德神仙，","内蕴心灵。"],["红肌丝发，","外彰华精。"],["色如含芳，","貌若和光。"],["胚浑造化，","含吐阴阳。"],["吾闻安期，","隐见不常。"],["或在世间，","或游上苍。"],["猗欤真人，","得非后身。"],["写此仙骨，","久而不磷。"],["皎皎明眸，","了然如新。"],["蔼蔼童颜，","的然如春。"],["金石可并，","丹青不冺。"],["通天台上，","有见常人。"],["俗士观瞻，","方悟幽尘。"],["君子图之，","敬兮如神。"]]}
{"id":"61f41ebf25","title":"和李德裕游汉州房公湖二首 一","author":"郑澣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太尉留琴地，","时移重可寻。","徽弦一掩抑，","风月助登临。","荣驻青油骑，","高张白雪音。","秖言酬唱美，","良史记王箴。"],"stanzas":[["太尉留琴地，","时移重可寻。"],["徽弦一掩抑，","风月助登临。"],["荣驻青油骑，","高张白雪音。"],["秖言酬唱美，","良史记王箴。"]]}
{"id":"32f1a363be","title":"和李德裕游汉州房公湖二首 二","author":"郑澣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["静对烟波夕，","犹思栋宇青。","卧龙空有处，","驯鸟独忘情。","顾步襟期远，","参差物象横。","自宜雕乐石，","爽气际青城。"],"stanzas":[["静对烟波夕，","犹思栋宇青。"],["卧龙空有处，","驯鸟独忘情。"],["顾步襟期远，","参差物象横。"],["自宜雕乐石，","爽气际青城。"]]}
{"id":"fc3336cea2","title":"中书相公任兵部侍郎日后阁植四松逾数年澣忝此官因献拙什","author":"郑澣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丞相当时植，","幽襟对此开。","人知舟檝器，","天假栋梁材。","错落龙鳞出，","䙰褷鹤翅回。","重阴罗武库，","细响静山台。","得地公堂里，","移根涧水隈。","吴臣梦寐远，","秦岳岁年摧。","转觉飞缨缪，","何因继组来。","几寻珠履迹，","愿比角弓培。","栢悦犹依社，","星高久照台。","后凋应共操，","无复问良媒。"],"stanzas":[["丞相当时植，","幽襟对此开。"],["人知舟檝器，","天假栋梁材。"],["错落龙鳞出，","䙰褷鹤翅回。"],["重阴罗武库，","细响静山台。"],["得地公堂里，","移根涧水隈。"],["吴臣梦寐远，","秦岳岁年摧。"],["转觉飞缨缪，","何因继组来。"],["几寻珠履迹，","愿比角弓培。"],["栢悦犹依社，","星高久照台。"],["后凋应共操，","无复问良媒。"]]}
{"id":"2a4f705839","title":"和李德裕房公旧竹亭闻琴","author":"郑澣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石室寒飙惊，","孙枝雅器裁。","坐来山水操，","玄断吊遗埃。"],"stanzas":[["石室寒飙惊，","孙枝雅器裁。"],["坐来山水操，","玄断吊遗埃。"]]}
{"id":"72d2153010","title":"句","author":"郑澣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但虑彩色污，","无虞臂胛肥。"],"stanzas":[["但虑彩色污，","无虞臂胛肥。"]]}
{"id":"b1a470211a","title":"游栖霞寺","author":"张汇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["跻险入幽林，","翠微含竹殿。","泉声无休歇，","山色时隐见。","潮来杂风雨，","梅落成霜霰。","一从方外游，","顿觉尘心变。"],"stanzas":[["跻险入幽林，","翠微含竹殿。"],["泉声无休歇，","山色时隐见。"],["潮来杂风雨，","梅落成霜霰。"],["一从方外游，","顿觉尘心变。"]]}
{"id":"d965574b27","title":"春风扇微和","author":"张汇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["木德生和气，","微微入曙风。","暗催南向叶，","渐翥北归鸿。","澹荡侵冰谷，","悠扬转蕙丛。","拂尘回广路，","泛籁过遥空。","暖上烟光际，","云移律侯中。","扶摇如可借，","从此戾苍穹。"],"stanzas":[["木德生和气，","微微入曙风。"],["暗催南向叶，","渐翥北归鸿。"],["澹荡侵冰谷，","悠扬转蕙丛。"],["拂尘回广路，","泛籁过遥空。"],["暖上烟光际，","云移律侯中。"],["扶摇如可借，","从此戾苍穹。"]]}
{"id":"8b83375f58","title":"观藏冰","author":"张汇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒气方穷律，","阴精正结冰。","体坚风带壮，","影素月临凝。","冬赋凌人掌，","春期命妇升。","凿来壶色彻，","纳处镜光澄。","鲁史曾留问，","幽诗旧见称。","同观里射享，","王道颂还兴。"],"stanzas":[["寒气方穷律，","阴精正结冰。"],["体坚风带壮，","影素月临凝。"],["冬赋凌人掌，","春期命妇升。"],["凿来壶色彻，","纳处镜光澄。"],["鲁史曾留问，","幽诗旧见称。"],["同观里射享，","王道颂还兴。"]]}
{"id":"d91eda51df","title":"赋得春风扇微和","author":"张汇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["习习和风扇，","悠悠淑气微。","阳升知候改，","律应喜春归。","池柳晴初拆，","林莺暖欲飞。","川原浮彩翠，","台馆动光辉。","泛艳摇丹阙，","扬芳入粉闱。","发生当有分，","枯朽幸因依。"],"stanzas":[["习习和风扇，","悠悠淑气微。"],["阳升知候改，","律应喜春归。"],["池柳晴初拆，","林莺暖欲飞。"],["川原浮彩翠，","台馆动光辉。"],["泛艳摇丹阙，","扬芳入粉闱。"],["发生当有分，","枯朽幸因依。"]]}
{"id":"5e4d3257e8","title":"金谷园怀古","author":"张汇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["缓步洛城下，","轸怀金谷园。","昔人随水逝，","旧树逐春繁。","冉冉摇风弱，","菲菲裛露翻。","歌台岂易见，","舞袖乍如存。","戏蝶香中起，","流莺暗处喧。","徒闻施锦帐，","此地拥行轩。"],"stanzas":[["缓步洛城下，","轸怀金谷园。"],["昔人随水逝，","旧树逐春繁。"],["冉冉摇风弱，","菲菲裛露翻。"],["歌台岂易见，","舞袖乍如存。"],["戏蝶香中起，","流莺暗处喧。"],["徒闻施锦帐，","此地拥行轩。"]]}
{"id":"08572de139","title":"句","author":"张汇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["应念路傍憔悴翼，","昔年乔木幸同迁。"],"stanzas":[["应念路傍憔悴翼，","昔年乔木幸同迁。"]]}
{"id":"228541f264","title":"立春日晓望三素云","author":"李应","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玄鸟初来日，","灵仙望里分。","冰容朝上界，","玉辇拥朝云。","碧落流轻艳，","红霓间彩文。","带烟时缥缈，","向斗更氤氲。","髣髴随风驭，","迢遥出晓雰。","兹辰三见后，","希得从元君。"],"stanzas":[["玄鸟初来日，","灵仙望里分。"],["冰容朝上界，","玉辇拥朝云。"],["碧落流轻艳，","红霓间彩文。"],["带烟时缥缈，","向斗更氤氲。"],["髣髴随风驭，","迢遥出晓雰。"],["兹辰三见后，","希得从元君。"]]}
{"id":"00bccfe95b","title":"立春日晓望三素云","author":"陈师穆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晴晓初春日，","高心望素云。","彩光浮玉辇，","紫气隐元君。","缥缈中天去，","逍遥上界分。","鸾骖攀不及，","仙吹远难闻。","礼候于斯覩，","明循在解纷。","人归悬想处，","霞色自氛氲。"],"stanzas":[["晴晓初春日，","高心望素云。"],["彩光浮玉辇，","紫气隐元君。"],["缥缈中天去，","逍遥上界分。"],["鸾骖攀不及，","仙吹远难闻。"],["礼候于斯覩，","明循在解纷。"],["人归悬想处，","霞色自氛氲。"]]}
{"id":"c9d04abc27","title":"立春日晓望三素云","author":"李季何","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霭霭青春曙，","飞仙驾五云。","浮轮初缥缈，","承盖下氤氲。","薄影随风度，","殊容向日分。","羽毛纷共远，","环佩杳犹闻。","静合烟霞色，","遥将鸾鹤群。","年年瞻此节，","应许从元君。"],"stanzas":[["霭霭青春曙，","飞仙驾五云。"],["浮轮初缥缈，","承盖下氤氲。"],["薄影随风度，","殊容向日分。"],["羽毛纷共远，","环佩杳犹闻。"],["静合烟霞色，","遥将鸾鹤群。"],["年年瞻此节，","应许从元君。"]]}
{"id":"e031757a92","title":"春台晴望","author":"李程","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曲台送春目，","景物丽新晴。","霭霭烟收翠，","忻忻木向荣。","静看迟日上，","闲爱野云平。","风慢游丝转，","天开远水明。","登高尘虑息，","观徼道心清。","更有迁乔意，","翩翩出谷莺。"],"stanzas":[["曲台送春目，","景物丽新晴。"],["霭霭烟收翠，","忻忻木向荣。"],["静看迟日上，","闲爱野云平。"],["风慢游丝转，","天开远水明。"],["登高尘虑息，","观徼道心清。"],["更有迁乔意，","翩翩出谷莺。"]]}
{"id":"8e5556d1ff","title":"玉壶冰","author":"李程","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琢玉性惟坚，","成壶体更圆。","虚心含众象，","应物受寒泉。","温润资天质，","清贞禀自然。","日融光乍散，","雪照色逾鲜。","至鉴功宁宰，","无私照岂偏。","明将水镜对，","白与粉闱连。","拂拭终为美，","提携伫见传。","勿令毫发累，","遗恨鲍公篇。"],"stanzas":[["琢玉性惟坚，","成壶体更圆。"],["虚心含众象，","应物受寒泉。"],["温润资天质，","清贞禀自然。"],["日融光乍散，","雪照色逾鲜。"],["至鉴功宁宰，","无私照岂偏。"],["明将水镜对，","白与粉闱连。"],["拂拭终为美，","提携伫见传。"],["勿令毫发累，","遗恨鲍公篇。"]]}
{"id":"7c7d7084cd","title":"赋得竹箭有筠","author":"李程","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["常爱凌寒竹，","坚贞可喻人。","能将先进礼，","义与后凋邻。","冉冉犹全节，","青青尚有筠。","陶钧二仪内，","柯叶四时春。","待凤花仍吐，","停霜色更新。","方持不易操，","对此欲观身。"],"stanzas":[["常爱凌寒竹，","坚贞可喻人。"],["能将先进礼，","义与后凋邻。"],["冉冉犹全节，","青青尚有筠。"],["陶钧二仪内，","柯叶四时春。"],["待凤花仍吐，","停霜色更新。"],["方持不易操，","对此欲观身。"]]}
{"id":"110fa0c8b8","title":"观庆云图","author":"李程","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五云从表瑞，","藻绘宛成图。","柯叶何时改，","丹青此不渝。","非烟色尚丽，","似盖状应殊。","渥彩看犹在，","轻阴望已无。","方将遇翠幄，","那羡起苍梧。","欲识从龙处，","今逢圣合符。"],"stanzas":[["五云从表瑞，","藻绘宛成图。"],["柯叶何时改，","丹青此不渝。"],["非烟色尚丽，","似盖状应殊。"],["渥彩看犹在，","轻阴望已无。"],["方将遇翠幄，","那羡起苍梧。"],["欲识从龙处，","今逢圣合符。"]]}
{"id":"8f6351d5f4","title":"赠毛仙翁","author":"李程","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茫茫尘累愧腥膻，","强把蜉蝣望列仙。","闲指紫霄峰下路，","却归白鹿洞中天。","吹箫凤去经何代，","茹玉方传得几年。","他日更来人世看，","又应东海变桑田。"],"stanzas":[["茫茫尘累愧腥膻，","强把蜉蝣望列仙。"],["闲指紫霄峰下路，","却归白鹿洞中天。"],["吹箫凤去经何代，","茹玉方传得几年。"],["他日更来人世看，","又应东海变桑田。"]]}
{"id":"70ec941822","title":"省试春台晴望","author":"高弁","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["层台聊一望，","遍赏帝城春。","风煖闻啼鸟，","冰开见跃鳞。","晴山烟外翠，","香蘂日边新。","已变青门柳，","初销紫陌尘。","金汤千里国，","车骑万方人。","此处云霄近，","凭高愿致身。"],"stanzas":[["层台聊一望，","遍赏帝城春。"],["风煖闻啼鸟，","冰开见跃鳞。"],["晴山烟外翠，","香蘂日边新。"],["已变青门柳，","初销紫陌尘。"],["金汤千里国，","车骑万方人。"],["此处云霄近，","凭高愿致身。"]]}
{"id":"1b681ae80a","title":"霜菊","author":"席夔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["时令忽已变，","行看被霜菊。","可怜后时秀，","当此凛风肃。","淅沥翠枝翻，","凄清金蘂馥。","凝姿节堪重，","澄艳景非淑。","宁祛青女威，","愿盈君子掬。","持来泛罇酒，","永以照幽独。"],"stanzas":[["时令忽已变，","行看被霜菊。"],["可怜后时秀，","当此凛风肃。"],["淅沥翠枝翻，","凄清金蘂馥。"],["凝姿节堪重，","澄艳景非淑。"],["宁祛青女威，","愿盈君子掬。"],["持来泛罇酒，","永以照幽独。"]]}
{"id":"6b5191102f","title":"赋得竹箭有筠","author":"席夔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共爱东南美，","青青叹有筠。","贞姿众木异，","秀色四时均。","枝叶当无改，","风霜岂惮频。","虚心如待物，","劲节自留春。","鲜润期栖凤，","婵娟可并人。","可怜初箨卷，","粉泽更宜新。"],"stanzas":[["共爱东南美，","青青叹有筠。"],["贞姿众木异，","秀色四时均。"],["枝叶当无改，","风霜岂惮频。"],["虚心如待物，","劲节自留春。"],["鲜润期栖凤，","婵娟可并人。"],["可怜初箨卷，","粉泽更宜新。"]]}
{"id":"68c0689e10","title":"省试观庆云图","author":"李行敏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["缣素传休祉，","丹青状庆云。","非烟凝漠漠，","似盖乍纷纷。","尚驻从龙意，","全舒捧日文。","光因五色起，","影向九霄分。","裂素观嘉瑞，","披图贺圣君。","宁同窥汗漫，","方此覩氛氲。"],"stanzas":[["缣素传休祉，","丹青状庆云。"],["非烟凝漠漠，","似盖乍纷纷。"],["尚驻从龙意，","全舒捧日文。"],["光因五色起，","影向九霄分。"],["裂素观嘉瑞，","披图贺圣君。"],["宁同窥汗漫，","方此覩氛氲。"]]}
{"id":"fd125ae1c6","title":"赋得冬日可爱","author":"陈讽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒日临清昼，","寥天一望时。","未消埋径雪，","先暖读书帷。","属思光难驻，","舒情影若遗。","晋臣曾比德，","谢客昔言诗。","散彩宁偏照，","流阴信不追。","余辉如可就，","回烛幸无私。"],"stanzas":[["寒日临清昼，","寥天一望时。"],["未消埋径雪，","先暖读书帷。"],["属思光难驻，","舒情影若遗。"],["晋臣曾比德，","谢客昔言诗。"],["散彩宁偏照，","流阴信不追。"],["余辉如可就，","回烛幸无私。"]]}
{"id":"b3056dfec3","title":"郡斋三月下旬作","author":"崔护","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春事日已歇，","池塘旷幽寻。","残红披独坠，","嫩绿间浅深。","偃仰卷芳褥，","顾步爱新阴。","谋春未及竟，","夏初遽见侵。"],"stanzas":[["春事日已歇，","池塘旷幽寻。"],["残红披独坠，","嫩绿间浅深。"],["偃仰卷芳褥，","顾步爱新阴。"],["谋春未及竟，","夏初遽见侵。"]]}
{"id":"91c803fa01","title":"五月水边柳","author":"崔护","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["结根挺涯涘，","垂影覆清浅。","睡脸寒未开，","嬾腰晴更软。","摇空条已重，","拂水带方展。","似醉烟景凝，","如愁月露泫。","丝长鱼悮恐，","枝弱禽惊践。","长别几多情，","含春任攀搴。"],"stanzas":[["结根挺涯涘，","垂影覆清浅。"],["睡脸寒未开，","嬾腰晴更软。"],["摇空条已重，","拂水带方展。"],["似醉烟景凝，","如愁月露泫。"],["丝长鱼悮恐，","枝弱禽惊践。"],["长别几多情，","含春任攀搴。"]]}
{"id":"bb32e0d79c","title":"三月五日陪裴大夫泛长沙东湖","author":"崔护","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上巳余风景，","芳辰集远坰。","彩舟浮泛荡，","绣毂下娉婷。","林树回葱蒨，","笙歌入杳冥。","湖光迷翡翠，","草色醉蜻蜓。","鸟弄桐花日，","鱼翻谷雨萍。","从今留胜会，","谁看画兰亭。"],"stanzas":[["上巳余风景，","芳辰集远坰。"],["彩舟浮泛荡，","绣毂下娉婷。"],["林树回葱蒨，","笙歌入杳冥。"],["湖光迷翡翠，","草色醉蜻蜓。"],["鸟弄桐花日，","鱼翻谷雨萍。"],["从今留胜会，","谁看画兰亭。"]]}
{"id":"e3eab05673","title":"山鸡舞石镜","author":"崔护","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庐峰开石镜，","人说舞山鸡。","物象纤舞隐，","禽情秖自迷。","景当烟雾歇，","心喜锦翎齐。","宛转乌呈彩，","婆娑凤欲栖。","何言资羽族，","在地得天倪。","应笑翰音者，","终朝饮败醯。"],"stanzas":[["庐峰开石镜，","人说舞山鸡。"],["物象纤舞隐，","禽情秖自迷。"],["景当烟雾歇，","心喜锦翎齐。"],["宛转乌呈彩，","婆娑凤欲栖。"],["何言资羽族，","在地得天倪。"],["应笑翰音者，","终朝饮败醯。"]]}
{"id":"0136ef6cf5","title":"题都城南庄","author":"崔护","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去年今日此门中，","人面桃花相映红。","人面不知何处在，","桃花依旧笑春风。"],"stanzas":[["去年今日此门中，","人面桃花相映红。"],["人面不知何处在，","桃花依旧笑春风。"]]}
{"id":"d78c0c8bca","title":"晚鸡","author":"崔护","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黯黯严城罢鼓鼙，","数声相续出寒栖。","不嫌惊破纱窗梦，","却恐为奴半夜啼。"],"stanzas":[["黯黯严城罢鼓鼙，","数声相续出寒栖。"],["不嫌惊破纱窗梦，","却恐为奴半夜啼。"]]}
{"id":"01bcd8cf3b","title":"赠药山高僧惟俨二首 一","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["练得身形似鹤形，","千株松下两函经。","我来问道无余说，","云在青霄水在瓶。"],"stanzas":[["练得身形似鹤形，","千株松下两函经。"],["我来问道无余说，","云在青霄水在瓶。"]]}
{"id":"eeae0fdb27","title":"赠药山高僧惟俨二首 二","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["选得幽居惬野情，","终年无送亦无迎。","有时直上孤峰顶，","月下披云啸一声。"],"stanzas":[["选得幽居惬野情，","终年无送亦无迎。"],["有时直上孤峰顶，","月下披云啸一声。"]]}
{"id":"7f3fa9f538","title":"赠毛仙翁","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫霄仙客下三山，","因救生灵到世间。","龟鹤计年承甲子，","冰霜为质驻童颜。","韬藏休咎传真箓，","变化荣枯试小还。","从此便教尘骨贵，","九霄云路愿追攀。"],"stanzas":[["紫霄仙客下三山，","因救生灵到世间。"],["龟鹤计年承甲子，","冰霜为质驻童颜。"],["韬藏休咎传真箓，","变化荣枯试小还。"],["从此便教尘骨贵，","九霄云路愿追攀。"]]}
{"id":"244a772385","title":"拜禹歌","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惟天地之无穷兮，","哀生人之常勤。","往者吾弗及兮，","来者吾弗闻。","已而，","已而。"],"stanzas":[["惟天地之无穷兮，","哀生人之常勤。"],["往者吾弗及兮，","来者吾弗闻。"],["已而，","已而。"]]}
{"id":"7bb4ff3c3e","title":"广庆寺","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["传者不足信，","见景胜如闻。","一水远赴海，","两山高入云。","鱼龙晴自戏，","猿狖晚成群。","醉酒斜阳下，","离心草自薰。"],"stanzas":[["传者不足信，","见景胜如闻。"],["一水远赴海，","两山高入云。"],["鱼龙晴自戏，","猿狖晚成群。"],["醉酒斜阳下，","离心草自薰。"]]}
{"id":"d97aaafff7","title":"奉酬刘言史宴光风亭","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闰余春早景沈沈，","禊饮风亭恣赏心。","红袖青娥留永夕，","汉阴宁肯羡山阴。"],"stanzas":[["闰余春早景沈沈，","禊饮风亭恣赏心。"],["红袖青娥留永夕，","汉阴宁肯羡山阴。"]]}
{"id":"1e37d91acb","title":"戏赠诗","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["县君好砖渠，","绕水恣行游。","鄙性乐疎野，","凿地便成沟。","两岸值芳草，","中央漾清流。","所尚既不同，","砖凿可自修。","从他后人见，","境趣谁为幽。"],"stanzas":[["县君好砖渠，","绕水恣行游。"],["鄙性乐疎野，","凿地便成沟。"],["两岸值芳草，","中央漾清流。"],["所尚既不同，","砖凿可自修。"],["从他后人见，","境趣谁为幽。"]]}
{"id":"6dc8433df3","title":"题浯溪石","author":"皇甫湜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["次山有文章，","可惋只在碎。","然长于指叙，","约洁有余态。","心语适相应，","出句多分外。","于诸作者间，","拔戟成一队。","中行虽富剧，","粹美若可盖。","子昂感遇佳，","未若君雅裁。","退之全而神，","上与千载对。","李杜才海翻，","高下非可概。","文与一气间，","为物莫与大。","先王路不荒，","岂不仰吾辈。","石屏立衙衙，","溪口扬素濑。","我思何人知，","徙倚如有待。"],"stanzas":[["次山有文章，","可惋只在碎。"],["然长于指叙，","约洁有余态。"],["心语适相应，","出句多分外。"],["于诸作者间，","拔戟成一队。"],["中行虽富剧，","粹美若可盖。"],["子昂感遇佳，","未若君雅裁。"],["退之全而神，","上与千载对。"],["李杜才海翻，","高下非可概。"],["文与一气间，","为物莫与大。"],["先王路不荒，","岂不仰吾辈。"],["石屏立衙衙，","溪口扬素濑。"],["我思何人知，","徙倚如有待。"]]}
{"id":"03d0eeefe2","title":"石佛谷","author":"皇甫湜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["[澶漫]太行北，","千里一块石。","平腹有壑谷，","深广数百尺。","土僧何为者，","老草毛发白。","寝处容身龛，","足膝隐成迹。","金僊琢灵象，","相好倚北壁。","花座五云扶，","玉豪六虚射。","文人留纪述，","时事可辨析。","鸟迹巧均分，","龙骸极癯瘠。","枯松间槎枿，","猛兽恣腾掷。","蛣𧎜虫食纵，","悬垂露凝滴。","精艺贯古今，","穷岩谁爱惜。","托师禅诵余，","勿使尘埃积。"],"stanzas":[["[澶漫]太行北，","千里一块石。"],["平腹有壑谷，","深广数百尺。"],["土僧何为者，","老草毛发白。"],["寝处容身龛，","足膝隐成迹。"],["金僊琢灵象，","相好倚北壁。"],["花座五云扶，","玉豪六虚射。"],["文人留纪述，","时事可辨析。"],["鸟迹巧均分，","龙骸极癯瘠。"],["枯松间槎枿，","猛兽恣腾掷。"],["蛣𧎜虫食纵，","悬垂露凝滴。"],["精艺贯古今，","穷岩谁爱惜。"],["托师禅诵余，","勿使尘埃积。"]]}
{"id":"e894dbeff8","title":"出世篇","author":"皇甫湜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["生当为大丈夫，","断羁罗，","出泥涂。","四散号呶，","[俶扰]无隅。","埋之深渊，","飘然上浮。","骑龙披青云，","泛览游八区。","经太山，","绝大海，","一长吁。","西摩月镜，","东弄日珠。","上括天之门，","直指帝所居。","群仙来迎塞天衢，","凤皇鸾鸟灿金舆。","音声嘈嘈满太虚，","旨饮食兮照庖厨。","食之不饫饫不尽，","使人不陋复不愚。","旦旦狎玉皇，","夜夜御天姝。","当御者几人，","百千为番。","宛宛舒舒，","忽不自知。","支消体化膏露明，","湛然无色茵席濡。","俄而散漫，","[斐]然虚无。","翕然复抟，","抟久而苏。","精神如太阳，","霍然照清都。","四肢为琅玕，","五脏为璠玙。","颜如芙蓉，","顶为醍醐。","与天地相终始，","浩漫为欢娱。","下顾人间，","溷粪蝇蛆。"],"stanzas":[["生当为大丈夫，","断羁罗，","出泥涂。"],["四散号呶，","[俶扰]无隅。"],["埋之深渊，","飘然上浮。"],["骑龙披青云，","泛览游八区。"],["经太山，","绝大海，","一长吁。"],["西摩月镜，","东弄日珠。"],["上括天之门，","直指帝所居。"],["群仙来迎塞天衢，","凤皇鸾鸟灿金舆。"],["音声嘈嘈满太虚，","旨饮食兮照庖厨。"],["食之不饫饫不尽，","使人不陋复不愚。"],["旦旦狎玉皇，","夜夜御天姝。"],["当御者几人，","百千为番。"],["宛宛舒舒，","忽不自知。"],["支消体化膏露明，","湛然无色茵席濡。"],["俄而散漫，","[斐]然虚无。"],["翕然复抟，","抟久而苏。"],["精神如太阳，","霍然照清都。"],["四肢为琅玕，","五脏为璠玙。"],["颜如芙蓉，","顶为醍醐。"],["与天地相终始，","浩漫为欢娱。"],["下顾人间，","溷粪蝇蛆。"]]}
{"id":"320603a21c","title":"蜀绵州越王楼诗","author":"樊宗师","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危楼倚天门，","如𨶻星辰宫。","榱薄龙虎怪，","洄洄绕雷风。","徂秋试登临，","大霭屯乔空。","不见西北路，","考怀益雕穷。","石濑薄溅溅，","上山杳穹穹。","昔人创为逝，","所适酡颜红。","今我兹之来，","犹校成岁功。","辍田植科亩，","游圃歌芳丛。","地财无丛厚，","人室安取丰。","既乏富庶能，","千万慙文翁。"],"stanzas":[["危楼倚天门，","如𨶻星辰宫。"],["榱薄龙虎怪，","洄洄绕雷风。"],["徂秋试登临，","大霭屯乔空。"],["不见西北路，","考怀益雕穷。"],["石濑薄溅溅，","上山杳穹穹。"],["昔人创为逝，","所适酡颜红。"],["今我兹之来，","犹校成岁功。"],["辍田植科亩，","游圃歌芳丛。"],["地财无丛厚，","人室安取丰。"],["既乏富庶能，","千万慙文翁。"]]}
{"id":"1f36cd5dc8","title":"催妆","author":"卢储","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔年将去玉京游，","第一仙人许状头。","今日幸为秦晋会，","早教鸾凤下妆楼。"],"stanzas":[["昔年将去玉京游，","第一仙人许状头。"],["今日幸为秦晋会，","早教鸾凤下妆楼。"]]}
{"id":"caaae92a1d","title":"官舍迎内子有庭花开","author":"卢储","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芍药斩新栽，","当庭数朵开。","东风与拘束，","留待细君来。"],"stanzas":[["芍药斩新栽，","当庭数朵开。"],["东风与拘束，","留待细君来。"]]}
{"id":"61c8620b9d","title":"古松感兴","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皇天后土力，","使我向此生。","贵贱不我均，","若为天地情。","我家世道德，","旨意匡文明。","家集四百卷，","独立天地经。","寄言青松姿，","岂羡朱槿荣。","昭昭大化光，","共此遗芳馨。"],"stanzas":[["皇天后土力，","使我向此生。"],["贵贱不我均，","若为天地情。"],["我家世道德，","旨意匡文明。"],["家集四百卷，","独立天地经。"],["寄言青松姿，","岂羡朱槿荣。"],["昭昭大化光，","共此遗芳馨。"]]}
{"id":"ee7c6df3be","title":"怨回纥歌","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白首南朝女，","愁听异域歌。","收兵颉利国，","饮马胡芦河。","毳布腥膻久，","穹庐岁月多。","雕巢城上宿，","吹笛泪滂沱。"],"stanzas":[["白首南朝女，","愁听异域歌。"],["收兵颉利国，","饮马胡芦河。"],["毳布腥膻久，","穹庐岁月多。"],["雕巢城上宿，","吹笛泪滂沱。"]]}
{"id":"7545c25648","title":"江上送别","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["祖席驻征棹，","开帆候信潮。","隔筵桃叶泣，","吹管杏花飘。","船去鸥飞阁，","人归尘上桥。","别离惆怅泪，","江路湿红蕉。"],"stanzas":[["祖席驻征棹，","开帆候信潮。"],["隔筵桃叶泣，","吹管杏花飘。"],["船去鸥飞阁，","人归尘上桥。"],["别离惆怅泪，","江路湿红蕉。"]]}
{"id":"c062c1f8fb","title":"采莲子二首 一","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["菡萏香连十顷陂，","小姑贪戏采莲迟。","晚来弄水船头湿，","更脱红裙裹鸭儿。"],"stanzas":[["菡萏香连十顷陂，","小姑贪戏采莲迟。"],["晚来弄水船头湿，","更脱红裙裹鸭儿。"]]}
{"id":"f066602c2e","title":"采莲子二首 二","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["船动湖光滟滟秋，","贪看年少信船流。","无端隔水抛莲子，","遥被人知半日羞。"],"stanzas":[["船动湖光滟滟秋，","贪看年少信船流。"],["无端隔水抛莲子，","遥被人知半日羞。"]]}
{"id":"3645be90eb","title":"抛毬乐 一","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红拨一声飘，","轻毬坠越绡。","带翻金孔雀，","香满绣蜂腰。","少少抛分数，","花枝正索饶。"],"stanzas":[["红拨一声飘，","轻毬坠越绡。"],["带翻金孔雀，","香满绣蜂腰。"],["少少抛分数，","花枝正索饶。"]]}
{"id":"142c52903d","title":"抛毬乐 二","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金蹙花毬小，","真珠绣带垂。","几回冲蜡烛，","千度入春怀。","上客终须醉，","觥杯自乱排。"],"stanzas":[["金蹙花毬小，","真珠绣带垂。"],["几回冲蜡烛，","千度入春怀。"],["上客终须醉，","觥杯自乱排。"]]}
{"id":"b2044b36c1","title":"劝僧酒","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劝僧一杯酒，","共看青青山。","酣然万象灭，","不动心印闲。"],"stanzas":[["劝僧一杯酒，","共看青青山。"],["酣然万象灭，","不动心印闲。"]]}
{"id":"a7bec95f1a","title":"登郭隗台","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕相谋在兹，","积金黄巍巍。","上诸欲何颜，","使我千载悲。"],"stanzas":[["燕相谋在兹，","积金黄巍巍。"],["上诸欲何颜，","使我千载悲。"]]}
{"id":"239dc26497","title":"杨柳枝词二首 一","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烂漫春归水国时。","吴王宫殿柳丝垂，","黄莺长叫空闺畔。","西子无因更得知。"],"stanzas":[["烂漫春归水国时。"],["吴王宫殿柳丝垂，","黄莺长叫空闺畔。"],["西子无因更得知。"]]}
