{"id":"8e627a8c64","title":"寄珉笛与宇文舍人","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["调高银字声还侧，","物比柯亭韵校奇。","寄与玉人天上去，","桓将军见不教吹。"],"stanzas":[["调高银字声还侧，","物比柯亭韵校奇。"],["寄与玉人天上去，","桓将军见不教吹。"]]}
{"id":"8f39a05302","title":"寄内兄和州崔员外十二韵","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["历阳崔太守，","何日不含情。","恩义同钟李，","埙篪实弟兄。","光尘能混合，","擘画最分明。","台阁仁贤誉，","闺门孝友声。","西方像教毁，","南海绣衣行。","金橐宁回顾，","珠簟肯一枨。","秪宜裁密诏，","何自取专城。","进退无非道，","徊翔必有名。","好风初婉软，","离思苦萦盈。","金马旧游贵，","桐庐春水生。","雨侵寒牖梦，","梅引冻醪倾。","共祝中兴主，","高歌唱太平。"],"stanzas":[["历阳崔太守，","何日不含情。"],["恩义同钟李，","埙篪实弟兄。"],["光尘能混合，","擘画最分明。"],["台阁仁贤誉，","闺门孝友声。"],["西方像教毁，","南海绣衣行。"],["金橐宁回顾，","珠簟肯一枨。"],["秪宜裁密诏，","何自取专城。"],["进退无非道，","徊翔必有名。"],["好风初婉软，","离思苦萦盈。"],["金马旧游贵，","桐庐春水生。"],["雨侵寒牖梦，","梅引冻醪倾。"],["共祝中兴主，","高歌唱太平。"]]}
{"id":"6392f35738","title":"遣兴","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["镜弄白髭须，","如何作老夫。","浮生长勿勿，","儿小且呜呜。","忍过事堪喜，","泰来忧胜无。","治平心径熟，","不遣有穷途。"],"stanzas":[["镜弄白髭须，","如何作老夫。"],["浮生长勿勿，","儿小且呜呜。"],["忍过事堪喜，","泰来忧胜无。"],["治平心径熟，","不遣有穷途。"]]}
{"id":"6cea2b8a5a","title":"早秋","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["疎雨洗空旷，","秋标惊意新。","大热去酷吏，","清风来故人。","尊酒酌未酌，","晚花嚬不嚬。","铢秤与缕雪，","谁觉老陈陈。"],"stanzas":[["疎雨洗空旷，","秋标惊意新。"],["大热去酷吏，","清风来故人。"],["尊酒酌未酌，","晚花嚬不嚬。"],["铢秤与缕雪，","谁觉老陈陈。"]]}
{"id":"5a413b058d","title":"秋思","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["热去解钳釱，","飘萧秋半时。","微雨池塘见，","好风襟袖知。","髪短梳未足，","枕凉闲且欹。","平生分过此，","何事不参差。"],"stanzas":[["热去解钳釱，","飘萧秋半时。"],["微雨池塘见，","好风襟袖知。"],["髪短梳未足，","枕凉闲且欹。"],["平生分过此，","何事不参差。"]]}
{"id":"c8420ef48c","title":"途中一绝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["镜中丝髪悲来惯，","衣上尘痕拂渐难。","惆怅江湖钓竿手，","却遮西日向长安。"],"stanzas":[["镜中丝髪悲来惯，","衣上尘痕拂渐难。"],["惆怅江湖钓竿手，","却遮西日向长安。"]]}
{"id":"03957dc755","title":"春尽途中","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["田园不事来游宦，","故国谁教尔别离。","独倚关亭还把酒，","一年春尽送春诗。"],"stanzas":[["田园不事来游宦，","故国谁教尔别离。"],["独倚关亭还把酒，","一年春尽送春诗。"]]}
{"id":"7250588c98","title":"题村舍","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三树稚桑春未到，","扶床乳女午啼饥。","潜销暗铄归何处，","万指侯家自不知。"],"stanzas":[["三树稚桑春未到，","扶床乳女午啼饥。"],["潜销暗铄归何处，","万指侯家自不知。"]]}
{"id":"b46e61b188","title":"代人寄远六言二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河桥酒斾风软，","候馆梅花雪娇。","宛陵楼上瞪目，","我郎何处情饶。"],"stanzas":[["河桥酒斾风软，","候馆梅花雪娇。"],["宛陵楼上瞪目，","我郎何处情饶。"]]}
{"id":"727564a3d7","title":"代人寄远六言二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绣领任垂蓬髻，","丁香闲结春梢。","賸肯新年归否，","江南绿草迢迢。"],"stanzas":[["绣领任垂蓬髻，","丁香闲结春梢。"],["賸肯新年归否，","江南绿草迢迢。"]]}
{"id":"6e0eeec7f8","title":"闺情","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["娟娟却月眉，","新鬓学鵶飞。","暗砌匀檀粉，","晴窓画夹衣。","袖红垂寂寞，","眉黛歛衣稀。","还向长陵去，","今宵归不归。"],"stanzas":[["娟娟却月眉，","新鬓学鵶飞。"],["暗砌匀檀粉，","晴窓画夹衣。"],["袖红垂寂寞，","眉黛歛衣稀。"],["还向长陵去，","今宵归不归。"]]}
{"id":"592760bed0","title":"旧游","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲吟芍药诗，","惆望久嚬眉。","盼眄回眸远，","纤衫整髻迟。","重寻春昼梦，","笑把浅花枝。","小市长陵住，","非郎谁得知。"],"stanzas":[["闲吟芍药诗，","惆望久嚬眉。"],["盼眄回眸远，","纤衫整髻迟。"],["重寻春昼梦，","笑把浅花枝。"],["小市长陵住，","非郎谁得知。"]]}
{"id":"fef9b1eca7","title":"寄远","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["只影随惊鴈，","单栖鏁画笼。","向春罗袖薄，","谁念舞台风。"],"stanzas":[["只影随惊鴈，","单栖鏁画笼。"],["向春罗袖薄，","谁念舞台风。"]]}
{"id":"70b68aa057","title":"帘","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["徒云逢剪削，","岂谓见偏装。","凤节轻雕日，","鸾花薄餙香。","问屏何屈曲，","怜帐解周防。","下渍金阶露，","斜分碧瓦霜。","沈沈伴春梦，","寂寂侍华堂。","谁见昭阳殿，","真珠十二行。"],"stanzas":[["徒云逢剪削，","岂谓见偏装。"],["凤节轻雕日，","鸾花薄餙香。"],["问屏何屈曲，","怜帐解周防。"],["下渍金阶露，","斜分碧瓦霜。"],["沈沈伴春梦，","寂寂侍华堂。"],["谁见昭阳殿，","真珠十二行。"]]}
{"id":"1b7bd14b51","title":"寄题甘露寺北轩","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾向蓬莱宫里行，","北轩阑槛最留情。","孤高堪弄桓伊笛，","缥缈宜闻子晋笙。","天接海门秋水色，","烟笼隋苑暮钟声。","他年会著荷衣去，","不向山僧说姓名。"],"stanzas":[["曾向蓬莱宫里行，","北轩阑槛最留情。"],["孤高堪弄桓伊笛，","缥缈宜闻子晋笙。"],["天接海门秋水色，","烟笼隋苑暮钟声。"],["他年会著荷衣去，","不向山僧说姓名。"]]}
{"id":"29b0904b5b","title":"题青云馆","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虬蟠千仞剧羊肠，","天府由来百二强。","四皓有芝轻汉祖，","张仪无地与怀王。","云连帐影萝阴合，","枕绕泉声客梦凉。","深处会容高尚者，","水苗三顷百株桑。"],"stanzas":[["虬蟠千仞剧羊肠，","天府由来百二强。"],["四皓有芝轻汉祖，","张仪无地与怀王。"],["云连帐影萝阴合，","枕绕泉声客梦凉。"],["深处会容高尚者，","水苗三顷百株桑。"]]}
{"id":"958d69a376","title":"正初奉酬歙州刺史邢群","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠岩千尺倚溪斜，","曾得严光作钓家。","越嶂远分丁字水，","腊梅迟见二年花。","明时刀尺君须用，","幽处田园我有涯。","一壑风烟阳羡里，","解龟休去路非赊。"],"stanzas":[["翠岩千尺倚溪斜，","曾得严光作钓家。"],["越嶂远分丁字水，","腊梅迟见二年花。"],["明时刀尺君须用，","幽处田园我有涯。"],["一壑风烟阳羡里，","解龟休去路非赊。"]]}
{"id":"ce0241823f","title":"江上偶见绝句","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚江寒食橘花时，","野渡临风驻彩旗。","草色连云人去住，","水纹如縠燕差池。"],"stanzas":[["楚江寒食橘花时，","野渡临风驻彩旗。"],["草色连云人去住，","水纹如縠燕差池。"]]}
{"id":"ef1aaec7aa","title":"题木兰庙","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弯弓征战作男儿，","梦里曾经与画眉。","几度思归还把酒，","拂云堆上祝明妃。"],"stanzas":[["弯弓征战作男儿，","梦里曾经与画眉。"],["几度思归还把酒，","拂云堆上祝明妃。"]]}
{"id":"33633140a8","title":"入商山","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早入商山百里云，","蓝溪桥下水声分。","流水旧声人旧耳，","此回呜咽不堪闻。"],"stanzas":[["早入商山百里云，","蓝溪桥下水声分。"],["流水旧声人旧耳，","此回呜咽不堪闻。"]]}
{"id":"3082a12a82","title":"偶题","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["甘罗昔作秦丞相，","子政曾为汉辇郎。","千载更逢王侍读，","当时还道有文章。"],"stanzas":[["甘罗昔作秦丞相，","子政曾为汉辇郎。"],["千载更逢王侍读，","当时还道有文章。"]]}
{"id":"337d8e1e44","title":"送卢秀才一绝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春濑与烟远，","送君孤櫂开。","潺湲如不改，","愁更钓鱼来。"],"stanzas":[["春濑与烟远，","送君孤櫂开。"],["潺湲如不改，","愁更钓鱼来。"]]}
{"id":"0b5b8b4354","title":"醉题","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金镊洗霜鬓，","银觥敌露桃。","醉头扶不起，","三丈日还高。"],"stanzas":[["金镊洗霜鬓，","银觥敌露桃。"],["醉头扶不起，","三丈日还高。"]]}
{"id":"d9d9daa0d8","title":"题商山四皓庙一绝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吕氏强梁嗣子柔，","我于天性岂恩讐。","南军不袒左边袖，","四老安刘是灭刘。"],"stanzas":[["吕氏强梁嗣子柔，","我于天性岂恩讐。"],["南军不袒左边袖，","四老安刘是灭刘。"]]}
{"id":"00b9891e65","title":"送隐者一绝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无媒径路草萧萧，","自古云林远市朝。","公道世间唯白发，","贵人头上不曾饶。"],"stanzas":[["无媒径路草萧萧，","自古云林远市朝。"],["公道世间唯白发，","贵人头上不曾饶。"]]}
{"id":"2f25f68b86","title":"题张处士山庄一绝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好鸟疑敲磬，","风蝉认轧筝。","修篁与嘉树，","偏倚半岩生。"],"stanzas":[["好鸟疑敲磬，","风蝉认轧筝。"],["修篁与嘉树，","偏倚半岩生。"]]}
{"id":"73135bde53","title":"有怀重送斛斯判官","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍苍烟月满川亭，","我有劳歌一为听。","将取离魂随白骑，","三台星里拜文星。"],"stanzas":[["苍苍烟月满川亭，","我有劳歌一为听。"],["将取离魂随白骑，","三台星里拜文星。"]]}
{"id":"88636219b3","title":"赠别二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["娉娉褭褭十三余，","豆蔻梢头二月初。","春风十里扬州路，","卷上珠帘总不如。"],"stanzas":[["娉娉褭褭十三余，","豆蔻梢头二月初。"],["春风十里扬州路，","卷上珠帘总不如。"]]}
{"id":"06713667b7","title":"赠别二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["多情却似总无情，","唯觉尊前笑不成。","蜡烛有心还惜别，","替人垂泪到天明。"],"stanzas":[["多情却似总无情，","唯觉尊前笑不成。"],["蜡烛有心还惜别，","替人垂泪到天明。"]]}
{"id":"728970239d","title":"寄远","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前山极远碧云合，","清夜一声白雪微。","欲寄相思千里月，","溪边残照雨霏霏。"],"stanzas":[["前山极远碧云合，","清夜一声白雪微。"],["欲寄相思千里月，","溪边残照雨霏霏。"]]}
{"id":"44fa46e5bb","title":"少年行","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["官为骏马监，","职帅羽林儿。","两绶藏不见，","落花何处期？","猎敲白玉镫，","怒袖紫金锤。","田窦长留醉，","苏辛曲让岐。","豪持出塞节，","笑别远山眉。","捷报云台贺，","公卿拜寿巵。"],"stanzas":[["官为骏马监，","职帅羽林儿。"],["两绶藏不见，","落花何处期？"],["猎敲白玉镫，","怒袖紫金锤。"],["田窦长留醉，","苏辛曲让岐。"],["豪持出塞节，","笑别远山眉。"],["捷报云台贺，","公卿拜寿巵。"]]}
{"id":"7860cda0c8","title":"盆池","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凿破苍苔地，","偷他一片天。","白云生镜里，","明月落堦前。"],"stanzas":[["凿破苍苔地，","偷他一片天。"],["白云生镜里，","明月落堦前。"]]}
{"id":"980575b128","title":"有寄","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云阔烟深树，","江澄水浴秋。","美人何处在，","明月万山头。"],"stanzas":[["云阔烟深树，","江澄水浴秋。"],["美人何处在，","明月万山头。"]]}
{"id":"4f65e8cab5","title":"斑竹筒簟","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["血染斑斑成锦纹，","昔年遗恨至今存。","分明知是湘妃泣，","何忍将身卧泪痕。"],"stanzas":[["血染斑斑成锦纹，","昔年遗恨至今存。"],["分明知是湘妃泣，","何忍将身卧泪痕。"]]}
{"id":"fd36ff6b84","title":"和严恽秀才落花","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共惜流年留不得，","且环流水醉流杯。","无情红艳年年盛，","不恨凋零却恨开。"],"stanzas":[["共惜流年留不得，","且环流水醉流杯。"],["无情红艳年年盛，","不恨凋零却恨开。"]]}
{"id":"75b07f5f55","title":"倡楼戏赠","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细柳桥边深半春，","缬衣帘里动香尘。","无端有寄闲消息，","背插金钗笑向人。"],"stanzas":[["细柳桥边深半春，","缬衣帘里动香尘。"],["无端有寄闲消息，","背插金钗笑向人。"]]}
{"id":"708813eea1","title":"初上船留寄","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟水本好尚，","亲交何惨凄。","况为珠履客，","即泊锦帆堤。","沙鴈同船去，","田鵶绕岸啼。","此时还有味，","必卧日从西。"],"stanzas":[["烟水本好尚，","亲交何惨凄。"],["况为珠履客，","即泊锦帆堤。"],["沙鴈同船去，","田鵶绕岸啼。"],["此时还有味，","必卧日从西。"]]}
{"id":"ddf114ce39","title":"秋岸","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河岸微退落，","柳影微雕疎。","船上听呼穉，","堤南趁漉鱼。","数帆旗去疾，","一艇箭回初。","曾入相思梦，","因凭附远书。"],"stanzas":[["河岸微退落，","柳影微雕疎。"],["船上听呼穉，","堤南趁漉鱼。"],["数帆旗去疾，","一艇箭回初。"],["曾入相思梦，","因凭附远书。"]]}
{"id":"3b4e805da7","title":"过大梁闻河亭方䜩赠孙子端","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梁园纵玩归应少，","赋雪搜才去必频。","板落岂缘无罚酒，","不教客右更添人。"],"stanzas":[["梁园纵玩归应少，","赋雪搜才去必频。"],["板落岂缘无罚酒，","不教客右更添人。"]]}
{"id":"e02fa77241","title":"题吴兴消暑楼十二韵","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晴日登攀好，","危楼物象饶。","一溪通四境，","万岫饶层霄。","鸟翼舒华屋，","鱼鳞棹短桡。","浪花机乍织，","云叶匠新雕。","台榭罗嘉卉，","城池敞丽谯。","蟾蜍来作鉴，","䗖𬟽引成桥。","燕任随秋叶，","人空集早潮。","楚鸿行尽直，","沙鹭立偏翘。","暮角凄游旅，","清歌惨泬寥。","景牵游目困，","愁托酒肠销。","远吹流松韵，","残阳渡柳桥。","时陪庾公赏，","还悟脱烦嚣。"],"stanzas":[["晴日登攀好，","危楼物象饶。"],["一溪通四境，","万岫饶层霄。"],["鸟翼舒华屋，","鱼鳞棹短桡。"],["浪花机乍织，","云叶匠新雕。"],["台榭罗嘉卉，","城池敞丽谯。"],["蟾蜍来作鉴，","䗖𬟽引成桥。"],["燕任随秋叶，","人空集早潮。"],["楚鸿行尽直，","沙鹭立偏翘。"],["暮角凄游旅，","清歌惨泬寥。"],["景牵游目困，","愁托酒肠销。"],["远吹流松韵，","残阳渡柳桥。"],["时陪庾公赏，","还悟脱烦嚣。"]]}
{"id":"ab4e1b88d5","title":"奉送中丞姊夫俦自大理卿出镇江西叙事书怀因成十二韵","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惟帝忧南纪，","搜贤与大藩。","梅仙调步骤，","庾亮拂橐鞬。","一室何劳扫，","三章自不冤。","精明如定国，","孤峻似陈蕃。","灞岸秋犹嫩，","蓝桥水始喧。","红旓罣石壁，","黑矟断云根。","滕阁丹霄倚，","章江碧玉奔。","一声仙妓唱，","千里暮江痕。","私好初童稚，","官荣见子孙。","流年休挂念，","万事至无言。","玉辇君频过，","冯唐将未论。","庸书醻万债，","竹坞问樊村。"],"stanzas":[["惟帝忧南纪，","搜贤与大藩。"],["梅仙调步骤，","庾亮拂橐鞬。"],["一室何劳扫，","三章自不冤。"],["精明如定国，","孤峻似陈蕃。"],["灞岸秋犹嫩，","蓝桥水始喧。"],["红旓罣石壁，","黑矟断云根。"],["滕阁丹霄倚，","章江碧玉奔。"],["一声仙妓唱，","千里暮江痕。"],["私好初童稚，","官荣见子孙。"],["流年休挂念，","万事至无言。"],["玉辇君频过，","冯唐将未论。"],["庸书醻万债，","竹坞问樊村。"]]}
{"id":"12e4ad0146","title":"中丞业深韬畧志在功名再奉长句一篇兼有咨劝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["樯似邓林江拍天，","越香巴锦万千千。","滕王阁上柘枝鼓，","徐孺亭西铁轴船。","八部元侯非不贵，","万人师长岂无权。","要君严重疎欢乐，","犹有河湟可下鞭。"],"stanzas":[["樯似邓林江拍天，","越香巴锦万千千。"],["滕王阁上柘枝鼓，","徐孺亭西铁轴船。"],["八部元侯非不贵，","万人师长岂无权。"],["要君严重疎欢乐，","犹有河湟可下鞭。"]]}
{"id":"189d0b8b6f","title":"和裴杰秀才新樱桃","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新果真琼液，","人应宴紫兰。","圆疑窃龙颔，","色已夺鸡冠。","远火微微辨，","繁星历历看。","茂先知味好，","曼倩恨偷难。","忍用烹酥酪，","从将玩玉盘。","流年如可驻，","何必九华丹。"],"stanzas":[["新果真琼液，","人应宴紫兰。"],["圆疑窃龙颔，","色已夺鸡冠。"],["远火微微辨，","繁星历历看。"],["茂先知味好，","曼倩恨偷难。"],["忍用烹酥酪，","从将玩玉盘。"],["流年如可驻，","何必九华丹。"]]}
{"id":"12d68c09f5","title":"春思","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岂君心的的，","嗟我泪涓涓。","绵羽啼来久，","锦鳞书未传。","兽垆凝冷焰，","罗暮蔽晴烟。","自是求佳梦，","何须讶画眠。"],"stanzas":[["岂君心的的，","嗟我泪涓涓。"],["绵羽啼来久，","锦鳞书未传。"],["兽垆凝冷焰，","罗暮蔽晴烟。"],["自是求佳梦，","何须讶画眠。"]]}
{"id":"287637734f","title":"代人作","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼高春日早，","屏束麝烟堆。","盼眄凝魂别，","依稀梦雨来。","绿鬟羞妥么，","红颊思天偎。","鬬草怜香蕙，","簪花间雪梅。","戌辽虽咽切，","游蜀亦迟回。","锦字梭悬壁，","琴心月满台。","笑筵凝贝启，","眠箔晓珠开。","腊破征车动，","袍襟对泪裁。"],"stanzas":[["楼高春日早，","屏束麝烟堆。"],["盼眄凝魂别，","依稀梦雨来。"],["绿鬟羞妥么，","红颊思天偎。"],["鬬草怜香蕙，","簪花间雪梅。"],["戌辽虽咽切，","游蜀亦迟回。"],["锦字梭悬壁，","琴心月满台。"],["笑筵凝贝启，","眠箔晓珠开。"],["腊破征车动，","袍襟对泪裁。"]]}
{"id":"4f2b2f0d0f","title":"偶题二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劳劳千里身，","襟袂满行尘。","深夜悬双泪，","短亭思远人。","苍江程未息，","黑水梦何频。","明月轻桡去，","唯应钓赤鳞。"],"stanzas":[["劳劳千里身，","襟袂满行尘。"],["深夜悬双泪，","短亭思远人。"],["苍江程未息，","黑水梦何频。"],["明月轻桡去，","唯应钓赤鳞。"]]}
{"id":"1fa4d49709","title":"偶题二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有恨秋来极，","无端别后知。","夜阑终耿耿，","明发竟迟迟。","信已凭鸿去，","归唯与燕期。","只因明月见，","千里两相思。"],"stanzas":[["有恨秋来极，","无端别后知。"],["夜阑终耿耿，","明发竟迟迟。"],["信已凭鸿去，","归唯与燕期。"],["只因明月见，","千里两相思。"]]}
{"id":"2537723ce5","title":"冬至日遇京使发寄舍弟","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远信初凭双鲤去，","他乡正遇一阳生。","尊前岂解愁家国，","辇下唯能忆弟兄。","旅馆夜忧姜被冷，","暮江寒觉晏裘轻。","竹门风过还惆怅，","疑是松窗雪打声。"],"stanzas":[["远信初凭双鲤去，","他乡正遇一阳生。"],["尊前岂解愁家国，","辇下唯能忆弟兄。"],["旅馆夜忧姜被冷，","暮江寒觉晏裘轻。"],["竹门风过还惆怅，","疑是松窗雪打声。"]]}
{"id":"a24c82643c","title":"洛下送张曼容赴上党召","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌阕罇残恨却偏，","凭君不用设离筵。","未趍雉尾随元老，","且蓦羊肠过少年。","七叶汉貂真密近，","一枝诜桂亦徒然。","羽书正急征兵地，","须遣头风处处痊。"],"stanzas":[["歌阕罇残恨却偏，","凭君不用设离筵。"],["未趍雉尾随元老，","且蓦羊肠过少年。"],["七叶汉貂真密近，","一枝诜桂亦徒然。"],["羽书正急征兵地，","须遣头风处处痊。"]]}
{"id":"1a6cda19f5","title":"宣州留赠","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红铅湿尽半罗裙，","洞府人间手欲分。","满面风流虽似玉，","四年夫婿恰如云。","当春离恨杯长满，","倚柱关情日渐曛。","为报眼波须稳当，","五陵游宕莫知闻。"],"stanzas":[["红铅湿尽半罗裙，","洞府人间手欲分。"],["满面风流虽似玉，","四年夫婿恰如云。"],["当春离恨杯长满，","倚柱关情日渐曛。"],["为报眼波须稳当，","五陵游宕莫知闻。"]]}
{"id":"205e223119","title":"寄题宣州开元寺","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["松寺曾同一鹤栖，","夜深台殿月高低。","何人为倚东楼柱，","正是千山雪涨溪。"],"stanzas":[["松寺曾同一鹤栖，","夜深台殿月高低。"],["何人为倚东楼柱，","正是千山雪涨溪。"]]}
{"id":"47ca72b8a8","title":"赠张祜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗韵一逢君，","平生称所闻。","粉毫唯画月，","琼尺只裁云。","鲸阵人人慑，","秋星历历分。","数篇留别我，","羞杀李将军。"],"stanzas":[["诗韵一逢君，","平生称所闻。"],["粉毫唯画月，","琼尺只裁云。"],["鲸阵人人慑，","秋星历历分。"],["数篇留别我，","羞杀李将军。"]]}
{"id":"26c721afcc","title":"残春独来南亭因寄张祜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖云如粉草如茵，","独步长堤不见人。","一岭桃花红锦黦，","半溪山水碧罗新。","高枝百舌犹欺鸟，","带叶梨花独送春。","仲蔚欲知何处在，","苦吟林下拂诗尘。"],"stanzas":[["暖云如粉草如茵，","独步长堤不见人。"],["一岭桃花红锦黦，","半溪山水碧罗新。"],["高枝百舌犹欺鸟，","带叶梨花独送春。"],["仲蔚欲知何处在，","苦吟林下拂诗尘。"]]}
{"id":"030c1a925c","title":"宣州开元寺南楼","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小楼才受一床横，","终日看山酒满倾。","可惜和风夜来雨，","醉中虚度打窗声。"],"stanzas":[["小楼才受一床横，","终日看山酒满倾。"],["可惜和风夜来雨，","醉中虚度打窗声。"]]}
{"id":"7daef53134","title":"寄远人","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["终日求人卜，","回回道好音。","那时离别后，","入梦到如今。"],"stanzas":[["终日求人卜，","回回道好音。"],["那时离别后，","入梦到如今。"]]}
{"id":"a14666a611","title":"别沈处士","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旧事参差梦，","新程逦迤秋。","故人如见忆，","时到寺东楼。"],"stanzas":[["旧事参差梦，","新程逦迤秋。"],["故人如见忆，","时到寺东楼。"]]}
{"id":"253893e325","title":"留赠","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舞靴应任闲人看，","笑脸还须待我开。","不用镜前空有泪，","蔷薇花谢即归来。"],"stanzas":[["舞靴应任闲人看，","笑脸还须待我开。"],["不用镜前空有泪，","蔷薇花谢即归来。"]]}
{"id":"3daa9bf4a0","title":"奉和仆射相公春泽稍愆圣君轸虑嘉雪忽降品汇昭苏即事书成四韵","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飘来鸡树凤池边，","渐压琼枝冻碧涟。","银阙双高银汉里，","玉山横列玉墀前。","昭阳殿下风回急，","承露盘中月彩圆。","上相抽毫歌帝德，","一篇风雅美丰年。"],"stanzas":[["飘来鸡树凤池边，","渐压琼枝冻碧涟。"],["银阙双高银汉里，","玉山横列玉墀前。"],["昭阳殿下风回急，","承露盘中月彩圆。"],["上相抽毫歌帝德，","一篇风雅美丰年。"]]}
{"id":"810fd5dce3","title":"寄李播评事","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子列光殊价，","明时忍自高。","宁无好舟檝，","不泛恶风涛。","大翼终难戢，","奇锋且自韬。","春来烟渚上，","几净雪霜毫。"],"stanzas":[["子列光殊价，","明时忍自高。"],["宁无好舟檝，","不泛恶风涛。"],["大翼终难戢，","奇锋且自韬。"],["春来烟渚上，","几净雪霜毫。"]]}
{"id":"902d9f8d33","title":"送牛相出镇襄州","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盛时常注意，","南雍暂分茅。","紫殿辞明主，","岩廊别旧交。","危幢侵碧雾，","寒斾猎红旓。","德业悬秦镜，","威声隐楚郊。","拜尘先洒泪，","成厦昔容巢。","遥仰沈碑会，","鸳鸯玉佩敲。"],"stanzas":[["盛时常注意，","南雍暂分茅。"],["紫殿辞明主，","岩廊别旧交。"],["危幢侵碧雾，","寒斾猎红旓。"],["德业悬秦镜，","威声隐楚郊。"],["拜尘先洒泪，","成厦昔容巢。"],["遥仰沈碑会，","鸳鸯玉佩敲。"]]}
{"id":"d66276c03f","title":"送薛邽二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可怜走马骑驴汉，","岂有风光肯占伊。","只有三张最惆怅，","下山回马尚迟迟。"],"stanzas":[["可怜走马骑驴汉，","岂有风光肯占伊。"],["只有三张最惆怅，","下山回马尚迟迟。"]]}
{"id":"dd61e55c4e","title":"送薛邽二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小捷风流已俊才，","便将红粉作金台。","明年未去池阳郡，","更乞春时却重来。"],"stanzas":[["小捷风流已俊才，","便将红粉作金台。"],["明年未去池阳郡，","更乞春时却重来。"]]}
{"id":"9ccb4a4228","title":"见穆三十宅中庭海榴花谢","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["矜红掩素似多才，","不待樱桃不逐梅。","春到未曾逢宴赏，","雨余争解免低徊。","巧穷南国千般艳，","趁得春风二月开。","堪恨王孙浪游去，","落英狼籍始归来。"],"stanzas":[["矜红掩素似多才，","不待樱桃不逐梅。"],["春到未曾逢宴赏，","雨余争解免低徊。"],["巧穷南国千般艳，","趁得春风二月开。"],["堪恨王孙浪游去，","落英狼籍始归来。"]]}
{"id":"ba61c4d265","title":"留诲曹师等诗","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万物有丑好，","各一姿状分。","唯人即不尔，","学与不学论。","学非探其花，","要自拨其根。","孝友与诚实，","而不忘尔言。","根本既深实，","柯叶自滋繁。","念尔无忽此，","期以庆吾门。"],"stanzas":[["万物有丑好，","各一姿状分。"],["唯人即不尔，","学与不学论。"],["学非探其花，","要自拨其根。"],["孝友与诚实，","而不忘尔言。"],["根本既深实，","柯叶自滋繁。"],["念尔无忽此，","期以庆吾门。"]]}
{"id":"a63f2c35ff","title":"洛阳","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文争武战就神功，","时似开元天宝中。","已建玄戈收相土，","应回翠帽过离宫。","侯门草满宜寒兔，","洛浦沙深下塞鸿。","疑有女娥西望处，","上阳烟树正秋风。"],"stanzas":[["文争武战就神功，","时似开元天宝中。"],["已建玄戈收相土，","应回翠帽过离宫。"],["侯门草满宜寒兔，","洛浦沙深下塞鸿。"],["疑有女娥西望处，","上阳烟树正秋风。"]]}
{"id":"ed2d97c4a0","title":"寄唐州李玭尚书","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["累代功勋照世光，","奚胡闻道死心降。","书功笔秃三千管，","领节门排十六双。","先揖耿弇声寂寂，","今看黄霸事摐摐。","时人欲识胸襟否，","彭蠡秋连万里江。"],"stanzas":[["累代功勋照世光，","奚胡闻道死心降。"],["书功笔秃三千管，","领节门排十六双。"],["先揖耿弇声寂寂，","今看黄霸事摐摐。"],["时人欲识胸襟否，","彭蠡秋连万里江。"]]}
{"id":"4888fd66e3","title":"南陵道中","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南陵水面漫悠悠，","风紧云轻欲变秋。","正是客心孤回处，","谁家红袖凭江楼。"],"stanzas":[["南陵水面漫悠悠，","风紧云轻欲变秋。"],["正是客心孤回处，","谁家红袖凭江楼。"]]}
{"id":"a18bf3d980","title":"登九峰楼","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晴江滟滟含浅沙，","高低绕郭滞秋花。","牛歌鱼笛山月上，","鹭渚鹙梁溪日斜。","为郡异乡徒泥酒，","杜陵芳草岂无家。"],"stanzas":[["晴江滟滟含浅沙，","高低绕郭滞秋花。"],["牛歌鱼笛山月上，","鹭渚鹙梁溪日斜。"],["为郡异乡徒泥酒，","杜陵芳草岂无家。"]]}
{"id":"bd31facf63","title":"别家","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["初岁娇儿未识爷，","别爷不拜手咤叉。","拊头一别三千里，","何日迎门却到家。"],"stanzas":[["初岁娇儿未识爷，","别爷不拜手咤叉。"],["拊头一别三千里，","何日迎门却到家。"]]}
{"id":"2cc31adb96","title":"归家","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["穉子牵衣问，","归来何太迟。","共谁争岁月，","赢得鬓边丝。"],"stanzas":[["穉子牵衣问，","归来何太迟。"],["共谁争岁月，","赢得鬓边丝。"]]}
{"id":"ffc45b0a64","title":"雨","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["连云接塞添迢递，","洒幕侵灯送寂寥。","一夜不眠孤客耳，","主人牕外有芭蕉。"],"stanzas":[["连云接塞添迢递，","洒幕侵灯送寂寥。"],["一夜不眠孤客耳，","主人牕外有芭蕉。"]]}
{"id":"5aaeb05aac","title":"送人","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸳鸯帐里暖芙蓉，","低泣关山几万重。","明镜半边钗一股，","此生何处不相逢。"],"stanzas":[["鸳鸯帐里暖芙蓉，","低泣关山几万重。"],["明镜半边钗一股，","此生何处不相逢。"]]}
{"id":"43ba7da49e","title":"遣怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道泰时还泰，","时来命不来。","何当离城市，","高卧博山隈。"],"stanzas":[["道泰时还泰，","时来命不来。"],["何当离城市，","高卧博山隈。"]]}
{"id":"ae220248c0","title":"醉赠薛道封","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["饮酒论文四百刻，","水分云隔二三年。","男儿事业知公有，","卖与明君直几钱。"],"stanzas":[["饮酒论文四百刻，","水分云隔二三年。"],["男儿事业知公有，","卖与明君直几钱。"]]}
{"id":"4c962a5efe","title":"歙州卢中丞见惠名酝","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁怜贱子启穷途，","太守封来酒一壶。","攻破是非浑似梦，","削平身世有如无。","醺醺若借嵇康懒，","兀兀仍添甯武愚。","犹念悲秋更分赐，","夹溪红蓼映风蒲。"],"stanzas":[["谁怜贱子启穷途，","太守封来酒一壶。"],["攻破是非浑似梦，","削平身世有如无。"],["醺醺若借嵇康懒，","兀兀仍添甯武愚。"],["犹念悲秋更分赐，","夹溪红蓼映风蒲。"]]}
{"id":"91963e5516","title":"咏袜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钿尺裁量减四分，","纤纤玉笋裹轻云。","五陵年少欺他醉，","笑把花前出画裙。"],"stanzas":[["钿尺裁量减四分，","纤纤玉笋裹轻云。"],["五陵年少欺他醉，","笑把花前出画裙。"]]}
{"id":"00d2ab70c9","title":"宫词二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蝉翼轻绡傅体红，","玉肤如醉向春风。","深宫锁闭犹疑惑，","更取丹沙试辟宫。"],"stanzas":[["蝉翼轻绡傅体红，","玉肤如醉向春风。"],["深宫锁闭犹疑惑，","更取丹沙试辟宫。"]]}
{"id":"981b016633","title":"宫词二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["监宫引出暂开门，","随例须朝不是恩。","银钥却收金锁合，","月明花落又黄昏。"],"stanzas":[["监宫引出暂开门，","随例须朝不是恩。"],["银钥却收金锁合，","月明花落又黄昏。"]]}
{"id":"4f7f221c97","title":"月","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三十六宫秋夜深，","昭阳歌断信沈沈。","唯应独伴陈皇后，","照见长门望幸心。"],"stanzas":[["三十六宫秋夜深，","昭阳歌断信沈沈。"],["唯应独伴陈皇后，","照见长门望幸心。"]]}
{"id":"62b56ebb7e","title":"忍死留别献监铁裴相公二十叔","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贤相辅明主，","苍生寿域开。","青春辞白日，","幽壤作黄埃。","岂是无多士，","偏蒙不弃才。","孤坟三尺土，","谁可为培栽。"],"stanzas":[["贤相辅明主，","苍生寿域开。"],["青春辞白日，","幽壤作黄埃。"],["岂是无多士，","偏蒙不弃才。"],["孤坟三尺土，","谁可为培栽。"]]}
{"id":"27c49d7c8c","title":"悲吴王城","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二月春风江上来，","水精波动碎楼台。","吴王宫殿柳含翠，","苏小宅房花正开。","解舞细腰何处往，","能歌姹女逐谁回。","千秋万古无消息，","国作荒原人作灰。"],"stanzas":[["二月春风江上来，","水精波动碎楼台。"],["吴王宫殿柳含翠，","苏小宅房花正开。"],["解舞细腰何处往，","能歌姹女逐谁回。"],["千秋万古无消息，","国作荒原人作灰。"]]}
{"id":"1ee86f9368","title":"闺情代作","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梧桐叶落鴈初归，","迢递无因寄远衣。","月照石泉金点冷，","凤酣箫管玉声微。","佳人刀杵秋风外，","荡子从征梦寐希。","遥望戌楼天欲晓，","满城冬鼓白云飞。"],"stanzas":[["梧桐叶落鴈初归，","迢递无因寄远衣。"],["月照石泉金点冷，","凤酣箫管玉声微。"],["佳人刀杵秋风外，","荡子从征梦寐希。"],["遥望戌楼天欲晓，","满城冬鼓白云飞。"]]}
{"id":"80626a9915","title":"寄沈褒秀才","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晴河万里色如刀，","处处浮云卧碧桃。","仙桂茂时金镜晓，","洛波飞处玉容高。","雄如宝劒冲牛斗，","丽似鸳鸯养羽毛。","他日忆君何处望，","九天香满碧萧骚。"],"stanzas":[["晴河万里色如刀，","处处浮云卧碧桃。"],["仙桂茂时金镜晓，","洛波飞处玉容高。"],["雄如宝劒冲牛斗，","丽似鸳鸯养羽毛。"],["他日忆君何处望，","九天香满碧萧骚。"]]}
{"id":"6583ad56af","title":"入关","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东西南北数衢通，","曾取江西径过东。","今日更寻南去路，","未秋应有北归鸿。"],"stanzas":[["东西南北数衢通，","曾取江西径过东。"],["今日更寻南去路，","未秋应有北归鸿。"]]}
{"id":"79e98cc7ad","title":"及第后寄长安故人","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东都放牓未花开，","三十三人走马回。","秦地少年多酿酒，","已将春色入关来。"],"stanzas":[["东都放牓未花开，","三十三人走马回。"],["秦地少年多酿酒，","已将春色入关来。"]]}
{"id":"3ac88fa11a","title":"偶作","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["才子风流咏晓霞，","倚楼吟住日初斜。","惊杀东隣绣床女，","错将黄晕压檀花。"],"stanzas":[["才子风流咏晓霞，","倚楼吟住日初斜。"],["惊杀东隣绣床女，","错将黄晕压檀花。"]]}
{"id":"0feea5550f","title":"赠终南兰若僧","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北阙南山是故乡，","两枝仙桂一时芳。","休公都不知名姓，","始觉禅门气味长。"],"stanzas":[["北阙南山是故乡，","两枝仙桂一时芳。"],["休公都不知名姓，","始觉禅门气味长。"]]}
{"id":"a902684fac","title":"遣怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落魄江南载酒行，","楚腰肠断掌中轻。","十年一觉扬州梦，","赢得青楼薄幸名。"],"stanzas":[["落魄江南载酒行，","楚腰肠断掌中轻。"],["十年一觉扬州梦，","赢得青楼薄幸名。"]]}
{"id":"a07ec0cd44","title":"秋感","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金风万里思何尽，","玉树一窓秋影寒。","独掩柴门明月下，","泪流香袂倚阑干。"],"stanzas":[["金风万里思何尽，","玉树一窓秋影寒。"],["独掩柴门明月下，","泪流香袂倚阑干。"]]}
{"id":"548bea4354","title":"赠渔父","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芦花深泽静垂纶，","月夕烟朝几十春。","自说孤舟寒水畔，","不曾逢著独醒人。"],"stanzas":[["芦花深泽静垂纶，","月夕烟朝几十春。"],["自说孤舟寒水畔，","不曾逢著独醒人。"]]}
{"id":"90a034dd7a","title":"叹花","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自恨寻芳到已迟，","往年曾见未开时。","如今风摆花狼籍，","绿叶成阴子满枝。"],"stanzas":[["自恨寻芳到已迟，","往年曾见未开时。"],["如今风摆花狼籍，","绿叶成阴子满枝。"]]}
{"id":"7b1a76e0d0","title":"题刘秀才新竹","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数茎幽玉色，","晓夕翠烟分。","声破寒窗梦，","根穿绿藓纹。","渐笼当槛日，","欲碍入帘云。","不是山阴客，","何人爱此君。"],"stanzas":[["数茎幽玉色，","晓夕翠烟分。"],["声破寒窗梦，","根穿绿藓纹。"],["渐笼当槛日，","欲碍入帘云。"],["不是山阴客，","何人爱此君。"]]}
{"id":"fd4ab3a92d","title":"山行","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远上寒山石径斜，","白云生处有人家。","停车坐爱枫林晚，","霜叶红于二月花。"],"stanzas":[["远上寒山石径斜，","白云生处有人家。"],["停车坐爱枫林晚，","霜叶红于二月花。"]]}
{"id":"1adcd62cc3","title":"书怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满眼青山未得过，","镜中无那鬓丝何。","秖言旋老转无事，","欲到中年事更多。"],"stanzas":[["满眼青山未得过，","镜中无那鬓丝何。"],["秖言旋老转无事，","欲到中年事更多。"]]}
{"id":"ea5c2c85bf","title":"紫薇花","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓迎秋露一枝新，","不占园中最上春。","桃李无言又何在，","向风偏笑艳阳人。"],"stanzas":[["晓迎秋露一枝新，","不占园中最上春。"],["桃李无言又何在，","向风偏笑艳阳人。"]]}
{"id":"1b0bc90ffe","title":"醉后呈崔大夫","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢傅秋凉阅管弦，","徒教贱子侍华筵。","溪头正雨归不得，","辜负东窓一觉眠。"],"stanzas":[["谢傅秋凉阅管弦，","徒教贱子侍华筵。"],["溪头正雨归不得，","辜负东窓一觉眠。"]]}
{"id":"10a21d4945","title":"和宣州沈大夫登北楼书怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兵符严重辞金马，","星劒光芒射斗牛。","笔落青山飘古韵，","帐开红斾照高秋。","香连日彩浮绡幕，","溪逐歌声绕画楼。","可惜登临佳丽地，","羽仪须去凤池游。"],"stanzas":[["兵符严重辞金马，","星劒光芒射斗牛。"],["笔落青山飘古韵，","帐开红斾照高秋。"],["香连日彩浮绡幕，","溪逐歌声绕画楼。"],["可惜登临佳丽地，","羽仪须去凤池游。"]]}
{"id":"d7cd2431a8","title":"夜雨","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九月三十日，","雨声如别秋。","无端满阶叶，","共白几人头。","点滴侵寒梦，","萧骚著淡愁。","渔歌听不唱，","蓑湿棹回舟。"],"stanzas":[["九月三十日，","雨声如别秋。"],["无端满阶叶，","共白几人头。"],["点滴侵寒梦，","萧骚著淡愁。"],["渔歌听不唱，","蓑湿棹回舟。"]]}
{"id":"f3ed6252cf","title":"方响","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数条秋水挂琅玕，","玉手丁当怕夜寒。","曲尽连敲三四下，","恐惊珠泪落金盘。"],"stanzas":[["数条秋水挂琅玕，","玉手丁当怕夜寒。"],["曲尽连敲三四下，","恐惊珠泪落金盘。"]]}
{"id":"95e63b05db","title":"将出关宿层峰驿却寄李谏议","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤驿在重阻，","云根掩柴扉。","数声暮禽切，","万壑秋意归。","心驰碧泉涧，","目断青琐闱。","明日武关外，","梦魂劳远飞。"],"stanzas":[["孤驿在重阻，","云根掩柴扉。"],["数声暮禽切，","万壑秋意归。"],["心驰碧泉涧，","目断青琐闱。"],["明日武关外，","梦魂劳远飞。"]]}
{"id":"158b6cff8a","title":"使回枉唐州崔司马书兼寄四韵因和","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清晨候吏把书来，","十载离忧得暂开。","痴叔去时还读易，","仲容多兴索衔杯。","人心计日殷勤望，","马首随云早晚回。","莫为霜台愁岁暮，","潜龙须待一声雷。"],"stanzas":[["清晨候吏把书来，","十载离忧得暂开。"],["痴叔去时还读易，","仲容多兴索衔杯。"],["人心计日殷勤望，","马首随云早晚回。"],["莫为霜台愁岁暮，","潜龙须待一声雷。"]]}
{"id":"fc44792a5d","title":"郡斋秋夜即事寄斛斯处士许秀才","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有客谁人肯夜过，","独怜风景奈愁何。","边鸿怨处迷霜久，","庭树空来见月多。","故国杳无千里信，","彩弦时伴一声歌。","驰心秖待城乌晓，","几对虚簷望白河。"],"stanzas":[["有客谁人肯夜过，","独怜风景奈愁何。"],["边鸿怨处迷霜久，","庭树空来见月多。"],["故国杳无千里信，","彩弦时伴一声歌。"],["驰心秖待城乌晓，","几对虚簷望白河。"]]}
{"id":"cf0322e787","title":"早春题真上人院","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清羸已近百年身，","古寺风烟又一春。","寰海自成戎马地，","唯师曾是太平人。"],"stanzas":[["清羸已近百年身，","古寺风烟又一春。"],["寰海自成戎马地，","唯师曾是太平人。"]]}
{"id":"6f5522e3d0","title":"对花微疾不饮呈坐中诸公","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花前虽病亦提壶，","数调持觞兴有无。","尽日临风羡人醉，","雪香空伴白髭须。"],"stanzas":[["花前虽病亦提壶，","数调持觞兴有无。"],["尽日临风羡人醉，","雪香空伴白髭须。"]]}
{"id":"f1ee77ceec","title":"酬王秀才桃花园见寄","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桃满西园淑景催，","几多红艳浅深开。","此花不逐溪流出，","晋客无因入洞来。"],"stanzas":[["桃满西园淑景催，","几多红艳浅深开。"],["此花不逐溪流出，","晋客无因入洞来。"]]}
{"id":"f8caa79215","title":"走笔送杜十三归京","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟鸿上汉声声远，","逸骥寻云步步高。","应笑内兄年六十，","郡城闲坐养霜毛。"],"stanzas":[["烟鸿上汉声声远，","逸骥寻云步步高。"],["应笑内兄年六十，","郡城闲坐养霜毛。"]]}
{"id":"305413c8fa","title":"送王十至褒中因寄尚书","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阙下经年别，","人间两地情。","坛场新汉将，","烟月古隋城。","鴈去梁山远，","云高楚岫明。","君家荷藕好，","缄恨寄遥程。"],"stanzas":[["阙下经年别，","人间两地情。"],["坛场新汉将，","烟月古隋城。"],["鴈去梁山远，","云高楚岫明。"],["君家荷藕好，","缄恨寄遥程。"]]}
{"id":"61083c5301","title":"后池泛舟送王十","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相送西郊暮景和，","青苍竹外绕寒波。","为君蘸甲十分饮，","应见离心一倍多。"],"stanzas":[["相送西郊暮景和，","青苍竹外绕寒波。"],["为君蘸甲十分饮，","应见离心一倍多。"]]}
{"id":"f9959a3fd2","title":"重送王十","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["执袂还应立马看，","向来离思始知难。","鴈飞不见行尘灭，","景下山遥极目寒。"],"stanzas":[["执袂还应立马看，","向来离思始知难。"],["鴈飞不见行尘灭，","景下山遥极目寒。"]]}
{"id":"ea98a9be08","title":"洛阳秋夕","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泠泠寒水带霜风，","更在天桥夜景中。","清禁漏闲烟树寂，","月轮移在上阳宫。"],"stanzas":[["泠泠寒水带霜风，","更在天桥夜景中。"],["清禁漏闲烟树寂，","月轮移在上阳宫。"]]}
{"id":"72c38a3521","title":"赠猎骑","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已落双雕血尚新，","鸣鞭走马又翻身。","凭君莫射南来鴈，","恐有家书寄远人。"],"stanzas":[["已落双雕血尚新，","鸣鞭走马又翻身。"],["凭君莫射南来鴈，","恐有家书寄远人。"]]}
{"id":"1a9340f56b","title":"怀吴中冯秀才","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长洲苑外草萧萧，","却筭游程岁月遥。","唯有别时今不忘，","暮烟秋雨过枫桥。"],"stanzas":[["长洲苑外草萧萧，","却筭游程岁月遥。"],["唯有别时今不忘，","暮烟秋雨过枫桥。"]]}
{"id":"648df99bd7","title":"寄东塔僧","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["初月微明漏白烟，","碧松梢外挂青天。","西风静起传深夜，","应送愁吟入夜禅。"],"stanzas":[["初月微明漏白烟，","碧松梢外挂青天。"],["西风静起传深夜，","应送愁吟入夜禅。"]]}
{"id":"265fda2797","title":"秋夕","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红烛秋光冷画屏，","轻罗小扇扑流萤。","天阶夜色凉如水，","坐看牵牛织女星。"],"stanzas":[["红烛秋光冷画屏，","轻罗小扇扑流萤。"],["天阶夜色凉如水，","坐看牵牛织女星。"]]}
{"id":"664633b175","title":"瑶瑟","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉仙瑶瑟夜珊珊，","月过楼西桂烛残。","风景人间不如此，","动摇湘水彻明寒。"],"stanzas":[["玉仙瑶瑟夜珊珊，","月过楼西桂烛残。"],["风景人间不如此，","动摇湘水彻明寒。"]]}
{"id":"fd9cfb12f7","title":"送故人归山","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三清洞里无端别，","又拂尘衣欲卧云。","看著挂冠迷处所，","北山萝月在移文。"],"stanzas":[["三清洞里无端别，","又拂尘衣欲卧云。"],["看著挂冠迷处所，","北山萝月在移文。"]]}
{"id":"59ebaaeabc","title":"闻角","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓楼烟槛出云霄，","景下林塘已寂寥。","城角为秋悲更远，","护霜云破海天遥。"],"stanzas":[["晓楼烟槛出云霄，","景下林塘已寂寥。"],["城角为秋悲更远，","护霜云破海天遥。"]]}
{"id":"568e637ec5","title":"押兵甲发谷口寄诸公","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓涧青青桂色孤，","楚人随玉上天衢。","水辞谷口山寒少，","今日风头校暖无。"],"stanzas":[["晓涧青青桂色孤，","楚人随玉上天衢。"],["水辞谷口山寒少，","今日风头校暖无。"]]}
{"id":"f04586faa7","title":"和令狐侍御赏蕙草","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寻常诗思巧如春，","又喜幽亭蕙草新。","本是馨香比君子，","绕栏今更为何人。"],"stanzas":[["寻常诗思巧如春，","又喜幽亭蕙草新。"],["本是馨香比君子，","绕栏今更为何人。"]]}
{"id":"35345155fa","title":"偶题","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道在人间或可传，","小还轻变已多年。","今来海上升高望，","不到蓬莱不是仙。"],"stanzas":[["道在人间或可传，","小还轻变已多年。"],["今来海上升高望，","不到蓬莱不是仙。"]]}
{"id":"0638a41911","title":"三川驿伏览座主舍人留题","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旧迹依然已十秋，","雪山当面照银钩。","怀恩泪尽霜天晓，","一片余霞映驿楼。"],"stanzas":[["旧迹依然已十秋，","雪山当面照银钩。"],["怀恩泪尽霜天晓，","一片余霞映驿楼。"]]}
{"id":"92278d9427","title":"陕州醉赠裴四同年","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凄风洛下同羁思，","迟日棠阴得醉歌。","自笑与君三岁别，","头衔依旧鬓丝多。"],"stanzas":[["凄风洛下同羁思，","迟日棠阴得醉歌。"],["自笑与君三岁别，","头衔依旧鬓丝多。"]]}
{"id":"d6e0720dd1","title":"破镜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳人失手镜初分，","何日团圆再会君。","今朝万里秋风起，","山北山南一片云。"],"stanzas":[["佳人失手镜初分，","何日团圆再会君。"],["今朝万里秋风起，","山北山南一片云。"]]}
{"id":"941fd20cbf","title":"长安雪后","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦陵汉苑参差雪，","北阙南山次第春。","车马满城原上去，","岂知惆怅有闲人。"],"stanzas":[["秦陵汉苑参差雪，","北阙南山次第春。"],["车马满城原上去，","岂知惆怅有闲人。"]]}
{"id":"f26ba0deb2","title":"华清宫","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["零叶飜红万树霜，","玉莲开蘂暖泉香。","行云不下朝元阁，","一曲淋铃泪数行。"],"stanzas":[["零叶飜红万树霜，","玉莲开蘂暖泉香。"],["行云不下朝元阁，","一曲淋铃泪数行。"]]}
{"id":"24ac6b01f8","title":"冬日题智门寺北楼","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满怀多少是恩酬，","未见功名已白头。","不为寻山试筋力，","岂能寒上背云楼。"],"stanzas":[["满怀多少是恩酬，","未见功名已白头。"],["不为寻山试筋力，","岂能寒上背云楼。"]]}
{"id":"d3460b0682","title":"别王十后遣京使累路附书","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重关晓度宿云寒，","羸马缘知步步难。","此信的应中路见，","乱山何处拆书看。"],"stanzas":[["重关晓度宿云寒，","羸马缘知步步难。"],["此信的应中路见，","乱山何处拆书看。"]]}
{"id":"bbcd0dd624","title":"许秀才至辱李蕲州绝句问断酒之情因寄","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有客南来话所思，","故人遥枉醉中诗。","暂因微疾须防酒，","不是欢情减旧时。"],"stanzas":[["有客南来话所思，","故人遥枉醉中诗。"],["暂因微疾须防酒，","不是欢情减旧时。"]]}
{"id":"4dbd422cad","title":"送张判官归兼谒鄂州大夫","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["处士闻名早，","游秦献疏回。","腹中书万卷，","身外酒千杯。","江雨春波阔，","园林客梦催。","今君拜旌戟，","凛凛近霜台。"],"stanzas":[["处士闻名早，","游秦献疏回。"],["腹中书万卷，","身外酒千杯。"],["江雨春波阔，","园林客梦催。"],["今君拜旌戟，","凛凛近霜台。"]]}
{"id":"2c73d9c64c","title":"宿长庆寺","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南行步步远浮尘，","更近青山昨夜隣。","高铎数声秋撼玉，","霁河千里晓横银。","红蕖影落前池净，","绿稻香来野径频。","终日官闲无一事，","不妨长醉是游人。"],"stanzas":[["南行步步远浮尘，","更近青山昨夜隣。"],["高铎数声秋撼玉，","霁河千里晓横银。"],["红蕖影落前池净，","绿稻香来野径频。"],["终日官闲无一事，","不妨长醉是游人。"]]}
{"id":"0ac259d745","title":"望少华三首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身随白日看将老，","心与青云自有期。","今对晴峰无十里，","世缘多累暗生悲。"],"stanzas":[["身随白日看将老，","心与青云自有期。"],["今对晴峰无十里，","世缘多累暗生悲。"]]}
{"id":"8203b0e029","title":"望少华三首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文字波中去不还，","物情初雨是非闲。","时名竟是无端事，","羞对灵山道爱山。"],"stanzas":[["文字波中去不还，","物情初雨是非闲。"],["时名竟是无端事，","羞对灵山道爱山。"]]}
{"id":"a719901e6e","title":"望少华三首 三","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["眼看云鹤不相随，","何况尘中事作为。","好伴羽人深洞去，","月前秋听玉参差。"],"stanzas":[["眼看云鹤不相随，","何况尘中事作为。"],["好伴羽人深洞去，","月前秋听玉参差。"]]}
{"id":"f14d32c3c9","title":"登澧州驿楼寄京兆韦尹","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一话涔阳旧使君，","郡人回首望青云。","政声长与江声在，","自到津楼日夜闻。"],"stanzas":[["一话涔阳旧使君，","郡人回首望青云。"],["政声长与江声在，","自到津楼日夜闻。"]]}
{"id":"7cfcbb08ad","title":"长安晴望","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠屏山对凤城开，","碧落摇光霁后来。","廻识六龙巡幸处，","飞烟闲绕望春台。"],"stanzas":[["翠屏山对凤城开，","碧落摇光霁后来。"],["廻识六龙巡幸处，","飞烟闲绕望春台。"]]}
{"id":"8ae51ac2bf","title":"岁旦朝回口号","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["星河犹在整朝衣，","远望天门再拜归。","笑向春风初五十，","敢言知命且知非。"],"stanzas":[["星河犹在整朝衣，","远望天门再拜归。"],["笑向春风初五十，","敢言知命且知非。"]]}
{"id":"dea405d59c","title":"骕骦骏","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瑶池罢游宴，","良乐委尘沙。","遭遇不遭遇，","盐车与鼓车。"],"stanzas":[["瑶池罢游宴，","良乐委尘沙。"],["遭遇不遭遇，","盐车与鼓车。"]]}
{"id":"4a552e68c7","title":"龙丘途中二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉苑残花别，","吴江盛夏来。","唯看万树合，","不见一枝开。"],"stanzas":[["汉苑残花别，","吴江盛夏来。"],["唯看万树合，","不见一枝开。"]]}
{"id":"50ab884add","title":"龙丘途中二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水色饶湘浦，","滩声怯建溪。","泪流回月上，","可得更猿啼。"],"stanzas":[["水色饶湘浦，","滩声怯建溪。"],["泪流回月上，","可得更猿啼。"]]}
{"id":"705b5631e7","title":"宫人冢","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尽是离宫院中女，","苑墙城外冢累累。","少年入内教歌舞，","不识君王到老时。"],"stanzas":[["尽是离宫院中女，","苑墙城外冢累累。"],["少年入内教歌舞，","不识君王到老时。"]]}
{"id":"cbeb504ee2","title":"寄浙西李判官","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕台上客意[何如]，","四五年来渐渐疎。","直道莫抛男子业，","遭时还与故人书。","青云满眼应骄我，","白发浑头少恨渠。","唯念贤哉崔大让，","可怜无事不歌鱼。"],"stanzas":[["燕台上客意[何如]，","四五年来渐渐疎。"],["直道莫抛男子业，","遭时还与故人书。"],["青云满眼应骄我，","白发浑头少恨渠。"],["唯念贤哉崔大让，","可怜无事不歌鱼。"]]}
{"id":"ee9fb67237","title":"寄杜子二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不识长杨事北胡，","且教红袖醉来扶。","狂风烈燄虽千尺，","豁得平生俊气无。"],"stanzas":[["不识长杨事北胡，","且教红袖醉来扶。"],["狂风烈燄虽千尺，","豁得平生俊气无。"]]}
{"id":"ccc8bfc82e","title":"寄杜子二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武牢关吏应相笑，","个里年年往复来。","若问使君何处去，","为言相忆首长回。"],"stanzas":[["武牢关吏应相笑，","个里年年往复来。"],["若问使君何处去，","为言相忆首长回。"]]}
{"id":"66d1281ab8","title":"卢秀才将出王屋高步名场江南相逢赠别","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["王屋山人有古文，","欲攀青桂弄氛氲。","将携健笔干明主，","莫向仙坛问白云。","驰逐宁教争处让，","是非偏忌众人分。","交游话我凭君道，","除却鲈鱼更不闻。"],"stanzas":[["王屋山人有古文，","欲攀青桂弄氛氲。"],["将携健笔干明主，","莫向仙坛问白云。"],["驰逐宁教争处让，","是非偏忌众人分。"],["交游话我凭君道，","除却鲈鱼更不闻。"]]}
{"id":"f00d201453","title":"送刘三复郎中赴阙","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["横溪辞寂寞，","金马去追游。","好是鸳鸯侣，","正逢霄汉秋。","玉珂声琐琐，","锦帐梦悠悠。","微笑知今是，","因风谢钓舟。"],"stanzas":[["横溪辞寂寞，","金马去追游。"],["好是鸳鸯侣，","正逢霄汉秋。"],["玉珂声琐琐，","锦帐梦悠悠。"],["微笑知今是，","因风谢钓舟。"]]}
{"id":"257632c07b","title":"羊栏浦夜陪宴会","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戈槛营中夜未央，","雨沾云惹侍襄王。","毬来香袖依稀暖，","酒凸斛心泛滟光。","红弦高紧声声急，","珠唱铺圆褭褭长。"],"stanzas":[["戈槛营中夜未央，","雨沾云惹侍襄王。"],["毬来香袖依稀暖，","酒凸斛心泛滟光。"],["红弦高紧声声急，","珠唱铺圆褭褭长。"]]}
{"id":"47944ce6ae","title":"送杜𫖮赴润州幕","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年才俊赴知音，","丞相门栏不觉深。","直道事人男子业，","异乡加饭弟兄心。","还须整理韦弦佩，","莫独矜夸玳瑁簪。","若去上元怀古去，","谢安坟下与沉吟。"],"stanzas":[["少年才俊赴知音，","丞相门栏不觉深。"],["直道事人男子业，","异乡加饭弟兄心。"],["还须整理韦弦佩，","莫独矜夸玳瑁簪。"],["若去上元怀古去，","谢安坟下与沉吟。"]]}
{"id":"ced9dd2b2e","title":"有感","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宛溪垂柳最长枝，","曾被春风尽日吹。","不堪攀折犹堪看，","陌上少年来自迟。"],"stanzas":[["宛溪垂柳最长枝，","曾被春风尽日吹。"],["不堪攀折犹堪看，","陌上少年来自迟。"]]}
{"id":"90179a46d5","title":"书怀寄卢州","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢山南畔州，","风物最宜秋。","太守悬金印，","佳人敞画楼。","凝缸暗醉夕，","残月上汀州。","可惜当年鬓，","朱门不得游。"],"stanzas":[["谢山南畔州，","风物最宜秋。"],["太守悬金印，","佳人敞画楼。"],["凝缸暗醉夕，","残月上汀州。"],["可惜当年鬓，","朱门不得游。"]]}
{"id":"966ade0853","title":"贺崔大夫崔正字","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内举无惭古所难，","燕台遥想拂尘冠。","登龙有路水不峻，","一鴈背飞天正寒。","别夜酒余红烛短，","映山帆满碧霞残。","谢公楼下潺湲响，","离恨诗情添几般。"],"stanzas":[["内举无惭古所难，","燕台遥想拂尘冠。"],["登龙有路水不峻，","一鴈背飞天正寒。"],["别夜酒余红烛短，","映山帆满碧霞残。"],["谢公楼下潺湲响，","离恨诗情添几般。"]]}
{"id":"01a36406a4","title":"江南送左师","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江南为客正悲秋，","更送吾师古渡头。","惆怅不同尘土别，","水云踪迹去悠悠。"],"stanzas":[["江南为客正悲秋，","更送吾师古渡头。"],["惆怅不同尘土别，","水云踪迹去悠悠。"]]}
{"id":"1cbb513a47","title":"寝夜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛩唱如波咽，","更深似水寒。","露华惊弊褐，","灯影挂尘冠。","故国初离梦，","前溪更下滩。","纷纷毫髪事，","多少宦游难。"],"stanzas":[["蛩唱如波咽，","更深似水寒。"],["露华惊弊褐，","灯影挂尘冠。"],["故国初离梦，","前溪更下滩。"],["纷纷毫髪事，","多少宦游难。"]]}
{"id":"bc5e88b412","title":"十九兄郡楼有宴病不赴","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十二层楼敞画簷，","连云歌尽草纤纤。","空堂病怯阶前月，","燕子嗔垂一竹帘。"],"stanzas":[["十二层楼敞画簷，","连云歌尽草纤纤。"],["空堂病怯阶前月，","燕子嗔垂一竹帘。"]]}
{"id":"9c2df05bb3","title":"愁","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["聚散竟无形，","回肠自结成。","古今留不得，","离别又潜生。","降虏将军思，","穷秋远客情。","何人更憔悴，","落第泣秦京。"],"stanzas":[["聚散竟无形，","回肠自结成。"],["古今留不得，","离别又潜生。"],["降虏将军思，","穷秋远客情。"],["何人更憔悴，","落第泣秦京。"]]}
{"id":"e93caa1dba","title":"隋苑","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红霞一抹广陵春，","定子当筵睡脸新。","却笑吃亏隋炀帝，","破家亡国为谁人。"],"stanzas":[["红霞一抹广陵春，","定子当筵睡脸新。"],["却笑吃亏隋炀帝，","破家亡国为谁人。"]]}
{"id":"70e2b3491a","title":"芭蕉","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芭蕉为雨移，","故向窓前种。","怜渠点滴声，","留得归乡梦。","梦远莫归乡，","觉来一翻动。"],"stanzas":[["芭蕉为雨移，","故向窓前种。"],["怜渠点滴声，","留得归乡梦。"],["梦远莫归乡，","觉来一翻动。"]]}
{"id":"a025d83d7b","title":"汴人舟行荅张祜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千万长河共使船，","听君诗句倍怆然。","春风野岸名花发，","一道帆樯画柳烟。"],"stanzas":[["千万长河共使船，","听君诗句倍怆然。"],["春风野岸名花发，","一道帆樯画柳烟。"]]}
{"id":"bb49c610fd","title":"牧陪昭应卢郎中在江西宣州佐今吏部沈公幕罢府周岁公宰昭应牧在淮南縻职叙旧成二十二韵用以投寄","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕鴈下扬州，","凉风柳陌愁。","可怜千里梦，","还是一年秋。","宛水环朱槛，","章江敞碧流。","谬陪吾益友，","祗事我贤侯。","印组萦光马，","锋铓看解牛。","井闾安乐易，","冠盖惬依投。","政简稀开阁，","功成每运筹。","送春经野坞，","迟日上高楼。","玉裂歌声断，","霞飘舞带收。","泥情斜拂印，","别脸小低头。","日晚花枝烂，","釭凝粉彩稠。","未曾孤酩酊，","剩肯只淹留。","重德俄征宠，","诸生苦宦游。","分途之绝国，","洒泪拜行辀。","聚散真漂梗，","光阴急转邮。","铭心徒历历，","屈指尽悠悠。","君作烹鲜用，","谁膺仄席求。","卷怀能愤悱，","卒岁且优游。","去矣时难遇，","沽哉价莫酬。","满枝为鼓吹，","衷甲避戈矛。","隋帝宫荒草，","秦王土一丘。","相逢好大笑，","除此总云浮。"],"stanzas":[["燕鴈下扬州，","凉风柳陌愁。"],["可怜千里梦，","还是一年秋。"],["宛水环朱槛，","章江敞碧流。"],["谬陪吾益友，","祗事我贤侯。"],["印组萦光马，","锋铓看解牛。"],["井闾安乐易，","冠盖惬依投。"],["政简稀开阁，","功成每运筹。"],["送春经野坞，","迟日上高楼。"],["玉裂歌声断，","霞飘舞带收。"],["泥情斜拂印，","别脸小低头。"],["日晚花枝烂，","釭凝粉彩稠。"],["未曾孤酩酊，","剩肯只淹留。"],["重德俄征宠，","诸生苦宦游。"],["分途之绝国，","洒泪拜行辀。"],["聚散真漂梗，","光阴急转邮。"],["铭心徒历历，","屈指尽悠悠。"],["君作烹鲜用，","谁膺仄席求。"],["卷怀能愤悱，","卒岁且优游。"],["去矣时难遇，","沽哉价莫酬。"],["满枝为鼓吹，","衷甲避戈矛。"],["隋帝宫荒草，","秦王土一丘。"],["相逢好大笑，","除此总云浮。"]]}
{"id":"e48c93e01e","title":"寓言","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖风迟日柳初含，","顾影看身又自慙。","何事明朝独惆怅，","杏花时节在江南。"],"stanzas":[["暖风迟日柳初含，","顾影看身又自慙。"],["何事明朝独惆怅，","杏花时节在江南。"]]}
{"id":"4ac17bfe4c","title":"猿","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月白烟青水暗流，","孤猿衔恨叫中秋。","三声欲断疑肠断，","饶是少年今白头。"],"stanzas":[["月白烟青水暗流，","孤猿衔恨叫中秋。"],["三声欲断疑肠断，","饶是少年今白头。"]]}
{"id":"0f71747f33","title":"怀归","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尘埃终日满牕前，","水态云容思浩然。","争得便归湘浦去，","却持竿上钓鱼船。"],"stanzas":[["尘埃终日满牕前，","水态云容思浩然。"],["争得便归湘浦去，","却持竿上钓鱼船。"]]}
{"id":"ab9f9dfe24","title":"边上晚秋","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黑山南面更无州，","马放平沙夜不收。","风送孤城临晚角，","一声声入客心愁。"],"stanzas":[["黑山南面更无州，","马放平沙夜不收。"],["风送孤城临晚角，","一声声入客心愁。"]]}
{"id":"2584a61232","title":"伤友人悼吹箫妓","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉箫声断没流年，","满目春愁陇树烟。","艳质已随云雨散，","凤楼空锁月明天。"],"stanzas":[["玉箫声断没流年，","满目春愁陇树烟。"],["艳质已随云雨散，","凤楼空锁月明天。"]]}
{"id":"efcc07520d","title":"访许颜","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门近寒溪牕近山，","枕山流水日潺潺。","长嫌世上浮云客，","老向尘中不解颜。"],"stanzas":[["门近寒溪牕近山，","枕山流水日潺潺。"],["长嫌世上浮云客，","老向尘中不解颜。"]]}
{"id":"139fd8ffcd","title":"春日古道傍作","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万古荣华旦暮齐，","楼台春尽草萋萋。","君看陌上何人墓，","旋化红尘送马蹏。"],"stanzas":[["万古荣华旦暮齐，","楼台春尽草萋萋。"],["君看陌上何人墓，","旋化红尘送马蹏。"]]}
{"id":"75738fd5e1","title":"青冢","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青冢前头陇水流，","燕支山上暮云秋。","蛾眉一坠穷泉路，","夜夜孤魂月下愁。"],"stanzas":[["青冢前头陇水流，","燕支山上暮云秋。"],["蛾眉一坠穷泉路，","夜夜孤魂月下愁。"]]}
{"id":"bc2f163d98","title":"大梦上人自庐峰回","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行脚寻常到寺稀，","一枝藜杖一禅衣。","开门满院空秋色，","新向庐峰过夏归。"],"stanzas":[["行脚寻常到寺稀，","一枝藜杖一禅衣。"],["开门满院空秋色，","新向庐峰过夏归。"]]}
{"id":"78aaf0afa7","title":"洛中二首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳动晴风拂路尘，","年年宫阙锁浓春。","一从翠辇无巡幸，","老却蛾眉几许人。"],"stanzas":[["柳动晴风拂路尘，","年年宫阙锁浓春。"],["一从翠辇无巡幸，","老却蛾眉几许人。"]]}
{"id":"716320fe81","title":"洛中二首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风吹柳带摇晴绿，","蝶绕花枝恋暖香。","多把芳菲泛春酒，","直教愁色对愁肠。"],"stanzas":[["风吹柳带摇晴绿，","蝶绕花枝恋暖香。"],["多把芳菲泛春酒，","直教愁色对愁肠。"]]}
{"id":"5c461cd9b6","title":"边上闻笳三首 一","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何处吹笳薄暮天，","塞垣高鸟没狼烟。","游人一听头堪白，","苏武争禁十九年。"],"stanzas":[["何处吹笳薄暮天，","塞垣高鸟没狼烟。"],["游人一听头堪白，","苏武争禁十九年。"]]}
{"id":"f53a1f30a5","title":"边上闻笳三首 二","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海路无尘边草新，","荣枯不见绿杨春。","白沙日暮愁云起，","独感离乡万里人。"],"stanzas":[["海路无尘边草新，","荣枯不见绿杨春。"],["白沙日暮愁云起，","独感离乡万里人。"]]}
{"id":"6b10f67bf4","title":"边上闻笳三首 三","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["胡雏吹笛上高台，","寒雁惊飞去不回。","尽日春风吹不散，","只应分付客愁来。"],"stanzas":[["胡雏吹笛上高台，","寒雁惊飞去不回。"],["尽日春风吹不散，","只应分付客愁来。"]]}
{"id":"c652c75bda","title":"春日寄许浑先辈","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蓟北雁初去，","湘南春又归。","水流沧海急，","人到白头稀。","塞路尽何处，","我愁当落晖。","终须接鸳鹭，","霄汉共高飞。"],"stanzas":[["蓟北雁初去，","湘南春又归。"],["水流沧海急，","人到白头稀。"],["塞路尽何处，","我愁当落晖。"],["终须接鸳鹭，","霄汉共高飞。"]]}
{"id":"459f4ca9ce","title":"经阖闾城","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["遗踪委衰草，","行客思悠悠。","昔日人何处，","终年水自流。","孤烟邨戌远，","乱雨海门秋。","吟罢独归去，","烟云尽惨愁。"],"stanzas":[["遗踪委衰草，","行客思悠悠。"],["昔日人何处，","终年水自流。"],["孤烟邨戌远，","乱雨海门秋。"],["吟罢独归去，","烟云尽惨愁。"]]}
{"id":"b5c942a2c1","title":"并州道中","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行役我方倦，","苦吟谁复闻。","戌楼春带雪，","边角暮吹云。","极目无人迹，","回头送鴈群。","如何遣公子，","高卧醉醺醺。"],"stanzas":[["行役我方倦，","苦吟谁复闻。"],["戌楼春带雪，","边角暮吹云。"],["极目无人迹，","回头送鴈群。"],["如何遣公子，","高卧醉醺醺。"]]}
{"id":"6956e2ce4e","title":"别怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相别徒成泣，","经过总是空。","劳生惯离别，","夜梦苦西东。","去路三湘浪，","归程一片风。","他年寄消息，","书在鲤鱼中。"],"stanzas":[["相别徒成泣，","经过总是空。"],["劳生惯离别，","夜梦苦西东。"],["去路三湘浪，","归程一片风。"],["他年寄消息，","书在鲤鱼中。"]]}
{"id":"94e7be6d9e","title":"渔父","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白发沧浪上，","全忘是与非。","秋潭垂钓去，","夜月叩船归。","烟影侵芦岸，","潮痕在竹扉。","终年狎鸥鸟，","来去且无机。"],"stanzas":[["白发沧浪上，","全忘是与非。"],["秋潭垂钓去，","夜月叩船归。"],["烟影侵芦岸，","潮痕在竹扉。"],["终年狎鸥鸟，","来去且无机。"]]}
{"id":"770e8fca6e","title":"秋梦","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒空动高吹，","月色满清砧。","残梦夜魂断，","美人边思深。","孤鸿秋出塞，","一叶暗辞林。","又寄征衣去，","迢迢天外心。"],"stanzas":[["寒空动高吹，","月色满清砧。"],["残梦夜魂断，","美人边思深。"],["孤鸿秋出塞，","一叶暗辞林。"],["又寄征衣去，","迢迢天外心。"]]}
{"id":"f8e724e292","title":"早秋客舍","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风吹一片叶，","万物已惊秋。","独夜他乡泪，","年年为客愁。","别离何处尽，","摇落几时休。","不及磻溪叟，","身闲长自由。"],"stanzas":[["风吹一片叶，","万物已惊秋。"],["独夜他乡泪，","年年为客愁。"],["别离何处尽，","摇落几时休。"],["不及磻溪叟，","身闲长自由。"]]}
{"id":"87e5f12914","title":"逢故人","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故交相见稀，","相见倍依依。","尘路事不尽，","云岩闲好归。","投人销壮志，","徇俗变真机。","又落他乡泪，","风前一满衣。"],"stanzas":[["故交相见稀，","相见倍依依。"],["尘路事不尽，","云岩闲好归。"],["投人销壮志，","徇俗变真机。"],["又落他乡泪，","风前一满衣。"]]}
{"id":"05fc0a96c5","title":"秋晚江上遣怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤舟天际外，","去路望中赊。","贫病远行客，","梦魂多在家。","蝉吟秋色树，","鸦噪夕阳沙。","不拟彻双鬓，","他方掷岁华。"],"stanzas":[["孤舟天际外，","去路望中赊。"],["贫病远行客，","梦魂多在家。"],["蝉吟秋色树，","鸦噪夕阳沙。"],["不拟彻双鬓，","他方掷岁华。"]]}
{"id":"d1baf24104","title":"长安夜月","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒光垂静夜，","皓彩满重城。","万国尽分照，","谁家无此明。","古槐疎影薄，","仙桂动秋声。","独有长门里，","蛾眉对晓晴。"],"stanzas":[["寒光垂静夜，","皓彩满重城。"],["万国尽分照，","谁家无此明。"],["古槐疎影薄，","仙桂动秋声。"],["独有长门里，","蛾眉对晓晴。"]]}
{"id":"8c4a0f9da1","title":"云","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东西那有碍，","出处岂虚心。","晓入洞庭阔，","暮归巫峡深。","渡江随鸟影，","拥树隔猿吟。","莫隐高唐去，","枯苗待作霖。"],"stanzas":[["东西那有碍，","出处岂虚心。"],["晓入洞庭阔，","暮归巫峡深。"],["渡江随鸟影，","拥树隔猿吟。"],["莫隐高唐去，","枯苗待作霖。"]]}
{"id":"87bf2f5d8f","title":"春怀","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年光何太急，","倏忽又青春。","明月谁为主，","江山暗换人。","莺花潜运老，","荣乐渐成尘。","遥忆朱门柳，","别离应更频。"],"stanzas":[["年光何太急，","倏忽又青春。"],["明月谁为主，","江山暗换人。"],["莺花潜运老，","荣乐渐成尘。"],["遥忆朱门柳，","别离应更频。"]]}
{"id":"2b5ba2f288","title":"逢故人","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年年不相见，","相见却成悲。","教我泪如霰，","嗟君髪似丝。","正伤携手处，","况值落花时。","莫惜今宵醉，","人间忽忽期。"],"stanzas":[["年年不相见，","相见却成悲。"],["教我泪如霰，","嗟君髪似丝。"],["正伤携手处，","况值落花时。"],["莫惜今宵醉，","人间忽忽期。"]]}
{"id":"54e981d98d","title":"闲题","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["男儿所在即为家，","百镒黄金一朵花。","借问春风何处好，","绿杨深巷马头斜。"],"stanzas":[["男儿所在即为家，","百镒黄金一朵花。"],["借问春风何处好，","绿杨深巷马头斜。"]]}
{"id":"03dc4e314f","title":"金谷园","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["繁华事散逐香尘，","流水无情草自春。","日暮东风怨啼鸟，","落花犹似堕楼人。"],"stanzas":[["繁华事散逐香尘，","流水无情草自春。"],["日暮东风怨啼鸟，","落花犹似堕楼人。"]]}
{"id":"c9a905393a","title":"重登科","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["星汉离宫月出轮，","满街含笑绮罗春。","花前每被青蛾问，","何事重来只一人。"],"stanzas":[["星汉离宫月出轮，","满街含笑绮罗春。"],["花前每被青蛾问，","何事重来只一人。"]]}
{"id":"8c7971b0bf","title":"游边","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄沙连海路无尘，","边草长枯不见春。","日暮拂云堆下过，","马前逢著射雕人。"],"stanzas":[["黄沙连海路无尘，","边草长枯不见春。"],["日暮拂云堆下过，","马前逢著射雕人。"]]}
{"id":"601438817d","title":"将赴池州道中作","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青阳云水去年寻，","黄绢歌诗出翰林。","投辖暂停留酒客，","绛帷斜系满松阴。","妖人笑我不相问，","道者应知归路心。","南去南来尽乡国，","月明秋水只沈沈。"],"stanzas":[["青阳云水去年寻，","黄绢歌诗出翰林。"],["投辖暂停留酒客，","绛帷斜系满松阴。"],["妖人笑我不相问，","道者应知归路心。"],["南去南来尽乡国，","月明秋水只沈沈。"]]}
{"id":"db266fff7a","title":"隋宫春","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙舟东下事成空，","蔓草萋萋满故宫。","亡国亡家为颜色，","露桃犹自恨春风。"],"stanzas":[["龙舟东下事成空，","蔓草萋萋满故宫。"],["亡国亡家为颜色，","露桃犹自恨春风。"]]}
{"id":"2c39c017ba","title":"蛮中醉","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瘴塞蛮江入洞流，","人家多在竹棚头。","青山海上无城郭，","唯见松牌出象州。"],"stanzas":[["瘴塞蛮江入洞流，","人家多在竹棚头。"],["青山海上无城郭，","唯见松牌出象州。"]]}
{"id":"5d85e04133","title":"寓题","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["把酒直须判酩酊，","逢花莫惜暂淹留。","假如三万六千日，","半是悲哀半是愁。"],"stanzas":[["把酒直须判酩酊，","逢花莫惜暂淹留。"],["假如三万六千日，","半是悲哀半是愁。"]]}
{"id":"b12ce180e2","title":"送赵十二赴举","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["省事却因多事力，","无心翻似有心来。","秋风郡阁残花在，","别后何人更一杯。"],"stanzas":[["省事却因多事力，","无心翻似有心来。"],["秋风郡阁残花在，","别后何人更一杯。"]]}
{"id":"d5d6dd8f12","title":"偶呈郑先辈","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不语亭亭俨薄粧，","画裙双凤郁金香。","西京才子旁看取，","何似乔家郍窈娘。"],"stanzas":[["不语亭亭俨薄粧，","画裙双凤郁金香。"],["西京才子旁看取，","何似乔家郍窈娘。"]]}
{"id":"d32b081ddd","title":"子规","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀地曾闻子规鸟，","宣城又见杜鹃花。","一呌一回肠一断，","三春三月忆三巴。"],"stanzas":[["蜀地曾闻子规鸟，","宣城又见杜鹃花。"],["一呌一回肠一断，","三春三月忆三巴。"]]}
{"id":"eb6dbc4a6d","title":"江楼","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独酌芳春酒，","登楼已半醺。","谁惊一行雁，","冲断过江云。"],"stanzas":[["独酌芳春酒，","登楼已半醺。"],["谁惊一行雁，","冲断过江云。"]]}
{"id":"857ffd3e08","title":"旅宿","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旅馆无良伴，","凝情自悄然。","寒灯思旧事，","断鴈警愁眠。","远梦归侵晓，","家书到隔年。","湘江好烟月，","门系钓鱼船。"],"stanzas":[["旅馆无良伴，","凝情自悄然。"],["寒灯思旧事，","断鴈警愁眠。"],["远梦归侵晓，","家书到隔年。"],["湘江好烟月，","门系钓鱼船。"]]}
{"id":"baa22e9c35","title":"杜鹃","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杜宇竟何冤，","年年呌蜀门。","至今衔积恨，","终古吊残魂。","芳草迷肠结，","红花染血痕。","山川尽春色，","呜咽复谁论。"],"stanzas":[["杜宇竟何冤，","年年呌蜀门。"],["至今衔积恨，","终古吊残魂。"],["芳草迷肠结，","红花染血痕。"],["山川尽春色，","呜咽复谁论。"]]}
{"id":"9c7d16169d","title":"闻蝉","author":"杜牧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["火云初似灭，","晓角欲微清。","故国行千里，","新蝉忽数声。","时行仍髣髴，","度日更分明。","不敢频倾耳，","唯忧白发生。"],"stanzas":[["火云初似灭，","晓角欲微清。"],["故国行千里，","新蝉忽数声。"],["时行仍髣髴，","度日更分明。"],["不敢频倾耳，","唯忧白发生。"]]}
