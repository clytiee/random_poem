{"id":"1cf76e099b","title":"寄太仆田卿二首 二","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一阳才动伏群阴，","万物于今寓太音。","若喜长生添线日，","微微消息识天心。"],"stanzas":[["一阳才动伏群阴，","万物于今寓太音。"],["若喜长生添线日，","微微消息识天心。"]]}
{"id":"fd585d0432","title":"新昌井","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["辘轳千转劳筋力，","待得甘泉渴杀人。","且共山麋同饮涧，","玉沙铺底浅磷磷。"],"stanzas":[["辘轳千转劳筋力，","待得甘泉渴杀人。"],["且共山麋同饮涧，","玉沙铺底浅磷磷。"]]}
{"id":"584084fbf9","title":"经靖安里","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巷底萧萧绝市尘，","供愁疎雨打黄昏。","悠然一曲泉明调，","浅立闲愁轻闭门。"],"stanzas":[["巷底萧萧绝市尘，","供愁疎雨打黄昏。"],["悠然一曲泉明调，","浅立闲愁轻闭门。"]]}
{"id":"4fbb9a6992","title":"闻筝歌","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凄凄切切断肠声，","指滑音柔万种情。","花影深沉遮不住，","度帏穿幕又残更。"],"stanzas":[["凄凄切切断肠声，","指滑音柔万种情。"],["花影深沉遮不住，","度帏穿幕又残更。"]]}
{"id":"b04a97a36f","title":"吹笙歌","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伶儿竹声愁绕空，","秦女泪湿燕支红。","玉桃花片落不住，","三十六簧能唤风。"],"stanzas":[["伶儿竹声愁绕空，","秦女泪湿燕支红。"],["玉桃花片落不住，","三十六簧能唤风。"]]}
{"id":"27e7cb165d","title":"赠歌人郭婉二首 一","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石家金谷旧歌人，","起唱花筵泪满巾。","红粉少年诸弟子，","一时惆怅望梁尘。"],"stanzas":[["石家金谷旧歌人，","起唱花筵泪满巾。"],["红粉少年诸弟子，","一时惆怅望梁尘。"]]}
{"id":"0ef990f3ac","title":"赠歌人郭婉二首 二","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云满衣裳月满身，","轻盈归步过流尘。","五更无限留连意，","常恐风花又一春。"],"stanzas":[["云满衣裳月满身，","轻盈归步过流尘。"],["五更无限留连意，","常恐风花又一春。"]]}
{"id":"dd04ec6bed","title":"潭州席上赠舞柘枝妓","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姑苏太守青娥女，","流落长沙舞柘枝。","坐满绣衣皆不识，","可怜红脸泪双垂。"],"stanzas":[["姑苏太守青娥女，","流落长沙舞柘枝。"],["坐满绣衣皆不识，","可怜红脸泪双垂。"]]}
{"id":"441ec6f24c","title":"句","author":"殷尧藩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瘴雨出虹𬟽，","蛮烟渡江急。","尝闻岛夷俗，","犀象满城邑。"],"stanzas":[["瘴雨出虹𬟽，","蛮烟渡江急。"],["尝闻岛夷俗，","犀象满城邑。"]]}
{"id":"1098c3b1ed","title":"虎丘山真娘墓","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金钗沦劒壑，","兹地似花台。","油壁何人值，","钱塘度曲哀。","翠余长染柳，","香重欲薰梅。","但道行云去，","应随魂梦来。"],"stanzas":[["金钗沦劒壑，","兹地似花台。"],["油壁何人值，","钱塘度曲哀。"],["翠余长染柳，","香重欲薰梅。"],["但道行云去，","应随魂梦来。"]]}
{"id":"acbf338594","title":"荅殷尧藩赠罢泾源记室","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劳君辍雅话，","听说事疆场。","提笔从征虏，","飞书始伏羌。","河流辞马岭，","节卧听龙骧。","孤负平生劒，","空怜射斗光。"],"stanzas":[["劳君辍雅话，","听说事疆场。"],["提笔从征虏，","飞书始伏羌。"],["河流辞马岭，","节卧听龙骧。"],["孤负平生劒，","空怜射斗光。"]]}
{"id":"55860a8064","title":"五月六日发石头城步望前船示舍弟兼寄侯郎","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["客子去淮阳，","逶迤别梦长。","水关开夜锁，","雾櫂起晨凉。","烟月期同赏，","风波勿异行。","隐山曾撼橹，","转濑指遥樯。","蒲叶吴刀绿，","筠筒楚粽香。","因书报惠远，","为我忆檀郎。"],"stanzas":[["客子去淮阳，","逶迤别梦长。"],["水关开夜锁，","雾櫂起晨凉。"],["烟月期同赏，","风波勿异行。"],["隐山曾撼橹，","转濑指遥樯。"],["蒲叶吴刀绿，","筠筒楚粽香。"],["因书报惠远，","为我忆檀郎。"]]}
{"id":"c6ba1e71fe","title":"别庞子肃","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自为应仙才，","丹砂炼几回。","山秋梦桂树，","月晓忆瑶台。","雨雪依岩避，","烟云逐步开。","今朝龙杖去，","早晚鹤书来。"],"stanzas":[["自为应仙才，","丹砂炼几回。"],["山秋梦桂树，","月晓忆瑶台。"],["雨雪依岩避，","烟云逐步开。"],["今朝龙杖去，","早晚鹤书来。"]]}
{"id":"7a215797fa","title":"春色满皇州","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何处春辉好，","偏宜在雍州。","花明夹城道，","柳暗曲江头。","风软游丝重，","光融瑞气浮。","鬬鸡怜短草，","乳燕傍高楼。","绣毂盈香陌，","新泉溢御沟。","回看日欲暮，","还骑似川流。"],"stanzas":[["何处春辉好，","偏宜在雍州。"],["花明夹城道，","柳暗曲江头。"],["风软游丝重，","光融瑞气浮。"],["鬬鸡怜短草，","乳燕傍高楼。"],["绣毂盈香陌，","新泉溢御沟。"],["回看日欲暮，","还骑似川流。"]]}
{"id":"9d84270487","title":"宿白马津寄寇立","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["客思听蛩嗟，","秋怀似乱砂。","劒头悬日影，","蝇鼻落灯花。","天外归鸿断，","漳南别路赊。","闻君同旅舍，","几得梦还家。"],"stanzas":[["客思听蛩嗟，","秋怀似乱砂。"],["劒头悬日影，","蝇鼻落灯花。"],["天外归鸿断，","漳南别路赊。"],["闻君同旅舍，","几得梦还家。"]]}
{"id":"7a4fb12102","title":"汴州船行赋岸傍所见","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古木晓苍苍，","秋林拂岸香。","露珠虫网细，","金缕兔丝长。","秋浪时回沫，","惊鳞乍触航。","蓬烟拈绿线，","棘实缀红囊。","乱穗摇鼯尾，","出根挂凤肠。","聊持一濯足，","谁道比沧浪。"],"stanzas":[["古木晓苍苍，","秋林拂岸香。"],["露珠虫网细，","金缕兔丝长。"],["秋浪时回沫，","惊鳞乍触航。"],["蓬烟拈绿线，","棘实缀红囊。"],["乱穗摇鼯尾，","出根挂凤肠。"],["聊持一濯足，","谁道比沧浪。"]]}
{"id":"bcd16e1bb8","title":"送文颕上人游天台","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["露花浮翠瓦，","鲜思起芳丛。","此际断客梦，","况复别志公。","既历天台去，","言过赤城东。","莫说人间事，","崎岖尘土中。"],"stanzas":[["露花浮翠瓦，","鲜思起芳丛。"],["此际断客梦，","况复别志公。"],["既历天台去，","言过赤城东。"],["莫说人间事，","崎岖尘土中。"]]}
{"id":"4b70dbc35b","title":"宿后自华阳行次昭应寄王直方","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重归能几日，","物意早如春。","暖色先骊岫，","寒声别鴈群。","川光如戏劒，","帆态似翔云。","为报东园蝶，","南枝日已曛。"],"stanzas":[["重归能几日，","物意早如春。"],["暖色先骊岫，","寒声别鴈群。"],["川光如戏劒，","帆态似翔云。"],["为报东园蝶，","南枝日已曛。"]]}
{"id":"619c1bb82f","title":"题海榴树呈八叔大人","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾在蓬壶伴众仙，","文章枝叶五云边。","几时奉宴瑶台下，","何日移荣玉砌前。","染日裁霞深雨露，","凌寒送暖占风烟。","应笑强如河畔柳，","逢波逐浪送张骞。"],"stanzas":[["曾在蓬壶伴众仙，","文章枝叶五云边。"],["几时奉宴瑶台下，","何日移荣玉砌前。"],["染日裁霞深雨露，","凌寒送暖占风烟。"],["应笑强如河畔柳，","逢波逐浪送张骞。"]]}
{"id":"6aee54a199","title":"西蕃请谒庙","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["肃肃层城里，","巍巍祖庙清。","圣恩覃布濩，","异域献精诚。","冠盖分行列，","戎夷辨姓名。","礼终齐百拜，","心洁表忠贞。","瑞气千重色，","箫韶九奏声。","杖移迎日转，","旌动逐风轻。","休运威仪正，","年推俎豆盈。","不才慙圣泽，","空此望华缨。"],"stanzas":[["肃肃层城里，","巍巍祖庙清。"],["圣恩覃布濩，","异域献精诚。"],["冠盖分行列，","戎夷辨姓名。"],["礼终齐百拜，","心洁表忠贞。"],["瑞气千重色，","箫韶九奏声。"],["杖移迎日转，","旌动逐风轻。"],["休运威仪正，","年推俎豆盈。"],["不才慙圣泽，","空此望华缨。"]]}
{"id":"a3d7d62141","title":"劝政楼下观百官献寿","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御气黄花节，","临轩紫陌头。","早阳生彩杖，","霁色入仙楼。","献寿皆鸳鹭，","瞻天在冕旒。","菊尊开九日，","凤历启千秋。","乐阕祥烟起，","杯酣瑞影收。","年年歌舞夕，","此地庆皇休。"],"stanzas":[["御气黄花节，","临轩紫陌头。"],["早阳生彩杖，","霁色入仙楼。"],["献寿皆鸳鹭，","瞻天在冕旒。"],["菊尊开九日，","凤历启千秋。"],["乐阕祥烟起，","杯酣瑞影收。"],["年年歌舞夕，","此地庆皇休。"]]}
{"id":"9cc097ce19","title":"山出云","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["片云朝出岫，","孤色逈难亲。","盖小辞山早，","根轻触石新。","飘扬经绿野，","明丽照青春。","拂树疑舒叶，","临江似结鳞。","从龙方有感，","捧日岂无因。","看助为霖去，","恩沾雨露均。"],"stanzas":[["片云朝出岫，","孤色逈难亲。"],["盖小辞山早，","根轻触石新。"],["飘扬经绿野，","明丽照青春。"],["拂树疑舒叶，","临江似结鳞。"],["从龙方有感，","捧日岂无因。"],["看助为霖去，","恩沾雨露均。"]]}
{"id":"e02c41d8a2","title":"曲江亭望慈恩杏花发","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曲台晴好望，","近接梵王家。","十亩开金地，","千株发杏花。","带云犹误雪，","映日欲欺霞。","紫陌传香远，","红泉落影斜。","园中春尚早，","亭上路非赊。","芳景偏堪赏，","其如积岁华。"],"stanzas":[["曲台晴好望，","近接梵王家。"],["十亩开金地，","千株发杏花。"],["带云犹误雪，","映日欲欺霞。"],["紫陌传香远，","红泉落影斜。"],["园中春尚早，","亭上路非赊。"],["芳景偏堪赏，","其如积岁华。"]]}
{"id":"de3d9e1311","title":"村居","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有树巢宿鸟，","无酒共客醉。","月上蝉韵残，","梧桐阴绕地。","独出村舍门，","吟剧微风起。","萧萧芦荻丛，","呌啸如山鬼。","应缘我憔悴，","为我哭秋思。"],"stanzas":[["有树巢宿鸟，","无酒共客醉。"],["月上蝉韵残，","梧桐阴绕地。"],["独出村舍门，","吟剧微风起。"],["萧萧芦荻丛，","呌啸如山鬼。"],["应缘我憔悴，","为我哭秋思。"]]}
{"id":"f46412c3b7","title":"春词酬元微之","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄莺啼时春日高，","红芳发尽井边桃。","美人手暖裁衣易，","片片轻花落翦刀。"],"stanzas":[["黄莺啼时春日高，","红芳发尽井边桃。"],["美人手暖裁衣易，","片片轻花落翦刀。"]]}
{"id":"c69ca73d6b","title":"题侯仙亭","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新创仙亭覆石坛，","雕梁峻宇入云端。","岭北啸猨高枕听，","湖南山色卷帘看。"],"stanzas":[["新创仙亭覆石坛，","雕梁峻宇入云端。"],["岭北啸猨高枕听，","湖南山色卷帘看。"]]}
{"id":"49218b4e0f","title":"送庞子肃","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三年游宦也迷津，","马困长安九陌尘。","都作无成不归去，","古来妻嫂笑苏秦。"],"stanzas":[["三年游宦也迷津，","马困长安九陌尘。"],["都作无成不归去，","古来妻嫂笑苏秦。"]]}
{"id":"8543fdb104","title":"梦挽秦弄玉","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泣葬一枝红，","生同死不同。","金钿坠芳草，","香绣满春风。","旧日闻箫处，","高楼当月中。","梨花寒食夜，","深闭翠微宫。"],"stanzas":[["泣葬一枝红，","生同死不同。"],["金钿坠芳草，","香绣满春风。"],["旧日闻箫处，","高楼当月中。"],["梨花寒食夜，","深闭翠微宫。"]]}
{"id":"27b15e61a8","title":"梦别秦穆公","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["击髆舞，","恨满烟光无处所。","泪如雨，","欲拟著辞不成语。","金凤衔红旧绣衣，","几度宫中同看舞。","人间春日正欢乐，","日暮东风何处去。"],"stanzas":[["击髆舞，","恨满烟光无处所。"],["泪如雨，","欲拟著辞不成语。"],["金凤衔红旧绣衣，","几度宫中同看舞。"],["人间春日正欢乐，","日暮东风何处去。"]]}
{"id":"d98176dae9","title":"梦游秦宫","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君王多感放东归，","从此秦宫不复期。","春景似伤秦丧主，","落花如雨泪臙脂。"],"stanzas":[["君王多感放东归，","从此秦宫不复期。"],["春景似伤秦丧主，","落花如雨泪臙脂。"]]}
{"id":"4b97e0ed24","title":"湘中怨 一","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["隆佳秀兮昭盛时，","播薰绿兮淑华归。","顾室荑与处蕚兮，","潜重房以饰姿。","见稚态之韶羞兮，","蒙长霭以为帏。","醉融光兮渺渺弥弥，","迷千里兮涵烟眉。","晨陶陶兮暮熙熙，","舞婑那之秾条兮。","骋盈盈以披迟，","酡游颜兮倡蔓卉縠，","流蒨霓兮石发髓旎。"],"stanzas":[["隆佳秀兮昭盛时，","播薰绿兮淑华归。"],["顾室荑与处蕚兮，","潜重房以饰姿。"],["见稚态之韶羞兮，","蒙长霭以为帏。"],["醉融光兮渺渺弥弥，","迷千里兮涵烟眉。"],["晨陶陶兮暮熙熙，","舞婑那之秾条兮。"],["骋盈盈以披迟，","酡游颜兮倡蔓卉縠，","流蒨霓兮石发髓旎。"]]}
{"id":"5f9705f212","title":"湘中怨 二","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溯青山兮江之隅，","拖湘波兮褭绿裾。","荷拳拳兮未舒，","匪同归兮将焉[如]。"],"stanzas":[["溯青山兮江之隅，","拖湘波兮褭绿裾。"],["荷拳拳兮未舒，","匪同归兮将焉[如]。"]]}
{"id":"58d92271a9","title":"文祝延二阕 一","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闽山之杭杭兮水堋堋，","吞荒抱大兮香叠层。","腾气清浑兮朝昏，","神生其中兮宅幽凝。","居如山兮惠如水，","处端卓兮赴下而忘鄙。","集人之祈兮从人之所市，","攀清明兮叩髣髴。","我民清兮期吉日，","愿听诚兮陈所当。","侯临我兮恩如光，","照导兮天覆。","惠流吾兮乐且康，","恭闻侯兮饮食失常。","民萦忧兮心苦疮，","饱我之饥兮侯由有谷。","神有泽兮宜荫沃，","脱侯之恙兮归侯之多福。","群卑勤之恭洁兮，","鉴贞盟乎山竹。"],"stanzas":[["闽山之杭杭兮水堋堋，","吞荒抱大兮香叠层。"],["腾气清浑兮朝昏，","神生其中兮宅幽凝。"],["居如山兮惠如水，","处端卓兮赴下而忘鄙。"],["集人之祈兮从人之所市，","攀清明兮叩髣髴。"],["我民清兮期吉日，","愿听诚兮陈所当。"],["侯临我兮恩如光，","照导兮天覆。"],["惠流吾兮乐且康，","恭闻侯兮饮食失常。"],["民萦忧兮心苦疮，","饱我之饥兮侯由有谷。"],["神有泽兮宜荫沃，","脱侯之恙兮归侯之多福。"],["群卑勤之恭洁兮，","鉴贞盟乎山竹。"]]}
{"id":"a14a7d10d5","title":"文祝延二阕 二","author":"沈亚之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兕载吹兮音咿咿，","铜铙呶兮睋呼𪾤睢。","樟之盖兮麓下，","云垂幄兮为帷。","合吾民兮将安，","维吾侯之康兮乐欣。","肴盘列兮荅神，","神摆渔篁兮降拂窣窣。","右持妓兮左夫人，","态修邃兮佻眇。","调丹含琼兮瑳佳笑，","馨炮膻燔兮溢按豆。","爵盎无虚兮菓摭杂佑，","秋云清醉兮流融光。","巫裾旋兮觋袖翔，","瞪虚凝兮览回杨。","语神欢兮酒云央，","望吾侯兮遵赏事。","朝马驾兮搦宝辔，","千弭函弦兮森道骑。","吾何乐兮神轩，","维侯之康兮居游自遂。"],"stanzas":[["兕载吹兮音咿咿，","铜铙呶兮睋呼𪾤睢。"],["樟之盖兮麓下，","云垂幄兮为帷。"],["合吾民兮将安，","维吾侯之康兮乐欣。"],["肴盘列兮荅神，","神摆渔篁兮降拂窣窣。"],["右持妓兮左夫人，","态修邃兮佻眇。"],["调丹含琼兮瑳佳笑，","馨炮膻燔兮溢按豆。"],["爵盎无虚兮菓摭杂佑，","秋云清醉兮流融光。"],["巫裾旋兮觋袖翔，","瞪虚凝兮览回杨。"],["语神欢兮酒云央，","望吾侯兮遵赏事。"],["朝马驾兮搦宝辔，","千弭函弦兮森道骑。"],["吾何乐兮神轩，","维侯之康兮居游自遂。"]]}
{"id":"67b9679cd6","title":"及第后过杨子江","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忆昔将贡年，","抱愁此江边。","鱼龙互闪烁，","黑浪高于天。","今日步春草，","复来经此道。","江神也世情，","为我风色好。"],"stanzas":[["忆昔将贡年，","抱愁此江边。"],["鱼龙互闪烁，","黑浪高于天。"],["今日步春草，","复来经此道。"],["江神也世情，","为我风色好。"]]}
{"id":"dac7f932e8","title":"夜宴曲","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兰缸如昼晓不眠，","玉堂夜起沉香烟。","青娥一行十二仙，","欲笑不笑桃花然。","碧窗弄娇梳洗晚，","户外不知银汉转。","被郎嗔罚琉璃盏，","酒入四肢红玉软。"],"stanzas":[["兰缸如昼晓不眠，","玉堂夜起沉香烟。"],["青娥一行十二仙，","欲笑不笑桃花然。"],["碧窗弄娇梳洗晚，","户外不知银汉转。"],["被郎嗔罚琉璃盏，","酒入四肢红玉软。"]]}
{"id":"f49eb42aad","title":"効古兴","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金雀无旧钗，","缃绮无旧裾。","唯有一寸心，","长贮万里夫。","南轩夜虫织已促，","北牖飞蛾绕残烛。","祗言众口铄千金，","谁信独愁销片玉。","不知岁晚归不归，","又将啼眼缝征衣。"],"stanzas":[["金雀无旧钗，","缃绮无旧裾。"],["唯有一寸心，","长贮万里夫。"],["南轩夜虫织已促，","北牖飞蛾绕残烛。"],["祗言众口铄千金，","谁信独愁销片玉。"],["不知岁晚归不归，","又将啼眼缝征衣。"]]}
{"id":"e04345721d","title":"古别离二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古人谩歌西飞燕，","十年不见狂夫面。","三更风作切梦刀，","万转愁成系肠线。","所嗟不及牛女星，","一年一度得相见。"],"stanzas":[["古人谩歌西飞燕，","十年不见狂夫面。"],["三更风作切梦刀，","万转愁成系肠线。"],["所嗟不及牛女星，","一年一度得相见。"]]}
{"id":"094f37d58b","title":"古别离二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老母别爱子，","少妻送征郎。","血流既四面，","乃一断二肠。","不愁寒无衣，","不怕饥无粮。","惟恐征战不还乡，","母化为鬼妻为孀。"],"stanzas":[["老母别爱子，","少妻送征郎。"],["血流既四面，","乃一断二肠。"],["不愁寒无衣，","不怕饥无粮。"],["惟恐征战不还乡，","母化为鬼妻为孀。"]]}
{"id":"a810e7d99f","title":"壮士行","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一斗之胆撑脏腑，","如磥之筋碍臂骨。","有时悮入千人丛，","自觉一身横突兀。","当今四海无烟尘，","胸襟被压不得伸。","冻枭残虿我不取，","汚我匣里青蛇鳞。"],"stanzas":[["一斗之胆撑脏腑，","如磥之筋碍臂骨。"],["有时悮入千人丛，","自觉一身横突兀。"],["当今四海无烟尘，","胸襟被压不得伸。"],["冻枭残虿我不取，","汚我匣里青蛇鳞。"]]}
{"id":"e249d17e60","title":"代征妇怨","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒窗羞见影相随，","嫁得五陵轻薄儿。","长短艳歌君自解，","浅深更漏妾偏知。","画裙多泪鸳鸯湿，","云鬓慵梳玳瑁垂。","何事不看霜雪里，","坚贞惟有古松枝。"],"stanzas":[["寒窗羞见影相随，","嫁得五陵轻薄儿。"],["长短艳歌君自解，","浅深更漏妾偏知。"],["画裙多泪鸳鸯湿，","云鬓慵梳玳瑁垂。"],["何事不看霜雪里，","坚贞惟有古松枝。"]]}
{"id":"e508cea38a","title":"送人南游","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["见说南行偏不易，","中途莫忘寄书频。","凌空瘴气堕飞鸟，","解语山魈恼病人。","闽县绿娥能引客，","泉州乌药好防身。","异花奇竹分明看，","待汝归来画取真。"],"stanzas":[["见说南行偏不易，","中途莫忘寄书频。"],["凌空瘴气堕飞鸟，","解语山魈恼病人。"],["闽县绿娥能引客，","泉州乌药好防身。"],["异花奇竹分明看，","待汝归来画取真。"]]}
{"id":"6483dcbd61","title":"赠边将","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轻生奉国不为难，","战苦身多旧箭瘢。","玉匣锁龙鳞甲冷，","金铃衬鹘羽毛寒。","皂貂拥出花当背，","白马骑来月在鞍。","犹恐犬戎临虏塞，","柳营时把阵图看。"],"stanzas":[["轻生奉国不为难，","战苦身多旧箭瘢。"],["玉匣锁龙鳞甲冷，","金铃衬鹘羽毛寒。"],["皂貂拥出花当背，","白马骑来月在鞍。"],["犹恐犬戎临虏塞，","柳营时把阵图看。"]]}
{"id":"bb5403bfda","title":"上礼部侍郎陈情","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九重城里无亲识，","八百人中独姓施。","弱羽飞时攒箭险，","蹇驴行处薄冰危。","晴天欲照盆难反，","贫女如花镜不知。","却向从来受恩地，","再求青律变寒枝。"],"stanzas":[["九重城里无亲识，","八百人中独姓施。"],["弱羽飞时攒箭险，","蹇驴行处薄冰危。"],["晴天欲照盆难反，","贫女如花镜不知。"],["却向从来受恩地，","再求青律变寒枝。"]]}
{"id":"79dd9a8279","title":"早春残雪","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春景照林峦，","玲珑雪影残。","井泉添碧甃，","药圃洗朱栏。","云路迷初醒，","书堂映渐难。","花分梅岭色，","尘减玉堦寒。","远称栖松鹤，","高宜点露盘。","伫逢春律后，","阴谷始堪看。"],"stanzas":[["春景照林峦，","玲珑雪影残。"],["井泉添碧甃，","药圃洗朱栏。"],["云路迷初醒，","书堂映渐难。"],["花分梅岭色，","尘减玉堦寒。"],["远称栖松鹤，","高宜点露盘。"],["伫逢春律后，","阴谷始堪看。"]]}
{"id":"37c210ec33","title":"送端上人游天台","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师今欲向天台去，","来说天台意最真。","溪过石桥为险处，","路逢毛褐是真人。","云边望字钟声远，","雪里寻僧脚迹新。","只可且论经夏别，","莫教琪树两回春。"],"stanzas":[["师今欲向天台去，","来说天台意最真。"],["溪过石桥为险处，","路逢毛褐是真人。"],["云边望字钟声远，","雪里寻僧脚迹新。"],["只可且论经夏别，","莫教琪树两回春。"]]}
{"id":"f6527cb230","title":"惜花","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落尽万株红，","无人解系风。","今朝芳径里，","惆怅锦机空。"],"stanzas":[["落尽万株红，","无人解系风。"],["今朝芳径里，","惆怅锦机空。"]]}
{"id":"f41e818be2","title":"冲夜行","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜行无月时，","古路多荒榛。","山鬼摇把火，","自照不照人。"],"stanzas":[["夜行无月时，","古路多荒榛。"],["山鬼摇把火，","自照不照人。"]]}
{"id":"19cd922e64","title":"夜愁曲","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌者歌未绝，","愁人愁转增。","空把琅玕枝，","强挑无心灯。"],"stanzas":[["歌者歌未绝，","愁人愁转增。"],["空把琅玕枝，","强挑无心灯。"]]}
{"id":"add295f085","title":"杂古词五首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可怜江北女，","惯唱江南曲。","摇荡木兰舟，","双凫不成浴。"],"stanzas":[["可怜江北女，","惯唱江南曲。"],["摇荡木兰舟，","双凫不成浴。"]]}
{"id":"b7329f48f1","title":"杂古词五首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["郎为七上香，","妾作笼下灰。","归时即暖热，","去罢生尘埃。"],"stanzas":[["郎为七上香，","妾作笼下灰。"],["归时即暖热，","去罢生尘埃。"]]}
{"id":"b057e50745","title":"杂古词五首 三","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜裁鸳鸯绮，","朝织蒲桃绫。","欲试一寸心，","待缝三尺冰。"],"stanzas":[["夜裁鸳鸯绮，","朝织蒲桃绫。"],["欲试一寸心，","待缝三尺冰。"]]}
{"id":"c5508f693a","title":"杂古词五首 四","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["怜时鱼得水，","怨罢商与参。","不如山栀子，","却能结同心。"],"stanzas":[["怜时鱼得水，","怨罢商与参。"],["不如山栀子，","却能结同心。"]]}
{"id":"735865fad1","title":"杂古词五首 五","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红颜感暮花，","白日同流水。","思君若孤灯，","一夜一心死。"],"stanzas":[["红颜感暮花，","白日同流水。"],["思君若孤灯，","一夜一心死。"]]}
{"id":"04fc3d7585","title":"幼女词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幼女才六岁，","未知巧与拙。","向夜在堂前，","学人拜新月。"],"stanzas":[["幼女才六岁，","未知巧与拙。"],["向夜在堂前，","学人拜新月。"]]}
{"id":"7d382d638e","title":"买地词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["买地不惜钱，","为多芳桂丛。","所期在清凉，","坐起闻香风。"],"stanzas":[["买地不惜钱，","为多芳桂丛。"],["所期在清凉，","坐起闻香风。"]]}
{"id":"ed7a22c7e7","title":"弋阳访古","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行逢葛溪水，","不见葛仙人。","空抛青竹杖，","呪作葛陂神。"],"stanzas":[["行逢葛溪水，","不见葛仙人。"],["空抛青竹杖，","呪作葛陂神。"]]}
{"id":"b100f6f4f4","title":"幽居乐","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万籁不在耳，","寂寥心境清。","无妨数茎竹，","时有萧萧声。"],"stanzas":[["万籁不在耳，","寂寥心境清。"],["无妨数茎竹，","时有萧萧声。"]]}
{"id":"422b0a432e","title":"湘川怀古","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湘水终日流，","湘妃昔时哭。","美色已成尘，","泪痕犹在竹。"],"stanzas":[["湘水终日流，","湘妃昔时哭。"],["美色已成尘，","泪痕犹在竹。"]]}
{"id":"6554653060","title":"秋山吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜吟秋山上，","褭褭秋风归。","月色清且[冷]，","桂香落人衣。"],"stanzas":[["夜吟秋山上，","褭褭秋风归。"],["月色清且[冷]，","桂香落人衣。"]]}
{"id":"d45cec5984","title":"寒夜","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三复招隐吟，","不知寒夜深。","看看西来月，","移到青天心。"],"stanzas":[["三复招隐吟，","不知寒夜深。"],["看看西来月，","移到青天心。"]]}
{"id":"89c5ca7679","title":"湘竹词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万古湘江竹，","无穷奈怨何。","年年长春笋，","只是泪痕多。"],"stanzas":[["万古湘江竹，","无穷奈怨何。"],["年年长春笋，","只是泪痕多。"]]}
{"id":"b511083672","title":"观花后游慈恩寺","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世事知难了，","应须问苦空。","羞将看花眼，","来入梵王宫。"],"stanzas":[["世事知难了，","应须问苦空。"],["羞将看花眼，","来入梵王宫。"]]}
{"id":"60f78b51ef","title":"乞巧词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乞巧望星河，","双双并绮罗。","不嫌针眼小，","只道月明多。"],"stanzas":[["乞巧望星河，","双双并绮罗。"],["不嫌针眼小，","只道月明多。"]]}
{"id":"354a9f75b5","title":"不见来词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乌鹊语千回，","黄昏不见来。","漫教脂粉匣，","闭了又重开。"],"stanzas":[["乌鹊语千回，","黄昏不见来。"],["漫教脂粉匣，","闭了又重开。"]]}
{"id":"8d0bc97049","title":"夜起来","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["香销连理带，","尘覆合欢桮。","嬾卧相思枕，","愁吟夜起来。"],"stanzas":[["香销连理带，","尘覆合欢桮。"],["嬾卧相思枕，","愁吟夜起来。"]]}
{"id":"7e3dacbdda","title":"笑卿卿词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["笑向卿卿道，","躭书夜夜多。","出来看玉兔，","又欲过银河。"],"stanzas":[["笑向卿卿道，","躭书夜夜多。"],["出来看玉兔，","又欲过银河。"]]}
{"id":"35a307c205","title":"感遇词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一种貌如仙，","人情要自偏。","罗敷有底好，","最得使君怜。"],"stanzas":[["一种貌如仙，","人情要自偏。"],["罗敷有底好，","最得使君怜。"]]}
{"id":"9984c4ee0c","title":"及第后夜访月仙子","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自喜寻幽夜，","新当及第年。","还将天上桂，","来访月中仙。"],"stanzas":[["自喜寻幽夜，","新当及第年。"],["还将天上桂，","来访月中仙。"]]}
{"id":"2d4bbfc8db","title":"定情乐 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["敢嗟君不怜，","自是命不谐。","著破三条裙，","却还双股钗。"],"stanzas":[["敢嗟君不怜，","自是命不谐。"],["著破三条裙，","却还双股钗。"]]}
{"id":"495f4e84b5","title":"定情乐 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["感郎双条脱，","新破八幅绡。","不惜榆荚钱，","买人金步摇。"],"stanzas":[["感郎双条脱，","新破八幅绡。"],["不惜榆荚钱，","买人金步摇。"]]}
{"id":"fdd1f44574","title":"宿南一上人山房","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["窗牖月色多，","坐卧禅心静。","青鬼来试人，","夜深弄灯影。"],"stanzas":[["窗牖月色多，","坐卧禅心静。"],["青鬼来试人，","夜深弄灯影。"]]}
{"id":"10c571913f","title":"兰渚泊","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家在洞水西，","身作兰渚客。","天昼无纤云，","独坐空江碧。"],"stanzas":[["家在洞水西，","身作兰渚客。"],["天昼无纤云，","独坐空江碧。"]]}
{"id":"ec4cb30882","title":"经吴真君旧宅","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古仙炼丹处，","不测何岁年。","至今空宅基，","时有五色烟。"],"stanzas":[["古仙炼丹处，","不测何岁年。"],["至今空宅基，","时有五色烟。"]]}
{"id":"68e04a23c9","title":"古相思","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十访九不见，","甚于菖蒲花。","可怜云中月，","今夜堕我家。"],"stanzas":[["十访九不见，","甚于菖蒲花。"],["可怜云中月，","今夜堕我家。"]]}
{"id":"af5c9e3038","title":"瀑布","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["豁开青冥颠，","写出万丈泉。","如裁一条素，","白日悬秋天。"],"stanzas":[["豁开青冥颠，","写出万丈泉。"],["如裁一条素，","白日悬秋天。"]]}
{"id":"ad901fe98b","title":"金尺石","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹砂画顽石，","黄金横一尺。","人世较短长，","仙家爱平直。"],"stanzas":[["丹砂画顽石，","黄金横一尺。"],["人世较短长，","仙家爱平直。"]]}
{"id":"ab4850d858","title":"秋洞宿","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜深秋洞里，","风雨报龙归。","何事触人睡，","不教胡蝶飞。"],"stanzas":[["夜深秋洞里，","风雨报龙归。"],["何事触人睡，","不教胡蝶飞。"]]}
{"id":"f2497cbf9b","title":"效古词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姊妹无多兄弟少，","举家钟爱年最小。","有时绕树山鹊飞，","贪看不待画眉了。"],"stanzas":[["姊妹无多兄弟少，","举家钟爱年最小。"],["有时绕树山鹊飞，","贪看不待画眉了。"]]}
{"id":"4df0d2c3a2","title":"山中得刘秀才京书","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自笑家贫客到疎，","满庭烟草不能锄。","今朝谁料三千里，","忽得刘京一纸书。"],"stanzas":[["自笑家贫客到疎，","满庭烟草不能锄。"],["今朝谁料三千里，","忽得刘京一纸书。"]]}
{"id":"384a8fbac7","title":"望夫词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["手爇寒灯向影频，","回文机上暗生尘。","自家夫壻无消息，","却恨桥头卖卜人。"],"stanzas":[["手爇寒灯向影频，","回文机上暗生尘。"],["自家夫壻无消息，","却恨桥头卖卜人。"]]}
{"id":"ac53a85b9b","title":"忆四明山泉","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爱彼山中石泉水，","幽深夜夜落空里。","至今忆得卧云时，","犹自涓涓在人耳。"],"stanzas":[["爱彼山中石泉水，","幽深夜夜落空里。"],["至今忆得卧云时，","犹自涓涓在人耳。"]]}
{"id":"f85eded752","title":"西山静中吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重重道气结成神，","玉阙金堂逐日新。","若数西山得道者，","连予便是十三人。"],"stanzas":[["重重道气结成神，","玉阙金堂逐日新。"],["若数西山得道者，","连予便是十三人。"]]}
{"id":"88cfd9283f","title":"天柱山赠峨嵋田道士","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古称天柱连九天，","峨嵋道士栖其巅。","近闻教得玄鹤舞，","试凭驱出青芝田。"],"stanzas":[["古称天柱连九天，","峨嵋道士栖其巅。"],["近闻教得玄鹤舞，","试凭驱出青芝田。"]]}
{"id":"fd76cd41d2","title":"夜岩谣","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜上幽岩踏灵草，","松枝已疎桂枝老。","新诗几度惜不吟，","此处一声风月好。"],"stanzas":[["夜上幽岩踏灵草，","松枝已疎桂枝老。"],["新诗几度惜不吟，","此处一声风月好。"]]}
{"id":"bf78ad9c05","title":"岛夷行","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["腥臊海边多鬼市，","岛夷居处无乡里。","黑皮少年学采珠，","手把生犀照咸水。"],"stanzas":[["腥臊海边多鬼市，","岛夷居处无乡里。"],["黑皮少年学采珠，","手把生犀照咸水。"]]}
{"id":"f5916fe5d9","title":"帝宫词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自得居王宠爱时，","敢言春色上寒枝。","十年宫里无人问，","一日承恩天下知。"],"stanzas":[["自得居王宠爱时，","敢言春色上寒枝。"],["十年宫里无人问，","一日承恩天下知。"]]}
{"id":"5fb5c854fd","title":"叹花词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前日满林红锦遍，","今日绕林看不见。","空余古岸泥土中，","零落臙脂两三片。"],"stanzas":[["前日满林红锦遍，","今日绕林看不见。"],["空余古岸泥土中，","零落臙脂两三片。"]]}
{"id":"f662b45e08","title":"杜鹃花词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杜鹃花时夭艳然，","所恨帝城人不识。","丁宁莫遣春风吹，","留与佳人比颜色。"],"stanzas":[["杜鹃花时夭艳然，","所恨帝城人不识。"],["丁宁莫遣春风吹，","留与佳人比颜色。"]]}
{"id":"3cf82c3362","title":"晓光词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日轮浮动羲和推，","东方一轧天门开。","风神为我扫烟雾，","四海荡荡无尘埃。"],"stanzas":[["日轮浮动羲和推，","东方一轧天门开。"],["风神为我扫烟雾，","四海荡荡无尘埃。"]]}
{"id":"ba04ef9211","title":"望晓词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["揽衣起兮望秋河，","蒙蒙远雾飞轻罗。","蟠桃树上日欲出，","白榆枝畔星无多。"],"stanzas":[["揽衣起兮望秋河，","蒙蒙远雾飞轻罗。"],["蟠桃树上日欲出，","白榆枝畔星无多。"]]}
{"id":"da4546bc44","title":"海边远望","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扶桑枝边红皎皎，","天鸡一声四溟晓。","偶看仙女上青天，","鸾鹤无多采云少。"],"stanzas":[["扶桑枝边红皎皎，","天鸡一声四溟晓。"],["偶看仙女上青天，","鸾鹤无多采云少。"]]}
{"id":"cf5e64733d","title":"听南僧说偈词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师子座中香已发，","西方佛偈南僧说。","惠风吹尽六条尘，","清净水中初见月。"],"stanzas":[["师子座中香已发，","西方佛偈南僧说。"],["惠风吹尽六条尘，","清净水中初见月。"]]}
{"id":"da29293631","title":"春日美新绿词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前日萌芽小于粟，","今朝草树色已足。","天公不语能运为，","驱遣羲和染新绿。"],"stanzas":[["前日萌芽小于粟，","今朝草树色已足。"],["天公不语能运为，","驱遣羲和染新绿。"]]}
{"id":"49a86bc992","title":"对月忆嵩阳故人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["团团月光照西壁，","嵩阳故人千里隔。","不知三十六峰前，","定为何处峰前客。"],"stanzas":[["团团月光照西壁，","嵩阳故人千里隔。"],["不知三十六峰前，","定为何处峰前客。"]]}
{"id":"ac0dfe4184","title":"赠莎地道士","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莎地阴森古莲叶，","游龟暗老青苔甲。","池边道士夸眼明，","夜取蟭螟摘蚊睫。"],"stanzas":[["莎地阴森古莲叶，","游龟暗老青苔甲。"],["池边道士夸眼明，","夜取蟭螟摘蚊睫。"]]}
{"id":"d788eb8e2f","title":"效古词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫愁新得年十六，","如蛾双眉长带绿。","初学箜篌四五人，","莫愁独自声前足。"],"stanzas":[["莫愁新得年十六，","如蛾双眉长带绿。"],["初学箜篌四五人，","莫愁独自声前足。"]]}
{"id":"9c4f49b4d7","title":"冬日观早朝","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫烟捧日炉香动，","万马千车踏新冻。","绣衣年少朝欲归，","美人犹在青楼梦。"],"stanzas":[["紫烟捧日炉香动，","万马千车踏新冻。"],["绣衣年少朝欲归，","美人犹在青楼梦。"]]}
{"id":"4335d965c9","title":"观吴偃画松","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君有绝艺终身宝，","方寸巧心通万造。","忽然写出涧底松，","笔下看看一枝老。"],"stanzas":[["君有绝艺终身宝，","方寸巧心通万造。"],["忽然写出涧底松，","笔下看看一枝老。"]]}
{"id":"bf332ade6f","title":"题山僧水阁","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山房水阁连空翠，","沈沉下有蛟龙睡。","老僧趺坐入定时，","不知花落黄金地。"],"stanzas":[["山房水阁连空翠，","沈沉下有蛟龙睡。"],["老僧趺坐入定时，","不知花落黄金地。"]]}
{"id":"0361d15d91","title":"登岘亭怀孟生","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岘山自高水自绿，","后辈词人心眼俗。","鹿门才子不再生，","怪景幽奇无管属。"],"stanzas":[["岘山自高水自绿，","后辈词人心眼俗。"],["鹿门才子不再生，","怪景幽奇无管属。"]]}
{"id":"77db464e70","title":"吴中代蜀客吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身狎吴儿客在蜀，","春深屡唱思乡曲。","峨眉风景无主人，","锦江悠悠为谁绿。"],"stanzas":[["身狎吴儿客在蜀，","春深屡唱思乡曲。"],["峨眉风景无主人，","锦江悠悠为谁绿。"]]}
{"id":"87152a24a7","title":"戏咏榆荚","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风吹榆钱落如雨，","绕林绕屋来不住。","知尔不堪还酒家，","漫教夷甫无行处。"],"stanzas":[["风吹榆钱落如雨，","绕林绕屋来不住。"],["知尔不堪还酒家，","漫教夷甫无行处。"]]}
{"id":"4a687c2b2f","title":"寄李补阙","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍生应怪君起迟，","蒲轮重辗嵩阳道。","功成名遂来不来，","三十六峰仙鹤老。"],"stanzas":[["苍生应怪君起迟，","蒲轮重辗嵩阳道。"],["功成名遂来不来，","三十六峰仙鹤老。"]]}
{"id":"45f1bde5fd","title":"贫客吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["𣰦毯敝衣无处结，","寸心耿耿如刀切。","今朝欲泣泉客珠，","及到盘中却成血。"],"stanzas":[["𣰦毯敝衣无处结，","寸心耿耿如刀切。"],["今朝欲泣泉客珠，","及到盘中却成血。"]]}
{"id":"1b8cd62ec1","title":"诮山中叟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老人今年八十几，","口中零落残牙齿。","天阴伛偻带嗽行，","犹向岩前种松子。"],"stanzas":[["老人今年八十几，","口中零落残牙齿。"],["天阴伛偻带嗽行，","犹向岩前种松子。"]]}
{"id":"424b21adc8","title":"闻山中步虚声","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何人步虚南峰顶，","鹤唳九天霜月冷。","仙词偶逐东风来，","误飘数声落尘境。"],"stanzas":[["何人步虚南峰顶，","鹤唳九天霜月冷。"],["仙词偶逐东风来，","误飘数声落尘境。"]]}
{"id":"1bbcc650e8","title":"题龙池山人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["主人家在龙池侧，","水中有鱼不敢食。","终朝采药供仙厨，","却笑桃花少颜色。"],"stanzas":[["主人家在龙池侧，","水中有鱼不敢食。"],["终朝采药供仙厨，","却笑桃花少颜色。"]]}
{"id":"a1f9956f68","title":"玩新桃花","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几叹红桃开未得，","忽惊造化新装饰。","一种同沾荣盛时，","偏荷清光借颜色。"],"stanzas":[["几叹红桃开未得，","忽惊造化新装饰。"],["一种同沾荣盛时，","偏荷清光借颜色。"]]}
{"id":"c0fd9d8f9b","title":"山石榴花","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深色臙脂碎剪红，","巧能攒合是天公。","莫言无物堪相比，","妖艳西施春驿中。"],"stanzas":[["深色臙脂碎剪红，","巧能攒合是天公。"],["莫言无物堪相比，","妖艳西施春驿中。"]]}
{"id":"2faeec97ae","title":"玩友人庭竹","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾去玄洲看种玉，","那似君家满庭竹。","客来不用呼清风，","此处挂冠凉自足。"],"stanzas":[["曾去玄洲看种玉，","那似君家满庭竹。"],["客来不用呼清风，","此处挂冠凉自足。"]]}
{"id":"11715fcc3f","title":"秋夜山居二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽居正想飡霞客，","夜久月寒珠露滴。","千年独鹤两三声，","飞下岩前一枝柏。"],"stanzas":[["幽居正想飡霞客，","夜久月寒珠露滴。"],["千年独鹤两三声，","飞下岩前一枝柏。"]]}
{"id":"405ad49993","title":"秋夜山居二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去鴈声遥人语绝，","谁家素机织新雪。","秋山野客醉醒时，","百尺老松衔半月。"],"stanzas":[["去鴈声遥人语绝，","谁家素机织新雪。"],["秋山野客醉醒时，","百尺老松衔半月。"]]}
{"id":"76a7922199","title":"秋夜山中别友人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独鹤孤云两难说，","明朝又作东西别。","知君少壮无几年，","莫爱闲吟老松月。"],"stanzas":[["独鹤孤云两难说，","明朝又作东西别。"],["知君少壮无几年，","莫爱闲吟老松月。"]]}
{"id":"f38ccf081b","title":"赠别王炼师往罗浮","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道俗骈阗留不住，","罗浮山上有心期。","却愁仙处人难到，","别后音书寄与谁。"],"stanzas":[["道俗骈阗留不住，","罗浮山上有心期。"],["却愁仙处人难到，","别后音书寄与谁。"]]}
{"id":"b0a91b0a17","title":"春日飡霞阁","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洒水初晴物候新，","飡霞阁上最宜春。","山花四面风吹入，","为我铺床作锦茵。"],"stanzas":[["洒水初晴物候新，","飡霞阁上最宜春。"],["山花四面风吹入，","为我铺床作锦茵。"]]}
{"id":"b3572d3558","title":"喜友再相逢","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三十年前与君别，","可怜容色夺花红。","谁知日月相催促，","此度见君成老翁。"],"stanzas":[["三十年前与君别，","可怜容色夺花红。"],["谁知日月相催促，","此度见君成老翁。"]]}
{"id":"a1e36af437","title":"候仙词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西归公子何时降，","南岳先生早晚来。","巡历世间犹未遍，","乞求鸾鹤且裴回。"],"stanzas":[["西归公子何时降，","南岳先生早晚来。"],["巡历世间犹未遍，","乞求鸾鹤且裴回。"]]}
{"id":"11291c9cda","title":"修仙词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹田自种留年药，","玄谷长生续命芝。","世上漫忙兼漫走，","不知求己更求谁。"],"stanzas":[["丹田自种留年药，","玄谷长生续命芝。"],["世上漫忙兼漫走，","不知求己更求谁。"]]}
{"id":"9142b4cf95","title":"夏日题方师院","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["火天无处买清风，","闷发时来入梵宫。","只向方师小廊下，","回看门外是樊笼。"],"stanzas":[["火天无处买清风，","闷发时来入梵宫。"],["只向方师小廊下，","回看门外是樊笼。"]]}
{"id":"3abe7f19ca","title":"春游乐","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一年三百六十日，","赏心那似春中物。","草迷曲坞花满园，","东家少年西家出。"],"stanzas":[["一年三百六十日，","赏心那似春中物。"],["草迷曲坞花满园，","东家少年西家出。"]]}
{"id":"0c5f517723","title":"仙客归乡词二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六合八荒游未半，","子孙零落暂归来。","井边不认捎云树，","多是门人在后栽。"],"stanzas":[["六合八荒游未半，","子孙零落暂归来。"],["井边不认捎云树，","多是门人在后栽。"]]}
{"id":"b26d9de8ed","title":"仙客归乡词二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞中日月洞中仙，","不算离家是几年。","出郭始知人代变，","又须抛却古时钱。"],"stanzas":[["洞中日月洞中仙，","不算离家是几年。"],["出郭始知人代变，","又须抛却古时钱。"]]}
{"id":"563f604405","title":"云州饮席","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒肠虽满少欢情，","身在云州望帝城。","巡次合当谁令改，","先须为我打还京。"],"stanzas":[["酒肠虽满少欢情，","身在云州望帝城。"],["巡次合当谁令改，","先须为我打还京。"]]}
{"id":"bd65c1c5a6","title":"戏赠李主簿","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["官罢江南客恨遥，","二年空被酒中消。","不知暗数春游处，","偏忆扬州第几桥。"],"stanzas":[["官罢江南客恨遥，","二年空被酒中消。"],["不知暗数春游处，","偏忆扬州第几桥。"]]}
{"id":"d754293848","title":"春词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄鸟啼多春日高，","红芳开尽井边桃。","美人手暖裁衣易，","片片轻云落剪刀。"],"stanzas":[["黄鸟啼多春日高，","红芳开尽井边桃。"],["美人手暖裁衣易，","片片轻云落剪刀。"]]}
{"id":"4f0cdb48c7","title":"题景上人山门","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水有青莲沙有金，","老僧于此独观心。","愁人欲寄中峰宿，","只恐白猨啼夜深。"],"stanzas":[["水有青莲沙有金，","老僧于此独观心。"],["愁人欲寄中峰宿，","只恐白猨啼夜深。"]]}
{"id":"d0f4561fea","title":"妓人残粧词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云髻已收金凤皇，","巧匀轻黛约残粧。","不知昨夜新歌响，","犹在谁家绕画梁。"],"stanzas":[["云髻已收金凤皇，","巧匀轻黛约残粧。"],["不知昨夜新歌响，","犹在谁家绕画梁。"]]}
{"id":"ed48bc2e6e","title":"临水亭","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["只怪素亭黏黛色，","溪烟为我染莓苔。","欲知源上春风起，","看取桃花逐水来。"],"stanzas":[["只怪素亭黏黛色，","溪烟为我染莓苔。"],["欲知源上春风起，","看取桃花逐水来。"]]}
{"id":"c2d1ad6f1a","title":"听范玄长吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["声声扣出碧琅玕，","能使秋猨欲呌难。","诗兴未穷心更远，","手垂青拂向云看。"],"stanzas":[["声声扣出碧琅玕，","能使秋猨欲呌难。"],["诗兴未穷心更远，","手垂青拂向云看。"]]}
{"id":"0733454bce","title":"观叶生画花","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心窍玲珑貌亦奇，","荣枯只在手中移。","今朝故向霜天里，","点破繁花四五枝。"],"stanzas":[["心窍玲珑貌亦奇，","荣枯只在手中移。"],["今朝故向霜天里，","点破繁花四五枝。"]]}
{"id":"a3d0a4e909","title":"洗丹沙词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千淘万洗紫光攒，","夜火荧荧照玉盘。","恐是麻姑残米粒，","不曾将与世人看。"],"stanzas":[["千淘万洗紫光攒，","夜火荧荧照玉盘。"],["恐是麻姑残米粒，","不曾将与世人看。"]]}
{"id":"46366bfb37","title":"长安春夜吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["露盘滴时河汉微，","美人灯下裁春衣。","蟾蜍东去鹊南飞，","芸香省中郎不归。"],"stanzas":[["露盘滴时河汉微，","美人灯下裁春衣。"],["蟾蜍东去鹊南飞，","芸香省中郎不归。"]]}
{"id":"e747c45c61","title":"自述","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["箧贮灵砂日日看，","欲成仙法脱身难。","不知谁向交州去，","为谢罗浮葛长官。"],"stanzas":[["箧贮灵砂日日看，","欲成仙法脱身难。"],["不知谁向交州去，","为谢罗浮葛长官。"]]}
{"id":"44187c28b4","title":"少年行","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["醉骑白马走空衢，","恶少皆称电不如。","五凤街头新勒辔，","半垂衫袖揖金吾。"],"stanzas":[["醉骑白马走空衢，","恶少皆称电不如。"],["五凤街头新勒辔，","半垂衫袖揖金吾。"]]}
{"id":"e6051ad3a0","title":"越中遇寒食","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去岁清明霅溪口，","今朝寒食镜湖西。","信知天地心不易，","还有子规依旧啼。"],"stanzas":[["去岁清明霅溪口，","今朝寒食镜湖西。"],["信知天地心不易，","还有子规依旧啼。"]]}
{"id":"0837be6758","title":"赠采药叟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老去唯将药裹行，","无家无累一身轻。","却教年少取书卷，","小字灯前鬬眼明。"],"stanzas":[["老去唯将药裹行，","无家无累一身轻。"],["却教年少取书卷，","小字灯前鬬眼明。"]]}
{"id":"2d74b94521","title":"清夜忆仙宫子","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜静门深紫洞烟，","孤行独坐忆神仙。","三清宫里月如昼，","十二宫楼何处眠。"],"stanzas":[["夜静门深紫洞烟，","孤行独坐忆神仙。"],["三清宫里月如昼，","十二宫楼何处眠。"]]}
{"id":"c87a6b2f41","title":"江南怨","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁见桥边荇叶新，","兰舟枕水楫生尘。","从来不是无莲采，","十顷莲塘卖与人。"],"stanzas":[["愁见桥边荇叶新，","兰舟枕水楫生尘。"],["从来不是无莲采，","十顷莲塘卖与人。"]]}
{"id":"37adf37819","title":"送绝尘子归旧隐二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云水千重绕洞门，","独归何处是桃源？","仙方不用随身去，","留与人间老子孙。"],"stanzas":[["云水千重绕洞门，","独归何处是桃源？","仙方不用随身去，","留与人间老子孙。"]]}
{"id":"17735fdf09","title":"送绝尘子归旧隐二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["班藤为杖草为衣，","万壑千峰独自归。","纵令相忆谁相报，","桂树岩边人信稀。"],"stanzas":[["班藤为杖草为衣，","万壑千峰独自归。"],["纵令相忆谁相报，","桂树岩边人信稀。"]]}
{"id":"528a1f3d45","title":"送裴秀才归淮南","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["怪来频起咏刀头，","枫叶枝边一夕秋。","又向江南别才子，","却将风景过扬州。"],"stanzas":[["怪来频起咏刀头，","枫叶枝边一夕秋。"],["又向江南别才子，","却将风景过扬州。"]]}
{"id":"9bed842e18","title":"钱塘渡口","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天堑茫茫连沃焦，","秦皇何事不安桥。","钱塘渡口无钱纳，","已失西兴两信潮。"],"stanzas":[["天堑茫茫连沃焦，","秦皇何事不安桥。"],["钱塘渡口无钱纳，","已失西兴两信潮。"]]}
{"id":"3ee3c41b8b","title":"春日宴徐君池亭","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暂凭春酒换愁颜，","今日应须醉始还。","池上有门君莫掩，","从教野客见青山。"],"stanzas":[["暂凭春酒换愁颜，","今日应须醉始还。"],["池上有门君莫掩，","从教野客见青山。"]]}
{"id":"46ad0ea1f4","title":"山中送友人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲折杨枝别恨生，","一重枝上一啼莺。","乱山重叠云相掩，","君向乱山何处行。"],"stanzas":[["欲折杨枝别恨生，","一重枝上一啼莺。"],["乱山重叠云相掩，","君向乱山何处行。"]]}
{"id":"ca540f9f0f","title":"寄王少府","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["采松仙子徒销日，","吃菜山僧枉过生。","多谢蓝田王少府，","人间诗酒最关情。"],"stanzas":[["采松仙子徒销日，","吃菜山僧枉过生。"],["多谢蓝田王少府，","人间诗酒最关情。"]]}
{"id":"1110d9ef7c","title":"赠女道士郑玉华二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玄发新簪碧藕花，","欲添肌雪饵红砂。","世间风景那堪恋，","长笑刘郎漫忆家。"],"stanzas":[["玄发新簪碧藕花，","欲添肌雪饵红砂。"],["世间风景那堪恋，","长笑刘郎漫忆家。"]]}
{"id":"f792d95ac4","title":"赠女道士郑玉华二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明镜湖中休采莲，","却师阿母学神仙。","朱丝误落青囊里，","犹是箜篌第几弦。"],"stanzas":[["明镜湖中休采莲，","却师阿母学神仙。"],["朱丝误落青囊里，","犹是箜篌第几弦。"]]}
{"id":"efbae7a531","title":"寄西台李侍御","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二千余里采琼瓌，","到处伤心瓦砾堆。","唯有绣衣周柱史，","独将珠玉挂西台。"],"stanzas":[["二千余里采琼瓌，","到处伤心瓦砾堆。"],["唯有绣衣周柱史，","独将珠玉挂西台。"]]}
{"id":"68ab29d439","title":"赠凌仙姥","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阿母从天降几时，","前朝惟有汉皇知。","仙桃不啻三回熟，","饱见东方一小儿。"],"stanzas":[["阿母从天降几时，","前朝惟有汉皇知。"],["仙桃不啻三回熟，","饱见东方一小儿。"]]}
{"id":"9af8a0c7ee","title":"晚春送王秀才游剡川","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越山花去剡藤新，","才子风光不厌春。","第一莫寻溪上路，","可怜仙女爱迷人。"],"stanzas":[["越山花去剡藤新，","才子风光不厌春。"],["第一莫寻溪上路，","可怜仙女爱迷人。"]]}
{"id":"fe58f238b9","title":"冯上人院","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扰扰凡情逐水流，","世间多喜复多忧。","一回行到冯公院，","便欲令人百事休。"],"stanzas":[["扰扰凡情逐水流，","世间多喜复多忧。"],["一回行到冯公院，","便欲令人百事休。"]]}
{"id":"d25dd0932b","title":"金吾词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行拥朱轮锦幨儿，","望仙门外叱金羁。","染须偷嫩无人觉，","唯有平康小妇知。"],"stanzas":[["行拥朱轮锦幨儿，","望仙门外叱金羁。"],["染须偷嫩无人觉，","唯有平康小妇知。"]]}
{"id":"3682add5e5","title":"观舞女","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["缠红结紫畏风吹，","袅娜初回弱柳枝。","买笑未知谁是主，","万人心逐一人移。"],"stanzas":[["缠红结紫畏风吹，","袅娜初回弱柳枝。"],["买笑未知谁是主，","万人心逐一人移。"]]}
{"id":"c8997e24bc","title":"鄠县村居","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲住村西日日慵，","上山无水引高踪。","谁能求得秦皇术，","为我先驱紫阁峰。"],"stanzas":[["欲住村西日日慵，","上山无水引高踪。"],["谁能求得秦皇术，","为我先驱紫阁峰。"]]}
{"id":"83753ef5ba","title":"酬周秀才","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三展蜀牋皆郢曲，","我心珍重甚琼瑶。","应缘水府龙神睡，","偷得蛟人五色绡。"],"stanzas":[["三展蜀牋皆郢曲，","我心珍重甚琼瑶。"],["应缘水府龙神睡，","偷得蛟人五色绡。"]]}
{"id":"f2cb365cf2","title":"旅次文水县喜遇李少府","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为君三日废行程，","一县官人是酒朋。","共忆襄阳同醉处，","尚书坐上纳银觥。"],"stanzas":[["为君三日废行程，","一县官人是酒朋。"],["共忆襄阳同醉处，","尚书坐上纳银觥。"]]}
{"id":"cbb816cda1","title":"夏雨后题青荷兰若","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["僧舍清凉竹树新，","初经一雨洗诸尘。","微风忽起吹莲叶，","青玉盘中泻水银。"],"stanzas":[["僧舍清凉竹树新，","初经一雨洗诸尘。"],["微风忽起吹莲叶，","青玉盘中泻水银。"]]}
{"id":"7d93a82370","title":"途中逢少女","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身倚西门笑向东，","牡丹初折一枝红。","市头日卖千般镜，","知落谁家新匣中。"],"stanzas":[["身倚西门笑向东，","牡丹初折一枝红。"],["市头日卖千般镜，","知落谁家新匣中。"]]}
{"id":"2728a107da","title":"山中玩白鹿","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绕洞寻花日易销，","人间无路得相招。","呦呦白鹿毛如雪，","踏我桃花过石桥。"],"stanzas":[["绕洞寻花日易销，","人间无路得相招。"],["呦呦白鹿毛如雪，","踏我桃花过石桥。"]]}
{"id":"72c4e1469c","title":"山居乐","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸾鹤每于松下见，","笙歌常向坐中闻。","手持十节龙头杖，","不指虚空即指云。"],"stanzas":[["鸾鹤每于松下见，","笙歌常向坐中闻。"],["手持十节龙头杖，","不指虚空即指云。"]]}
{"id":"778a530588","title":"襄阳曲","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大堤女儿郎莫寻，","三三五五结同心。","清晨对镜理容色，","意欲取郎千万金。"],"stanzas":[["大堤女儿郎莫寻，","三三五五结同心。"],["清晨对镜理容色，","意欲取郎千万金。"]]}
{"id":"8873cd2e8e","title":"望夫词二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["看看北鴈又南飞，","薄幸征夫久不归。","蟢子到头无信处，","凡经几度上人衣。"],"stanzas":[["看看北鴈又南飞，","薄幸征夫久不归。"],["蟢子到头无信处，","凡经几度上人衣。"]]}
{"id":"5ecb0e775d","title":"望夫词二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何事经年断书信，","愁闻远客说风波。","西家还有望夫伴，","一种泪痕儿最多。"],"stanzas":[["何事经年断书信，","愁闻远客说风波。"],["西家还有望夫伴，","一种泪痕儿最多。"]]}
{"id":"d2767e5e12","title":"少妇游春词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["簇锦攒花鬬胜游，","万人行处最风流。","无端自向春园里，","笑摘青梅呌阿侯。"],"stanzas":[["簇锦攒花鬬胜游，","万人行处最风流。"],["无端自向春园里，","笑摘青梅呌阿侯。"]]}
{"id":"0baba2369f","title":"折柳枝","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伤见路边杨柳春，","一重折尽一重新。","今年还折去年处，","不送去年离别人。"],"stanzas":[["伤见路边杨柳春，","一重折尽一重新。"],["今年还折去年处，","不送去年离别人。"]]}
{"id":"63aca7f40a","title":"归将吟","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百战放归成老翁，","余生得出死人中。","今朝授敕三回舞，","两赐青娥又拜公。"],"stanzas":[["百战放归成老翁，","余生得出死人中。"],["今朝授敕三回舞，","两赐青娥又拜公。"]]}
{"id":"708d240435","title":"惜花词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千树繁红绕碧泉，","正宜尊酒对芳年。","明朝欲饮还来此，","只怕春风却在前。"],"stanzas":[["千树繁红绕碧泉，","正宜尊酒对芳年。"],["明朝欲饮还来此，","只怕春风却在前。"]]}
{"id":"e201f6f455","title":"抛缠头词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠娥初罢绕梁词，","又见双鬟对舞时。","一抱红罗分不足，","参差裂破凤皇儿。"],"stanzas":[["翠娥初罢绕梁词，","又见双鬟对舞时。"],["一抱红罗分不足，","参差裂破凤皇儿。"]]}
{"id":"5db33e8053","title":"望骑马郎","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧蹄新压步初成，","玉色郎君弄影行。","赚杀唱歌楼上女，","伊州误作石州声。"],"stanzas":[["碧蹄新压步初成，","玉色郎君弄影行。"],["赚杀唱歌楼上女，","伊州误作石州声。"]]}
{"id":"75db3bf7f4","title":"春日钱塘杂兴二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒姥溪头桑褭褭，","钱塘郭外柳毶毶。","路逢邻妇遥相问，","小小如今学养蚕。"],"stanzas":[["酒姥溪头桑褭褭，","钱塘郭外柳毶毶。"],["路逢邻妇遥相问，","小小如今学养蚕。"]]}
{"id":"9ecc9de420","title":"春日钱塘杂兴二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西邻年少问东邻，","柳岸花隄几处新。","昨夜雨多春水阔，","隔江桃叶唤何人。"],"stanzas":[["西邻年少问东邻，","柳岸花隄几处新。"],["昨夜雨多春水阔，","隔江桃叶唤何人。"]]}
{"id":"996c926c2d","title":"玩手植松","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["却思毫末栽松处，","青翠才将众草分。","今日散材遮不得，","看看气色欲凌云。"],"stanzas":[["却思毫末栽松处，","青翠才将众草分。"],["今日散材遮不得，","看看气色欲凌云。"]]}
{"id":"b4fc524615","title":"夜笛词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皎洁西楼月未斜，","笛声寥亮入东家。","却令灯下裁衣妇，","误翦同心一半花。"],"stanzas":[["皎洁西楼月未斜，","笛声寥亮入东家。"],["却令灯下裁衣妇，","误翦同心一半花。"]]}
{"id":"b657130a12","title":"赠郑伦吹凤管","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["喃喃解语凤皇儿，","曾听棃园竹里吹。","谁谓五陵年少子，","还将此曲暗相随。"],"stanzas":[["喃喃解语凤皇儿，","曾听棃园竹里吹。"],["谁谓五陵年少子，","还将此曲暗相随。"]]}
{"id":"89219ffd7d","title":"蜀茗词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越椀初盛蜀茗新，","薄烟轻处搅来匀。","山僧问我将何比，","欲道琼浆却畏嗔。"],"stanzas":[["越椀初盛蜀茗新，","薄烟轻处搅来匀。"],["山僧问我将何比，","欲道琼浆却畏嗔。"]]}
{"id":"3f8eb1083f","title":"春霁","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["煎茶水里花千片，","候客亭中酒一樽。","独对春光还寂寞，","罗浮道士忽敲门。"],"stanzas":[["煎茶水里花千片，","候客亭中酒一樽。"],["独对春光还寂寞，","罗浮道士忽敲门。"]]}
{"id":"29129d75aa","title":"讽山云","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲云生叶不生根，","常被重重蔽石门。","赖有风帘能埽荡，","满山晴日照乾坤。"],"stanzas":[["闲云生叶不生根，","常被重重蔽石门。"],["赖有风帘能埽荡，","满山晴日照乾坤。"]]}
{"id":"e0f1e4a82a","title":"日晚归山词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虎迹新逢雨后泥，","无人家处洞边溪。","独行归客晚山里，","赖有鹧鸪临路岐。"],"stanzas":[["虎迹新逢雨后泥，","无人家处洞边溪。"],["独行归客晚山里，","赖有鹧鸪临路岐。"]]}
{"id":"809cfcc7a3","title":"玩花词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今朝造化使春风，","开拆西施面上红。","竟日眼前犹不足，","数株舁入寸心中。"],"stanzas":[["今朝造化使春风，","开拆西施面上红。"],["竟日眼前犹不足，","数株舁入寸心中。"]]}
{"id":"c311dc6d82","title":"长安早春","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["报花消息是春风，","未见先教何处红。","想得芳园十余日，","万家身在画屏中。"],"stanzas":[["报花消息是春风，","未见先教何处红。"],["想得芳园十余日，","万家身在画屏中。"]]}
{"id":"a4fa5ca548","title":"再酬李先辈","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清辞再发郢人家，","字字新移锦上花。","能使龙宫买绡女，","低回不敢织轻霞。"],"stanzas":[["清辞再发郢人家，","字字新移锦上花。"],["能使龙宫买绡女，","低回不敢织轻霞。"]]}
{"id":"3462ea4a78","title":"寄隐者","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["路绝空林无处问，","幽奇山水不知名。","松门拾得一片屐，","知是高人向此行。"],"stanzas":[["路绝空林无处问，","幽奇山水不知名。"],["松门拾得一片屐，","知是高人向此行。"]]}
{"id":"32d7751607","title":"寄四明山子","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高栖只在千峰里，","尘世望君那得知。","长忆去年风雨夜，","向君窗下听猨时。"],"stanzas":[["高栖只在千峰里，","尘世望君那得知。"],["长忆去年风雨夜，","向君窗下听猨时。"]]}
{"id":"a7dd23b0c2","title":"观美人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["漆点双眸鬓绕蝉，","长留白雪占胸前。","爱将红袖遮娇笑，","往往偷开水上莲。"],"stanzas":[["漆点双眸鬓绕蝉，","长留白雪占胸前。"],["爱将红袖遮娇笑，","往往偷开水上莲。"]]}
{"id":"2cc67c3eab","title":"收妆词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斜月胧胧照半床，","茕茕孤妾嬾收妆。","灯前再览青铜镜，","枉插金钗十二行。"],"stanzas":[["斜月胧胧照半床，","茕茕孤妾嬾收妆。"],["灯前再览青铜镜，","枉插金钗十二行。"]]}
{"id":"9966b01ff1","title":"仙女词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙女群中名最高，","曾看王母种仙桃。","手题金简非凡笔，","道是天边玉兔毛。"],"stanzas":[["仙女群中名最高，","曾看王母种仙桃。"],["手题金简非凡笔，","道是天边玉兔毛。"]]}
{"id":"2e36d77304","title":"仙翁词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世间无远可为游，","六合朝行夕已周。","坛上夜深风雨静，","小仙乘月系苍虬。"],"stanzas":[["世间无远可为游，","六合朝行夕已周。"],["坛上夜深风雨静，","小仙乘月系苍虬。"]]}
{"id":"aeb8e047c6","title":"遇李山人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["游山游水几千重，","二十年中一度逢。","别易会难君且住，","莫交青竹化为龙。"],"stanzas":[["游山游水几千重，","二十年中一度逢。"],["别易会难君且住，","莫交青竹化为龙。"]]}
{"id":"3b85a3a67e","title":"同张炼师溪行","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青溪道士紫霞巾，","洞里仙家旧是邻。","每见桃花逐流水，","无回不忆武陵人。"],"stanzas":[["青溪道士紫霞巾，","洞里仙家旧是邻。"],["每见桃花逐流水，","无回不忆武陵人。"]]}
{"id":"91212914be","title":"桃源词二首 一","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夭夭花里千家住，","总为当时隐暴秦。","归去不论无旧识，","子孙今亦是他人。"],"stanzas":[["夭夭花里千家住，","总为当时隐暴秦。"],["归去不论无旧识，","子孙今亦是他人。"]]}
{"id":"77614d743c","title":"桃源词二首 二","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦世老翁归汉世，","还同白鹤返辽城。","纵令记得山川路，","莫问当时州县名。"],"stanzas":[["秦世老翁归汉世，","还同白鹤返辽城。"],["纵令记得山川路，","莫问当时州县名。"]]}
{"id":"1b07adb249","title":"送道友游山","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲驻如今未老形，","万重山上九芝清。","君今若问采芝路，","踏水踏云攀杳冥。"],"stanzas":[["欲驻如今未老形，","万重山上九芝清。"],["君今若问采芝路，","踏水踏云攀杳冥。"]]}
{"id":"29caf1490f","title":"赠王屋刘道士","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小有洞中长住客，","大罗天下后来仙。","出门即是寻常处，","未可还它跨鹤鞭。"],"stanzas":[["小有洞中长住客，","大罗天下后来仙。"],["出门即是寻常处，","未可还它跨鹤鞭。"]]}
{"id":"b89d792b09","title":"谢自然升仙","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["分明得道谢自然，","古来漫说尸解仙。","如花年少一女子，","身骑白鹤游青天。"],"stanzas":[["分明得道谢自然，","古来漫说尸解仙。"],["如花年少一女子，","身骑白鹤游青天。"]]}
{"id":"fcbd46dca6","title":"秋吟献李舍人","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["肠结愁根酒不消，","新惊白发长愁苗。","主司傥许题名姓，","笔下看成度海桥。"],"stanzas":[["肠结愁根酒不消，","新惊白发长愁苗。"],["主司傥许题名姓，","笔下看成度海桥。"]]}
{"id":"6a1b094fc0","title":"山中喜静和子见访","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绝壁深溪无四邻，","每逢猨鹤即相亲。","小奴惊出垂藤下，","山犬今朝吠一人。"],"stanzas":[["绝壁深溪无四邻，","每逢猨鹤即相亲。"],["小奴惊出垂藤下，","山犬今朝吠一人。"]]}
{"id":"7a8ce59a6c","title":"春日题罗处士山舍","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱叠千峰掩翠微，","高人爱此自忘机。","春风若埽阶前地，","便是山花带锦飞。"],"stanzas":[["乱叠千峰掩翠微，","高人爱此自忘机。"],["春风若埽阶前地，","便是山花带锦飞。"]]}
{"id":"d5f8dd36bf","title":"访松岭徐炼师","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千仞峰头一谪仙，","何时种玉已成田？","开经犹在松阴里，","读到南华第几篇。"],"stanzas":[["千仞峰头一谪仙，","何时种玉已成田？","开经犹在松阴里，","读到南华第几篇。"]]}
{"id":"85afc59cff","title":"江南织绫词","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卿卿买得越人丝，","贪弄金梭嬾画眉。","女伴能来看新𥷨，","鸳鸯正欲上花枝。"],"stanzas":[["卿卿买得越人丝，","贪弄金梭嬾画眉。"],["女伴能来看新𥷨，","鸳鸯正欲上花枝。"]]}
