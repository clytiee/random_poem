{"id":"c2d943ee68","title":"开元杂题七首 舞马","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月窟龙孙四百蹄，","骄骧轻步应金鞞。","曲终似要君王宠，","回望红楼不敢嘶。"],"stanzas":[["月窟龙孙四百蹄，","骄骧轻步应金鞞。"],["曲终似要君王宠，","回望红楼不敢嘶。"]]}
{"id":"f74379f014","title":"开元杂题七首 杂伎","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拜象驯犀角觝豪，","星丸霜劒出花高。","六宫争近乘舆望，","珠翠三千拥赭袍。"],"stanzas":[["拜象驯犀角觝豪，","星丸霜劒出花高。"],["六宫争近乘舆望，","珠翠三千拥赭袍。"]]}
{"id":"e604250943","title":"开元杂题七首 雪衣女","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嫩红钩曲雪花攒，","月殿栖时片影残。","自说夜来春梦恶，","学持金偈玉栏干。"],"stanzas":[["嫩红钩曲雪花攒，","月殿栖时片影残。"],["自说夜来春梦恶，","学持金偈玉栏干。"]]}
{"id":"f429f53cd4","title":"开元杂题七首 绣岭宫","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绣岭花残翠倚空，","碧窗瑶砌旧行宫。","闲乘小驷浓阴下，","时举金鞭半袖风。"],"stanzas":[["绣岭花残翠倚空，","碧窗瑶砌旧行宫。"],["闲乘小驷浓阴下，","时举金鞭半袖风。"]]}
{"id":"55deb4a1e9","title":"开元杂题七首 汤泉","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖殿流汤数十间，","玉渠香细浪回环。","上皇初解云衣浴，","珠櫂时敲瑟瑟山。"],"stanzas":[["暖殿流汤数十间，","玉渠香细浪回环。"],["上皇初解云衣浴，","珠櫂时敲瑟瑟山。"]]}
{"id":"ae9c67391a","title":"题杜秀才水亭","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓和风露立晴烟，","秖恐腥魂涴洞天。","云肆有龙君若买，","便敲初日铸金钱。"],"stanzas":[["晓和风露立晴烟，","秖恐腥魂涴洞天。"],["云肆有龙君若买，","便敲初日铸金钱。"]]}
{"id":"5fd427de15","title":"翠碧","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红襟翠翰两参差，","径拂烟华上细枝。","春水渐生鱼易得，","莫辞风雨坐多时。"],"stanzas":[["红襟翠翰两参差，","径拂烟华上细枝。"],["春水渐生鱼易得，","莫辞风雨坐多时。"]]}
{"id":"95c9462607","title":"水国诗","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水国不堪旱，","斯民生甚微。","直至葭菼少，","敢言鱼蟹肥。","我到荒村无食啗，","对案又非梁谢览。","况是干苗结子疎，","归时祗得藜羹糁。"],"stanzas":[["水国不堪旱，","斯民生甚微。"],["直至葭菼少，","敢言鱼蟹肥。"],["我到荒村无食啗，","对案又非梁谢览。"],["况是干苗结子疎，","归时祗得藜羹糁。"]]}
{"id":"8ce9d4ec62","title":"井上桐","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["美人伤别离，","汲井长待晓。","愁因辘轳转，","惊起双栖鸟。","独立傍银床，","碧桐风袅袅。"],"stanzas":[["美人伤别离，","汲井长待晓。"],["愁因辘轳转，","惊起双栖鸟。"],["独立傍银床，","碧桐风袅袅。"]]}
{"id":"41b88356cc","title":"门前路","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门前向城路，","一直复一曲。","曲去日中还，","直行日暮宿。","何必日中还，","曲途荆棘间。"],"stanzas":[["门前向城路，","一直复一曲。"],["曲去日中还，","直行日暮宿。"],["何必日中还，","曲途荆棘间。"]]}
{"id":"3a180078e4","title":"彼农二章 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世路浇险，","淳风荡除。","彼农家流，","犹存厥初。","藁焉而席，","茨焉而居。","首乱如葆，","形枯若腒。","大耋既鲐，","童子未𪘯。","以负以载，","悉薅悉鉏。","我慕圣道，","我躭古书。","小倦于学，","时游汝庐。","有饭一盛，","莫盐莫蔬。","有𦈡一缇，","不襟不袪。","所谓饥寒，","汝何逭欤。"],"stanzas":[["世路浇险，","淳风荡除。"],["彼农家流，","犹存厥初。"],["藁焉而席，","茨焉而居。"],["首乱如葆，","形枯若腒。"],["大耋既鲐，","童子未𪘯。"],["以负以载，","悉薅悉鉏。"],["我慕圣道，","我躭古书。"],["小倦于学，","时游汝庐。"],["有饭一盛，","莫盐莫蔬。"],["有𦈡一缇，","不襟不袪。"],["所谓饥寒，","汝何逭欤。"]]}
{"id":"fcd357c396","title":"彼农二章 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禹贡厥田，","上下各异。","善人为邦，","民受其赐。","去年西成，","野有遗穗。","今夏南亩，","旱气赤地。","遭其丰凶，","概歛无二。","退输弗供，","进诉弗视。","号于旻天，","以血为泪。","孟子有言，","王无罪岁。","诗以穷辞，","以嫉悍吏。"],"stanzas":[["禹贡厥田，","上下各异。"],["善人为邦，","民受其赐。"],["去年西成，","野有遗穗。"],["今夏南亩，","旱气赤地。"],["遭其丰凶，","概歛无二。"],["退输弗供，","进诉弗视。"],["号于旻天，","以血为泪。"],["孟子有言，","王无罪岁。"],["诗以穷辞，","以嫉悍吏。"]]}
{"id":"dcbd332658","title":"奉酬袭美苦雨见寄","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["松篁交加午阴黑，","别是江南烟霭国。","顽云猛雨更相欺，","声似虓号色如墨。","茅茨裛烂簷生衣，","夜夜化为萤火飞。","萤飞渐多屋渐薄，","一注愁霖当面落。","愁霖愁霖尔何错，","灭顶于余奚所作。","既不能赋似陈思王，","又不能诗似谢康乐。","昔年尝过杜子美，","亦得高歌破印纸。","惯曾掀搅大笔多，","为我才情也如此。","高揖愁霖词未已，","披文忽自皮夫子。","哀弦怨柱合为吟，","㤞我穷栖蓬藋里。","初悲湿翼何由起，","末欲牋天叩天耳。","其如玉女正投壶，","笑电霏霏作天喜。","我本曾无一棱田，","平生啸傲空渔船。","有时赤脚弄明月，","踏破五湖光底天。","去岁王师东下急，","输兵粟尽民相泣。","伊予不战不耕人，","敢怨烝黎无糁粒。","不然受性圆如规，","千姿万态分毫厘。","唾壶虎子尽能执，","舐痔折枝无所辞。","有头强方心强直，","撑拄颓风不量力。","自爱垂名野史中，","宁论抱困荒城侧。","唯君浩叹非庸人，","分衣辍饮来相亲。","横眠木榻忘华荐，","对食露葵轻八珍。","欲穷玄，","凤未白，","欲怀仙，","鲸尚隔。","不如驱入醉乡中，","只恐醉乡田地窄。"],"stanzas":[["松篁交加午阴黑，","别是江南烟霭国。"],["顽云猛雨更相欺，","声似虓号色如墨。"],["茅茨裛烂簷生衣，","夜夜化为萤火飞。"],["萤飞渐多屋渐薄，","一注愁霖当面落。"],["愁霖愁霖尔何错，","灭顶于余奚所作。"],["既不能赋似陈思王，","又不能诗似谢康乐。"],["昔年尝过杜子美，","亦得高歌破印纸。"],["惯曾掀搅大笔多，","为我才情也如此。"],["高揖愁霖词未已，","披文忽自皮夫子。"],["哀弦怨柱合为吟，","㤞我穷栖蓬藋里。"],["初悲湿翼何由起，","末欲牋天叩天耳。"],["其如玉女正投壶，","笑电霏霏作天喜。"],["我本曾无一棱田，","平生啸傲空渔船。"],["有时赤脚弄明月，","踏破五湖光底天。"],["去岁王师东下急，","输兵粟尽民相泣。"],["伊予不战不耕人，","敢怨烝黎无糁粒。"],["不然受性圆如规，","千姿万态分毫厘。"],["唾壶虎子尽能执，","舐痔折枝无所辞。"],["有头强方心强直，","撑拄颓风不量力。"],["自爱垂名野史中，","宁论抱困荒城侧。"],["唯君浩叹非庸人，","分衣辍饮来相亲。"],["横眠木榻忘华荐，","对食露葵轻八珍。"],["欲穷玄，","凤未白，","欲怀仙，","鲸尚隔。"],["不如驱入醉乡中，","只恐醉乡田地窄。"]]}
{"id":"43a2394de1","title":"夏日闲居作四声诗寄袭美 平声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荒池菰蒲深，","闲阶莓苔平。","江边松篁多，","人家帘栊清。","为书凌遗编，","调弦夸新声。","求欢虽殊途，","探幽聊怡情。"],"stanzas":[["荒池菰蒲深，","闲阶莓苔平。"],["江边松篁多，","人家帘栊清。"],["为书凌遗编，","调弦夸新声。"],["求欢虽殊途，","探幽聊怡情。"]]}
{"id":"f03776de18","title":"夏日闲居作四声诗寄袭美 平上声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝烟淹楼台，","晚雨染岛屿。","渔童惊狂歌，","艇子喜野语。","山容堪停杯，","柳影好隐暑。","年华如飞鸿，","斗酒幸且举。"],"stanzas":[["朝烟淹楼台，","晚雨染岛屿。"],["渔童惊狂歌，","艇子喜野语。"],["山容堪停杯，","柳影好隐暑。"],["年华如飞鸿，","斗酒幸且举。"]]}
{"id":"d133492d65","title":"夏日闲居作四声诗寄袭美 平去声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新开窗犹偏，","自种蕙未徧。","书签风摇闻，","钓榭雾破见。","耕耘闲之资，","啸咏性最便。","希夷全天真，","讵要问贵贱。"],"stanzas":[["新开窗犹偏，","自种蕙未徧。"],["书签风摇闻，","钓榭雾破见。"],["耕耘闲之资，","啸咏性最便。"],["希夷全天真，","讵要问贵贱。"]]}
{"id":"9675586b7e","title":"夏日闲居作四声诗寄袭美 平入声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["端居愁无涯，","一夕髪欲白。","因为鸾章吟，","忽忆鹤骨客。","手披丹台文，","脚著赤玉舃。","如蒙清音酬，","若渴吸月液。"],"stanzas":[["端居愁无涯，","一夕髪欲白。"],["因为鸾章吟，","忽忆鹤骨客。"],["手披丹台文，","脚著赤玉舃。"],["如蒙清音酬，","若渴吸月液。"]]}
{"id":"38c2ac1596","title":"奉酬袭美苦雨四声重寄三十二句 平声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽栖眠疎窗，","豪居凭高楼。","浮沤惊跳丸，","寒声思重裘。","床前垂文竿，","巢边登轻舟。","虽无东臯田，","还生鱼乎忧。"],"stanzas":[["幽栖眠疎窗，","豪居凭高楼。"],["浮沤惊跳丸，","寒声思重裘。"],["床前垂文竿，","巢边登轻舟。"],["虽无东臯田，","还生鱼乎忧。"]]}
{"id":"92cbcaee07","title":"奉酬袭美苦雨四声重寄三十二句 平上声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["层云愁天低，","久雨倚槛冷。","丝禽藏荷香，","锦鲤绕岛影。","心将时人乖，","道与隐者静。","桐阴无深泉，","所以逞短绠。"],"stanzas":[["层云愁天低，","久雨倚槛冷。"],["丝禽藏荷香，","锦鲤绕岛影。"],["心将时人乖，","道与隐者静。"],["桐阴无深泉，","所以逞短绠。"]]}
{"id":"e8ff4f3662","title":"奉酬袭美苦雨四声重寄三十二句 平去声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乌蟾俱沈光，","昼夜恨暗度。","何当乘云螭，","面见上帝愬。","臣言阴云欺，","诏用利劒付。","回车诛群奸，","自散万籁怒。"],"stanzas":[["乌蟾俱沈光，","昼夜恨暗度。"],["何当乘云螭，","面见上帝愬。"],["臣言阴云欺，","诏用利劒付。"],["回车诛群奸，","自散万籁怒。"]]}
{"id":"e5c9c528fa","title":"奉酬袭美苦雨四声重寄三十二句 平入声","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危簷仍空堦，","十日滴不歇。","青莎看成狂，","白菊即欲没。","吴王荒金尊，","越妾挟玉瑟。","当时虽愁霖，","亦若惜落月。"],"stanzas":[["危簷仍空堦，","十日滴不歇。"],["青莎看成狂，","白菊即欲没。"],["吴王荒金尊，","越妾挟玉瑟。"],["当时虽愁霖，","亦若惜落月。"]]}
{"id":"9a6acfcf3f","title":"晓起即事因成回文寄袭美","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平波落月吟闲景，","暗幌浮烟思起人。","清露晓垂花谢半，","远风微动蕙抽新。","城荒上处樵童小，","石藓分来宿鹭驯。","晴寺野寻同去好，","古碑苔字细书匀。"],"stanzas":[["平波落月吟闲景，","暗幌浮烟思起人。"],["清露晓垂花谢半，","远风微动蕙抽新。"],["城荒上处樵童小，","石藓分来宿鹭驯。"],["晴寺野寻同去好，","古碑苔字细书匀。"]]}
{"id":"14f07614a3","title":"回文","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["静烟临碧树，","残雪背晴楼。","冷天侵极戍，","寒月对行舟。"],"stanzas":[["静烟临碧树，","残雪背晴楼。"],["冷天侵极戍，","寒月对行舟。"]]}
{"id":"1647f6a504","title":"叠韵山中吟","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琼英轻明生，","石脉滴沥碧。","玄铅仙偏怜，","白帻客亦惜。"],"stanzas":[["琼英轻明生，","石脉滴沥碧。"],["玄铅仙偏怜，","白帻客亦惜。"]]}
{"id":"a7b6312327","title":"双声溪上思","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溪空唯容云，","木密不陨雨。","迎渔隐映间，","安问讴鸦樐。"],"stanzas":[["溪空唯容云，","木密不陨雨。"],["迎渔隐映间，","安问讴鸦樐。"]]}
{"id":"96b3ce929c","title":"叠韵吴宫词二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["肤愉吴都姝，","眷恋便殿宴。","逡巡新春人，","转面见战箭。"],"stanzas":[["肤愉吴都姝，","眷恋便殿宴。"],["逡巡新春人，","转面见战箭。"]]}
{"id":"87daecbe5c","title":"叠韵吴宫词二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红栊通东风，","翠珥醉易坠。","平明兵盈城，","弃置遂至地。"],"stanzas":[["红栊通东风，","翠珥醉易坠。"],["平明兵盈城，","弃置遂至地。"]]}
{"id":"a12444fa13","title":"和胥口即事 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨后山容若动，","天寒树色如消。","目送回汀隐隐，","心随挂鹿摇摇。","白蒋知秋露裛，","青枫欲暮烟饶。","莫问吴趋行乐，","酒旗竿倚河桥。"],"stanzas":[["雨后山容若动，","天寒树色如消。"],["目送回汀隐隐，","心随挂鹿摇摇。"],["白蒋知秋露裛，","青枫欲暮烟饶。"],["莫问吴趋行乐，","酒旗竿倚河桥。"]]}
{"id":"b4b3fa31af","title":"和胥口即事 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["把钓丝随浪远，","采莲衣染香浓。","绿倒红飘欲尽，","风斜雨细相逢。","断岸沈渔𦋥𦊲，","邻村送客𦪽{舟卭}。","即是清霜剖野，","乘闲莫厌来重。"],"stanzas":[["把钓丝随浪远，","采莲衣染香浓。"],["绿倒红飘欲尽，","风斜雨细相逢。"],["断岸沈渔𦋥𦊲，","邻村送客𦪽{舟卭}。"],["即是清霜剖野，","乘闲莫厌来重。"]]}
{"id":"fc94e14817","title":"齐梁怨别","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寥寥缺月看将落，","簷外霜华染罗幕。","不知兰櫂到何山，","应倚相思树边泊。"],"stanzas":[["寥寥缺月看将落，","簷外霜华染罗幕。"],["不知兰櫂到何山，","应倚相思树边泊。"]]}
{"id":"0591226074","title":"闲居杂题五首 鸣蜩早","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲来倚杖柴门口，","鸟下深枝啄晚虫。","周步一池销半日，","十年听此鬓如蓬。"],"stanzas":[["闲来倚杖柴门口，","鸟下深枝啄晚虫。"],["周步一池销半日，","十年听此鬓如蓬。"]]}
{"id":"a1d5427d63","title":"闲居杂题五首 野态真","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君如有意躭田里，","予亦无机向艺能。","心迹所便唯是直，","人间闻道最先憎。"],"stanzas":[["君如有意躭田里，","予亦无机向艺能。"],["心迹所便唯是直，","人间闻道最先憎。"]]}
{"id":"c5f4103130","title":"闲居杂题五首 松间斟","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子山园静怜幽木，","公干词清咏荜门。","月上风微萧洒甚，","斗醪何惜置盈尊。"],"stanzas":[["子山园静怜幽木，","公干词清咏荜门。"],["月上风微萧洒甚，","斗醪何惜置盈尊。"]]}
{"id":"27c6cf3a55","title":"闲居杂题五首 饮岩泉","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已甘茅洞三君食，","欠买桐江一朵山。","严子濑高秋浪白，","水禽飞尽钓舟还。"],"stanzas":[["已甘茅洞三君食，","欠买桐江一朵山。"],["严子濑高秋浪白，","水禽飞尽钓舟还。"]]}
{"id":"b093fddae6","title":"闲居杂题五首 当轩鹤","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自笑与人乖好尚，","田家山客共柴车。","干时未似栖庐雀，","鸟道闲携相尔书。"],"stanzas":[["自笑与人乖好尚，","田家山客共柴车。"],["干时未似栖庐雀，","鸟道闲携相尔书。"]]}
{"id":"bee7ed9782","title":"药名离合夏日即事三首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乘屐著来幽砌滑，","石甖煎得远泉甘。","草堂祗待新秋景，","天色微凉酒半酣。"],"stanzas":[["乘屐著来幽砌滑，","石甖煎得远泉甘。"],["草堂祗待新秋景，","天色微凉酒半酣。"]]}
{"id":"e94c899f87","title":"药名离合夏日即事三首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["避暑最须从朴野，","葛巾筠席更相当。","归来又好乘凉钓，","藤蔓阴阴著雨香。"],"stanzas":[["避暑最须从朴野，","葛巾筠席更相当。"],["归来又好乘凉钓，","藤蔓阴阴著雨香。"]]}
{"id":"6f3401d632","title":"药名离合夏日即事三首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["窗外晓帘还自卷，","柏烟兰露思晴空。","青箱有意终须续，","断简遗编一半通。"],"stanzas":[["窗外晓帘还自卷，","柏烟兰露思晴空。"],["青箱有意终须续，","断简遗编一半通。"]]}
{"id":"3694f59d4d","title":"和袭美怀锡山药名离合二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹤伴前溪栽白杏，","人来阴洞写枯松。","萝深境静日欲落，","石上未眠闻远钟。"],"stanzas":[["鹤伴前溪栽白杏，","人来阴洞写枯松。"],["萝深境静日欲落，","石上未眠闻远钟。"]]}
{"id":"90574a54c4","title":"和袭美怀锡山药名离合二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳句成来谁不伏，","神丹偷去亦须防。","风前莫怪携诗藁，","本是吴吟荡桨郎。"],"stanzas":[["佳句成来谁不伏，","神丹偷去亦须防。"],["风前莫怪携诗藁，","本是吴吟荡桨郎。"]]}
{"id":"9e31ee7d90","title":"和袭美怀鹿门县名离合二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云容覆枕无非白，","水色侵矶直是蓝。","田种紫芝餐可寿，","春来何事恋江南。"],"stanzas":[["云容覆枕无非白，","水色侵矶直是蓝。"],["田种紫芝餐可寿，","春来何事恋江南。"]]}
{"id":"9ca855950d","title":"和袭美怀鹿门县名离合二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹溪深处猿同宿，","松阁秋来客共登。","封径古苔侵石鹿，","城中谁解访山僧。"],"stanzas":[["竹溪深处猿同宿，","松阁秋来客共登。"],["封径古苔侵石鹿，","城中谁解访山僧。"]]}
{"id":"898efc1007","title":"寒日古人名","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["初寒朗咏裴回立，","欲谢玄关早晚开。","昨日登楼望江色，","鱼梁鸿雁几多来。"],"stanzas":[["初寒朗咏裴回立，","欲谢玄关早晚开。"],["昨日登楼望江色，","鱼梁鸿雁几多来。"]]}
{"id":"516bdbdf0f","title":"句","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几点社翁雨，","一番花信风。","水鸟歌妇女，","衣襟便佞舌。","溪山自是清凉国，","松竹合封萧洒侯。","山上花明水上曛，","一桡青翰破霞文。","白帝霜舆欲御秋，","但说漱流并枕石。","不辞蝉腹与龟肠，","头方不会王门事。","尘土空缁白苎衣，","秋来嬾上向吴亭。"],"stanzas":[["几点社翁雨，","一番花信风。"],["水鸟歌妇女，","衣襟便佞舌。"],["溪山自是清凉国，","松竹合封萧洒侯。"],["山上花明水上曛，","一桡青翰破霞文。"],["白帝霜舆欲御秋，","但说漱流并枕石。"],["不辞蝉腹与龟肠，","头方不会王门事。"],["尘土空缁白苎衣，","秋来嬾上向吴亭。"]]}
{"id":"edc5ae69f8","title":"旅泊吴门","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一舸吴江晚，","堪忧病广文。","鲈鱼谁与伴，","鸥鸟自成群。","反照纵横水，","斜空断续云。","异乡无限思，","尽付酒醺醺。"],"stanzas":[["一舸吴江晚，","堪忧病广文。"],["鲈鱼谁与伴，","鸥鸟自成群。"],["反照纵横水，","斜空断续云。"],["异乡无限思，","尽付酒醺醺。"]]}
{"id":"6259cbeefe","title":"贲中间有吴门旅泊之什蒙鲁望垂和更作一章以伸詶谢","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶发陶匏响，","皆蒙组绣文。","清秋将落帽，","子夏正离群。","有恨书燕雁，","无聊赋郢云。","徧看心自醉，","不是酒能醺。"],"stanzas":[["偶发陶匏响，","皆蒙组绣文。"],["清秋将落帽，","子夏正离群。"],["有恨书燕雁，","无聊赋郢云。"],["徧看心自醉，","不是酒能醺。"]]}
{"id":"2d0d132fcb","title":"酬袭美先见寄倒来韵","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寻疑天意丧斯文，","故选茅峰寄白云。","酒后只留沧海客，","香前唯见紫阳君。","近年已绝诗书癖，","今日兼将笔砚焚。","为有此身犹苦患，","不知何者是玄𫄸。"],"stanzas":[["寻疑天意丧斯文，","故选茅峰寄白云。"],["酒后只留沧海客，","香前唯见紫阳君。"],["近年已绝诗书癖，","今日兼将笔砚焚。"],["为有此身犹苦患，","不知何者是玄𫄸。"]]}
{"id":"ea1a8ee7e2","title":"奉和袭美醉中即席见赠次韵","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桂枝新下月中仙，","学海词锋誉蔼然。","文阵已推忠信甲，","穷波犹认孝廉船。","清标称住羊车上，","俗韵惭居鹤氅前。","共许逢蒙快弓箭，","再穿杨叶在明年。"],"stanzas":[["桂枝新下月中仙，","学海词锋誉蔼然。"],["文阵已推忠信甲，","穷波犹认孝廉船。"],["清标称住羊车上，","俗韵惭居鹤氅前。"],["共许逢蒙快弓箭，","再穿杨叶在明年。"]]}
{"id":"59622ffc19","title":"奉和袭美题褚家林亭","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["疎野林亭震泽西，","朗吟闲步喜相携。","时时风折芦花乱，","处处霜摧稻穗低。","百本败荷鱼不动，","一枝寒菊蝶空迷。","今朝偶得高阳伴，","从放山翁醉似泥。"],"stanzas":[["疎野林亭震泽西，","朗吟闲步喜相携。"],["时时风折芦花乱，","处处霜摧稻穗低。"],["百本败荷鱼不动，","一枝寒菊蝶空迷。"],["今朝偶得高阳伴，","从放山翁醉似泥。"]]}
{"id":"67a2f2a4bd","title":"奉和袭美伤开元观顾道士","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤麟胶尽夜如何，","共叹先生劒解多。","几度吊来唯白鹤，","此时乘去必青骡。","图中含景随残照，","琴里流泉寄逝波。","惆怅真灵又空返，","玉书谁授紫微歌。"],"stanzas":[["凤麟胶尽夜如何，","共叹先生劒解多。"],["几度吊来唯白鹤，","此时乘去必青骡。"],["图中含景随残照，","琴里流泉寄逝波。"],["惆怅真灵又空返，","玉书谁授紫微歌。"]]}
{"id":"395d12d5c8","title":"和鲁望白菊","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪彩冰姿号女华，","寄身多是地仙家。","有时南国和霜立，","几处东篱伴月斜。","谢客琼枝空贮恨，","袁郎金钿不成夸。","自知终古清香在，","更出梅粧弄晚霞。"],"stanzas":[["雪彩冰姿号女华，","寄身多是地仙家。"],["有时南国和霜立，","几处东篱伴月斜。"],["谢客琼枝空贮恨，","袁郎金钿不成夸。"],["自知终古清香在，","更出梅粧弄晚霞。"]]}
{"id":"72f0841ec6","title":"奉和袭美先辈悼鹤","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["池塘萧索掩空笼，","玉树同嗟一土中。","莎径罢鸣唯泣露，","松轩休舞但悲风。","丹台旧氅难重缉，","紫府新书岂更通。","云减雾消无处问，","只留华髪与衰翁。"],"stanzas":[["池塘萧索掩空笼，","玉树同嗟一土中。"],["莎径罢鸣唯泣露，","松轩休舞但悲风。"],["丹台旧氅难重缉，","紫府新书岂更通。"],["云减雾消无处问，","只留华髪与衰翁。"]]}
{"id":"57c580a8c2","title":"偶约道流终乖文会荅皮陆","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["僊侣无何访蔡经，","两烦韶濩出彤庭。","人间若有登楼望，","应怪文星近客星。"],"stanzas":[["僊侣无何访蔡经，","两烦韶濩出彤庭。"],["人间若有登楼望，","应怪文星近客星。"]]}
{"id":"803d3cc5d7","title":"和袭美寒夜见访","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云孤鹤独且相亲，","倣効从它折角巾。","不用吴江叹留滞，","风姿俱是玉清人。"],"stanzas":[["云孤鹤独且相亲，","倣効从它折角巾。"],["不用吴江叹留滞，","风姿俱是玉清人。"]]}
{"id":"69241d7fac","title":"和袭美醉中先起次韵","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何事桃源路忽迷，","惟留云雨怨空闺。","僊郎共许多情调，","莫遣重歌浊水泥。"],"stanzas":[["何事桃源路忽迷，","惟留云雨怨空闺。"],["僊郎共许多情调，","莫遣重歌浊水泥。"]]}
{"id":"f5fc026f8b","title":"和皮陆酒病偶作","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白编椰席镂冰明，","应助杨青解宿酲。","难继二贤金玉唱，","可怜空作断猿声。"],"stanzas":[["白编椰席镂冰明，","应助杨青解宿酲。"],["难继二贤金玉唱，","可怜空作断猿声。"]]}
{"id":"15bfe6bc6c","title":"送浙东德师侍御罢府西归","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤云独鸟本无依，","江海重逢故旧稀。","杨柳渐疏芦苇白，","可怜斜日送君归。"],"stanzas":[["孤云独鸟本无依，","江海重逢故旧稀。"],["杨柳渐疏芦苇白，","可怜斜日送君归。"]]}
{"id":"a38436963c","title":"以青䭀饭分送袭美鲁望因成一绝","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁屑琼瑶事青䭀，","旧传名品出华阳。","应宜仙子胡麻拌，","因送刘郎与阮郎。"],"stanzas":[["谁屑琼瑶事青䭀，","旧传名品出华阳。"],["应宜仙子胡麻拌，","因送刘郎与阮郎。"]]}
{"id":"1339ae82ae","title":"玩金㶉鶒和陆鲁望","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠羽红襟镂彩云，","双飞常笑白鸥群。","谁怜化作雕金质，","从倩沈檀十里闻。"],"stanzas":[["翠羽红襟镂彩云，","双飞常笑白鸥群。"],["谁怜化作雕金质，","从倩沈檀十里闻。"]]}
{"id":"4e8161e92c","title":"悼鹤和袭美","author":"张贲","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渥顶鲜毛品格驯，","莎庭闲暇重难群。","无端日暮东风起，","飘散春空一片云。"],"stanzas":[["渥顶鲜毛品格驯，","莎庭闲暇重难群。"],["无端日暮东风起，","飘散春空一片云。"]]}
{"id":"9644115aa7","title":"览皮先辈盛制因作十韵以寄用伸欵仰","author":"崔璐","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河岳挺灵异，","星辰精气殊。","在人为英杰，","与国作祯符。","襄阳得奇士，","俊迈真龙驹。","勇果鲁仲由，","文赋蜀相如。","浑浩江海广，","葩华桃李敷。","小言入无间，","大言塞空虚。","几人游赤水，","夫子得玄珠。","鬼神争奥秘，","天地惜洪𬬻。","既有曾参行，","仍兼君子儒。","吾知上帝意，","将使居黄枢。","好保千金体须为万姓谟。"],"stanzas":[["河岳挺灵异，","星辰精气殊。"],["在人为英杰，","与国作祯符。"],["襄阳得奇士，","俊迈真龙驹。"],["勇果鲁仲由，","文赋蜀相如。"],["浑浩江海广，","葩华桃李敷。"],["小言入无间，","大言塞空虚。"],["几人游赤水，","夫子得玄珠。"],["鬼神争奥秘，","天地惜洪𬬻。"],["既有曾参行，","仍兼君子儒。"],["吾知上帝意，","将使居黄枢。"],["好保千金体须为万姓谟。"]]}
{"id":"52a34f6a17","title":"浙东罢府西归酬别张广文皮先辈陆秀才","author":"李縠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岂有头风笔下痊，","浪成蛮语向初筵。","兰亭旧趾虽曾见，","柯笛遗音更不传。","照曜文星吴分野，","留连花月晋名贤。","相逢只恨相知晚，","一曲骊歌又几年。"],"stanzas":[["岂有头风笔下痊，","浪成蛮语向初筵。"],["兰亭旧趾虽曾见，","柯笛遗音更不传。"],["照曜文星吴分野，","留连花月晋名贤。"],["相逢只恨相知晚，","一曲骊歌又几年。"]]}
{"id":"a630a2ba31","title":"和皮日休悼鸖 一","author":"李縠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["才子襟期本上清，","陆云家鸖伴闲情。","犹怜反顾五六里，","何意忽归十二城。","露滴谁闻高叶坠，","月沈休藉半阶明。","人闻华表堪留语，","剩向秋风寄一声。"],"stanzas":[["才子襟期本上清，","陆云家鸖伴闲情。"],["犹怜反顾五六里，","何意忽归十二城。"],["露滴谁闻高叶坠，","月沈休藉半阶明。"],["人闻华表堪留语，","剩向秋风寄一声。"]]}
{"id":"7a38fe7381","title":"和皮日休悼鸖 二","author":"李縠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道林曾放雪翎飞，","应悔庭除闭羽衣。","料得王恭披鹤氅，","倚吟犹待月中归。"],"stanzas":[["道林曾放雪翎飞，","应悔庭除闭羽衣。"],["料得王恭披鹤氅，","倚吟犹待月中归。"]]}
{"id":"e9d2fa2355","title":"醉中袭美先月中归","author":"李縠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["休文虽即逃琼液，","阿鹜还须掩玉闺。","月落金鸡一声后，","不知谁悔醉如泥。"],"stanzas":[["休文虽即逃琼液，","阿鹜还须掩玉闺。"],["月落金鸡一声后，","不知谁悔醉如泥。"]]}
{"id":"e9886cd301","title":"奉酬皮先辈霜菊见赠","author":"崔璞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["菊花开晚过秋风，","闻道芳香正满丛。","争奈病夫难强饮，","应须速自召车公。"],"stanzas":[["菊花开晚过秋风，","闻道芳香正满丛。"],["争奈病夫难强饮，","应须速自召车公。"]]}
{"id":"30b7ea18fb","title":"蒙恩除替将还京洛偶叙所怀因成六韵呈军事院诸公郡中一二秀才","author":"崔璞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两载求人瘼，","三春受代归。","务繁多簿籍，","才短乏恩威。","共理乖天奖，","分忧值岁饥。","遽蒙交郡印，","安敢整朝衣。","作牧慙为政，","思乡念式微。","傥容还故里，","高卧掩柴扉。"],"stanzas":[["两载求人瘼，","三春受代归。"],["务繁多簿籍，","才短乏恩威。"],["共理乖天奖，","分忧值岁饥。"],["遽蒙交郡印，","安敢整朝衣。"],["作牧慙为政，","思乡念式微。"],["傥容还故里，","高卧掩柴扉。"]]}
{"id":"90e43906a3","title":"和皮日休悼鹤 一","author":"魏朴","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["直欲裁诗问杳冥，","岂教灵化亦浮生。","风林月动疑留魄，","沙岛香愁似蕴情。","雪骨夜封苍藓冷，","练衣寒在碧塘轻。","人间飞去犹堪恨，","况是泉台远玉京。"],"stanzas":[["直欲裁诗问杳冥，","岂教灵化亦浮生。"],["风林月动疑留魄，","沙岛香愁似蕴情。"],["雪骨夜封苍藓冷，","练衣寒在碧塘轻。"],["人间飞去犹堪恨，","况是泉台远玉京。"]]}
{"id":"998a87191c","title":"和皮日休悼鹤 二","author":"魏朴","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["经秋宋玉已悲伤，","况报胎禽昨夜亡。","霜晓起来无问处，","伴僧弹指绕荷塘。"],"stanzas":[["经秋宋玉已悲伤，","况报胎禽昨夜亡。"],["霜晓起来无问处，","伴僧弹指绕荷塘。"]]}
{"id":"17f6fe7a8b","title":"皮袭美见留小䜩次韵","author":"羊昭业","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泽国春来少遇晴，","有花开日且飞觥。","王戎似电休推病，","周𫖮才醒众却惊。","芳景渐浓偏属酒，","煖风初畅欲调莺。","知君不肯然官烛，","争得华筵彻夜明。"],"stanzas":[["泽国春来少遇晴，","有花开日且飞觥。"],["王戎似电休推病，","周𫖮才醒众却惊。"],["芳景渐浓偏属酒，","煖风初畅欲调莺。"],["知君不肯然官烛，","争得华筵彻夜明。"]]}
{"id":"7579a92e70","title":"送羊振文归觐桂阳","author":"颜萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高挂吴帆喜动容，","问安归去指湘峰。","悬鱼庭内芝兰秀，","驭鹤门前薜荔封。","红斾正怜棠影茂，","彩衣偏带桂香浓。","临岐独有沾襟恋，","南巷当年共化龙。"],"stanzas":[["高挂吴帆喜动容，","问安归去指湘峰。"],["悬鱼庭内芝兰秀，","驭鹤门前薜荔封。"],["红斾正怜棠影茂，","彩衣偏带桂香浓。"],["临岐独有沾襟恋，","南巷当年共化龙。"]]}
{"id":"694571b16c","title":"送圆载上人","author":"颜萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师来一世恣经行，","却泛沧波问去程。","心静已能防渴鹿，","鼙喧时为骇长鲸。","禅林几结金桃重，","梵室重修铁瓦轻。","料得还乡无别利，","只应先见日华生。"],"stanzas":[["师来一世恣经行，","却泛沧波问去程。"],["心静已能防渴鹿，","鼙喧时为骇长鲸。"],["禅林几结金桃重，","梵室重修铁瓦轻。"],["料得还乡无别利，","只应先见日华生。"]]}
{"id":"6c80bf970b","title":"过张祜处士丹阳故居","author":"颜萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忆昔为儿逐我兄，","曾抛竹马拜先生。","书斋已换当时主，","诗壁空题故友名。","岂是争权留怨敌，","可怜当路尽公卿。","柴扉草屋无人问，","犹向荒田责地征。"],"stanzas":[["忆昔为儿逐我兄，","曾抛竹马拜先生。"],["书斋已换当时主，","诗壁空题故友名。"],["岂是争权留怨敌，","可怜当路尽公卿。"],["柴扉草屋无人问，","犹向荒田责地征。"]]}
{"id":"3dbb367158","title":"和袭美伤顾道士","author":"郑璧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斜汉银澜一夜东，","飘飘何处五云中。","空留华表千年约，","才毕丹炉九转功。","形蜕远山孤圹月，","影寒深院晓松风。","门人不覩飞升去，","犹与浮生哭恨同。"],"stanzas":[["斜汉银澜一夜东，","飘飘何处五云中。"],["空留华表千年约，","才毕丹炉九转功。"],["形蜕远山孤圹月，","影寒深院晓松风。"],["门人不覩飞升去，","犹与浮生哭恨同。"]]}
{"id":"8b64420172","title":"奉和陆鲁望白菊","author":"郑璧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白艳轻明带露痕，","始知佳色重难群。","终朝疑笑梁王雪，","尽日慵飞蜀帝魂。","燕雨似翻瑶渚浪，","雁风疑卷玉绡纹。","琼妃若会宽裁剪，","堪作蟾宫夜舞裙。"],"stanzas":[["白艳轻明带露痕，","始知佳色重难群。"],["终朝疑笑梁王雪，","尽日慵飞蜀帝魂。"],["燕雨似翻瑶渚浪，","雁风疑卷玉绡纹。"],["琼妃若会宽裁剪，","堪作蟾宫夜舞裙。"]]}
{"id":"e0b313b303","title":"和袭美索友人酒","author":"郑璧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乘兴闲来小谢家，","便裁诗句乞榴花。","邴原虽不无端醉，","也爱临风从鹿车。"],"stanzas":[["乘兴闲来小谢家，","便裁诗句乞榴花。"],["邴原虽不无端醉，","也爱临风从鹿车。"]]}
{"id":"b9e57bc1cc","title":"文燕润卿不至","author":"郑璧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已知羽驾朝金阙，","不用烧兰望玉京。","应是易迁明月好，","玉皇留看舞双成。"],"stanzas":[["已知羽驾朝金阙，","不用烧兰望玉京。"],["应是易迁明月好，","玉皇留看舞双成。"]]}
{"id":"6da47eae97","title":"塞上","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里隋城在，","三边虏气衰。","沙填孤障角，","烧断故关碑。","马色经寒惨，","雕声带晚悲。","将军正闲暇，","留客换歌辞。"],"stanzas":[["万里隋城在，","三边虏气衰。"],["沙填孤障角，","烧断故关碑。"],["马色经寒惨，","雕声带晚悲。"],["将军正闲暇，","留客换歌辞。"]]}
{"id":"c5bec973d4","title":"寄永嘉崔道融","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旅寓虽难定，","乘闲是胜游。","碧云萧寺霁，","红树谢邨秋。","戍鼓和潮暗，","船灯照岛幽。","诗家多滞此，","风景似相留。"],"stanzas":[["旅寓虽难定，","乘闲是胜游。"],["碧云萧寺霁，","红树谢邨秋。"],["戍鼓和潮暗，","船灯照岛幽。"],["诗家多滞此，","风景似相留。"]]}
{"id":"39d5cabe5b","title":"下方","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三十年来往，","中间京洛尘。","倦行今白首，","归卧已清神。","坡暖冬抽笋，","松凉夏健人。","更惭征诏起，","避世迹非真。"],"stanzas":[["三十年来往，","中间京洛尘。"],["倦行今白首，","归卧已清神。"],["坡暖冬抽笋，","松凉夏健人。"],["更惭征诏起，","避世迹非真。"]]}
{"id":"f7fd2d05c1","title":"华下","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日炙旱云裂，","迸为千道血。","天地沸一镬，","竟自烹妖孽。","尧汤遇灾数，","灾数还中辍。","何事奸与邪，","古来难扑灭。"],"stanzas":[["日炙旱云裂，","迸为千道血。"],["天地沸一镬，","竟自烹妖孽。"],["尧汤遇灾数，","灾数还中辍。"],["何事奸与邪，","古来难扑灭。"]]}
{"id":"d2e1586acb","title":"僧舍贻友","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["笑破人间事，","吾徒莫自欺。","解吟僧亦俗，","爱舞鹤终卑。","竹上题幽梦，","溪边约敌棋。","旧山归有阻，","不是故迟迟。"],"stanzas":[["笑破人间事，","吾徒莫自欺。"],["解吟僧亦俗，","爱舞鹤终卑。"],["竹上题幽梦，","溪边约敌棋。"],["旧山归有阻，","不是故迟迟。"]]}
{"id":"a12e7c41be","title":"下方","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昏旦松轩下，","怡然对一瓢。","雨微吟思足，","花落梦无聊。","细事当棋遣，","衰容喜镜饶。","溪僧有深趣，","书至又相邀。"],"stanzas":[["昏旦松轩下，","怡然对一瓢。"],["雨微吟思足，","花落梦无聊。"],["细事当棋遣，","衰容喜镜饶。"],["溪僧有深趣，","书至又相邀。"]]}
{"id":"6ae5ad498a","title":"华下送文浦","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["郊居谢名利，","何事最相亲。","渐与论诗久，","皆知得句新。","川明虹照雨，","树密鸟冲人。","应念从今去，","还来岳下频。"],"stanzas":[["郊居谢名利，","何事最相亲。"],["渐与论诗久，","皆知得句新。"],["川明虹照雨，","树密鸟冲人。"],["应念从今去，","还来岳下频。"]]}
{"id":"66b1e663fc","title":"自诫","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我祖铭座右，","嘉谋贻厥孙。","勤此苟不怠，","令名日可存。","媒衒士所耻，","慈俭道所尊。","松柏岂不茂，","桃李亦自繁。","众人皆察察，","而我独昏昏。","取训于老氏，","大辩欲讷言。"],"stanzas":[["我祖铭座右，","嘉谋贻厥孙。"],["勤此苟不怠，","令名日可存。"],["媒衒士所耻，","慈俭道所尊。"],["松柏岂不茂，","桃李亦自繁。"],["众人皆察察，","而我独昏昏。"],["取训于老氏，","大辩欲讷言。"]]}
{"id":"2e0b4081dc","title":"效陈拾遗子昂感遇二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高燕飞何捷，","啄害恣群雏。","人岂玩其暴，","华轩容尔居。","强欺自天禀，","刚吐信吾徒。","乃知不平者，","矫世道终孤。"],"stanzas":[["高燕飞何捷，","啄害恣群雏。"],["人岂玩其暴，","华轩容尔居。"],["强欺自天禀，","刚吐信吾徒。"],["乃知不平者，","矫世道终孤。"]]}
{"id":"5d2c36291c","title":"效陈拾遗子昂感遇二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阳和含煦润，","卉木竞纷华。","当为众所悦，","私已汝何夸。","北里秘秾艳，","东园锁名花。","豪夺乃常理，","笑君徒咄嗟。"],"stanzas":[["阳和含煦润，","卉木竞纷华。"],["当为众所悦，","私已汝何夸。"],["北里秘秾艳，","东园锁名花。"],["豪夺乃常理，","笑君徒咄嗟。"]]}
{"id":"85343f52b8","title":"效陈拾遗子昂","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丑妇竞簪花，","花多映愈丑。","邻女恃其姿，","掇之不盈手。","量已苟自私，","招损乃谁咎。","宠禄既非安，","于吾竟何有。"],"stanzas":[["丑妇竞簪花，","花多映愈丑。"],["邻女恃其姿，","掇之不盈手。"],["量已苟自私，","招损乃谁咎。"],["宠禄既非安，","于吾竟何有。"]]}
{"id":"e5caadb5d0","title":"感时","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好鸟无恶声，","仁兽肯狂噬。","宁教鹦鹉哑，","不遣麒麟细。","人人语与默，","唯观利与势。","爱毁亦自遭，","掩谤终失计。"],"stanzas":[["好鸟无恶声，","仁兽肯狂噬。"],["宁教鹦鹉哑，","不遣麒麟细。"],["人人语与默，","唯观利与势。"],["爱毁亦自遭，","掩谤终失计。"]]}
{"id":"d303c0c6c3","title":"秋思","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身病时亦危，","逢秋多恸哭。","风波一摇荡，","天地几翻覆。","孤萤出荒池，","落叶穿破屋。","势利长草草，","何人访幽独。"],"stanzas":[["身病时亦危，","逢秋多恸哭。"],["风波一摇荡，","天地几翻覆。"],["孤萤出荒池，","落叶穿破屋。"],["势利长草草，","何人访幽独。"]]}
{"id":"0cf036b6d1","title":"早春","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伤怀同客处，","病眼却花朝。","草嫩侵沙短，","冰轻著雨消。","风光知可爱，","容髪不相饶。","早晚丹丘去，","飞书肯见招。"],"stanzas":[["伤怀同客处，","病眼却花朝。"],["草嫩侵沙短，","冰轻著雨消。"],["风光知可爱，","容髪不相饶。"],["早晚丹丘去，","飞书肯见招。"]]}
{"id":"b705f9ef82","title":"上陌梯寺怀旧僧二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云根禅客居，","皆说旧无庐。","松日明金像，","山风向木鱼。","依栖应不阻，","名利本来疎。","纵有人相问，","林间懒拆书。"],"stanzas":[["云根禅客居，","皆说旧无庐。"],["松日明金像，","山风向木鱼。"],["依栖应不阻，","名利本来疎。"],["纵有人相问，","林间懒拆书。"]]}
{"id":"acd5765164","title":"上陌梯寺怀旧僧二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高鸦隔谷见，","路转寺西门。","塔影荫泉脉，","山苗侵烧痕。","钟疎含杳霭，","合迥亘黄昏。","更待他僧到，","长如前信存。"],"stanzas":[["高鸦隔谷见，","路转寺西门。"],["塔影荫泉脉，","山苗侵烧痕。"],["钟疎含杳霭，","合迥亘黄昏。"],["更待他僧到，","长如前信存。"]]}
{"id":"2fa06b57e7","title":"寄怀元秀上人","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悠悠干禄利，","草草废渔樵。","身世堪惆怅，","风骚顿寂寥。","高秋期步野，","积雨放趋朝。","得句如相忆，","莎斋且见招。"],"stanzas":[["悠悠干禄利，","草草废渔樵。"],["身世堪惆怅，","风骚顿寂寥。"],["高秋期步野，","积雨放趋朝。"],["得句如相忆，","莎斋且见招。"]]}
{"id":"307e176efa","title":"次韵和秀上人游南五台","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中峰曾到处，","题记没苍苔。","振锡传深谷，","翻经想旧台。","危松临砌偃，","惊鹿蓦溪来。","内殿御诗切，","身回心未回。"],"stanzas":[["中峰曾到处，","题记没苍苔。"],["振锡传深谷，","翻经想旧台。"],["危松临砌偃，","惊鹿蓦溪来。"],["内殿御诗切，","身回心未回。"]]}
{"id":"ead6ae3a4f","title":"赠圆昉公","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天阶让紫衣，","冷格鹤犹卑。","道胜嫌名出，","身闲觉老迟。","晓香延宿火，","寒磬度高枝。","每说长松寺，","他年与我期。"],"stanzas":[["天阶让紫衣，","冷格鹤犹卑。"],["道胜嫌名出，","身闲觉老迟。"],["晓香延宿火，","寒磬度高枝。"],["每说长松寺，","他年与我期。"]]}
{"id":"016d24fc4f","title":"赠信美寺岑上人","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巡礼诸方遍，","湘南频有缘。","焚香老山寺，","乞食向江船。","纱碧笼名画，","灯寒照净禅。","我来能永日，","莲漏滴寒泉。"],"stanzas":[["巡礼诸方遍，","湘南频有缘。"],["焚香老山寺，","乞食向江船。"],["纱碧笼名画，","灯寒照净禅。"],["我来能永日，","莲漏滴寒泉。"]]}
{"id":"3eaf8ace62","title":"江行二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地阔分吴塞，","枫高映楚天。","曲塘春尽雨，","方响夜深船。","行纪添新梦，","羇愁甚往年。","何时京洛路，","马上见人烟。"],"stanzas":[["地阔分吴塞，","枫高映楚天。"],["曲塘春尽雨，","方响夜深船。"],["行纪添新梦，","羇愁甚往年。"],["何时京洛路，","马上见人烟。"]]}
{"id":"5f50b7b53e","title":"江行二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["初程风信好，","回望失津楼。","日带潮声晚，","烟含楚色秋。","戍旗当远客，","岛树转惊鸥。","此去非名利，","孤帆任白头。"],"stanzas":[["初程风信好，","回望失津楼。"],["日带潮声晚，","烟含楚色秋。"],["戍旗当远客，","岛树转惊鸥。"],["此去非名利，","孤帆任白头。"]]}
{"id":"a99684271b","title":"长安赠王注","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正下搜贤诏，","多君独避名。","客来当意惬，","花发遇歌成。","乐地留高趣，","权门让后生。","东方御闲驷，","园外好同行。"],"stanzas":[["正下搜贤诏，","多君独避名。"],["客来当意惬，","花发遇歌成。"],["乐地留高趣，","权门让后生。"],["东方御闲驷，","园外好同行。"]]}
{"id":"23b50f145e","title":"赠步寄李员外","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危桥转溪路，","经雨石丛荒。","幽瀑下仙果，","孤巢悬夕阳。","病辞青琐秘，","心在紫芝房。","更喜谐招隐，","诗家有望郎。"],"stanzas":[["危桥转溪路，","经雨石丛荒。"],["幽瀑下仙果，","孤巢悬夕阳。"],["病辞青琐秘，","心在紫芝房。"],["更喜谐招隐，","诗家有望郎。"]]}
{"id":"216d301154","title":"寄郑仁规","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清才郑小戎，","标的贵游中。","万里云无侣，","三山鹤不笼。","香和丹地暖，","晚着彩衣风。","荣路期经济，","唯应在至公。"],"stanzas":[["清才郑小戎，","标的贵游中。"],["万里云无侣，","三山鹤不笼。"],["香和丹地暖，","晚着彩衣风。"],["荣路期经济，","唯应在至公。"]]}
{"id":"11843dd9bd","title":"寄考功王员外","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["喜闻三字耗，","闲客是陪游。","白鸟闲疎索，","青山日滞留。","琴如高韵称，","诗愧逸才酬。","更勉匡君志，","论思在献谋。"],"stanzas":[["喜闻三字耗，","闲客是陪游。"],["白鸟闲疎索，","青山日滞留。"],["琴如高韵称，","诗愧逸才酬。"],["更勉匡君志，","论思在献谋。"]]}
{"id":"2412ba514b","title":"杂言","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸟飞飞，","兔蹶蹶，","朝来暮去驱时节。","女娲只解补青天，","不解煎胶黏日月。"],"stanzas":[["鸟飞飞，","兔蹶蹶，","朝来暮去驱时节。"],["女娲只解补青天，","不解煎胶黏日月。"]]}
{"id":"bc8d7da7c6","title":"陈疾","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自怜旅舍亦酣歌，","世路无机奈尔何。","霄汉逼来心不动，","鬓毛白尽兴犹多。","残阳暂照乡关近，","远鸟因投岳庙过。","闲得此身归未得，","磬声深夏隔烟萝。"],"stanzas":[["自怜旅舍亦酣歌，","世路无机奈尔何。"],["霄汉逼来心不动，","鬓毛白尽兴犹多。"],["残阳暂照乡关近，","远鸟因投岳庙过。"],["闲得此身归未得，","磬声深夏隔烟萝。"]]}
{"id":"f53f8aed5b","title":"淅上 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华下支离已隔河，","又来此地避干戈。","山田渐广猨时到，","邨舍新添燕亦多。","丹桂石楠宜并长，","秦云楚雨暗相和。","儿童栗熟迷归路，","归得仍随牧竖歌。"],"stanzas":[["华下支离已隔河，","又来此地避干戈。"],["山田渐广猨时到，","邨舍新添燕亦多。"],["丹桂石楠宜并长，","秦云楚雨暗相和。"],["儿童栗熟迷归路，","归得仍随牧竖歌。"]]}
{"id":"3018f77190","title":"淅上 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西北乡关近帝京，","烟尘一片正伤情。","愁看地色连空色，","静听歌声似哭声。","红蓼满邨人不在，","青山绕槛路难平。","从他烟棹更南去，","休向津头问去程。"],"stanzas":[["西北乡关近帝京，","烟尘一片正伤情。"],["愁看地色连空色，","静听歌声似哭声。"],["红蓼满邨人不在，","青山绕槛路难平。"],["从他烟棹更南去，","休向津头问去程。"]]}
{"id":"3513873796","title":"山中","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["全家与我恋孤岑，","蹋得苍苔一径深。","逃难人多分隙地，","放生麋大出寒林。","名应不朽轻仙骨，","理到忘机近佛心。","昨夜前溪骤雷雨，","晚晴闲步数峰吟。"],"stanzas":[["全家与我恋孤岑，","蹋得苍苔一径深。"],["逃难人多分隙地，","放生麋大出寒林。"],["名应不朽轻仙骨，","理到忘机近佛心。"],["昨夜前溪骤雷雨，","晚晴闲步数峰吟。"]]}
{"id":"6b2250e5a8","title":"寄赠诗僧秀公","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵一心传清塞心，","可公吟后础公吟。","近来雅道相亲少，","惟仰吾师所得深。","好句未停无暇日，","旧山归老有东林。","冷曹孤宦甘寥落，","多谢携筇数访寻。"],"stanzas":[["灵一心传清塞心，","可公吟后础公吟。"],["近来雅道相亲少，","惟仰吾师所得深。"],["好句未停无暇日，","旧山归老有东林。"],["冷曹孤宦甘寥落，","多谢携筇数访寻。"]]}
{"id":"a571c57dde","title":"重阳日访元秀上人","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红叶黄花秋景宽，","醉吟朝夕在樊川。","却嫌今日登山俗，","且共高僧对榻眠。","别画长怀吴寺壁，","宜茶偏赏霅溪泉。","归来童穉争相笑，","何事无人与酒船。"],"stanzas":[["红叶黄花秋景宽，","醉吟朝夕在樊川。"],["却嫌今日登山俗，","且共高僧对榻眠。"],["别画长怀吴寺壁，","宜茶偏赏霅溪泉。"],["归来童穉争相笑，","何事无人与酒船。"]]}
{"id":"d0d99e73c3","title":"丁未岁归王官谷","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家山牢落战尘西，","匹马偷归路已迷。","冢上卷旗人簇立，","花边移寨鸟惊啼。","本来薄俗轻文字，","却致中原动鼓鼙。","将取一壶闲日月，","长歌深入武陵溪。"],"stanzas":[["家山牢落战尘西，","匹马偷归路已迷。"],["冢上卷旗人簇立，","花边移寨鸟惊啼。"],["本来薄俗轻文字，","却致中原动鼓鼙。"],["将取一壶闲日月，","长歌深入武陵溪。"]]}
{"id":"95b952eadd","title":"书怀","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["病来犹强引雏行，","力上东原欲试耕。","几处马嘶春麦长，","一川人喜雪峰晴。","闲知有味心难肯，","道贵谋安迹易平。","陶令若能兼不饮，","无弦琴亦是沽名。"],"stanzas":[["病来犹强引雏行，","力上东原欲试耕。"],["几处马嘶春麦长，","一川人喜雪峰晴。"],["闲知有味心难肯，","道贵谋安迹易平。"],["陶令若能兼不饮，","无弦琴亦是沽名。"]]}
{"id":"f80eb46e04","title":"退栖","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宦游萧索为无能，","移住中条最上层。","得劒乍如添健仆，","亡书久似失良朋。","燕昭不是空怜马，","支遁何妨亦爱鹰。","自此致身绳检外，","肯教世路日兢兢。"],"stanzas":[["宦游萧索为无能，","移住中条最上层。"],["得劒乍如添健仆，","亡书久似失良朋。"],["燕昭不是空怜马，","支遁何妨亦爱鹰。"],["自此致身绳检外，","肯教世路日兢兢。"]]}
{"id":"c78242f3ab","title":"五十","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲身事少只题诗，","五十今来觉陡衰。","清秩偶叨非养望，","丹方频试更堪疑。","髭须强染三分折，","弦管遥听一半悲。","漉酒有巾无黍酿，","负他黄菊满东篱。"],"stanzas":[["闲身事少只题诗，","五十今来觉陡衰。"],["清秩偶叨非养望，","丹方频试更堪疑。"],["髭须强染三分折，","弦管遥听一半悲。"],["漉酒有巾无黍酿，","负他黄菊满东篱。"]]}
{"id":"94802c12e5","title":"新岁对写真","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得见明时下寿身，","须甘岁酒更移巡。","生情暗结千重恨，","寒势常欺一半春。","文武轻销丹灶火，","市朝偏贵黑头人。","自伤衰飒慵开镜，","拟与儿童别写真。"],"stanzas":[["得见明时下寿身，","须甘岁酒更移巡。"],["生情暗结千重恨，","寒势常欺一半春。"],["文武轻销丹灶火，","市朝偏贵黑头人。"],["自伤衰飒慵开镜，","拟与儿童别写真。"]]}
{"id":"b36c98dec4","title":"华下","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["箨冠新带步池塘，","逸韵偏宜夏景长。","扶起绿荷承早露，","惊回白鸟入残阳。","久无书去干时贵，","时有僧来自故乡。","不用名山访真诀，","退休便是养生方。"],"stanzas":[["箨冠新带步池塘，","逸韵偏宜夏景长。"],["扶起绿荷承早露，","惊回白鸟入残阳。"],["久无书去干时贵，","时有僧来自故乡。"],["不用名山访真诀，","退休便是养生方。"]]}
{"id":"f5cb5fb361","title":"重阳山居","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗人自古恨难穷，","暮节登临且喜同。","四望交亲兵乱后，","一川风物笛声中。","菊残深处回幽蝶，","陂动晴光下早鸿。","明日更期来此醉，","不堪寂寞对衰翁。"],"stanzas":[["诗人自古恨难穷，","暮节登临且喜同。"],["四望交亲兵乱后，","一川风物笛声中。"],["菊残深处回幽蝶，","陂动晴光下早鸿。"],["明日更期来此醉，","不堪寂寞对衰翁。"]]}
{"id":"ecc342bd2d","title":"争名","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["争名岂在更搜奇，","不朽才消一句诗。","穷辱未甘英气阻，","乖疎还有正人知。","荷香浥露侵衣润，","松影和风傍枕移。","只此共栖尘外境，","无妨亦恋好文时。"],"stanzas":[["争名岂在更搜奇，","不朽才消一句诗。"],["穷辱未甘英气阻，","乖疎还有正人知。"],["荷香浥露侵衣润，","松影和风傍枕移。"],["只此共栖尘外境，","无妨亦恋好文时。"]]}
{"id":"7a5c19396a","title":"光启四年春戊申","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱后烧残数架书，","峰前犹自恋吾庐。","忘机渐喜逢人少，","览镜空怜待鹤疎。","孤屿池痕春涨满，","小阑花韵午晴初。","酣歌自适逃名久，","不必门多长者车。"],"stanzas":[["乱后烧残数架书，","峰前犹自恋吾庐。"],["忘机渐喜逢人少，","览镜空怜待鹤疎。"],["孤屿池痕春涨满，","小阑花韵午晴初。"],["酣歌自适逃名久，","不必门多长者车。"]]}
{"id":"88e47e7c05","title":"丁巳重阳","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重阳未到已登临，","探得黄花且独斟。","客舍喜逢连日雨，","家山似响隔河砧。","乱来已失耕桑计，","病后休论济活心。","自贺逢时能自弃，","归鞭唯拍马鞯吟。"],"stanzas":[["重阳未到已登临，","探得黄花且独斟。"],["客舍喜逢连日雨，","家山似响隔河砧。"],["乱来已失耕桑计，","病后休论济活心。"],["自贺逢时能自弃，","归鞭唯拍马鞯吟。"]]}
{"id":"a398001256","title":"喜王驾小仪重阳相访","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白菊初开卧内明，","闻君相访病身轻。","樽前且拨伤心事，","溪上还随觅句行。","幽鹤傍人疑旧识，","残蝉向日噪新晴。","拟将寂寞同留住，","且劝康时立大名。"],"stanzas":[["白菊初开卧内明，","闻君相访病身轻。"],["樽前且拨伤心事，","溪上还随觅句行。"],["幽鹤傍人疑旧识，","残蝉向日噪新晴。"],["拟将寂寞同留住，","且劝康时立大名。"]]}
{"id":"ca82606927","title":"酬张芬赦后见寄","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫凤朝衔五色书，","阳春忽布网罗除。","已将心变寒灰后，","岂料光生腐草余。","建水风烟收客泪，","杜陵花烛梦郊居。","劳君故有诗相赠，","欲报琼瑶愧不如。"],"stanzas":[["紫凤朝衔五色书，","阳春忽布网罗除。"],["已将心变寒灰后，","岂料光生腐草余。"],["建水风烟收客泪，","杜陵花烛梦郊居。"],["劳君故有诗相赠，","欲报琼瑶愧不如。"]]}
{"id":"720f078fa0","title":"上元放二雉","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["婴网虽皆困，","搴笼喜共归。","无心期尔报，","相见莫惊飞。"],"stanzas":[["婴网虽皆困，","搴笼喜共归。"],["无心期尔报，","相见莫惊飞。"]]}
{"id":"77a3210de2","title":"中秋","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲吟秋景外，","万事觉悠悠。","此夜若无月，","一年虚过秋。"],"stanzas":[["闲吟秋景外，","万事觉悠悠。"],["此夜若无月，","一年虚过秋。"]]}
{"id":"70bada6d66","title":"偶题","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水榭花繁处，","春晴日午前。","鸟窥临槛镜，","马过隔墙鞭。"],"stanzas":[["水榭花繁处，","春晴日午前。"],["鸟窥临槛镜，","马过隔墙鞭。"]]}
{"id":"4577772d99","title":"闲步","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几处白烟断，","一川红树时。","坏桥侵辙水，","残照背邨碑。"],"stanzas":[["几处白烟断，","一川红树时。"],["坏桥侵辙水，","残照背邨碑。"]]}
{"id":"2115bfb218","title":"春中","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伏溜侵堦润，","繁花隔竹香。","娇莺方晓听，","无事过南塘。"],"stanzas":[["伏溜侵堦润，","繁花隔竹香。"],["娇莺方晓听，","无事过南塘。"]]}
{"id":"4a82e2b54d","title":"独望","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿树连邨暗，","黄花出陌稀。","远陂春草绿，","犹有水禽飞。"],"stanzas":[["绿树连邨暗，","黄花出陌稀。"],["远陂春草绿，","犹有水禽飞。"]]}
{"id":"6446b1ef5c","title":"杂题","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤枕闻莺起，","幽怀独悄然。","地融春力润，","花泛晓光鲜。"],"stanzas":[["孤枕闻莺起，","幽怀独悄然。"],["地融春力润，","花泛晓光鲜。"]]}
{"id":"70c4379553","title":"漫题三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱后他乡节，","烧残故国春。","自怜垂白首，","犹伴踏青人。"],"stanzas":[["乱后他乡节，","烧残故国春。"],["自怜垂白首，","犹伴踏青人。"]]}
{"id":"70010f0d25","title":"漫题三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["齿落伤情久，","心惊健忘频。","蜗庐经岁客，","蚕市异乡人。"],"stanzas":[["齿落伤情久，","心惊健忘频。"],["蜗庐经岁客，","蚕市异乡人。"]]}
{"id":"4ed8ccc763","title":"漫题三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["率怕人言谨，","闲宜酒韵高。","山林若无虑，","名利不难逃。"],"stanzas":[["率怕人言谨，","闲宜酒韵高。"],["山林若无虑，","名利不难逃。"]]}
{"id":"4001959a58","title":"河上二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惨惨日将暮，","驱羸独到庄。","沙痕傍墟落，","风色入牛羊。"],"stanzas":[["惨惨日将暮，","驱羸独到庄。"],["沙痕傍墟落，","风色入牛羊。"]]}
{"id":"9ff062a864","title":"河上二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新霁田园处，","夕阳禾黍明。","沙邨平见水，","深巷有鸥声。"],"stanzas":[["新霁田园处，","夕阳禾黍明。"],["沙邨平见水，","深巷有鸥声。"]]}
{"id":"e403596159","title":"早朝","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白日新年好，","青春上国多。","街平双阙近，","尘起五云和。"],"stanzas":[["白日新年好，","青春上国多。"],["街平双阙近，","尘起五云和。"]]}
{"id":"43a29c3039","title":"即事二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茶爽添诗句，","天清莹道心。","只留鹤一只，","此外是空林。"],"stanzas":[["茶爽添诗句，","天清莹道心。"],["只留鹤一只，","此外是空林。"]]}
{"id":"6a6ebb8136","title":"即事二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御礼征奇策，","人心注盛时。","从来留振滞，","只待济临危。"],"stanzas":[["御礼征奇策，","人心注盛时。"],["从来留振滞，","只待济临危。"]]}
{"id":"bc5b4c9106","title":"永夜","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["永夜疑无日，","危时只赖山。","旷怀休戚外，","孤迹是非间。"],"stanzas":[["永夜疑无日，","危时只赖山。"],["旷怀休戚外，","孤迹是非间。"]]}
{"id":"b093f24cc1","title":"秦关","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["形胜今虽在，","荒凉恨不穷。","虎狼秦国破，","狐兔汉陵空。"],"stanzas":[["形胜今虽在，","荒凉恨不穷。"],["虎狼秦国破，","狐兔汉陵空。"]]}
{"id":"43ef39565a","title":"渡江","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋江共僧渡，","乡泪滴船回。","一夜吴船梦，","家书立马开。"],"stanzas":[["秋江共僧渡，","乡泪滴船回。"],["一夜吴船梦，","家书立马开。"]]}
{"id":"aeeb616c56","title":"退居漫题七首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花缺伤难缀，","莺喧奈细听。","惜春春已晚，","珍重草青青。"],"stanzas":[["花缺伤难缀，","莺喧奈细听。"],["惜春春已晚，","珍重草青青。"]]}
{"id":"4e015d879a","title":"退居漫题七首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堤柳自绵绵，","幽人无恨牵。","只忧诗病发，","莫寄校书牋。"],"stanzas":[["堤柳自绵绵，","幽人无恨牵。"],["只忧诗病发，","莫寄校书牋。"]]}
{"id":"4d900f05f8","title":"退居漫题七首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕语曾来客，","花催欲别人。","莫愁春又过，","看著又新春。"],"stanzas":[["燕语曾来客，","花催欲别人。"],["莫愁春又过，","看著又新春。"]]}
{"id":"ea5a21445a","title":"退居漫题七首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身外都无事，","山中久避喧。","破巢看乳燕，","留果待啼猨。"],"stanzas":[["身外都无事，","山中久避喧。"],["破巢看乳燕，","留果待啼猨。"]]}
{"id":"34252ae02c","title":"退居漫题七首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗家通籍美，","工部与司勋。","高贾虽难敌，","微官偶胜君。"],"stanzas":[["诗家通籍美，","工部与司勋。"],["高贾虽难敌，","微官偶胜君。"]]}
{"id":"4cb80ef6af","title":"退居漫题七首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["努力省前非，","人生上寿稀。","青云无直道，","暗室有危机。"],"stanzas":[["努力省前非，","人生上寿稀。"],["青云无直道，","暗室有危机。"]]}
{"id":"c7698026e4","title":"退居漫题七首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕拙营巢苦，","鱼贪触网惊。","岂缘身外事，","亦似我劳形。"],"stanzas":[["燕拙营巢苦，","鱼贪触网惊。"],["岂缘身外事，","亦似我劳形。"]]}
{"id":"a90d0d6d90","title":"即事九首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宿雨川原霁，","凭高景物新。","陂痕侵牧马，","云影带耕人。"],"stanzas":[["宿雨川原霁，","凭高景物新。"],["陂痕侵牧马，","云影带耕人。"]]}
{"id":"0815e58a55","title":"即事九首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十年深隐地，","一雨太平心。","匣涩休看劒，","窗明复上琴。"],"stanzas":[["十年深隐地，","一雨太平心。"],["匣涩休看劒，","窗明复上琴。"]]}
{"id":"4c30d9c346","title":"即事九首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明时那弃置，","多病自迟留。","疎磬和吟断，","残灯照卧幽。"],"stanzas":[["明时那弃置，","多病自迟留。"],["疎磬和吟断，","残灯照卧幽。"]]}
{"id":"5bac7c17b8","title":"即事九首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["衰鬓闲生少，","丹梯望觉危。","松须依石长，","鹤不傍人卑。"],"stanzas":[["衰鬓闲生少，","丹梯望觉危。"],["松须依石长，","鹤不傍人卑。"]]}
{"id":"a7a7558f46","title":"即事九首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落叶频惊鹿，","连峰欲映雕。","此生诗病苦，","此病更萧条。"],"stanzas":[["落叶频惊鹿，","连峰欲映雕。"],["此生诗病苦，","此病更萧条。"]]}
{"id":"bc15c4b935","title":"即事九首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旅思又惊夏，","庭前长小松。","远峰生贵气，","残月歛衰容。"],"stanzas":[["旅思又惊夏，","庭前长小松。"],["远峰生贵气，","残月歛衰容。"]]}
{"id":"e6cc98c213","title":"即事九首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["林鸟频窥静，","家人亦笑慵。","旧居留稳枕，","归卧听秋钟。"],"stanzas":[["林鸟频窥静，","家人亦笑慵。"],["旧居留稳枕，","归卧听秋钟。"]]}
{"id":"e225099b59","title":"即事九首 八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华宇知难保，","烧来又却修。","只应巢燕惜，","未必主人留。"],"stanzas":[["华宇知难保，","烧来又却修。"],["只应巢燕惜，","未必主人留。"]]}
{"id":"95e277607d","title":"即事九首 九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽鸟穿篱去，","邻翁采药回。","云从潭底出，","花向佛前开。"],"stanzas":[["幽鸟穿篱去，","邻翁采药回。"],["云从潭底出，","花向佛前开。"]]}
{"id":"1a405eae79","title":"松滋渡二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["步上短亭久，","看回官渡船。","江乡宜晚霁，","楚老语丰年。"],"stanzas":[["步上短亭久，","看回官渡船。"],["江乡宜晚霁，","楚老语丰年。"]]}
{"id":"e9dafe5cbc","title":"松滋渡二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚岫接乡思，","茫茫归路迷。","更堪斑竹驿，","初听鹧鸪啼。"],"stanzas":[["楚岫接乡思，","茫茫归路迷。"],["更堪斑竹驿，","初听鹧鸪啼。"]]}
{"id":"20c839009c","title":"华清宫","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["帝业山河固，","离宫宴幸频。","岂知驱战马，","只是太平人。"],"stanzas":[["帝业山河固，","离宫宴幸频。"],["岂知驱战马，","只是太平人。"]]}
{"id":"089d0432b9","title":"牛头寺","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["终南最佳处，","禅诵出青霄。","群木澄幽寂，","疎烟泛泬寥。"],"stanzas":[["终南最佳处，","禅诵出青霄。"],["群木澄幽寂，","疎烟泛泬寥。"]]}
{"id":"538ef1dffd","title":"感时上卢相","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兵待皇威振，","人随国步安。","万方休望幸，","封岳始鸣銮。"],"stanzas":[["兵待皇威振，","人随国步安。"],["万方休望幸，","封岳始鸣銮。"]]}
{"id":"85203be6bc","title":"乱后三首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丧乱家难保，","艰虞病懒医。","空将忧国泪，","犹拟洒丹墀。"],"stanzas":[["丧乱家难保，","艰虞病懒医。"],["空将忧国泪，","犹拟洒丹墀。"]]}
{"id":"6230126f9c","title":"乱后三首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流芳能几日，","惆怅又闻蝉。","行在多新贵，","幽栖独长年。"],"stanzas":[["流芳能几日，","惆怅又闻蝉。"],["行在多新贵，","幽栖独长年。"]]}
{"id":"13e57a6e7b","title":"乱后三首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世事尝艰险，","僧居惯寂寥。","美香闻夜合，","清景见寅朝。"],"stanzas":[["世事尝艰险，","僧居惯寂寥。"],["美香闻夜合，","清景见寅朝。"]]}
{"id":"33aded3c02","title":"秋景","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["景物皆难驻，","伤春复怨秋。","旋书红叶落，","拟画碧云收。"],"stanzas":[["景物皆难驻，","伤春复怨秋。"],["旋书红叶落，","拟画碧云收。"]]}
{"id":"c5428ff889","title":"避乱","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["离乱身偶在，","窜迹任浮沉。","虎暴荒居逈，","萤孤黑夜深。"],"stanzas":[["离乱身偶在，","窜迹任浮沉。"],["虎暴荒居逈，","萤孤黑夜深。"]]}
{"id":"8f532b9360","title":"长亭","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梅雨和乡泪，","终年共酒衣。","殷勤华表鹤，","羡尔亦曾归。"],"stanzas":[["梅雨和乡泪，","终年共酒衣。"],["殷勤华表鹤，","羡尔亦曾归。"]]}
{"id":"13a087b519","title":"邨西杏花二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["薄腻力偏羸，","看看怆别时。","东风狂不惜，","西子病难医。"],"stanzas":[["薄腻力偏羸，","看看怆别时。"],["东风狂不惜，","西子病难医。"]]}
{"id":"c793d3c284","title":"邨西杏花二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["肌细分红脉，","香浓破紫苞。","无因留得玩，","争忍折来抛。"],"stanzas":[["肌细分红脉，","香浓破紫苞。"],["无因留得玩，","争忍折来抛。"]]}
{"id":"70a0a4d88c","title":"独坐","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽径入桑麻，","坞西逢一家。","编篱薪带茧，","补屋草和花。"],"stanzas":[["幽径入桑麻，","坞西逢一家。"],["编篱薪带茧，","补屋草和花。"]]}
{"id":"f34d7654e4","title":"借居","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["借住郊园久，","仍逢夏景新。","绿苔行屐稳，","黄鸟傍窗频。"],"stanzas":[["借住郊园久，","仍逢夏景新。"],["绿苔行屐稳，","黄鸟傍窗频。"]]}
{"id":"4e9e70d7b3","title":"重阳","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["菊开犹阻雨，","蝶意切于人。","亦应知暮节，","不比惜残春。"],"stanzas":[["菊开犹阻雨，","蝶意切于人。"],["亦应知暮节，","不比惜残春。"]]}
{"id":"401b4ff75b","title":"偶书五首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["衰榭当何忏，","惟应悔壮图。","磬声花外远，","人影塔前孤。"],"stanzas":[["衰榭当何忏，","惟应悔壮图。"],["磬声花外远，","人影塔前孤。"]]}
{"id":"a88cc282fe","title":"偶书五首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["色变莺雏长，","竿齐笋箨垂。","白头身偶在，","清夏景还移。"],"stanzas":[["色变莺雏长，","竿齐笋箨垂。"],["白头身偶在，","清夏景还移。"]]}
{"id":"a1254756d4","title":"偶书五首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀妓轻成妙，","吴娃狎共纤。","晚妆留拜月，","卷上水精帘。"],"stanzas":[["蜀妓轻成妙，","吴娃狎共纤。"],["晚妆留拜月，","卷上水精帘。"]]}
{"id":"6299a6a670","title":"偶书五首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独步荒郊暮，","沉思远墅幽。","平生多少事，","弹指一时休。"],"stanzas":[["独步荒郊暮，","沉思远墅幽。"],["平生多少事，","弹指一时休。"]]}
{"id":"a69d0d1d7a","title":"偶书五首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["掩谤知迎吠，","欺心见强颜。","有名人易困，","无契债难还。"],"stanzas":[["掩谤知迎吠，","欺心见强颜。"],["有名人易困，","无契债难还。"]]}
{"id":"1f221d9b02","title":"杂题九首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["病来胜未病，","名缚便忘名。","今日甘为客，","当时注愍征。"],"stanzas":[["病来胜未病，","名缚便忘名。"],["今日甘为客，","当时注愍征。"]]}
{"id":"ae4e4bfd91","title":"杂题九首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暑湿深山雨，","荒居破屋灯。","此生无忏处，","此去作高僧。"],"stanzas":[["暑湿深山雨，","荒居破屋灯。"],["此生无忏处，","此去作高僧。"]]}
{"id":"f61dca7972","title":"杂题九首 三","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不须频怅望，","且喜脱喧嚣。","亦有终焉意，","陂南看稻苗。"],"stanzas":[["不须频怅望，","且喜脱喧嚣。"],["亦有终焉意，","陂南看稻苗。"]]}
{"id":"2039199b3a","title":"杂题九首 四","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼带猨吟迥，","庭容鹤舞宽。","晒书因阅画，","封药偶和丹。"],"stanzas":[["楼带猨吟迥，","庭容鹤舞宽。"],["晒书因阅画，","封药偶和丹。"]]}
{"id":"ec08aad777","title":"杂题九首 五","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宴罢论诗久，","亭高拜表频。","岸香蕃舶月，","洲色海烟春。"],"stanzas":[["宴罢论诗久，","亭高拜表频。"],["岸香蕃舶月，","洲色海烟春。"]]}
{"id":"d819082116","title":"杂题九首 六","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["驿步堤萦阁，","军城鼓振桥。","鸥和湖鴈下，","雪隔岭梅飘。"],"stanzas":[["驿步堤萦阁，","军城鼓振桥。"],["鸥和湖鴈下，","雪隔岭梅飘。"]]}
{"id":"f7dadba819","title":"杂题九首 七","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["带雪南山道，","和钟北阙明。","太平当共贺，","开化喝来声。"],"stanzas":[["带雪南山道，","和钟北阙明。"],["太平当共贺，","开化喝来声。"]]}
{"id":"471dac0097","title":"杂题九首 八","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舴艋猨偷上，","蜻蜓燕竞飞。","樵香烧桂子，","苔湿挂莎衣。"],"stanzas":[["舴艋猨偷上，","蜻蜓燕竞飞。"],["樵香烧桂子，","苔湿挂莎衣。"]]}
{"id":"695f0cf586","title":"杂题九首 九","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溪涨渔家近，","烟收鸟道高。","松花飘可惜，","睡里洒离骚。"],"stanzas":[["溪涨渔家近，","烟收鸟道高。"],["松花飘可惜，","睡里洒离骚。"]]}
{"id":"80755e278e","title":"古乐府","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一叶随西风，","君行亦向东。","知妾飞书意，","无劳待早鸿。"],"stanzas":[["一叶随西风，","君行亦向东。"],["知妾飞书意，","无劳待早鸿。"]]}
{"id":"bb42553ad7","title":"有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灯影看须黑，","墙阴惜草青。","岁阑悲物我，","同是冒霜萤。"],"stanzas":[["灯影看须黑，","墙阴惜草青。"],["岁阑悲物我，","同是冒霜萤。"]]}
{"id":"58313e109a","title":"休休亭","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["且喜安能保，","那堪病更忧。","可怜藜杖者，","真个种瓜侯。"],"stanzas":[["且喜安能保，","那堪病更忧。"],["可怜藜杖者，","真个种瓜侯。"]]}
{"id":"158d427a6c","title":"漫书二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["剩欲逢花折，","判须冒雨频。","晴明开渐少，","莫怕湿新巾。"],"stanzas":[["剩欲逢花折，","判须冒雨频。"],["晴明开渐少，","莫怕湿新巾。"]]}
{"id":"984c05a85d","title":"漫书二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小蝶尔何竞，","追飞不惮劳。","远教群雀见，","宁悟祸梯高。"],"stanzas":[["小蝶尔何竞，","追飞不惮劳。"],["远教群雀见，","宁悟祸梯高。"]]}
{"id":"4e4760a03c","title":"岁尽二首 一","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明日添一岁，","端忧奈尔何。","冲寒出洞口，","犹校夕阳多。"],"stanzas":[["明日添一岁，","端忧奈尔何。"],["冲寒出洞口，","犹校夕阳多。"]]}
{"id":"70b68e17fa","title":"岁尽二首 二","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫话伤心事，","投春满鬓霜。","殷勤共尊酒，","今岁只残阳。"],"stanzas":[["莫话伤心事，","投春满鬓霜。"],["殷勤共尊酒，","今岁只残阳。"]]}
{"id":"923fe9554f","title":"牡丹","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得地牡丹盛，","晓添龙麝香。","主人犹自惜，","锦幕护春霜。"],"stanzas":[["得地牡丹盛，","晓添龙麝香。"],["主人犹自惜，","锦幕护春霜。"]]}
{"id":"7392f7f1ac","title":"乱后","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["羽书传栈道，","风火隔乡关。","病眼那堪泣，","伤心不到间。"],"stanzas":[["羽书传栈道，","风火隔乡关。"],["病眼那堪泣，","伤心不到间。"]]}
{"id":"42c38baba2","title":"春山","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可是武陵溪，","春芳著路迷。","花明催曙早，","云腻惹空低。"],"stanzas":[["可是武陵溪，","春芳著路迷。"],["花明催曙早，","云腻惹空低。"]]}
{"id":"01b6a6ecc4","title":"乐府","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝马跋尘光，","双驰照路旁。","喧传报戚里，","明日幸长杨。"],"stanzas":[["宝马跋尘光，","双驰照路旁。"],["喧传报戚里，","明日幸长杨。"]]}
{"id":"d72085af0a","title":"乱前上卢相","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虏黠虽多变，","兵骄即易乘。","犹须劳斥候，","勿遣大河冰。"],"stanzas":[["虏黠虽多变，","兵骄即易乘。"],["犹须劳斥候，","勿遣大河冰。"]]}
{"id":"8625af4a19","title":"有感","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["国事皆须救未然，","汉家高阁漫凌烟。","功臣尽遣词人赞，","不省沧洲画鲁连。"],"stanzas":[["国事皆须救未然，","汉家高阁漫凌烟。"],["功臣尽遣词人赞，","不省沧洲画鲁连。"]]}
{"id":"fa252b6736","title":"歌","author":"司空图","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["处处亭台只坏墙，","军营人学内人妆。","太平故事因君唱，","马上曾听隔教坊。"],"stanzas":[["处处亭台只坏墙，","军营人学内人妆。"],["太平故事因君唱，","马上曾听隔教坊。"]]}
