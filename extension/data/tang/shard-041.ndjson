{"id":"43d6f840c3","title":"霓裳词十首 八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["传呼法部按霓裳，","新得承恩别作行。","应是贵妃楼上看，","内人舁下彩罗箱。"],"stanzas":[["传呼法部按霓裳，","新得承恩别作行。"],["应是贵妃楼上看，","内人舁下彩罗箱。"]]}
{"id":"4b51975a2d","title":"霓裳词十首 九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝元阁上山风起，","夜听霓裳玉露寒。","宫女月中更替立，","黄金梯滑并行难。"],"stanzas":[["朝元阁上山风起，","夜听霓裳玉露寒。"],["宫女月中更替立，","黄金梯滑并行难。"]]}
{"id":"bb48f742a8","title":"霓裳词十首 十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["知向华清年月满，","山头山底种长生。","去时留下霓裳曲，","总是离宫别馆声。"],"stanzas":[["知向华清年月满，","山头山底种长生。"],["去时留下霓裳曲，","总是离宫别馆声。"]]}
{"id":"e55bcf2a8a","title":"宫前早春","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒幔高楼一百家，","宫前杨柳寺前花。","内园分得温汤水，","二月中旬已进瓜。"],"stanzas":[["酒幔高楼一百家，","宫前杨柳寺前花。"],["内园分得温汤水，","二月中旬已进瓜。"]]}
{"id":"80029adc66","title":"奉同曾郎中题石瓮寺得嵌韵","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寺门连内绕丹岩，","下界云开数过帆。","遥指上皇翻曲处，","百官题字满西嵌。"],"stanzas":[["寺门连内绕丹岩，","下界云开数过帆。"],["遥指上皇翻曲处，","百官题字满西嵌。"]]}
{"id":"2c21efcdbd","title":"旧宫人","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["先帝旧宫宫女在，","乱丝犹挂凤皇钗。","霓裳法曲浑抛却，","独自花间埽玉堦。"],"stanzas":[["先帝旧宫宫女在，","乱丝犹挂凤皇钗。"],["霓裳法曲浑抛却，","独自花间埽玉堦。"]]}
{"id":"1d099220fd","title":"新授戒尼师","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新短方裙叠作棱，","听钟洗钵绕青蝇。","自知戒相分明后，","先出坛场礼大僧。"],"stanzas":[["新短方裙叠作棱，","听钟洗钵绕青蝇。"],["自知戒相分明后，","先出坛场礼大僧。"]]}
{"id":"bf465b3454","title":"太和公主和蕃","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["塞黑云黄欲渡河，","风沙瞇眼雪相和。","琵琶泪湿行声小，","断得人肠不在多。"],"stanzas":[["塞黑云黄欲渡河，","风沙瞇眼雪相和。"],["琵琶泪湿行声小，","断得人肠不在多。"]]}
{"id":"b92a3b5f7c","title":"元太守同游七泉寺","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盘磴回廊古塔深，","紫芝红药入云寻。","晚吹箫管秋山里，","引得猕猴出象林。"],"stanzas":[["盘磴回廊古塔深，","紫芝红药入云寻。"],["晚吹箫管秋山里，","引得猕猴出象林。"]]}
{"id":"472418d46a","title":"望定州寺","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回看佛阁青山半，","三四年前到上头。","省得老僧留不住，","重寻更可有因由。"],"stanzas":[["回看佛阁青山半，","三四年前到上头。"],["省得老僧留不住，","重寻更可有因由。"]]}
{"id":"5324e586ff","title":"道中寄杜书记","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西南东北暮天斜，","巴字江边楚树花。","珍重荆州杜书记，","闲时多在广师家。"],"stanzas":[["西南东北暮天斜，","巴字江边楚树花。"],["珍重荆州杜书记，","闲时多在广师家。"]]}
{"id":"c06af2f6d1","title":"听琴","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无事此身离白云，","松风溪水不曾闻。","至心听著仙翁引，","今看青山围绕君。"],"stanzas":[["无事此身离白云，","松风溪水不曾闻。"],["至心听著仙翁引，","今看青山围绕君。"]]}
{"id":"8a1ceaa431","title":"赠陈评事","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["识君虽向歌钟会，","说事不离云水间。","春夜酒醒长起坐，","灯前一纸洞庭山。"],"stanzas":[["识君虽向歌钟会，","说事不离云水间。"],["春夜酒醒长起坐，","灯前一纸洞庭山。"]]}
{"id":"aef68c186e","title":"寄画松僧","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天香寺里古松僧，","不画枯松落石层。","最爱临江两三树，","水禽栖处解无藤。"],"stanzas":[["天香寺里古松僧，","不画枯松落石层。"],["最爱临江两三树，","水禽栖处解无藤。"]]}
{"id":"cd58e42a3b","title":"花褐裘","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["对织芭蕉雪毳新，","长缝双袖窄裁身。","到头须向边城著，","消杀秋风称猎尘。"],"stanzas":[["对织芭蕉雪毳新，","长缝双袖窄裁身。"],["到头须向边城著，","消杀秋风称猎尘。"]]}
{"id":"b212b06acf","title":"夜看美人宫棋","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫棋布局不依经，","黑白分明子数停。","巡拾玉沙天汉晓，","犹残织女两三星。"],"stanzas":[["宫棋布局不依经，","黑白分明子数停。"],["巡拾玉沙天汉晓，","犹残织女两三星。"]]}
{"id":"83461bf0f9","title":"上田仆射","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一方新地隔河烟，","曾接诸生听管弦。","却忆去年寒食会，","看花犹在水堂前。"],"stanzas":[["一方新地隔河烟，","曾接诸生听管弦。"],["却忆去年寒食会，","看花犹在水堂前。"]]}
{"id":"bf98c2a828","title":"江陵道中","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["菱叶参差萍叶重，","新蒲半折夜来风。","江村水落平地出，","溪畔渔船青草中。"],"stanzas":[["菱叶参差萍叶重，","新蒲半折夜来风。"],["江村水落平地出，","溪畔渔船青草中。"]]}
{"id":"793b2a7934","title":"冬至后招于秀才","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日近山红暖气新，","一阳先入御沟春。","闻闲立马重来此，","沐浴明年称意身。"],"stanzas":[["日近山红暖气新，","一阳先入御沟春。"],["闻闲立马重来此，","沐浴明年称意身。"]]}
{"id":"b86fa95724","title":"别曲","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["毒蛇在肠疮满背，","去年别家今别弟。","马头对哭各东西，","天边柳絮无根蔕。"],"stanzas":[["毒蛇在肠疮满背，","去年别家今别弟。"],["马头对哭各东西，","天边柳絮无根蔕。"]]}
{"id":"68ef491773","title":"长安别","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安清明好时节，","只宜相送不宜别。","恶心床上铜片明，","照见离人白头发。"],"stanzas":[["长安清明好时节，","只宜相送不宜别。"],["恶心床上铜片明，","照见离人白头发。"]]}
{"id":"d7270801c5","title":"宫人斜","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未央墙西青草路，","宫人斜里红妆墓。","一边载出一边来，","更衣不减寻常数。"],"stanzas":[["未央墙西青草路，","宫人斜里红妆墓。"],["一边载出一边来，","更衣不减寻常数。"]]}
{"id":"c2ce823126","title":"春词","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["良人朝早半夜起，","樱桃如珠露如水。","下堂把火送郎回，","移枕重眠晓窗里。"],"stanzas":[["良人朝早半夜起，","樱桃如珠露如水。"],["下堂把火送郎回，","移枕重眠晓窗里。"]]}
{"id":"751f6568d6","title":"野池","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野池水满连秋隄，","菱花结实蒲叶齐。","川口雨晴风复止，","蜻蜓上下鱼东西。"],"stanzas":[["野池水满连秋隄，","菱花结实蒲叶齐。"],["川口雨晴风复止，","蜻蜓上下鱼东西。"]]}
{"id":"3ff98eeb2a","title":"题崔秀才里居","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自知名出休呈卷，","爱去人家远处居。","时复打门无别事，","铺头来索买残书。"],"stanzas":[["自知名出休呈卷，","爱去人家远处居。"],["时复打门无别事，","铺头来索买残书。"]]}
{"id":"28cbc50b93","title":"酬栢侍御荅酒","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茱萸酒法大家同，","好是盛来白椀中。","这度自知颜色重，","不消诗里弄溪翁。"],"stanzas":[["茱萸酒法大家同，","好是盛来白椀中。"],["这度自知颜色重，","不消诗里弄溪翁。"]]}
{"id":"226604ef99","title":"别药栏","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芍药丁香手里栽，","临行一日绕千回。","外人应怪难辞别，","总是山中自取来。"],"stanzas":[["芍药丁香手里栽，","临行一日绕千回。"],["外人应怪难辞别，","总是山中自取来。"]]}
{"id":"d8c64513c7","title":"长门","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长门闭定不求生，","烧却头花卸却筝。","病卧玉窗秋雨下，","遥闻别院唤人声。"],"stanzas":[["长门闭定不求生，","烧却头花卸却筝。"],["病卧玉窗秋雨下，","遥闻别院唤人声。"]]}
{"id":"f146a5760c","title":"题渭亭","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云开远水傍秋天，","沙岸蒲帆隔野烟。","一片蔡州青草色，","日西铺在古台边。"],"stanzas":[["云开远水傍秋天，","沙岸蒲帆隔野烟。"],["一片蔡州青草色，","日西铺在古台边。"]]}
{"id":"cd2a91baa8","title":"过喜祥山馆","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜过深山算驿程，","三回黑地听泉声。","自离军马身轻健，","得向溪边尽足行。"],"stanzas":[["夜过深山算驿程，","三回黑地听泉声。"],["自离军马身轻健，","得向溪边尽足行。"]]}
{"id":"eed40f0cff","title":"送迁客","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里潮州一逐臣，","悠悠青草海边春。","天涯莫道无回日，","上岭还逢向北人。"],"stanzas":[["万里潮州一逐臣，","悠悠青草海边春。"],["天涯莫道无回日，","上岭还逢向北人。"]]}
{"id":"948d4eb4f2","title":"废寺","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["废寺乱来为县驿，","荒松老柏不生烟。","空廊屋漏画僧尽，","梁上犹书天宝年。"],"stanzas":[["废寺乱来为县驿，","荒松老柏不生烟。"],["空廊屋漏画僧尽，","梁上犹书天宝年。"]]}
{"id":"b1f586c739","title":"题禅师房","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浮生不住叶随风，","填海移山总是空。","长向人间愁老病，","谁来闲坐此房中。"],"stanzas":[["浮生不住叶随风，","填海移山总是空。"],["长向人间愁老病，","谁来闲坐此房中。"]]}
{"id":"c3143b1baf","title":"看石楠花","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["留得行人忘却归，","雨中须是石楠枝。","明朝独上铜台路，","容见花开少许时。"],"stanzas":[["留得行人忘却归，","雨中须是石楠枝。"],["明朝独上铜台路，","容见花开少许时。"]]}
{"id":"0cad181e56","title":"长安县后亭看画","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水冻横桥雪满池，","新排石笋绕巴篱。","县门斜掩无人吏，","看画双飞白鹭鸶。"],"stanzas":[["水冻横桥雪满池，","新排石笋绕巴篱。"],["县门斜掩无人吏，","看画双飞白鹭鸶。"]]}
{"id":"352caac9a4","title":"华岳庙二首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["女巫遮客买神盘，","争取琵琶庙里弹。","闻有马蹄生拍树，","路人来去向南看。"],"stanzas":[["女巫遮客买神盘，","争取琵琶庙里弹。"],["闻有马蹄生拍树，","路人来去向南看。"]]}
{"id":"9a04e6694c","title":"华岳庙二首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自移西岳门长锁，","一个行人一遍开。","上庙参天今见在，","夜头风起觉神来。"],"stanzas":[["自移西岳门长锁，","一个行人一遍开。"],["上庙参天今见在，","夜头风起觉神来。"]]}
{"id":"7a85ab4a2e","title":"酬赵侍御","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年少同为邺下游，","闲寻野寺醉登楼。","别来衣马从胜旧，","争向边尘满白头。"],"stanzas":[["年少同为邺下游，","闲寻野寺醉登楼。"],["别来衣马从胜旧，","争向边尘满白头。"]]}
{"id":"569f627c45","title":"镊白","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["总道老来无用处，","何须白发在前生。","如今不用偷年少，","拔却三茎又五茎。"],"stanzas":[["总道老来无用处，","何须白发在前生。"],["如今不用偷年少，","拔却三茎又五茎。"]]}
{"id":"670ece3fa8","title":"送山人二首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嵩山古寺离来久。","回见溪桥野叶黄，","辛苦老师看守处。","为悬秋药闭空房。"],"stanzas":[["嵩山古寺离来久。"],["回见溪桥野叶黄，","辛苦老师看守处。"],["为悬秋药闭空房。"]]}
{"id":"e17044e0bc","title":"送山人二首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山客狂来跨白驴，","袖中遗却颍阳书。","人间亦有妻儿在，","抛向嵩阳古观居。"],"stanzas":[["山客狂来跨白驴，","袖中遗却颍阳书。"],["人间亦有妻儿在，","抛向嵩阳古观居。"]]}
{"id":"461d48ca70","title":"扬州寻张籍不见","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["别后知君在楚城，","扬州寺里觅君名。","西江水阔吴山远，","却打船头向北行。"],"stanzas":[["别后知君在楚城，","扬州寺里觅君名。"],["西江水阔吴山远，","却打船头向北行。"]]}
{"id":"b52824f276","title":"宿长安县后斋","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新向金阶奏罢兵，","长安县里绕池行。","喜欢得伴山僧宿，","看雪吟诗直到明。"],"stanzas":[["新向金阶奏罢兵，","长安县里绕池行。"],["喜欢得伴山僧宿，","看雪吟诗直到明。"]]}
{"id":"dca6b0c089","title":"夜看扬州市","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜市千灯照碧云，","高楼红袖客纷纷。","如今不似时平日，","犹自笙歌彻晓闻。"],"stanzas":[["夜市千灯照碧云，","高楼红袖客纷纷。"],["如今不似时平日，","犹自笙歌彻晓闻。"]]}
{"id":"96109f7899","title":"寄韦谏议","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百年看似暂时间，","头白求官亦未闲。","独有龙门韦谏议，","三征不起恋青山。"],"stanzas":[["百年看似暂时间，","头白求官亦未闲。"],["独有龙门韦谏议，","三征不起恋青山。"]]}
{"id":"ae856ec5d8","title":"寻补阙旧宅","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["知得清名二十年，","登山上坂乞新篇。","除书近拜侍臣去，","空院鸟啼风竹前。"],"stanzas":[["知得清名二十年，","登山上坂乞新篇。"],["除书近拜侍臣去，","空院鸟啼风竹前。"]]}
{"id":"15dcc23e90","title":"初冬旅游","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远投人宿趁房迟，","僮仆伤寒马亦饥。","为客悠悠十月尽，","庄头栽竹已过时。"],"stanzas":[["远投人宿趁房迟，","僮仆伤寒马亦饥。"],["为客悠悠十月尽，","庄头栽竹已过时。"]]}
{"id":"5c25dc6824","title":"江馆对雨","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸟声愁雨似秋天，","病客思家一向眠。","草馆门临广州路，","夜闻蛮语小江边。"],"stanzas":[["鸟声愁雨似秋天，","病客思家一向眠。"],["草馆门临广州路，","夜闻蛮语小江边。"]]}
{"id":"30eeb4b055","title":"雨过山村","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨里鸡鸣一两家，","竹溪村路板桥斜。","妇姑相唤浴蚕去，","闲看中庭栀子花。"],"stanzas":[["雨里鸡鸣一两家，","竹溪村路板桥斜。"],["妇姑相唤浴蚕去，","闲看中庭栀子花。"]]}
{"id":"c8dc7c4eaa","title":"山店","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["登登石路何时尽，","决决溪泉到处闻。","风动叶声山犬吠，","一家松火隔秋云。"],"stanzas":[["登登石路何时尽，","决决溪泉到处闻。"],["风动叶声山犬吠，","一家松火隔秋云。"]]}
{"id":"ad71493a12","title":"雨中寄东溪韦处士","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨中溪破无干地，","浸著床头湿著书。","一个月来山水隔，","不知茅屋若为居。"],"stanzas":[["雨中溪破无干地，","浸著床头湿著书。"],["一个月来山水隔，","不知茅屋若为居。"]]}
{"id":"bde21330e7","title":"乞竹","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乞取池西三两竿，","房前栽著病时看。","亦知自惜难判割，","犹胜横根引出栏。"],"stanzas":[["乞取池西三两竿，","房前栽著病时看。"],["亦知自惜难判割，","犹胜横根引出栏。"]]}
{"id":"a914f130bf","title":"人家看花","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年少狂疎逐君马，","去来憔悴到京华。","恨无闲地栽仙药，","长傍人家看好花。"],"stanzas":[["年少狂疎逐君马，","去来憔悴到京华。"],["恨无闲地栽仙药，","长傍人家看好花。"]]}
{"id":"7411a52e68","title":"未央风","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五更先起玉阶东，","渐入千门万户中。","总向高楼吹舞袖，","秋风还不及春风。"],"stanzas":[["五更先起玉阶东，","渐入千门万户中。"],["总向高楼吹舞袖，","秋风还不及春风。"]]}
{"id":"59b3d18907","title":"归山庄","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安寄食半年余，","重向人边乞荐书。","山路独归冲夜雪，","落斜骑马避柴车。"],"stanzas":[["长安寄食半年余，","重向人边乞荐书。"],["山路独归冲夜雪，","落斜骑马避柴车。"]]}
{"id":"b22a5f6c8c","title":"寒食忆归","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["京中曹局无多事，","寒食贫儿要在家。","遮莫杏园胜别处，","亦须归看傍村花。"],"stanzas":[["京中曹局无多事，","寒食贫儿要在家。"],["遮莫杏园胜别处，","亦须归看傍村花。"]]}
{"id":"bebb5982b9","title":"留别张广文","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢恩新入凤皇城，","乱定相逢合眼明。","千万求方好将息，","杏花寒食的同行。"],"stanzas":[["谢恩新入凤皇城，","乱定相逢合眼明。"],["千万求方好将息，","杏花寒食的同行。"]]}
{"id":"7366c6db02","title":"送郑山人归山","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉作车辕蒲作轮，","当初不起颍阳人。","一家总入嵩山去，","天子何因得谏臣。"],"stanzas":[["玉作车辕蒲作轮，","当初不起颍阳人。"],["一家总入嵩山去，","天子何因得谏臣。"]]}
{"id":"3db5cc7878","title":"伤堕水乌","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一乌堕水百乌啼，","相吊相号绕故堤。","眼见行人车辗过，","不妨同伴各东西。"],"stanzas":[["一乌堕水百乌啼，","相吊相号绕故堤。"],["眼见行人车辗过，","不妨同伴各东西。"]]}
{"id":"8d91d75a46","title":"看碁","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["彼此抽先局势平，","傍人道死的还生。","两边对坐无言语，","尽日时闻下子声。"],"stanzas":[["彼此抽先局势平，","傍人道死的还生。"],["两边对坐无言语，","尽日时闻下子声。"]]}
{"id":"77a8f3e4ca","title":"设酒寄独孤少府","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自看和酿一依方，","缘看松花色较黄。","不分君家新酒熟，","好诗收得被回将。"],"stanzas":[["自看和酿一依方，","缘看松花色较黄。"],["不分君家新酒熟，","好诗收得被回将。"]]}
{"id":"4d9ddc1039","title":"赠人二首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金炉烟里要班头，","欲得归山可自由。","每度报朝愁入阁，","在先教示小千牛。"],"stanzas":[["金炉烟里要班头，","欲得归山可自由。"],["每度报朝愁入阁，","在先教示小千牛。"]]}
{"id":"a7640769ca","title":"赠人二首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["多在蓬莱少在家，","越绯衫上有红霞。","朝回不向诸余处，","骑马城西检校花。"],"stanzas":[["多在蓬莱少在家，","越绯衫上有红霞。"],["朝回不向诸余处，","骑马城西检校花。"]]}
{"id":"a6f8594bec","title":"楼前","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天宝年前勤政楼，","每年三日作千秋。","飞龙老马曾教舞，","闻著音声总举头。"],"stanzas":[["天宝年前勤政楼，","每年三日作千秋。"],["飞龙老马曾教舞，","闻著音声总举头。"]]}
{"id":"071fcdd8f6","title":"寄刘蕡问疾","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年少病多应为酒，","谁家将息过今春。","赊来半夏重熏尽，","投著山中旧主人。"],"stanzas":[["年少病多应为酒，","谁家将息过今春。"],["赊来半夏重熏尽，","投著山中旧主人。"]]}
{"id":"2b1397ef93","title":"听雨","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["半夜思家睡里愁，","雨声落落屋簷头。","照泥星出依前黑，","淹烂庭花不肯休。"],"stanzas":[["半夜思家睡里愁，","雨声落落屋簷头。"],["照泥星出依前黑，","淹烂庭花不肯休。"]]}
{"id":"b0e8d98b93","title":"新晴","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夏夜新晴星校少，","雨收残水入天河。","簷前熟著衣裳坐，","风冷浑无扑火蛾。"],"stanzas":[["夏夜新晴星校少，","雨收残水入天河。"],["簷前熟著衣裳坐，","风冷浑无扑火蛾。"]]}
{"id":"0be28c8981","title":"秋日后","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["住处近山常足雨，","闻晴晒曝旧芳茵。","立秋日后无多热，","渐觉生衣不著身。"],"stanzas":[["住处近山常足雨，","闻晴晒曝旧芳茵。"],["立秋日后无多热，","渐觉生衣不著身。"]]}
{"id":"1500c8ba75","title":"哭孟东野二首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吟损秋天月不明，","兰无香气鹤无声。","自从东野先生死，","侧近云山得散行。"],"stanzas":[["吟损秋天月不明，","兰无香气鹤无声。"],["自从东野先生死，","侧近云山得散行。"]]}
{"id":"873bba7fa6","title":"哭孟东野二首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老松临死不生枝，","东野先生早哭儿。","但是洛阳城里客，","家传一本杏殇诗。"],"stanzas":[["老松临死不生枝，","东野先生早哭儿。"],["但是洛阳城里客，","家传一本杏殇诗。"]]}
{"id":"2404108161","title":"寄蜀中薛涛校书","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里桥边女校书，","枇杷花里闭门居。","扫眉才子于今少，","管领春风总不如。"],"stanzas":[["万里桥边女校书，","枇杷花里闭门居。"],["扫眉才子于今少，","管领春风总不如。"]]}
{"id":"93b79de15d","title":"路中上田尚书","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去路何词见六亲，","手中刀尺不如人。","可怜池阁秋风夜，","愁绿娇红一遍新。"],"stanzas":[["去路何词见六亲，","手中刀尺不如人。"],["可怜池阁秋风夜，","愁绿娇红一遍新。"]]}
{"id":"ba3c5d106a","title":"于主簿厅看花","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小叶稠枝粉压摧，","暖风吹动鹤翎开。","若无别事为留滞，","应便抛家宿看来。"],"stanzas":[["小叶稠枝粉压摧，","暖风吹动鹤翎开。"],["若无别事为留滞，","应便抛家宿看来。"]]}
{"id":"409d227ab5","title":"江楼对雨寄杜书记","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹烟花雨细相和，","看著闲书睡更多。","好是主人无事日，","应持小酒按新歌。"],"stanzas":[["竹烟花雨细相和，","看著闲书睡更多。"],["好是主人无事日，","应持小酒按新歌。"]]}
{"id":"e122ff9eaa","title":"观蛮妓","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲说昭君歛翠蛾，","清声委曲怨于歌。","谁家年少春风里，","抛与金钱唱好多。"],"stanzas":[["欲说昭君歛翠蛾，","清声委曲怨于歌。"],["谁家年少春风里，","抛与金钱唱好多。"]]}
{"id":"79c79647eb","title":"送顾非熊秀才归丹阳","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江城柳色海门烟，","欲到茅山始下船。","知道君家当瀑布，","菖蒲潭在草堂前。"],"stanzas":[["江城柳色海门烟，","欲到茅山始下船。"],["知道君家当瀑布，","菖蒲潭在草堂前。"]]}
{"id":"dfccae729e","title":"老人歌","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白发老人垂泪行，","上皇生日出京城。","如今供奉多新意，","错唱当时一半声。"],"stanzas":[["白发老人垂泪行，","上皇生日出京城。"],["如今供奉多新意，","错唱当时一半声。"]]}
{"id":"77ca069c66","title":"和元郎中从八月十二至十五夜玩月五首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["半秋初入中旬夜，","已向堦前守月明。","从未圆时看却好，","一分分见傍轮生。"],"stanzas":[["半秋初入中旬夜，","已向堦前守月明。"],["从未圆时看却好，","一分分见傍轮生。"]]}
{"id":"9408b79fc2","title":"和元郎中从八月十二至十五夜玩月五首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱云遮却台东月，","不许教依次第看。","莫为诗家先见镜，","被他宠与作艰难。"],"stanzas":[["乱云遮却台东月，","不许教依次第看。"],["莫为诗家先见镜，","被他宠与作艰难。"]]}
{"id":"486faf6c3b","title":"和元郎中从八月十二至十五夜玩月五首 三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今夜月明胜昨夜，","新添桂树近东枝。","立多地湿舁床坐，","看过墙西寸寸迟。"],"stanzas":[["今夜月明胜昨夜，","新添桂树近东枝。"],["立多地湿舁床坐，","看过墙西寸寸迟。"]]}
{"id":"aaa28a32a6","title":"和元郎中从八月十二至十五夜玩月五首 四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月似圆来色渐凝，","玉盆盛水欲侵棱。","夜深尽放家人睡，","直到天明不炷灯。"],"stanzas":[["月似圆来色渐凝，","玉盆盛水欲侵棱。"],["夜深尽放家人睡，","直到天明不炷灯。"]]}
{"id":"4bce4696df","title":"和元郎中从八月十二至十五夜玩月五首 五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["合望月时常望月，","分明不得似今年。","仰头五夜风中立，","从未圆时直到圆。"],"stanzas":[["合望月时常望月，","分明不得似今年。"],["仰头五夜风中立，","从未圆时直到圆。"]]}
{"id":"008d3869de","title":"对酒","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为病比来浑断绝，","缘花不免却知闻。","从来事事关身少，","主领春风只在君。"],"stanzas":[["为病比来浑断绝，","缘花不免却知闻。"],["从来事事关身少，","主领春风只在君。"]]}
{"id":"7287ab50ba","title":"晓望华清宫","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓来楼阁更鲜明，","日出阑干见鹿行。","武帝自知身不死，","看修玉殿号长生。"],"stanzas":[["晓来楼阁更鲜明，","日出阑干见鹿行。"],["武帝自知身不死，","看修玉殿号长生。"]]}
{"id":"19bbcd9e03","title":"赠李愬仆射二首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["和雪翻营一夜行，","神旗冻定马无声。","遥看火号连营赤，","知是先锋已上城。"],"stanzas":[["和雪翻营一夜行，","神旗冻定马无声。"],["遥看火号连营赤，","知是先锋已上城。"]]}
{"id":"7f7da00adb","title":"赠李愬仆射二首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旗幡四面下营稠，","手诏频来老将忧。","每日城南空挑战，","不知生缚入唐州。"],"stanzas":[["旗幡四面下营稠，","手诏频来老将忧。"],["每日城南空挑战，","不知生缚入唐州。"]]}
{"id":"7e9bc19831","title":"秋夜对雨寄石瓮寺二秀才","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜山秋雨滴空廊，","灯照堂前树叶光。","对坐读书终卷后，","自披衣被扫僧房。"],"stanzas":[["夜山秋雨滴空廊，","灯照堂前树叶光。"],["对坐读书终卷后，","自披衣被扫僧房。"]]}
{"id":"f52bfbb84a","title":"华清宫前柳","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳宫前忽地春，","在先惊动探春人。","晓来唯欠骊山雨，","洗却枝头绿上尘。"],"stanzas":[["杨柳宫前忽地春，","在先惊动探春人。"],["晓来唯欠骊山雨，","洗却枝头绿上尘。"]]}
{"id":"500be3115e","title":"别杨校书","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["从军秣马十三年，","白发营中听早蝉。","故作老丞身不避，","县名昭应管山泉。"],"stanzas":[["从军秣马十三年，","白发营中听早蝉。"],["故作老丞身不避，","县名昭应管山泉。"]]}
{"id":"4cedf9f982","title":"和门下武相公春晓闻莺","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侵黑行飞一两声，","春寒啭小未分明。","若教更解诸余语，","应向宫花不惜情。"],"stanzas":[["侵黑行飞一两声，","春寒啭小未分明。"],["若教更解诸余语，","应向宫花不惜情。"]]}
{"id":"f2d5f61340","title":"田侍郎归镇 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去处长将决胜筹，","回回身在阵前头。","贼城破后先锋入，","看著红妆不敢收。"],"stanzas":[["去处长将决胜筹，","回回身在阵前头。"],["贼城破后先锋入，","看著红妆不敢收。"]]}
{"id":"5e865f97fe","title":"田侍郎归镇 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["熨帖朝衣抛战袍，","夔龙班里侍中高。","对时先奏牙间将，","次第天恩与节旄。"],"stanzas":[["熨帖朝衣抛战袍，","夔龙班里侍中高。"],["对时先奏牙间将，","次第天恩与节旄。"]]}
{"id":"30b5450823","title":"田侍郎归镇 三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["踏著家乡马脚轻，","暮山秋色眼前明。","老人上酒齐头拜，","得侍中来尽再生。"],"stanzas":[["踏著家乡马脚轻，","暮山秋色眼前明。"],["老人上酒齐头拜，","得侍中来尽再生。"]]}
{"id":"827e223624","title":"田侍郎归镇 四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["功成谁不拥藩方，","富贵还须是本乡。","万里双旌汾水上，","玉鞭遥指白云庄。"],"stanzas":[["功成谁不拥藩方，","富贵还须是本乡。"],["万里双旌汾水上，","玉鞭遥指白云庄。"]]}
{"id":"20b89b9bff","title":"田侍郎归镇 五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鼓吹旛旗道两边，","行男走女喜骈阗。","旧交省得当时别，","指点如今却少年。"],"stanzas":[["鼓吹旛旗道两边，","行男走女喜骈阗。"],["旧交省得当时别，","指点如今却少年。"]]}
{"id":"70cf384847","title":"田侍郎归镇 六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["广场破阵乐初休，","彩纛高于百尺楼。","老将气雄争起舞，","管弦回作大缠头。"],"stanzas":[["广场破阵乐初休，","彩纛高于百尺楼。"],["老将气雄争起舞，","管弦回作大缠头。"]]}
{"id":"1a0ce2224c","title":"田侍郎归镇 七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["笳声万里动燕山，","草白天清塞马闲。","触处不如别处乐，","可怜秋月照江关。"],"stanzas":[["笳声万里动燕山，","草白天清塞马闲。"],["触处不如别处乐，","可怜秋月照江关。"]]}
{"id":"7f567643ea","title":"田侍郎归镇 八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["将士请衣忘却贫，","绿窗红烛酒楼新。","家家尽踏还乡曲，","明月街中不绝人。"],"stanzas":[["将士请衣忘却贫，","绿窗红烛酒楼新。"],["家家尽踏还乡曲，","明月街中不绝人。"]]}
{"id":"945f1d04d4","title":"寄广文张博士","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春明门外作卑官，","病友经年不得看。","莫道长安近于日，","升天却易到城难。"],"stanzas":[["春明门外作卑官，","病友经年不得看。"],["莫道长安近于日，","升天却易到城难。"]]}
{"id":"45ba19c174","title":"早春书情","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渐老风光不著人，","花溪柳陌早逢春。","近来行到门前少，","趁暖闲眠似病人。"],"stanzas":[["渐老风光不著人，","花溪柳陌早逢春。"],["近来行到门前少，","趁暖闲眠似病人。"]]}
{"id":"dbacb3bcb3","title":"唐昌观玉蕋花","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一树笼𩮀玉刻成，","飘廊点地色轻轻。","女冠夜觅香来处，","唯见阶前碎月明。"],"stanzas":[["一树笼𩮀玉刻成，","飘廊点地色轻轻。"],["女冠夜觅香来处，","唯见阶前碎月明。"]]}
{"id":"13d03e16b7","title":"眼病寄同官","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天寒眼痛少心情，","隔雾看人夜里行。","年少往来常不住，","墙西冻地马蹄声。"],"stanzas":[["天寒眼痛少心情，","隔雾看人夜里行。"],["年少往来常不住，","墙西冻地马蹄声。"]]}
{"id":"4ae16cf914","title":"九日登丛台","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平原池阁在谁家，","双塔丛台野菊花。","零落故宫无入路，","西来涧水绕城斜。"],"stanzas":[["平原池阁在谁家，","双塔丛台野菊花。"],["零落故宫无入路，","西来涧水绕城斜。"]]}
{"id":"2355e75130","title":"题酸枣县蔡中郎碑","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍苔满字土埋龟，","风雨销磨绝妙词。","不向图经中旧见，","无人知是蔡邕碑。"],"stanzas":[["苍苔满字土埋龟，","风雨销磨绝妙词。"],["不向图经中旧见，","无人知是蔡邕碑。"]]}
{"id":"dd0ef2f3b3","title":"江陵使至汝州","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回看巴路在云间，","寒食离家麦熟还。","日暮数峰青似染，","商人说是汝州山。"],"stanzas":[["回看巴路在云间，","寒食离家麦熟还。"],["日暮数峰青似染，","商人说是汝州山。"]]}
{"id":"0c434aa657","title":"十五夜望月寄杜郎中","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中庭地白树栖鸦，","冷露无声湿桂花。","今夜月明人尽望，","不知秋思在谁家。"],"stanzas":[["中庭地白树栖鸦，","冷露无声湿桂花。"],["今夜月明人尽望，","不知秋思在谁家。"]]}
{"id":"3f889b0c02","title":"寄同州田长史","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["除听好语耳常聋，","不见诗人眼底空。","莫怪出城为长史，","总缘山在白云中。"],"stanzas":[["除听好语耳常聋，","不见诗人眼底空。"],["莫怪出城为长史，","总缘山在白云中。"]]}
{"id":"f5e2b6da77","title":"外按","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夹城门向野田开，","白鹿非时出洞来。","日暮秦陵尘土起，","从东外按使初回。"],"stanzas":[["夹城门向野田开，","白鹿非时出洞来。"],["日暮秦陵尘土起，","从东外按使初回。"]]}
{"id":"82e722fd08","title":"宫词一百首 一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蓬莱正殿压金鼇，","红日初生碧海涛。","闲著五门遥北望，","柘黄新帕御床高。"],"stanzas":[["蓬莱正殿压金鼇，","红日初生碧海涛。"],["闲著五门遥北望，","柘黄新帕御床高。"]]}
{"id":"a8e87a969f","title":"宫词一百首 二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿前传点各依班，","召对西来八诏蛮。","上得青花龙尾道，","侧身偷觑正南山。"],"stanzas":[["殿前传点各依班，","召对西来八诏蛮。"],["上得青花龙尾道，","侧身偷觑正南山。"]]}
{"id":"7065852a12","title":"宫词一百首 三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙烟日暖紫曈曈，","宣政门当玉殿风。","五刻阁前卿相出，","下帘声在半天中。"],"stanzas":[["龙烟日暖紫曈曈，","宣政门当玉殿风。"],["五刻阁前卿相出，","下帘声在半天中。"]]}
{"id":"239b304205","title":"宫词一百首 四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白玉窗前起草臣，","樱桃初赤赐尝新。","殿头传语金阶远，","只进词来谢圣人。"],"stanzas":[["白玉窗前起草臣，","樱桃初赤赐尝新。"],["殿头传语金阶远，","只进词来谢圣人。"]]}
{"id":"3d73d152ca","title":"宫词一百首 五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内人对御叠花牋，","绣坐移来玉案边。","红蜡烛前呈草本，","平明舁出阁门宣。"],"stanzas":[["内人对御叠花牋，","绣坐移来玉案边。"],["红蜡烛前呈草本，","平明舁出阁门宣。"]]}
{"id":"7d4076c4a4","title":"宫词一百首 六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千牛仗下放朝初，","玉案傍边立起居。","每日进来金凤纸，","殿头无事不多书。"],"stanzas":[["千牛仗下放朝初，","玉案傍边立起居。"],["每日进来金凤纸，","殿头无事不多书。"]]}
{"id":"89c70a9523","title":"宫词一百首 七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["延英引对碧衣郎，","江砚宣毫各别床。","天子下帘亲考试，","宫人手里过茶汤。"],"stanzas":[["延英引对碧衣郎，","江砚宣毫各别床。"],["天子下帘亲考试，","宫人手里过茶汤。"]]}
{"id":"b9ce52032e","title":"宫词一百首 八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未明开著九重关，","金画黄龙五色幡。","直到银台排仗合，","圣人三殿对西番。"],"stanzas":[["未明开著九重关，","金画黄龙五色幡。"],["直到银台排仗合，","圣人三殿对西番。"]]}
{"id":"954cd5a9b2","title":"宫词一百首 九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年天子重边功，","亲到凌烟画阁中。","教觅勋臣写图本，","长将殿里作屏风。"],"stanzas":[["少年天子重边功，","亲到凌烟画阁中。"],["教觅勋臣写图本，","长将殿里作屏风。"]]}
{"id":"e5724f00c1","title":"宫词一百首 十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹凤楼门把火开，","五云金辂下天来。","堦前走马人宣慰，","天子南郊一宿回。"],"stanzas":[["丹凤楼门把火开，","五云金辂下天来。"],["堦前走马人宣慰，","天子南郊一宿回。"]]}
{"id":"93f2294c48","title":"宫词一百首 十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼前立仗看宣赦，","万岁声长拜舞齐。","日照彩盘高百尺，","飞仙争上取金鸡。"],"stanzas":[["楼前立仗看宣赦，","万岁声长拜舞齐。"],["日照彩盘高百尺，","飞仙争上取金鸡。"]]}
{"id":"42e7b0db68","title":"宫词一百首 十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["集贤殿里图书满，","点勘头边御印同。","真迹进来依数字，","别收锁在玉函中。"],"stanzas":[["集贤殿里图书满，","点勘头边御印同。"],["真迹进来依数字，","别收锁在玉函中。"]]}
{"id":"c17b1b0842","title":"宫词一百首 十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秘殿清斋刻漏长，","紫微宫女夜焚香。","拜陵日近公卿发，","卤簿分头入太常。"],"stanzas":[["秘殿清斋刻漏长，","紫微宫女夜焚香。"],["拜陵日近公卿发，","卤簿分头入太常。"]]}
{"id":"48a2d25dd5","title":"宫词一百首 十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新调白马怕鞭声，","供奉骑来绕殿行。","为报诸王侵早入，","隔门催进打毬名。"],"stanzas":[["新调白马怕鞭声，","供奉骑来绕殿行。"],["为报诸王侵早入，","隔门催进打毬名。"]]}
{"id":"f6e22838f0","title":"宫词一百首 十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["对御难争第一筹，","殿前不打背身毬。","内人唱好龟兹急，","天子鞘回过玉楼。"],"stanzas":[["对御难争第一筹，","殿前不打背身毬。"],["内人唱好龟兹急，","天子鞘回过玉楼。"]]}
{"id":"63de7270fa","title":"宫词一百首 十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新衫一样殿头黄，","银带排方獭尾长。","总把玉鞭骑御马，","绿鬃红额麝香香。"],"stanzas":[["新衫一样殿头黄，","银带排方獭尾长。"],["总把玉鞭骑御马，","绿鬃红额麝香香。"]]}
{"id":"482ffbeee8","title":"宫词一百首 十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["罗衫叶叶绣重重，","金凤银鹅各一丛。","每遍舞时分两向，","太平万岁字当中。"],"stanzas":[["罗衫叶叶绣重重，","金凤银鹅各一丛。"],["每遍舞时分两向，","太平万岁字当中。"]]}
{"id":"36fc9d9aa8","title":"宫词一百首 十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼藻宫中锁翠娥，","先皇行处不曾过。","如今池底休铺锦，","菱角鸡头积渐多。"],"stanzas":[["鱼藻宫中锁翠娥，","先皇行处不曾过。"],["如今池底休铺锦，","菱角鸡头积渐多。"]]}
{"id":"f79a83854f","title":"宫词一百首 十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿前明日中和节，","连夜琼林散舞衣。","传报所司分蜡烛，","监开金锁放人归。"],"stanzas":[["殿前明日中和节，","连夜琼林散舞衣。"],["传报所司分蜡烛，","监开金锁放人归。"]]}
{"id":"f1cc8aef57","title":"宫词一百首 二十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五更三点索金车，","尽放宫人出看花。","仗下一时催立马，","殿头先报内园家。"],"stanzas":[["五更三点索金车，","尽放宫人出看花。"],["仗下一时催立马，","殿头先报内园家。"]]}
{"id":"de5df8d7a9","title":"宫词一百首 二十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["城东北面望云楼，","半下珠帘半上钩。","骑马行人长远过，","恐防天子在楼头。"],"stanzas":[["城东北面望云楼，","半下珠帘半上钩。"],["骑马行人长远过，","恐防天子在楼头。"]]}
{"id":"c68feeb97b","title":"宫词一百首 二十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["射生宫女宿红妆，","把得新弓各自张。","临上马时齐赐酒，","男儿跪拜谢君王。"],"stanzas":[["射生宫女宿红妆，","把得新弓各自张。"],["临上马时齐赐酒，","男儿跪拜谢君王。"]]}
{"id":"c2f9fa98e1","title":"宫词一百首 二十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新秋白兔大于拳，","红耳霜毛趁草眠。","天子不教人射杀，","玉鞭遮到马蹄前。"],"stanzas":[["新秋白兔大于拳，","红耳霜毛趁草眠。"],["天子不教人射杀，","玉鞭遮到马蹄前。"]]}
{"id":"d488820cb7","title":"宫词一百首 二十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内鹰笼脱解红绦，","鬬胜争飞出手高。","直上碧云还却下，","一双金爪掬花毛。"],"stanzas":[["内鹰笼脱解红绦，","鬬胜争飞出手高。"],["直上碧云还却下，","一双金爪掬花毛。"]]}
{"id":"9c75d59e7b","title":"宫词一百首 二十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竞渡船头掉采旗，","两边溅水湿罗衣。","池东争向池西岸，","先到先书上字归。"],"stanzas":[["竞渡船头掉采旗，","两边溅水湿罗衣。"],["池东争向池西岸，","先到先书上字归。"]]}
{"id":"0b50b7791e","title":"宫词一百首 二十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灯前飞入玉堦虫，","未卧常闻半夜钟。","看著中元斋日到，","自盘金线绣真容。"],"stanzas":[["灯前飞入玉堦虫，","未卧常闻半夜钟。"],["看著中元斋日到，","自盘金线绣真容。"]]}
{"id":"3e05d6ba12","title":"宫词一百首 二十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红灯睡里唤春云，","云上三更直宿分。","金砌雨来行步滑，","两人抬起隐花裙。"],"stanzas":[["红灯睡里唤春云，","云上三更直宿分。"],["金砌雨来行步滑，","两人抬起隐花裙。"]]}
{"id":"2bfd981835","title":"宫词一百首 二十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一时起立吹箫管，","得宠人来满殿迎。","整顿衣裳皆著却，","舞头当拍第三声。"],"stanzas":[["一时起立吹箫管，","得宠人来满殿迎。"],["整顿衣裳皆著却，","舞头当拍第三声。"]]}
{"id":"d99c421e15","title":"宫词一百首 二十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琵琶先抹六么头，","小管丁宁侧调愁。","半夜美人双唱起，","一声声出凤皇楼。"],"stanzas":[["琵琶先抹六么头，","小管丁宁侧调愁。"],["半夜美人双唱起，","一声声出凤皇楼。"]]}
{"id":"4d5728bbfd","title":"宫词一百首 三十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春池日暖少风波，","花里牵船水上歌。","遥索劒南新样锦，","东宫先钓得鱼多。"],"stanzas":[["春池日暖少风波，","花里牵船水上歌。"],["遥索劒南新样锦，","东宫先钓得鱼多。"]]}
{"id":"abe8312835","title":"宫词一百首 三十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十三初学擘箜篌，","弟子名中被点留。","昨日教坊新进入，","并房宫女与梳头。"],"stanzas":[["十三初学擘箜篌，","弟子名中被点留。"],["昨日教坊新进入，","并房宫女与梳头。"]]}
{"id":"14e040d04d","title":"宫词一百首 三十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红蛮杆拨贴胸前，","移坐当头近御筵。","用力独弹金殿响，","凤皇飞下四条弦。"],"stanzas":[["红蛮杆拨贴胸前，","移坐当头近御筵。"],["用力独弹金殿响，","凤皇飞下四条弦。"]]}
{"id":"ae9f858f5b","title":"宫词一百首 三十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风吹雨洒旗竿，","得出深宫不怕寒。","夸道自家能走马，","团中横过觅人看。"],"stanzas":[["春风吹雨洒旗竿，","得出深宫不怕寒。"],["夸道自家能走马，","团中横过觅人看。"]]}
{"id":"8f7d418e0d","title":"宫词一百首 三十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["粟金腰带象牙锥，","散插红翎玉突枝。","旋猎一边还引马，","归来鸡兔绕鞍垂。"],"stanzas":[["粟金腰带象牙锥，","散插红翎玉突枝。"],["旋猎一边还引马，","归来鸡兔绕鞍垂。"]]}
{"id":"f63f442f9f","title":"宫词一百首 三十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云駮花骢各试行，","一般毛色一般缨。","殿前来往重骑过，","欲得君王别赐名。"],"stanzas":[["云駮花骢各试行，","一般毛色一般缨。"],["殿前来往重骑过，","欲得君王别赐名。"]]}
{"id":"ea49ca0554","title":"宫词一百首 三十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["每夜停灯熨御衣，","银熏笼底火霏霏。","遥听帐里君王觉，","上直钟声始得归。"],"stanzas":[["每夜停灯熨御衣，","银熏笼底火霏霏。"],["遥听帐里君王觉，","上直钟声始得归。"]]}
{"id":"6b9ed1dffe","title":"宫词一百首 三十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["因吃樱桃病放归，","三年著破旧罗衣。","内中人识从来去，","结得金花上贵妃。"],"stanzas":[["因吃樱桃病放归，","三年著破旧罗衣。"],["内中人识从来去，","结得金花上贵妃。"]]}
{"id":"89cdb78954","title":"宫词一百首 三十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲迎天子看花去，","下得金堦却悔行。","恐见失恩人旧院，","回来忆著五弦声。"],"stanzas":[["欲迎天子看花去，","下得金堦却悔行。"],["恐见失恩人旧院，","回来忆著五弦声。"]]}
{"id":"96b691e7c4","title":"宫词一百首 三十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["往来旧院不堪修，","近勑宣徽别起楼。","闻有美人新进入，","六宫未见一时愁。"],"stanzas":[["往来旧院不堪修，","近勑宣徽别起楼。"],["闻有美人新进入，","六宫未见一时愁。"]]}
{"id":"cf91980f25","title":"宫词一百首 四十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自夸歌舞胜诸人，","恨未承恩出内频。","连夜宫中修别院，","地衣帘额一时新。"],"stanzas":[["自夸歌舞胜诸人，","恨未承恩出内频。"],["连夜宫中修别院，","地衣帘额一时新。"]]}
{"id":"34dbfa75f8","title":"宫词一百首 四十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闷来无处可思量，","旋下金堦旋忆床。","收得山丹红蘂粉，","镜前洗却麝香黄。"],"stanzas":[["闷来无处可思量，","旋下金堦旋忆床。"],["收得山丹红蘂粉，","镜前洗却麝香黄。"]]}
{"id":"9be9fe38ae","title":"宫词一百首 四十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜂须蝉翅薄松松，","浮动搔头似有风。","一度出时抛一遍，","金条零落满函中。"],"stanzas":[["蜂须蝉翅薄松松，","浮动搔头似有风。"],["一度出时抛一遍，","金条零落满函中。"]]}
{"id":"7e4b9bd793","title":"宫词一百首 四十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["合暗报来门锁了，","夜深应别唤笙歌。","房房下著珠帘睡，","月过金堦白露多。"],"stanzas":[["合暗报来门锁了，","夜深应别唤笙歌。"],["房房下著珠帘睡，","月过金堦白露多。"]]}
{"id":"a1c417de88","title":"宫词一百首 四十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御厨不食索时新，","每见花开即苦春。","白日卧多娇似病，","隔帘教唤女医人。"],"stanzas":[["御厨不食索时新，","每见花开即苦春。"],["白日卧多娇似病，","隔帘教唤女医人。"]]}
{"id":"3c7e3cb361","title":"宫词一百首 四十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丛丛洗手绕金盆，","旋拭红巾入殿门。","众里遥抛新摘子，","在前收得便承恩。"],"stanzas":[["丛丛洗手绕金盆，","旋拭红巾入殿门。"],["众里遥抛新摘子，","在前收得便承恩。"]]}
{"id":"cf00cbff36","title":"宫词一百首 四十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御池水色春来好，","处处分流白玉渠。","密奏君王知入月，","唤人相伴洗裙裾。"],"stanzas":[["御池水色春来好，","处处分流白玉渠。"],["密奏君王知入月，","唤人相伴洗裙裾。"]]}
{"id":"d88fbf1690","title":"宫词一百首 四十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["移来女乐部头边，","新赐花檀木五弦。","缏得红罗手帕子，","中心细画一双蝉。"],"stanzas":[["移来女乐部头边，","新赐花檀木五弦。"],["缏得红罗手帕子，","中心细画一双蝉。"]]}
{"id":"08baa86280","title":"宫词一百首 四十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新晴草色绿温暾，","山雪初消渐出浑。","今日踏青归校晚，","传声留著望春门。"],"stanzas":[["新晴草色绿温暾，","山雪初消渐出浑。"],["今日踏青归校晚，","传声留著望春门。"]]}
{"id":"84de17e90b","title":"宫词一百首 四十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两楼相换珠帘额，","中尉明朝设内家。","一样金盘五千面，","红酥点出牡丹花。"],"stanzas":[["两楼相换珠帘额，","中尉明朝设内家。"],["一样金盘五千面，","红酥点出牡丹花。"]]}
{"id":"c7b4b4b665","title":"宫词一百首 五十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尽送春来出内家，","记巡传把一枝花。","散时各自烧红烛，","相逐行归不上车。"],"stanzas":[["尽送春来出内家，","记巡传把一枝花。"],["散时各自烧红烛，","相逐行归不上车。"]]}
{"id":"8c03a9bf5e","title":"宫词一百首 五十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家常爱著旧衣裳，","空插红梳不出妆。","忽地下堦裙带解，","非时应得见君王。"],"stanzas":[["家常爱著旧衣裳，","空插红梳不出妆。"],["忽地下堦裙带解，","非时应得见君王。"]]}
{"id":"e56f62567b","title":"宫词一百首 五十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["别勑教歌不出房，","一声一遍奏君王。","再三博士留残拍，","索向宣徽作彻章。"],"stanzas":[["别勑教歌不出房，","一声一遍奏君王。"],["再三博士留残拍，","索向宣徽作彻章。"]]}
{"id":"04c9e53131","title":"宫词一百首 五十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行中第一争先舞，","博士傍边亦被欺。","忽觉管弦偷破拍，","急翻罗袖不教知。"],"stanzas":[["行中第一争先舞，","博士傍边亦被欺。"],["忽觉管弦偷破拍，","急翻罗袖不教知。"]]}
{"id":"29c2d7bc14","title":"宫词一百首 五十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["私缝黄帔舍钗梳，","欲得金仙观里居。","近被君王知识字，","收来案上检文书。"],"stanzas":[["私缝黄帔舍钗梳，","欲得金仙观里居。"],["近被君王知识字，","收来案上检文书。"]]}
{"id":"84e33f7260","title":"宫词一百首 五十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月冷江清近猎时，","玉阶金瓦雪澌澌。","浴堂门外抄名入，","公主家人谢面脂。"],"stanzas":[["月冷江清近猎时，","玉阶金瓦雪澌澌。"],["浴堂门外抄名入，","公主家人谢面脂。"]]}
{"id":"a2ace2543b","title":"宫词一百首 五十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未承恩泽一家愁，","乍到宫中忆外头。","求守管弦声款逐，","侧商调里唱伊州。"],"stanzas":[["未承恩泽一家愁，","乍到宫中忆外头。"],["求守管弦声款逐，","侧商调里唱伊州。"]]}
{"id":"5d9c6c565e","title":"宫词一百首 五十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东风泼火雨新休，","舁尽春泥扫雪沟。","走马犊车当御路，","汉阳宫主进鸡毬。"],"stanzas":[["东风泼火雨新休，","舁尽春泥扫雪沟。"],["走马犊车当御路，","汉阳宫主进鸡毬。"]]}
{"id":"5a6c27a9e9","title":"宫词一百首 五十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风帘水阁压芙蓉，","四面钩栏在水中。","避热不归金殿宿，","秋河织女夜妆红。"],"stanzas":[["风帘水阁压芙蓉，","四面钩栏在水中。"],["避热不归金殿宿，","秋河织女夜妆红。"]]}
{"id":"3655b7c792","title":"宫词一百首 五十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣人生日明朝是，","私地教人属内监。","自写金花红牓子，","前头先进凤皇衫。"],"stanzas":[["圣人生日明朝是，","私地教人属内监。"],["自写金花红牓子，","前头先进凤皇衫。"]]}
{"id":"5ddecba7ad","title":"宫词一百首 六十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["避暑昭阳不掷卢，","井边含水喷鵶雏。","内中数日无呼唤，","搨得滕王蛱蝶图。"],"stanzas":[["避暑昭阳不掷卢，","井边含水喷鵶雏。"],["内中数日无呼唤，","搨得滕王蛱蝶图。"]]}
{"id":"004936314a","title":"宫词一百首 六十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内宴初秋入二更，","殿前灯火一天明。","中宫传旨音声散，","诸院门开触处行。"],"stanzas":[["内宴初秋入二更，","殿前灯火一天明。"],["中宫传旨音声散，","诸院门开触处行。"]]}
{"id":"7f8e142ac2","title":"宫词一百首 六十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉蝉金雀三层插，","翠髻高丛绿鬓虚。","舞处春风吹落地，","归来别赐一头梳。"],"stanzas":[["玉蝉金雀三层插，","翠髻高丛绿鬓虚。"],["舞处春风吹落地，","归来别赐一头梳。"]]}
{"id":"aacfc479fe","title":"宫词一百首 六十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["树叶初成鸟护窠，","石榴花里笑声多。","众中遗却金钗子，","拾得从他要赎么。"],"stanzas":[["树叶初成鸟护窠，","石榴花里笑声多。"],["众中遗却金钗子，","拾得从他要赎么。"]]}
{"id":"12187f0733","title":"宫词一百首 六十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小殿初成粉未干，","贵妃姊妹自来看。","为逢好日先移入，","续向街西索牡丹。"],"stanzas":[["小殿初成粉未干，","贵妃姊妹自来看。"],["为逢好日先移入，","续向街西索牡丹。"]]}
{"id":"505c49df2e","title":"宫词一百首 六十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["内人相续报花开，","准拟君王便看来。","逢着五弦琴绣袋，","宜春院里按歌回。"],"stanzas":[["内人相续报花开，","准拟君王便看来。"],["逢着五弦琴绣袋，","宜春院里按歌回。"]]}
{"id":"9617c1fab4","title":"宫词一百首 六十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巡吹慢遍不相和，","暗数看谁曲校多。","明日棃花园里见，","先须逐得内家歌。"],"stanzas":[["巡吹慢遍不相和，","暗数看谁曲校多。"],["明日棃花园里见，","先须逐得内家歌。"]]}
{"id":"0c09027e07","title":"宫词一百首 六十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄金合里盛红雪，","重结香罗四出花。","一一傍边书勑字，","中官送与大臣家。"],"stanzas":[["黄金合里盛红雪，","重结香罗四出花。"],["一一傍边书勑字，","中官送与大臣家。"]]}
{"id":"46958e331a","title":"宫词一百首 六十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未明东上阁门开，","排仗声从后殿来。","阿监两边相对立，","遥闻索马一时回。"],"stanzas":[["未明东上阁门开，","排仗声从后殿来。"],["阿监两边相对立，","遥闻索马一时回。"]]}
{"id":"1a41b81580","title":"宫词一百首 六十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫人早起笑相呼，","不识堦前扫地夫。","乞与金钱争借问，","外头还似此间无。"],"stanzas":[["宫人早起笑相呼，","不识堦前扫地夫。"],["乞与金钱争借问，","外头还似此间无。"]]}
{"id":"1577f1dd30","title":"宫词一百首 七十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小随阿姊学吹笙，","见好君王赐与名。","夜拂玉床朝把镜，","黄金殿外不教行。"],"stanzas":[["小随阿姊学吹笙，","见好君王赐与名。"],["夜拂玉床朝把镜，","黄金殿外不教行。"]]}
{"id":"f7dd2d8705","title":"宫词一百首 七十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日高殿里有香烟，","万岁声长动九天。","妃子院中初降诞，","内人争乞洗儿钱。"],"stanzas":[["日高殿里有香烟，","万岁声长动九天。"],["妃子院中初降诞，","内人争乞洗儿钱。"]]}
{"id":"2c19a1d309","title":"宫词一百首 七十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宫花不共外花同，","正月长生一半红。","供御樱桃看守别，","直无鸦鹊到园中。"],"stanzas":[["宫花不共外花同，","正月长生一半红。"],["供御樱桃看守别，","直无鸦鹊到园中。"]]}
{"id":"c2751cc7e9","title":"宫词一百首 七十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["殿前铺设两边楼，","寒食宫人步打毬。","一半走来争跪拜，","上棚先谢得头筹。"],"stanzas":[["殿前铺设两边楼，","寒食宫人步打毬。"],["一半走来争跪拜，","上棚先谢得头筹。"]]}
{"id":"7e617069ac","title":"宫词一百首 七十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太仪前日暖房来，","嘱向朝阳乞药栽。","勑赐一窠红踯躅，","谢恩未了奏花开。"],"stanzas":[["太仪前日暖房来，","嘱向朝阳乞药栽。"],["勑赐一窠红踯躅，","谢恩未了奏花开。"]]}
{"id":"b27b2c2995","title":"宫词一百首 七十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御前新赐紫罗襦，","步步金堦上软舆。","宫局总来为喜乐，","院中新拜内尚书。"],"stanzas":[["御前新赐紫罗襦，","步步金堦上软舆。"],["宫局总来为喜乐，","院中新拜内尚书。"]]}
{"id":"845041b148","title":"宫词一百首 七十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹦鹉谁教转舌关，","内人手里养来奸。","语多更觉承恩泽，","数对君王忆陇山。"],"stanzas":[["鹦鹉谁教转舌关，","内人手里养来奸。"],["语多更觉承恩泽，","数对君王忆陇山。"]]}
{"id":"9332ec5258","title":"宫词一百首 七十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["分朋闲坐赌樱桃，","收却投壶玉腕劳。","各把沉香双陆子，","局中鬬累阿谁高。"],"stanzas":[["分朋闲坐赌樱桃，","收却投壶玉腕劳。"],["各把沉香双陆子，","局中鬬累阿谁高。"]]}
{"id":"08a7c68f42","title":"宫词一百首 七十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禁寺红楼内里通，","笙歌引驾夹城东。","裹头宫监堂前立，","手把牙鞘竹弹弓。"],"stanzas":[["禁寺红楼内里通，","笙歌引驾夹城东。"],["裹头宫监堂前立，","手把牙鞘竹弹弓。"]]}
{"id":"642542f48f","title":"宫词一百首 七十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风院院落花堆，","金锁生衣掣不开。","更筑歌台起妆殿，","明朝先进画图来。"],"stanzas":[["春风院院落花堆，","金锁生衣掣不开。"],["更筑歌台起妆殿，","明朝先进画图来。"]]}
{"id":"3b16e17791","title":"宫词一百首 八十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舞来汗湿罗衣彻，","楼上人扶下玉梯。","归到院中重洗面，","金花盆里泼银泥。"],"stanzas":[["舞来汗湿罗衣彻，","楼上人扶下玉梯。"],["归到院中重洗面，","金花盆里泼银泥。"]]}
{"id":"ebaf011715","title":"宫词一百首 八十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宿妆残粉未明天，","总立昭阳花树边。","寒食内人长白打，","库中先散与金钱。"],"stanzas":[["宿妆残粉未明天，","总立昭阳花树边。"],["寒食内人长白打，","库中先散与金钱。"]]}
{"id":"635589479b","title":"宫词一百首 八十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["众中偏得君王笑，","偷把金箱笔砚开。","书破红蛮隔子上，","旋推当直美人来。"],"stanzas":[["众中偏得君王笑，","偷把金箱笔砚开。"],["书破红蛮隔子上，","旋推当直美人来。"]]}
{"id":"1f2ab486f6","title":"宫词一百首 八十三","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["教遍宫娥唱遍词，","暗中头白没人知。","楼中日日歌声好，","不问从初学阿谁。"],"stanzas":[["教遍宫娥唱遍词，","暗中头白没人知。"],["楼中日日歌声好，","不问从初学阿谁。"]]}
{"id":"a0068c4702","title":"宫词一百首 八十四","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青楼小妇砑裙长，","总被抄名入教坊。","春设殿前多队舞，","朋头各自请衣裳。"],"stanzas":[["青楼小妇砑裙长，","总被抄名入教坊。"],["春设殿前多队舞，","朋头各自请衣裳。"]]}
{"id":"86f6535933","title":"宫词一百首 八十五","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水中芹叶土中花，","拾得还将避众家。","总待别人般数尽，","袖中拈出郁金芽。"],"stanzas":[["水中芹叶土中花，","拾得还将避众家。"],["总待别人般数尽，","袖中拈出郁金芽。"]]}
{"id":"fa3da8d9bc","title":"宫词一百首 八十六","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉箫改调筝移柱，","催换红罗绣舞筵。","未戴柘枝花帽子，","两行宫监在帘前。"],"stanzas":[["玉箫改调筝移柱，","催换红罗绣舞筵。"],["未戴柘枝花帽子，","两行宫监在帘前。"]]}
{"id":"e1bf035992","title":"宫词一百首 八十七","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["窗窗户户院相当，","总有珠帘玳瑁床。","虽道君王不来宿，","帐中长是炷牙香。"],"stanzas":[["窗窗户户院相当，","总有珠帘玳瑁床。"],["虽道君王不来宿，","帐中长是炷牙香。"]]}
{"id":"740cb6a9db","title":"宫词一百首 八十八","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨入珠帘满殿凉，","避风新出玉盆汤。","内人恐要秋衣着，","不住熏笼换好香。"],"stanzas":[["雨入珠帘满殿凉，","避风新出玉盆汤。"],["内人恐要秋衣着，","不住熏笼换好香。"]]}
{"id":"8aae63b47e","title":"宫词一百首 八十九","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金吾除夜进傩名，","画袴朱衣四队行。","院院烧灯如白日，","沉香火底坐吹笙。"],"stanzas":[["金吾除夜进傩名，","画袴朱衣四队行。"],["院院烧灯如白日，","沉香火底坐吹笙。"]]}
{"id":"111c193398","title":"宫词一百首 九十","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["树头树底觅残红，","一片西飞一片东。","自是桃花贪结子，","错教人恨五更风。"],"stanzas":[["树头树底觅残红，","一片西飞一片东。"],["自是桃花贪结子，","错教人恨五更风。"]]}
{"id":"b24550f1f3","title":"宫词一百首 九十一","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金殿当头紫合重，","仙人掌上玉芙蓉。","太平天子朝迎日，","五色云车驾六龙。"],"stanzas":[["金殿当头紫合重，","仙人掌上玉芙蓉。"],["太平天子朝迎日，","五色云车驾六龙。"]]}
{"id":"3c141bb76d","title":"宫词一百首 九十二","author":"王建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸳鸯瓦上瞥然声，","昼寝宫娥梦里惊。","元是我王金弹子，","海棠花下打流莺。"],"stanzas":[["鸳鸯瓦上瞥然声，","昼寝宫娥梦里惊。"],["元是我王金弹子，","海棠花下打流莺。"]]}
