{"id":"0673a5835a","title":"蝴蝶三首 一","author":"徐夤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不并难飞茧里蛾，","有花芳处定经过。","天风相送轻飘去，","却笑[蜘蛛]谩织罗。"],"stanzas":[["不并难飞茧里蛾，","有花芳处定经过。"],["天风相送轻飘去，","却笑[蜘蛛]谩织罗。"]]}
{"id":"74d7e3cb22","title":"蝴蝶三首 二","author":"徐夤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苒苒双双拂画栏，","佳人偷眼再三看。","莫欺翼短飞长近，","试就花间扑已难。"],"stanzas":[["苒苒双双拂画栏，","佳人偷眼再三看。"],["莫欺翼短飞长近，","试就花间扑已难。"]]}
{"id":"157da26528","title":"蝴蝶三首 三","author":"徐夤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["栩栩无因系得他，","野园荒径一何多。","不闻丝竹谁教舞，","应仗流莺为唱歌。"],"stanzas":[["栩栩无因系得他，","野园荒径一何多。"],["不闻丝竹谁教舞，","应仗流莺为唱歌。"]]}
{"id":"f3ebe205ab","title":"新刺袜","author":"徐夤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["素手春溪罢浣纱，","巧裁明月半弯斜。","齐宫合赠东昏宠，","好步黄金菡萏花。"],"stanzas":[["素手春溪罢浣纱，","巧裁明月半弯斜。"],["齐宫合赠东昏宠，","好步黄金菡萏花。"]]}
{"id":"7cbb440e56","title":"寄华山司空侍郎","author":"徐夤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山掌林中第一人，","鹤书时或问眠云。","莫言疎野全无事，","明月清风肯放君。"],"stanzas":[["山掌林中第一人，","鹤书时或问眠云。"],["莫言疎野全无事，","明月清风肯放君。"]]}
{"id":"28ab1eb09a","title":"初夏戏题","author":"徐夤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长养薰风拂晓吹，","渐开荷芰落蔷薇。","青虫也学庄周梦，","化作南园蛱蝶飞。"],"stanzas":[["长养薰风拂晓吹，","渐开荷芰落蔷薇。"],["青虫也学庄周梦，","化作南园蛱蝶飞。"]]}
{"id":"21a241ddda","title":"客舍寓怀","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洒洒滩声晚霁时，","客亭风袖半披垂。","野云行止谁相待，","明月襟怀祗自知。","无伴偶吟溪上路，","有花偷笑腊前枝。","牵情景物潜惆怅，","忽似伤春远别离。"],"stanzas":[["洒洒滩声晚霁时，","客亭风袖半披垂。"],["野云行止谁相待，","明月襟怀祗自知。"],["无伴偶吟溪上路，","有花偷笑腊前枝。"],["牵情景物潜惆怅，","忽似伤春远别离。"]]}
{"id":"db8fa8e32a","title":"送王郎中","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惜别远相送，","却成惆怅多。","独归回首处，","争那暮山何。"],"stanzas":[["惜别远相送，","却成惆怅多。"],["独归回首处，","争那暮山何。"]]}
{"id":"bdeed0a85c","title":"江行无题一百首 一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["倾酒向涟漪，","乘流欲去时。","寸心同尺璧，","投此报冯夷。"],"stanzas":[["倾酒向涟漪，","乘流欲去时。"],["寸心同尺璧，","投此报冯夷。"]]}
{"id":"1be6ce0baa","title":"江行无题一百首 二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江曲全萦楚，","云飞半自秦。","岘山回首望，","如别故乡人。"],"stanzas":[["江曲全萦楚，","云飞半自秦。"],["岘山回首望，","如别故乡人。"]]}
{"id":"c63efb4eb8","title":"江行无题一百首 三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浦烟含夜色，","冷日转秋旻。","自有沈碑在，","清光不照人。"],"stanzas":[["浦烟含夜色，","冷日转秋旻。"],["自有沈碑在，","清光不照人。"]]}
{"id":"8881295fe3","title":"江行无题一百首 四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚岸云空合，","楚城人不来。","祗今谁善舞，","莫恨废章台。"],"stanzas":[["楚岸云空合，","楚城人不来。"],["祗今谁善舞，","莫恨废章台。"]]}
{"id":"5af5d0b618","title":"江行无题一百首 五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行背青山郭，","吟当白露秋。","风流无屈宋，","空咏古荆州。"],"stanzas":[["行背青山郭，","吟当白露秋。"],["风流无屈宋，","空咏古荆州。"]]}
{"id":"d4f0d997f3","title":"江行无题一百首 六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚来渔父喜，","网重欲收迟。","恐有长江使，","金钱愿赎龟。"],"stanzas":[["晚来渔父喜，","网重欲收迟。"],["恐有长江使，","金钱愿赎龟。"]]}
{"id":"1dc6fdbde6","title":"江行无题一百首 七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去指龙沙路，","徒悬象阙心。","夜凉无远梦，","不为偶闻砧。"],"stanzas":[["去指龙沙路，","徒悬象阙心。"],["夜凉无远梦，","不为偶闻砧。"]]}
{"id":"aa033db733","title":"江行无题一百首 八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雾云疎有叶，","雨浪细无花。","稳放扁舟去，","江天自有涯。"],"stanzas":[["雾云疎有叶，","雨浪细无花。"],["稳放扁舟去，","江天自有涯。"]]}
{"id":"7483a5efd6","title":"江行无题一百首 九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好日当秋半，","层波动旅肠。","已行千里外，","谁与共秋光。"],"stanzas":[["好日当秋半，","层波动旅肠。"],["已行千里外，","谁与共秋光。"]]}
{"id":"4f80e8fc12","title":"江行无题一百首 十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["润色非东里，","官曹更建章。","宦游难自定，","来唤櫂船郎。"],"stanzas":[["润色非东里，","官曹更建章。"],["宦游难自定，","来唤櫂船郎。"]]}
{"id":"445906fada","title":"江行无题一百首 十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜江清未晓，","徒惜月光沉。","不是因行乐，","堪伤老大心。"],"stanzas":[["夜江清未晓，","徒惜月光沉。"],["不是因行乐，","堪伤老大心。"]]}
{"id":"8e8b098388","title":"江行无题一百首 十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翳日多乔木，","维舟取束薪。","静听江叟语，","尽是厌兵人。"],"stanzas":[["翳日多乔木，","维舟取束薪。"],["静听江叟语，","尽是厌兵人。"]]}
{"id":"6b4ca063c0","title":"江行无题一百首 十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["箭漏日初短，","汀烟草未衰。","雨余虽更绿，","不是采苹时。"],"stanzas":[["箭漏日初短，","汀烟草未衰。"],["雨余虽更绿，","不是采苹时。"]]}
{"id":"5ec6f95074","title":"江行无题一百首 十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山雨夜来涨，","喜鱼跳满江。","岸沙平欲尽，","垂蓼入船窗。"],"stanzas":[["山雨夜来涨，","喜鱼跳满江。"],["岸沙平欲尽，","垂蓼入船窗。"]]}
{"id":"dab649e25a","title":"江行无题一百首 十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渚边新鴈下，","舟上独凄凉。","俱是南来客，","怜君缀一行。"],"stanzas":[["渚边新鴈下，","舟上独凄凉。"],["俱是南来客，","怜君缀一行。"]]}
{"id":"f330ae01b5","title":"江行无题一百首 十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云密连江暗，","风斜著物鸣。","一杯真战将，","笑尔作愁兵。"],"stanzas":[["云密连江暗，","风斜著物鸣。"],["一杯真战将，","笑尔作愁兵。"]]}
{"id":"9aa78b8399","title":"江行无题一百首 十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳拂斜开路，","篱边数户村。","可能还有意，","不掩向江门。"],"stanzas":[["柳拂斜开路，","篱边数户村。"],["可能还有意，","不掩向江门。"]]}
{"id":"ca9ee0be1e","title":"江行无题一百首 十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不识相如渴，","徒吟子美诗。","江清惟独看，","心外更谁知。"],"stanzas":[["不识相如渴，","徒吟子美诗。"],["江清惟独看，","心外更谁知。"]]}
{"id":"1349759bda","title":"江行无题一百首 十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牵路沿江狭，","沙崩岸不平。","尽知行处险，","谁肯载时轻。"],"stanzas":[["牵路沿江狭，","沙崩岸不平。"],["尽知行处险，","谁肯载时轻。"]]}
{"id":"732db6a16a","title":"江行无题一百首 二十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["憔悴异灵均，","非谗作逐臣。","如逢渔父问，","未是独醒人。"],"stanzas":[["憔悴异灵均，","非谗作逐臣。"],["如逢渔父问，","未是独醒人。"]]}
{"id":"310110177c","title":"江行无题一百首 二十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水含秋夜静，","云带夕阳高。","诗癖非吾病，","何妨吮短豪。"],"stanzas":[["水含秋夜静，","云带夕阳高。"],["诗癖非吾病，","何妨吮短豪。"]]}
{"id":"65fcf12249","title":"江行无题一百首 二十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["带舟维古岸，","还似阻西陵。","箕伯无多怒，","回头讵不能。"],"stanzas":[["带舟维古岸，","还似阻西陵。"],["箕伯无多怒，","回头讵不能。"]]}
{"id":"c6a0bf3031","title":"江行无题一百首 二十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋云久无雨，","江燕社犹飞。","却笑舟中客，","今年未得归。"],"stanzas":[["秋云久无雨，","江燕社犹飞。"],["却笑舟中客，","今年未得归。"]]}
{"id":"59b245e3d5","title":"江行无题一百首 二十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["帆翅初张处，","云鹏怒翼同。","莫愁千里路，","自有到来风。"],"stanzas":[["帆翅初张处，","云鹏怒翼同。"],["莫愁千里路，","自有到来风。"]]}
{"id":"959078c2cf","title":"江行无题一百首 二十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳节虽逢菊，","浮生正似萍。","故山何处望，","荒岸小长亭。"],"stanzas":[["佳节虽逢菊，","浮生正似萍。"],["故山何处望，","荒岸小长亭。"]]}
{"id":"419145eb90","title":"江行无题一百首 二十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月下江流静，","村荒人语稀。","鹭鸳虽有伴，","仍共影双飞。"],"stanzas":[["月下江流静，","村荒人语稀。"],["鹭鸳虽有伴，","仍共影双飞。"]]}
{"id":"a74e919009","title":"江行无题一百首 二十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斗转月未落，","舟行夜已深。","有村知不远，","风便数声砧。"],"stanzas":[["斗转月未落，","舟行夜已深。"],["有村知不远，","风便数声砧。"]]}
{"id":"64e1cc008a","title":"江行无题一百首 二十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["櫂惊沙鸟迅，","飞溅夕阳波。","不顾鱼多处，","应防一目罗。"],"stanzas":[["櫂惊沙鸟迅，","飞溅夕阳波。"],["不顾鱼多处，","应防一目罗。"]]}
{"id":"4e54ff5266","title":"江行无题一百首 二十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行到楚江岸，","苍茫人正迷。","秪如秦塞远，","格磔鹧鸪啼。"],"stanzas":[["行到楚江岸，","苍茫人正迷。"],["秪如秦塞远，","格磔鹧鸪啼。"]]}
{"id":"5b4615c6e1","title":"江行无题一百首 三十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渐觉江天远，","难逢故国书。","可能无往事，","空食鼎中鱼。"],"stanzas":[["渐觉江天远，","难逢故国书。"],["可能无往事，","空食鼎中鱼。"]]}
{"id":"9b940f0205","title":"江行无题一百首 三十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岸草连荒色，","村声乐稔年。","晚晴贪获稻，","闲却采菱船。"],"stanzas":[["岸草连荒色，","村声乐稔年。"],["晚晴贪获稻，","闲却采菱船。"]]}
{"id":"8d391f19b0","title":"江行无题一百首 三十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["滩浅多游鹭，","江清易见鱼。","怪来吟未足，","秋物欠红蕖。"],"stanzas":[["滩浅多游鹭，","江清易见鱼。"],["怪来吟未足，","秋物欠红蕖。"]]}
{"id":"d15f9b8247","title":"江行无题一百首 三十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛩响依沙草，","萤飞透水烟。","夜凉谁咏史，","空泊运租船。"],"stanzas":[["蛩响依沙草，","萤飞透水烟。"],["夜凉谁咏史，","空泊运租船。"]]}
{"id":"4f8e3f60bb","title":"江行无题一百首 三十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["睡稳叶舟轻，","风微浪不惊。","人居芦苇岸，","终夜动秋声。"],"stanzas":[["睡稳叶舟轻，","风微浪不惊。"],["人居芦苇岸，","终夜动秋声。"]]}
{"id":"7b2bf7fb99","title":"江行无题一百首 三十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自念平生意，","曾期一郡符。","可知因谪宦，","斑鬓入江湖。"],"stanzas":[["自念平生意，","曾期一郡符。"],["可知因谪宦，","斑鬓入江湖。"]]}
{"id":"970adaccc5","title":"江行无题一百首 三十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水天凉夜月，","不是少清光。","好景随人物，","秦淮忆建康。"],"stanzas":[["水天凉夜月，","不是少清光。"],["好景随人物，","秦淮忆建康。"]]}
{"id":"1bdad441b7","title":"江行无题一百首 三十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古来多思客，","摇落恨江潭。","今日秋风至，","萧疎过沔南。"],"stanzas":[["古来多思客，","摇落恨江潭。"],["今日秋风至，","萧疎过沔南。"]]}
{"id":"2de9d563cb","title":"江行无题一百首 三十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["映竹疑村好，","穿芦觉渚幽。","渐安无旷土，","姜芋当农收。"],"stanzas":[["映竹疑村好，","穿芦觉渚幽。"],["渐安无旷土，","姜芋当农收。"]]}
{"id":"0a012f7844","title":"江行无题一百首 三十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟渚复烟渚，","画屏休画屏。","引愁天末去，","数点暮山青。"],"stanzas":[["烟渚复烟渚，","画屏休画屏。"],["引愁天末去，","数点暮山青。"]]}
{"id":"ec737ee71c","title":"江行无题一百首 四十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋风动客心，","寂寂不成吟。","飞上危樯立，","莺啼报好音。"],"stanzas":[["秋风动客心，","寂寂不成吟。"],["飞上危樯立，","莺啼报好音。"]]}
{"id":"e4f0fd869b","title":"江行无题一百首 四十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["见底高秋水，","开怀万里天。","旅吟还有伴，","沙柳数枝蝉。"],"stanzas":[["见底高秋水，","开怀万里天。"],["旅吟还有伴，","沙柳数枝蝉。"]]}
{"id":"c0b4e4507f","title":"江行无题一百首 四十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九日自佳节，","扁舟无一杯。","曹园旧罇酒，","戏马忆高台。"],"stanzas":[["九日自佳节，","扁舟无一杯。"],["曹园旧罇酒，","戏马忆高台。"]]}
{"id":"be83cf1881","title":"江行无题一百首 四十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兵火有余烬，","贫村才数家。","无人争晓渡，","残月下寒沙。"],"stanzas":[["兵火有余烬，","贫村才数家。"],["无人争晓渡，","残月下寒沙。"]]}
{"id":"b75e5bff38","title":"江行无题一百首 四十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渚禽菱芡足，","不向稻粱争。","静宿凉湾月，","应无失侣声。"],"stanzas":[["渚禽菱芡足，","不向稻粱争。"],["静宿凉湾月，","应无失侣声。"]]}
{"id":"1bebcad43a","title":"江行无题一百首 四十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轻云未扑霜，","树杪橘初黄。","行是知名物，","过风过水香。"],"stanzas":[["轻云未扑霜，","树杪橘初黄。"],["行是知名物，","过风过水香。"]]}
{"id":"d6f0bdacc9","title":"江行无题一百首 四十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["土旷深耕少，","江平远钓多。","平生皆弃本，","金革竟如何。"],"stanzas":[["土旷深耕少，","江平远钓多。"],["平生皆弃本，","金革竟如何。"]]}
{"id":"e3aca1a999","title":"江行无题一百首 四十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海月非常物，","等闲不可寻。","披沙应有地，","浅处定无金。"],"stanzas":[["海月非常物，","等闲不可寻。"],["披沙应有地，","浅处定无金。"]]}
{"id":"bd610764a8","title":"江行无题一百首 四十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风晚冷飕飕，","芦花已白头。","旧来红叶寺，","堪忆玉京秋。"],"stanzas":[["风晚冷飕飕，","芦花已白头。"],["旧来红叶寺，","堪忆玉京秋。"]]}
{"id":"c32e9c0b84","title":"江行无题一百首 四十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渺渺望天涯，","清涟浸赤霞。","难逢星汉使，","乌鹊日乘槎。"],"stanzas":[["渺渺望天涯，","清涟浸赤霞。"],["难逢星汉使，","乌鹊日乘槎。"]]}
{"id":"ac0b33a024","title":"江行无题一百首 五十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风好来无阵，","云开去有踪。","钓歌无远近，","应喜罢艨艟。"],"stanzas":[["风好来无阵，","云开去有踪。"],["钓歌无远近，","应喜罢艨艟。"]]}
{"id":"8f3319a106","title":"江行无题一百首 五十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴疆连楚甸，","楚俗异吴乡。","谩把罇中物，","无人啄蟹黄。"],"stanzas":[["吴疆连楚甸，","楚俗异吴乡。"],["谩把罇中物，","无人啄蟹黄。"]]}
{"id":"9c5f5c92fe","title":"江行无题一百首 五十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岸绿野烟远，","江红斜照微。","撑开小渔艇，","应到月明归。"],"stanzas":[["岸绿野烟远，","江红斜照微。"],["撑开小渔艇，","应到月明归。"]]}
{"id":"b8a38b38b5","title":"江行无题一百首 五十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨余江始涨，","漾漾见流薪。","曾叹河中木，","斯言忆古人。"],"stanzas":[["雨余江始涨，","漾漾见流薪。"],["曾叹河中木，","斯言忆古人。"]]}
{"id":"a28ff4d178","title":"江行无题一百首 五十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["垂露晚犹浓，","清风不易逢。","涉江虽已晚，","高树搴芙蓉。"],"stanzas":[["垂露晚犹浓，","清风不易逢。"],["涉江虽已晚，","高树搴芙蓉。"]]}
{"id":"2b9a4f7ff7","title":"江行无题一百首 五十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乘舟维夏口，","烟野独行时。","不见头陀寺，","空怀幼妇碑。"],"stanzas":[["乘舟维夏口，","烟野独行时。"],["不见头陀寺，","空怀幼妇碑。"]]}
{"id":"b4c9fb1219","title":"江行无题一百首 五十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚泊武昌岸，","津亭疎柳风。","数株曾手植，","好事忆陶公。"],"stanzas":[["晚泊武昌岸，","津亭疎柳风。"],["数株曾手植，","好事忆陶公。"]]}
{"id":"49e81c3b70","title":"江行无题一百首 五十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舟航依浦定，","星斗满江寒。","若比阴霾日，","何妨夜未阑。"],"stanzas":[["舟航依浦定，","星斗满江寒。"],["若比阴霾日，","何妨夜未阑。"]]}
{"id":"8d0dbe210b","title":"江行无题一百首 五十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["近戍离金落，","孤岑望火门。","惟将知命意，","潇洒向乾坤。"],"stanzas":[["近戍离金落，","孤岑望火门。"],["惟将知命意，","潇洒向乾坤。"]]}
{"id":"c1aaedea58","title":"江行无题一百首 五十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丛菊生堤上，","此花长后时。","有人还采掇，","何必在春期。"],"stanzas":[["丛菊生堤上，","此花长后时。"],["有人还采掇，","何必在春期。"]]}
{"id":"9b5eb58139","title":"江行无题一百首 六十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["景夕残霞落，","秋寒细雨晴。","短缨何用濯，","舟在月中行。"],"stanzas":[["景夕残霞落，","秋寒细雨晴。"],["短缨何用濯，","舟在月中行。"]]}
{"id":"9eb0f26347","title":"江行无题一百首 六十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堤坏漏江水，","地坳成野塘。","晚荷人不折，","留取作秋香。"],"stanzas":[["堤坏漏江水，","地坳成野塘。"],["晚荷人不折，","留取作秋香。"]]}
{"id":"191cfd74c5","title":"江行无题一百首 六十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["左宦终何路，","摅怀亦自宽。","襞牋嘲白鹭，","无意喻枭鸾。"],"stanzas":[["左宦终何路，","摅怀亦自宽。"],["襞牋嘲白鹭，","无意喻枭鸾。"]]}
{"id":"012e456d37","title":"江行无题一百首 六十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼空人不归，","云白去时衣。","黄鹤无心下，","长应笑令威。"],"stanzas":[["楼空人不归，","云白去时衣。"],["黄鹤无心下，","长应笑令威。"]]}
{"id":"65539aff1f","title":"江行无题一百首 六十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白帝朝惊浪，","阳台暮映云。","等闲生险易，","世路秪如君。"],"stanzas":[["白帝朝惊浪，","阳台暮映云。"],["等闲生险易，","世路秪如君。"]]}
{"id":"ee9976bee8","title":"江行无题一百首 六十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["橹慢生轻浪，","帆虚带白云。","客船虽狭小，","容得瘦将军。"],"stanzas":[["橹慢生轻浪，","帆虚带白云。"],["客船虽狭小，","容得瘦将军。"]]}
{"id":"d41fe46d8f","title":"江行无题一百首 六十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["静看秋江水，","风微浪渐平。","人间驰竞处，","尘土自波成。"],"stanzas":[["静看秋江水，","风微浪渐平。"],["人间驰竞处，","尘土自波成。"]]}
{"id":"0030dbc155","title":"江行无题一百首 六十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风借帆方疾，","风回櫂却迟。","较量人世事，","不校一毫厘。"],"stanzas":[["风借帆方疾，","风回櫂却迟。"],["较量人世事，","不校一毫厘。"]]}
{"id":"635e2fcd5e","title":"江行无题一百首 六十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["咫尺愁风雨，","匡庐不可登。","秪疑云雾窟，","犹有六朝僧。"],"stanzas":[["咫尺愁风雨，","匡庐不可登。"],["秪疑云雾窟，","犹有六朝僧。"]]}
{"id":"c4811e78ec","title":"江行无题一百首 六十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江草何多思，","冬青尚满洲。","谁能惊鵩鸟，","作赋为沙鸥。"],"stanzas":[["江草何多思，","冬青尚满洲。"],["谁能惊鵩鸟，","作赋为沙鸥。"]]}
{"id":"7346debde7","title":"江行无题一百首 七十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幸有烟波兴，","宁辞笔砚劳。","缘情无怨刺，","却似反离骚。"],"stanzas":[["幸有烟波兴，","宁辞笔砚劳。"],["缘情无怨刺，","却似反离骚。"]]}
{"id":"32b195beaf","title":"江行无题一百首 七十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沙上独行时，","高吟到楚词。","难将垂岸蓼，","盈把当江蓠。"],"stanzas":[["沙上独行时，","高吟到楚词。"],["难将垂岸蓼，","盈把当江蓠。"]]}
{"id":"6b6dd1d32f","title":"江行无题一百首 七十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋寒鹰隼健，","逐雀下云空。","知是江湖客，","无心击塞鸿。"],"stanzas":[["秋寒鹰隼健，","逐雀下云空。"],["知是江湖客，","无心击塞鸿。"]]}
{"id":"5efed5df32","title":"江行无题一百首 七十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽怀念烟水，","长恨隔龙沙。","今日滕王阁，","分明见落霞。"],"stanzas":[["幽怀念烟水，","长恨隔龙沙。"],["今日滕王阁，","分明见落霞。"]]}
{"id":"38606ef7d8","title":"江行无题一百首 七十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江流何渺渺，","怀古独依依。","渔父非贤者，","芦中但有矶。"],"stanzas":[["江流何渺渺，","怀古独依依。"],["渔父非贤者，","芦中但有矶。"]]}
{"id":"eade26ac87","title":"江行无题一百首 七十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风雨正甘寝，","云霓忽晓晴。","放歌虽自遣，","一岁又峥嵘。"],"stanzas":[["风雨正甘寝，","云霓忽晓晴。"],["放歌虽自遣，","一岁又峥嵘。"]]}
{"id":"d9ee35c73b","title":"江行无题一百首 七十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽思正迟迟，","沙边濯弄时。","自怜非博物，","犹未识凫葵。"],"stanzas":[["幽思正迟迟，","沙边濯弄时。"],["自怜非博物，","犹未识凫葵。"]]}
{"id":"d93558b90a","title":"江行无题一百首 七十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾有烟波客，","能歌西塞山。","落花惟待月，","一钓紫菱湾。"],"stanzas":[["曾有烟波客，","能歌西塞山。"],["落花惟待月，","一钓紫菱湾。"]]}
{"id":"4da81e8ef7","title":"江行无题一百首 七十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千顷水纹细，","一拳岚影孤。","君山寒树绿，","曾过洞庭湖。"],"stanzas":[["千顷水纹细，","一拳岚影孤。"],["君山寒树绿，","曾过洞庭湖。"]]}
{"id":"0f78753cd5","title":"江行无题一百首 七十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["光阔重湖水，","低斜远鴈行。","未曾无兴咏，","多谢沈东阳。"],"stanzas":[["光阔重湖水，","低斜远鴈行。"],["未曾无兴咏，","多谢沈东阳。"]]}
{"id":"0c9db50093","title":"江行无题一百首 八十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚菊绕江垒，","忽如开古屏。","莫言时节过，","白日有余馨。"],"stanzas":[["晚菊绕江垒，","忽如开古屏。"],["莫言时节过，","白日有余馨。"]]}
{"id":"ad9b2b92fe","title":"江行无题一百首 八十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日落长亭晚，","山门步障青。","可怜无酒分，","处处有旗亭。"],"stanzas":[["日落长亭晚，","山门步障青。"],["可怜无酒分，","处处有旗亭。"]]}
{"id":"0f722cfb33","title":"江行无题一百首 八十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远岸无行树，","经霜有伴红。","停船搜好句，","题叶赠江枫。"],"stanzas":[["远岸无行树，","经霜有伴红。"],["停船搜好句，","题叶赠江枫。"]]}
{"id":"4b5dbf6299","title":"江行无题一百首 八十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身世比行舟，","无风亦暂休。","敢言终破浪，","惟愿稳乘流。"],"stanzas":[["身世比行舟，","无风亦暂休。"],["敢言终破浪，","惟愿稳乘流。"]]}
{"id":"342687895a","title":"江行无题一百首 八十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数亩苍苔石，","烟蒙鹤卵洲。","定因词客遇，","名字始风流。"],"stanzas":[["数亩苍苔石，","烟蒙鹤卵洲。"],["定因词客遇，","名字始风流。"]]}
{"id":"de5b03a9f7","title":"江行无题一百首 八十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兴闲停桂楫，","路好过松门。","不负佳山水，","还开酒一樽。"],"stanzas":[["兴闲停桂楫，","路好过松门。"],["不负佳山水，","还开酒一樽。"]]}
{"id":"f378f7ab18","title":"江行无题一百首 八十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["短檝休敲桂，","孤根自驻萍。","自怜非劒气，","空向斗牛星。"],"stanzas":[["短檝休敲桂，","孤根自驻萍。"],["自怜非劒气，","空向斗牛星。"]]}
{"id":"3c6af0b210","title":"江行无题一百首 八十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高浪如银屋，","江风一发时。","笔端降太白，","才大语终奇。"],"stanzas":[["高浪如银屋，","江风一发时。"],["笔端降太白，","才大语终奇。"]]}
{"id":"ac6034c34a","title":"江行无题一百首 八十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细竹渔家路，","晴阳看结罾。","喜来邀客坐，","分与折腰菱。"],"stanzas":[["细竹渔家路，","晴阳看结罾。"],["喜来邀客坐，","分与折腰菱。"]]}
{"id":"a63d93cde5","title":"江行无题一百首 八十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平湖五百里，","江水想通波。","不奈扁舟去，","其如决计何。"],"stanzas":[["平湖五百里，","江水想通波。"],["不奈扁舟去，","其如决计何。"]]}
{"id":"8f3832ccf0","title":"江行无题一百首 九十","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数逢云断处，","去岸映高山。","身到章江日，","应犹未得闲。"],"stanzas":[["数逢云断处，","去岸映高山。"],["身到章江日，","应犹未得闲。"]]}
{"id":"fe40c7210d","title":"江行无题一百首 九十一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一湾斜照水，","三版顺风船。","未敢相邀钓，","劳生只自怜。"],"stanzas":[["一湾斜照水，","三版顺风船。"],["未敢相邀钓，","劳生只自怜。"]]}
{"id":"156b6d460a","title":"江行无题一百首 九十二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江雨正霏微，","江村晚渡稀。","何曾妨钓艇，","更待得鱼归。"],"stanzas":[["江雨正霏微，","江村晚渡稀。"],["何曾妨钓艇，","更待得鱼归。"]]}
{"id":"c24e1bccc0","title":"江行无题一百首 九十三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新野旧楼名，","浔阳胜赏情。","照人长一色，","江月共凄清。"],"stanzas":[["新野旧楼名，","浔阳胜赏情。"],["照人长一色，","江月共凄清。"]]}
{"id":"678dfb9965","title":"江行无题一百首 九十四","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愿饮西江水，","那吟北渚愁。","莫教留滞迹，","远比蔡昭侯。"],"stanzas":[["愿饮西江水，","那吟北渚愁。"],["莫教留滞迹，","远比蔡昭侯。"]]}
{"id":"4e0a843fbd","title":"江行无题一百首 九十五","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湖口分江水，","东流独有情。","常时好风物，","谁伴谢宣城。"],"stanzas":[["湖口分江水，","东流独有情。"],["常时好风物，","谁伴谢宣城。"]]}
{"id":"b92950c666","title":"江行无题一百首 九十六","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浔阳江畔菊，","应似古来秋。","为问幽栖客，","吟时得酒不。"],"stanzas":[["浔阳江畔菊，","应似古来秋。"],["为问幽栖客，","吟时得酒不。"]]}
{"id":"6d16b3a6d3","title":"江行无题一百首 九十七","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高峰有佳号，","千尺倚寒风。","若使炉烟在，","犹应为上公。"],"stanzas":[["高峰有佳号，","千尺倚寒风。"],["若使炉烟在，","犹应为上公。"]]}
{"id":"75536c53d2","title":"江行无题一百首 九十八","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万木已清霜，","江边村事忙。","故溪黄稻熟，","一夜梦中香。"],"stanzas":[["万木已清霜，","江边村事忙。"],["故溪黄稻熟，","一夜梦中香。"]]}
{"id":"311b61415c","title":"江行无题一百首 九十九","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚水苦萦回，","征帆落又开。","可缘非直路，","却有好风来。"],"stanzas":[["楚水苦萦回，","征帆落又开。"],["可缘非直路，","却有好风来。"]]}
{"id":"fda3a35484","title":"江行无题一百首 一百","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远谪岁时[晏]，","暮江风雨寒。","仍愁系舟处，","惊梦近长滩。"],"stanzas":[["远谪岁时[晏]，","暮江风雨寒。"],["仍愁系舟处，","惊梦近长滩。"]]}
{"id":"01ddae3f8d","title":"春恨三首 一","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["负罪将军在北朝，","秦淮芳草绿迢迢。","高台爱妾魂销尽，","始得丘迟为一招。"],"stanzas":[["负罪将军在北朝，","秦淮芳草绿迢迢。"],["高台爱妾魂销尽，","始得丘迟为一招。"]]}
{"id":"7fdec880e2","title":"春恨三首 二","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["久戍临洮报未归，","箧香销尽别时衣。","身轻愿比兰堦蝶，","万里还寻塞草飞。"],"stanzas":[["久戍临洮报未归，","箧香销尽别时衣。"],["身轻愿比兰堦蝶，","万里还寻塞草飞。"]]}
{"id":"e0c9976b61","title":"春恨三首 三","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["永巷频闻小苑游，","旧恩如泪亦难收。","君前愿报新颜色，","团扇须防白露秋。"],"stanzas":[["永巷频闻小苑游，","旧恩如泪亦难收。"],["君前愿报新颜色，","团扇须防白露秋。"]]}
{"id":"76b12f4d71","title":"蜀国偶题","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忽忆明皇西幸时，","暗伤潜恨竟谁知。","佩兰应语宫臣道，","莫向金盘进茘枝。"],"stanzas":[["忽忆明皇西幸时，","暗伤潜恨竟谁知。"],["佩兰应语宫臣道，","莫向金盘进茘枝。"]]}
{"id":"747490ad11","title":"未展芭蕉","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冷烛无烟绿蜡干，","芳心犹卷怯春寒。","一缄书札藏何事，","会被东风暗拆看。"],"stanzas":[["冷烛无烟绿蜡干，","芳心犹卷怯春寒。"],["一缄书札藏何事，","会被东风暗拆看。"]]}
{"id":"7cabead38c","title":"同程九早入中书","author":"钱珝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉家贤相重英奇，","蟠木何材也见知。","不意云霄能自致，","空惊鹓鹭忽相随。","腊雪初明柏子殿，","春光欲上万年枝。","独惭皇鉴明如日，","未厌春光向玉墀。"],"stanzas":[["汉家贤相重英奇，","蟠木何材也见知。"],["不意云霄能自致，","空惊鹓鹭忽相随。"],["腊雪初明柏子殿，","春光欲上万年枝。"],["独惭皇鉴明如日，","未厌春光向玉墀。"]]}
{"id":"d0087ea93a","title":"陈情献中丞","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤拙竟何营，","徒希折桂名。","始终谁肯荐，","得失自难明。","贡乏雄文献，","归无瘠土耕。","沧江长发梦，","紫陌久慙行。","意纵求知切，","才惟惧鉴精。","五言非琢玉，","十载看迁莺。","取进心甘钝，","伤嗟骨每惊。","尘襟痕积泪，","客鬓白新茎。","顾盼身堪教，","吹嘘羽觉生。","依门情转切，","荷德力须倾。","奖善犹怜贡，","垂恩必不轻。","从兹便提挈，","云路自生荣。"],"stanzas":[["孤拙竟何营，","徒希折桂名。"],["始终谁肯荐，","得失自难明。"],["贡乏雄文献，","归无瘠土耕。"],["沧江长发梦，","紫陌久慙行。"],["意纵求知切，","才惟惧鉴精。"],["五言非琢玉，","十载看迁莺。"],["取进心甘钝，","伤嗟骨每惊。"],["尘襟痕积泪，","客鬓白新茎。"],["顾盼身堪教，","吹嘘羽觉生。"],["依门情转切，","荷德力须倾。"],["奖善犹怜贡，","垂恩必不轻。"],["从兹便提挈，","云路自生荣。"]]}
{"id":"eaf1c566f2","title":"长安雪后","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧落云收尽，","天涯雪霁时。","草开当井地，","树折带巢枝。","野渡滋寒麦，","高泉涨禁池。","遥分丹阙出，","回对上林宜。","宿片攀簷取，","凝花就砌窥。","气凌禽翅束，","冻入马蹄危。","北想连沙漠，","南思极海涯。","冷光兼素彩，","向暮朔风吹。"],"stanzas":[["碧落云收尽，","天涯雪霁时。"],["草开当井地，","树折带巢枝。"],["野渡滋寒麦，","高泉涨禁池。"],["遥分丹阙出，","回对上林宜。"],["宿片攀簷取，","凝花就砌窥。"],["气凌禽翅束，","冻入马蹄危。"],["北想连沙漠，","南思极海涯。"],["冷光兼素彩，","向暮朔风吹。"]]}
{"id":"aacd6b2c42","title":"送友人游东川","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["食尽须分散，","将行几愿留。","春兼三月闰，","人拟半年游。","风俗同吴地，","山川拥梓州。","思君登栈道，","猨啸始应愁。"],"stanzas":[["食尽须分散，","将行几愿留。"],["春兼三月闰，","人拟半年游。"],["风俗同吴地，","山川拥梓州。"],["思君登栈道，","猨啸始应愁。"]]}
{"id":"c934a384fd","title":"题樟亭驿楼","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危槛倚山城，","风帆槛外行。","日生沧海赤，","潮落浙江清。","秋晚遥峰出，","沙干细草平。","西陵烟树色，","长见伍员情。"],"stanzas":[["危槛倚山城，","风帆槛外行。"],["日生沧海赤，","潮落浙江清。"],["秋晚遥峰出，","沙干细草平。"],["西陵烟树色，","长见伍员情。"]]}
{"id":"305b570c1f","title":"大梁送友人东游","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自古东西路，","舟车此地分。","河声梁苑夜，","草色楚田曛。","鴈已多南去，","蝉犹在此闻。","圣朝无谏猎，","何计谒明君。"],"stanzas":[["自古东西路，","舟车此地分。"],["河声梁苑夜，","草色楚田曛。"],["鴈已多南去，","蝉犹在此闻。"],["圣朝无谏猎，","何计谒明君。"]]}
{"id":"b99f28928b","title":"送友人游蜀","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为儒早得名，","为客不忧程。","春尽离丹阙，","花繁到锦城。","雪消巴水涨，","日上剑关明。","预想回来树，","秋蝉已数声。"],"stanzas":[["为儒早得名，","为客不忧程。"],["春尽离丹阙，","花繁到锦城。"],["雪消巴水涨，","日上剑关明。"],["预想回来树，","秋蝉已数声。"]]}
{"id":"f5525f2265","title":"留别友人书斋","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相见不相暌，","一留日已西。","轩凉庭木大，","巷僻鸟巢低。","背俗修琴谱，","思家话药畦。","卜邻期太华，","同上上方梯。"],"stanzas":[["相见不相暌，","一留日已西。"],["轩凉庭木大，","巷僻鸟巢低。"],["背俗修琴谱，","思家话药畦。"],["卜邻期太华，","同上上方梯。"]]}
{"id":"756fdace03","title":"题耿处士林亭","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身向闲中老，","生涯本豁然。","草堂山水下，","渔艇鸟花边。","窥井猨兼鹿，","啼林鸟杂蝉。","何时人事了，","依此亦高眠。"],"stanzas":[["身向闲中老，","生涯本豁然。"],["草堂山水下，","渔艇鸟花边。"],["窥井猨兼鹿，","啼林鸟杂蝉。"],["何时人事了，","依此亦高眠。"]]}
{"id":"5c6cbfc746","title":"商于逢友人","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行役何时了，","年年骨肉分。","春风来汉棹，","雪路入商云。","水险溪难定，","林寒鸟异群。","相逢聊坐石，","啼狖语中闻。"],"stanzas":[["行役何时了，","年年骨肉分。"],["春风来汉棹，","雪路入商云。"],["水险溪难定，","林寒鸟异群。"],["相逢聊坐石，","啼狖语中闻。"]]}
{"id":"b92686b576","title":"灞上逢故人","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花落杏园枝，","驱车问路岐。","人情谁可会，","身事自堪疑。","岳雨狂雷送，","溪槎涨水吹。","家山如此景，","几处不相随。"],"stanzas":[["花落杏园枝，","驱车问路岐。"],["人情谁可会，","身事自堪疑。"],["岳雨狂雷送，","溪槎涨水吹。"],["家山如此景，","几处不相随。"]]}
{"id":"558e0f944f","title":"发浙江","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岛屿遍含烟，","烟中济大川。","山城犹转漏，","沙浦已摇船。","海曙霞浮日，","江遥水合天。","此时空阔思，","翻想涉穷边。"],"stanzas":[["岛屿遍含烟，","烟中济大川。"],["山城犹转漏，","沙浦已摇船。"],["海曙霞浮日，","江遥水合天。"],["此时空阔思，","翻想涉穷边。"]]}
{"id":"7c64528512","title":"晚泊旴𣅿","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["广苇夹深流，","萧萧到海秋。","宿船横月浦，","惊鸟绕霜洲。","云湿淮南树，","笳清泗水楼。","徒悬乡国思，","羁迹尚东游。"],"stanzas":[["广苇夹深流，","萧萧到海秋。"],["宿船横月浦，","惊鸟绕霜洲。"],["云湿淮南树，","笳清泗水楼。"],["徒悬乡国思，","羁迹尚东游。"]]}
{"id":"79287d4699","title":"归江南","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["归日值江春，","看花过楚津。","草晴虫网遍，","沙晓浪痕新。","莲叶初浮水，","鸥雏已狎人。","渔心惭未遂，","空厌路岐尘。"],"stanzas":[["归日值江春，","看花过楚津。"],["草晴虫网遍，","沙晓浪痕新。"],["莲叶初浮水，","鸥雏已狎人。"],["渔心惭未遂，","空厌路岐尘。"]]}
{"id":"59f247d626","title":"代北言怀","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["困马榆关北，","那堪落景催。","路行沙不绝，","风与雪兼来。","草得春犹白，","鸿侵夏始回。","行人莫远入，","戍角有余哀。"],"stanzas":[["困马榆关北，","那堪落景催。"],["路行沙不绝，","风与雪兼来。"],["草得春犹白，","鸿侵夏始回。"],["行人莫远入，","戍角有余哀。"]]}
{"id":"cea302354b","title":"春游曲江","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["误入杏花尘，","晴江一看春。","菰蒲虽似越，","骨肉且非秦。","曲岸藏翘鹭，","垂杨拂跃鳞。","徒怜汀草色，","未是醉眠人。"],"stanzas":[["误入杏花尘，","晴江一看春。"],["菰蒲虽似越，","骨肉且非秦。"],["曲岸藏翘鹭，","垂杨拂跃鳞。"],["徒怜汀草色，","未是醉眠人。"]]}
{"id":"3e94a6d3ce","title":"和范秘书宿省中作","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清省宜寒夜，","仙才称独吟。","钟来宫转漏，","月过合移阴。","鹤避灯前尽，","芸高幄外深。","想知因此兴，","暂动忆山心。"],"stanzas":[["清省宜寒夜，","仙才称独吟。"],["钟来宫转漏，","月过合移阴。"],["鹤避灯前尽，","芸高幄外深。"],["想知因此兴，","暂动忆山心。"]]}
{"id":"81ba5ecf2b","title":"寄华阴姚少府","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泰华当公署，","为官兴可知。","砚和青霭冻，","帘对白云垂。","峻掌光浮日，","危莲影入池。","料于三考内，","应惜德音移。"],"stanzas":[["泰华当公署，","为官兴可知。"],["砚和青霭冻，","帘对白云垂。"],["峻掌光浮日，","危莲影入池。"],["料于三考内，","应惜德音移。"]]}
{"id":"380079b91e","title":"路泊富春寄友人","author":"喻坦之","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江钟寒夕微，","江鸟望巢飞。","木落山城出，","潮生海棹归。","独吟霜岛月，","谁寄雪天衣。","此别三千里，","关西信更稀。"],"stanzas":[["江钟寒夕微，","江鸟望巢飞。"],["木落山城出，","潮生海棹归。"],["独吟霜岛月，","谁寄雪天衣。"],["此别三千里，","关西信更稀。"]]}
{"id":"739c866c77","title":"梅花","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数萼初含雪，","孤标画本难。","香中别有韵，","清极不知寒。","横笛和愁听，","斜枝倚病看。","朔风如解意，","容易莫摧残。"],"stanzas":[["数萼初含雪，","孤标画本难。"],["香中别有韵，","清极不知寒。"],["横笛和愁听，","斜枝倚病看。"],["朔风如解意，","容易莫摧残。"]]}
{"id":"44f2555afa","title":"铜雀妓二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["严妆垂玉筯，","妙舞对清风。","无复君王顾，","春来起渐慵。"],"stanzas":[["严妆垂玉筯，","妙舞对清风。"],["无复君王顾，","春来起渐慵。"]]}
{"id":"73699f217c","title":"铜雀妓二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌咽新翻曲，","香销旧赐衣。","陵园春雨暗，","不见六龙归。"],"stanzas":[["歌咽新翻曲，","香销旧赐衣。"],["陵园春雨暗，","不见六龙归。"]]}
{"id":"f9f02da80c","title":"春闺二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒食月明雨，","落花香满泥。","佳人持锦字，","无雁寄辽西。"],"stanzas":[["寒食月明雨，","落花香满泥。"],["佳人持锦字，","无雁寄辽西。"]]}
{"id":"f802e3ba3f","title":"春闺二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲剪宜春字，","春寒入剪刀。","辽阳在何处，","莫望寄征袍。"],"stanzas":[["欲剪宜春字，","春寒入剪刀。"],["辽阳在何处，","莫望寄征袍。"]]}
{"id":"c85e67ceed","title":"访僧不遇","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寻僧已寂寞，","林下锁山房。","松竹虽无语，","牵衣借晚凉。"],"stanzas":[["寻僧已寂寞，","林下锁山房。"],["松竹虽无语，","牵衣借晚凉。"]]}
{"id":"3103283d58","title":"田上","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨足高田白，","披蓑半夜耕。","人牛力俱尽，","东方殊未明。"],"stanzas":[["雨足高田白，","披蓑半夜耕。"],["人牛力俱尽，","东方殊未明。"]]}
{"id":"1314e86490","title":"月夕","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月上随人意，","人闲月更清。","朱楼高百尺，","不见到天明。"],"stanzas":[["月上随人意，","人闲月更清。"],["朱楼高百尺，","不见到天明。"]]}
{"id":"5c04296e9e","title":"槿花","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["槿花不见夕，","一日一回新。","东风吹桃李，","须到明年春。"],"stanzas":[["槿花不见夕，","一日一回新。"],["东风吹桃李，","须到明年春。"]]}
{"id":"7e2fe6e9ba","title":"西施滩","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宰嚭亡吴国，","西施陷恶名。","浣纱春水急，","似有不平声。"],"stanzas":[["宰嚭亡吴国，","西施陷恶名。"],["浣纱春水急，","似有不平声。"]]}
{"id":"d2355e7c10","title":"江上逢故人","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故里琴樽侣，","相逢近腊梅。","江村买一醉，","破泪却成咍。"],"stanzas":[["故里琴樽侣，","相逢近腊梅。"],["江村买一醉，","破泪却成咍。"]]}
{"id":"a081577952","title":"牧竖","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牧竖持蓑笠，","逢人气傲然。","卧牛吹短笛，","耕却傍溪田。"],"stanzas":[["牧竖持蓑笠，","逢人气傲然。"],["卧牛吹短笛，","耕却傍溪田。"]]}
{"id":"f2711fceb5","title":"过农家","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲羡农家子，","秋新看刈禾。","苏秦无负郭，","六印又如何。"],"stanzas":[["欲羡农家子，","秋新看刈禾。"],["苏秦无负郭，","六印又如何。"]]}
{"id":"193f7ce6d0","title":"江夕","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江心秋月白，","起柁信潮行。","蛟龙化为人，","半夜吹笛声。"],"stanzas":[["江心秋月白，","起柁信潮行。"],["蛟龙化为人，","半夜吹笛声。"]]}
{"id":"6ecdbc413b","title":"春墅","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛙声近过社，","农事忽已忙。","邻妇饷田归，","不见百花芳。"],"stanzas":[["蛙声近过社，","农事忽已忙。"],["邻妇饷田归，","不见百花芳。"]]}
{"id":"c434411f49","title":"江村","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日暮片帆落，","江村如有情。","独对沙上月，","满船人睡声。"],"stanzas":[["日暮片帆落，","江村如有情。"],["独对沙上月，","满船人睡声。"]]}
{"id":"3525bf925c","title":"拟乐府子夜四时歌四首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴子爱桃李，","月色不到地。","明朝欲看花，","六宫人不睡。"],"stanzas":[["吴子爱桃李，","月色不到地。"],["明朝欲看花，","六宫人不睡。"]]}
{"id":"30dd8c0194","title":"拟乐府子夜四时歌四首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凉轩待月生，","暗里萤飞出。","低回不称意，","蛙鸣乱清瑟。"],"stanzas":[["凉轩待月生，","暗里萤飞出。"],["低回不称意，","蛙鸣乱清瑟。"]]}
{"id":"dc98d9fbf9","title":"拟乐府子夜四时歌四首 三","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月色明如昼，","虫声入户多。","狂夫自不归，","满地无天河。"],"stanzas":[["月色明如昼，","虫声入户多。"],["狂夫自不归，","满地无天河。"]]}
{"id":"def9a30033","title":"拟乐府子夜四时歌四首 四","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["银缸照残梦，","零泪沾粉臆。","洞房犹自寒，","何况关山北。"],"stanzas":[["银缸照残梦，","零泪沾粉臆。"],["洞房犹自寒，","何况关山北。"]]}
{"id":"365ced046b","title":"寄人二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花上断续雨，","江头来去风。","相思春欲尽，","未遣酒尊空。"],"stanzas":[["花上断续雨，","江头来去风。"],["相思春欲尽，","未遣酒尊空。"]]}
{"id":"c34caea497","title":"寄人二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["澹澹长江水，","悠悠远客情。","落花相与恨，","到地一无声。"],"stanzas":[["澹澹长江水，","悠悠远客情。"],["落花相与恨，","到地一无声。"]]}
{"id":"8066010ae3","title":"江鸥","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白鸟波上栖，","见人懒飞起。","为有求鱼心，","不是恋江水。"],"stanzas":[["白鸟波上栖，","见人懒飞起。"],["为有求鱼心，","不是恋江水。"]]}
{"id":"3c9042131f","title":"春晚","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三月寒食时，","日色浓于酒。","落尽墙头花，","莺声隔原柳。"],"stanzas":[["三月寒食时，","日色浓于酒。"],["落尽墙头花，","莺声隔原柳。"]]}
{"id":"28e8d04a8c","title":"汉宫词","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独诏胡衣出，","天花落殿堂。","他人不敢妬，","垂泪向君王。"],"stanzas":[["独诏胡衣出，","天花落殿堂。"],["他人不敢妬，","垂泪向君王。"]]}
{"id":"e2d9b29b59","title":"旅行","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少壮经勤苦，","衰年始浪游。","谁怜不龟手，","他处却封侯。"],"stanzas":[["少壮经勤苦，","衰年始浪游。"],["谁怜不龟手，","他处却封侯。"]]}
{"id":"dd7ade2e4d","title":"班婕妤","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宠极辞同辇，","恩深弃后宫。","自题秋扇后，","不敢怨春风。"],"stanzas":[["宠极辞同辇，","恩深弃后宫。"],["自题秋扇后，","不敢怨春风。"]]}
{"id":"5203960b09","title":"元日有题","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十载元正酒，","相欢意转深。","自量麋鹿分，","只合在山林。"],"stanzas":[["十载元正酒，","相欢意转深。"],["自量麋鹿分，","只合在山林。"]]}
{"id":"29dc3c83a5","title":"古树","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古树春风入，","阳和力太迟。","莫言生意尽，","更引万年枝。"],"stanzas":[["古树春风入，","阳和力太迟。"],["莫言生意尽，","更引万年枝。"]]}
{"id":"9061d80994","title":"春题二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青春未得意，","见花却如讐。","路逢白面郎，","醉插花满头。"],"stanzas":[["青春未得意，","见花却如讐。"],["路逢白面郎，","醉插花满头。"]]}
{"id":"a58778bec0","title":"春题二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满眼桃李花，","愁人如不见。","别有惜花人，","东风莫吹散。"],"stanzas":[["满眼桃李花，","愁人如不见。"],["别有惜花人，","东风莫吹散。"]]}
{"id":"b3c4fbcf7c","title":"长安春","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安牡丹开，","绣毂辗晴雷。","若使花长在，","人应看不回。"],"stanzas":[["长安牡丹开，","绣毂辗晴雷。"],["若使花长在，","人应看不回。"]]}
{"id":"b61eabb2e2","title":"病起二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["病起春已晚，","曳筇伤绿苔。","强攀庭树枝，","唤作花未开。"],"stanzas":[["病起春已晚，","曳筇伤绿苔。"],["强攀庭树枝，","唤作花未开。"]]}
{"id":"b217f7cfee","title":"病起二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["病起绕庭除，","春泥黏屐齿。","如从万里来，","骨肉满面喜。"],"stanzas":[["病起绕庭除，","春泥黏屐齿。"],["如从万里来，","骨肉满面喜。"]]}
{"id":"3fe2485952","title":"峡路","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清猨啼不住，","白水下来新。","八月莫为客，","夜长愁杀人。"],"stanzas":[["清猨啼不住，","白水下来新。"],["八月莫为客，","夜长愁杀人。"]]}
{"id":"b612e58b7c","title":"长门怨","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长门春欲尽，","明月照花枝。","买得相如赋，","君恩不可移。"],"stanzas":[["长门春欲尽，","明月照花枝。"],["买得相如赋，","君恩不可移。"]]}
{"id":"63446beba9","title":"月夕有怀","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圆光照一海，","远客在孤舟。","相忆无期见，","中宵独上楼。"],"stanzas":[["圆光照一海，","远客在孤舟。"],["相忆无期见，","中宵独上楼。"]]}
{"id":"efa5393000","title":"夜泊九江","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜泊江门外，","欢声月里楼。","明朝归去路，","犹隔洞庭秋。"],"stanzas":[["夜泊江门外，","欢声月里楼。"],["明朝归去路，","犹隔洞庭秋。"]]}
{"id":"07cc248bc4","title":"寒食夜","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满地梨花白，","风吹碎月明。","大家寒食夜，","独贮望乡情。"],"stanzas":[["满地梨花白，","风吹碎月明。"],["大家寒食夜，","独贮望乡情。"]]}
{"id":"2bf4cec0a4","title":"归燕","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海燕频来去，","西人独滞留。","天边又相送，","肠断故园秋。"],"stanzas":[["海燕频来去，","西人独滞留。"],["天边又相送，","肠断故园秋。"]]}
{"id":"4c60023373","title":"长安春","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珠箔映高柳，","美人红袖垂。","忽闻半天语，","不见上楼时。"],"stanzas":[["珠箔映高柳，","美人红袖垂。"],["忽闻半天语，","不见上楼时。"]]}
{"id":"050e1089bb","title":"銮驾东回","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两川花捧御衣香，","万岁山呼辇路长。","天子还从马嵬过，","别无惆怅似明皇。"],"stanzas":[["两川花捧御衣香，","万岁山呼辇路长。"],["天子还从马嵬过，","别无惆怅似明皇。"]]}
{"id":"7d355e869a","title":"钓鱼","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲钓江鱼不钓名，","瓦瓯斟酒暮山青。","醉头倒向芦花里，","却笑无端犯客星。"],"stanzas":[["闲钓江鱼不钓名，","瓦瓯斟酒暮山青。"],["醉头倒向芦花里，","却笑无端犯客星。"]]}
{"id":"490e353ee6","title":"西施","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苎萝山下如花女，","占得姑苏台上春。","一笑不能亡敌国，","五湖何处有功臣。"],"stanzas":[["苎萝山下如花女，","占得姑苏台上春。"],["一笑不能亡敌国，","五湖何处有功臣。"]]}
{"id":"f50bade23d","title":"马嵬","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万乘凄凉蜀路归，","眼前珠翠与心违。","重华不是风流主，","湘水犹传泣二妃。"],"stanzas":[["万乘凄凉蜀路归，","眼前珠翠与心违。"],["重华不是风流主，","湘水犹传泣二妃。"]]}
{"id":"91fdac8a16","title":"羯鼓","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华清宫里打撩声，","供奉丝簧束手听。","寂莫銮舆斜谷里，","是谁翻得雨淋铃。"],"stanzas":[["华清宫里打撩声，","供奉丝簧束手听。"],["寂莫銮舆斜谷里，","是谁翻得雨淋铃。"]]}
{"id":"06935c9cf0","title":"寄李左司","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柏台兰省共清风，","鸣玉朝联夜被同。","肯信人间有兄弟，","一生长在别离中。"],"stanzas":[["柏台兰省共清风，","鸣玉朝联夜被同。"],["肯信人间有兄弟，","一生长在别离中。"]]}
{"id":"7f5a59ac8c","title":"梅","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溪上寒梅初满枝，","夜来霜月透芳菲。","清光寂莫思无尽，","应待琴尊与解围。"],"stanzas":[["溪上寒梅初满枝，","夜来霜月透芳菲。"],["清光寂莫思无尽，","应待琴尊与解围。"]]}
{"id":"cad12a1485","title":"天台陈逸人","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绝粒空山秋复春，","欲看沧海化成尘。","近抛三井更深去，","不怕虎狼唯怕人。"],"stanzas":[["绝粒空山秋复春，","欲看沧海化成尘。"],["近抛三井更深去，","不怕虎狼唯怕人。"]]}
{"id":"7de83d7a8a","title":"雪窦禅师","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪窦峰前一派悬，","雪窦五月无炎天。","客尘半日洗欲尽，","师到白头林下禅。"],"stanzas":[["雪窦峰前一派悬，","雪窦五月无炎天。"],["客尘半日洗欲尽，","师到白头林下禅。"]]}
{"id":"c4c090252a","title":"溪上遇雨二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回塘雨脚如缲丝，","野禽不起沈鱼飞。","耕蓑钓笠取未暇，","秋田有望从淋漓。"],"stanzas":[["回塘雨脚如缲丝，","野禽不起沈鱼飞。"],["耕蓑钓笠取未暇，","秋田有望从淋漓。"]]}
{"id":"8cc1cf8162","title":"溪上遇雨二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坐看黑云衔猛雨，","喷洒前山此独晴。","忽惊云雨在头上，","却是山前晚照明。"],"stanzas":[["坐看黑云衔猛雨，","喷洒前山此独晴。"],["忽惊云雨在头上，","却是山前晚照明。"]]}
{"id":"af26d0e0af","title":"长门怨","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长门花泣一枝春，","争奈君恩别处新。","错把黄金买词赋，","相如自是薄情人。"],"stanzas":[["长门花泣一枝春，","争奈君恩别处新。"],["错把黄金买词赋，","相如自是薄情人。"]]}
{"id":"ad7bdae8a2","title":"秋夕","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自怜三十未西游，","傍山寻水过却秋。","一夜雨声多少事，","不思量尽到心头。"],"stanzas":[["自怜三十未西游，","傍山寻水过却秋。"],["一夜雨声多少事，","不思量尽到心头。"]]}
{"id":"4b58836753","title":"过隆中","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玄德苍黄起卧龙，","鼎分天下一言中。","可怜蜀国关张后，","不见商量徐庶功。"],"stanzas":[["玄德苍黄起卧龙，","鼎分天下一言中。"],["可怜蜀国关张后，","不见商量徐庶功。"]]}
{"id":"c267f5b243","title":"关下","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百二山河壮帝畿，","关门何事更开迟。","应从漏却田文后，","每度闻鸡不免疑。"],"stanzas":[["百二山河壮帝畿，","关门何事更开迟。"],["应从漏却田文后，","每度闻鸡不免疑。"]]}
{"id":"8f3f34c392","title":"寒食客中有怀","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江上闻莺禁火时，","百花开尽柳依依。","故园兄弟别来久，","应到清明犹望归。"],"stanzas":[["江上闻莺禁火时，","百花开尽柳依依。"],["故园兄弟别来久，","应到清明犹望归。"]]}
{"id":"bfeb5f0e5a","title":"溪夜","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["积雪消来溪水宽，","满楼明月碎琅玕。","渔人抛得钓筒尽，","却放轻舟下急滩。"],"stanzas":[["积雪消来溪水宽，","满楼明月碎琅玕。"],["渔人抛得钓筒尽，","却放轻舟下急滩。"]]}
{"id":"2905dc97b1","title":"山居卧疾广利大师见访","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桐谷孙枝已上弦，","野人犹卧白云边。","九天飞锡应相诮，","三到行朝二十年。"],"stanzas":[["桐谷孙枝已上弦，","野人犹卧白云边。"],["九天飞锡应相诮，","三到行朝二十年。"]]}
{"id":"dee5523df2","title":"村墅","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正月二月村墅闲，","余粮未乏人心宽。","南邻雨中揭屋笑，","酒熟数家来相看。"],"stanzas":[["正月二月村墅闲，","余粮未乏人心宽。"],["南邻雨中揭屋笑，","酒熟数家来相看。"]]}
{"id":"7422d433a0","title":"悲李拾遗二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故友从来匪石心，","谏多难得主恩深。","行朝半夜烟尘起，","晓殿吁嗟一镜沈。"],"stanzas":[["故友从来匪石心，","谏多难得主恩深。"],["行朝半夜烟尘起，","晓殿吁嗟一镜沈。"]]}
{"id":"2213a2070e","title":"悲李拾遗二首 二","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天涯时有北来尘，","因话它人及故人。","也是先皇能罪己，","殿前频得触龙鳞。"],"stanzas":[["天涯时有北来尘，","因话它人及故人。"],["也是先皇能罪己，","殿前频得触龙鳞。"]]}
{"id":"c2c4d70d9a","title":"题李将军传","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猨臂将军去似飞，","弯弓百步虏无遗。","汉文自与封侯得，","何必伤嗟不遇时。"],"stanzas":[["猨臂将军去似飞，","弯弓百步虏无遗。"],["汉文自与封侯得，","何必伤嗟不遇时。"]]}
{"id":"976590527b","title":"酒醒","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒醒拨剔残灰火，","多少凄凉在此中。","炉畔自斟还自醉，","打窗深夜雪兼风。"],"stanzas":[["酒醒拨剔残灰火，","多少凄凉在此中。"],["炉畔自斟还自醉，","打窗深夜雪兼风。"]]}
{"id":"2472b8c938","title":"郊居友人相访","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柴门深掩古城秋，","背郭缘溪一径幽。","不有小园新竹色，","君来那肯暂淹留。"],"stanzas":[["柴门深掩古城秋，","背郭缘溪一径幽。"],["不有小园新竹色，","君来那肯暂淹留。"]]}
{"id":"14052bb30e","title":"镜湖雪霁贻方干","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天外晓岚和雪望，","月中归棹带冰行。","相逢半醉吟诗苦，","应抵寒猨褭树声。"],"stanzas":[["天外晓岚和雪望，","月中归棹带冰行。"],["相逢半醉吟诗苦，","应抵寒猨褭树声。"]]}
{"id":"c91c9ef29d","title":"秋霁","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨霁长空荡涤清，","远山初出未知名。","夜来江上如钩月，","时有惊鱼掷浪声。"],"stanzas":[["雨霁长空荡涤清，","远山初出未知名。"],["夜来江上如钩月，","时有惊鱼掷浪声。"]]}
{"id":"070363de3e","title":"谢朱常侍寄贶蜀茶剡纸二首 一","author":"崔道融","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瑟瑟香尘瑟瑟泉，","惊风骤雨起炉烟。","一瓯解却山中醉，","便觉身轻欲上天。"],"stanzas":[["瑟瑟香尘瑟瑟泉，","惊风骤雨起炉烟。"],["一瓯解却山中醉，","便觉身轻欲上天。"]]}
