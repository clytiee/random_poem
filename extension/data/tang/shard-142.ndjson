{"id":"3de8dd6348","title":"山阳燕中郊乐录","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["淮上能无雨，","回头总是情。","蒲帆浑未织，","争得一欢成。"],"stanzas":[["淮上能无雨，","回头总是情。"],["蒲帆浑未织，","争得一欢成。"]]}
{"id":"b5c5897532","title":"偶作","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["双眉初出茧，","两鬓正藏鸦。","自有王昌在，","何劳近宋家。"],"stanzas":[["双眉初出茧，","两鬓正藏鸦。"],["自有王昌在，","何劳近宋家。"]]}
{"id":"f65c6111d9","title":"有示","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相对莫辞贫，","蓬蒿任塞门。","无情是金玉，","不报主人恩。"],"stanzas":[["相对莫辞贫，","蓬蒿任塞门。"],["无情是金玉，","不报主人恩。"]]}
{"id":"50d77f8d81","title":"秋思三首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桐露珪初落，","兰风佩欲衰。","不知能赋客，","何似枉刀儿。"],"stanzas":[["桐露珪初落，","兰风佩欲衰。"],["不知能赋客，","何似枉刀儿。"]]}
{"id":"0131d9f8ea","title":"秋思三首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁在嫖姚幕，","能教霹雳车。","至今思秃尾，","无以代寒葅。"],"stanzas":[["谁在嫖姚幕，","能教霹雳车。"],["至今思秃尾，","无以代寒葅。"]]}
{"id":"98696587fb","title":"秋思三首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未得同虀杵，","何时减药囊。","莫言天帝醉，","秦暴不灵长。"],"stanzas":[["未得同虀杵，","何时减药囊。"],["莫言天帝醉，","秦暴不灵长。"]]}
{"id":"e15c9b579a","title":"早春","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨冷唯添暑，","烟初不著春。","数枝花颣小，","愁杀扈芳人。"],"stanzas":[["雨冷唯添暑，","烟初不著春。"],["数枝花颣小，","愁杀扈芳人。"]]}
{"id":"df52bb1c40","title":"怀仙三首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻道阳都女，","连娟耳细长。","自非黄犊客，","不得到云房。"],"stanzas":[["闻道阳都女，","连娟耳细长。"],["自非黄犊客，","不得到云房。"]]}
{"id":"3567a7fe83","title":"怀仙三首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但服镮刚子，","兼吟曲素词。","须知臣汉客，","还见布龙儿。"],"stanzas":[["但服镮刚子，","兼吟曲素词。"],["须知臣汉客，","还见布龙儿。"]]}
{"id":"7a5ba6ac3e","title":"怀仙三首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["神烛光华丽，","灵祛羽翼生。","已传餐玉粒，","犹自买云英。"],"stanzas":[["神烛光华丽，","灵祛羽翼生。"],["已传餐玉粒，","犹自买云英。"]]}
{"id":"da004cdc76","title":"芙蓉","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲吟鲍照赋，","更起屈平愁。","莫引西风动，","红衣不耐秋。"],"stanzas":[["闲吟鲍照赋，","更起屈平愁。"],["莫引西风动，","红衣不耐秋。"]]}
{"id":"8de2982d45","title":"春思","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["怨莺新语涩，","双蝶鬬飞高。","作个名春恨，","浮生百倍劳。"],"stanzas":[["怨莺新语涩，","双蝶鬬飞高。"],["作个名春恨，","浮生百倍劳。"]]}
{"id":"ae96513297","title":"风人诗四首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十万全师出，","遥知正忆君。","一心如瑞麦，","长作两岐分。"],"stanzas":[["十万全师出，","遥知正忆君。"],["一心如瑞麦，","长作两岐分。"]]}
{"id":"13e9aaaaca","title":"风人诗四首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["破檗供朝爨，","须怜是苦辛。","晓天窥落宿，","谁识独醒人。"],"stanzas":[["破檗供朝爨，","须怜是苦辛。"],["晓天窥落宿，","谁识独醒人。"]]}
{"id":"fbc571817a","title":"风人诗四首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旦日思双屦，","明时愿早谐。","丹青传四渎，","难写是秋怀。"],"stanzas":[["旦日思双屦，","明时愿早谐。"],["丹青传四渎，","难写是秋怀。"]]}
{"id":"dfbf78a7b2","title":"风人诗四首 四","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻道更新帜，","多应废旧旗。","征衣无伴捣，","独处自然悲。"],"stanzas":[["闻道更新帜，","多应废旧旗。"],["征衣无伴捣，","独处自然悲。"]]}
{"id":"f96637864a","title":"乐府杂咏六首 双吹管","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长短裁浮筠，","参差作飞凤。","高楼微月夜，","吹出江南弄。"],"stanzas":[["长短裁浮筠，","参差作飞凤。"],["高楼微月夜，","吹出江南弄。"]]}
{"id":"2ad54a4454","title":"乐府杂咏六首 东飞凫","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["裁得尺锦书，","欲寄东飞凫。","胫短翅亦短，","雌雄恋菰蒲。"],"stanzas":[["裁得尺锦书，","欲寄东飞凫。"],["胫短翅亦短，","雌雄恋菰蒲。"]]}
{"id":"2fad77ee35","title":"乐府杂咏六首 花成子","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风等君意，","亦解欺桃李。","写得去时真，","归来不相似。"],"stanzas":[["春风等君意，","亦解欺桃李。"],["写得去时真，","归来不相似。"]]}
{"id":"51fb3ad1b6","title":"乐府杂咏六首 月成弦","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤光照还没，","转益伤离别。","妾若是嫦娥，","长圆不教缺。"],"stanzas":[["孤光照还没，","转益伤离别。"],["妾若是嫦娥，","长圆不教缺。"]]}
{"id":"acba360d11","title":"乐府杂咏六首 孤烛怨","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前回边使至，","闻道交河战。","坐想鼓鞞声，","寸心攒百箭。"],"stanzas":[["前回边使至，","闻道交河战。"],["坐想鼓鞞声，","寸心攒百箭。"]]}
{"id":"662666982e","title":"乐府杂咏六首 金吾子","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嫁得金吾子，","常闻轻薄名。","君心如不重，","妾腰徒自轻。"],"stanzas":[["嫁得金吾子，","常闻轻薄名。"],["君心如不重，","妾腰徒自轻。"]]}
{"id":"3849384d14","title":"子夜四时歌 春","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山连翠羽屏，","草接烟华席。","望尽南飞燕，","佳人断消息。"],"stanzas":[["山连翠羽屏，","草接烟华席。"],["望尽南飞燕，","佳人断消息。"]]}
{"id":"ea266ef79d","title":"子夜四时歌 夏","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兰眼抬路斜，","莺唇映花老。","金龙倾漏尽，","玉井敲冰早。"],"stanzas":[["兰眼抬路斜，","莺唇映花老。"],["金龙倾漏尽，","玉井敲冰早。"]]}
{"id":"f37a70e7d5","title":"子夜四时歌 秋","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凉汉清泬寥，","衰林怨风雨。","愁听络纬唱，","似与羁魂语。"],"stanzas":[["凉汉清泬寥，","衰林怨风雨。"],["愁听络纬唱，","似与羁魂语。"]]}
{"id":"7e16365e44","title":"子夜四时歌 冬","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南云走冷圭，","北籁号空木。","年年任霜霰，","不减筼筜绿。"],"stanzas":[["南云走冷圭，","北籁号空木。"],["年年任霜霰，","不减筼筜绿。"]]}
{"id":"c6d5584e8a","title":"大子夜歌二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌谣数百种，","子夜最可怜。","慷慨吐清音，","明转出天然。"],"stanzas":[["歌谣数百种，","子夜最可怜。"],["慷慨吐清音，","明转出天然。"]]}
{"id":"bfec926a05","title":"大子夜歌二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丝竹发歌响，","假器扬清音。","不知歌谣妙，","声势出口心。"],"stanzas":[["丝竹发歌响，","假器扬清音。"],["不知歌谣妙，","声势出口心。"]]}
{"id":"ee35f54f41","title":"子夜警歌二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["镂椀传绿酒，","雕𬬻薰紫烟。","谁知苦寒调，","共作白雪弦。"],"stanzas":[["镂椀传绿酒，","雕𬬻薰紫烟。"],["谁知苦寒调，","共作白雪弦。"]]}
{"id":"9de998463f","title":"子夜警歌二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恃爱如欲进，","含羞出不前。","朱口发艳歌，","玉指弄娇弦。"],"stanzas":[["恃爱如欲进，","含羞出不前。"],["朱口发艳歌，","玉指弄娇弦。"]]}
{"id":"c1dc4219f4","title":"子夜变歌三首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人传欢负情，","我自未尝见。","三更开门去，","始知子夜变。"],"stanzas":[["人传欢负情，","我自未尝见。"],["三更开门去，","始知子夜变。"]]}
{"id":"0014300604","title":"子夜变歌三首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岁月如流迈，","春尽秋已至。","荧荧条上花，","零落何乃驶。"],"stanzas":[["岁月如流迈，","春尽秋已至。"],["荧荧条上花，","零落何乃驶。"]]}
{"id":"e7a8086414","title":"子夜变歌三首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岁月如流迈，","行已及素秋。","蟋蟀吟堂前，","惆怅使侬愁。"],"stanzas":[["岁月如流迈，","行已及素秋。"],["蟋蟀吟堂前，","惆怅使侬愁。"]]}
{"id":"4da367369b","title":"江南曲五首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼戏莲叶间，","参差隐叶扇。","䴔䴖𪈺鳿窥，","潋滟无因见。"],"stanzas":[["鱼戏莲叶间，","参差隐叶扇。"],["䴔䴖𪈺鳿窥，","潋滟无因见。"]]}
{"id":"2e35419160","title":"江南曲五首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼戏莲叶东，","初霞射红尾。","傍临谢山侧，","恰值清风起。"],"stanzas":[["鱼戏莲叶东，","初霞射红尾。"],["傍临谢山侧，","恰值清风起。"]]}
{"id":"201e50cd9d","title":"江南曲五首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼戏莲叶西，","盘盘舞波急。","潜依曲岸凉，","正直斜光入。"],"stanzas":[["鱼戏莲叶西，","盘盘舞波急。"],["潜依曲岸凉，","正直斜光入。"]]}
{"id":"dac9aef5bc","title":"江南曲五首 四","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼戏莲叶南，","欹危舞烟叠。","光摇越鸟巢，","影乱吴娃檝。"],"stanzas":[["鱼戏莲叶南，","欹危舞烟叠。"],["光摇越鸟巢，","影乱吴娃檝。"]]}
{"id":"9dee0bad23","title":"江南曲五首 五","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼戏莲叶北，","澄阳动微涟。","回看帝子渚，","稍背鄂君船。"],"stanzas":[["鱼戏莲叶北，","澄阳动微涟。"],["回看帝子渚，","稍背鄂君船。"]]}
{"id":"d65d316caf","title":"陌上桑","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皓齿还如贝色含，","长眉亦似烟华贴。","邻娃尽著绣裆襦，","独自提筐采蚕叶。"],"stanzas":[["皓齿还如贝色含，","长眉亦似烟华贴。"],["邻娃尽著绣裆襦，","独自提筐采蚕叶。"]]}
{"id":"b5d7c769fb","title":"自遣诗三十首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五年重别旧山村，","树有交柯犊有孙。","更感卞峰颜色好，","晓云才散便当门。"],"stanzas":[["五年重别旧山村，","树有交柯犊有孙。"],["更感卞峰颜色好，","晓云才散便当门。"]]}
{"id":"bed917d956","title":"自遣诗三十首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪下孤村淅淅鸣，","病魂无睡洒来清。","心摇秖待东窗晓，","长媿寒鸡第一声。"],"stanzas":[["雪下孤村淅淅鸣，","病魂无睡洒来清。"],["心摇秖待东窗晓，","长媿寒鸡第一声。"]]}
{"id":"cafe62fcdd","title":"自遣诗三十首 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["多情多感自难忘，","秖有风流共古长。","座上不遗金带枕，","陈王词赋为谁伤。"],"stanzas":[["多情多感自难忘，","秖有风流共古长。"],["座上不遗金带枕，","陈王词赋为谁伤。"]]}
{"id":"74a40fbe04","title":"自遣诗三十首 四","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["甫里先生未白头，","酒旗犹可战高楼。","长鲸好鲙无因得，","乞取艅艎作钓舟。"],"stanzas":[["甫里先生未白头，","酒旗犹可战高楼。"],["长鲸好鲙无因得，","乞取艅艎作钓舟。"]]}
{"id":"a3b6e6fc07","title":"自遣诗三十首 五","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花濑蒙蒙紫气昏，","水边山曲更深村。","终须拣取幽栖处，","老桧成双便作门。"],"stanzas":[["花濑蒙蒙紫气昏，","水边山曲更深村。"],["终须拣取幽栖处，","老桧成双便作门。"]]}
{"id":"60c8e611b2","title":"自遣诗三十首 六","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阴洞曾为采药行，","冷云凝绝烛微明。","玉芝敲折琤然堕，","合有真人上姓名。"],"stanzas":[["阴洞曾为采药行，","冷云凝绝烛微明。"],["玉芝敲折琤然堕，","合有真人上姓名。"]]}
{"id":"791263e51e","title":"自遣诗三十首 七","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长叹人间髪易华，","暗将心事许烟霞。","病来前约分明在，","药鼎书囊便是家。"],"stanzas":[["长叹人间髪易华，","暗将心事许烟霞。"],["病来前约分明在，","药鼎书囊便是家。"]]}
{"id":"5aadb4ed6e","title":"自遣诗三十首 八","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酝得秋泉似玉容，","比于云液更应浓。","思量北海徐刘辈，","枉向人间号酒龙。"],"stanzas":[["酝得秋泉似玉容，","比于云液更应浓。"],["思量北海徐刘辈，","枉向人间号酒龙。"]]}
{"id":"5bee3e24d5","title":"自遣诗三十首 九","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["羊侃多应自古豪，","解盘金矟置纤腰。","纵然此事教双得，","不博溪田二顷苗。"],"stanzas":[["羊侃多应自古豪，","解盘金矟置纤腰。"],["纵然此事教双得，","不博溪田二顷苗。"]]}
{"id":"99d1718241","title":"自遣诗三十首 十","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶然携稚看微波，","临水春寒一倍多。","便使笔精如逸少，","嬾能书字换群鹅。"],"stanzas":[["偶然携稚看微波，","临水春寒一倍多。"],["便使笔精如逸少，","嬾能书字换群鹅。"]]}
{"id":"b69a2f2fb6","title":"自遣诗三十首 十一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔闻庄叟迢迢梦，","又道韩生苒苒飞。","知有姓名聊寄问，","更无言语抱斜晖。"],"stanzas":[["昔闻庄叟迢迢梦，","又道韩生苒苒飞。"],["知有姓名聊寄问，","更无言语抱斜晖。"]]}
{"id":"35059d07e4","title":"自遣诗三十首 十二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪侵春事太无端，","舞急微还近腊寒。","应是也疑真宰怪，","休时犹未徧林峦。"],"stanzas":[["雪侵春事太无端，","舞急微还近腊寒。"],["应是也疑真宰怪，","休时犹未徧林峦。"]]}
{"id":"de15790222","title":"自遣诗三十首 十三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数尺游丝堕碧空，","年年长是惹东风。","争知天上无人住，","亦有春愁鹤髪翁。"],"stanzas":[["数尺游丝堕碧空，","年年长是惹东风。"],["争知天上无人住，","亦有春愁鹤髪翁。"]]}
{"id":"5a102edb04","title":"自遣诗三十首 十四","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁使寒鸦意绪娇，","云情山晚动情憀。","乱和残照纷纷舞，","应索阳乌次第饶。"],"stanzas":[["谁使寒鸦意绪娇，","云情山晚动情憀。"],["乱和残照纷纷舞，","应索阳乌次第饶。"]]}
{"id":"2137fa85f8","title":"自遣诗三十首 十五","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古往天高事渺茫，","争知灵媛不凄凉。","月娥如有相思泪，","秖待方诸寄两行。"],"stanzas":[["古往天高事渺茫，","争知灵媛不凄凉。"],["月娥如有相思泪，","秖待方诸寄两行。"]]}
{"id":"9c05742a84","title":"自遣诗三十首 十六","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["本来云外寄闲身，","遂与溪云作主人。","一夜逆风愁四散，","晓来零落傍衣巾。"],"stanzas":[["本来云外寄闲身，","遂与溪云作主人。"],["一夜逆风愁四散，","晓来零落傍衣巾。"]]}
{"id":"dbc076b8c8","title":"自遣诗三十首 十七","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渊明不待公田熟，","乘兴先秋解印归。","我为余粮春未去，","到头谁是复谁非。"],"stanzas":[["渊明不待公田熟，","乘兴先秋解印归。"],["我为余粮春未去，","到头谁是复谁非。"]]}
{"id":"1b0bd62366","title":"自遣诗三十首 十八","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云拥根株抱石危，","斲来文似瘦蛟螭。","幽人带病慵朝起，","秖向春山尽日欹。"],"stanzas":[["云拥根株抱石危，","斲来文似瘦蛟螭。"],["幽人带病慵朝起，","秖向春山尽日欹。"]]}
{"id":"b78c8f5529","title":"自遣诗三十首 十九","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月澹花闲夜已深，","宋家微咏若遗音。","重思万古无人赏，","露湿清香独满襟。"],"stanzas":[["月澹花闲夜已深，","宋家微咏若遗音。"],["重思万古无人赏，","露湿清香独满襟。"]]}
{"id":"91ada8a0fd","title":"自遣诗三十首 二十","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南岸春田手自农，","往来横截半江风。","有时不耐轻桡兴，","暂欲蓬山访洛公。"],"stanzas":[["南岸春田手自农，","往来横截半江风。"],["有时不耐轻桡兴，","暂欲蓬山访洛公。"]]}
{"id":"d0bbcc636c","title":"自遣诗三十首 二十一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贤达垂竿小隐中，","我来真作捕鱼翁。","前溪一夜春流急，","已学严滩下钓筒。"],"stanzas":[["贤达垂竿小隐中，","我来真作捕鱼翁。"],["前溪一夜春流急，","已学严滩下钓筒。"]]}
{"id":"bb5c4c9ab1","title":"自遣诗三十首 二十二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水国君王又姓萧，","风情由是冠南朝。","灵和殿下巴江柳，","十二旒前舞翠条。"],"stanzas":[["水国君王又姓萧，","风情由是冠南朝。"],["灵和殿下巴江柳，","十二旒前舞翠条。"]]}
{"id":"c666d9b4b8","title":"自遣诗三十首 二十三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["强梳蓬鬓整斜冠，","片烛光微夜思阑。","天意最饶惆怅事，","单栖分付与春寒。"],"stanzas":[["强梳蓬鬓整斜冠，","片烛光微夜思阑。"],["天意最饶惆怅事，","单栖分付与春寒。"]]}
{"id":"1657f2cd6c","title":"自遣诗三十首 二十四","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无多药圃近南荣，","合有新苗次第生。","稚子不知名品上，","恐随春草鬬输赢。"],"stanzas":[["无多药圃近南荣，","合有新苗次第生。"],["稚子不知名品上，","恐随春草鬬输赢。"]]}
{"id":"99e8207d3a","title":"自遣诗三十首 二十五","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一派溪随箬下流，","春来无处不汀洲。","漪澜未碧蒲犹短，","不见鸳鸯正自由。"],"stanzas":[["一派溪随箬下流，","春来无处不汀洲。"],["漪澜未碧蒲犹短，","不见鸳鸯正自由。"]]}
{"id":"377ca607b1","title":"自遣诗三十首 二十六","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山下花明水上曛，","一桡青翰破霞文。","越人但爱风流客，","绣被何须属鄂君。"],"stanzas":[["山下花明水上曛，","一桡青翰破霞文。"],["越人但爱风流客，","绣被何须属鄂君。"]]}
{"id":"bd91f9e621","title":"自遣诗三十首 二十七","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妍华须是占时生，","准拟差肩不近情。","佳丽几时腰不细，","荆王辛苦致宫名。"],"stanzas":[["妍华须是占时生，","准拟差肩不近情。"],["佳丽几时腰不细，","荆王辛苦致宫名。"]]}
{"id":"90154d24ec","title":"自遣诗三十首 二十八","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姹女精神似月孤，","敢将容易入洪炉。","人间纵道铅华少，","蝶翅新篁未肯无。"],"stanzas":[["姹女精神似月孤，","敢将容易入洪炉。"],["人间纵道铅华少，","蝶翅新篁未肯无。"]]}
{"id":"9a43fdbdf6","title":"自遣诗三十首 二十九","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贞白求丹变姓名，","主恩潜助亦无成。","侯家竟换梁天子，","王整徒劳作外兵。"],"stanzas":[["贞白求丹变姓名，","主恩潜助亦无成。"],["侯家竟换梁天子，","王整徒劳作外兵。"]]}
{"id":"12ffeb697c","title":"自遣诗三十首 三十","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春雨能膏草木肥，","就中林野碧含滋。","唯余病客相逢背，","一夜寒声减四肢。"],"stanzas":[["春雨能膏草木肥，","就中林野碧含滋。"],["唯余病客相逢背，","一夜寒声减四肢。"]]}
{"id":"dee3f541b6","title":"别墅怀归","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东去沧溟百里余，","沿江潮信到吾庐。","就中家在蓬山下，","一日堪凭两寄书。"],"stanzas":[["东去沧溟百里余，","沿江潮信到吾庐。"],["就中家在蓬山下，","一日堪凭两寄书。"]]}
{"id":"861470fe82","title":"野井","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱阁前头露井多，","碧梧桐下美人过。","寒泉未必能如此，","奈有银缾素绠何。"],"stanzas":[["朱阁前头露井多，","碧梧桐下美人过。"],["寒泉未必能如此，","奈有银缾素绠何。"]]}
{"id":"aadad49a58","title":"南征","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丞相南征定有无，","幕中谁是骋良图。","遥知贼胆纵横破，","绕帐生犀一万株。"],"stanzas":[["丞相南征定有无，","幕中谁是骋良图。"],["遥知贼胆纵横破，","绕帐生犀一万株。"]]}
{"id":"40c4f9d915","title":"北渡","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江客柴门枕浪花，","鸣机寒艣任呕哑。","轻舟过去真堪画，","惊起鸬鹚一阵斜。"],"stanzas":[["江客柴门枕浪花，","鸣机寒艣任呕哑。"],["轻舟过去真堪画，","惊起鸬鹚一阵斜。"]]}
{"id":"bfdeff2467","title":"夜泊咏栖鸿","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可怜霜月暂相依，","莫向衡阳趁逐飞。","同是江南寒夜客，","羽毛单薄稻粱微。"],"stanzas":[["可怜霜月暂相依，","莫向衡阳趁逐飞。"],["同是江南寒夜客，","羽毛单薄稻粱微。"]]}
{"id":"9f073d1846","title":"早行","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水寒孤櫂触天文，","直似乘槎去问津。","纵使碧虚无限好，","客星名字也愁人。"],"stanzas":[["水寒孤櫂触天文，","直似乘槎去问津。"],["纵使碧虚无限好，","客星名字也愁人。"]]}
{"id":"1de4e92df5","title":"木兰堂","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞庭波浪渺无津，","日日征帆送远人。","几度木兰舟上望，","不知元是此花身。"],"stanzas":[["洞庭波浪渺无津，","日日征帆送远人。"],["几度木兰舟上望，","不知元是此花身。"]]}
{"id":"d5ef6ea3bc","title":"和袭美春夕陪崔谏议樱桃园宴","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳人芳树杂春蹊，","花外烟蒙月渐低。","几度艳歌清欲转，","流莺惊起不成栖。"],"stanzas":[["佳人芳树杂春蹊，","花外烟蒙月渐低。"],["几度艳歌清欲转，","流莺惊起不成栖。"]]}
{"id":"a3b0d3df99","title":"和袭美松江早春","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳下江餐待好风，","暂时还得狎渔翁。","一生无事烟波足，","唯有沙边水勃公。"],"stanzas":[["柳下江餐待好风，","暂时还得狎渔翁。"],["一生无事烟波足，","唯有沙边水勃公。"]]}
{"id":"1cd1c79417","title":"和袭美女坟湖","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水平波淡绕回塘，","鹤殉人沈万古伤。","应是离魂双不得，","至今沙上少鸳鸯。"],"stanzas":[["水平波淡绕回塘，","鹤殉人沈万古伤。"],["应是离魂双不得，","至今沙上少鸳鸯。"]]}
{"id":"8debf16986","title":"和袭美泰伯庙","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故国城荒德未荒，","年年椒奠湿中堂。","迩来父子争天下，","不信人间有让王。"],"stanzas":[["故国城荒德未荒，","年年椒奠湿中堂。"],["迩来父子争天下，","不信人间有让王。"]]}
{"id":"b671b0238c","title":"和袭美木兰院次韵","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苦吟清漏迢迢极，","月过花西尚未眠。","犹忆故山欹警枕，","夜来呜咽似流泉。"],"stanzas":[["苦吟清漏迢迢极，","月过花西尚未眠。"],["犹忆故山欹警枕，","夜来呜咽似流泉。"]]}
{"id":"1cafad795a","title":"和袭美重题蔷薇","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秾华自古不得久，","况是倚春春已空。","更被夜来风雨恶，","满阶狼籍没多红。"],"stanzas":[["秾华自古不得久，","况是倚春春已空。"],["更被夜来风雨恶，","满阶狼籍没多红。"]]}
{"id":"9d79f66e71","title":"和袭美春夕酒醒","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几年无事傍江湖，","醉倒黄公旧酒垆。","觉后不知明月上，","满身花影倩人扶。"],"stanzas":[["几年无事傍江湖，","醉倒黄公旧酒垆。"],["觉后不知明月上，","满身花影倩人扶。"]]}
{"id":"358102ba30","title":"和袭美木兰后池三咏 重台莲花","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水国烟乡足芰荷，","就中芳瑞此难过。","风情为与吴王近，","红萼常教一倍多。"],"stanzas":[["水国烟乡足芰荷，","就中芳瑞此难过。"],["风情为与吴王近，","红萼常教一倍多。"]]}
{"id":"6aafb8cad0","title":"和袭美木兰后池三咏 浮萍","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚来风约半池明，","重叠侵沙绿罽成。","不用临池更相笑，","最无根蔕是浮名。"],"stanzas":[["晚来风约半池明，","重叠侵沙绿罽成。"],["不用临池更相笑，","最无根蔕是浮名。"]]}
{"id":"8c256c8ab3","title":"和袭美木兰后池三咏 白莲","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["素蘤多蒙别艳欺，","此花真合在瑶池。","还应有恨无人觉，","月晓风清欲堕时。"],"stanzas":[["素蘤多蒙别艳欺，","此花真合在瑶池。"],["还应有恨无人觉，","月晓风清欲堕时。"]]}
{"id":"e990ad516e","title":"和袭美重题后池","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓烟清露暗相和，","浴雁浮鸥意绪多。","却是陈王词赋错，","枉将心事托微波。"],"stanzas":[["晓烟清露暗相和，","浴雁浮鸥意绪多。"],["却是陈王词赋错，","枉将心事托微波。"]]}
{"id":"d9e93da1a5","title":"和胥门闲泛","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细桨轻撶下白苹，","故城花谢绿阴新。","岂无今日逃名士，","试问南塘著屧人。"],"stanzas":[["细桨轻撶下白苹，","故城花谢绿阴新。"],["岂无今日逃名士，","试问南塘著屧人。"]]}
{"id":"323868d0ee","title":"袭美初植松桂偶题","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轩阴冉冉移斜日，","寒韵泠泠入晚风。","烟格月姿曾不改，","至今犹似在山中。"],"stanzas":[["轩阴冉冉移斜日，","寒韵泠泠入晚风。"],["烟格月姿曾不改，","至今犹似在山中。"]]}
{"id":"3a81961e8a","title":"和袭美馆娃宫怀古五绝 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三千虽衣水犀珠，","半夜夫差国暗屠。","犹有八人皆二八，","独教西子占亡吴。"],"stanzas":[["三千虽衣水犀珠，","半夜夫差国暗屠。"],["犹有八人皆二八，","独教西子占亡吴。"]]}
{"id":"bd9d3deb51","title":"和袭美馆娃宫怀古五绝 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一宫花渚漾涟漪，","俀堕鸦鬟出茧眉。","可料座中歌舞袖，","便将残节拂降旗。"],"stanzas":[["一宫花渚漾涟漪，","俀堕鸦鬟出茧眉。"],["可料座中歌舞袖，","便将残节拂降旗。"]]}
{"id":"311e496884","title":"和袭美馆娃宫怀古五绝 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几多云榭倚青冥，","越燄烧来一片平。","此地最应沾恨血，","至今春草不匀生。"],"stanzas":[["几多云榭倚青冥，","越燄烧来一片平。"],["此地最应沾恨血，","至今春草不匀生。"]]}
{"id":"b57ff3ee04","title":"和袭美馆娃宫怀古五绝 四","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江色分明练绕台，","战帆遥隔绮疏开。","波神自厌荒淫主，","句践楼船稳帖来。"],"stanzas":[["江色分明练绕台，","战帆遥隔绮疏开。"],["波神自厌荒淫主，","句践楼船稳帖来。"]]}
{"id":"90ca632e20","title":"和袭美馆娃宫怀古五绝 五","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝袜香綦碎晓尘，","乱兵谁惜似花人。","伯劳应是精灵使，","犹向残阳泣暮春。"],"stanzas":[["宝袜香綦碎晓尘，","乱兵谁惜似花人。"],["伯劳应是精灵使，","犹向残阳泣暮春。"]]}
{"id":"a752e5f58f","title":"和袭美虎丘寺西小溪闲泛三绝 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["树号相思枝拂地，","鸟语提壶声满溪。","云涯一里千万曲，","直是渔翁行也迷。"],"stanzas":[["树号相思枝拂地，","鸟语提壶声满溪。"],["云涯一里千万曲，","直是渔翁行也迷。"]]}
{"id":"cb3dc147d7","title":"和袭美虎丘寺西小溪闲泛三绝 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荒柳卧波浑似困，","宿云遮坞未全痴。","云情柳意萧萧会，","若问诸余总不知。"],"stanzas":[["荒柳卧波浑似困，","宿云遮坞未全痴。"],["云情柳意萧萧会，","若问诸余总不知。"]]}
{"id":"c3a12839c5","title":"和袭美虎丘寺西小溪闲泛三绝 三","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["每逢孤屿一倚檝，","便欲狂歌同采薇。","任是烟萝中待月，","不妨欹枕扣舷归。"],"stanzas":[["每逢孤屿一倚檝，","便欲狂歌同采薇。"],["任是烟萝中待月，","不妨欹枕扣舷归。"]]}
{"id":"2d0c5f1fa3","title":"和袭美天竺寺八月十五夜桂子","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霜实常闻秋半夜，","天台天竺堕云岑。","如何两地无人种，","却是湘漓是桂林。"],"stanzas":[["霜实常闻秋半夜，","天台天竺堕云岑。"],["如何两地无人种，","却是湘漓是桂林。"]]}
{"id":"ab07fd74a8","title":"戏题袭美书印囊","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹊衔龟顾妙无余，","不爱封侯爱石渠。","应笑休文过万卷，","至今谁道沈家书。"],"stanzas":[["鹊衔龟顾妙无余，","不爱封侯爱石渠。"],["应笑休文过万卷，","至今谁道沈家书。"]]}
{"id":"b34ebceb06","title":"和袭美钓侣二章 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一艇轻撶看晓涛，","接䍠抛下漉春醪。","相逢便倚蒹葭泊，","更唱菱歌擘蟹螯。"],"stanzas":[["一艇轻撶看晓涛，","接䍠抛下漉春醪。"],["相逢便倚蒹葭泊，","更唱菱歌擘蟹螯。"]]}
{"id":"84908b0594","title":"和袭美钓侣二章 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨后沙虚古岸崩，","鱼梁移入乱云层。","归时月堕汀洲暗，","认得妻儿结网灯。"],"stanzas":[["雨后沙虚古岸崩，","鱼梁移入乱云层。"],["归时月堕汀洲暗，","认得妻儿结网灯。"]]}
{"id":"9cb88078d7","title":"和袭美寄同年韦校书","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万古风烟满故都，","清才搜括妙无余。","可中寄与芸香客，","便是江南地里书。"],"stanzas":[["万古风烟满故都，","清才搜括妙无余。"],["可中寄与芸香客，","便是江南地里书。"]]}
{"id":"07c7ed676c","title":"和袭美初冬偶作","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桐下空阶叠绿钱，","貂裘初绽拥高眠。","小炉低幌还遮掩，","酒滴灰香似去年。"],"stanzas":[["桐下空阶叠绿钱，","貂裘初绽拥高眠。"],["小炉低幌还遮掩，","酒滴灰香似去年。"]]}
{"id":"f0df3f7574","title":"袭美醉中寄一壶并一绝走笔次韵奉酬","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒痕衣上杂莓苔，","犹忆红螺一两杯。","正被绕篱荒菊笑，","日斜还有白衣来。"],"stanzas":[["酒痕衣上杂莓苔，","犹忆红螺一两杯。"],["正被绕篱荒菊笑，","日斜还有白衣来。"]]}
{"id":"9a3e514368","title":"再和次韵","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堦下饥禽啄嫩苔，","野人方倒病中杯。","寒蔬卖却还沽吃，","可有金貂换得来。"],"stanzas":[["堦下饥禽啄嫩苔，","野人方倒病中杯。"],["寒蔬卖却还沽吃，","可有金貂换得来。"]]}
{"id":"0068720425","title":"和袭美重玄寺双矮桧","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可怜烟刺是青螺，","如到双林误礼多。","更忆早秋登北固，","海门苍翠出晴波。"],"stanzas":[["可怜烟刺是青螺，","如到双林误礼多。"],["更忆早秋登北固，","海门苍翠出晴波。"]]}
{"id":"e746eec19a","title":"醉中戏赠袭美","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南北风流旧不同，","伧吴今日若相通。","病来犹伴金杯满，","欲得人呼小褚公。"],"stanzas":[["南北风流旧不同，","伧吴今日若相通。"],["病来犹伴金杯满，","欲得人呼小褚公。"]]}
{"id":"668f6ea720","title":"润卿遗青䭀饭兼之一绝聊用荅谢","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旧闻香积金仙食，","今见青精玉斧餐。","自笑镜中无骨录，","可能飞上紫云端。"],"stanzas":[["旧闻香积金仙食，","今见青精玉斧餐。"],["自笑镜中无骨录，","可能飞上紫云端。"]]}
{"id":"52f55a7225","title":"文䜩招润卿博士辞以道侣将至一绝寄之","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙客何时下鹤翎，","方瞳如水脑华清。","不过传达杨君梦，","从许人间小兆听。"],"stanzas":[["仙客何时下鹤翎，","方瞳如水脑华清。"],["不过传达杨君梦，","从许人间小兆听。"]]}
{"id":"595f0b8725","title":"再招","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["遥知道侣谈玄次，","又是文交丽事时。","虽是寒轻云重日，","也留花簟待徐摛。"],"stanzas":[["遥知道侣谈玄次，","又是文交丽事时。"],["虽是寒轻云重日，","也留花簟待徐摛。"]]}
{"id":"9731de5496","title":"玩金㶉𪆟戏赠袭美","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾向溪边泊暮云，","至今犹忆浪花群。","不知镂羽凝香雾，","堪与鸳鸯觉后闻。"],"stanzas":[["曾向溪边泊暮云，","至今犹忆浪花群。"],["不知镂羽凝香雾，","堪与鸳鸯觉后闻。"]]}
{"id":"575162c860","title":"子规一首","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧竿微露月玲珑，","谢豹伤心独叫风。","高处已应闻滴血，","山榴一夜几枝红。"],"stanzas":[["碧竿微露月玲珑，","谢豹伤心独叫风。"],["高处已应闻滴血，","山榴一夜几枝红。"]]}
{"id":"3626a81a14","title":"寄题天台国清寺齐梁体","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峰带楼台天外立，","明河色近罘罳湿。","松间石上定僧寒，","半夜楢溪水声急。"],"stanzas":[["峰带楼台天外立，","明河色近罘罳湿。"],["松间石上定僧寒，","半夜楢溪水声急。"]]}
{"id":"b1b540ee1a","title":"奉和谏议酬先辈霜菊","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫茎芳艳照西风，","秖怕霜华掠断丛。","争奈病夫难强饮，","应须速自召车公。"],"stanzas":[["紫茎芳艳照西风，","秖怕霜华掠断丛。"],["争奈病夫难强饮，","应须速自召车公。"]]}
{"id":"c9fa14d4a1","title":"和袭美咏臯桥","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["横截春流架断虹，","凭栏犹思五噫风。","今来未必非梁孟，","却是无人断伯通。"],"stanzas":[["横截春流架断虹，","凭栏犹思五噫风。"],["今来未必非梁孟，","却是无人断伯通。"]]}
{"id":"9f5230428c","title":"和袭美悼鹤","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酆都香稻字重思，","遥想飞魂去未饥。","争奈野鸦无数健，","黄昏来占旧栖枝。"],"stanzas":[["酆都香稻字重思，","遥想飞魂去未饥。"],["争奈野鸦无数健，","黄昏来占旧栖枝。"]]}
{"id":"015550c351","title":"和醉中袭美先起次韵","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫唱艳歌凝翠黛，","已通仙籍在金闺。","他时若寄相思泪，","红粉痕应伴紫泥。"],"stanzas":[["莫唱艳歌凝翠黛，","已通仙籍在金闺。"],["他时若寄相思泪，","红粉痕应伴紫泥。"]]}
{"id":"92f7fd96ac","title":"和袭美酒病偶作次韵","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳疎桐下晚窗明，","秖有微风为析酲。","唯欠白绡笼解散，","洛生闲咏两三声。"],"stanzas":[["柳疎桐下晚窗明，","秖有微风为析酲。"],["唯欠白绡笼解散，","洛生闲咏两三声。"]]}
{"id":"59295e5810","title":"忆白菊","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["稚子书传白菊开，","西成相滞未容回。","月明阶下窗纱薄，","多少清香透入来。"],"stanzas":[["稚子书传白菊开，","西成相滞未容回。"],["月明阶下窗纱薄，","多少清香透入来。"]]}
{"id":"db570bfdd9","title":"和同润卿寒夜访袭美各惜其志次韵","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["醉韵飘飘不可亲，","掉头吟侧华阳巾。","如能跂脚南窗下，","便是羲皇世上人。"],"stanzas":[["醉韵飘飘不可亲，","掉头吟侧华阳巾。"],["如能跂脚南窗下，","便是羲皇世上人。"]]}
{"id":"9dda47926b","title":"和袭美寒夜文䜩润卿有期不至","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细雨轻觞玉漏终，","上清词句落吟中。","松斋一夜怀贞白，","霜外空闻五粒风。"],"stanzas":[["细雨轻觞玉漏终，","上清词句落吟中。"],["松斋一夜怀贞白，","霜外空闻五粒风。"]]}
{"id":"b8e6bd75f1","title":"移石盆","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["移得龙泓潋滟寒，","月轮初下白云端。","无人尽日澄心坐，","倒影新篁一两竿。"],"stanzas":[["移得龙泓潋滟寒，","月轮初下白云端。"],["无人尽日澄心坐，","倒影新篁一两竿。"]]}
{"id":"8c47526a9d","title":"石竹花咏","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾看南朝画国娃，","古萝衣上碎明霞。","而今莫共金钱鬬，","买却春风是此花。"],"stanzas":[["曾看南朝画国娃，","古萝衣上碎明霞。"],["而今莫共金钱鬬，","买却春风是此花。"]]}
{"id":"92ab848563","title":"和袭美友人许惠酒以诗征之","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冻醪初漉嫩如春，","轻蚁漂漂杂蘂尘。","得伴方平同一醉，","明朝应作蔡经身。"],"stanzas":[["冻醪初漉嫩如春，","轻蚁漂漂杂蘂尘。"],["得伴方平同一醉，","明朝应作蔡经身。"]]}
{"id":"88487ab282","title":"闻圆载上人挟儒书洎释典归日本国更作一绝以送","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九流三藏一时倾，","万轴光凌渤澥声。","从此遗编东去后，","却应荒外有诸生。"],"stanzas":[["九流三藏一时倾，","万轴光凌渤澥声。"],["从此遗编东去后，","却应荒外有诸生。"]]}
{"id":"b934b9cef3","title":"闲吟","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲吟料得三更尽，","始把孤灯背竹窗。","一夜西风高浪起，","不教归梦过寒江。"],"stanzas":[["闲吟料得三更尽，","始把孤灯背竹窗。"],["一夜西风高浪起，","不教归梦过寒江。"]]}
{"id":"15b3536b61","title":"秘色越器","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九秋风露越窑开，","夺得千峰翠色来。","好向中宵盛沆瀣，","共嵇中散鬬遗杯。"],"stanzas":[["九秋风露越窑开，","夺得千峰翠色来。"],["好向中宵盛沆瀣，","共嵇中散鬬遗杯。"]]}
{"id":"ad9fd286ab","title":"景阳宫井","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古堞烟埋宫井树，","陈主吴姬堕泉处。","舜没苍梧万里云，","却不闻将二妃去。"],"stanzas":[["古堞烟埋宫井树，","陈主吴姬堕泉处。"],["舜没苍梧万里云，","却不闻将二妃去。"]]}
{"id":"4bff45cadb","title":"江南二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["便风船尾香秔熟，","细雨层头赤鲤跳。","待得江餐闲望足，","日斜方动木兰桡。"],"stanzas":[["便风船尾香秔熟，","细雨层头赤鲤跳。"],["待得江餐闲望足，","日斜方动木兰桡。"]]}
{"id":"4b3a256dc3","title":"江南二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["村边紫豆花垂次，","岸上红梨叶战初。","莫怪烟中重回首，","酒家青纻一行书。"],"stanzas":[["村边紫豆花垂次，","岸上红梨叶战初。"],["莫怪烟中重回首，","酒家青纻一行书。"]]}
{"id":"88ea15a73b","title":"溪思雨中","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨映前山万絇丝，","樐声冲破似鸣机。","无端织得愁成段，","堪作骚人酒病衣。"],"stanzas":[["雨映前山万絇丝，","樐声冲破似鸣机。"],["无端织得愁成段，","堪作骚人酒病衣。"]]}
{"id":"22beb80d79","title":"江城夜泊","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["漏移寒箭丁丁急，","月挂虚弓霭霭明。","此夜离魂堪射断，","更须江笛两三声。"],"stanzas":[["漏移寒箭丁丁急，","月挂虚弓霭霭明。"],["此夜离魂堪射断，","更须江笛两三声。"]]}
{"id":"4ef15b4455","title":"宫人斜","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["草著愁烟似不春，","晚莺哀怨问行人。","须知一种埋香骨，","犹胜昭君作虏尘。"],"stanzas":[["草著愁烟似不春，","晚莺哀怨问行人。"],["须知一种埋香骨，","犹胜昭君作虏尘。"]]}
{"id":"7cc3821d68","title":"送棋客","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满目山川似势棋，","况当秋雁正斜飞。","金门若召羊玄保，","赌取江东太守归。"],"stanzas":[["满目山川似势棋，","况当秋雁正斜飞。"],["金门若召羊玄保，","赌取江东太守归。"]]}
{"id":"81776cd54d","title":"汉宫词","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["招灵阁上霓旌绝，","柏梁台中珠翠稠。","一身三十六宫夜，","露滴玉盘青桂秋。"],"stanzas":[["招灵阁上霓旌绝，","柏梁台中珠翠稠。"],["一身三十六宫夜，","露滴玉盘青桂秋。"]]}
{"id":"c83b6a3853","title":"上清","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉林风露寂寥清，","仙妃对月闲吹笙。","新篁冷涩曲未尽，","细拂云枝栖凤惊。"],"stanzas":[["玉林风露寂寥清，","仙妃对月闲吹笙。"],["新篁冷涩曲未尽，","细拂云枝栖凤惊。"]]}
{"id":"a87d44bb38","title":"秋荷","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蒲茸承露有佳色，","茭叶束烟如效颦。","盈盈一水不得渡，","冷翠遗香愁向人。"],"stanzas":[["蒲茸承露有佳色，","茭叶束烟如效颦。"],["盈盈一水不得渡，","冷翠遗香愁向人。"]]}
{"id":"ae53687ee6","title":"有别二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["且将丝䋏系兰舟，","醉下烟汀减去愁。","江上有楼君莫上，","落花随浪正东流。"],"stanzas":[["且将丝䋏系兰舟，","醉下烟汀减去愁。"],["江上有楼君莫上，","落花随浪正东流。"]]}
{"id":"60c1c92c4b","title":"有别二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["池上已看莺舌默，","云间应即雁翰开。","唯愁别后当风立，","万树将秋入恨来。"],"stanzas":[["池上已看莺舌默，","云间应即雁翰开。"],["唯愁别后当风立，","万树将秋入恨来。"]]}
{"id":"4178db18b7","title":"病中晓思","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月堕霜西竹井寒，","辘轳丝冻下缾难。","幽人病久浑成渴，","愁见龙书一鼎干。"],"stanzas":[["月堕霜西竹井寒，","辘轳丝冻下缾难。"],["幽人病久浑成渴，","愁见龙书一鼎干。"]]}
{"id":"5c3c0acd86","title":"送友人之湖上","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故人溪上有渔舟，","竿倚风苹夜不收。","欲寄一函聊问讯，","洪乔宁作置书邮。"],"stanzas":[["故人溪上有渔舟，","竿倚风苹夜不收。"],["欲寄一函聊问讯，","洪乔宁作置书邮。"]]}
{"id":"9b6013ec92","title":"寒日逢僧","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瘦胫高褰梵屧轻，","野塘风劲锡环鸣。","如何不向深山里，","坐拥闲云过一生。"],"stanzas":[["瘦胫高褰梵屧轻，","野塘风劲锡环鸣。"],["如何不向深山里，","坐拥闲云过一生。"]]}
{"id":"540159b636","title":"冬柳","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳汀斜对野人窗，","零落衰条傍晓江。","正是霜风飘断处，","寒鸥惊起一双双。"],"stanzas":[["柳汀斜对野人窗，","零落衰条傍晓江。"],["正是霜风飘断处，","寒鸥惊起一双双。"]]}
{"id":"5d3693d50d","title":"寄友人","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["敬亭寒夜溪声里，","同听先生讲太玄。","上得云梯不回首，","钓竿犹在五湖边。"],"stanzas":[["敬亭寒夜溪声里，","同听先生讲太玄。"],["上得云梯不回首，","钓竿犹在五湖边。"]]}
{"id":"169597e81d","title":"岛树","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["波涛漱苦盘根浅，","风雨飘多著叶迟。","迥出孤烟残照里，","鹭鹚相对立高枝。"],"stanzas":[["波涛漱苦盘根浅，","风雨飘多著叶迟。"],["迥出孤烟残照里，","鹭鹚相对立高枝。"]]}
{"id":"ab1533f34a","title":"头陀僧","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万峰围绕一峰深，","向此长修苦行心。","自埽雪中归鹿迹，","天明恐被猎人寻。"],"stanzas":[["万峰围绕一峰深，","向此长修苦行心。"],["自埽雪中归鹿迹，","天明恐被猎人寻。"]]}
{"id":"ac15f2a98d","title":"晚渡","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["半波风雨半波晴，","渔曲飘秋野调清。","各样莲船逗村去，","笠簷衰袂有残声。"],"stanzas":[["半波风雨半波晴，","渔曲飘秋野调清。"],["各样莲船逗村去，","笠簷衰袂有残声。"]]}
{"id":"73f85de36f","title":"赠老僧二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["枯貌自同霜里木，","余生唯指佛前灯。","少时写得坐禅影，","今见问人何处僧。"],"stanzas":[["枯貌自同霜里木，","余生唯指佛前灯。"],["少时写得坐禅影，","今见问人何处僧。"]]}
{"id":"1106267ce2","title":"赠老僧二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自有家山供衲线，","不离溪曲取庵茅。","旧曾闻说林中鸟，","定后长来顶上巢。"],"stanzas":[["自有家山供衲线，","不离溪曲取庵茅。"],["旧曾闻说林中鸟，","定后长来顶上巢。"]]}
{"id":"145888da26","title":"忆山泉","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一夜寒声来梦里，","平明著屐到声边。","心期盛夏同过此，","脱却荷衣石上眠。"],"stanzas":[["一夜寒声来梦里，","平明著屐到声边。"],["心期盛夏同过此，","脱却荷衣石上眠。"]]}
{"id":"e858ab44d8","title":"白芙蓉","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["澹然相对却成劳，","月染风裁个个高。","似说玉皇亲谪堕，","至今犹著水霜袍。"],"stanzas":[["澹然相对却成劳，","月染风裁个个高。"],["似说玉皇亲谪堕，","至今犹著水霜袍。"]]}
{"id":"67b59efe5a","title":"严光钓台","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["片帆竿外揖清风，","石立云孤万古中。","不是狂奴为故态，","仲华争得黑头公。"],"stanzas":[["片帆竿外揖清风，","石立云孤万古中。"],["不是狂奴为故态，","仲华争得黑头公。"]]}
{"id":"58592f6601","title":"读陈拾遗集","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蓬颗何时与恨平，","蜀江衣带蜀山轻。","寻闻骑士枭黄祖，","自是无人祭祢衡。"],"stanzas":[["蓬颗何时与恨平，","蜀江衣带蜀山轻。"],["寻闻骑士枭黄祖，","自是无人祭祢衡。"]]}
{"id":"5a173f7afe","title":"吴宫怀古","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["香径长洲尽棘丛，","奢云艳雨秖悲风。","吴王事事须亡国，","未必西施胜六宫。"],"stanzas":[["香径长洲尽棘丛，","奢云艳雨秖悲风。"],["吴王事事须亡国，","未必西施胜六宫。"]]}
{"id":"137d4b442f","title":"送琴客之建康","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蕙风杉露共泠泠，","三峡寒泉漱玉清。","君到南朝访遗事，","柳家双锁旧知名。"],"stanzas":[["蕙风杉露共泠泠，","三峡寒泉漱玉清。"],["君到南朝访遗事，","柳家双锁旧知名。"]]}
{"id":"5e01d2ef64","title":"闺怨","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白夹行人又远游，","日斜空上映花楼。","愁丝堕絮相逢著，","绊惹春风卒未休。"],"stanzas":[["白夹行人又远游，","日斜空上映花楼。"],["愁丝堕絮相逢著，","绊惹春风卒未休。"]]}
{"id":"b65672fb17","title":"丁香","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江上悠悠人不问，","十年云外醉中身。","殷勤解却丁香结，","纵放繁枝散诞春。"],"stanzas":[["江上悠悠人不问，","十年云外醉中身。"],["殷勤解却丁香结，","纵放繁枝散诞春。"]]}
{"id":"3d0859630d","title":"种蒲","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杜若溪边手自移，","旋抽烟劒碧参差。","何时织得孤帆去，","悬向秋风访所思。"],"stanzas":[["杜若溪边手自移，","旋抽烟劒碧参差。"],["何时织得孤帆去，","悬向秋风访所思。"]]}
{"id":"5bfbfbdd2f","title":"范蠡","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平吴专越祸胎深，","岂是功成有去心。","句践不知嫌鸟喙，","归来犹自铸良金。"],"stanzas":[["平吴专越祸胎深，","岂是功成有去心。"],["句践不知嫌鸟喙，","归来犹自铸良金。"]]}
{"id":"b1f6c076dd","title":"山僧二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山藓几重生草履，","涧泉长自满铜缾。","时将如意敲眠虎，","遣向林间坐听经。"],"stanzas":[["山藓几重生草履，","涧泉长自满铜缾。"],["时将如意敲眠虎，","遣向林间坐听经。"]]}
{"id":"d5c9b827f5","title":"山僧二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一夏不离苍岛上，","秋来频话石城南。","思归瀑布声前坐，","却把松枝拂旧庵。"],"stanzas":[["一夏不离苍岛上，","秋来频话石城南。"],["思归瀑布声前坐，","却把松枝拂旧庵。"]]}
{"id":"59269932b8","title":"上云乐","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青丝作筰桂为船，","白兔捣药虾蟇丸。","便浮天汉泊星渚，","回首笑君承露盘。"],"stanzas":[["青丝作筰桂为船，","白兔捣药虾蟇丸。"],["便浮天汉泊星渚，","回首笑君承露盘。"]]}
{"id":"53d7ef382d","title":"新秋杂题六首 眠","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一簟临窗薤叶秋，","小帘风荡半离钩。","魂清雨急梦难到，","身在五湖波上头。"],"stanzas":[["一簟临窗薤叶秋，","小帘风荡半离钩。"],["魂清雨急梦难到，","身在五湖波上头。"]]}
{"id":"4a4d3b827c","title":"新秋杂题六首 行","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寻人直到月坞北，","觅鹤便过云峰西。","只今犹有疎野调，","但绕莓苔风雨畦。"],"stanzas":[["寻人直到月坞北，","觅鹤便过云峰西。"],["只今犹有疎野调，","但绕莓苔风雨畦。"]]}
{"id":"f5f4e07316","title":"新秋杂题六首 倚","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["橘下凝情香染巾，","竹边留思露摇身。","背烟垂首尽日立，","忆得山中无事人。"],"stanzas":[["橘下凝情香染巾，","竹边留思露摇身。"],["背烟垂首尽日立，","忆得山中无事人。"]]}
{"id":"9d6ec1bfe2","title":"新秋杂题六首 吟","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忆山摇膝石上晚，","怀古掉头溪畔凉。","有时得句一声发，","惊起鹭鹚和夕阳。"],"stanzas":[["忆山摇膝石上晚，","怀古掉头溪畔凉。"],["有时得句一声发，","惊起鹭鹚和夕阳。"]]}
{"id":"da63cf3c7a","title":"新秋杂题六首 食","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日午空斋带睡痕，","水蔬山药荐盘[飧]。","林乌信我无机事，","长到而今下石盆。"],"stanzas":[["日午空斋带睡痕，","水蔬山药荐盘[飧]。"],["林乌信我无机事，","长到而今下石盆。"]]}
{"id":"5c26ea935e","title":"新秋杂题六首 坐","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶避蝉声来隙地，","忽随鸿影入辽天。","闲僧不会寂寥意，","道学西方人坐禅。"],"stanzas":[["偶避蝉声来隙地，","忽随鸿影入辽天。"],["闲僧不会寂寥意，","道学西方人坐禅。"]]}
{"id":"12a141bb80","title":"新沙","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渤澥声中涨小隄，","官家知后海鸥知。","蓬莱有路教人到，","应亦年年税紫芝。"],"stanzas":[["渤澥声中涨小隄，","官家知后海鸥知。"],["蓬莱有路教人到，","应亦年年税紫芝。"]]}
{"id":"f2aed23c6b","title":"邺宫词二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魏武平生不好香，","枫胶蕙炷洁宫房。","可知遗令非前事，","却有余薰在绣囊。"],"stanzas":[["魏武平生不好香，","枫胶蕙炷洁宫房。"],["可知遗令非前事，","却有余薰在绣囊。"]]}
{"id":"40ec6b2a83","title":"邺宫词二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花飞蝶骇不愁人，","水殿云廊别置春。","晓日靓妆千骑女，","白樱桃下紫纶巾。"],"stanzas":[["花飞蝶骇不愁人，","水殿云廊别置春。"],["晓日靓妆千骑女，","白樱桃下紫纶巾。"]]}
{"id":"fa3e83d22c","title":"古别离","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙人左手把长箭，","欲射日乌乌不栖。","何事离情畏明发，","一心唯恨汝南鸡。"],"stanzas":[["仙人左手把长箭，","欲射日乌乌不栖。"],["何事离情畏明发，","一心唯恨汝南鸡。"]]}
{"id":"094fadcd16","title":"高道士","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峨眉道士风骨峻，","手把玉皇书一通。","东游借得琴高鲤，","骑人蓬莱清浅中。"],"stanzas":[["峨眉道士风骨峻，","手把玉皇书一通。"],["东游借得琴高鲤，","骑人蓬莱清浅中。"]]}
{"id":"864c461e9c","title":"蔬食","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孔融不要留残脍，","庾悦无端恡子鹅。","香稻熟来秋菜嫩，","伴僧餐了听云和。"],"stanzas":[["孔融不要留残脍，","庾悦无端恡子鹅。"],["香稻熟来秋菜嫩，","伴僧餐了听云和。"]]}
{"id":"147f59d8e8","title":"寄远","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["缥梨花谢莺口吃，","黄犊少年人未归。","画扇红弦相掩映，","独看斜月下帘衣。"],"stanzas":[["缥梨花谢莺口吃，","黄犊少年人未归。"],["画扇红弦相掩映，","独看斜月下帘衣。"]]}
{"id":"28e06105e4","title":"山中僧","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["手关一室翠微里，","日暮白云栖半间。","白云朝出天际去，","若比老僧犹未闲。"],"stanzas":[["手关一室翠微里，","日暮白云栖半间。"],["白云朝出天际去，","若比老僧犹未闲。"]]}
{"id":"3971e742ec","title":"洞宫秋夕","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浓霜打叶落地声，","南溪石泉细泠泠。","洞宫寂寞人不去，","坐见月生云母屏。"],"stanzas":[["浓霜打叶落地声，","南溪石泉细泠泠。"],["洞宫寂寞人不去，","坐见月生云母屏。"]]}
{"id":"22df765367","title":"连昌宫词二首 门","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金铺零落兽镮空，","斜揜双扉细草中。","日暮鸟归宫树绿，","不闻鸦轧闭春风。"],"stanzas":[["金铺零落兽镮空，","斜揜双扉细草中。"],["日暮鸟归宫树绿，","不闻鸦轧闭春风。"]]}
{"id":"8255455b32","title":"连昌宫词二首 阶","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["草没苔封叠翠斜，","坠红千叶拥残霞。","年年直为秋霖苦，","滴陷青珉隐起花。"],"stanzas":[["草没苔封叠翠斜，","坠红千叶拥残霞。"],["年年直为秋霖苦，","滴陷青珉隐起花。"]]}
{"id":"44ae6d88a6","title":"怀宛陵旧游","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陵阳佳地昔年游，","谢朓青山李白楼。","唯有日斜溪上思，","酒旗风影落春流。"],"stanzas":[["陵阳佳地昔年游，","谢朓青山李白楼。"],["唯有日斜溪上思，","酒旗风影落春流。"]]}
{"id":"b5e6b42410","title":"松石晓景图","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霜骨云根惨澹愁，","宿烟封著未全收。","将归与说文通后，","写得松江岸上秋。"],"stanzas":[["霜骨云根惨澹愁，","宿烟封著未全收。"],["将归与说文通后，","写得松江岸上秋。"]]}
{"id":"0b5523893d","title":"钓车","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小轮轻线妙无双，","曾伴幽人酒一缸。","洛客见诗如有问，","辗烟冲雨过桐江。"],"stanzas":[["小轮轻线妙无双，","曾伴幽人酒一缸。"],["洛客见诗如有问，","辗烟冲雨过桐江。"]]}
{"id":"871784e4e6","title":"漉酒巾","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["靖节高风不可攀，","此巾犹坠冻醪间。","偏宜雪夜山中戴，","认取时情与醉颜。"],"stanzas":[["靖节高风不可攀，","此巾犹坠冻醪间。"],["偏宜雪夜山中戴，","认取时情与醉颜。"]]}
{"id":"4f5c87dd36","title":"华阳巾","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莲花峰下得佳名，","云褐相兼上鹤翎。","须是古坛秋霁后，","静焚香炷礼寒星。"],"stanzas":[["莲花峰下得佳名，","云褐相兼上鹤翎。"],["须是古坛秋霁后，","静焚香炷礼寒星。"]]}
{"id":"a0c6099f93","title":"方响","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["击霜寒玉乱丁丁，","花[底]秋风拂坐生。","王母闲看汉天子，","满猗兰殿佩环声。"],"stanzas":[["击霜寒玉乱丁丁，","花[底]秋风拂坐生。"],["王母闲看汉天子，","满猗兰殿佩环声。"]]}
{"id":"59b93ccec4","title":"白鹭","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪然飞下立苍苔，","应伴江鸥拒我来。","见欲扁舟摇荡去，","倩君先作水云媒。"],"stanzas":[["雪然飞下立苍苔，","应伴江鸥拒我来。"],["见欲扁舟摇荡去，","倩君先作水云媒。"]]}
{"id":"23a7fac774","title":"溪行","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚天寒雨上滩时，","他已扬舲我尚迟。","自是樯低帆幅少，","溪风终不两般吹。"],"stanzas":[["晚天寒雨上滩时，","他已扬舲我尚迟。"],["自是樯低帆幅少，","溪风终不两般吹。"]]}
{"id":"c2830da932","title":"太湖叟","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细桨轻船卖石归，","酒痕狼籍徧苔衣。","攻车战舰繁如织，","不肯回头问是非。"],"stanzas":[["细桨轻船卖石归，","酒痕狼籍徧苔衣。"],["攻车战舰繁如织，","不肯回头问是非。"]]}
{"id":"6819a83cd5","title":"荅友人","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荆卿雄骨化为尘，","燕市应无共饮人。","能说鹔鹴来换酒，","五湖赊与一年春。"],"stanzas":[["荆卿雄骨化为尘，","燕市应无共饮人。"],["能说鹔鹴来换酒，","五湖赊与一年春。"]]}
{"id":"6a7bdedac4","title":"偶作","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒信巧为缲病绪，","花音长作嫁愁媒。","也知愁病堪回避，","争奈流莺唤起来。"],"stanzas":[["酒信巧为缲病绪，","花音长作嫁愁媒。"],["也知愁病堪回避，","争奈流莺唤起来。"]]}
{"id":"ae2c9f97c0","title":"春思二首 一","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹外麦烟愁漠漠，","短翅啼禽飞魄魄。","此时忆著千里人，","独坐支颐看花落。"],"stanzas":[["竹外麦烟愁漠漠，","短翅啼禽飞魄魄。"],["此时忆著千里人，","独坐支颐看花落。"]]}
{"id":"d853b11ac7","title":"春思二首 二","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江南酒熟清明天，","高高绿斾当风悬。","谁家无事少年子，","满面落花犹醉眠。"],"stanzas":[["江南酒熟清明天，","高高绿斾当风悬。"],["谁家无事少年子，","满面落花犹醉眠。"]]}
{"id":"5fc25e2bad","title":"访僧不遇","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["櫂倚东林欲问禅，","远公飞锡未应还。","蒙庄弟子相看笑，","何事空门亦有关。"],"stanzas":[["櫂倚东林欲问禅，","远公飞锡未应还。"],["蒙庄弟子相看笑，","何事空门亦有关。"]]}
{"id":"b8de641a4b","title":"谢山泉","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["决决春泉出洞霞，","石坛封寄野人家。","草堂尽日留僧坐，","自向前溪摘茗芽。"],"stanzas":[["决决春泉出洞霞，","石坛封寄野人家。"],["草堂尽日留僧坐，","自向前溪摘茗芽。"]]}
{"id":"e5e9c8d1ea","title":"洞宫夕","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月午山空桂花落，","华阳道士云衣薄。","石坛香散步虚声，","杉云清泠滴栖鹤。"],"stanzas":[["月午山空桂花落，","华阳道士云衣薄。"],["石坛香散步虚声，","杉云清泠滴栖鹤。"]]}
{"id":"e96fdd0d93","title":"峡客行","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万仞峰排千劒束，","孤舟夜系峰头宿。","蛮溪雪坏蜀江倾，","滟滪朝来大如屋。"],"stanzas":[["万仞峰排千劒束，","孤舟夜系峰头宿。"],["蛮溪雪坏蜀江倾，","滟滪朝来大如屋。"]]}
{"id":"2f0078fd00","title":"江边","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江边日晚潮烟上，","树里鸦鸦桔槔响。","无因得似灌园翁，","十亩春蔬一藜杖。"],"stanzas":[["江边日晚潮烟上，","树里鸦鸦桔槔响。"],["无因得似灌园翁，","十亩春蔬一藜杖。"]]}
{"id":"4516a122f7","title":"帘","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["枕映疎容晚向欹，","秋烟脉脉雨微微。","逆风障燕寻常事，","不学人前当妓衣。"],"stanzas":[["枕映疎容晚向欹，","秋烟脉脉雨微微。"],["逆风障燕寻常事，","不学人前当妓衣。"]]}
{"id":"d6c70bf2bb","title":"开元杂题七首 玉龙子","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何代奇工碾玉英，","细髯纤角尽雕成。","烟干雾悄君心苦，","风雨长随一掷声。"],"stanzas":[["何代奇工碾玉英，","细髯纤角尽雕成。"],["烟干雾悄君心苦，","风雨长随一掷声。"]]}
{"id":"1e3f357167","title":"开元杂题七首 照夜白","author":"陆龟蒙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪蚪轻骏步如飞，","一练腾光透月旗。","应笑穆王抛万乘，","踏风鞭露向瑶池。"],"stanzas":[["雪蚪轻骏步如飞，","一练腾光透月旗。"],["应笑穆王抛万乘，","踏风鞭露向瑶池。"]]}
