{"id":"b02003cdc7","title":"咏罂粟子","author":"李贞白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["倒排双陆子，","希插碧牙筹。","既似牺牛乳，","又如铃马兜。","鼓捶并瀑箭，","直是有来由。"],"stanzas":[["倒排双陆子，","希插碧牙筹。"],["既似牺牛乳，","又如铃马兜。"],["鼓捶并瀑箭，","直是有来由。"]]}
{"id":"3d204ae54f","title":"咏蟹","author":"李贞白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蝉眼龟形脚似蛛，","未曾正面向人趋。","如今饤在盘筵上，","得似江湖乱走无。"],"stanzas":[["蝉眼龟形脚似蛛，","未曾正面向人趋。"],["如今饤在盘筵上，","得似江湖乱走无。"]]}
{"id":"b2893d4990","title":"示女诗","author":"郫城令","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深宫富贵事风流，","莫忘生身老骨头。","因与太师欢笑处，","为吾方便觅彭州。"],"stanzas":[["深宫富贵事风流，","莫忘生身老骨头。"],["因与太师欢笑处，","为吾方便觅彭州。"]]}
{"id":"b8d4fd4cf0","title":"寄女","author":"李令","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有人教我向衡阳，","一度思归欲断肠。","为报艳妻兼少女，","与吾觅取朗州场。"],"stanzas":[["有人教我向衡阳，","一度思归欲断肠。"],["为报艳妻兼少女，","与吾觅取朗州场。"]]}
{"id":"d460ce83fd","title":"讽刘炎索贿诗","author":"太守","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未到桃源时，","长忆出家景。","及到桃源了，","还似鉴中影。"],"stanzas":[["未到桃源时，","长忆出家景。"],["及到桃源了，","还似鉴中影。"]]}
{"id":"30dee5d36c","title":"被按自悔诗","author":"刘炎","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早知太守如虎狼，","猎取膏粱以啗之。"],"stanzas":[["早知太守如虎狼，","猎取膏粱以啗之。"]]}
{"id":"2234dae261","title":"与王仙客互嘲","author":"甘洽","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["王，","计尔应姓田，","为你面拨獭，","抽却你两边。","甘，","计尔应姓丹，","为你头不曲，","回脚向上安。"],"stanzas":[["王，","计尔应姓田，","为你面拨獭，","抽却你两边。"],["甘，","计尔应姓丹，","为你头不曲，","回脚向上安。"]]}
{"id":"b8ca40fbd0","title":"题濠州高塘馆","author":"阎敬爱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["借问襄王安在哉，","山川此地胜阳台。","今宵寓宿高塘馆，","神女何曾入梦来。"],"stanzas":[["借问襄王安在哉，","山川此地胜阳台。"],["今宵寓宿高塘馆，","神女何曾入梦来。"]]}
{"id":"77b6ecd775","title":"题敬爱诗后","author":"李和风","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高唐不是这高塘，","淮畔荆南各异方。","若向此中求荐枕，","参差笑杀楚襄王。"],"stanzas":[["高唐不是这高塘，","淮畔荆南各异方。"],["若向此中求荐枕，","参差笑杀楚襄王。"]]}
{"id":"c855dd00ab","title":"荅日休皮字诗","author":"归氏子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八片尖裁浪作毬，","火中𬊈了水中揉。","一包闲气如长在，","惹踢招拳卒未休。"],"stanzas":[["八片尖裁浪作毬，","火中𬊈了水中揉。"],["一包闲气如长在，","惹踢招拳卒未休。"]]}
{"id":"7633d5421a","title":"谑池亳二州宾佐兼寄宣武军掌书记李昼","author":"张鲁封","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杜叟学仙轻蕙质，","韦公事佛畏青娥。","乐营却是闲人管，","两地风情日渐多。"],"stanzas":[["杜叟学仙轻蕙质，","韦公事佛畏青娥。"],["乐营却是闲人管，","两地风情日渐多。"]]}
{"id":"1fa3ba5bc5","title":"戏酬张鲁封","author":"李昼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋浦亚卿颜叔子，","谯都中宪老桑门。","如今柳巷通车马，","唯恐他时立棘垣。"],"stanzas":[["秋浦亚卿颜叔子，","谯都中宪老桑门。"],["如今柳巷通车马，","唯恐他时立棘垣。"]]}
{"id":"0e58a2a49c","title":"即事","author":"杨鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白日苍蝇满飰盘，","夜间蚊子又成团。","每到更深人静后，","定来头上齩杨鸾。"],"stanzas":[["白日苍蝇满飰盘，","夜间蚊子又成团。"],["每到更深人静后，","定来头上齩杨鸾。"]]}
{"id":"627e1f059c","title":"嘲周颛","author":"座客","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙津掉尾十年劳，","声价当时鬬月高。","惟有红妆回舞手，","似持霜刀向猨猱。"],"stanzas":[["龙津掉尾十年劳，","声价当时鬬月高。"],["惟有红妆回舞手，","似持霜刀向猨猱。"]]}
{"id":"1923565514","title":"和座客","author":"周颛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十载文场敢惮劳，","宋都回鶂为风高。","今朝甘被花枝笑，","任道尊前爱缚猱。"],"stanzas":[["十载文场敢惮劳，","宋都回鶂为风高。"],["今朝甘被花枝笑，","任道尊前爱缚猱。"]]}
{"id":"f0681e78b1","title":"荅或人","author":"张𬸦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宁可且将朱唇饮酒，","谁能遂你黑齿常之。"],"stanzas":[["宁可且将朱唇饮酒，","谁能遂你黑齿常之。"]]}
{"id":"34b1271c3e","title":"嘲崔嘏","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二十九人及第，","五十七眼看花。"],"stanzas":[["二十九人及第，","五十七眼看花。"]]}
{"id":"de192d8f2d","title":"岭南诗句","author":"苏芸","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["郭里多榕树，","街中足使君。"],"stanzas":[["郭里多榕树，","街中足使君。"]]}
