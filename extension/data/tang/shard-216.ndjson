{"id":"59cdedf00d","title":"与李荣互谑","author":"僧法轨","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姓李应须礼，","言荣又不荣。","身长三尺半，","头毛犹未生。"],"stanzas":[["姓李应须礼，","言荣又不荣。"],["身长三尺半，","头毛犹未生。"]]}
{"id":"fec00660e0","title":"广州三樵歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["奉敕追三樵，","随侯傍道走。","回头语李郎，","唤取尔朱九。"],"stanzas":[["奉敕追三樵，","随侯傍道走。"],["回头语李郎，","唤取尔朱九。"]]}
{"id":"f6ed996e9e","title":"三御史咏","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["韦子凝而密，","任生直且狂。","可怜元福庆，","也学坐凝床。"],"stanzas":[["韦子凝而密，","任生直且狂。"],["可怜元福庆，","也学坐凝床。"]]}
{"id":"76995caf21","title":"台中里行咏","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柱下虽为史，","台中未是官。","何时闻必也，","早晚见任端。"],"stanzas":[["柱下虽为史，","台中未是官。"],["何时闻必也，","早晚见任端。"]]}
{"id":"ff7b57192c","title":"讥裴休","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赵氏儿皆尼氏女，","师翁儿即晋公儿。","却教术士难推算，","胎月分张与阿谁。"],"stanzas":[["赵氏儿皆尼氏女，","师翁儿即晋公儿。"],["却教术士难推算，","胎月分张与阿谁。"]]}
{"id":"bab916b17d","title":"嘲四相","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["确确无余事，","钱财总被收。","商人都不管，","货赂几时休。"],"stanzas":[["确确无余事，","钱财总被收。"],["商人都不管，","货赂几时休。"]]}
{"id":"48bdd22802","title":"放牓诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乞儿还有大通年，","三十三人椀杖全。","薛庶准前骑瘦马，","范酂依旧盖番毡。"],"stanzas":[["乞儿还有大通年，","三十三人椀杖全。"],["薛庶准前骑瘦马，","范酂依旧盖番毡。"]]}
{"id":"9db3d05292","title":"改魏扶诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叶落满庭阴，","朱门试院深。","昔年辛苦地，","今日负前心。"],"stanzas":[["叶落满庭阴，","朱门试院深。"],["昔年辛苦地，","今日负前心。"]]}
{"id":"a6ca92d517","title":"嘲举子骑驴","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今年敕下尽骑驴，","短轴长秋满九衢。","清瘦儿郎犹自可，","就中愁杀郑昌图。"],"stanzas":[["今年敕下尽骑驴，","短轴长秋满九衢。"],["清瘦儿郎犹自可，","就中愁杀郑昌图。"]]}
{"id":"f5aed7fd6c","title":"嘲崔垂休","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["慈恩塔下亲泥壁，","滑腻光华玉不如。","何事博陵崔四十，","金陵腿上逞欧书。"],"stanzas":[["慈恩塔下亲泥壁，","滑腻光华玉不如。"],["何事博陵崔四十，","金陵腿上逞欧书。"]]}
{"id":"c0e6c6eca5","title":"嘲主司崔澹","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["主司何事厌吾王，","解把黄巢比武王。"],"stanzas":[["主司何事厌吾王，","解把黄巢比武王。"]]}
{"id":"2a1603861b","title":"朝士戏任毂","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云林应讶鹤书迟，","自入京来探事宜。","从此见山须合眼，","被山相赚已多时。"],"stanzas":[["云林应讶鹤书迟，","自入京来探事宜。"],["从此见山须合眼，","被山相赚已多时。"]]}
{"id":"27b7abb298","title":"题房鲁题名后","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姚家新壻是房郎，","未解芳颜意欲狂。","见说正调穿羽箭，","莫教射破寺家墙。"],"stanzas":[["姚家新壻是房郎，","未解芳颜意欲狂。"],["见说正调穿羽箭，","莫教射破寺家墙。"]]}
{"id":"38c85b21ab","title":"洛阳人嘲跋异","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赫赫洛下，","唯说异画。","张氏出头，","跋异无价。"],"stanzas":[["赫赫洛下，","唯说异画。"],["张氏出头，","跋异无价。"]]}
{"id":"40bb0b223d","title":"又嘲","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["李生来，","跋君怕。","不意今日却增价，","不画罗汉画驼马。"],"stanzas":[["李生来，","跋君怕。"],["不意今日却增价，","不画罗汉画驼马。"]]}
{"id":"6b614c6e2c","title":"蜀选人嘲韩昭","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嘉眉邛蜀，","侍郎骨肉。","导江青城，","侍郎情亲。","果阆二州，","侍郎自留。","巴蓬集壁，","侍郎不识。"],"stanzas":[["嘉眉邛蜀，","侍郎骨肉。"],["导江青城，","侍郎情亲。"],["果阆二州，","侍郎自留。"],["巴蓬集壁，","侍郎不识。"]]}
{"id":"2efaa60c55","title":"嘲伛偻人","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拄杖欲似乃，","播笏还似及。","逆风荡雨行，","面干顶额湿。","著衣床上坐，","肚缓脊皮急。","城门尔许高，","故自匍匐入。"],"stanzas":[["拄杖欲似乃，","播笏还似及。"],["逆风荡雨行，","面干顶额湿。"],["著衣床上坐，","肚缓脊皮急。"],["城门尔许高，","故自匍匐入。"]]}
{"id":"11d22fd7a3","title":"曲中唱语","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["张公吃酒李公颠，","盛六生儿郑九怜。","舍下雄鸡伤一德，","南头小凤纳三千。"],"stanzas":[["张公吃酒李公颠，","盛六生儿郑九怜。"],["舍下雄鸡伤一德，","南头小凤纳三千。"]]}
{"id":"084443d2a6","title":"改唱","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["张公吃酒李公颠，","盛六生儿郑九怜。","舍下雄鸡失一足，","街头小福拉三拳。"],"stanzas":[["张公吃酒李公颠，","盛六生儿郑九怜。"],["舍下雄鸡失一足，","街头小福拉三拳。"]]}
{"id":"b991028ab7","title":"街中又唱","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫将庞大作荍团，","庞大皮中的不干。","不怕凤皇当额打，","更将鸡脚用筋缠。"],"stanzas":[["莫将庞大作荍团，","庞大皮中的不干。"],["不怕凤皇当额打，","更将鸡脚用筋缠。"]]}
{"id":"41a37b59b6","title":"吹火诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吹火朱唇动，","添薪玉腕斜。","遥看烟里面，","大似雾中花。"],"stanzas":[["吹火朱唇动，","添薪玉腕斜。"],["遥看烟里面，","大似雾中花。"]]}
{"id":"fd903b2b41","title":"吹火诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吹火青唇动，","添薪黑腕斜。","遥看烟里面，","恰似鸠盘荼。"],"stanzas":[["吹火青唇动，","添薪黑腕斜。"],["遥看烟里面，","恰似鸠盘荼。"]]}
{"id":"1313c75e71","title":"刘黑闼解嘲人语 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水恶，","头如镰杓尾如凿，","河里搦鱼无僻错。"],"stanzas":[["水恶，","头如镰杓尾如凿，","河里搦鱼无僻错。"]]}
{"id":"6e07b84d4d","title":"刘黑闼解嘲人语 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["骆驼，","项曲绿蹄，","被他负物多。"],"stanzas":[["骆驼，","项曲绿蹄，","被他负物多。"]]}
{"id":"3b039e0477","title":"村人学解嘲人语","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["緜绢，","割两耳，","只有面。"],"stanzas":[["緜绢，","割两耳，","只有面。"]]}
{"id":"5cb99304cc","title":"嘲刘师老","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大府朝天升穆老，","尚书倒地落刘郎。"],"stanzas":[["大府朝天升穆老，","尚书倒地落刘郎。"]]}
