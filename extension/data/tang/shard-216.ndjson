{"id":"0008ffdf06","title":"题洛阳县壁","author":"李兼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猾吏畏服，","县妖破胆。","好录政声，","闻于御览。"],"stanzas":[["猾吏畏服，","县妖破胆。"],["好录政声，","闻于御览。"]]}
{"id":"90a64e6c0f","title":"题书卷后语","author":"杜兼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["倩俸写来手自校，","汝曹读之知圣道，","坠之鬻之为不孝。"],"stanzas":[["倩俸写来手自校，","汝曹读之知圣道，","坠之鬻之为不孝。"]]}
{"id":"e71faeddb5","title":"题李阳冰玉箸篆词","author":"舒元舆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斯去千年，","冰生唐时。","冰复去矣，","后来者谁。","后千年有人，","谁来待之。","后千年无人，","篆止于斯。","呜呼主人，","为吾宝之。"],"stanzas":[["斯去千年，","冰生唐时。"],["冰复去矣，","后来者谁。"],["后千年有人，","谁来待之。"],["后千年无人，","篆止于斯。"],["呜呼主人，","为吾宝之。"]]}
{"id":"e910cdacbd","title":"判误书纸背","author":"裴谞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["这畔似那畔，","那畔似这畔。","我也不辞与你判，","笑杀门前著鞾汉。"],"stanzas":[["这畔似那畔，","那畔似这畔。"],["我也不辞与你判，","笑杀门前著鞾汉。"]]}
{"id":"2b1502609c","title":"又判争猫儿状","author":"裴谞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猫儿不识主，","傍家搦老鼠。","两家不须争，","将来与裴谞。"],"stanzas":[["猫儿不识主，","傍家搦老鼠。"],["两家不须争，","将来与裴谞。"]]}
{"id":"77b099c15d","title":"断僧通状","author":"李翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上岁童子，","二十受戒。","君王不朝，","父母不拜。","口称贫道，","有钱放债。","量决十下，","牒出东界。"],"stanzas":[["上岁童子，","二十受戒。"],["君王不朝，","父母不拜。"],["口称贫道，","有钱放债。"],["量决十下，","牒出东界。"]]}
{"id":"0d8345bf1d","title":"判僧云晏五人聚赌喧诤语","author":"韩滉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正法何曾执贝，","空门不积余财。","白日既能赌博，","通宵必醉尊罍。","强说天堂难到，","又言地狱长开。","竝付江神收管，","波中便是泉台。"],"stanzas":[["正法何曾执贝，","空门不积余财。"],["白日既能赌博，","通宵必醉尊罍。"],["强说天堂难到，","又言地狱长开。"],["竝付江神收管，","波中便是泉台。"]]}
{"id":"dfab781287","title":"判道士黄山隐","author":"皇甫大夫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道士黄山隐，","轻人复重财。","太山将比甑，","东海只容杯。","绿绶藏云帔，","乌巾换鹿胎。","黄泉六个鬼，","今夜待君来。"],"stanzas":[["道士黄山隐，","轻人复重财。"],["太山将比甑，","东海只容杯。"],["绿绶藏云帔，","乌巾换鹿胎。"],["黄泉六个鬼，","今夜待君来。"]]}
{"id":"9dd028e0d4","title":"碾驴鞍判","author":"罗绍威","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["邺城大道甚宽，","何故驾车碾鞍。","领鞴驴汉子科决，","待驾车汉子喜欢。"],"stanzas":[["邺城大道甚宽，","何故驾车碾鞍。"],["领鞴驴汉子科决，","待驾车汉子喜欢。"]]}
{"id":"dd6fcce877","title":"批州符","author":"萧结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秧开五叶，","蚕长三眠。","人皆忙迫，","划甚闲船。"],"stanzas":[["秧开五叶，","蚕长三眠。"],["人皆忙迫，","划甚闲船。"]]}
