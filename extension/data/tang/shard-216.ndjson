{"id":"06f1f77dcd","title":"自状","author":"张翱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有张翱兮，","寓止淮阴。","来绮席兮，","放恣胸襟。"],"stanzas":[["有张翱兮，","寓止淮阴。"],["来绮席兮，","放恣胸襟。"]]}
{"id":"11e1e1ca5f","title":"刺左右膊诗","author":"赵武建","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野鸭滩头宿，","朝朝被鹘梢。","忽惊飞入水，","留命到今朝。"],"stanzas":[["野鸭滩头宿，","朝朝被鹘梢。"],["忽惊飞入水，","留命到今朝。"]]}
{"id":"0571c8f191","title":"刺左臂膊诗","author":"宋元素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔日已前家未贫，","苦将钱物结交亲。","如今失路寻知己，","行尽关山无一人。"],"stanzas":[["昔日已前家未贫，","苦将钱物结交亲。"],["如今失路寻知己，","行尽关山无一人。"]]}
