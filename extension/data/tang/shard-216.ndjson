{"id":"77861bd541","title":"劝进疏引谶 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西北天火照，","龙山昭童子，","赤光连北斗。","童子木上悬白幡，","胡兵纷纷满前后。","拍手唱堂堂，","驱羊向南走。"],"stanzas":[["西北天火照，","龙山昭童子，","赤光连北斗。"],["童子木上悬白幡，","胡兵纷纷满前后。"],["拍手唱堂堂，","驱羊向南走。"]]}
{"id":"f0afb8a04d","title":"劝进疏引谶 四","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["胡兵未济汉不整，","治中都护有八井。"],"stanzas":[["胡兵未济汉不整，","治中都护有八井。"]]}
{"id":"45f8203ac6","title":"劝进疏引谶 五","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兴伍伍，","仁义行武。","得九九，","得声名。","童子木底百丈水，","东家井里五色星。","我语不可信，","问取卫先生。"],"stanzas":[["兴伍伍，","仁义行武。"],["得九九，","得声名。"],["童子木底百丈水，","东家井里五色星。"],["我语不可信，","问取卫先生。"]]}
{"id":"65e4cedc69","title":"劝进疏引谶 六","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戌亥君臣乱，","子丑破城隍。","寅卯如欲定，","龙蛇伏四方。","十八成男子，","洪水主刀傍。","市朝义归政，","人宁俱不荒。","人言有恒性，","也复道非常。","为君好思量，","何□□禹汤。","桃源花□□，","李树起堂堂。","只看寅卯岁，","深水没黄杨。"],"stanzas":[["戌亥君臣乱，","子丑破城隍。"],["寅卯如欲定，","龙蛇伏四方。"],["十八成男子，","洪水主刀傍。"],["市朝义归政，","人宁俱不荒。"],["人言有恒性，","也复道非常。"],["为君好思量，","何□□禹汤。"],["桃源花□□，","李树起堂堂。"],["只看寅卯岁，","深水没黄杨。"]]}
