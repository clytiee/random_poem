{"id":"d6c29fa798","title":"选人歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今年选数恰相当，","都由座主无文章。","案后一腔冻猪肉，","所以名为姜侍郎。"],"stanzas":[["今年选数恰相当，","都由座主无文章。"],["案后一腔冻猪肉，","所以名为姜侍郎。"]]}
{"id":"d8d151ec7b","title":"鲁城民歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鲁地抑种稻，","一概被水沫。","年年索蟹夫，","百姓不可活。"],"stanzas":[["鲁地抑种稻，","一概被水沫。"],["年年索蟹夫，","百姓不可活。"]]}
{"id":"8513e247ef","title":"王法曹歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前得尹佛子，","后得王癞獭。","判事驴齩瓜，","唤人牛嚼沫。","见钱满面喜，","无镪从头喝。","常逢饿夜叉，","百姓不可活。"],"stanzas":[["前得尹佛子，","后得王癞獭。"],["判事驴齩瓜，","唤人牛嚼沫。"],["见钱满面喜，","无镪从头喝。"],["常逢饿夜叉，","百姓不可活。"]]}
{"id":"790e48a242","title":"得体歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得体纥那也，","纥囊得体那。","潭里船车闹，","扬州铜器多。","三郎当殿坐，","听唱得体歌。"],"stanzas":[["得体纥那也，","纥囊得体那。"],["潭里船车闹，","扬州铜器多。"],["三郎当殿坐，","听唱得体歌。"]]}
{"id":"7b085e4529","title":"得宝歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得宝耶，","弘农耶。","弘农耶，","得宝耶。"],"stanzas":[["得宝耶，","弘农耶。"],["弘农耶，","得宝耶。"]]}
{"id":"1a39c6e450","title":"崔成甫飜得宝歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得宝弘农野，","弘农得宝那。","潭里船车闹，","扬州铜器多。","三郎当殿坐，","听唱得宝歌。"],"stanzas":[["得宝弘农野，","弘农得宝那。"],["潭里船车闹，","扬州铜器多。"],["三郎当殿坐，","听唱得宝歌。"]]}
{"id":"f04b0025f4","title":"袁仁敬歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天不恤冤人兮，","何夺我慈亲兮。","有理无申兮，","痛哉安诉陈兮。"],"stanzas":[["天不恤冤人兮，","何夺我慈亲兮。"],["有理无申兮，","痛哉安诉陈兮。"]]}
{"id":"6a9b50cc23","title":"京兆二尹歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前尹赫赫，","具瞻允若。","后尹熙熙，","具瞻允斯。"],"stanzas":[["前尹赫赫，","具瞻允若。"],["后尹熙熙，","具瞻允斯。"]]}
{"id":"6f1e4c28ab","title":"黄州左公歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我欲逃乡里，","我欲去坟墓。","左公今既来，","谁忍弃之去。"],"stanzas":[["我欲逃乡里，","我欲去坟墓。"],["左公今既来，","谁忍弃之去。"]]}
{"id":"701783e25b","title":"又歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吾乡有鬼巫，","惑人人不知。","天子正尊信，","左公能杀之。"],"stanzas":[["吾乡有鬼巫，","惑人人不知。"],["天子正尊信，","左公能杀之。"]]}
{"id":"33582efebc","title":"舒州人歌","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["邻邑谷不登，","我土丰粢盛。","禾稼美如云，","实系我使君。"],"stanzas":[["邻邑谷不登，","我土丰粢盛。"],["禾稼美如云，","实系我使君。"]]}
{"id":"1efc7b3635","title":"建州人歌 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["令我州郡泰，","令我户口裕。","令我活计大，","陆员外。"],"stanzas":[["令我州郡泰，","令我户口裕。"],["令我活计大，","陆员外。"]]}
{"id":"28e844289d","title":"建州人歌 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["令我家不分，","令我马成群。","令我稻满囷，","陆使君。"],"stanzas":[["令我家不分，","令我马成群。"],["令我稻满囷，","陆使君。"]]}
