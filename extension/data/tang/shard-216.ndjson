{"id":"9673b87f1a","title":"漳泉分地神篆","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["漳泉两州，","分地太平。","永安龙溪，","山高气清。","千年不惑，","万古作程。"],"stanzas":[["漳泉两州，","分地太平。"],["永安龙溪，","山高气清。"],["千年不惑，","万古作程。"]]}
{"id":"00550270b6","title":"含元殿丹石隐语","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天汉二年，","赤光生栗。","木下有子，","伤心遇酷。"],"stanzas":[["天汉二年，","赤光生栗。"],["木下有子，","伤心遇酷。"]]}
{"id":"f93331631e","title":"长安空宅铭篆","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夏天子紫金三千斤，","赐有德者。"],"stanzas":[["夏天子紫金三千斤，","赐有德者。"]]}
{"id":"b7b9020781","title":"莆田石记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石敢当，","镇百鬼，","压灾殃。","官吏福，","百姓康。","风教盛，","礼乐昌。"],"stanzas":[["石敢当，","镇百鬼，","压灾殃。"],["官吏福，","百姓康。"],["风教盛，","礼乐昌。"]]}
{"id":"57b6be6e7c","title":"符离树穴中石篆","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旁有水，","上有道，","八百年中逢栲栳。"],"stanzas":[["旁有水，","上有道，","八百年中逢栲栳。"]]}
{"id":"7262237f4f","title":"淮西池濠石铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["井底一竿竹，","竹色深绿绿。","鸡未肥，","酒未熟，","障车儿郎且须缩。"],"stanzas":[["井底一竿竹，","竹色深绿绿。"],["鸡未肥，","酒未熟，","障车儿郎且须缩。"]]}
{"id":"dbb39aacfc","title":"罗池石刻","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙城柳，","神所守。","驱厉鬼，","山左首。","福士氓，","制九丑。"],"stanzas":[["龙城柳，","神所守。"],["驱厉鬼，","山左首。"],["福士氓，","制九丑。"]]}
{"id":"bdd9439c8a","title":"道者遗记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武之在卯，","尧王八季。","我弃其寝，","我去其扆。","深深然，","高高然。","人不吾知，","又不吾谓。","由今之后，","二百余祀。","燄燄其光，","和和其始。","东方有兔，","小首元尾。","经过吾道，","来至吾里。","饮吾泉以醉，","登吾榻而寐。","刻乎其壁，","奥乎其义。","人谁以辨，","其东平子。"],"stanzas":[["武之在卯，","尧王八季。"],["我弃其寝，","我去其扆。"],["深深然，","高高然。"],["人不吾知，","又不吾谓。"],["由今之后，","二百余祀。"],["燄燄其光，","和和其始。"],["东方有兔，","小首元尾。"],["经过吾道，","来至吾里。"],["饮吾泉以醉，","登吾榻而寐。"],["刻乎其壁，","奥乎其义。"],["人谁以辨，","其东平子。"]]}
{"id":"a463f7077d","title":"王璠石铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山有石，","石有玉。","玉有瑕，","即休也。"],"stanzas":[["山有石，","石有玉。"],["玉有瑕，","即休也。"]]}
{"id":"af5935ceb3","title":"玄元观栋桁记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山水谁无言，","元年有福重修。"],"stanzas":[["山水谁无言，","元年有福重修。"]]}
{"id":"d105135e5d","title":"天台观石简记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海水竭，","台山缺，","皇家宝祚无休歇。"],"stanzas":[["海水竭，","台山缺，","皇家宝祚无休歇。"]]}
{"id":"3803cf20f8","title":"成都罗城北门石记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五五复五五，","五五逾重数。","浮世若浮云，","金石一如故。","与君相见时，","杳杳非今土。"],"stanzas":[["五五复五五，","五五逾重数。"],["浮世若浮云，","金石一如故。"],["与君相见时，","杳杳非今土。"]]}
{"id":"f6e0e1aa77","title":"青羊宫甎记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太平平中元灾。"],"stanzas":[["太平平中元灾。"]]}
{"id":"0acc741152","title":"铜雀台玉板篆","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上土巴灰除虚除，","伊尹东北八九余。","秦赵多应分五玉，","丝竹木子世世居。","但看六六百中外，","世主难留如国如。"],"stanzas":[["上土巴灰除虚除，","伊尹东北八九余。"],["秦赵多应分五玉，","丝竹木子世世居。"],["但看六六百中外，","世主难留如国如。"]]}
{"id":"799d299075","title":"显德道宫石记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瑞云灵迹镇梁东，","他日多应与古同。","岁月迁移人事改，","再来闲处又兴功。"],"stanzas":[["瑞云灵迹镇梁东，","他日多应与古同。"],["岁月迁移人事改，","再来闲处又兴功。"]]}
{"id":"225fdc3f55","title":"南唐升元殿基下石记","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫问江南事，","江南事可凭。","抱鸡升宝位，","跨犬出金陵。","子建司南位，","安仁秉夜灯。","东邻娇小女，","骑虎渡河冰。"],"stanzas":[["莫问江南事，","江南事可凭。"],["抱鸡升宝位，","跨犬出金陵。"],["子建司南位，","安仁秉夜灯。"],["东邻娇小女，","骑虎渡河冰。"]]}
{"id":"b9dfb33d52","title":"马殷浚城石碣篆","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龙举头，","猳掉尾。","羊为兄，","猴作弟。","羊归穴，","猴离次。"],"stanzas":[["龙举头，","猳掉尾。"],["羊为兄，","猴作弟。"],["羊归穴，","猴离次。"]]}
{"id":"37a03fa7ed","title":"王霸仙坛甎刻","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["树枯不用伐，","坛坏不须结。","未满一千岁，","自有系孙列。","后来是三皇，","潮水荡祸殃。","岩逢二乍间，","未免有消亡。","子孙依吾道，","代代封闽疆。"],"stanzas":[["树枯不用伐，","坛坏不须结。"],["未满一千岁，","自有系孙列。"],["后来是三皇，","潮水荡祸殃。"],["岩逢二乍间，","未免有消亡。"],["子孙依吾道，","代代封闽疆。"]]}
{"id":"91fb47f1a9","title":"刘䶮石谶","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人人有一，","山山值牛。","兔丝吞骨，","盖海承刘。"],"stanzas":[["人人有一，","山山值牛。"],["兔丝吞骨，","盖海承刘。"]]}
{"id":"109196ddf1","title":"南汉罗浮古劒篆文","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丁与水同宫，","王将耳口同。","尹来居口上，","山岫获重重。"],"stanzas":[["丁与水同宫，","王将耳口同。"],["尹来居口上，","山岫获重重。"]]}
{"id":"8bba3fbb5a","title":"司马承祯含象鉴文 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天地含象，","日月贞明。","写规万物，","洞鉴百灵。"],"stanzas":[["天地含象，","日月贞明。"],["写规万物，","洞鉴百灵。"]]}
{"id":"3774da529f","title":"司马承祯含象鉴文 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龟自卜，","镜自照。","吉可募，","光不曜。"],"stanzas":[["龟自卜，","镜自照。"],["吉可募，","光不曜。"]]}
{"id":"2fc8fe2cae","title":"司马承祯含象鉴文 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青盖作镜大吉昌，","巧工刊之成文章。","左龙右虎辟不祥，","朱鸟玄武顺于旁，","子孙富贵居中央。"],"stanzas":[["青盖作镜大吉昌，","巧工刊之成文章。"],["左龙右虎辟不祥，","朱鸟玄武顺于旁，","子孙富贵居中央。"]]}
{"id":"7095064dad","title":"景震劒文 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["㧑雷电，","运玄星。","摧凶恶，","亨利贞。"],"stanzas":[["㧑雷电，","运玄星。"],["摧凶恶，","亨利贞。"]]}
{"id":"35ee09e7af","title":"景震劒文 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["干降精，","坤应灵。","日月象，","岳渎形。"],"stanzas":[["干降精，","坤应灵。"],["日月象，","岳渎形。"]]}
{"id":"d219f2859a","title":"高丽镜文","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三水中，","四维下，","上帝降子于辰马。","先操鸡，","后搏鸭。","己年中，","二龙见。","一则藏身青木中，","一则见形黑金东。"],"stanzas":[["三水中，","四维下，","上帝降子于辰马。"],["先操鸡，","后搏鸭。"],["己年中，","二龙见。"],["一则藏身青木中，","一则见形黑金东。"]]}
{"id":"5226acc06e","title":"京西市放生池墓铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["龟言市，","蓍言水。"],"stanzas":[["龟言市，","蓍言水。"]]}
{"id":"5271892afe","title":"古墓卜地词","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尔后一千岁，","此地化为泉。","赖逢邬侍御，","移我向高原。"],"stanzas":[["尔后一千岁，","此地化为泉。"],["赖逢邬侍御，","移我向高原。"]]}
{"id":"d24a7b7f92","title":"卫先生墓铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["姜师度，","更移向南三五步。"],"stanzas":[["姜师度，","更移向南三五步。"]]}
{"id":"cf5c61a2fe","title":"隐者瘗男铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["神真链形年未足，","化为我子功相续。","丞相瘗之刻玄玉，","仙路何长死何促。"],"stanzas":[["神真链形年未足，","化为我子功相续。"],["丞相瘗之刻玄玉，","仙路何长死何促。"]]}
{"id":"920f80eade","title":"乌氏葬碑","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牛领冈头，","红箫笼下。","葬用两日，","手板相亚。"],"stanzas":[["牛领冈头，","红箫笼下。"],["葬用两日，","手板相亚。"]]}
{"id":"48a234cedb","title":"岩腹棺铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲堕不堕逢王果，","五百年中重收我。"],"stanzas":[["欲堕不堕逢王果，","五百年中重收我。"]]}
{"id":"824a8d722c","title":"古棺石铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲陷不陷被藤缚，","欲落不落被沙阁，","五百年后遇熊博。"],"stanzas":[["欲陷不陷被藤缚，","欲落不落被沙阁，","五百年后遇熊博。"]]}
{"id":"9bc945e2e3","title":"涟水古冢缾文","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一双青乌子，","飞来五两头。","借问船轻重，","寄信到扬州。"],"stanzas":[["一双青乌子，","飞来五两头。"],["借问船轻重，","寄信到扬州。"]]}
{"id":"da9e2bcc1f","title":"沈彬圹篆","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳城今已开，","虽开不葬埋。","漆灯犹未灭，","留待沈彬来。"],"stanzas":[["佳城今已开，","虽开不葬埋。"],["漆灯犹未灭，","留待沈彬来。"]]}
{"id":"afa6822327","title":"广陵古冢石刻","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日为箭兮月为弓，","四时躬人兮无穷。","但得天将明月死，","不觉人随流水空。","山川秀兮碧穹窿，","崇夫人墓兮直其中。","猨啼鸟啸烟蒙蒙，","千年万年松柏风。"],"stanzas":[["日为箭兮月为弓，","四时躬人兮无穷。"],["但得天将明月死，","不觉人随流水空。"],["山川秀兮碧穹窿，","崇夫人墓兮直其中。"],["猨啼鸟啸烟蒙蒙，","千年万年松柏风。"]]}
{"id":"304b1bc9ac","title":"王承检掘得墓铭","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["车道之北，","邽山之阳。","深深葬玉，","郁郁埋香。","刻斯贞石，","焕乎遗芳。","地变陵谷，","崄列城隍。","干德丙年，","坏者合郎。"],"stanzas":[["车道之北，","邽山之阳。"],["深深葬玉，","郁郁埋香。"],["刻斯贞石，","焕乎遗芳。"],["地变陵谷，","崄列城隍。"],["干德丙年，","坏者合郎。"]]}
