{"id":"d82fbe6004","title":"早发潜水驿谒郎中员外","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["半床秋月一声鸡，","万里行人费马蹄。","青野雾销凝晋洞，","碧山烟散避秦溪。","楼台稍辨乌城外，","更漏微闻鹤柱西。","已是大仙怜后进，","不应来向武陵迷。"],"stanzas":[["半床秋月一声鸡，","万里行人费马蹄。"],["青野雾销凝晋洞，","碧山烟散避秦溪。"],["楼台稍辨乌城外，","更漏微闻鹤柱西。"],["已是大仙怜后进，","不应来向武陵迷。"]]}
{"id":"3be12cee47","title":"赠渔者","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不媿人间万户侯，","子孙相继老扁舟。","往来南越谙鲛室，","生长东吴识蜃楼。","自为钓竿能遣闷，","不因萱草解销忧。","羡君独得逃名趣，","身外无机任白头。"],"stanzas":[["不媿人间万户侯，","子孙相继老扁舟。"],["往来南越谙鲛室，","生长东吴识蜃楼。"],["自为钓竿能遣闷，","不因萱草解销忧。"],["羡君独得逃名趣，","身外无机任白头。"]]}
{"id":"1167939f4f","title":"自岭下泛鹢到清远峡作","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乘船浮鹢下韶水，","绝境方知在岭南。","薜荔雨余山自黛，","蒹葭烟尽岛如蓝。","旦游萧帝新松寺，","夜宿嫦娥桂影潭。","不为箧中书未献，","便来兹地结茅庵。"],"stanzas":[["乘船浮鹢下韶水，","绝境方知在岭南。"],["薜荔雨余山自黛，","蒹葭烟尽岛如蓝。"],["旦游萧帝新松寺，","夜宿嫦娥桂影潭。"],["不为箧中书未献，","便来兹地结茅庵。"]]}
{"id":"0e0827cca1","title":"题周瑜将军庙","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共说生前国步难，","山川龙战血漫漫。","交锋魏帝旌旗退，","委任君王社稷安。","庭际雨余春草长，","庙前风起晚光残。","功勋碑碣今何在，","不得当时一字看。"],"stanzas":[["共说生前国步难，","山川龙战血漫漫。"],["交锋魏帝旌旗退，","委任君王社稷安。"],["庭际雨余春草长，","庙前风起晚光残。"],["功勋碑碣今何在，","不得当时一字看。"]]}
{"id":"ee053a5777","title":"咏史诗 乌江","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["争帝图王势已倾，","八千兵散楚歌声。","乌江不是无船渡，","耻向东吴再起兵。"],"stanzas":[["争帝图王势已倾，","八千兵散楚歌声。"],["乌江不是无船渡，","耻向东吴再起兵。"]]}
{"id":"b77fcb3876","title":"咏史诗 章华台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茫茫衰草没章华，","因笑灵王昔好奢。","台土未干箫管绝，","可怜身死野人家。"],"stanzas":[["茫茫衰草没章华，","因笑灵王昔好奢。"],["台土未干箫管绝，","可怜身死野人家。"]]}
{"id":"ef9015a155","title":"咏史诗 细腰宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚王辛苦战无功，","国破城荒霸业空。","唯有青春花上露，","至今犹泣细腰宫。"],"stanzas":[["楚王辛苦战无功，","国破城荒霸业空。"],["唯有青春花上露，","至今犹泣细腰宫。"]]}
{"id":"8fc097df7e","title":"咏史诗 沙苑","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冯翊南边宿雾开，","行人一步一裴回。","谁知此地凋残柳，","尽是高欢败后栽。"],"stanzas":[["冯翊南边宿雾开，","行人一步一裴回。"],["谁知此地凋残柳，","尽是高欢败后栽。"]]}
{"id":"52ee42464c","title":"咏史诗 石城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古郢云开白雪楼，","汉江还绕石城流。","何人知道寥天月，","曾向朱门送莫愁。"],"stanzas":[["古郢云开白雪楼，","汉江还绕石城流。"],["何人知道寥天月，","曾向朱门送莫愁。"]]}
{"id":"208951bc83","title":"咏史诗 荆山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["抱玉岩前桂叶稠，","碧溪寒水至今流。","空山落日猨声呌，","疑是荆人哭未休。"],"stanzas":[["抱玉岩前桂叶稠，","碧溪寒水至今流。"],["空山落日猨声呌，","疑是荆人哭未休。"]]}
{"id":"26ba940b0b","title":"咏史诗 阳台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚国城池飒已空，","阳台云雨过无踪。","何人更有襄王梦，","寂寂巫山十二重。"],"stanzas":[["楚国城池飒已空，","阳台云雨过无踪。"],["何人更有襄王梦，","寂寂巫山十二重。"]]}
{"id":"ee19936cf1","title":"咏史诗 居延","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["漠漠平沙际碧天，","问人云此是居延。","停骖一顾犹魂断，","苏武争禁十九年。"],"stanzas":[["漠漠平沙际碧天，","问人云此是居延。"],["停骖一顾犹魂断，","苏武争禁十九年。"]]}
{"id":"50ab48d444","title":"咏史诗 沛宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉高辛苦事干戈，","帝业兴隆俊杰多。","犹恨四方无壮士，","还乡悲唱大风歌。"],"stanzas":[["汉高辛苦事干戈，","帝业兴隆俊杰多。"],["犹恨四方无壮士，","还乡悲唱大风歌。"]]}
{"id":"55d3a84cc5","title":"咏史诗 金谷园","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一自佳人坠玉楼，","繁华东逐洛河流。","唯余金谷园中树，","残日蝉声送客愁。"],"stanzas":[["一自佳人坠玉楼，","繁华东逐洛河流。"],["唯余金谷园中树，","残日蝉声送客愁。"]]}
{"id":"cab801e5a3","title":"咏史诗 湘川","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虞舜南捐万乘君，","灵妃挥涕竹成纹。","不知精魄游何处，","落日潇湘空白云。"],"stanzas":[["虞舜南捐万乘君，","灵妃挥涕竹成纹。"],["不知精魄游何处，","落日潇湘空白云。"]]}
{"id":"e794409360","title":"咏史诗 夷门","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六龙冉冉骤朝昏，","魏国贤才杳不存。","唯有侯嬴在时月，","夜来空自照夷门。"],"stanzas":[["六龙冉冉骤朝昏，","魏国贤才杳不存。"],["唯有侯嬴在时月，","夜来空自照夷门。"]]}
{"id":"401da6ab17","title":"咏史诗 黄金台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北乘羸马到燕然，","此地何人复礼贤。","若问昭王无处所，","黄金台上草连天。"],"stanzas":[["北乘羸马到燕然，","此地何人复礼贤。"],["若问昭王无处所，","黄金台上草连天。"]]}
{"id":"708d70e170","title":"咏史诗 夷陵","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夷陵城阙倚朝云，","战败秦师纵火焚。","何事三千珠履客，","不能西御武安君。"],"stanzas":[["夷陵城阙倚朝云，","战败秦师纵火焚。"],["何事三千珠履客，","不能西御武安君。"]]}
{"id":"b6788d4ce5","title":"咏史诗 汉江","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉江一带碧流长，","两岸春风起绿杨。","借问胶船何处没，","欲停兰棹祀昭王。"],"stanzas":[["汉江一带碧流长，","两岸春风起绿杨。"],["借问胶船何处没，","欲停兰棹祀昭王。"]]}
{"id":"b77096da43","title":"咏史诗 苍梧","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有虞龙驾不西还，","空委箫韶洞壑间。","无计得知陵寝处，","愁云长满九疑山。"],"stanzas":[["有虞龙驾不西还，","空委箫韶洞壑间。"],["无计得知陵寝处，","愁云长满九疑山。"]]}
{"id":"4bc812ca8e","title":"咏史诗 陈宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陈国机权未可涯，","如何后主恣娇奢。","不知即入宫中井，","犹自听吹玉树花。"],"stanzas":[["陈国机权未可涯，","如何后主恣娇奢。"],["不知即入宫中井，","犹自听吹玉树花。"]]}
{"id":"c20c8ee77e","title":"咏史诗 南阳","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世乱英雄百战余，","孔明方此乐耕锄。","蜀王不自垂三顾，","争得先生出旧庐。"],"stanzas":[["世乱英雄百战余，","孔明方此乐耕锄。"],["蜀王不自垂三顾，","争得先生出旧庐。"]]}
{"id":"821f416af5","title":"咏史诗 即墨","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["即墨门开纵火牛，","燕师营里血波流。","固存不得田单术，","齐国寻成一土丘。"],"stanzas":[["即墨门开纵火牛，","燕师营里血波流。"],["固存不得田单术，","齐国寻成一土丘。"]]}
{"id":"0047948fad","title":"咏史诗 渭滨","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岸草青青渭水流，","子牙曾此独垂钩。","当时未入非熊兆，","几向斜阳叹白头。"],"stanzas":[["岸草青青渭水流，","子牙曾此独垂钩。"],["当时未入非熊兆，","几向斜阳叹白头。"]]}
{"id":"f8b607edec","title":"咏史诗 五湖","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东上高山望五湖，","雪涛烟浪起天隅。","不知范蠡乘舟后，","更有功臣继踵无。"],"stanzas":[["东上高山望五湖，","雪涛烟浪起天隅。"],["不知范蠡乘舟后，","更有功臣继踵无。"]]}
{"id":"f01f7412d6","title":"咏史诗 易水","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一旦秦皇马角生，","燕丹归北送荆卿。","行人欲识无穷恨，","听取东流易水声。"],"stanzas":[["一旦秦皇马角生，","燕丹归北送荆卿。"],["行人欲识无穷恨，","听取东流易水声。"]]}
{"id":"de0332375f","title":"咏史诗 长平","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长平瓦震武安初，","赵卒俄成戏鼎鱼。","四十万人俱下世，","元戎何用读兵书。"],"stanzas":[["长平瓦震武安初，","赵卒俄成戏鼎鱼。"],["四十万人俱下世，","元戎何用读兵书。"]]}
{"id":"dab44182a6","title":"咏史诗 西园","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月满西园夜未央，","金风不动邺天凉。","高情公子多秋兴，","更领诗人入醉乡。"],"stanzas":[["月满西园夜未央，","金风不动邺天凉。"],["高情公子多秋兴，","更领诗人入醉乡。"]]}
{"id":"efea50ba93","title":"咏史诗 长沙","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江上南风起白苹，","长沙城郭异咸秦。","故乡犹自嫌卑湿，","何况当时赋鵩人。"],"stanzas":[["江上南风起白苹，","长沙城郭异咸秦。"],["故乡犹自嫌卑湿，","何况当时赋鵩人。"]]}
{"id":"d10283015d","title":"咏史诗 圯桥","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庙算张良独有余，","少年逃难下邳初。","逡巡不进泥中履，","争得先生一卷书。"],"stanzas":[["庙算张良独有余，","少年逃难下邳初。"],["逡巡不进泥中履，","争得先生一卷书。"]]}
{"id":"a125cc53e6","title":"咏史诗 铜雀台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魏武龙舆逐逝波，","高台空按望陵歌。","遏云声绝悲风起，","翻向樽前泣翠娥。"],"stanzas":[["魏武龙舆逐逝波，","高台空按望陵歌。"],["遏云声绝悲风起，","翻向樽前泣翠娥。"]]}
{"id":"a8e56cd058","title":"咏史诗 东晋","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石头城下浪崔嵬，","风起声疑出地雷。","何事苻坚太相小，","欲投鞭策过江来。"],"stanzas":[["石头城下浪崔嵬，","风起声疑出地雷。"],["何事苻坚太相小，","欲投鞭策过江来。"]]}
{"id":"2ed8ab4355","title":"咏史诗 吴江","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子胥今日委东流，","吴国明朝亦古丘。","大笑夫差诸将相，","更无人解守苏州。"],"stanzas":[["子胥今日委东流，","吴国明朝亦古丘。"],["大笑夫差诸将相，","更无人解守苏州。"]]}
{"id":"abc07a0f6b","title":"咏史诗 函谷关","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寂函关锁未开，","田文车马出秦来。","朱门不养三千客，","谁为鸡鸣得放回。"],"stanzas":[["寂寂函关锁未开，","田文车马出秦来。"],["朱门不养三千客，","谁为鸡鸣得放回。"]]}
{"id":"17da5eaaca","title":"咏史诗 武关","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["战国相持竟不休，","武关才掩楚王忧。","出门若取灵均语，","岂作咸阳一死囚。"],"stanzas":[["战国相持竟不休，","武关才掩楚王忧。"],["出门若取灵均语，","岂作咸阳一死囚。"]]}
{"id":"7ff2fe8e06","title":"咏史诗 垓下","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拔山力尽霸图隳，","倚剑空歌不逝骓。","明月满营天似水，","那堪回首别虞姬。"],"stanzas":[["拔山力尽霸图隳，","倚剑空歌不逝骓。"],["明月满营天似水，","那堪回首别虞姬。"]]}
{"id":"46b604e4ea","title":"咏史诗 郴县","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["义帝南迁路入郴，","国亡身死乱山深。","不知埋恨穷泉后，","几度西陵片月沈。"],"stanzas":[["义帝南迁路入郴，","国亡身死乱山深。"],["不知埋恨穷泉后，","几度西陵片月沈。"]]}
{"id":"d590421d00","title":"咏史诗 东海","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东巡玉辇委泉台，","徐福楼船尚未回。","自是祖龙先下世，","不关无路到蓬莱。"],"stanzas":[["东巡玉辇委泉台，","徐福楼船尚未回。"],["自是祖龙先下世，","不关无路到蓬莱。"]]}
{"id":"cd8ccc43c6","title":"咏史诗 故宜城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武安南伐勒秦兵，","疎凿功将夏禹并。","谁谓长渠千载后，","水流犹入故宜城。"],"stanzas":[["武安南伐勒秦兵，","疎凿功将夏禹并。"],["谁谓长渠千载后，","水流犹入故宜城。"]]}
{"id":"e1da2d2ae5","title":"咏史诗 成都","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杜宇曾为蜀帝王，","化禽飞去旧城荒。","年年来呌桃花月，","似向春风诉国亡。"],"stanzas":[["杜宇曾为蜀帝王，","化禽飞去旧城荒。"],["年年来呌桃花月，","似向春风诉国亡。"]]}
{"id":"99ecca05c4","title":"咏史诗 檀溪","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三月襄阳绿草齐，","王孙相引到檀溪。","的卢何处埋龙骨，","流水依前绕大堤。"],"stanzas":[["三月襄阳绿草齐，","王孙相引到檀溪。"],["的卢何处埋龙骨，","流水依前绕大堤。"]]}
{"id":"ec8f55d7a1","title":"咏史诗 青冢","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉貌元期汉帝招，","谁知西嫁怨天骄。","至今青冢愁云起，","疑是佳人恨未销。"],"stanzas":[["玉貌元期汉帝招，","谁知西嫁怨天骄。"],["至今青冢愁云起，","疑是佳人恨未销。"]]}
{"id":"48f16be653","title":"咏史诗 李陵台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北入单于万里疆，","五千兵败滞穷荒。","英雄不伏蛮夷死，","更筑高台望故乡。"],"stanzas":[["北入单于万里疆，","五千兵败滞穷荒。"],["英雄不伏蛮夷死，","更筑高台望故乡。"]]}
{"id":"b3ee61abbe","title":"咏史诗 河梁","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉家英杰出皇都，","携手河梁话入胡。","不是子卿全大节，","也应低首拜单于。"],"stanzas":[["汉家英杰出皇都，","携手河梁话入胡。"],["不是子卿全大节，","也应低首拜单于。"]]}
{"id":"10c7abbb4a","title":"咏史诗 轵道","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉祖西来秉白旄，","子婴宗庙委波涛。","谁怜君有翻身术，","解向秦宫杀赵高。"],"stanzas":[["汉祖西来秉白旄，","子婴宗庙委波涛。"],["谁怜君有翻身术，","解向秦宫杀赵高。"]]}
{"id":"12b4edce24","title":"咏史诗 汉宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明妃远嫁泣西风，","玉筯双垂出汉宫。","何事将军封万户，","却令红粉为和戎。"],"stanzas":[["明妃远嫁泣西风，","玉筯双垂出汉宫。"],["何事将军封万户，","却令红粉为和戎。"]]}
{"id":"d2262c50d4","title":"咏史诗 豫让桥","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["豫让酬恩岁已深，","高名不朽到如今。","年年桥上行人过，","谁有当时国士心。"],"stanzas":[["豫让酬恩岁已深，","高名不朽到如今。"],["年年桥上行人过，","谁有当时国士心。"]]}
{"id":"46b7e33207","title":"咏史诗 华亭","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陆机西没洛阳城，","吴国春风草又青。","惆怅月中千岁鹤，","夜来犹为唳华亭。"],"stanzas":[["陆机西没洛阳城，","吴国春风草又青。"],["惆怅月中千岁鹤，","夜来犹为唳华亭。"]]}
{"id":"92f87dd25d","title":"咏史诗 东山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五马南浮一化龙，","谢安入相此山空。","不知携妓重来日，","几树莺啼谷口风。"],"stanzas":[["五马南浮一化龙，","谢安入相此山空。"],["不知携妓重来日，","几树莺啼谷口风。"]]}
{"id":"7675694413","title":"咏史诗 杀子谷","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["举国贤良尽泪垂，","扶苏屈死树边时。","至今谷口泉呜咽，","犹似秦人恨李斯。"],"stanzas":[["举国贤良尽泪垂，","扶苏屈死树边时。"],["至今谷口泉呜咽，","犹似秦人恨李斯。"]]}
{"id":"b64732b1a0","title":"咏史诗 马陵","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坠叶萧萧九月天，","驱兵独过马陵前。","路傍古木虫书处，","记得将军破敌年。"],"stanzas":[["坠叶萧萧九月天，","驱兵独过马陵前。"],["路傍古木虫书处，","记得将军破敌年。"]]}
{"id":"2481dc0190","title":"咏史诗 玉门关","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西戎不敢过天山，","定远功成白马闲。","半夜帐中停烛坐，","唯思生入玉门关。"],"stanzas":[["西戎不敢过天山，","定远功成白马闲。"],["半夜帐中停烛坐，","唯思生入玉门关。"]]}
{"id":"7df8b2c5a6","title":"咏史诗 滹沱河","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["光武经营业未兴，","王郎兵革正凭陵。","须知后汉功臣力，","不及滹沱一片冰。"],"stanzas":[["光武经营业未兴，","王郎兵革正凭陵。"],["须知后汉功臣力，","不及滹沱一片冰。"]]}
{"id":"fb70ea203e","title":"咏史诗 黄河","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["博望沈埋不复旋，","黄河依旧水茫然。","沿流欲共牛郎语，","只得灵槎送上天。"],"stanzas":[["博望沈埋不复旋，","黄河依旧水茫然。"],["沿流欲共牛郎语，","只得灵槎送上天。"]]}
{"id":"ed40462a1f","title":"咏史诗 凤皇台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦娥一别凤皇台，","东入青冥更不回。","空有玉箫千载后，","遗声时到世间来。"],"stanzas":[["秦娥一别凤皇台，","东入青冥更不回。"],["空有玉箫千载后，","遗声时到世间来。"]]}
{"id":"924ae36ab1","title":"咏史诗 五丈原","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀相西驱十万来，","秋风原下久裴回。","长星不为英雄住，","半夜流光落九垓。"],"stanzas":[["蜀相西驱十万来，","秋风原下久裴回。"],["长星不为英雄住，","半夜流光落九垓。"]]}
{"id":"c4f7a5fcfe","title":"咏史诗 平城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉帝西征陷虏尘，","一朝围解议和亲。","当时已有吹毛剑，","何事无人杀奉春。"],"stanzas":[["汉帝西征陷虏尘，","一朝围解议和亲。"],["当时已有吹毛剑，","何事无人杀奉春。"]]}
{"id":"3ee1d47ae7","title":"咏史诗 汴水","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千里长河一旦开，","亡隋波浪九天来。","锦帆未落干戈起，","惆怅龙舟更不回。"],"stanzas":[["千里长河一旦开，","亡隋波浪九天来。"],["锦帆未落干戈起，","惆怅龙舟更不回。"]]}
{"id":"45e627927b","title":"咏史诗 兰台宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["迟迟春日满长空，","亡国离宫蔓草中。","宋玉不忧人事变，","从游那赋大王风。"],"stanzas":[["迟迟春日满长空，","亡国离宫蔓草中。"],["宋玉不忧人事变，","从游那赋大王风。"]]}
{"id":"60b61669e7","title":"咏史诗 金牛驿","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山岭千重拥蜀门，","成都别是一乾坤。","五丁不凿金牛路，","秦惠何由得并吞。"],"stanzas":[["山岭千重拥蜀门，","成都别是一乾坤。"],["五丁不凿金牛路，","秦惠何由得并吞。"]]}
{"id":"acc0899a2a","title":"咏史诗 望思台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太子衔冤去不回，","临臯从筑望思台。","至今汉武销魂处，","犹有悲风木上来。"],"stanzas":[["太子衔冤去不回，","临臯从筑望思台。"],["至今汉武销魂处，","犹有悲风木上来。"]]}
{"id":"69b8cc26e2","title":"咏史诗 邯郸","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓入邯郸十里春，","东风吹下玉楼尘。","青娥莫怪频含笑，","记得当年失步人。"],"stanzas":[["晓入邯郸十里春，","东风吹下玉楼尘。"],["青娥莫怪频含笑，","记得当年失步人。"]]}
{"id":"5038b5f105","title":"咏史诗 箕山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寂箕山春复秋，","更无人到此溪头。","弃瓢岩畔中宵月，","千古空闻属许由。"],"stanzas":[["寂寂箕山春复秋，","更无人到此溪头。"],["弃瓢岩畔中宵月，","千古空闻属许由。"]]}
{"id":"0a27879c31","title":"咏史诗 会稽山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越王兵败已山栖，","岂望全生出会稽。","何事夫差无远虑，","更开罗网放鲸鲵。"],"stanzas":[["越王兵败已山栖，","岂望全生出会稽。"],["何事夫差无远虑，","更开罗网放鲸鲵。"]]}
{"id":"12d4d8fb91","title":"咏史诗 不周山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共工争帝力穷秋，","因此捐生触不周。","遂使世间多感客，","至今哀怨水东流。"],"stanzas":[["共工争帝力穷秋，","因此捐生触不周。"],["遂使世间多感客，","至今哀怨水东流。"]]}
{"id":"b718db72e6","title":"咏史诗 虞坂","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悠悠虞坂路欹斜，","迟日和风簇野花。","未省孙阳身没后，","几多骐骥困盐车。"],"stanzas":[["悠悠虞坂路欹斜，","迟日和风簇野花。"],["未省孙阳身没后，","几多骐骥困盐车。"]]}
{"id":"87e836ddb0","title":"咏史诗 秦庭","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚国君臣草莽间，","吴王戈甲未东还。","包胥不动咸阳哭，","争得秦兵出武关。"],"stanzas":[["楚国君臣草莽间，","吴王戈甲未东还。"],["包胥不动咸阳哭，","争得秦兵出武关。"]]}
{"id":"9752e08f02","title":"咏史诗 延平津","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["延平津路水溶溶，","峭壁巍岑一万重。","昨夜七星潭底见，","分明神剑化为龙。"],"stanzas":[["延平津路水溶溶，","峭壁巍岑一万重。"],["昨夜七星潭底见，","分明神剑化为龙。"]]}
{"id":"830f8d1f27","title":"咏史诗 瑶池","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阿母瑶池宴穆王，","九天仙乐送琼浆。","漫矜八骏行如电，","归到人间国已亡。"],"stanzas":[["阿母瑶池宴穆王，","九天仙乐送琼浆。"],["漫矜八骏行如电，","归到人间国已亡。"]]}
{"id":"17d39fc10d","title":"咏史诗 铜柱","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一柱高标险塞垣，","南蛮不敢犯中原。","功成自合分茅土，","何事翻衔薏苡冤。"],"stanzas":[["一柱高标险塞垣，","南蛮不敢犯中原。"],["功成自合分茅土，","何事翻衔薏苡冤。"]]}
{"id":"65cbad9669","title":"咏史诗 关西","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨震幽魂下北邙，","关西踪迹遂荒凉。","四知美誉留人世，","应与乾坤共久长。"],"stanzas":[["杨震幽魂下北邙，","关西踪迹遂荒凉。"],["四知美誉留人世，","应与乾坤共久长。"]]}
{"id":"2f883d823a","title":"咏史诗 高阳池","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古人未遇即衔桮，","所贵愁肠得酒开。","何事山公持玉节，","等闲深入醉乡来。"],"stanzas":[["古人未遇即衔桮，","所贵愁肠得酒开。"],["何事山公持玉节，","等闲深入醉乡来。"]]}
{"id":"a46ce8c6db","title":"咏史诗 泸水","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五月驱兵入不毛，","月明泸水瘴烟高。","誓将雄略酬三顾，","岂惮征蛮七纵劳。"],"stanzas":[["五月驱兵入不毛，","月明泸水瘴烟高。"],["誓将雄略酬三顾，","岂惮征蛮七纵劳。"]]}
{"id":"cd52336735","title":"咏史诗 细柳营","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文帝銮舆劳北征，","条侯此地整严兵。","辕门不峻将军令，","今日争知细柳营。"],"stanzas":[["文帝銮舆劳北征，","条侯此地整严兵。"],["辕门不峻将军令，","今日争知细柳营。"]]}
{"id":"76644536ed","title":"咏史诗 叶县","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叶公丘墓已尘埃，","云矗崇墉亦半摧。","借问往年龙见日，","几多风雨送将来。"],"stanzas":[["叶公丘墓已尘埃，","云矗崇墉亦半摧。"],["借问往年龙见日，","几多风雨送将来。"]]}
{"id":"10634beaf1","title":"咏史诗 杜邮","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自古功成祸亦侵，","武安冤向杜邮深。","五湖烟月无穷水，","何事迁延到陆沈。"],"stanzas":[["自古功成祸亦侵，","武安冤向杜邮深。"],["五湖烟月无穷水，","何事迁延到陆沈。"]]}
{"id":"169f925c70","title":"咏史诗 柯亭","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一宿柯亭月满天，","笛亡人没事空传。","中郎在世无甄别，","争得名垂尔许年。"],"stanzas":[["一宿柯亭月满天，","笛亡人没事空传。"],["中郎在世无甄别，","争得名垂尔许年。"]]}
{"id":"c7b29dfcaa","title":"咏史诗 葛陂","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长房回到葛陂中，","人已登真竹化龙。","莫道神仙难顿学，","嵇生自是不遭逢。"],"stanzas":[["长房回到葛陂中，","人已登真竹化龙。"],["莫道神仙难顿学，","嵇生自是不遭逢。"]]}
{"id":"e15928d2e2","title":"咏史诗 博浪沙","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嬴政鲸吞六合秋，","削平天下虏诸侯。","山东不是无公子，","何事张良独报讐。"],"stanzas":[["嬴政鲸吞六合秋，","削平天下虏诸侯。"],["山东不是无公子，","何事张良独报讐。"]]}
{"id":"301d0fddcc","title":"咏史诗 陇西","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乘春来到陇山西，","隗氏城荒碧草齐。","好笑王元不量力，","函关那受一丸泥。"],"stanzas":[["乘春来到陇山西，","隗氏城荒碧草齐。"],["好笑王元不量力，","函关那受一丸泥。"]]}
{"id":"99d39a8ee5","title":"咏史诗 白帝城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀江一带向东倾，","江上巍峩白帝城。","自古山河归圣主，","子阳虚共汉家争。"],"stanzas":[["蜀江一带向东倾，","江上巍峩白帝城。"],["自古山河归圣主，","子阳虚共汉家争。"]]}
{"id":"0f8e9c0a84","title":"咏史诗 牛渚","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["温峤南归辍棹晨，","燃犀牛渚照通津。","谁知万丈洪流下，","更有朱衣跃马人。"],"stanzas":[["温峤南归辍棹晨，","燃犀牛渚照通津。"],["谁知万丈洪流下，","更有朱衣跃马人。"]]}
{"id":"11791bbe9b","title":"咏史诗 朝歌","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长嗟墨翟少风流，","急管繁弦似寇讐。","若解闻韶知肉味，","朝歌欲到肯回头。"],"stanzas":[["长嗟墨翟少风流，","急管繁弦似寇讐。"],["若解闻韶知肉味，","朝歌欲到肯回头。"]]}
{"id":"0e83cd5d06","title":"咏史诗 谷口","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一旦天真逐水流，","虎争龙战为诸侯。","子真独有烟霞趣，","谷口耕锄到白头。"],"stanzas":[["一旦天真逐水流，","虎争龙战为诸侯。"],["子真独有烟霞趣，","谷口耕锄到白头。"]]}
{"id":"4a7e529214","title":"咏史诗 武陵溪","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一溪春水彻云根，","流出桃花片片新。","若到长生是虚语，","洞中争得有秦人。"],"stanzas":[["一溪春水彻云根，","流出桃花片片新。"],["若到长生是虚语，","洞中争得有秦人。"]]}
{"id":"01e4535620","title":"咏史诗 大泽","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白蛇初断路人通，","汉祖龙泉血刃红。","不是咸阳将瓦解，","素灵那哭月明中。"],"stanzas":[["白蛇初断路人通，","汉祖龙泉血刃红。"],["不是咸阳将瓦解，","素灵那哭月明中。"]]}
{"id":"5bf46ae95d","title":"咏史诗 渑池","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日照荒城芳草新，","相如曾此挫强秦。","能令百二山河主，","便作樽前击缶人。"],"stanzas":[["日照荒城芳草新，","相如曾此挫强秦。"],["能令百二山河主，","便作樽前击缶人。"]]}
{"id":"7a706e5c78","title":"咏史诗 岘山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓日登临感晋臣，","古碑零落岘山春。","松间残露频频滴，","酷似当时堕泪人。"],"stanzas":[["晓日登临感晋臣，","古碑零落岘山春。"],["松间残露频频滴，","酷似当时堕泪人。"]]}
{"id":"5896ecb62d","title":"咏史诗 荥阳","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉祖东征屈未伸，","荥阳失律纪生焚。","当时天下方龙战，","谁为将军作诔文。"],"stanzas":[["汉祖东征屈未伸，","荥阳失律纪生焚。"],["当时天下方龙战，","谁为将军作诔文。"]]}
{"id":"bd0c92bb69","title":"咏史诗 长城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["祖舜宗尧自太平，","秦皇何事苦苍生。","不知祸起萧墙内，","虚筑防胡万里城。"],"stanzas":[["祖舜宗尧自太平，","秦皇何事苦苍生。"],["不知祸起萧墙内，","虚筑防胡万里城。"]]}
{"id":"f65f97e660","title":"咏史诗 赤壁","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烈火西焚魏帝旗，","周郎开国虎争时。","交兵不假挥长剑，","已挫英雄百万师。"],"stanzas":[["烈火西焚魏帝旗，","周郎开国虎争时。"],["交兵不假挥长剑，","已挫英雄百万师。"]]}
{"id":"850128101f","title":"咏史诗 田横墓","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古墓崔巍约路岐，","歌传薤露到今时。","也知不去朝黄屋，","祗为曾烹郦食其。"],"stanzas":[["古墓崔巍约路岐，","歌传薤露到今时。"],["也知不去朝黄屋，","祗为曾烹郦食其。"]]}
{"id":"51fb613926","title":"咏史诗 青门","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉皇提剑灭咸秦，","亡国诸侯尽是臣。","唯有东陵守高节，","青门甘作种瓜人。"],"stanzas":[["汉皇提剑灭咸秦，","亡国诸侯尽是臣。"],["唯有东陵守高节，","青门甘作种瓜人。"]]}
{"id":"ee490a33e6","title":"咏史诗 姑苏台","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴王恃霸弃雄才，","贪向姑苏醉醁醅。","不觉钱塘江上月，","一宵西送越兵来。"],"stanzas":[["吴王恃霸弃雄才，","贪向姑苏醉醁醅。"],["不觉钱塘江上月，","一宵西送越兵来。"]]}
{"id":"4a9f36aade","title":"咏史诗 息城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["息亡身入楚王家，","回首春风一面花。","感旧不言长掩泪，","秪应翻恨有容华。"],"stanzas":[["息亡身入楚王家，","回首春风一面花。"],["感旧不言长掩泪，","秪应翻恨有容华。"]]}
{"id":"c0a30eeb3b","title":"咏史诗 上蔡","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上蔡东门狡兔肥，","李斯何事忘南归。","功成不解谋身退，","直待云阳血染衣。"],"stanzas":[["上蔡东门狡兔肥，","李斯何事忘南归。"],["功成不解谋身退，","直待云阳血染衣。"]]}
{"id":"924bac611a","title":"咏史诗 武昌","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["王濬戈鋋发上流，","武昌鸿业土崩秋。","思量铁锁真儿戏，","谁为吴王画此筹。"],"stanzas":[["王濬戈鋋发上流，","武昌鸿业土崩秋。"],["思量铁锁真儿戏，","谁为吴王画此筹。"]]}
{"id":"6aa3db9391","title":"咏史诗 鸿沟","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虎倦龙疲白刃秋，","两分天下指鸿沟。","项王不觉英雄挫，","欲向彭门醉玉楼。"],"stanzas":[["虎倦龙疲白刃秋，","两分天下指鸿沟。"],["项王不觉英雄挫，","欲向彭门醉玉楼。"]]}
{"id":"bab7760eeb","title":"咏史诗 襃城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恃宠娇多得自由，","骊山举火戏诸侯。","秪知一笑倾人国，","不觉胡尘满玉楼。"],"stanzas":[["恃宠娇多得自由，","骊山举火戏诸侯。"],["秪知一笑倾人国，","不觉胡尘满玉楼。"]]}
{"id":"c15b20c6b5","title":"咏史诗 金陵","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侯景长驱十万人，","可怜梁武坐蒙尘。","生前不得空王力，","徒向金田自舍身。"],"stanzas":[["侯景长驱十万人，","可怜梁武坐蒙尘。"],["生前不得空王力，","徒向金田自舍身。"]]}
{"id":"4978fc60ae","title":"咏史诗 洛阳","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石勒童年有战机，","洛阳长啸倚门时。","晋朝不是王夷甫，","大智何由得预知。"],"stanzas":[["石勒童年有战机，","洛阳长啸倚门时。"],["晋朝不是王夷甫，","大智何由得预知。"]]}
{"id":"08e3fecd5e","title":"咏史诗 番禺","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重冈复岭势崔巍，","一卒当关万卒回。","不是大夫多辨说，","尉他争肯筑朝台。"],"stanzas":[["重冈复岭势崔巍，","一卒当关万卒回。"],["不是大夫多辨说，","尉他争肯筑朝台。"]]}
{"id":"ec04f99fda","title":"咏史诗 汨罗","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["襄王不用直臣筹，","放逐南来泽国秋。","自向波间葬鱼腹，","楚人徒倚济川舟。"],"stanzas":[["襄王不用直臣筹，","放逐南来泽国秋。"],["自向波间葬鱼腹，","楚人徒倚济川舟。"]]}
{"id":"e11f6d4d0c","title":"咏史诗 彭泽","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["英杰那堪屈下僚，","便栽门柳事萧条。","凤皇不共鸡争食，","莫怪先生懒折腰。"],"stanzas":[["英杰那堪屈下僚，","便栽门柳事萧条。"],["凤皇不共鸡争食，","莫怪先生懒折腰。"]]}
{"id":"d281c49fe5","title":"咏史诗 涿鹿","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["涿鹿茫茫白草秋，","轩辕曾此破蚩尤。","丹霞遥映祠前水，","疑是成川血尚流。"],"stanzas":[["涿鹿茫茫白草秋，","轩辕曾此破蚩尤。"],["丹霞遥映祠前水，","疑是成川血尚流。"]]}
{"id":"a372086db5","title":"咏史诗 洞庭","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五月扁舟过洞庭，","鱼龙吹浪水云腥。","轩辕黄帝今何在，","回首巴山芦叶青。"],"stanzas":[["五月扁舟过洞庭，","鱼龙吹浪水云腥。"],["轩辕黄帝今何在，","回首巴山芦叶青。"]]}
{"id":"89e3cac0d7","title":"咏史诗 嶓冢","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夏禹崩来一万秋，","水从嶓冢至今流。","当时若诉胼胝苦，","更使何人别九州。"],"stanzas":[["夏禹崩来一万秋，","水从嶓冢至今流。"],["当时若诉胼胝苦，","更使何人别九州。"]]}
{"id":"cde1c577ec","title":"咏史诗 涂山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大禹涂山御座开，","诸侯玉帛走如雷。","防风谩有专车骨，","何事兹辰最后来。"],"stanzas":[["大禹涂山御座开，","诸侯玉帛走如雷。"],["防风谩有专车骨，","何事兹辰最后来。"]]}
{"id":"1e69b98e54","title":"咏史诗 商郊","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莺啭商郊百草新，","殷汤遗迹在荒榛。","谁知继桀为天子，","便是当初祝网人。"],"stanzas":[["莺啭商郊百草新，","殷汤遗迹在荒榛。"],["谁知继桀为天子，","便是当初祝网人。"]]}
{"id":"4541528f18","title":"咏史诗 傅岩","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岩前版筑不求伸，","方寸那希据要津。","自是武丁安寝夜，","一宵宫里梦贤人。"],"stanzas":[["岩前版筑不求伸，","方寸那希据要津。"],["自是武丁安寝夜，","一宵宫里梦贤人。"]]}
{"id":"0a67b901d8","title":"咏史诗 巨桥","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["积粟成尘竟不开，","谁知拒谏剖贤才。","武王兵起无人敌，","遂作商郊一聚灰。"],"stanzas":[["积粟成尘竟不开，","谁知拒谏剖贤才。"],["武王兵起无人敌，","遂作商郊一聚灰。"]]}
{"id":"4e7fc42c3a","title":"咏史诗 首阳山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤竹夷齐耻战争，","望尘遮道请休兵。","首阳山倒为平地，","应始无人说姓名。"],"stanzas":[["孤竹夷齐耻战争，","望尘遮道请休兵。"],["首阳山倒为平地，","应始无人说姓名。"]]}
{"id":"ad33c13acb","title":"咏史诗 孟津","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋风飒飒孟津头，","立马沙边看水流。","见说武王东渡日，","戎衣曾此叱阳侯。"],"stanzas":[["秋风飒飒孟津头，","立马沙边看水流。"],["见说武王东渡日，","戎衣曾此叱阳侯。"]]}
{"id":"ecf245a8b9","title":"咏史诗 流沙","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["七雄戈戟乱如麻，","四海无人得坐家。","老氏却思天竺住，","便将徐甲去流沙。"],"stanzas":[["七雄戈戟乱如麻，","四海无人得坐家。"],["老氏却思天竺住，","便将徐甲去流沙。"]]}
{"id":"61773eeaa4","title":"咏史诗 邓城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["邓侯城垒汉江干，","自谓深根百世安。","不用三甥谋楚计，","临危方觉噬脐难。"],"stanzas":[["邓侯城垒汉江干，","自谓深根百世安。"],["不用三甥谋楚计，","临危方觉噬脐难。"]]}
{"id":"c3f17de662","title":"咏史诗 召陵","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["小白匡周入楚郊，","楚王雄霸亦咆哮。","不思管仲为谋主，","争取言征缩酒茅。"],"stanzas":[["小白匡周入楚郊，","楚王雄霸亦咆哮。"],["不思管仲为谋主，","争取言征缩酒茅。"]]}
{"id":"316b47f000","title":"咏史诗 绵山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亲在要君召不来，","乱山重叠使空回。","如何坚执尤人意，","甘向岩前作死灰。"],"stanzas":[["亲在要君召不来，","乱山重叠使空回。"],["如何坚执尤人意，","甘向岩前作死灰。"]]}
{"id":"aab529cb5d","title":"咏史诗 鲁城","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鲁公城阙已丘墟，","荒草无由认玉除。","因笑臧孙才智少，","东门钟鼓祀鶢鶋。"],"stanzas":[["鲁公城阙已丘墟，","荒草无由认玉除。"],["因笑臧孙才智少，","东门钟鼓祀鶢鶋。"]]}
{"id":"fd4aa792ed","title":"咏史诗 骕骦陂","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行行西至一荒陂，","因笑唐公不见机。","莫惜骕骦输令尹，","汉东宫阙早时归。"],"stanzas":[["行行西至一荒陂，","因笑唐公不见机。"],["莫惜骕骦输令尹，","汉东宫阙早时归。"]]}
{"id":"5249e98f6c","title":"咏史诗 夹谷","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夹谷莺啼三月天，","野花芳草整相鲜。","来时不见侏儒死，","空笑齐人失措年。"],"stanzas":[["夹谷莺啼三月天，","野花芳草整相鲜。"],["来时不见侏儒死，","空笑齐人失措年。"]]}
{"id":"3560daf4a7","title":"咏史诗 吴宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["草长黄池千里余，","归来宗庙已丘墟。","出师不听忠臣谏，","徒耻穷泉见子胥。"],"stanzas":[["草长黄池千里余，","归来宗庙已丘墟。"],["出师不听忠臣谏，","徒耻穷泉见子胥。"]]}
{"id":"cac0b753aa","title":"咏史诗 摩笄山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春草绵绵岱日低，","山边立马看摩笄。","黄莺也解追前事，","来向夫人死处啼。"],"stanzas":[["春草绵绵岱日低，","山边立马看摩笄。"],["黄莺也解追前事，","来向夫人死处啼。"]]}
{"id":"9c19c7d54a","title":"咏史诗 房陵","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赵王一旦到房陵，","国破家亡百恨增。","魂断丛台归不得，","夜来明月为谁升。"],"stanzas":[["赵王一旦到房陵，","国破家亡百恨增。"],["魂断丛台归不得，","夜来明月为谁升。"]]}
{"id":"484238792b","title":"咏史诗 濮水","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青春行役思悠悠，","一曲汀蒲濮水流。","正见涂中龟曳尾，","令人特地感庄周。"],"stanzas":[["青春行役思悠悠，","一曲汀蒲濮水流。"],["正见涂中龟曳尾，","令人特地感庄周。"]]}
{"id":"c1491b4e8b","title":"咏史诗 柏举","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野田极目草茫茫，","吴楚交兵此路傍。","谁料伍员入郢后，","大开陵寝挞平王。"],"stanzas":[["野田极目草茫茫，","吴楚交兵此路傍。"],["谁料伍员入郢后，","大开陵寝挞平王。"]]}
{"id":"ffb188dcf7","title":"咏史诗 望夫山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一上青山便化身，","不知何代怨离人。","古来节妇皆销朽，","独尔不为泉下尘。"],"stanzas":[["一上青山便化身，","不知何代怨离人。"],["古来节妇皆销朽，","独尔不为泉下尘。"]]}
{"id":"608b0cab48","title":"咏史诗 金义岭","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凿开山岭引湘波，","上去昭回不较多。","无限鹊临桥畔立，","适来天道过天河。"],"stanzas":[["凿开山岭引湘波，","上去昭回不较多。"],["无限鹊临桥畔立，","适来天道过天河。"]]}
{"id":"4e63c4a8b7","title":"咏史诗 云云亭","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一上高亭日正晡，","青山重叠片云无。","万年松树不知数，","若个蚪枝是大夫。"],"stanzas":[["一上高亭日正晡，","青山重叠片云无。"],["万年松树不知数，","若个蚪枝是大夫。"]]}
{"id":"93f16edc91","title":"咏史诗 阿房宫","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新建阿房壁未干，","沛公兵已入长安。","帝王苦竭生灵力，","大业沙崩固不难。"],"stanzas":[["新建阿房壁未干，","沛公兵已入长安。"],["帝王苦竭生灵力，","大业沙崩固不难。"]]}
{"id":"e94560cbf5","title":"咏史诗 沙丘","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年年游览不曾停，","天下山川欲遍经。","堪笑沙丘才过处，","銮舆风过鲍鱼腥。"],"stanzas":[["年年游览不曾停，","天下山川欲遍经。"],["堪笑沙丘才过处，","銮舆风过鲍鱼腥。"]]}
{"id":"5a42b78511","title":"咏史诗 咸阳","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一朝阎乐统群凶，","二世朝廷扫地空。","唯有渭川流不尽，","至今犹绕望夷宫。"],"stanzas":[["一朝阎乐统群凶，","二世朝廷扫地空。"],["唯有渭川流不尽，","至今犹绕望夷宫。"]]}
{"id":"fe64616880","title":"咏史诗 废丘山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此水虽非禹凿开，","废丘山下重萦回。","莫言只解东流去，","曾使章邯自杀来。"],"stanzas":[["此水虽非禹凿开，","废丘山下重萦回。"],["莫言只解东流去，","曾使章邯自杀来。"]]}
{"id":"0fc1399c5c","title":"咏史诗 广武山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数罪楚师应夺气，","底须多论破深艰。","仓皇鬬智成何语，","遗笑当时广武山。"],"stanzas":[["数罪楚师应夺气，","底须多论破深艰。"],["仓皇鬬智成何语，","遗笑当时广武山。"]]}
{"id":"b19d51280d","title":"咏史诗 长安","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["关东新破项王归，","赤帜悠扬日月旗。","从此汉家无敌国，","争教彭越受诛夷。"],"stanzas":[["关东新破项王归，","赤帜悠扬日月旗。"],["从此汉家无敌国，","争教彭越受诛夷。"]]}
{"id":"559842922b","title":"咏史诗 鸿门","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["项籍鹰扬六合晨，","鸿门开宴贺亡秦。","樽前若取谋臣计，","岂作阴陵失路人。"],"stanzas":[["项籍鹰扬六合晨，","鸿门开宴贺亡秦。"],["樽前若取谋臣计，","岂作阴陵失路人。"]]}
{"id":"0c621370e9","title":"咏史诗 汉中","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荆棘苍苍汉水湄，","将坛烟草覆余基。","适来投石空江上，","犹似龙颜纳谏时。"],"stanzas":[["荆棘苍苍汉水湄，","将坛烟草覆余基。"],["适来投石空江上，","犹似龙颜纳谏时。"]]}
{"id":"f57b5221da","title":"咏史诗 泜水","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["韩信经营按镆铘，","临戎叱咤有谁加。","犹疑转战逢勍敌，","更向军中问左车。"],"stanzas":[["韩信经营按镆铘，","临戎叱咤有谁加。"],["犹疑转战逢勍敌，","更向军中问左车。"]]}
{"id":"188bddbe6f","title":"咏史诗 云梦","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉祖听谗不可防，","伪游韩信果罹殃。","十年辛苦平天下，","何事生擒入帝乡。"],"stanzas":[["汉祖听谗不可防，","伪游韩信果罹殃。"],["十年辛苦平天下，","何事生擒入帝乡。"]]}
{"id":"d0b51d43bb","title":"咏史诗 高阳","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["路入高阳感郦生，","逢时长揖便论兵。","最怜伏轼东游日，","下尽齐王七十城。"],"stanzas":[["路入高阳感郦生，","逢时长揖便论兵。"],["最怜伏轼东游日，","下尽齐王七十城。"]]}
{"id":"ee7a34e81a","title":"咏史诗 四皓庙","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["四皓忘机饮碧松，","石岩云殿隐高踪。","不知俱出龙楼后，","多在商山第几重。"],"stanzas":[["四皓忘机饮碧松，","石岩云殿隐高踪。"],["不知俱出龙楼后，","多在商山第几重。"]]}
{"id":"e5f6f80b15","title":"咏史诗 霸陵","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["原头日落雪边云，","犹放韩卢逐兔群。","况是四方无事日，","霸陵谁识旧将军。"],"stanzas":[["原头日落雪边云，","犹放韩卢逐兔群。"],["况是四方无事日，","霸陵谁识旧将军。"]]}
{"id":"b77009e2a6","title":"咏史诗 昆明池","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲出昆明万里师，","汉皇习战此穿池。","如何一面图攻取，","不念生灵气力疲。"],"stanzas":[["欲出昆明万里师，","汉皇习战此穿池。"],["如何一面图攻取，","不念生灵气力疲。"]]}
{"id":"54aa52ac34","title":"咏史诗 回中","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武皇无路及昆丘，","青鸟西沈陇树秋。","欲问生前躬祀日，","几烦龙驾到泾州。"],"stanzas":[["武皇无路及昆丘，","青鸟西沈陇树秋。"],["欲问生前躬祀日，","几烦龙驾到泾州。"]]}
{"id":"351cb2beee","title":"咏史诗 东门","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何人知足反田庐，","玉管东门饯二疏。","岂是不荣天子禄，","后贤那使久闲居。"],"stanzas":[["何人知足反田庐，","玉管东门饯二疏。"],["岂是不荣天子禄，","后贤那使久闲居。"]]}
{"id":"c5fbd41820","title":"咏史诗 射熊馆","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉帝荒唐不解忧，","大夸田猎废农收。","子云徒献长杨赋，","肯念高皇沐雨秋。"],"stanzas":[["汉帝荒唐不解忧，","大夸田猎废农收。"],["子云徒献长杨赋，","肯念高皇沐雨秋。"]]}
{"id":"ce0488bcbc","title":"咏史诗 昆阳","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师克由来在协和，","萧王兵马固无多。","谁知大敌昆阳败，","却笑前朝困楚歌。"],"stanzas":[["师克由来在协和，","萧王兵马固无多。"],["谁知大敌昆阳败，","却笑前朝困楚歌。"]]}
{"id":"65f7355a25","title":"咏史诗 七里滩","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["七里青滩映碧层，","九天星象感严陵。","钓鱼台上无丝竹，","不是高人谁解登。"],"stanzas":[["七里青滩映碧层，","九天星象感严陵。"],["钓鱼台上无丝竹，","不是高人谁解登。"]]}
{"id":"11a459577c","title":"咏史诗 颍川","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古贤高尚不争名，","行止由来动杳冥。","今日浪为千里客，","看花慙上德星亭。"],"stanzas":[["古贤高尚不争名，","行止由来动杳冥。"],["今日浪为千里客，","看花慙上德星亭。"]]}
{"id":"eb6ff0ea12","title":"咏史诗 江夏","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄祖才非长者俦，","祢衡珠碎此江头。","今来鹦鹉洲边过，","惟有无情碧水流。"],"stanzas":[["黄祖才非长者俦，","祢衡珠碎此江头。"],["今来鹦鹉洲边过，","惟有无情碧水流。"]]}
{"id":"0e34f3c114","title":"咏史诗 官渡","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["本初屈指定中华，","官渡相持勒虎牙。","若使许攸财用足，","山河争得属曹家。"],"stanzas":[["本初屈指定中华，","官渡相持勒虎牙。"],["若使许攸财用足，","山河争得属曹家。"]]}
{"id":"15055689d5","title":"咏史诗 灞岸","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安城外白云秋，","萧索悲风灞水流。","因想汉朝离乱日，","仲宣从此向荆州。"],"stanzas":[["长安城外白云秋，","萧索悲风灞水流。"],["因想汉朝离乱日，","仲宣从此向荆州。"]]}
{"id":"f9afc6a195","title":"咏史诗 濡须桥","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["徒向濡须欲受降，","英雄才略独无双。","天心不与金陵便，","高步何由得渡江。"],"stanzas":[["徒向濡须欲受降，","英雄才略独无双。"],["天心不与金陵便，","高步何由得渡江。"]]}
{"id":"14a2aadbf1","title":"咏史诗 豫州","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["策马行行到豫州，","祖生寂寞水空流。","当时更有三年寿，","石勒寻为关下囚。"],"stanzas":[["策马行行到豫州，","祖生寂寞水空流。"],["当时更有三年寿，","石勒寻为关下囚。"]]}
{"id":"3bba2b1eeb","title":"咏史诗 八公山","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苻坚举国出西秦，","东晋危如累卵晨。","谁料此山诸草木，","尽能排难化为人。"],"stanzas":[["苻坚举国出西秦，","东晋危如累卵晨。"],["谁料此山诸草木，","尽能排难化为人。"]]}
{"id":"f9dcd2db8d","title":"下第","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翰苑何时休嫁女，","文昌早晚罢生儿。","上林新桂年年发，","不许平人折一枝。"],"stanzas":[["翰苑何时休嫁女，","文昌早晚罢生儿。"],["上林新桂年年发，","不许平人折一枝。"]]}
{"id":"c25a92b53e","title":"赠薛涛","author":"胡曾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里桥边女校书，","枇杷花下闭门居。","扫眉才子知多少，","管领春风总不如。"],"stanzas":[["万里桥边女校书，","枇杷花下闭门居。"],["扫眉才子知多少，","管领春风总不如。"]]}
{"id":"f453980f6a","title":"采莲","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["采莲女儿避残热，","隔夜相期侵早发。","指剥春葱腕似雪，","画桡轻拨蒲根月。","兰舟迟速有输赢，","先到河湾赌何物。","才到河湾分首去，","散在花间不知处。"],"stanzas":[["采莲女儿避残热，","隔夜相期侵早发。"],["指剥春葱腕似雪，","画桡轻拨蒲根月。"],["兰舟迟速有输赢，","先到河湾赌何物。"],["才到河湾分首去，","散在花间不知处。"]]}
{"id":"0f41cd10fa","title":"寄李频","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["众木又摇落，","望君还不还。","轩车在何处，","雨雪满前山。","思苦文星动，","乡遥钓渚闲。","明年见名姓，","唯我独何颜。"],"stanzas":[["众木又摇落，","望君还不还。"],["轩车在何处，","雨雪满前山。"],["思苦文星动，","乡遥钓渚闲。"],["明年见名姓，","唯我独何颜。"]]}
{"id":"1462f91ba6","title":"东溪别业寄吉州段郎中","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前山含远翠，","罗列在窗中。","尽日人不到，","一尊谁与同。","凉随莲叶雨，","暑避柳条风。","岂分长岑寂，","明时有至公。"],"stanzas":[["前山含远翠，","罗列在窗中。"],["尽日人不到，","一尊谁与同。"],["凉随莲叶雨，","暑避柳条风。"],["岂分长岑寂，","明时有至公。"]]}
{"id":"aba0328ffc","title":"怀州客舍","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["误饮覃怀酒，","谁知滞去程。","朝昏太行色，","坐卧沁河声。","白道穿秦甸，","严鼙似戍城。","邻鸡莫相促，","游子自晨征。"],"stanzas":[["误饮覃怀酒，","谁知滞去程。"],["朝昏太行色，","坐卧沁河声。"],["白道穿秦甸，","严鼙似戍城。"],["邻鸡莫相促，","游子自晨征。"]]}
{"id":"3652d8d06b","title":"中路寄喻凫先辈","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["求名如未遂，","白首亦难归。","送我尊前酒，","典君身上衣。","寒芜随楚尽，","落叶渡淮稀。","莫叹干时晚，","前心岂便非。"],"stanzas":[["求名如未遂，","白首亦难归。"],["送我尊前酒，","典君身上衣。"],["寒芜随楚尽，","落叶渡淮稀。"],["莫叹干时晚，","前心岂便非。"]]}
{"id":"85381942dc","title":"送赵明府还北","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故园终不住，","剑鹤在扁舟。","尽室无余俸，","还家得白头。","钟催吴岫晓，","月绕渭河流。","曾是栖安邑，","恩期异日酬。"],"stanzas":[["故园终不住，","剑鹤在扁舟。"],["尽室无余俸，","还家得白头。"],["钟催吴岫晓，","月绕渭河流。"],["曾是栖安邑，","恩期异日酬。"]]}
{"id":"33e6f18d8e","title":"过朱协律故山","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["地下无余恨，","人间得盛名。","残篇续大雅，","稚子托诸生。","度日山空暮，","缘溪鹤自鸣。","难收故交意，","寒笛一声声。"],"stanzas":[["地下无余恨，","人间得盛名。"],["残篇续大雅，","稚子托诸生。"],["度日山空暮，","缘溪鹤自鸣。"],["难收故交意，","寒笛一声声。"]]}
{"id":"faefffeba2","title":"途中寄刘沆","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["登车误相远，","谈笑亦何因。","路入潇湘树，","书随巴蜀人。","歛衣寒犯雪，","倾箧病看春。","莫负髫年志，","清朝作献臣。"],"stanzas":[["登车误相远，","谈笑亦何因。"],["路入潇湘树，","书随巴蜀人。"],["歛衣寒犯雪，","倾箧病看春。"],["莫负髫年志，","清朝作献臣。"]]}
{"id":"b11431e564","title":"送班主簿入谒荆南韦常侍","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["束书成远去，","还计莫经春。","倒箧唯求醉，","登舟自笑贫。","波移彭蠡月，","树没汉陵人。","试吏曾趋府，","旌幢自可亲。"],"stanzas":[["束书成远去，","还计莫经春。"],["倒箧唯求醉，","登舟自笑贫。"],["波移彭蠡月，","树没汉陵人。"],["试吏曾趋府，","旌幢自可亲。"]]}
{"id":"4cd6c89fcb","title":"夏日登灵隐寺后峰","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绝顶无烦暑，","登临三伏中。","深萝难透日，","乔木更含风。","山叠云霞际，","川倾世界东。","那知兹夕兴，","不与古人同。"],"stanzas":[["绝顶无烦暑，","登临三伏中。"],["深萝难透日，","乔木更含风。"],["山叠云霞际，","川倾世界东。"],["那知兹夕兴，","不与古人同。"]]}
{"id":"e1adae26c7","title":"听新蝉寄张昼","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细声频断续，","审听亦难分。","髣髴应移处，","从容却不闻。","兰栖朝咽露，","树隐暝吟云。","莫遣乡愁起，","吾怀祗是君。"],"stanzas":[["细声频断续，","审听亦难分。"],["髣髴应移处，","从容却不闻。"],["兰栖朝咽露，","树隐暝吟云。"],["莫遣乡愁起，","吾怀祗是君。"]]}
{"id":"bf167fbf5a","title":"送喻坦之下第还江东","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文战偶未胜，","无令移壮心。","风尘辞帝里，","舟檝到家林。","过楚寒方尽，","浮淮月正沈。","持杯话来日，","不听洞庭砧。"],"stanzas":[["文战偶未胜，","无令移壮心。"],["风尘辞帝里，","舟檝到家林。"],["过楚寒方尽，","浮淮月正沈。"],["持杯话来日，","不听洞庭砧。"]]}
{"id":"510c1535d6","title":"送姚舒下第游蜀","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀路何迢递，","怜君独去游。","风烟连北虏，","山水似东瓯。","九折盘荒坂，","重江绕汉州。","临邛一壶酒，","能遣长卿愁。"],"stanzas":[["蜀路何迢递，","怜君独去游。"],["风烟连北虏，","山水似东瓯。"],["九折盘荒坂，","重江绕汉州。"],["临邛一壶酒，","能遣长卿愁。"]]}
{"id":"3d3fe3e7d4","title":"旅次钱塘","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此地似乡国，","堪为朝夕吟。","云藏吴相庙，","树引越山禽。","潮落海人散，","钟迟秋寺深。","我来无旧识，","谁见寂寥心。"],"stanzas":[["此地似乡国，","堪为朝夕吟。"],["云藏吴相庙，","树引越山禽。"],["潮落海人散，","钟迟秋寺深。"],["我来无旧识，","谁见寂寥心。"]]}
{"id":"c3d44ac06c","title":"别喻凫","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["知心似古人，","岁久分弥亲。","离别波涛阔，","留连槐柳新。","蟆陵寒贳酒，","渔浦夜垂纶。","自此星居后，","音书岂厌频。"],"stanzas":[["知心似古人，","岁久分弥亲。"],["离别波涛阔，","留连槐柳新。"],["蟆陵寒贳酒，","渔浦夜垂纶。"],["自此星居后，","音书岂厌频。"]]}
{"id":"fe9e434460","title":"送相里烛","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相逢未作期，","相送定何之。","不得长年少，","那堪远别离。","泛湖乘月早，","践雪过山迟。","永望多时立，","翻如在梦思。"],"stanzas":[["相逢未作期，","相送定何之。"],["不得长年少，","那堪远别离。"],["泛湖乘月早，","践雪过山迟。"],["永望多时立，","翻如在梦思。"]]}
{"id":"0ec04277b7","title":"君不来","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲花未零落，","心绪已纷纷。","久客无人见，","新禽何处闻？","舟随一水远，","路出万山分。","夜月生愁望，","孤光必照君。"],"stanzas":[["闲花未零落，","心绪已纷纷。"],["久客无人见，","新禽何处闻？"],["舟随一水远，","路出万山分。"],["夜月生愁望，","孤光必照君。"]]}
{"id":"a012eb47d6","title":"将谒商州吕郎中道出楚州留献章中丞","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江流盘复直，","浮棹出家林。","商洛路犹远，","山阳春已深。","青云应有望，","白发未相侵。","才小知难荐，","终劳许郭心。"],"stanzas":[["江流盘复直，","浮棹出家林。"],["商洛路犹远，","山阳春已深。"],["青云应有望，","白发未相侵。"],["才小知难荐，","终劳许郭心。"]]}
{"id":"fcb0ca5550","title":"金州客舍","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卷箔群峰暮，","萧条未掩关。","江流嶓[冢]雨，","路入汉家山。","落叶欹眠后，","孤砧倚望间。","此情偏耐醉，","难遣酒罍闲。"],"stanzas":[["卷箔群峰暮，","萧条未掩关。"],["江流嶓[冢]雨，","路入汉家山。"],["落叶欹眠后，","孤砧倚望间。"],["此情偏耐醉，","难遣酒罍闲。"]]}
{"id":"474c9174c3","title":"途中逢孙辂因得李频消息","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灞上寒仍在，","柔条亦自新。","山河虽度腊，","雨雪未知春。","正忆同袍者，","堪逢共国人。","衔杯益无语，","与尔转相亲。"],"stanzas":[["灞上寒仍在，","柔条亦自新。"],["山河虽度腊，","雨雪未知春。"],["正忆同袍者，","堪逢共国人。"],["衔杯益无语，","与尔转相亲。"]]}
{"id":"cc03a74e98","title":"送从兄郜","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道路本无限，","又应何处逢？","流年莫虚掷，","华髪不相容。","野渡波摇月，","空城雨翳钟。","此心随去马，","迢递过千峰。"],"stanzas":[["道路本无限，","又应何处逢？"],["流年莫虚掷，","华髪不相容。"],["野渡波摇月，","空城雨翳钟。"],["此心随去马，","迢递过千峰。"]]}
{"id":"6267c331f5","title":"送许温","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["壮岁分冞切，","少年心正同。","当闻千里去，","难遣一尊空。","翳烛蒹葭雨，","吹帆橘柚风。","明年见亲族，","尽集在怀中。"],"stanzas":[["壮岁分冞切，","少年心正同。"],["当闻千里去，","难遣一尊空。"],["翳烛蒹葭雨，","吹帆橘柚风。"],["明年见亲族，","尽集在怀中。"]]}
{"id":"5c9423e7a7","title":"镜中别业二首 一","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒山压镜心，","此处是家林。","梁燕窥春醉，","嵒猿学夜吟。","云连平地起，","月向白波沈。","犹自闻钟角，","栖身可在深。"],"stanzas":[["寒山压镜心，","此处是家林。"],["梁燕窥春醉，","嵒猿学夜吟。"],["云连平地起，","月向白波沈。"],["犹自闻钟角，","栖身可在深。"]]}
{"id":"11284b3be2","title":"镜中别业二首 二","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世人如不容，","吾自纵天慵。","落叶凭风扫，","香秔倩水舂。","花朝连郭雾，","雪夜隔湖钟。","身外无能事，","头宜白此峰。"],"stanzas":[["世人如不容，","吾自纵天慵。"],["落叶凭风扫，","香秔倩水舂。"],["花朝连郭雾，","雪夜隔湖钟。"],["身外无能事，","头宜白此峰。"]]}
{"id":"00a5aa036b","title":"经周处士故居","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁吟与独行，","何事不伤情。","久立钓鱼处，","唯闻啼鸟声。","山蔬和草嫩，","海树入篱生。","吾在兹溪上，","怀君恨不平。"],"stanzas":[["愁吟与独行，","何事不伤情。"],["久立钓鱼处，","唯闻啼鸟声。"],["山蔬和草嫩，","海树入篱生。"],["吾在兹溪上，","怀君恨不平。"]]}
{"id":"4e06b01fc8","title":"赠喻凫","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["所得非众语，","众人那得知。","才吟五字句，","又白几茎髭。","月阁欹眠夜，","霜轩正坐时。","沉思心更苦，","恐作满头丝。"],"stanzas":[["所得非众语，","众人那得知。"],["才吟五字句，","又白几茎髭。"],["月阁欹眠夜，","霜轩正坐时。"],["沉思心更苦，","恐作满头丝。"]]}
{"id":"525a07b850","title":"早发洞庭","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长天接广泽，","二气共含秋。","举目无平地，","何心恋直钩。","孤钟鸣大岸，","片月落中流。","却忆鸱夷子，","当时此泛舟。"],"stanzas":[["长天接广泽，","二气共含秋。"],["举目无平地，","何心恋直钩。"],["孤钟鸣大岸，","片月落中流。"],["却忆鸱夷子，","当时此泛舟。"]]}
{"id":"3032fd7e98","title":"贻钱塘县路明府","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["志业不得力，","到今犹苦吟。","唫成五字句，","用破一生心。","世路屈声远，","寒溪怨气深。","前贤多晚达，","莫怕鬓霜侵。"],"stanzas":[["志业不得力，","到今犹苦吟。"],["唫成五字句，","用破一生心。"],["世路屈声远，","寒溪怨气深。"],["前贤多晚达，","莫怕鬓霜侵。"]]}
{"id":"a78086b9ca","title":"湖上言事寄长城喻明府","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吟霜与卧云，","此兴亦甘贫。","吹箭落翠羽，","垂丝牵锦鳞。","满湖风撼月，","半日雨藏春。","却笑萦簪组，","劳心字远人。"],"stanzas":[["吟霜与卧云，","此兴亦甘贫。"],["吹箭落翠羽，","垂丝牵锦鳞。"],["满湖风撼月，","半日雨藏春。"],["却笑萦簪组，","劳心字远人。"]]}
{"id":"95ba51174c","title":"涵碧亭","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高低竹杂松，","积翠复留风。","路极阴溪里，","寒生暑气中。","闲云低覆草，","片水静涵空。","方见洋源牧，","心侔造化功。"],"stanzas":[["高低竹杂松，","积翠复留风。"],["路极阴溪里，","寒生暑气中。"],["闲云低覆草，","片水静涵空。"],["方见洋源牧，","心侔造化功。"]]}
{"id":"34e4d7d6a6","title":"除夜","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["永怀难自问，","此夕众愁兴。","晓韵侵春角，","寒光隔岁灯。","心燃一寸火，","泪结两行冰。","煦育诚非远，","阳和又欲升。"],"stanzas":[["永怀难自问，","此夕众愁兴。"],["晓韵侵春角，","寒光隔岁灯。"],["心燃一寸火，","泪结两行冰。"],["煦育诚非远，","阳和又欲升。"]]}
{"id":"c92fd2a974","title":"赠许牍山人","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["才子醉更逸，","一吟倾一觞。","支颐忍有得，","摇笔便成章。","王粲实可重，","祢衡争不狂。","何时应会面，","梦里是潇湘。"],"stanzas":[["才子醉更逸，","一吟倾一觞。"],["支颐忍有得，","摇笔便成章。"],["王粲实可重，","祢衡争不狂。"],["何时应会面，","梦里是潇湘。"]]}
{"id":"1f4a6491ad","title":"赠功成将","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["定难在明略，","何曾劳战争。","飞书谕强寇，","计日下重城。","深雪移军夜，","寒笳出塞情。","苦心殊易老，","新髪早年生。"],"stanzas":[["定难在明略，","何曾劳战争。"],["飞书谕强寇，","计日下重城。"],["深雪移军夜，","寒笳出塞情。"],["苦心殊易老，","新髪早年生。"]]}
{"id":"daa1fa314d","title":"白艾原客","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["原上桑柘瘦，","再来还见贫。","沧州几年隐，","白发一茎新。","败叶平空堑，","残阳满近隣。","闲言说知己，","半是学禅人。"],"stanzas":[["原上桑柘瘦，","再来还见贫。"],["沧州几年隐，","白发一茎新。"],["败叶平空堑，","残阳满近隣。"],["闲言说知己，","半是学禅人。"]]}
{"id":"f8ac8069df","title":"朔管","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寥寥落何处，","一夜过胡天。","送苦秋风外，","吹愁白发边。","望乡皆下泪，","久戍尽休眠。","寂寞空沙晓，","开眸片月悬。"],"stanzas":[["寥寥落何处，","一夜过胡天。"],["送苦秋风外，","吹愁白发边。"],["望乡皆下泪，","久戍尽休眠。"],["寂寞空沙晓，","开眸片月悬。"]]}
{"id":"d8700faeda","title":"忆故山","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旧山长系念，","终日卧边亭。","道路知已远，","梦魂空再经。","秋泉凉好引，","乳鹤静宜听。","独上高楼望，","蓬身且未宁。"],"stanzas":[["旧山长系念，","终日卧边亭。"],["道路知已远，","梦魂空再经。"],["秋泉凉好引，","乳鹤静宜听。"],["独上高楼望，","蓬身且未宁。"]]}
{"id":"7f34639809","title":"冬夜泊僧舍","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江东寒近腊，","野寺水天昏。","无酒能消夜，","随僧早闭门。","照墙灯焰细，","著瓦雨声繁。","漂泊仍千里，","清吟欲断魂。"],"stanzas":[["江东寒近腊，","野寺水天昏。"],["无酒能消夜，","随僧早闭门。"],["照墙灯焰细，","著瓦雨声繁。"],["漂泊仍千里，","清吟欲断魂。"]]}
{"id":"d7b41c3f1c","title":"新秋独夜寄戴叔伦","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["遥夜独不卧，","寂寥庭户中。","河明五陵上，","月满九门东。","万里亲朋散，","故园沧海空。","归怀正南望，","此夕起秋风。"],"stanzas":[["遥夜独不卧，","寂寥庭户中。"],["河明五陵上，","月满九门东。"],["万里亲朋散，","故园沧海空。"],["归怀正南望，","此夕起秋风。"]]}
{"id":"97d67f024d","title":"送沛县司马丞之任","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["举酒一相劝，","逢春聊尽欢。","羇游故交少，","远别后期难。","路上野花发，","雨中青草寒。","悠悠两都梦，","小沛与长安。"],"stanzas":[["举酒一相劝，","逢春聊尽欢。"],["羇游故交少，","远别后期难。"],["路上野花发，","雨中青草寒。"],["悠悠两都梦，","小沛与长安。"]]}
{"id":"ad0fa90b94","title":"送卢评事东归","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里杨柳色，","出关随故人。","轻烟覆流水，","落日照行尘。","积梦江湖阔，","忆家兄弟贫。","裴回灞亭上，","不语共伤春。"],"stanzas":[["万里杨柳色，","出关随故人。"],["轻烟覆流水，","落日照行尘。"],["积梦江湖阔，","忆家兄弟贫。"],["裴回灞亭上，","不语共伤春。"]]}
{"id":"555fd29da8","title":"清明日送邓芮还乡","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钟鼓喧离室，","车徒促夜装。","晓榆新变火，","轻柳暗飞霜。","转镜看华髪，","传杯话故乡。","每嫌儿女泪，","今日自沾裳。"],"stanzas":[["钟鼓喧离室，","车徒促夜装。"],["晓榆新变火，","轻柳暗飞霜。"],["转镜看华髪，","传杯话故乡。"],["每嫌儿女泪，","今日自沾裳。"]]}
{"id":"b1ef674b8e","title":"送崔拾遗出使江东","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九门思谏诤，","万里采风谣。","关外逢秋月，","天涯过晚潮。","雁飞云杳杳，","木落浦萧萧。","空怨他乡别，","回舟暮寂寥。"],"stanzas":[["九门思谏诤，","万里采风谣。"],["关外逢秋月，","天涯过晚潮。"],["雁飞云杳杳，","木落浦萧萧。"],["空怨他乡别，","回舟暮寂寥。"]]}
{"id":"3f40080f2b","title":"重阳日送洛阳李丞之任","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为文通绝境，","从宦及良辰。","洛下知名早，","腰边结绶新。","且倾浮菊酒，","聊拂染衣尘。","独恨沧州侣，","愁来别故人。"],"stanzas":[["为文通绝境，","从宦及良辰。"],["洛下知名早，","腰边结绶新。"],["且倾浮菊酒，","聊拂染衣尘。"],["独恨沧州侣，","愁来别故人。"]]}
{"id":"702594151a","title":"江州送李侍御归东洛","author":"方干","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["独乘骢马去，","不并旅人还。","中外名卿贵，","田园高步闲。","暮春经楚县，","新月上淮山。","道路空瞻望，","轩车不敢攀。"],"stanzas":[["独乘骢马去，","不并旅人还。"],["中外名卿贵，","田园高步闲。"],["暮春经楚县，","新月上淮山。"],["道路空瞻望，","轩车不敢攀。"]]}
