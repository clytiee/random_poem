{"id":"a7c8f511f6","title":"送孙十尉温县","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飞花落絮满河桥，","千里伤心送客遥。","不惜芸香染黄绶，","惟怜鸿羽下青霄。","云衢有志终骧首，","吏道无媒且折腰。","急管繁弦催一醉，","颓阳不驻引征镳。"],"stanzas":[["飞花落絮满河桥，","千里伤心送客遥。"],["不惜芸香染黄绶，","惟怜鸿羽下青霄。"],["云衢有志终骧首，","吏道无媒且折腰。"],["急管繁弦催一醉，","颓阳不驻引征镳。"]]}
{"id":"42568415d2","title":"送钟评事应宏词下第东归","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芳岁归人嗟转蓬，","含情回首灞陵东。","蛾眉不入秦台镜，","鹢羽还惊宋国风。","世事悠扬春梦里，","年光寂寞旅愁中。","劝君稍尽离筵酒，","千里佳期难再同。"],"stanzas":[["芳岁归人嗟转蓬，","含情回首灞陵东。"],["蛾眉不入秦台镜，","鹢羽还惊宋国风。"],["世事悠扬春梦里，","年光寂寞旅愁中。"],["劝君稍尽离筵酒，","千里佳期难再同。"]]}
{"id":"f4eaa3d72a","title":"送严维尉河南","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蕙叶青青花乱开，","少年趋府下蓬莱。","甘泉未献扬雄赋，","吏道何劳贾谊才。","征陌独愁飞盖远，","离筵只惜暝钟催。","欲知别后相思处，","愿植琼枝向柏台。"],"stanzas":[["蕙叶青青花乱开，","少年趋府下蓬莱。"],["甘泉未献扬雄赋，","吏道何劳贾谊才。"],["征陌独愁飞盖远，","离筵只惜暝钟催。"],["欲知别后相思处，","愿植琼枝向柏台。"]]}
{"id":"fa1f17df2d","title":"送马员外拜官觐省","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二十为郎事汉文，","鸳雏骥子自为群。","笔精已许台中妙，","劒术还令世上闻。","归觐屡经槐里月，","出师常笑棘门军。","莫言来往朝天远，","看取鸣鞘入断云。"],"stanzas":[["二十为郎事汉文，","鸳雏骥子自为群。"],["笔精已许台中妙，","劒术还令世上闻。"],["归觐屡经槐里月，","出师常笑棘门军。"],["莫言来往朝天远，","看取鸣鞘入断云。"]]}
{"id":"c45f834483","title":"送冷朝阳擢第后归金陵觐省","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莱子昼归今始好，","潘园景色夏偏浓。","夕阳流水吟诗去，","明月青山出竹逢。","兄弟相欢初让果，","乡人争贺旧登龙。","佳期少别俄千里，","云树愁看过几重。"],"stanzas":[["莱子昼归今始好，","潘园景色夏偏浓。"],["夕阳流水吟诗去，","明月青山出竹逢。"],["兄弟相欢初让果，","乡人争贺旧登龙。"],["佳期少别俄千里，","云树愁看过几重。"]]}
{"id":"b6568ba0dc","title":"九日宴浙江西亭","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗人九日怜芳菊，","筵客高斋宴浙江。","渔浦浪花摇素壁，","西陵树色入秋窗。","木奴向熟悬金实，","桑落新开泻玉缸。","四子醉时争讲习，","笑论黄霸旧为邦。"],"stanzas":[["诗人九日怜芳菊，","筵客高斋宴浙江。"],["渔浦浪花摇素壁，","西陵树色入秋窗。"],["木奴向熟悬金实，","桑落新开泻玉缸。"],["四子醉时争讲习，","笑论黄霸旧为邦。"]]}
{"id":"f1bf073543","title":"和王员外雪晴早朝","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫微晴雪带恩光，","绕仗偏随鸳鹭行。","长信月留宁避晓，","宜春花满不飞香。","独看积素凝清禁，","已觉轻寒让太阳。","题柱盛名兼绝唱，","风流谁继汉田郎。"],"stanzas":[["紫微晴雪带恩光，","绕仗偏随鸳鹭行。"],["长信月留宁避晓，","宜春花满不飞香。"],["独看积素凝清禁，","已觉轻寒让太阳。"],["题柱盛名兼绝唱，","风流谁继汉田郎。"]]}
{"id":"7b4f2605f5","title":"避暑纳凉","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["木槿花开畏日长，","时摇轻扇倚绳床。","初晴草蔓缘新笋，","频雨苔衣染旧墙。","十旬河朔应虚醉，","八柱天台好纳凉。","无事始然知静胜，","深垂纱帐咏沧浪。"],"stanzas":[["木槿花开畏日长，","时摇轻扇倚绳床。"],["初晴草蔓缘新笋，","频雨苔衣染旧墙。"],["十旬河朔应虚醉，","八柱天台好纳凉。"],["无事始然知静胜，","深垂纱帐咏沧浪。"]]}
{"id":"69217134b5","title":"早夏","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚狂身世恨情多，","似病如忧正是魔。","花萼败春多寂寞，","叶阴迎夏已清和。","鹂黄好鸟摇深树，","细白佳人著紫罗。","军旅阅诗裁不得，","可怜风景遣如何。"],"stanzas":[["楚狂身世恨情多，","似病如忧正是魔。"],["花萼败春多寂寞，","叶阴迎夏已清和。"],["鹂黄好鸟摇深树，","细白佳人著紫罗。"],["军旅阅诗裁不得，","可怜风景遣如何。"]]}
{"id":"3f94c9c7aa","title":"题嵩阳焦道士石壁","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三峰花畔碧堂悬，","锦里真人此得仙。","玉体才飞西蜀雨，","霓裳欲向大罗天。","彩云不散烧丹灶，","白鹿时藏种玉田。","幸入桃源因去世，","方期丹诀一延年。"],"stanzas":[["三峰花畔碧堂悬，","锦里真人此得仙。"],["玉体才飞西蜀雨，","霓裳欲向大罗天。"],["彩云不散烧丹灶，","白鹿时藏种玉田。"],["幸入桃源因去世，","方期丹诀一延年。"]]}
{"id":"00498e402f","title":"题延州圣僧穴","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["定力无涯不可称，","未知何代坐禅僧。","默默山门宵闭月，","荧荧石壁昼然灯。","四时树长书经叶，","万岁岩悬拄杖藤。","昔日舍身缘救鸽，","今时出见有飞鹰。"],"stanzas":[["定力无涯不可称，","未知何代坐禅僧。"],["默默山门宵闭月，","荧荧石壁昼然灯。"],["四时树长书经叶，","万岁岩悬拄杖藤。"],["昔日舍身缘救鸽，","今时出见有飞鹰。"]]}
{"id":"810da8268e","title":"乐游原晴望上中书李侍郎","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爽气朝来万里清，","凭高一望九秋轻。","不知凤沼霖初霁，","但觉尧天日转明。","四野山河通远色，","千家砧杵共秋声。","遥想青云丞相府，","何时开合引书生。"],"stanzas":[["爽气朝来万里清，","凭高一望九秋轻。"],["不知凤沼霖初霁，","但觉尧天日转明。"],["四野山河通远色，","千家砧杵共秋声。"],["遥想青云丞相府，","何时开合引书生。"]]}
{"id":"53aa1d2fb6","title":"幽居春暮书怀","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自哂鄙夫多野性，","贫居数亩半临湍。","溪云杂雨来茅屋，","山雀将雏到药栏。","仙箓满床闲不厌，","阴符在箧老羞看。","更怜童子宜春服，","花里寻师指杏坛。"],"stanzas":[["自哂鄙夫多野性，","贫居数亩半临湍。"],["溪云杂雨来茅屋，","山雀将雏到药栏。"],["仙箓满床闲不厌，","阴符在箧老羞看。"],["更怜童子宜春服，","花里寻师指杏坛。"]]}
{"id":"aa30b9cd4d","title":"谒许由庙","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故向箕山访许由，","林泉物外自清幽。","松上挂瓢枝几变，","石间洗耳水空流。","绿苔唯见遮三径，","青史空传谢九州。","缅想古人增叹惜，","飒然云树满岩秋。"],"stanzas":[["故向箕山访许由，","林泉物外自清幽。"],["松上挂瓢枝几变，","石间洗耳水空流。"],["绿苔唯见遮三径，","青史空传谢九州。"],["缅想古人增叹惜，","飒然云树满岩秋。"]]}
{"id":"a99209eee3","title":"过张成侍御宅","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丞相幕中题凤人，","文章心事每相亲。","从军谁谓仲宣乐，","入室方知颜子贫。","杯里紫茶香代酒，","琴中绿水静留宾。","欲知别后相思意，","唯愿琼枝入梦频。"],"stanzas":[["丞相幕中题凤人，","文章心事每相亲。"],["从军谁谓仲宣乐，","入室方知颜子贫。"],["杯里紫茶香代酒，","琴中绿水静留宾。"],["欲知别后相思意，","唯愿琼枝入梦频。"]]}
{"id":"7666a281ab","title":"酬考功杨员外见赠佳句","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上林谏猎知才薄，","尺组承恩愧命牵。","潢潦难滋沧海润，","萤光空尽太阳前。","虚名滥接登龙士，","野性宁忘种黍田。","相国无私人守朴，","何辞老去上皇年。"],"stanzas":[["上林谏猎知才薄，","尺组承恩愧命牵。"],["潢潦难滋沧海润，","萤光空尽太阳前。"],["虚名滥接登龙士，","野性宁忘种黍田。"],["相国无私人守朴，","何辞老去上皇年。"]]}
{"id":"f7fc6bd53a","title":"寄永嘉王十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["永嘉风景入新年，","才子诗成定可怜。","梦里还乡不相见，","天涯忆戴复谁传。","花倾晓露垂如泪，","莺拂游丝断若弦。","愿得回风吹海雁，","飞书一宿到君边。"],"stanzas":[["永嘉风景入新年，","才子诗成定可怜。"],["梦里还乡不相见，","天涯忆戴复谁传。"],["花倾晓露垂如泪，","莺拂游丝断若弦。"],["愿得回风吹海雁，","飞书一宿到君边。"]]}
{"id":"18020df4ab","title":"七盘岭阻寇闻李端公先到南楚","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日暮穷途泪满襟，","云天南望羡飞禽。","阮肠暗与孤鸿断，","江水遥连别恨深。","明月既能通忆梦，","青山何用隔同心。","秦楚眼看成绝国，","相思一寄白头吟。"],"stanzas":[["日暮穷途泪满襟，","云天南望羡飞禽。"],["阮肠暗与孤鸿断，","江水遥连别恨深。"],["明月既能通忆梦，","青山何用隔同心。"],["秦楚眼看成绝国，","相思一寄白头吟。"]]}
{"id":"c23ee64863","title":"酬赵给事相寻不遇留赠","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁忆颜生穷巷里，","能劳马迹破春苔。","忽看童子扫花处，","始愧夕郎题凤来。","斜景适随诗兴尽，","好风才送珮声回。","岂无鸡黍期他日，","惜此残春阻绿杯。"],"stanzas":[["谁忆颜生穷巷里，","能劳马迹破春苔。"],["忽看童子扫花处，","始愧夕郎题凤来。"],["斜景适随诗兴尽，","好风才送珮声回。"],["岂无鸡黍期他日，","惜此残春阻绿杯。"]]}
{"id":"37d93190c6","title":"山中酬杨补阙见过","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日暖风恬种药时，","红泉翠壁薜萝垂。","幽溪鹿过苔还静，","深树云来鸟不知。","青琐同心多逸兴，","春山载酒远相随。","却慙身外牵缨冕，","未胜杯前倒接䍠。"],"stanzas":[["日暖风恬种药时，","红泉翠壁薜萝垂。"],["幽溪鹿过苔还静，","深树云来鸟不知。"],["青琐同心多逸兴，","春山载酒远相随。"],["却慙身外牵缨冕，","未胜杯前倒接䍠。"]]}
{"id":"5c20f7140c","title":"同王錥起居程浩郎中韩翃舍人题安国寺用上人院","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["慧眼沙门真远公，","经行宴坐有儒风。","香缘不绝簪裾会，","禅想宁妨藻思通。","曙后𬬻烟生不灭，","晴来堦色并归空。","狂夫入室无余事，","唯与天花一笑同。"],"stanzas":[["慧眼沙门真远公，","经行宴坐有儒风。"],["香缘不绝簪裾会，","禅想宁妨藻思通。"],["曙后𬬻烟生不灭，","晴来堦色并归空。"],["狂夫入室无余事，","唯与天花一笑同。"]]}
{"id":"3df42aca29","title":"寻司勋李郎中不遇","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["知己知音同舍郎，","如何咫尺阻清扬。","每恨蒹葭傍芳树，","多惭新燕入华堂。","重花不隔陈蕃榻，","修竹能深夫子墙。","唯有早朝趋凤合，","朝时怜羽接鸳行。"],"stanzas":[["知己知音同舍郎，","如何咫尺阻清扬。"],["每恨蒹葭傍芳树，","多惭新燕入华堂。"],["重花不隔陈蕃榻，","修竹能深夫子墙。"],["唯有早朝趋凤合，","朝时怜羽接鸳行。"]]}
{"id":"900a6337a1","title":"赠张南史","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫泥何日到沧州，","笑向东阳沈隐侯。","黛色晴峰云外出，","縠文江水县前流。","使臣自欲论公道，","才子非关厌薄游。","溪畔秋兰虽可佩，","知君不得少停舟。"],"stanzas":[["紫泥何日到沧州，","笑向东阳沈隐侯。"],["黛色晴峰云外出，","縠文江水县前流。"],["使臣自欲论公道，","才子非关厌薄游。"],["溪畔秋兰虽可佩，","知君不得少停舟。"]]}
{"id":"e607188643","title":"暇日览旧诗因以题咏","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["逍遥心地得关关，","偶被功名涴我闲。","有寿亦将归象外，","无诗兼不恋人间。","何穷默识轻洪范，","未丧斯文胜大还。","筐箧静开难似此，","蕊珠春色海中山。"],"stanzas":[["逍遥心地得关关，","偶被功名涴我闲。"],["有寿亦将归象外，","无诗兼不恋人间。"],["何穷默识轻洪范，","未丧斯文胜大还。"],["筐箧静开难似此，","蕊珠春色海中山。"]]}
{"id":"911a97d996","title":"汉武出猎","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉家无事乐时雍，","羽猎年年出九重。","玉帛不朝金阙路，","旌旗长绕彩霞峰。","且贪原兽轻黄屋，","宁畏渔人犯白龙。","薄暮方归长乐观，","垂杨几处绿烟浓。"],"stanzas":[["汉家无事乐时雍，","羽猎年年出九重。"],["玉帛不朝金阙路，","旌旗长绕彩霞峰。"],["且贪原兽轻黄屋，","宁畏渔人犯白龙。"],["薄暮方归长乐观，","垂杨几处绿烟浓。"]]}
{"id":"ba233e8b6f","title":"宴曹王宅","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贤王驷马退朝初，","小苑三春带雨余。","林沼葱茏多贵气，","楼台隐暎接天居。","仙鸡引敌穿红药，","宫燕衔泥落绮疏。","自叹平生相识愿，","何如今日厕应徐。"],"stanzas":[["贤王驷马退朝初，","小苑三春带雨余。"],["林沼葱茏多贵气，","楼台隐暎接天居。"],["仙鸡引敌穿红药，","宫燕衔泥落绮疏。"],["自叹平生相识愿，","何如今日厕应徐。"]]}
{"id":"91cfaf0ac6","title":"重赠赵给事","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["久飞鸳掖出时髦，","耻负平生稽古劳。","玉树满庭家转贵，","云衢独步位初高。","能迂驺驭寻蜗舍，","不惜瑶华报木桃。","应念潜郎守贫病，","常悲休沐对蓬蒿。"],"stanzas":[["久飞鸳掖出时髦，","耻负平生稽古劳。"],["玉树满庭家转贵，","云衢独步位初高。"],["能迂驺驭寻蜗舍，","不惜瑶华报木桃。"],["应念潜郎守贫病，","常悲休沐对蓬蒿。"]]}
{"id":"f48e859b30","title":"赠阙下裴舍人","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二月黄莺飞上林，","春城紫禁晓阴阴。","长乐钟声花外尽，","龙池柳色雨中深。","阳和不散穷途恨，","霄汉长怀捧日新。","献赋十年犹未遇，","羞将白发对华簪。"],"stanzas":[["二月黄莺飞上林，","春城紫禁晓阴阴。"],["长乐钟声花外尽，","龙池柳色雨中深。"],["阳和不散穷途恨，","霄汉长怀捧日新。"],["献赋十年犹未遇，","羞将白发对华簪。"]]}
{"id":"b62d85c639","title":"登刘宾客高斋","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["能以功成疎宠位，","不将心赏负云霞。","林间客散孙弘阁，","城上山宜绮季家。","蝴蝶晴连池岸草，","黄鹂晚出柳园花。","日陪鲤也趋文苑，","谁道门生隔绛纱。"],"stanzas":[["能以功成疎宠位，","不将心赏负云霞。"],["林间客散孙弘阁，","城上山宜绮季家。"],["蝴蝶晴连池岸草，","黄鹂晚出柳园花。"],["日陪鲤也趋文苑，","谁道门生隔绛纱。"]]}
{"id":"e29a510102","title":"哭辛霁","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流水辞山花别枝，","随风一去绝还期。","昨夜故人泉下宿，","今朝白发镜中垂。","音徽寂寂空成梦，","容范朝朝无见时。","旦暮余生几息在，","不应存没未尝悲。"],"stanzas":[["流水辞山花别枝，","随风一去绝还期。"],["昨夜故人泉下宿，","今朝白发镜中垂。"],["音徽寂寂空成梦，","容范朝朝无见时。"],["旦暮余生几息在，","不应存没未尝悲。"]]}
{"id":"490fc683e5","title":"和慕容法曹寻渔者寄城中故人","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤烟一点绿溪湄，","渔父幽居即旧基。","饥鹭不惊收钓处，","闲麛应乳负暄时。","茅斋对雪开尊好，","穉子焚枯饭客迟。","胜事宛然怀抱里，","顷来新得谢公诗。"],"stanzas":[["孤烟一点绿溪湄，","渔父幽居即旧基。"],["饥鹭不惊收钓处，","闲麛应乳负暄时。"],["茅斋对雪开尊好，","穉子焚枯饭客迟。"],["胜事宛然怀抱里，","顷来新得谢公诗。"]]}
{"id":"bfdf588147","title":"山花","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山花照坞复烧溪，","树树枝枝尽可迷。","野客未来枝畔立，","流莺已向树边啼。","从容只是愁风起，","眷恋常须向日西。","别有妖妍胜桃李，","攀来折去亦成蹊。"],"stanzas":[["山花照坞复烧溪，","树树枝枝尽可迷。"],["野客未来枝畔立，","流莺已向树边啼。"],["从容只是愁风起，","眷恋常须向日西。"],["别有妖妍胜桃李，","攀来折去亦成蹊。"]]}
{"id":"9c051ebf93","title":"送杨著作归东海","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳出关色，","东行千里期。","酒酣暂轻别，","路远始相思。","欲识离心尽，","斜阳到海时。"],"stanzas":[["杨柳出关色，","东行千里期。"],["酒酣暂轻别，","路远始相思。"],["欲识离心尽，","斜阳到海时。"]]}
{"id":"940d5a67ae","title":"送李协律还东京","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芳草忽无色，","王孙复入关。","长河侵驿道，","匹马傍云山。","愁见离居久，","萤飞秋月闲。"],"stanzas":[["芳草忽无色，","王孙复入关。"],["长河侵驿道，","匹马傍云山。"],["愁见离居久，","萤飞秋月闲。"]]}
{"id":"b70d24762b","title":"秋馆言怀","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蟋蟀已秋思，","蕙兰仍碧滋。","蹉跎献赋客，","叹息此良时。","日夕云台下，","商歌空自悲。"],"stanzas":[["蟋蟀已秋思，","蕙兰仍碧滋。"],["蹉跎献赋客，","叹息此良时。"],["日夕云台下，","商歌空自悲。"]]}
{"id":"8c8666db71","title":"和刘明府宴县前山亭","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["城隅劳心处，","雪后岁芳开。","山暎千花出，","泉经万井来。","翔鸾欲下舞，","上客且留杯。"],"stanzas":[["城隅劳心处，","雪后岁芳开。"],["山暎千花出，","泉经万井来。"],["翔鸾欲下舞，","上客且留杯。"]]}
{"id":"fc81948f57","title":"新雨喜得王卿书问","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苦雨暗秋径，","寒花垂紫苔。","愁中绿尊尽，","梦里故人来。","果有相思字，","银钩新月开。"],"stanzas":[["苦雨暗秋径，","寒花垂紫苔。"],["愁中绿尊尽，","梦里故人来。"],["果有相思字，","银钩新月开。"]]}
{"id":"22cc796c57","title":"赋得巢燕送客","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["能栖杏梁际，","不与黄雀群。","夜影寄红烛，","朝飞高碧云。","含情别故侣，","花月惜春分。"],"stanzas":[["能栖杏梁际，","不与黄雀群。"],["夜影寄红烛，","朝飞高碧云。"],["含情别故侣，","花月惜春分。"]]}
{"id":"c57573c507","title":"题张蓝田讼堂","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["角巾高枕向晴山，","讼简庭空不用关。","秋风窗下琴书静，","夜景门前人吏闲。","稍觉渊明归思远，","东臯月出片云还。"],"stanzas":[["角巾高枕向晴山，","讼简庭空不用关。"],["秋风窗下琴书静，","夜景门前人吏闲。"],["稍觉渊明归思远，","东臯月出片云还。"]]}
{"id":"dd640b48dd","title":"江行无题一百首 一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["倾酒向涟漪，","乘流东去时。","寸心同尺璧，","投此报冯夷。"],"stanzas":[["倾酒向涟漪，","乘流东去时。"],["寸心同尺璧，","投此报冯夷。"]]}
{"id":"84f011afde","title":"江行无题一百首 二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江曲全萦楚，","雪飞半自秦。","岘山回首望，","如别故关人。"],"stanzas":[["江曲全萦楚，","雪飞半自秦。"],["岘山回首望，","如别故关人。"]]}
{"id":"451de8f2bd","title":"江行无题一百首 三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浦烟函夜色，","冷日转秋旻。","自有沈碑石，","清光不照人。"],"stanzas":[["浦烟函夜色，","冷日转秋旻。"],["自有沈碑石，","清光不照人。"]]}
{"id":"33f3e9e4a4","title":"江行无题一百首 四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚岸云空合，","楚城人不来。","只今谁善舞，","莫恨发阳台。"],"stanzas":[["楚岸云空合，","楚城人不来。"],["只今谁善舞，","莫恨发阳台。"]]}
{"id":"ac99e1804e","title":"江行无题一百首 五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行背青山郭，","吟当白露秋。","风流无屈宋，","空咏古荆州。"],"stanzas":[["行背青山郭，","吟当白露秋。"],["风流无屈宋，","空咏古荆州。"]]}
{"id":"5bfee15a88","title":"江行无题一百首 六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚来渔父喜，","罾重欲收迟。","恐有长江使，","金钱愿赎龟。"],"stanzas":[["晚来渔父喜，","罾重欲收迟。"],["恐有长江使，","金钱愿赎龟。"]]}
{"id":"5f8abe279f","title":"江行无题一百首 七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去指龙沙路，","徒悬象阙心。","夜凉无远梦，","不为偶闻砧。"],"stanzas":[["去指龙沙路，","徒悬象阙心。"],["夜凉无远梦，","不为偶闻砧。"]]}
{"id":"9ec3c30be5","title":"江行无题一百首 八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霁云疎有叶，","雨浪细无花。","稳放扁舟去，","江天自有涯。"],"stanzas":[["霁云疎有叶，","雨浪细无花。"],["稳放扁舟去，","江天自有涯。"]]}
{"id":"ac3dcf7ded","title":"江行无题一百首 九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好日当秋半，","层波动旅肠。","已行千里外，","谁与共秋光。"],"stanzas":[["好日当秋半，","层波动旅肠。"],["已行千里外，","谁与共秋光。"]]}
{"id":"b3e1604406","title":"江行无题一百首 十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["润色非东里，","官曹更建章。","宦游难自定，","来唤櫂船郎。"],"stanzas":[["润色非东里，","官曹更建章。"],["宦游难自定，","来唤櫂船郎。"]]}
{"id":"0e10ce1902","title":"江行无题一百首 十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜江清未晓，","徒惜月光沈。","不是因行乐，","堪伤老大心。"],"stanzas":[["夜江清未晓，","徒惜月光沈。"],["不是因行乐，","堪伤老大心。"]]}
{"id":"9848298b27","title":"江行无题一百首 十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翳日多乔木，","维舟取束薪。","静听江叟语，","俱是厌兵人。"],"stanzas":[["翳日多乔木，","维舟取束薪。"],["静听江叟语，","俱是厌兵人。"]]}
{"id":"f01aea3f96","title":"江行无题一百首 十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["箭漏日初短，","汀烟草未衰。","雨余虽更绿，","不是采苹时。"],"stanzas":[["箭漏日初短，","汀烟草未衰。"],["雨余虽更绿，","不是采苹时。"]]}
{"id":"30fbd3aa98","title":"江行无题一百首 十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山雨夜来涨，","喜鱼跳满江。","岸沙平欲尽，","垂蓼入船窗。"],"stanzas":[["山雨夜来涨，","喜鱼跳满江。"],["岸沙平欲尽，","垂蓼入船窗。"]]}
{"id":"15e4675b79","title":"江行无题一百首 十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渚边新雁下，","舟上独凄凉。","俱是南来客，","怜君缀一行。"],"stanzas":[["渚边新雁下，","舟上独凄凉。"],["俱是南来客，","怜君缀一行。"]]}
{"id":"bea24a304e","title":"江行无题一百首 十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牵路沿江狭，","沙崩岸不平。","尽知行处险，","谁肯载时轻。"],"stanzas":[["牵路沿江狭，","沙崩岸不平。"],["尽知行处险，","谁肯载时轻。"]]}
{"id":"f5742b0abf","title":"江行无题一百首 十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云密连江暗，","风斜著物鸣。","一杯真战将，","笑尔作愁兵。"],"stanzas":[["云密连江暗，","风斜著物鸣。"],["一杯真战将，","笑尔作愁兵。"]]}
{"id":"50ba011a78","title":"江行无题一百首 十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳拂斜开路，","篱边数户村。","可能还有意，","不掩向江门。"],"stanzas":[["柳拂斜开路，","篱边数户村。"],["可能还有意，","不掩向江门。"]]}
{"id":"baeb2691e6","title":"江行无题一百首 十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不识桓公渴，","徒吟子美诗。","江清唯独看，","心外更谁知。"],"stanzas":[["不识桓公渴，","徒吟子美诗。"],["江清唯独看，","心外更谁知。"]]}
{"id":"f1eb2cad71","title":"江行无题一百首 二十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["憔悴异灵均，","非谗作逐臣。","如逢渔父问，","未是独醒人。"],"stanzas":[["憔悴异灵均，","非谗作逐臣。"],["如逢渔父问，","未是独醒人。"]]}
{"id":"5467e6c503","title":"江行无题一百首 二十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水涵秋色静，","云带夕阳高。","诗癖非吾病，","何妨吮短毫。"],"stanzas":[["水涵秋色静，","云带夕阳高。"],["诗癖非吾病，","何妨吮短毫。"]]}
{"id":"5e8afd8fd3","title":"江行无题一百首 二十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["登舟非古岸，","还似阻西陵。","箕伯无多少，","回头讵不能。"],"stanzas":[["登舟非古岸，","还似阻西陵。"],["箕伯无多少，","回头讵不能。"]]}
{"id":"e4b6e4d389","title":"江行无题一百首 二十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["帆翅初张处，","云鹏怒翼同。","莫愁千里路，","自有到来风。"],"stanzas":[["帆翅初张处，","云鹏怒翼同。"],["莫愁千里路，","自有到来风。"]]}
{"id":"a7e1457697","title":"江行无题一百首 二十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋云久无雨，","江燕社犹飞。","却笑舟中客，","今年未得归。"],"stanzas":[["秋云久无雨，","江燕社犹飞。"],["却笑舟中客，","今年未得归。"]]}
{"id":"6f3595e84a","title":"江行无题一百首 二十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳节虽逢菊，","浮生正似萍。","故山何处望，","荒岸小长亭。"],"stanzas":[["佳节虽逢菊，","浮生正似萍。"],["故山何处望，","荒岸小长亭。"]]}
{"id":"dddce11fcc","title":"江行无题一百首 二十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行到楚江岸，","苍茫人正迷。","秖知秦塞远，","格磔鹧鸪啼。"],"stanzas":[["行到楚江岸，","苍茫人正迷。"],["秖知秦塞远，","格磔鹧鸪啼。"]]}
{"id":"df089573e9","title":"江行无题一百首 二十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月下江流静，","村荒人语稀。","鹭鸶虽有伴，","仍共影双飞。"],"stanzas":[["月下江流静，","村荒人语稀。"],["鹭鸶虽有伴，","仍共影双飞。"]]}
{"id":"65a8d503de","title":"江行无题一百首 二十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斗转月未落，","舟行夜已深。","有村知不远，","风便数声砧。"],"stanzas":[["斗转月未落，","舟行夜已深。"],["有村知不远，","风便数声砧。"]]}
{"id":"5f634f3ba8","title":"江行无题一百首 二十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["櫂惊沙鸟迅，","飞溅夕阳波。","不顾鱼多处，","应防一目罗。"],"stanzas":[["櫂惊沙鸟迅，","飞溅夕阳波。"],["不顾鱼多处，","应防一目罗。"]]}
{"id":"bdb71e335e","title":"江行无题一百首 三十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渐觉江天远，","难逢故国书。","可能无往事，","空食鼎中鱼。"],"stanzas":[["渐觉江天远，","难逢故国书。"],["可能无往事，","空食鼎中鱼。"]]}
{"id":"aab29fdd49","title":"江行无题一百首 三十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岸草连荒色，","村声乐稔年。","晚晴初获稻，","闲却采莲船。"],"stanzas":[["岸草连荒色，","村声乐稔年。"],["晚晴初获稻，","闲却采莲船。"]]}
{"id":"b518e8b536","title":"江行无题一百首 三十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["滩浅争游鹭，","江清易见鱼。","怪来吟未足，","秋物欠红蕖。"],"stanzas":[["滩浅争游鹭，","江清易见鱼。"],["怪来吟未足，","秋物欠红蕖。"]]}
{"id":"a421465908","title":"江行无题一百首 三十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛩响依莎草，","萤飞透水烟。","夜凉谁咏史，","空泊运租船。"],"stanzas":[["蛩响依莎草，","萤飞透水烟。"],["夜凉谁咏史，","空泊运租船。"]]}
{"id":"2a490a6349","title":"江行无题一百首 三十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["睡稳叶舟轻，","风微浪不惊。","任君芦苇岸，","终夜动秋声。"],"stanzas":[["睡稳叶舟轻，","风微浪不惊。"],["任君芦苇岸，","终夜动秋声。"]]}
{"id":"07d92edcec","title":"江行无题一百首 三十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自念平生意，","曾期一郡符。","岂知因谪宦，","斑鬓入江湖。"],"stanzas":[["自念平生意，","曾期一郡符。"],["岂知因谪宦，","斑鬓入江湖。"]]}
{"id":"fc4c448901","title":"江行无题一百首 三十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟渚复烟渚，","画屏休画屏。","引愁天末去，","数点暮山青。"],"stanzas":[["烟渚复烟渚，","画屏休画屏。"],["引愁天末去，","数点暮山青。"]]}
{"id":"b85e495904","title":"江行无题一百首 三十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水天凉夜月，","不是惜清光。","好物随人秘，","秦淮忆建康。"],"stanzas":[["水天凉夜月，","不是惜清光。"],["好物随人秘，","秦淮忆建康。"]]}
{"id":"2161c3f5c7","title":"江行无题一百首 三十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古来多思客，","摇落恨江潭。","今日秋风至，","萧疎独沔南。"],"stanzas":[["古来多思客，","摇落恨江潭。"],["今日秋风至，","萧疎独沔南。"]]}
{"id":"807154415c","title":"江行无题一百首 三十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暎竹疑村好，","穿芦觉渚幽。","渐安无旷土，","姜芋当农收。"],"stanzas":[["暎竹疑村好，","穿芦觉渚幽。"],["渐安无旷土，","姜芋当农收。"]]}
{"id":"ea28dda65e","title":"江行无题一百首 四十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋风动客心，","寂寂不成吟。","飞上危樯立，","啼乌报好音。"],"stanzas":[["秋风动客心，","寂寂不成吟。"],["飞上危樯立，","啼乌报好音。"]]}
{"id":"f4b9f40302","title":"江行无题一百首 四十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["见底高秋水，","开怀万里天。","旅吟还有伴，","沙柳数枝蝉。"],"stanzas":[["见底高秋水，","开怀万里天。"],["旅吟还有伴，","沙柳数枝蝉。"]]}
{"id":"a1e37aabf4","title":"江行无题一百首 四十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九日自佳节，","扁舟无一杯。","曹园旧尊酒，","戏马忆高台。"],"stanzas":[["九日自佳节，","扁舟无一杯。"],["曹园旧尊酒，","戏马忆高台。"]]}
{"id":"55a6d021e1","title":"江行无题一百首 四十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兵火有余烬，","贫村才数家。","无人争晓渡，","残月下寒沙。"],"stanzas":[["兵火有余烬，","贫村才数家。"],["无人争晓渡，","残月下寒沙。"]]}
{"id":"f36002b5ce","title":"江行无题一百首 四十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渚禽菱芡足，","不向稻粱争。","静宿凉湾月，","应无失侣声。"],"stanzas":[["渚禽菱芡足，","不向稻粱争。"],["静宿凉湾月，","应无失侣声。"]]}
{"id":"e8863c1251","title":"江行无题一百首 四十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轻云未护霜，","树杪橘初黄。","信是知名物，","微风过水香。"],"stanzas":[["轻云未护霜，","树杪橘初黄。"],["信是知名物，","微风过水香。"]]}
{"id":"5e72cf9edc","title":"江行无题一百首 四十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渺渺望天涯，","清涟浸赤霞。","难逢星汉使，","乌鹊日乘槎。"],"stanzas":[["渺渺望天涯，","清涟浸赤霞。"],["难逢星汉使，","乌鹊日乘槎。"]]}
{"id":"5173a699cb","title":"江行无题一百首 四十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["土旷深耕少，","江平远钓多。","生平皆弃本，","金革竟如何。"],"stanzas":[["土旷深耕少，","江平远钓多。"],["生平皆弃本，","金革竟如何。"]]}
{"id":"3a50616149","title":"江行无题一百首 四十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海月非常物，","等闲不可寻。","披沙应有地，","浅处定无金。"],"stanzas":[["海月非常物，","等闲不可寻。"],["披沙应有地，","浅处定无金。"]]}
{"id":"b6a8ea8748","title":"江行无题一百首 四十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风晚冷飕飕，","芦花已白头。","旧来红叶寺，","堪忆玉京秋。"],"stanzas":[["风晚冷飕飕，","芦花已白头。"],["旧来红叶寺，","堪忆玉京秋。"]]}
{"id":"b00c6090d9","title":"江行无题一百首 五十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风好来无阵，","云闲去有踪。","钓歌无远近，","应喜罢艨艟。"],"stanzas":[["风好来无阵，","云闲去有踪。"],["钓歌无远近，","应喜罢艨艟。"]]}
{"id":"6fe332cb1a","title":"江行无题一百首 五十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴疆连楚甸，","楚俗异吴乡。","漫把尊中物，","无人啄蟹筐。"],"stanzas":[["吴疆连楚甸，","楚俗异吴乡。"],["漫把尊中物，","无人啄蟹筐。"]]}
{"id":"b806a34bc9","title":"江行无题一百首 五十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岸绿野烟远，","江红斜照微。","撑开小渔艇，","应到月明归。"],"stanzas":[["岸绿野烟远，","江红斜照微。"],["撑开小渔艇，","应到月明归。"]]}
{"id":"8f8cf5de2f","title":"江行无题一百首 五十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨余江始涨，","漾漾见流薪。","曾叹河中木，","斯言忆古人。"],"stanzas":[["雨余江始涨，","漾漾见流薪。"],["曾叹河中木，","斯言忆古人。"]]}
{"id":"08d339728f","title":"江行无题一百首 五十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叶舟维夏口，","烟野独行时。","不见头陀寺，","空怀幼妇碑。"],"stanzas":[["叶舟维夏口，","烟野独行时。"],["不见头陀寺，","空怀幼妇碑。"]]}
{"id":"2eb6467394","title":"江行无题一百首 五十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚泊武昌岸，","津亭疎柳风。","数株曾手植，","好事忆陶公。"],"stanzas":[["晚泊武昌岸，","津亭疎柳风。"],["数株曾手植，","好事忆陶公。"]]}
{"id":"42bc974596","title":"江行无题一百首 五十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坠露晓犹浓，","秋花不易逢。","涉江虽已晚，","高树搴芙蓉。"],"stanzas":[["坠露晓犹浓，","秋花不易逢。"],["涉江虽已晚，","高树搴芙蓉。"]]}
{"id":"8f807e2135","title":"江行无题一百首 五十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舟航依浦定，","星斗满江寒。","若比阴霾日，","何妨夜未阑。"],"stanzas":[["舟航依浦定，","星斗满江寒。"],["若比阴霾日，","何妨夜未阑。"]]}
{"id":"6d2986f57f","title":"江行无题一百首 五十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["近戍离金落，","孤岑望火门。","唯将知命意，","潇洒向乾坤。"],"stanzas":[["近戍离金落，","孤岑望火门。"],["唯将知命意，","潇洒向乾坤。"]]}
{"id":"7e5ddbaf19","title":"江行无题一百首 五十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丛菊生堤上，","此花长后时。","有人还采掇，","何必在春期。"],"stanzas":[["丛菊生堤上，","此花长后时。"],["有人还采掇，","何必在春期。"]]}
{"id":"742cf3303e","title":"江行无题一百首 六十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夕景残霞落，","秋寒细雨晴。","短缨何用濯，","舟在月中行。"],"stanzas":[["夕景残霞落，","秋寒细雨晴。"],["短缨何用濯，","舟在月中行。"]]}
{"id":"824931fede","title":"江行无题一百首 六十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["堤坏漏江水，","地坳成野塘。","晚荷人不折，","留取作秋香。"],"stanzas":[["堤坏漏江水，","地坳成野塘。"],["晚荷人不折，","留取作秋香。"]]}
{"id":"7db7c18ee9","title":"江行无题一百首 六十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["左宦终何路，","摅怀亦自宽。","襞牋嘲白鹭，","无意喻枭鸾。"],"stanzas":[["左宦终何路，","摅怀亦自宽。"],["襞牋嘲白鹭，","无意喻枭鸾。"]]}
{"id":"08276417a7","title":"江行无题一百首 六十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼空人不归，","云似去时衣。","黄鹤无心下，","长应笑令威。"],"stanzas":[["楼空人不归，","云似去时衣。"],["黄鹤无心下，","长应笑令威。"]]}
{"id":"4f171ec17c","title":"江行无题一百首 六十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白帝朝惊浪，","浔阳暮暎云。","等闲生险易，","世路秖如君。"],"stanzas":[["白帝朝惊浪，","浔阳暮暎云。"],["等闲生险易，","世路秖如君。"]]}
{"id":"178ad7b46d","title":"江行无题一百首 六十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["橹慢开轻浪，","帆虚带白云。","客船虽狭小，","容得庾将军。"],"stanzas":[["橹慢开轻浪，","帆虚带白云。"],["客船虽狭小，","容得庾将军。"]]}
{"id":"a00cc7bc73","title":"江行无题一百首 六十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风雨正甘寝，","云霓忽晚晴。","放歌虽自遣，","一岁又峥嵘。"],"stanzas":[["风雨正甘寝，","云霓忽晚晴。"],["放歌虽自遣，","一岁又峥嵘。"]]}
{"id":"708a0b3eb4","title":"江行无题一百首 六十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["静看秋江水，","风微浪渐平。","人间驰竞处，","尘土自波成。"],"stanzas":[["静看秋江水，","风微浪渐平。"],["人间驰竞处，","尘土自波成。"]]}
{"id":"4194162260","title":"江行无题一百首 六十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风劲帆方疾，","风回櫂却迟。","较量人世事，","不校一毫厘。"],"stanzas":[["风劲帆方疾，","风回櫂却迟。"],["较量人世事，","不校一毫厘。"]]}
{"id":"750825c039","title":"江行无题一百首 六十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["咫尺愁风雨，","匡庐不可登。","秖疑云雾窟，","犹有六朝僧。"],"stanzas":[["咫尺愁风雨，","匡庐不可登。"],["秖疑云雾窟，","犹有六朝僧。"]]}
{"id":"064199335e","title":"江行无题一百首 七十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽思正迟迟，","沙边濯弄时。","自怜非博物，","犹未识凫葵。"],"stanzas":[["幽思正迟迟，","沙边濯弄时。"],["自怜非博物，","犹未识凫葵。"]]}
{"id":"60ee9c9298","title":"江行无题一百首 七十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾有烟波客，","能歌西塞山。","落帆唯待月，","一钓紫菱湾。"],"stanzas":[["曾有烟波客，","能歌西塞山。"],["落帆唯待月，","一钓紫菱湾。"]]}
{"id":"08869f0a22","title":"江行无题一百首 七十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千顷水纹细，","一拳岚影孤。","君山寒树绿，","曾过洞庭湖。"],"stanzas":[["千顷水纹细，","一拳岚影孤。"],["君山寒树绿，","曾过洞庭湖。"]]}
{"id":"177fa0e5f2","title":"江行无题一百首 七十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["光阔重湖水，","低斜远雁行。","未曾无兴咏，","多谢沈东阳。"],"stanzas":[["光阔重湖水，","低斜远雁行。"],["未曾无兴咏，","多谢沈东阳。"]]}
{"id":"2c0b5ebf48","title":"江行无题一百首 七十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晚菊绕江垒，","忽如开古屏。","莫言时节过，","白日有余馨。"],"stanzas":[["晚菊绕江垒，","忽如开古屏。"],["莫言时节过，","白日有余馨。"]]}
{"id":"656b9a06ad","title":"江行无题一百首 七十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋寒鹰隼健，","逐雀下云空。","知是江湖阔，","无心击塞鸿。"],"stanzas":[["秋寒鹰隼健，","逐雀下云空。"],["知是江湖阔，","无心击塞鸿。"]]}
{"id":"9a6b2f9615","title":"江行无题一百首 七十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日落长亭晚，","山门步障青。","可怜无酒分，","处处有旗亭。"],"stanzas":[["日落长亭晚，","山门步障青。"],["可怜无酒分，","处处有旗亭。"]]}
{"id":"3d1d2292e4","title":"江行无题一百首 七十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江草何多思，","冬青尚满洲。","谁能惊鵩鸟，","作赋为沙鸥。"],"stanzas":[["江草何多思，","冬青尚满洲。"],["谁能惊鵩鸟，","作赋为沙鸥。"]]}
{"id":"0fdb704165","title":"江行无题一百首 七十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远岸无行树，","经霜有半红。","停船搜好句，","题叶赠江枫。"],"stanzas":[["远岸无行树，","经霜有半红。"],["停船搜好句，","题叶赠江枫。"]]}
{"id":"9841ef4242","title":"江行无题一百首 七十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身世比行舟，","无风亦暂休。","敢言终破浪，","唯愿稳乘流。"],"stanzas":[["身世比行舟，","无风亦暂休。"],["敢言终破浪，","唯愿稳乘流。"]]}
{"id":"c9315bdc50","title":"江行无题一百首 八十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数亩苍苔石，","烟蒙鹤卵洲。","定因词客遇，","名字始风流。"],"stanzas":[["数亩苍苔石，","烟蒙鹤卵洲。"],["定因词客遇，","名字始风流。"]]}
{"id":"15ea0a1078","title":"江行无题一百首 八十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兴闲停桂楫，","路好过松门。","不负佳山水，","还开酒一尊。"],"stanzas":[["兴闲停桂楫，","路好过松门。"],["不负佳山水，","还开酒一尊。"]]}
{"id":"73275e7742","title":"江行无题一百首 八十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽怀念烟水，","长恨隔龙沙。","今日膝王阁，","分明见落霞。"],"stanzas":[["幽怀念烟水，","长恨隔龙沙。"],["今日膝王阁，","分明见落霞。"]]}
{"id":"dc6829fae5","title":"江行无题一百首 八十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["短楫休敲桂，","孤根自驻萍。","自怜非劒气，","空向斗牛星。"],"stanzas":[["短楫休敲桂，","孤根自驻萍。"],["自怜非劒气，","空向斗牛星。"]]}
{"id":"f91e42456f","title":"江行无题一百首 八十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江流何渺渺，","怀古独依依。","渔父非贤者，","芦中但有矶。"],"stanzas":[["江流何渺渺，","怀古独依依。"],["渔父非贤者，","芦中但有矶。"]]}
{"id":"644e0926b8","title":"江行无题一百首 八十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高浪如银屋，","江风一发时。","笔端降太白，","才大语终奇。"],"stanzas":[["高浪如银屋，","江风一发时。"],["笔端降太白，","才大语终奇。"]]}
{"id":"33d61f4117","title":"江行无题一百首 八十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["细竹渔家路，","晴阳看结缯。","喜来邀客坐，","分与折腰菱。"],"stanzas":[["细竹渔家路，","晴阳看结缯。"],["喜来邀客坐，","分与折腰菱。"]]}
{"id":"8106503cda","title":"江行无题一百首 八十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幸有烟波兴，","宁辞笔砚劳。","缘情无怨刺，","却似反离骚。"],"stanzas":[["幸有烟波兴，","宁辞笔砚劳。"],["缘情无怨刺，","却似反离骚。"]]}
{"id":"73145fefbe","title":"江行无题一百首 八十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平湖五百里，","江水想通波。","不奈扁舟去，","其如决计何。"],"stanzas":[["平湖五百里，","江水想通波。"],["不奈扁舟去，","其如决计何。"]]}
{"id":"e22432c056","title":"江行无题一百首 八十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数峰云断处，","去岸暎高山。","身到韦江日，","犹应未得闲。"],"stanzas":[["数峰云断处，","去岸暎高山。"],["身到韦江日，","犹应未得闲。"]]}
{"id":"b5c9248bf2","title":"江行无题一百首 九十","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一湾斜照水，","三版顺风船。","未敢相邀约，","劳生秖自怜。"],"stanzas":[["一湾斜照水，","三版顺风船。"],["未敢相邀约，","劳生秖自怜。"]]}
{"id":"70aa582d4d","title":"江行无题一百首 九十一","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江雨正霏微，","江村晚渡稀。","何曾妨钓艇，","更待得鱼归。"],"stanzas":[["江雨正霏微，","江村晚渡稀。"],["何曾妨钓艇，","更待得鱼归。"]]}
{"id":"bd5efbe58a","title":"江行无题一百首 九十二","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沙上独行时，","高吟到楚词。","难将垂岸蓼，","盈把当江蓠。"],"stanzas":[["沙上独行时，","高吟到楚词。"],["难将垂岸蓼，","盈把当江蓠。"]]}
{"id":"60ff941c6e","title":"江行无题一百首 九十三","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新野旧楼名，","浔阳胜赏情。","照人长一色，","江月共凄清。"],"stanzas":[["新野旧楼名，","浔阳胜赏情。"],["照人长一色，","江月共凄清。"]]}
{"id":"676e799f7d","title":"江行无题一百首 九十四","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愿饮西江水，","那吟北渚愁。","莫教留滞迹，","远比蔡昭侯。"],"stanzas":[["愿饮西江水，","那吟北渚愁。"],["莫教留滞迹，","远比蔡昭侯。"]]}
{"id":"39d8d3ccb7","title":"江行无题一百首 九十五","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湖口分江水，","东流独有情。","当时好风物，","谁伴谢宣城。"],"stanzas":[["湖口分江水，","东流独有情。"],["当时好风物，","谁伴谢宣城。"]]}
{"id":"a44391fc82","title":"江行无题一百首 九十六","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浔阳江畔菊，","应似古来秋。","为问幽栖客，","吟时得酒不。"],"stanzas":[["浔阳江畔菊，","应似古来秋。"],["为问幽栖客，","吟时得酒不。"]]}
{"id":"b5b18178ea","title":"江行无题一百首 九十七","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高峰有佳号，","千尺倚寒松。","若使𬬻烟在，","犹应为上公。"],"stanzas":[["高峰有佳号，","千尺倚寒松。"],["若使𬬻烟在，","犹应为上公。"]]}
{"id":"24b3b552be","title":"江行无题一百首 九十八","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万木已清霜，","江边村事忙。","故溪黄稻熟，","一夜梦中香。"],"stanzas":[["万木已清霜，","江边村事忙。"],["故溪黄稻熟，","一夜梦中香。"]]}
{"id":"e0e2ae4514","title":"江行无题一百首 九十九","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚水苦萦回，","征帆落又开。","可缘非直路，","却有好风来。"],"stanzas":[["楚水苦萦回，","征帆落又开。"],["可缘非直路，","却有好风来。"]]}
{"id":"f9fda54036","title":"江行无题一百首 一百","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远谪岁时晏，","暮江风雨寒。","仍愁系舟处，","惊梦近长滩。"],"stanzas":[["远谪岁时晏，","暮江风雨寒。"],["仍愁系舟处，","惊梦近长滩。"]]}
{"id":"5a1450f94a","title":"言怀","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜月霁未好，","云泉堪梦归。","如何建章漏，","催著早朝衣。"],"stanzas":[["夜月霁未好，","云泉堪梦归。"],["如何建章漏，","催著早朝衣。"]]}
{"id":"1130dc7bf4","title":"和张仆射塞下曲","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月黑雁飞高，","单于夜遁逃。","欲将轻骑逐，","大雪满弓刀。"],"stanzas":[["月黑雁飞高，","单于夜遁逃。"],["欲将轻骑逐，","大雪满弓刀。"]]}
{"id":"0f4d6bb6b6","title":"送李明府去官","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谤言三至后，","直道叹何如。","今日蓝溪水，","无人不夜鱼。"],"stanzas":[["谤言三至后，","直道叹何如。"],["今日蓝溪水，","无人不夜鱼。"]]}
{"id":"872966448b","title":"赴章陵詶李卿赠别","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一官叨下秩，","九棘谢知音。","芳草文园路，","春愁满别心。"],"stanzas":[["一官叨下秩，","九棘谢知音。"],["芳草文园路，","春愁满别心。"]]}
{"id":"ed9883b061","title":"逢侠者","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["燕赵悲歌士，","相逢剧孟家。","寸心言不尽，","前路日将斜。"],"stanzas":[["燕赵悲歌士，","相逢剧孟家。"],["寸心言不尽，","前路日将斜。"]]}
{"id":"6d9ece1cca","title":"郎员外见寻不遇","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轩骑来相访，","渔樵悔晚归。","更怜垂露迹，","花里点墙衣。"],"stanzas":[["轩骑来相访，","渔樵悔晚归。"],["更怜垂露迹，","花里点墙衣。"]]}
{"id":"dad1d5e9b9","title":"过李侍御宅","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不见承明客，","愁闻长乐钟。","马卿何早世，","汉主欲登封。"],"stanzas":[["不见承明客，","愁闻长乐钟。"],["马卿何早世，","汉主欲登封。"]]}
{"id":"90c1e3a81b","title":"宿洞口馆","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野竹通溪冷，","秋泉入户鸣。","乱来人不到，","芳草上堦生。"],"stanzas":[["野竹通溪冷，","秋泉入户鸣。"],["乱来人不到，","芳草上堦生。"]]}
{"id":"c3f5da36ba","title":"九日寄姪箊箕等","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["采菊偏相忆，","传香寄便风。","今朝竹林下，","莫使桂尊空。"],"stanzas":[["采菊偏相忆，","传香寄便风。"],["今朝竹林下，","莫使桂尊空。"]]}
{"id":"9013e7ab81","title":"梨花","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["艳静如笼月，","香寒未逐风。","桃花徒照地，","终被笑妖红。"],"stanzas":[["艳静如笼月，","香寒未逐风。"],["桃花徒照地，","终被笑妖红。"]]}
{"id":"adabea99a2","title":"题崔逸人山亭","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["药径深红藓，","山窗满翠微。","羡君花下酒，","蝴蝶梦中飞。"],"stanzas":[["药径深红藓，","山窗满翠微。"],["羡君花下酒，","蝴蝶梦中飞。"]]}
{"id":"a9abc23d96","title":"蓝田溪杂咏二十二首 登台","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["望山登春台，","目尽趣难极。","晚景下平阡，","花际霞峰色。"],"stanzas":[["望山登春台，","目尽趣难极。"],["晚景下平阡，","花际霞峰色。"]]}
{"id":"ea8ce93f73","title":"蓝田溪杂咏二十二首 板桥","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["静宜樵隐度，","远与车马隔。","有时行药来，","喜遇归山客。"],"stanzas":[["静宜樵隐度，","远与车马隔。"],["有时行药来，","喜遇归山客。"]]}
{"id":"ef60b686ad","title":"蓝田溪杂咏二十二首 石井","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["片霞照仙井，","泉底桃花红。","那知幽石下，","不与武陵通。"],"stanzas":[["片霞照仙井，","泉底桃花红。"],["那知幽石下，","不与武陵通。"]]}
{"id":"9edc8d92bf","title":"蓝田溪杂咏二十二首 古藤","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["引蔓出云树，","垂纶覆巢鹤。","幽人对酒时，","苔上闲花落。"],"stanzas":[["引蔓出云树，","垂纶覆巢鹤。"],["幽人对酒时，","苔上闲花落。"]]}
{"id":"bd6a983aa1","title":"蓝田溪杂咏二十二首 晚归鹭","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["池上静难厌，","云间欲去晚。","忽背夕阳飞，","乘兴清风远。"],"stanzas":[["池上静难厌，","云间欲去晚。"],["忽背夕阳飞，","乘兴清风远。"]]}
{"id":"ecc28a064d","title":"蓝田溪杂咏二十二首 洞仙谣","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几转到青山，","数重度流水。","秦人入云去，","知向桃源里。"],"stanzas":[["几转到青山，","数重度流水。"],["秦人入云去，","知向桃源里。"]]}
{"id":"f799611bff","title":"蓝田溪杂咏二十二首 药圃","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春畦生百药，","花叶香初霁。","好容似风光，","偏来入丛蕙。"],"stanzas":[["春畦生百药，","花叶香初霁。"],["好容似风光，","偏来入丛蕙。"]]}
{"id":"328616a67c","title":"蓝田溪杂咏二十二首 石上苔","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["净与溪色连，","幽宜松雨滴。","谁知古石上，","不染世人迹。"],"stanzas":[["净与溪色连，","幽宜松雨滴。"],["谁知古石上，","不染世人迹。"]]}
{"id":"c6c7528a86","title":"蓝田溪杂咏二十二首 窗里山","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远岫见如近，","千里一窗里。","坐来石上云，","乍谓壶中起。"],"stanzas":[["远岫见如近，","千里一窗里。"],["坐来石上云，","乍谓壶中起。"]]}
{"id":"765d252b78","title":"蓝田溪杂咏二十二首 竹间路","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暗归草堂静，","半入花园去。","有时载酒来，","不与清风遇。"],"stanzas":[["暗归草堂静，","半入花园去。"],["有时载酒来，","不与清风遇。"]]}
{"id":"b35da81f11","title":"蓝田溪杂咏二十二首 竹屿","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽鸟清涟上，","兴来看不足。","新篁压水低，","昨夜鸳鸯宿。"],"stanzas":[["幽鸟清涟上，","兴来看不足。"],["新篁压水低，","昨夜鸳鸯宿。"]]}
{"id":"a818f2ba4c","title":"蓝田溪杂咏二十二首 砌下泉","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["穿云来自远，","激砌流偏驶。","能资庭户幽，","更引海禽至。"],"stanzas":[["穿云来自远，","激砌流偏驶。"],["能资庭户幽，","更引海禽至。"]]}
{"id":"7507381e01","title":"蓝田溪杂咏二十二首 戏鸥","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乍依菱蔓聚，","尽向芦花灭。","更喜好风来，","数片翻晴雪。"],"stanzas":[["乍依菱蔓聚，","尽向芦花灭。"],["更喜好风来，","数片翻晴雪。"]]}
{"id":"2b1dab79e4","title":"蓝田溪杂咏二十二首 远山钟","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风送出山钟，","云霞度水浅。","欲知声尽处，","鸟灭寥天远。"],"stanzas":[["风送出山钟，","云霞度水浅。"],["欲知声尽处，","鸟灭寥天远。"]]}
{"id":"460efaa9e9","title":"蓝田溪杂咏二十二首 东陂","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["永日兴难忘，","掇芳春陂曲。","新晴花枝下，","爱此苔水绿。"],"stanzas":[["永日兴难忘，","掇芳春陂曲。"],["新晴花枝下，","爱此苔水绿。"]]}
{"id":"7030a06dd6","title":"蓝田溪杂咏二十二首 池上亭","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["临池构杏梁，","待客归烟塘。","水上褰帘好，","莲开杜若香。"],"stanzas":[["临池构杏梁，","待客归烟塘。"],["水上褰帘好，","莲开杜若香。"]]}
{"id":"87f91de06f","title":"蓝田溪杂咏二十二首 衔鱼翠鸟","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有意莲叶间，","瞥然下高树。","擘波得潜鱼，","一点翠光去。"],"stanzas":[["有意莲叶间，","瞥然下高树。"],["擘波得潜鱼，","一点翠光去。"]]}
{"id":"23517aa2c5","title":"蓝田溪杂咏二十二首 石莲花","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽石生芙蓉，","百花惭美色。","远笑越溪女，","闻芳不可识。"],"stanzas":[["幽石生芙蓉，","百花惭美色。"],["远笑越溪女，","闻芳不可识。"]]}
{"id":"a6adf3ef22","title":"蓝田溪杂咏二十二首 潺湲声","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱石跳素波，","寒声闻几处。","飕飕暝风引，","散出空林去。"],"stanzas":[["乱石跳素波，","寒声闻几处。"],["飕飕暝风引，","散出空林去。"]]}
{"id":"4a4bb702c8","title":"蓝田溪杂咏二十二首 松下雪","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虽因朔风至，","不向瑶台侧。","唯助苦寒松，","偏明后雕色。"],"stanzas":[["虽因朔风至，","不向瑶台侧。"],["唯助苦寒松，","偏明后雕色。"]]}
{"id":"0ad5de2bf1","title":"蓝田溪杂咏二十二首 田鹤","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["田鹤望碧霄，","无风亦自举。","单飞后片云，","早晚及前侣。"],"stanzas":[["田鹤望碧霄，","无风亦自举。"],["单飞后片云，","早晚及前侣。"]]}
{"id":"40d548ea99","title":"蓝田溪杂咏二十二首 题南陂","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家住凤城南，","门临古陂曲。","时怜上林雁，","半入池塘宿。"],"stanzas":[["家住凤城南，","门临古陂曲。"],["时怜上林雁，","半入池塘宿。"]]}
{"id":"851c4b4966","title":"伤秋","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岁去人头白，","秋来树叶黄。","搔头向黄叶，","与尔共悲伤。"],"stanzas":[["岁去人头白，","秋来树叶黄。"],["搔头向黄叶，","与尔共悲伤。"]]}
{"id":"d4fff09d06","title":"送崔山人归山","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东山残雨挂斜晖，","野客巢由指翠微。","别酒稍酣乘兴去，","知君不羡白云归。"],"stanzas":[["东山残雨挂斜晖，","野客巢由指翠微。"],["别酒稍酣乘兴去，","知君不羡白云归。"]]}
{"id":"5c2ede948f","title":"题礼上人壁画山水","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["连山画出暎禅扉，","粉壁香筵满翠微。","坐来𬬻气萦空散，","共指晴云向岭归。"],"stanzas":[["连山画出暎禅扉，","粉壁香筵满翠微。"],["坐来𬬻气萦空散，","共指晴云向岭归。"]]}
{"id":"33c08b429c","title":"送欧阳子还江华郡","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江华胜事接湘滨，","千里湖山入兴新。","才子思归催去櫂，","汀花且为驻残春。"],"stanzas":[["江华胜事接湘滨，","千里湖山入兴新。"],["才子思归催去櫂，","汀花且为驻残春。"]]}
{"id":"a6896fd7d4","title":"暮春归故山草堂","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谷口春残黄鸟稀，","辛夷花尽杏花飞。","始怜幽竹山窗下，","不改清阴待我归。"],"stanzas":[["谷口春残黄鸟稀，","辛夷花尽杏花飞。"],["始怜幽竹山窗下，","不改清阴待我归。"]]}
{"id":"70634f32ae","title":"访李卿不遇","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["画戟朱楼暎晚霞，","高梧寒柳度飞鸦。","门前不见归轩至，","城上愁看落日斜。"],"stanzas":[["画戟朱楼暎晚霞，","高梧寒柳度飞鸦。"],["门前不见归轩至，","城上愁看落日斜。"]]}
{"id":"a3b14d42aa","title":"与赵莒茶䜩","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹下忘言对紫茶，","全胜羽客醉流霞。","尘心洗尽兴难尽，","一树蝉声片影斜。"],"stanzas":[["竹下忘言对紫茶，","全胜羽客醉流霞。"],["尘心洗尽兴难尽，","一树蝉声片影斜。"]]}
{"id":"65fce37420","title":"故王维右丞堂前芍药花开凄然感怀","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芍药花开出旧栏，","春衫掩泪再来看。","主人不在花长在，","更胜青松守岁寒。"],"stanzas":[["芍药花开出旧栏，","春衫掩泪再来看。"],["主人不在花长在，","更胜青松守岁寒。"]]}
{"id":"0002da82b5","title":"送张参及第还家","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大学三年闻琢玉，","东堂一举早成名。","借问还家何处好，","玉人含笑下机迎。"],"stanzas":[["大学三年闻琢玉，","东堂一举早成名。"],["借问还家何处好，","玉人含笑下机迎。"]]}
{"id":"fefffda401","title":"夜泊鹦鹉洲","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月照溪边一罩蓬，","夜闻清唱有微风。","小楼深巷敲方响，","水国人家在处同。"],"stanzas":[["月照溪边一罩蓬，","夜闻清唱有微风。"],["小楼深巷敲方响，","水国人家在处同。"]]}
{"id":"59df9e3349","title":"归雁","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["潇湘何事等闲回，","水碧沙明两岸苔。","二十五弦弹夜月，","不胜清怨却飞来。"],"stanzas":[["潇湘何事等闲回，","水碧沙明两岸苔。"],["二十五弦弹夜月，","不胜清怨却飞来。"]]}
{"id":"0f854d6304","title":"春郊","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水绕冰渠渐有声，","气融烟坞晚来明。","东风好作阳和使，","逢草逢花报发生。"],"stanzas":[["水绕冰渠渐有声，","气融烟坞晚来明。"],["东风好作阳和使，","逢草逢花报发生。"]]}
{"id":"80122bdf96","title":"晚归严明府题门","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["降士林沾蕙草寒，","弦惊翰苑失鸳鸾。","秋中回首君门阻，","马上应歌行路难。"],"stanzas":[["降士林沾蕙草寒，","弦惊翰苑失鸳鸾。"],["秋中回首君门阻，","马上应歌行路难。"]]}
{"id":"2857aff447","title":"秋夜送赵冽归襄阳","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斗酒忘言良夜深，","红萱露滴鹊惊林。","欲知别后思今夕，","汉水东流是寸心。"],"stanzas":[["斗酒忘言良夜深，","红萱露滴鹊惊林。"],["欲知别后思今夕，","汉水东流是寸心。"]]}
{"id":"6230aa8576","title":"送符别驾还郡","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["骥足骎骎吴越关，","屏星复与紫书还。","已知从事元无事，","城上愁看海上山。"],"stanzas":[["骥足骎骎吴越关，","屏星复与紫书还。"],["已知从事元无事，","城上愁看海上山。"]]}
{"id":"0049204f4e","title":"同王员外陇城绝句","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三军版筑脱金刀，","黎庶翻惭将士劳。","不忆新城连嶂起，","唯惊画角入云高。"],"stanzas":[["三军版筑脱金刀，","黎庶翻惭将士劳。"],["不忆新城连嶂起，","唯惊画角入云高。"]]}
{"id":"79a1076481","title":"过故洛城","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故城门外春日斜，","故城门里无人家。","市朝欲认不知处，","漠漠野田空草花。"],"stanzas":[["故城门外春日斜，","故城门里无人家。"],["市朝欲认不知处，","漠漠野田空草花。"]]}
{"id":"8f547b6d4f","title":"校猎曲","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长杨杀气连云飞，","汉主秋畋正掩围。","重门日晏红尘出，","数骑胡人猎兽归。"],"stanzas":[["长杨杀气连云飞，","汉主秋畋正掩围。"],["重门日晏红尘出，","数骑胡人猎兽归。"]]}
{"id":"faba0f1b67","title":"晚过横灞寄张蓝田","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱水东流落照时，","黄花满径客行迟。","林端忽见南山色，","马上还吟陶令诗。"],"stanzas":[["乱水东流落照时，","黄花满径客行迟。"],["林端忽见南山色，","马上还吟陶令诗。"]]}
{"id":"67e18b22ee","title":"九日田舍","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今日陶家野兴偏，","东篱黄菊映秋田。","浮云暝鸟飞将尽，","始达青山新月前。"],"stanzas":[["今日陶家野兴偏，","东篱黄菊映秋田。"],["浮云暝鸟飞将尽，","始达青山新月前。"]]}
{"id":"8630d62d96","title":"长安落第","author":"钱起","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花繁柳暗九门深，","对饮悲歌泪满襟。","数日莺花皆落羽，","一回春至一伤心。"],"stanzas":[["花繁柳暗九门深，","对饮悲歌泪满襟。"],["数日莺花皆落羽，","一回春至一伤心。"]]}
{"id":"43c2d15b11","title":"二风诗   一","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猗皇至圣兮，","至惠至仁。","德施蕴蕴，","蕴蕴如何。","不全不缺，","莫知所贶。"],"stanzas":[["猗皇至圣兮，","至惠至仁。"],["德施蕴蕴，","蕴蕴如何。"],["不全不缺，","莫知所贶。"]]}
{"id":"129edaa927","title":"二风诗   二","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猗皇至圣兮，","至俭至明。","化流瀛瀛，","瀛瀛如何。","不虢不赩，","莫知其极。"],"stanzas":[["猗皇至圣兮，","至俭至明。"],["化流瀛瀛，","瀛瀛如何。"],["不虢不赩，","莫知其极。"]]}
{"id":"40b4635295","title":"二风诗   一","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至化之深兮，","猗猗娭娭。","如煦如吹，","如负如持。","而不知其慈，","故莫周莫止，","静和而止。"],"stanzas":[["至化之深兮，","猗猗娭娭。"],["如煦如吹，","如负如持。"],["而不知其慈，","故莫周莫止，","静和而止。"]]}
{"id":"d16df87d48","title":"二风诗   二","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至化之极兮，","瀛瀛溶溶。","如涵如封，","如随如从。","而不知其功，","故莫由莫己，","顺时而理。"],"stanzas":[["至化之极兮，","瀛瀛溶溶。"],["如涵如封，","如随如从。"],["而不知其功，","故莫由莫己，","顺时而理。"]]}
{"id":"17cff8ec1e","title":"二风诗   一","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至哉勤绩，","不盈不延。","谁能颂之，","我请颂焉。","於戏劳王，","勤亦何极。","济尔九土，","山川沟洫。"],"stanzas":[["至哉勤绩，","不盈不延。"],["谁能颂之，","我请颂焉。"],["於戏劳王，","勤亦何极。"],["济尔九土，","山川沟洫。"]]}
{"id":"fedc41fbf8","title":"二风诗   二","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至哉俭德，","不丰不敷。","谁能颂之，","我请颂夫。","於戏劳王，","俭亦何深。","戒尔万代，","奢侈荒淫。"],"stanzas":[["至哉俭德，","不丰不敷。"],["谁能颂之，","我请颂夫。"],["於戏劳王，","俭亦何深。"],["戒尔万代，","奢侈荒淫。"]]}
{"id":"04100b3b11","title":"二风诗   三","author":"元结","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至哉茂功，","不升不圯。","谁能颂之，","我请颂矣。","於戏劳王，","功亦何大。","去尔兆庶，","洪湮灾害。"],"stanzas":[["至哉茂功，","不升不圯。"],["谁能颂之，","我请颂矣。"],["於戏劳王，","功亦何大。"],["去尔兆庶，","洪湮灾害。"]]}
