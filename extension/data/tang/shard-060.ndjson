{"id":"e7dc4bb6ba","title":"杂曲歌辞 思归乐 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里春应尽，","三江鴈亦稀。","连天汉水广，","孤客未言归。"],"stanzas":[["万里春应尽，","三江鴈亦稀。"],["连天汉水广，","孤客未言归。"]]}
{"id":"473c82b557","title":"杂曲歌辞 金殿乐","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["入夜秋砧动，","千门起四邻。","不缘楼上月，","应为陇头人。"],"stanzas":[["入夜秋砧动，","千门起四邻。"],["不缘楼上月，","应为陇头人。"]]}
{"id":"01aa012a17","title":"杂曲歌辞 胡渭州 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["亭亭孤月照行舟，","寂寂长江万里流。","乡国不知何处是？","云山漫漫使人愁。"],"stanzas":[["亭亭孤月照行舟，","寂寂长江万里流。"],["乡国不知何处是？","云山漫漫使人愁。"]]}
{"id":"84027910e3","title":"杂曲歌辞 胡渭州 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳千寻色，","桃花一苑芳。","风吹入帘里，","惟有惹衣香。"],"stanzas":[["杨柳千寻色，","桃花一苑芳。"],["风吹入帘里，","惟有惹衣香。"]]}
{"id":"f20e24b683","title":"杂曲歌辞 戎浑","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风劲角弓鸣，","将军猎渭城。","草枯鹰眼疾，","雪尽马蹏轻。"],"stanzas":[["风劲角弓鸣，","将军猎渭城。"],["草枯鹰眼疾，","雪尽马蹏轻。"]]}
{"id":"0f930dd3c1","title":"杂曲歌辞 墙头花 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蟋蟀鸣洞房，","梧桐落金井。","为君裁舞衣，","天寒翦刀冷。"],"stanzas":[["蟋蟀鸣洞房，","梧桐落金井。"],["为君裁舞衣，","天寒翦刀冷。"]]}
{"id":"6ed60a02d7","title":"杂曲歌辞 墙头花 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾有罗衣裳，","秦王在时作。","为舞春风多，","秋来不堪著。"],"stanzas":[["妾有罗衣裳，","秦王在时作。"],["为舞春风多，","秋来不堪著。"]]}
{"id":"5e49cf07be","title":"杂曲歌辞 采桑","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自古多征战，","由来尚甲兵。","长驱千里去，","一举两蕃平。","按劒从沙漠歌谣满帝京寄言天下将须立武功名。"],"stanzas":[["自古多征战，","由来尚甲兵。"],["长驱千里去，","一举两蕃平。"],["按劒从沙漠歌谣满帝京寄言天下将须立武功名。"]]}
{"id":"04968a7573","title":"杂曲歌辞 [杨]下采桑","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飞丝惹绿尘，","软叶对孤轮。","今朝入园去，","物色彊看人。"],"stanzas":[["飞丝惹绿尘，","软叶对孤轮。"],["今朝入园去，","物色彊看人。"]]}
{"id":"c7c1e2c8f7","title":"杂曲歌辞 破阵乐 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋来四面足风沙，","塞外征人暂别家。","千里不辞行路远，","时光早晚到天涯。"],"stanzas":[["秋来四面足风沙，","塞外征人暂别家。"],["千里不辞行路远，","时光早晚到天涯。"]]}
{"id":"3943d46809","title":"杂曲歌辞 破阵乐 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉兵出顿金微，","照日明光铁衣。","百里火幡熖熖，","千行云骑𬴂𬴂。","蹙踏辽河自竭，","鼓噪燕山可飞。","正属四方朝贺，","端知万舞皇威。"],"stanzas":[["汉兵出顿金微，","照日明光铁衣。"],["百里火幡熖熖，","千行云骑𬴂𬴂。"],["蹙踏辽河自竭，","鼓噪燕山可飞。"],["正属四方朝贺，","端知万舞皇威。"]]}
{"id":"19d3d761f5","title":"杂曲歌辞 破阵乐 三","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年胆气凌云，","共许骁雄出群。","匹马城南挑战，","单刀蓟北从军。","一鼓鲜卑送欵，","五饵单于解纷。","誓欲成名报国，","羞将开口论勋。"],"stanzas":[["少年胆气凌云，","共许骁雄出群。"],["匹马城南挑战，","单刀蓟北从军。"],["一鼓鲜卑送欵，","五饵单于解纷。"],["誓欲成名报国，","羞将开口论勋。"]]}
{"id":"5bd41fb0e1","title":"杂曲歌辞 战胜乐","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百战得功名，","天兵意气生。","三边永不战，","此是我皇英。"],"stanzas":[["百战得功名，","天兵意气生。"],["三边永不战，","此是我皇英。"]]}
{"id":"0f116b3991","title":"杂曲歌辞 劒南臣","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不分君恩断，","观妆视镜中。","容华尚春日，","娇爱已秋风。","枕席临窗晓，","屏帷对月空。","年年后庭树，","芳悴在深宫。"],"stanzas":[["不分君恩断，","观妆视镜中。"],["容华尚春日，","娇爱已秋风。"],["枕席临窗晓，","屏帷对月空。"],["年年后庭树，","芳悴在深宫。"]]}
{"id":"21449d84ec","title":"杂曲歌辞 征步郎","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["塞外虏尘飞，","频年度碛西。","死生随玉劒，","辛苦向金微。"],"stanzas":[["塞外虏尘飞，","频年度碛西。"],["死生随玉劒，","辛苦向金微。"]]}
{"id":"1ee1f1fa7b","title":"杂曲歌辞 [叹]疆场","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻道行人至，","妆梳对镜台。","泪痕犹尚在，","笑靥自然开。"],"stanzas":[["闻道行人至，","妆梳对镜台。"],["泪痕犹尚在，","笑靥自然开。"]]}
{"id":"e598916e29","title":"杂曲歌辞 塞姑","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日卢梅塞口，","整见诸人镇守。","都护三年不归，","折尽江边杨柳。"],"stanzas":[["昨日卢梅塞口，","整见诸人镇守。"],["都护三年不归，","折尽江边杨柳。"]]}
{"id":"ccb3242e89","title":"杂曲歌辞 水鼓子","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雕弓白羽猎初回，","薄夜牛羊复下来。","梦水河边秋草合，","黑山峰外阵云开。"],"stanzas":[["雕弓白羽猎初回，","薄夜牛羊复下来。"],["梦水河边秋草合，","黑山峰外阵云开。"]]}
{"id":"5e74469717","title":"杂曲歌辞 婆罗门","author":"杨敬述进","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回乐峰前沙似雪，","受降城外月如霜。","不知何处吹芦管？","一夜征人尽望乡。"],"stanzas":[["回乐峰前沙似雪，","受降城外月如霜。"],["不知何处吹芦管？","一夜征人尽望乡。"]]}
{"id":"7862f21ac4","title":"杂曲歌辞 浣沙女 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南陌春风早，","东邻去日斜。","千花开瑞锦，","香扑美人车。"],"stanzas":[["南陌春风早，","东邻去日斜。"],["千花开瑞锦，","香扑美人车。"]]}
{"id":"b08472aef8","title":"杂曲歌辞 浣沙女 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长乐青门外，","宜春小苑东。","楼开万户上，","人向百花中。"],"stanzas":[["长乐青门外，","宜春小苑东。"],["楼开万户上，","人向百花中。"]]}
{"id":"080798d0e3","title":"杂曲歌辞 镇西","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天边物色更无春，","祗有羊群与马群。","谁家营里吹羌笛，","哀怨教人不忍闻。"],"stanzas":[["天边物色更无春，","祗有羊群与马群。"],["谁家营里吹羌笛，","哀怨教人不忍闻。"]]}
{"id":"d2a12ee81a","title":"杂曲歌辞 镇西 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岁去年来拜圣朝，","更无山阙对溪桥。","九门杨柳浑无半，","犹自千条与万条。"],"stanzas":[["岁去年来拜圣朝，","更无山阙对溪桥。"],["九门杨柳浑无半，","犹自千条与万条。"]]}
{"id":"b514acf064","title":"杂曲歌辞 回纥","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾闻瀚海使难通，","幽闺少妇罢裁缝。","缅想边庭征战苦，","谁能对镜治愁容。","久戍人将老，","须臾变作白头翁。"],"stanzas":[["曾闻瀚海使难通，","幽闺少妇罢裁缝。"],["缅想边庭征战苦，","谁能对镜治愁容。"],["久戍人将老，","须臾变作白头翁。"]]}
{"id":"5aec914793","title":"杂曲歌辞 长命女","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云送关西雨，","风传渭北秋。","孤灯然客梦，","寒杵捣乡愁。"],"stanzas":[["云送关西雨，","风传渭北秋。"],["孤灯然客梦，","寒杵捣乡愁。"]]}
{"id":"8e4ed5ad5d","title":"杂曲歌辞 醉公子","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日春园饮，","今朝倒接䍠。","谁人扶上马，","不省下楼时。"],"stanzas":[["昨日春园饮，","今朝倒接䍠。"],["谁人扶上马，","不省下楼时。"]]}
{"id":"459275b122","title":"杂曲歌辞 一片子","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳色青山映，","梨花雪鸟藏。","绿窗桃李下，","闲坐叹春芳。"],"stanzas":[["柳色青山映，","梨花雪鸟藏。"],["绿窗桃李下，","闲坐叹春芳。"]]}
{"id":"ea7d9d6f7c","title":"杂曲歌辞 甘州","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲使传消息，","空书意不任。","寄君明月镜，","偏照故人心。"],"stanzas":[["欲使传消息，","空书意不任。"],["寄君明月镜，","偏照故人心。"]]}
{"id":"5708c992d6","title":"杂曲歌辞 濮阳女","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鴈来书不至，","月照独眠房。","贱妾多愁思，","不堪秋夜长。"],"stanzas":[["鴈来书不至，","月照独眠房。"],["贱妾多愁思，","不堪秋夜长。"]]}
{"id":"abbfb56d6d","title":"杂曲歌辞 相府莲","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜闻邻妇泣，","切切有余哀。","即问缘何事，","征人战未回。"],"stanzas":[["夜闻邻妇泣，","切切有余哀。"],["即问缘何事，","征人战未回。"]]}
{"id":"cf55ea3724","title":"杂曲歌辞 蔟拍相府莲","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫以今时宠，","宁无旧日恩。","看花满眼泪，","不共楚王言。","闺烛无人影，","罗屏有梦魂。","近来音耗绝，","终日望应门。"],"stanzas":[["莫以今时宠，","宁无旧日恩。"],["看花满眼泪，","不共楚王言。"],["闺烛无人影，","罗屏有梦魂。"],["近来音耗绝，","终日望应门。"]]}
{"id":"22b97ce817","title":"杂曲歌辞 离别难","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此别难重陈，","花深复变人。","来时梅覆雪，","去日柳含春。","物候催行客，","归途淑气新。","剡川今已远，","魂梦暗相亲。"],"stanzas":[["此别难重陈，","花深复变人。"],["来时梅覆雪，","去日柳含春。"],["物候催行客，","归途淑气新。"],["剡川今已远，","魂梦暗相亲。"]]}
{"id":"e7d15e4be1","title":"杂曲歌辞 离别难","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿杨陌上送行人，","马去车回一望尘。","不觉别时红泪尽，","归来无泪可沾巾。"],"stanzas":[["绿杨陌上送行人，","马去车回一望尘。"],["不觉别时红泪尽，","归来无泪可沾巾。"]]}
{"id":"e5a5714aa4","title":"杂曲歌辞 山鹧鸪 一","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉关征戍久，","空闺人独愁。","寒露湿青苔，","别来蓬鬓秋。"],"stanzas":[["玉关征戍久，","空闺人独愁。"],["寒露湿青苔，","别来蓬鬓秋。"]]}
{"id":"6de560d4dd","title":"杂曲歌辞 山鹧鸪 二","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人坐青楼晚，","莺语百花时。","愁人多自老，","肠断君不知。"],"stanzas":[["人坐青楼晚，","莺语百花时。"],["愁人多自老，","肠断君不知。"]]}
{"id":"fd5325a0e5","title":"杂曲歌辞 鹧鸪词","author":"李益","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湘江斑竹枝，","锦翼鹧鸪飞。","处处湘云合，","郎从何处归。"],"stanzas":[["湘江斑竹枝，","锦翼鹧鸪飞。"],["处处湘云合，","郎从何处归。"]]}
{"id":"8c9bce510c","title":"杂曲歌辞 鹧鸪词 一","author":"李涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湘江烟水深，","沙岸隔枫林。","何处鹧鸪飞？","日斜斑竹阴。","二女虚垂泪，","三闾枉自沈。","惟有鹧鸪鸟，","独伤行客心。"],"stanzas":[["湘江烟水深，","沙岸隔枫林。"],["何处鹧鸪飞？","日斜斑竹阴。"],["二女虚垂泪，","三闾枉自沈。"],["惟有鹧鸪鸟，","独伤行客心。"]]}
{"id":"4cb574b386","title":"杂曲歌辞 鹧鸪词 二","author":"李涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越冈连越井，","越鸟更南飞。","何处鹧鸪嗁，","夕烟东岭归。","岭头行人少，","天涯北客稀。","鹧鸪嗁别处，","相对泪沾衣。"],"stanzas":[["越冈连越井，","越鸟更南飞。"],["何处鹧鸪嗁，","夕烟东岭归。"],["岭头行人少，","天涯北客稀。"],["鹧鸪嗁别处，","相对泪沾衣。"]]}
{"id":"7d33bf753d","title":"杂曲歌辞 乐世","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["管急丝繁拍渐稠，","绿腰宛转曲终头。","诚知乐世声声乐，","老病人听未免愁。"],"stanzas":[["管急丝繁拍渐稠，","绿腰宛转曲终头。"],["诚知乐世声声乐，","老病人听未免愁。"]]}
{"id":"145fa51bd5","title":"杂曲歌辞 急[乐世]","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正抽碧线绣红罗，","忽听黄莺敛翠蛾。","秋思冬愁春恨望，","大都不得意时多。"],"stanzas":[["正抽碧线绣红罗，","忽听黄莺敛翠蛾。"],["秋思冬愁春恨望，","大都不得意时多。"]]}
{"id":"9fba9f86f5","title":"杂曲歌辞 何满子","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世传满子是人名，","临就刑时曲始成。","一曲四词歌八叠，","从头便是断肠声。"],"stanzas":[["世传满子是人名，","临就刑时曲始成。"],["一曲四词歌八叠，","从头便是断肠声。"]]}
{"id":"9b981c4ab2","title":"杂曲歌辞 何满子","author":"薛逢","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["系马宫槐老，","持杯店菊黄。","故交今不见，","流恨满川光。"],"stanzas":[["系马宫槐老，","持杯店菊黄。"],["故交今不见，","流恨满川光。"]]}
{"id":"1a2a09f872","title":"杂曲歌辞 清平调 一","author":"李白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云想衣裳花想容，","春风拂槛露华浓。","若非群玉山头见，","会向瑶台月下逢。"],"stanzas":[["云想衣裳花想容，","春风拂槛露华浓。"],["若非群玉山头见，","会向瑶台月下逢。"]]}
{"id":"9ce7f70c74","title":"杂曲歌辞 清平调 二","author":"李白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一枝红艳露凝香，","云雨巫山枉断肠。","借问汉宫谁得似，","可怜飞燕倚新妆。"],"stanzas":[["一枝红艳露凝香，","云雨巫山枉断肠。"],["借问汉宫谁得似，","可怜飞燕倚新妆。"]]}
{"id":"ab139e1d2a","title":"杂曲歌辞 清平调 三","author":"李白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名花倾国两相欢，","长得君王带笑看。","解释春风无限恨，","沉香亭北倚阑干。"],"stanzas":[["名花倾国两相欢，","长得君王带笑看。"],["解释春风无限恨，","沉香亭北倚阑干。"]]}
{"id":"51a233032d","title":"杂曲歌辞 回波乐","author":"李景伯","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回波尔时酒巵，","微臣职在箴规。","侍宴既过三爵，","諠哗窃恐非仪。"],"stanzas":[["回波尔时酒巵，","微臣职在箴规。"],["侍宴既过三爵，","諠哗窃恐非仪。"]]}
{"id":"3d6cc463d2","title":"杂曲歌辞 圣明乐 一","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉帛殊方至，","歌钟比屋闻。","华夷今一贯，","同贺圣明君。"],"stanzas":[["玉帛殊方至，","歌钟比屋闻。"],["华夷今一贯，","同贺圣明君。"]]}
{"id":"614bc91e08","title":"杂曲歌辞 圣明乐 二","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九陌祥烟合，","千春瑞月明。","宫花将苑柳，","先发凤皇城。"],"stanzas":[["九陌祥烟合，","千春瑞月明。"],["宫花将苑柳，","先发凤皇城。"]]}
{"id":"b1dbbe7ff0","title":"杂曲歌辞 圣明乐","author":"令狐楚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海浪恬丹徼，","边尘静异山。","从今万里外，","不复锁萧关。"],"stanzas":[["海浪恬丹徼，","边尘静异山。"],["从今万里外，","不复锁萧关。"]]}
{"id":"6fe4fb34d6","title":"杂曲歌辞 大酺乐","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["泪滴珠难尽，","容残玉易销。","傥随明月去，","莫道梦魂遥。"],"stanzas":[["泪滴珠难尽，","容残玉易销。"],["傥随明月去，","莫道梦魂遥。"]]}
{"id":"7857f70695","title":"杂曲歌辞 大酺乐 一","author":"杜审言","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣后乘干日，","皇明御历辰。","紫宫初启坐，","苍璧正临春。","雷雨垂膏泽，","金钱赐下人。","诏酺欢赏徧，","交泰覩惟新。"],"stanzas":[["圣后乘干日，","皇明御历辰。"],["紫宫初启坐，","苍璧正临春。"],["雷雨垂膏泽，","金钱赐下人。"],["诏酺欢赏徧，","交泰覩惟新。"]]}
{"id":"654d95a770","title":"杂曲歌辞 大酺乐 二","author":"杜审言","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["毘陵震泽九州通，","士女欢娱万国同。","伐鼓撞钟惊海上，","新妆袨服照江东。","梅花落处疑残雪，","柳叶开时任好风。","大德不官逢道泰，","天长地久属年丰。"],"stanzas":[["毘陵震泽九州通，","士女欢娱万国同。"],["伐鼓撞钟惊海上，","新妆袨服照江东。"],["梅花落处疑残雪，","柳叶开时任好风。"],["大德不官逢道泰，","天长地久属年丰。"]]}
{"id":"7e85087604","title":"杂曲歌辞 大酺乐 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["车驾东来值太平，","大酺三日洛阳城。","小儿一伎竿头绝，","天下传呼万岁声。"],"stanzas":[["车驾东来值太平，","大酺三日洛阳城。"],["小儿一伎竿头绝，","天下传呼万岁声。"]]}
{"id":"c16f4dc63d","title":"杂曲歌辞 大酺乐 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫陌酺归日欲斜，","红尘开路薛王家。","双鬟前说楼前鼓，","两伎争轮好结花。"],"stanzas":[["紫陌酺归日欲斜，","红尘开路薛王家。"],["双鬟前说楼前鼓，","两伎争轮好结花。"]]}
{"id":"adb981bc01","title":"杂曲歌辞 千秋乐","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八月平时花萼楼，","万方同乐奏千秋。","倾城人看长竿出，","一伎初成赵解愁。"],"stanzas":[["八月平时花萼楼，","万方同乐奏千秋。"],["倾城人看长竿出，","一伎初成赵解愁。"]]}
{"id":"468706b793","title":"杂曲歌辞 火凤辞 一","author":"李百药","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌声扇里出，","妆影扇中轻。","未能令掩笑，","何处欲鄣声。","知音自不惑，","得念是分明。","莫见双嚬敛，","疑人含笑情。"],"stanzas":[["歌声扇里出，","妆影扇中轻。"],["未能令掩笑，","何处欲鄣声。"],["知音自不惑，","得念是分明。"],["莫见双嚬敛，","疑人含笑情。"]]}
{"id":"e1b2c930a8","title":"杂曲歌辞 火凤辞 二","author":"李百药","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳人靓晚妆，","清唱动兰房。","影入含风扇，","声飞照日梁。","娇嚬眉际敛，","逸韵口中香。","自有横陈分，","应怜秋夜长。"],"stanzas":[["佳人靓晚妆，","清唱动兰房。"],["影入含风扇，","声飞照日梁。"],["娇嚬眉际敛，","逸韵口中香。"],["自有横陈分，","应怜秋夜长。"]]}
{"id":"2ff361a4df","title":"杂曲歌辞 热戏乐","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["热戏争心剧火烧，","铜槌暗执不相饶。","上皇失喜宁王笑，","百尺幢竿果动摇。"],"stanzas":[["热戏争心剧火烧，","铜槌暗执不相饶。"],["上皇失喜宁王笑，","百尺幢竿果动摇。"]]}
{"id":"ac832036b2","title":"杂曲歌辞 春莺啭","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兴庆池南柳未开，","太真先把一枝梅。","内人已唱春莺啭，","花下傞傞软舞来。"],"stanzas":[["兴庆池南柳未开，","太真先把一枝梅。"],["内人已唱春莺啭，","花下傞傞软舞来。"]]}
{"id":"9b06442862","title":"杂曲歌辞 达摩支","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["捣麝成尘香不灭，","拗莲作寸丝难绝。","红泪文姬洛水春，","白头苏武天山雪。","君不见无愁高纬花漫漫，","漳浦宴余清露寒。","一旦臣僚共囚虏，","欲吹羌管先汍澜。","旧臣头鬓霜华早，","可惜雄心醉中老。","万古春归梦不归，","邺城风雨连天草。"],"stanzas":[["捣麝成尘香不灭，","拗莲作寸丝难绝。"],["红泪文姬洛水春，","白头苏武天山雪。"],["君不见无愁高纬花漫漫，","漳浦宴余清露寒。"],["一旦臣僚共囚虏，","欲吹羌管先汍澜。"],["旧臣头鬓霜华早，","可惜雄心醉中老。"],["万古春归梦不归，","邺城风雨连天草。"]]}
{"id":"edb78b748a","title":"杂曲歌辞 如意娘","author":"则天皇后","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["看朱成碧思纷纷，","憔悴支离为忆君。","不信比来长下泪，","开箱验取石榴裙。"],"stanzas":[["看朱成碧思纷纷，","憔悴支离为忆君。"],["不信比来长下泪，","开箱验取石榴裙。"]]}
{"id":"6c422ecc65","title":"杂曲歌辞 雨霖铃","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨霖铃夜却归秦，","犹是张徽一曲新。","长说上皇垂泪教，","月明南内更无人。"],"stanzas":[["雨霖铃夜却归秦，","犹是张徽一曲新。"],["长说上皇垂泪教，","月明南内更无人。"]]}
{"id":"33e53bcb71","title":"杂曲歌辞 桂花曲","author":"不详","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可怜天上桂花孤，","试问姮娥更要无。","月宫幸有闲田地，","何不中央种两株。"],"stanzas":[["可怜天上桂花孤，","试问姮娥更要无。"],["月宫幸有闲田地，","何不中央种两株。"]]}
{"id":"a37c5ed8ac","title":"杂曲歌辞 渭城曲","author":"王维","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谓城朝雨浥轻尘，","客舍青青柳色春。","劝君更尽一杯酒，","西出阳关无故人。"],"stanzas":[["谓城朝雨浥轻尘，","客舍青青柳色春。"],["劝君更尽一杯酒，","西出阳关无故人。"]]}
{"id":"1bb62dec82","title":"杂曲歌辞 竹枝","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["帝子苍梧不复归，","洞庭叶下荆云飞。","巴人夜唱竹枝后，","肠断晓猨声渐稀。"],"stanzas":[["帝子苍梧不复归，","洞庭叶下荆云飞。"],["巴人夜唱竹枝后，","肠断晓猨声渐稀。"]]}
{"id":"14a8918585","title":"杂曲歌辞 竹枝 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白帝城头春草生，","白盐山下蜀江清。","南人上来歌一曲，","北人莫上动乡情。"],"stanzas":[["白帝城头春草生，","白盐山下蜀江清。"],["南人上来歌一曲，","北人莫上动乡情。"]]}
{"id":"cc25385c51","title":"杂曲歌辞 竹枝 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山桃红花满上头，","蜀江春水拍江流。","花红易衰似郎意，","水流无限似侬愁。"],"stanzas":[["山桃红花满上头，","蜀江春水拍江流。"],["花红易衰似郎意，","水流无限似侬愁。"]]}
{"id":"7a693e865b","title":"杂曲歌辞 竹枝 三","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江上朱楼新雨晴，","瀼西春水縠文生。","桥东桥西好杨柳，","人来人去唱歌行。"],"stanzas":[["江上朱楼新雨晴，","瀼西春水縠文生。"],["桥东桥西好杨柳，","人来人去唱歌行。"]]}
{"id":"055c4e04b7","title":"杂曲歌辞 竹枝 四","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日出三竿春雾消，","江头蜀客驻兰桡。","凭寄狂夫书一纸，","住在成都万里桥。"],"stanzas":[["日出三竿春雾消，","江头蜀客驻兰桡。"],["凭寄狂夫书一纸，","住在成都万里桥。"]]}
{"id":"e426caa8b6","title":"杂曲歌辞 竹枝 五","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两岸山花似雪开，","家家春酒满银杯。","昭君坊中多女伴，","永安宫外踏青来。"],"stanzas":[["两岸山花似雪开，","家家春酒满银杯。"],["昭君坊中多女伴，","永安宫外踏青来。"]]}
{"id":"7fb2bcb62e","title":"杂曲歌辞 竹枝 六","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瞿塘嘈嘈十二滩，","此中道路古来难。","长恨人心不如水，","等闲平地起波澜。"],"stanzas":[["瞿塘嘈嘈十二滩，","此中道路古来难。"],["长恨人心不如水，","等闲平地起波澜。"]]}
{"id":"b7e9fc9267","title":"杂曲歌辞 竹枝 七","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巫峡苍苍烟雨时，","清猨啼在最高枝。","个里愁人肠自断，","由来不是此声悲。"],"stanzas":[["巫峡苍苍烟雨时，","清猨啼在最高枝。"],["个里愁人肠自断，","由来不是此声悲。"]]}
{"id":"0432ea6741","title":"杂曲歌辞 竹枝 八","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["城西门前滟滪堆，","年年波浪不能摧。","懊恼人心不如石，","少时东去复西来。"],"stanzas":[["城西门前滟滪堆，","年年波浪不能摧。"],["懊恼人心不如石，","少时东去复西来。"]]}
{"id":"2d58458a00","title":"杂曲歌辞 竹枝 九","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山上层层桃李花，","云间烟火是人家。","银钏金钗来负水，","长刀短笠去烧畬。"],"stanzas":[["山上层层桃李花，","云间烟火是人家。"],["银钏金钗来负水，","长刀短笠去烧畬。"]]}
{"id":"ec5ee49f78","title":"杂曲歌辞 竹枝 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳青青江水平，","闻郎江上唱歌声。","东边日出西边雨，","道是无情还有情。"],"stanzas":[["杨柳青青江水平，","闻郎江上唱歌声。"],["东边日出西边雨，","道是无情还有情。"]]}
{"id":"40cc9e42bc","title":"杂曲歌辞 竹枝 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚水巴山江雨多，","巴人能唱本乡歌。","今朝北客思归去，","回入纥那披绿罗。"],"stanzas":[["楚水巴山江雨多，","巴人能唱本乡歌。"],["今朝北客思归去，","回入纥那披绿罗。"]]}
{"id":"42ca498cca","title":"杂曲歌辞 竹枝 一","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瞿塘峡口冷烟低，","白帝城头月向西。","唱到竹枝声咽处，","寒猨晴鸟一时啼。"],"stanzas":[["瞿塘峡口冷烟低，","白帝城头月向西。"],["唱到竹枝声咽处，","寒猨晴鸟一时啼。"]]}
{"id":"31803aa169","title":"杂曲歌辞 竹枝 二","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹枝苦怨怨何人，","夜静山空歇又闻。","蛮儿巴女齐声唱，","愁杀江楼病使君。"],"stanzas":[["竹枝苦怨怨何人，","夜静山空歇又闻。"],["蛮儿巴女齐声唱，","愁杀江楼病使君。"]]}
{"id":"e4d3dde94f","title":"杂曲歌辞 竹枝 三","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巴东船舫上巴西，","波面风生雨脚齐。","水蓼冷花红蔟蔟，","江蓠湿叶碧萋萋。"],"stanzas":[["巴东船舫上巴西，","波面风生雨脚齐。"],["水蓼冷花红蔟蔟，","江蓠湿叶碧萋萋。"]]}
{"id":"fed4faf9ed","title":"杂曲歌辞 竹枝 四","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江畔谁人唱竹枝，","前声断咽后声迟。","怪来调苦缘词苦，","多是通州司马诗。"],"stanzas":[["江畔谁人唱竹枝，","前声断咽后声迟。"],["怪来调苦缘词苦，","多是通州司马诗。"]]}
{"id":"fd662784f3","title":"杂曲歌辞 竹枝 一","author":"李涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荆门滩急水潺潺，","两岸猨啼烟满山。","渡头年少应官去，","月落西陵望不还。"],"stanzas":[["荆门滩急水潺潺，","两岸猨啼烟满山。"],["渡头年少应官去，","月落西陵望不还。"]]}
{"id":"285cdd7782","title":"杂曲歌辞 竹枝 二","author":"李涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巫峡云开神女祠，","绿潭红树影参差。","下牢戍口初相问，","无义滩头剩别离。"],"stanzas":[["巫峡云开神女祠，","绿潭红树影参差。"],["下牢戍口初相问，","无义滩头剩别离。"]]}
{"id":"c6ea41a225","title":"杂曲歌辞 竹枝 三","author":"李涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["石壁千重树万重，","白云斜掩碧芙蓉。","昭君溪上年年月，","独自婵娟色最浓。"],"stanzas":[["石壁千重树万重，","白云斜掩碧芙蓉。"],["昭君溪上年年月，","独自婵娟色最浓。"]]}
{"id":"892ac9de6a","title":"杂曲歌辞 竹枝 四","author":"李涉","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十二峰头月欲低，","空蒙江上子规啼。","孤舟一夜东归客，","泣向春风忆建溪。"],"stanzas":[["十二峰头月欲低，","空蒙江上子规啼。"],["孤舟一夜东归客，","泣向春风忆建溪。"]]}
{"id":"26ba60eb67","title":"杂曲歌辞 竹枝 一","author":"孙光宪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门前春水白苹花，","岸上无人小艇斜。","商女经过江欲暮，","散抛残食饲神雅。"],"stanzas":[["门前春水白苹花，","岸上无人小艇斜。"],["商女经过江欲暮，","散抛残食饲神雅。"]]}
{"id":"b60569239c","title":"杂曲歌辞 竹枝 二","author":"孙光宪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱绳千结绊人深，","越罗万丈表长寻。","杨柳在身垂意绪，","藕花落尽见莲心。"],"stanzas":[["乱绳千结绊人深，","越罗万丈表长寻。"],["杨柳在身垂意绪，","藕花落尽见莲心。"]]}
{"id":"a2c6ff6647","title":"杂曲歌辞 杨柳枝 一","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一树春风万万枝，","嫩于金色软于丝。","永丰西角荒园里，","尽日无人属阿谁。"],"stanzas":[["一树春风万万枝，","嫩于金色软于丝。"],["永丰西角荒园里，","尽日无人属阿谁。"]]}
{"id":"b37c9a9119","title":"杂曲歌辞 杨柳枝 二","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一树衰残委泥土，","双枝荣耀植天庭。","定知玄象今春后，","柳宿光中添两星。"],"stanzas":[["一树衰残委泥土，","双枝荣耀植天庭。"],["定知玄象今春后，","柳宿光中添两星。"]]}
{"id":"a405026d12","title":"杂曲歌辞 杨柳枝 一","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六么水调家家唱，","白雪梅花处处吹。","古歌旧曲君休听，","听取新翻杨柳枝。"],"stanzas":[["六么水调家家唱，","白雪梅花处处吹。"],["古歌旧曲君休听，","听取新翻杨柳枝。"]]}
{"id":"1f3800a5dd","title":"杂曲歌辞 杨柳枝 二","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陶令门前四五树，","亚夫营里百千条。","何似东都正二月，","黄金枝映洛阳桥。"],"stanzas":[["陶令门前四五树，","亚夫营里百千条。"],["何似东都正二月，","黄金枝映洛阳桥。"]]}
{"id":"e84e0bd073","title":"杂曲歌辞 杨柳枝 三","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["依依袅袅复青青，","句引清风无限情。","白雪花繁空扑地，","绿丝条弱不胜莺。"],"stanzas":[["依依袅袅复青青，","句引清风无限情。"],["白雪花繁空扑地，","绿丝条弱不胜莺。"]]}
{"id":"497d80bd56","title":"杂曲歌辞 杨柳枝 四","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红板江桥青酒旗，","馆娃宫暖日斜时。","可怜雨歇东风定，","万树千条各自垂。"],"stanzas":[["红板江桥青酒旗，","馆娃宫暖日斜时。"],["可怜雨歇东风定，","万树千条各自垂。"]]}
{"id":"e456ae35f2","title":"杂曲歌辞 杨柳枝 五","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苏州杨柳任君夸，","更有钱塘胜馆娃。","若解多情寻小小，","绿杨深处是苏家。"],"stanzas":[["苏州杨柳任君夸，","更有钱塘胜馆娃。"],["若解多情寻小小，","绿杨深处是苏家。"]]}
{"id":"af78fdd6c1","title":"杂曲歌辞 杨柳枝 六","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苏家小女旧知名，","杨柳风前别有情。","剥条盘作银环样，","卷叶吹为玉笛声。"],"stanzas":[["苏家小女旧知名，","杨柳风前别有情。"],["剥条盘作银环样，","卷叶吹为玉笛声。"]]}
{"id":"1da1cca93c","title":"杂曲歌辞 杨柳枝 七","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叶含浓露如啼眼，","枝袅轻风似舞腰。","小树不禁攀折苦，","乞君留取两三条。"],"stanzas":[["叶含浓露如啼眼，","枝袅轻风似舞腰。"],["小树不禁攀折苦，","乞君留取两三条。"]]}
{"id":"f897b3d393","title":"杂曲歌辞 杨柳枝 八","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人言柳叶似愁眉，","更有愁肠似柳丝。","柳丝挽断肠牵断，","彼此应无续得期。"],"stanzas":[["人言柳叶似愁眉，","更有愁肠似柳丝。"],["柳丝挽断肠牵断，","彼此应无续得期。"]]}
{"id":"d2e2917835","title":"杂曲歌辞 杨柳枝","author":"卢贞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一树依依在永丰，","两枝飞去杳无踪。","玉皇曾采人间曲，","应逐歌声入九重。"],"stanzas":[["一树依依在永丰，","两枝飞去杳无踪。"],["玉皇曾采人间曲，","应逐歌声入九重。"]]}
{"id":"68be248093","title":"杂曲歌辞 杨柳枝 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["塞北梅花羌笛吹，","淮南桂树小山词。","请君莫奏前朝曲，","听唱新翻杨柳枝。"],"stanzas":[["塞北梅花羌笛吹，","淮南桂树小山词。"],["请君莫奏前朝曲，","听唱新翻杨柳枝。"]]}
{"id":"8eff0f4099","title":"杂曲歌辞 杨柳枝 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南陌东城春早时，","相逢何处不依依。","桃红李白皆夸好，","须得垂杨相发辉。"],"stanzas":[["南陌东城春早时，","相逢何处不依依。"],["桃红李白皆夸好，","须得垂杨相发辉。"]]}
{"id":"834ebbf787","title":"杂曲歌辞 杨柳枝 三","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤阙轻遮翡翠帷，","龙墀遥望曲尘丝。","御沟春水柳晖映，","狂杀长安年少儿。"],"stanzas":[["凤阙轻遮翡翠帷，","龙墀遥望曲尘丝。"],["御沟春水柳晖映，","狂杀长安年少儿。"]]}
{"id":"c07d3c665e","title":"杂曲歌辞 杨柳枝 四","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金谷园中莺乱飞，","铜驼陌上好风吹。","城东桃李须臾尽，","争似垂杨无限时。"],"stanzas":[["金谷园中莺乱飞，","铜驼陌上好风吹。"],["城东桃李须臾尽，","争似垂杨无限时。"]]}
{"id":"a7f6192848","title":"杂曲歌辞 杨柳枝 五","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花萼楼前初种时，","美人楼上鬬腰支。","如今抛掷上街里，","露叶如啼欲恨谁。"],"stanzas":[["花萼楼前初种时，","美人楼上鬬腰支。"],["如今抛掷上街里，","露叶如啼欲恨谁。"]]}
{"id":"5b0601bedc","title":"杂曲歌辞 杨柳枝 六","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["炀帝行宫汴水滨，","数株残柳不胜春。","昨来风起花如雪，","飞入宫墙不见人。"],"stanzas":[["炀帝行宫汴水滨，","数株残柳不胜春。"],["昨来风起花如雪，","飞入宫墙不见人。"]]}
{"id":"e01ad0f9a6","title":"杂曲歌辞 杨柳枝 七","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御陌青门拂地垂，","千条金缕万条丝。","如今绾作同心结，","将赠行人知不知。"],"stanzas":[["御陌青门拂地垂，","千条金缕万条丝。"],["如今绾作同心结，","将赠行人知不知。"]]}
{"id":"a9fa9a2176","title":"杂曲歌辞 杨柳枝 八","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["城外春风满酒旗，","行人挥袂日西时。","长安陌上无穷树，","唯有垂杨管别离。"],"stanzas":[["城外春风满酒旗，","行人挥袂日西时。"],["长安陌上无穷树，","唯有垂杨管别离。"]]}
{"id":"f4a3c63525","title":"杂曲歌辞 杨柳枝 九","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轻盈袅娜占春华，","舞榭妆楼处处遮。","春尽絮飞留不得，","随风好去落谁家。"],"stanzas":[["轻盈袅娜占春华，","舞榭妆楼处处遮。"],["春尽絮飞留不得，","随风好去落谁家。"]]}
{"id":"b208074418","title":"杂曲歌辞 杨柳枝 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["[扬]子江头烟景迷，","隋家宫树拂金堤。","嵯峨犹有当时色，","半蘸波中水鸟栖。"],"stanzas":[["[扬]子江头烟景迷，","隋家宫树拂金堤。"],["嵯峨犹有当时色，","半蘸波中水鸟栖。"]]}
{"id":"f8a41bd859","title":"杂曲歌辞 杨柳枝 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["迎得春光先到来，","浅黄轻绿映楼台。","只缘袅娜多情思，","便被春风长请挼。"],"stanzas":[["迎得春光先到来，","浅黄轻绿映楼台。"],["只缘袅娜多情思，","便被春风长请挼。"]]}
{"id":"cbe7c9547b","title":"杂曲歌辞 杨柳枝 三","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巫峡巫山杨柳多，","朝云暮雨远相和。","因想阳台无限事，","为君回唱竹枝歌。"],"stanzas":[["巫峡巫山杨柳多，","朝云暮雨远相和。"],["因想阳台无限事，","为君回唱竹枝歌。"]]}
{"id":"2188031284","title":"杂曲歌辞 杨柳枝 一","author":"李商隐","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暂凭樽酒送无憀，","莫损愁眉与细腰。","人世死前唯有别，","春风争拟惜长条。"],"stanzas":[["暂凭樽酒送无憀，","莫损愁眉与细腰。"],["人世死前唯有别，","春风争拟惜长条。"]]}
{"id":"7801055458","title":"杂曲歌辞 杨柳枝 二","author":"李商隐","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["含烟惹雾每依依，","万绪千条拂落晖。","为报行人休尽折，","半留相送半迎归。"],"stanzas":[["含烟惹雾每依依，","万绪千条拂落晖。"],["为报行人休尽折，","半留相送半迎归。"]]}
{"id":"bbf0d5e6fa","title":"杂曲歌辞 杨柳枝","author":"韩琮","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梁苑隋堤事已空，","万条犹舞旧春风。","那堪更想千年后，","谁见杨花入汉宫。"],"stanzas":[["梁苑隋堤事已空，","万条犹舞旧春风。"],["那堪更想千年后，","谁见杨花入汉宫。"]]}
{"id":"987ae55955","title":"杂曲歌辞 杨柳枝","author":"施肩吾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伤见路傍杨柳春，","一枝折尽一重新。","今年还折去年处，","不送去年离别人。"],"stanzas":[["伤见路傍杨柳春，","一枝折尽一重新。"],["今年还折去年处，","不送去年离别人。"]]}
{"id":"c473c95997","title":"杂曲歌辞 杨柳枝 一","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宜春苑外最长条，","闲袅春风伴舞腰。","正是玉人肠断处，","一渠春水赤栏桥。"],"stanzas":[["宜春苑外最长条，","闲袅春风伴舞腰。"],["正是玉人肠断处，","一渠春水赤栏桥。"]]}
{"id":"17070ba111","title":"杂曲歌辞 杨柳枝 二","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南内墙东御路傍，","预知春色柳丝黄。","杏花未肯无情思，","何事情人最断肠。"],"stanzas":[["南内墙东御路傍，","预知春色柳丝黄。"],["杏花未肯无情思，","何事情人最断肠。"]]}
{"id":"59122fafed","title":"杂曲歌辞 杨柳枝 三","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苏小门前柳万条，","毵毵金线拂平桥。","黄莺不语东风起，","深闭朱门伴细腰。"],"stanzas":[["苏小门前柳万条，","毵毵金线拂平桥。"],["黄莺不语东风起，","深闭朱门伴细腰。"]]}
{"id":"bbb2ecf867","title":"杂曲歌辞 杨柳枝 四","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金缕毵毵碧瓦沟，","六宫眉黛惹春愁。","晚来更带龙池雨，","半拂栏干半入楼。"],"stanzas":[["金缕毵毵碧瓦沟，","六宫眉黛惹春愁。"],["晚来更带龙池雨，","半拂栏干半入楼。"]]}
{"id":"3b231f0afd","title":"杂曲歌辞 杨柳枝 五","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["馆娃宫外邺城西，","远映征帆近拂堤。","系得王孙归意切，","不关春草绿萋萋。"],"stanzas":[["馆娃宫外邺城西，","远映征帆近拂堤。"],["系得王孙归意切，","不关春草绿萋萋。"]]}
{"id":"78b0400253","title":"杂曲歌辞 杨柳枝 六","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两两黄鹂色似金，","袅枝啼露动芳音。","春来幸自长如线，","可惜牵缠荡子心。"],"stanzas":[["两两黄鹂色似金，","袅枝啼露动芳音。"],["春来幸自长如线，","可惜牵缠荡子心。"]]}
{"id":"cf55bdae78","title":"杂曲歌辞 杨柳枝 七","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["御柳如丝映九重，","凤凰窗柱绣芙蓉。","景阳楼伴千条露，","一面新妆待晓钟。"],"stanzas":[["御柳如丝映九重，","凤凰窗柱绣芙蓉。"],["景阳楼伴千条露，","一面新妆待晓钟。"]]}
{"id":"9e6b82ffdc","title":"杂曲歌辞 杨柳枝 八","author":"温庭筠","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["织锦机边莺语频，","停梭垂泪忆征人。","塞门三月犹萧索，","纵有垂杨未觉春。"],"stanzas":[["织锦机边莺语频，","停梭垂泪忆征人。"],["塞门三月犹萧索，","纵有垂杨未觉春。"]]}
{"id":"e02d588563","title":"杂曲歌辞 杨柳枝 一","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春入行宫映翠微，","玄宗侍女舞烟丝。","如今柳向空城绿，","玉笛何人更把吹。"],"stanzas":[["春入行宫映翠微，","玄宗侍女舞烟丝。"],["如今柳向空城绿，","玉笛何人更把吹。"]]}
{"id":"4bacdcf76d","title":"杂曲歌辞 杨柳枝 二","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烂熳春归水国时，","吴王宫殿柳垂丝。","黄莺长呌空闺畔，","西子无因更得知。"],"stanzas":[["烂熳春归水国时，","吴王宫殿柳垂丝。"],["黄莺长呌空闺畔，","西子无因更得知。"]]}
{"id":"ffd514d616","title":"杂曲歌辞 杨柳枝 一","author":"僧齐己","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤楼高映绿阴阴，","凝碧多含雨露深。","莫谓一枝柔软力，","几曾牵破别离心。"],"stanzas":[["凤楼高映绿阴阴，","凝碧多含雨露深。"],["莫谓一枝柔软力，","几曾牵破别离心。"]]}
{"id":"74fc5d1069","title":"杂曲歌辞 杨柳枝 二","author":"僧齐己","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["馆娃宫畔响廊前，","依托吴王养翠烟。","劒去国亡台榭毁，","却随红树噪秋蝉。"],"stanzas":[["馆娃宫畔响廊前，","依托吴王养翠烟。"],["劒去国亡台榭毁，","却随红树噪秋蝉。"]]}
{"id":"bd70d632d4","title":"杂曲歌辞 杨柳枝 三","author":"僧齐己","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秾低似中陶潜酒，","软极如伤宋玉风。","多谢将军绕营种，","翠中闲卓战旗红。"],"stanzas":[["秾低似中陶潜酒，","软极如伤宋玉风。"],["多谢将军绕营种，","翠中闲卓战旗红。"]]}
{"id":"a6a936b139","title":"杂曲歌辞 杨柳枝 四","author":"僧齐己","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高僧爱惜遮江寺，","游子伤残露野桥。","争似著行垂上苑，","碧桃红杏对摇摇。"],"stanzas":[["高僧爱惜遮江寺，","游子伤残露野桥。"],["争似著行垂上苑，","碧桃红杏对摇摇。"]]}
{"id":"c128735811","title":"杂曲歌辞 杨柳枝 一","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫折宫前杨柳枝，","玄宗曾向笛中吹。","伤心日暮烟霞起，","无限春愁生翠眉。"],"stanzas":[["莫折宫前杨柳枝，","玄宗曾向笛中吹。"],["伤心日暮烟霞起，","无限春愁生翠眉。"]]}
{"id":"3b788228dd","title":"杂曲歌辞 杨柳枝 二","author":"张祜","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凝碧池边敛翠眉，","景阳台下绾青丝。","那胜妃子朝元阁，","玉手和烟弄一枝。"],"stanzas":[["凝碧池边敛翠眉，","景阳台下绾青丝。"],["那胜妃子朝元阁，","玉手和烟弄一枝。"]]}
{"id":"7e22d34144","title":"杂曲歌辞 杨柳枝 一","author":"孙鲂","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵和风暖太昌春，","舞线摇丝向昔人。","何似晓来江雨后，","一行如画隔遥津。"],"stanzas":[["灵和风暖太昌春，","舞线摇丝向昔人。"],["何似晓来江雨后，","一行如画隔遥津。"]]}
{"id":"9448e917d8","title":"杂曲歌辞 杨柳枝 二","author":"孙鲂","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["彭泽初栽五树时，","只应闲看一枝枝。","不知天意风流处，","要与佳人学画眉。"],"stanzas":[["彭泽初栽五树时，","只应闲看一枝枝。"],["不知天意风流处，","要与佳人学画眉。"]]}
{"id":"c3c34b64e7","title":"杂曲歌辞 杨柳枝 三","author":"孙鲂","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖傍离亭静拂桥，","入流穿槛绿摇摇。","不知落日谁相送，","魂断千条与万条。"],"stanzas":[["暖傍离亭静拂桥，","入流穿槛绿摇摇。"],["不知落日谁相送，","魂断千条与万条。"]]}
{"id":"6e6a22ffe4","title":"杂曲歌辞 杨柳枝 四","author":"孙鲂","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春来绿树遍天涯，","未见垂杨未可夸。","晴日万株烟一阵，","闲坊兼是莫愁家。"],"stanzas":[["春来绿树遍天涯，","未见垂杨未可夸。"],["晴日万株烟一阵，","闲坊兼是莫愁家。"]]}
{"id":"0bf38d5fe3","title":"杂曲歌辞 杨柳枝 五","author":"孙鲂","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["十首当年有旧词，","唱青歌翠几无遗。","未曾得向行人道，","不为离情莫折伊。"],"stanzas":[["十首当年有旧词，","唱青歌翠几无遗。"],["未曾得向行人道，","不为离情莫折伊。"]]}
{"id":"36292e017a","title":"杂曲歌辞 杨柳枝 一","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华清高树出离宫，","南陌柔条带暖风。","谁见轻阴是良夜，","瀑泉声畔月明中。"],"stanzas":[["华清高树出离宫，","南陌柔条带暖风。"],["谁见轻阴是良夜，","瀑泉声畔月明中。"]]}
{"id":"53d9fcbb33","title":"杂曲歌辞 杨柳枝 二","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洛桥晴影覆江船，","羌笛秋声湿塞烟。","闲想习池公宴罢，","水蒲风絮夕阳天。"],"stanzas":[["洛桥晴影覆江船，","羌笛秋声湿塞烟。"],["闲想习池公宴罢，","水蒲风絮夕阳天。"]]}
{"id":"3191c8fd9a","title":"杂曲歌辞 杨柳枝 三","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嫩绿轻悬似缀旒，","路人遥见隔宫楼。","谁能更近丹墀种，","解播皇风入九州。"],"stanzas":[["嫩绿轻悬似缀旒，","路人遥见隔宫楼。"],["谁能更近丹墀种，","解播皇风入九州。"]]}
{"id":"7886285ec1","title":"杂曲歌辞 杨柳枝 四","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖风晴日断浮埃，","废路新条发钓台。","处处轻轻可惆怅，","后人攀处古人栽。"],"stanzas":[["暖风晴日断浮埃，","废路新条发钓台。"],["处处轻轻可惆怅，","后人攀处古人栽。"]]}
{"id":"593f4b5de3","title":"杂曲歌辞 杨柳枝 五","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["潭上江边袅袅垂，","日高风静絮相随。","青楼一树无人见，","正是女郎眠觉时。"],"stanzas":[["潭上江边袅袅垂，","日高风静絮相随。"],["青楼一树无人见，","正是女郎眠觉时。"]]}
{"id":"c7d2b1aec7","title":"杂曲歌辞 杨柳枝 六","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汴水高悬百万条，","风清两岸一时摇。","隋家力尽虚栽得，","无限春风属圣朝。"],"stanzas":[["汴水高悬百万条，","风清两岸一时摇。"],["隋家力尽虚栽得，","无限春风属圣朝。"]]}
{"id":"9faa9973f3","title":"杂曲歌辞 杨柳枝 七","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["和花烟树九重城，","夹路春阴十万营。","唯向边头不堪望，","一株顦顇少人行。"],"stanzas":[["和花烟树九重城，","夹路春阴十万营。"],["唯向边头不堪望，","一株顦顇少人行。"]]}
{"id":"bccd2d6582","title":"杂曲歌辞 杨柳枝 八","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["窗外齐垂旭日初，","楼边轻好暖风徐。","游人莫道栽无益，","桃李清阴却不如。"],"stanzas":[["窗外齐垂旭日初，","楼边轻好暖风徐。"],["游人莫道栽无益，","桃李清阴却不如。"]]}
{"id":"2270cd67fb","title":"杂曲歌辞 杨柳枝 九","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["众木犹寒独早青，","御沟桥畔曲江亭。","陶家旧日应如此，","一院春条绿绕厅。"],"stanzas":[["众木犹寒独早青，","御沟桥畔曲江亭。"],["陶家旧日应如此，","一院春条绿绕厅。"]]}
{"id":"0831074867","title":"杂曲歌辞 杨柳枝 十","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["帐偃缨垂细复繁，","令人心想石家园。","风条月影皆堪重，","何事侯门爱树萱。"],"stanzas":[["帐偃缨垂细复繁，","令人心想石家园。"],["风条月影皆堪重，","何事侯门爱树萱。"]]}
{"id":"6a32cfccba","title":"杂曲歌辞 杨柳枝 一","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数首新词带恨成，","柳丝牵我我伤情。","柔娥幸有腰支稳，","试踏吹声作唱声。"],"stanzas":[["数首新词带恨成，","柳丝牵我我伤情。"],["柔娥幸有腰支稳，","试踏吹声作唱声。"]]}
{"id":"b60811bda9","title":"杂曲歌辞 杨柳枝 二","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高出军营远映桥，","贼兵曾斫火曾烧。","风流性在终难改，","依旧春来万万条。"],"stanzas":[["高出军营远映桥，","贼兵曾斫火曾烧。"],["风流性在终难改，","依旧春来万万条。"]]}
{"id":"f78c225254","title":"杂曲歌辞 杨柳枝 三","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["县依陶令想嫌迂，","营伴将军即大麤。","此日与君除万恨，","数篇风调更应无。"],"stanzas":[["县依陶令想嫌迂，","营伴将军即大麤。"],["此日与君除万恨，","数篇风调更应无。"]]}
{"id":"31bb3ae311","title":"杂曲歌辞 杨柳枝 四","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["狂似纤腰软胜绵，","自多情态更谁怜。","游人不折还堪恨，","抛向桥边与路边。"],"stanzas":[["狂似纤腰软胜绵，","自多情态更谁怜。"],["游人不折还堪恨，","抛向桥边与路边。"]]}
{"id":"efaf020fb7","title":"杂曲歌辞 杨柳枝 五","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝阳晴照绿杨烟，","一别通波十七年。","应有旧枝无处觅，","万株风里卓旌旃。"],"stanzas":[["朝阳晴照绿杨烟，","一别通波十七年。"],["应有旧枝无处觅，","万株风里卓旌旃。"]]}
{"id":"a780dd655f","title":"杂曲歌辞 杨柳枝 六","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晴垂芳态吐牙新，","雨摆轻条湿面春。"],"stanzas":[["晴垂芳态吐牙新，","雨摆轻条湿面春。"]]}
{"id":"759081f7d9","title":"杂曲歌辞 杨柳枝 七","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暖梳簪朵事登楼，","因挂垂杨立地愁。","牵断绿丝攀不得，","半空悬著玉搔头。"],"stanzas":[["暖梳簪朵事登楼，","因挂垂杨立地愁。"],["牵断绿丝攀不得，","半空悬著玉搔头。"]]}
{"id":"5e9cb3f9dd","title":"杂曲歌辞 杨柳枝 八","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西园高树后庭根，","处处寻芳有折痕。","终忆旧游桃叶舍，","一株斜映竹篱门。"],"stanzas":[["西园高树后庭根，","处处寻芳有折痕。"],["终忆旧游桃叶舍，","一株斜映竹篱门。"]]}
{"id":"ccd1fc8804","title":"杂曲歌辞 杨柳枝 九","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["刘白苏台总近时，","当初章句是谁推。","纤腰舞尽春杨柳，","未有侬家一首诗。"],"stanzas":[["刘白苏台总近时，","当初章句是谁推。"],["纤腰舞尽春杨柳，","未有侬家一首诗。"]]}
{"id":"c5491cbda3","title":"杂曲歌辞 杨柳枝 一","author":"牛峤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["解冻风来末上青，","解垂罗袖拜卿卿。","无端袅娜临官路，","舞送行人过一生。"],"stanzas":[["解冻风来末上青，","解垂罗袖拜卿卿。"],["无端袅娜临官路，","舞送行人过一生。"]]}
{"id":"6f5722a32e","title":"杂曲歌辞 杨柳枝 二","author":"牛峤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴王宫里色偏深，","一簇纤条万缕金。","不愤钱塘苏小小，","引郎枝下结同心。"],"stanzas":[["吴王宫里色偏深，","一簇纤条万缕金。"],["不愤钱塘苏小小，","引郎枝下结同心。"]]}
{"id":"6e34dd29a9","title":"杂曲歌辞 杨柳枝 三","author":"牛峤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桥北桥南千万条，","恨伊张绪不相饶。","金羁白马临风望，","认得羊家静婉腰。"],"stanzas":[["桥北桥南千万条，","恨伊张绪不相饶。"],["金羁白马临风望，","认得羊家静婉腰。"]]}
{"id":"fa61089311","title":"杂曲歌辞 杨柳枝 四","author":"牛峤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["狂雪随风扑马飞，","惹烟无力被风欹。","莫交移入灵和殿，","宫女三千又妒伊。"],"stanzas":[["狂雪随风扑马飞，","惹烟无力被风欹。"],["莫交移入灵和殿，","宫女三千又妒伊。"]]}
{"id":"9d241d1267","title":"杂曲歌辞 杨柳枝 五","author":"牛峤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["袅翠笼烟拂暖波，","舞裙新染曲尘罗。","章华台畔隋堤上，","倚得春风尔许多。"],"stanzas":[["袅翠笼烟拂暖波，","舞裙新染曲尘罗。"],["章华台畔隋堤上，","倚得春风尔许多。"]]}
{"id":"7e5b10f973","title":"杂曲歌辞 杨柳枝 一","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["软碧摇烟似送人，","映花时把翠眉嚬。","青青自是风流主，","漫飐金丝待洛神。"],"stanzas":[["软碧摇烟似送人，","映花时把翠眉嚬。"],["青青自是风流主，","漫飐金丝待洛神。"]]}
{"id":"d9edce3316","title":"杂曲歌辞 杨柳枝 二","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["瑟瑟罗裙金缕腰，","黛眉偎破未重描。","醉来咬损新花子，","拽住仙郎尽放娇。"],"stanzas":[["瑟瑟罗裙金缕腰，","黛眉偎破未重描。"],["醉来咬损新花子，","拽住仙郎尽放娇。"]]}
{"id":"e44eaf3c5d","title":"杂曲歌辞 杨柳枝 三","author":"和凝","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹊桥初就咽银河，","今夜仙郎自性和。","不是昔年攀桂树，","岂能月里索姮娥。"],"stanzas":[["鹊桥初就咽银河，","今夜仙郎自性和。"],["不是昔年攀桂树，","岂能月里索姮娥。"]]}
{"id":"b95acb2af5","title":"杂曲歌辞 杨柳枝 一","author":"孙光宪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闾门风暖落花干，","飞遍江南雪不寒。","独有晚来临水驿，","闲人多凭赤阑干。"],"stanzas":[["闾门风暖落花干，","飞遍江南雪不寒。"],["独有晚来临水驿，","闲人多凭赤阑干。"]]}
{"id":"ec2dcc0e64","title":"杂曲歌辞 杨柳枝 二","author":"孙光宪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有池有榭即蒙蒙，","浸润翻成长养功。","恰似有人长点检，","著行排立向春风。"],"stanzas":[["有池有榭即蒙蒙，","浸润翻成长养功。"],["恰似有人长点检，","著行排立向春风。"]]}
{"id":"b6c4007edf","title":"杂曲歌辞 杨柳枝 三","author":"孙光宪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["根柢虽然傍浊河，","无妨终日近笙歌。","骖骖金带谁堪比，","还笑黄莺不较多。"],"stanzas":[["根柢虽然傍浊河，","无妨终日近笙歌。"],["骖骖金带谁堪比，","还笑黄莺不较多。"]]}
{"id":"fe00355b9d","title":"杂曲歌辞 杨柳枝 四","author":"孙光宪","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万株枯槁怨亡隋，","似吊吴台各自垂。","好是淮阴明月里，","酒楼横笛不胜吹。"],"stanzas":[["万株枯槁怨亡隋，","似吊吴台各自垂。"],["好是淮阴明月里，","酒楼横笛不胜吹。"]]}
{"id":"746893d675","title":"杂曲歌辞 浪淘沙 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九曲黄河万里沙，","浪淘风簸自天涯。","如今直上银河去，","同到牵牛织女家。"],"stanzas":[["九曲黄河万里沙，","浪淘风簸自天涯。"],["如今直上银河去，","同到牵牛织女家。"]]}
{"id":"937e669686","title":"杂曲歌辞 浪淘沙 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洛水桥边春日斜，","碧流轻浅见琼沙。","无端陌上狂风急，","惊起鸳鸯出浪花。"],"stanzas":[["洛水桥边春日斜，","碧流轻浅见琼沙。"],["无端陌上狂风急，","惊起鸳鸯出浪花。"]]}
{"id":"42912b39f2","title":"杂曲歌辞 浪淘沙 三","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汴水东流虎眼文，","清淮晓色鸭头春。","君看渡口淘沙处，","渡却人间多少人。"],"stanzas":[["汴水东流虎眼文，","清淮晓色鸭头春。"],["君看渡口淘沙处，","渡却人间多少人。"]]}
{"id":"36279ea6cd","title":"杂曲歌辞 浪淘沙 四","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹦鹉洲头浪飐沙，","青楼春望日将斜。","衔泥燕子争归舍，","独自狂夫不忆家。"],"stanzas":[["鹦鹉洲头浪飐沙，","青楼春望日将斜。"],["衔泥燕子争归舍，","独自狂夫不忆家。"]]}
{"id":"30abbe9dec","title":"杂曲歌辞 浪淘沙 五","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["濯锦江边两岸花，","春风吹浪正淘沙。","女郎剪下鸳鸯锦，","将向中流疋晚霞。"],"stanzas":[["濯锦江边两岸花，","春风吹浪正淘沙。"],["女郎剪下鸳鸯锦，","将向中流疋晚霞。"]]}
{"id":"3f5aea5e73","title":"杂曲歌辞 浪淘沙 六","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日照澄洲江雾开，","淘金女伴满江隈。","美人首饰侯王印，","尽是沙中浪底来。"],"stanzas":[["日照澄洲江雾开，","淘金女伴满江隈。"],["美人首饰侯王印，","尽是沙中浪底来。"]]}
{"id":"f449228f2f","title":"杂曲歌辞 浪淘沙 七","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八月涛声吼地来，","头高数丈触山回。","须臾却入海门去，","卷起沙堆似雪堆。"],"stanzas":[["八月涛声吼地来，","头高数丈触山回。"],["须臾却入海门去，","卷起沙堆似雪堆。"]]}
{"id":"9fa3f1399e","title":"杂曲歌辞 浪淘沙 八","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫道谗言如浪深，","莫言迁客似沙沈。","千淘万漉虽辛苦，","吹尽狂沙始到金。"],"stanzas":[["莫道谗言如浪深，","莫言迁客似沙沈。"],["千淘万漉虽辛苦，","吹尽狂沙始到金。"]]}
{"id":"f40f465a75","title":"杂曲歌辞 浪淘沙 九","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流水淘沙不暂停，","前波未灭后波生。","令人忽忆潇湘渚，","回唱迎神三两声。"],"stanzas":[["流水淘沙不暂停，","前波未灭后波生。"],["令人忽忆潇湘渚，","回唱迎神三两声。"]]}
{"id":"cda02dcbac","title":"杂曲歌辞 浪淘沙 一","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一泊沙来一泊去，","一重浪灭一重生。","相搅相淘无歇日，","会交山海一时平。"],"stanzas":[["一泊沙来一泊去，","一重浪灭一重生。"],["相搅相淘无歇日，","会交山海一时平。"]]}
{"id":"666757adff","title":"杂曲歌辞 浪淘沙 二","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白浪茫茫与海连，","平沙浩浩四无边。","暮去朝来淘不住，","遂令东海变桑田。"],"stanzas":[["白浪茫茫与海连，","平沙浩浩四无边。"],["暮去朝来淘不住，","遂令东海变桑田。"]]}
{"id":"8554352f80","title":"杂曲歌辞 浪淘沙 三","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青草湖中万里程，","黄梅雨里一人行。","愁见滩头夜泊处，","风翻暗浪打船声。"],"stanzas":[["青草湖中万里程，","黄梅雨里一人行。"],["愁见滩头夜泊处，","风翻暗浪打船声。"]]}
{"id":"5fdd24a684","title":"杂曲歌辞 浪淘沙 四","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["借问江湖与海水，","何似君情与妾心。","相恨不如潮有信，","相思始觉海非深。"],"stanzas":[["借问江湖与海水，","何似君情与妾心。"],["相恨不如潮有信，","相思始觉海非深。"]]}
{"id":"1f3cb7214b","title":"杂曲歌辞 浪淘沙 五","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["海底飞尘终有日，","山头化石岂无时。","谁道小郎抛小妇，","船头一去没回期。"],"stanzas":[["海底飞尘终有日，","山头化石岂无时。"],["谁道小郎抛小妇，","船头一去没回期。"]]}
{"id":"5d2bbacaf7","title":"杂曲歌辞 浪淘沙 六","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["随波逐浪到天涯，","迁客生还有几家。","却到帝乡重富贵，","请君莫忘浪淘沙。"],"stanzas":[["随波逐浪到天涯，","迁客生还有几家。"],["却到帝乡重富贵，","请君莫忘浪淘沙。"]]}
{"id":"23b894c818","title":"杂曲歌辞 浪淘沙 一","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["滩头细草接疎林，","浪恶罾船半欲沈。","宿鹭眠洲非旧浦，","去年沙觜是江心。"],"stanzas":[["滩头细草接疎林，","浪恶罾船半欲沈。"],["宿鹭眠洲非旧浦，","去年沙觜是江心。"]]}
{"id":"29fa3d3ece","title":"杂曲歌辞 浪淘沙 二","author":"皇甫松","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛮歌豆蔻北人愁，","松雨蒲风夜艇秋。","浪起䴔䴖眠不得，","寒沙细细入江流。"],"stanzas":[["蛮歌豆蔻北人愁，","松雨蒲风夜艇秋。"],["浪起䴔䴖眠不得，","寒沙细细入江流。"]]}
{"id":"b936225da0","title":"杂曲歌辞 纥那曲 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳郁青青，","竹枝无限情。","同郎一回顾，","听唱纥那声。"],"stanzas":[["杨柳郁青青，","竹枝无限情。"],["同郎一回顾，","听唱纥那声。"]]}
{"id":"5a27c0bb51","title":"杂曲歌辞 纥那曲 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["踏曲兴无穷，","调同词不同。","愿郎千万寿，","长作主人翁。"],"stanzas":[["踏曲兴无穷，","调同词不同。"],["愿郎千万寿，","长作主人翁。"]]}
{"id":"bae7e341a6","title":"杂曲歌辞 潇湘神二曲 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湘水流，","湘水流，","九疑云物至今愁。","君问二妃何处所？","零陵香草露中秋。"],"stanzas":[["湘水流，","湘水流，","九疑云物至今愁。"],["君问二妃何处所？","零陵香草露中秋。"]]}
{"id":"9e5db9f9cf","title":"杂曲歌辞 潇湘神二曲 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["斑竹枝，","斑竹枝，","泪痕点点寄相思。","楚客欲听瑶瑟怨，","潇湘深夜月明时。"],"stanzas":[["斑竹枝，","斑竹枝，","泪痕点点寄相思。"],["楚客欲听瑶瑟怨，","潇湘深夜月明时。"]]}
{"id":"761290f3ee","title":"杂曲歌辞 抛毬乐 一","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五彩绣团团，","登君玳瑁筵。","最宜红烛下，","偏称落花前。","上客如先起，","应须赠一船。"],"stanzas":[["五彩绣团团，","登君玳瑁筵。"],["最宜红烛下，","偏称落花前。"],["上客如先起，","应须赠一船。"]]}
{"id":"de0d822811","title":"杂曲歌辞 抛毬乐 二","author":"刘禹锡","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春早见花枝，","朝朝恨发迟。","及看花落后，","却忆未开时。","幸有抛毬乐，","一杯君莫辞。"],"stanzas":[["春早见花枝，","朝朝恨发迟。"],["及看花落后，","却忆未开时。"],["幸有抛毬乐，","一杯君莫辞。"]]}
{"id":"f30d819fa8","title":"杂曲歌辞 太平乐 一","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岁丰仍节俭，","时泰更销兵。","圣念长如此，","何忧不太平。"],"stanzas":[["岁丰仍节俭，","时泰更销兵。"],["圣念长如此，","何忧不太平。"]]}
{"id":"a61bb2c43c","title":"杂曲歌辞 太平乐 二","author":"白居易","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湛露浮尧酒，","薰风起舜歌。","愿同尧舜意，","所乐在人和。"],"stanzas":[["湛露浮尧酒，","薰风起舜歌。"],["愿同尧舜意，","所乐在人和。"]]}
{"id":"41474b6af2","title":"杂曲歌辞 太平乐","author":"王涯","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风俗今和厚，","君王在穆清。","行看采花曲，","尽是太阶平。"],"stanzas":[["风俗今和厚，","君王在穆清。"],["行看采花曲，","尽是太阶平。"]]}
{"id":"e0565bee1a","title":"杂曲歌辞 太平乐","author":"张仲素","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣德超千古，","皇威静四方。","苍生今息战，","无事觉时长。"],"stanzas":[["圣德超千古，","皇威静四方。"],["苍生今息战，","无事觉时长。"]]}
{"id":"c73369ea79","title":"杂曲歌辞 升平乐 一","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正气绕宫楼，","皇居信上游。","远冈延圣祚，","平地载神州。","会合皆重译，","潺湲近八流。","中兴岂假问，","据此自千秋。"],"stanzas":[["正气绕宫楼，","皇居信上游。"],["远冈延圣祚，","平地载神州。"],["会合皆重译，","潺湲近八流。"],["中兴岂假问，","据此自千秋。"]]}
{"id":"88afa35ce3","title":"杂曲歌辞 升平乐 二","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寥泬敞延英，","朝班立位横。","宣传无草动，","拜舞有衣声。","鸳瓦云消湿，","虫丝日照明。","辛勤自不到，","遥见似前生。"],"stanzas":[["寥泬敞延英，","朝班立位横。"],["宣传无草动，","拜舞有衣声。"],["鸳瓦云消湿，","虫丝日照明。"],["辛勤自不到，","遥见似前生。"]]}
{"id":"f2c91df8be","title":"杂曲歌辞 升平乐 三","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["处处足欢声，","时康岁已深。","不同三尺劒，","应似五弦琴。","寿笑山犹尽，","明嫌日有阴。","何当怜一物，","亦遣断愁吟。"],"stanzas":[["处处足欢声，","时康岁已深。"],["不同三尺劒，","应似五弦琴。"],["寿笑山犹尽，","明嫌日有阴。"],["何当怜一物，","亦遣断愁吟。"]]}
{"id":"f2625200fa","title":"杂曲歌辞 升平乐 四","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曙质绝埃氛，","彤庭列禁军。","圣颜初对日，","龙尾竞缘云。","珮响交成韵，","帘阴暖带纹。","逍遥岂有事，","于此咏南薰。"],"stanzas":[["曙质绝埃氛，","彤庭列禁军。"],["圣颜初对日，","龙尾竞缘云。"],["珮响交成韵，","帘阴暖带纹。"],["逍遥岂有事，","于此咏南薰。"]]}
{"id":"b92ffdb460","title":"杂曲歌辞 升平乐 五","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一物周天至，","洪纤尽晏然。","车书无异俗，","甲子竝丰年。","奇技皆归朴，","征夫亦服田。","君王故不有，","台鼎合韦弦。"],"stanzas":[["一物周天至，","洪纤尽晏然。"],["车书无异俗，","甲子竝丰年。"],["奇技皆归朴，","征夫亦服田。"],["君王故不有，","台鼎合韦弦。"]]}
{"id":"affdf0b657","title":"杂曲歌辞 升平乐 六","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日日听歌谣，","区中尽祝尧。","虫蝗初不害，","夷狄近全销。","史笔唯书瑞，","天台绝见祆。","因令匹夫志，","转欲事清朝。"],"stanzas":[["日日听歌谣，","区中尽祝尧。"],["虫蝗初不害，","夷狄近全销。"],["史笔唯书瑞，","天台绝见祆。"],["因令匹夫志，","转欲事清朝。"]]}
{"id":"7039ea337a","title":"杂曲歌辞 升平乐 七","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["品物尽昭苏，","神功复帝谟。","他时应有寿，","当代且无虞。","赐历通遐俗，","移关入半胡。","鹪鹩一何幸，","于此寄微躯。"],"stanzas":[["品物尽昭苏，","神功复帝谟。"],["他时应有寿，","当代且无虞。"],["赐历通遐俗，","移关入半胡。"],["鹪鹩一何幸，","于此寄微躯。"]]}
{"id":"922f23bd06","title":"杂曲歌辞 升平乐 八","author":"薛能","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无战复无私，","尧时即此时。","焚香临极早，","待月卷帘迟。","端拱乾坤内，","何言黈纩垂。","君看圣明验，","只此是神龟。"],"stanzas":[["无战复无私，","尧时即此时。"],["焚香临极早，","待月卷帘迟。"],["端拱乾坤内，","何言黈纩垂。"],["君看圣明验，","只此是神龟。"]]}
