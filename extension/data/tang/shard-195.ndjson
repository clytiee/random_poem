{"id":"15098f5a21","title":"临终召客","author":"颜令宾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["气余三五喘，","花剩两三枝。","话别一尊酒，","相邀无后期。"],"stanzas":[["气余三五喘，","花剩两三枝。"],["话别一尊酒，","相邀无后期。"]]}
{"id":"4ea254a5b8","title":"寄故人","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["淡淡春风花落时，","不堪愁望更相思。","无金可买长门赋，","有恨空吟团扇诗。"],"stanzas":[["淡淡春风花落时，","不堪愁望更相思。"],["无金可买长门赋，","有恨空吟团扇诗。"]]}
{"id":"6b0d67a129","title":"上成都在事","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日卖衣裳，","今日卖衣裳。","衣裳浑卖尽，","羞见嫁时箱。","有卖愁仍缓，","无时心转伤。"],"stanzas":[["昨日卖衣裳，","今日卖衣裳。"],["衣裳浑卖尽，","羞见嫁时箱。"],["有卖愁仍缓，","无时心转伤。"]]}
{"id":"3889f8e870","title":"春思二首 一","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门前梅柳烂春辉，","闭妾深闺绣舞衣。","双燕不知肠欲断，","衔泥故故傍人飞。"],"stanzas":[["门前梅柳烂春辉，","闭妾深闺绣舞衣。"],["双燕不知肠欲断，","衔泥故故傍人飞。"]]}
{"id":"67fdc33feb","title":"春思二首 二","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["井上梧桐是妾移，","夜来花发最高枝。","若教不向深闺种，","春过门前争得知。"],"stanzas":[["井上梧桐是妾移，","夜来花发最高枝。"],["若教不向深闺种，","春过门前争得知。"]]}
{"id":"2addd0bc6e","title":"西江行","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日下西塞山，","南来洞庭客。","晴空白鸟度，","万里秋光碧。"],"stanzas":[["日下西塞山，","南来洞庭客。"],["晴空白鸟度，","万里秋光碧。"]]}
{"id":"f5099b0299","title":"赠所思","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["与君咫尺长离别，","遣妾容华为谁说。","夕望层城眼欲穿，","晓临明镜肠堪绝。"],"stanzas":[["与君咫尺长离别，","遣妾容华为谁说。"],["夕望层城眼欲穿，","晓临明镜肠堪绝。"]]}
{"id":"9319a06420","title":"句","author":"张窈窕","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满院花飞人不到，","含情欲语燕双双。"],"stanzas":[["满院花飞人不到，","含情欲语燕双双。"]]}
{"id":"8b8b78bdb8","title":"赠裴思谦","author":"平康妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["银釭斜背解明珰，","小语偷声贺玉郎。","从此不知兰麝贵，","夜来新惹桂枝香。"],"stanzas":[["银釭斜背解明珰，","小语偷声贺玉郎。"],["从此不知兰麝贵，","夜来新惹桂枝香。"]]}
{"id":"599c9b4517","title":"迷香洞","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞口飞琼佩羽霓，","香风飘拂使人迷。","自从邂逅芙蓉帐，","不数桃花流水溪。"],"stanzas":[["洞口飞琼佩羽霓，","香风飘拂使人迷。"],["自从邂逅芙蓉帐，","不数桃花流水溪。"]]}
{"id":"998cb9d2a9","title":"神鸡枕","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["枕绘鸳鸯久与栖，","新裁雾縠鬬神鸡。","与郎酣梦浑忘晓，","鸡亦留连不肯啼。"],"stanzas":[["枕绘鸳鸯久与栖，","新裁雾縠鬬神鸡。"],["与郎酣梦浑忘晓，","鸡亦留连不肯啼。"]]}
{"id":"2b788e01f3","title":"锁莲灯","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灯锁莲花花照罍，","翠钿同醉楚台巍。","残灰剔罢携纤手，","也胜金莲送辙回。"],"stanzas":[["灯锁莲花花照罍，","翠钿同醉楚台巍。"],["残灰剔罢携纤手，","也胜金莲送辙回。"]]}
{"id":"de016f4d01","title":"鲛红被","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["肱被当年仅御寒，","青楼惯染血猩纨。","牙床舒卷鹓鸾共，","正值窗櫺月一团。"],"stanzas":[["肱被当年仅御寒，","青楼惯染血猩纨。"],["牙床舒卷鹓鸾共，","正值窗櫺月一团。"]]}
{"id":"e5d66504d4","title":"传香枕","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["韩寿香从何处传，","枕边芳馥恋婵娟。","休疑粉黛加铤刃，","玉女旃檀侍佛前。"],"stanzas":[["韩寿香从何处传，","枕边芳馥恋婵娟。"],["休疑粉黛加铤刃，","玉女旃檀侍佛前。"]]}
{"id":"01d75472b5","title":"八分羊","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["党家风味足肥羊，","绮阁留人漫较量。","万羊亦是男儿事，","莫学狂夫取次尝。"],"stanzas":[["党家风味足肥羊，","绮阁留人漫较量。"],["万羊亦是男儿事，","莫学狂夫取次尝。"]]}
{"id":"8f28168249","title":"闭门羮","author":"史凤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一豆聊供游冶郎，","去时忙唤锁仓琅。","入门独慕相如侣，","欲拨瑶琴弹凤凰。"],"stanzas":[["一豆聊供游冶郎，","去时忙唤锁仓琅。"],["入门独慕相如侣，","欲拨瑶琴弹凤凰。"]]}
{"id":"d60c739be9","title":"突厥三台","author":"盛小丛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雁门山上雁初飞，","马邑阑中马正肥。","日旰山西逢驿使，","殷勤南北送征衣。"],"stanzas":[["雁门山上雁初飞，","马邑阑中马正肥。"],["日旰山西逢驿使，","殷勤南北送征衣。"]]}
{"id":"76554d6ba3","title":"云鬟","author":"赵鸾鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扰扰香云湿未干，","鸦领蝉翼腻光寒。","侧边斜插黄金凤，","妆罢夫君带笑看。"],"stanzas":[["扰扰香云湿未干，","鸦领蝉翼腻光寒。"],["侧边斜插黄金凤，","妆罢夫君带笑看。"]]}
{"id":"7f9e832c19","title":"柳眉","author":"赵鸾鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弯弯柳叶愁边戏，","湛湛菱花照处频。","妩媚不烦螺子黛，","春山画出自精神。"],"stanzas":[["弯弯柳叶愁边戏，","湛湛菱花照处频。"],["妩媚不烦螺子黛，","春山画出自精神。"]]}
{"id":"7e004b991c","title":"檀口","author":"赵鸾鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["衔杯微动樱桃颗，","咳唾轻飘茉莉香。","曾见白家樊素口，","瓠犀颗颗缀榴芳。"],"stanzas":[["衔杯微动樱桃颗，","咳唾轻飘茉莉香。"],["曾见白家樊素口，","瓠犀颗颗缀榴芳。"]]}
{"id":"8e3ea98335","title":"纤指","author":"赵鸾鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["纤纤软玉削春葱，","长在香罗翠袖中。","昨日琵琶弦索上，","分明满甲染猩红。"],"stanzas":[["纤纤软玉削春葱，","长在香罗翠袖中。"],["昨日琵琶弦索上，","分明满甲染猩红。"]]}
{"id":"794c0be847","title":"酥乳","author":"赵鸾鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["粉香汗湿瑶琴轸，","春逗酥融绵雨膏。","浴罢檀郎扪弄处，","灵华凉沁紫葡萄。"],"stanzas":[["粉香汗湿瑶琴轸，","春逗酥融绵雨膏。"],["浴罢檀郎扪弄处，","灵华凉沁紫葡萄。"]]}
{"id":"15558b6240","title":"献陈陶处士","author":"莲花妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莲花为号玉为腮，","珍重尚书遣妾来。","处士不生巫峡梦，","虚劳神女下阳台。"],"stanzas":[["莲花为号玉为腮，","珍重尚书遣妾来。"],["处士不生巫峡梦，","虚劳神女下阳台。"]]}
{"id":"38c4575492","title":"叙怀","author":"徐月英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为失三从泣泪频，","此身何用处人伦。","虽然日逐笙歌乐，","长羡荆钗与布裙。"],"stanzas":[["为失三从泣泪频，","此身何用处人伦。"],["虽然日逐笙歌乐，","长羡荆钗与布裙。"]]}
{"id":"e898a21e9a","title":"送人","author":"徐月英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惆怅人间万事违，","两人同去一人归。","生憎平望亭前水，","忍照鸳鸯相背飞。"],"stanzas":[["惆怅人间万事违，","两人同去一人归。"],["生憎平望亭前水，","忍照鸳鸯相背飞。"]]}
{"id":"3b9af321b3","title":"句","author":"徐月英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["枕前泪与阶前雨，","隔个窗儿滴到明。"],"stanzas":[["枕前泪与阶前雨，","隔个窗儿滴到明。"]]}
{"id":"d9a29e3dad","title":"句","author":"韩襄客","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["连理枝前同设誓，","丁香树下共论心。"],"stanzas":[["连理枝前同设誓，","丁香树下共论心。"]]}
{"id":"326e3b664c","title":"酬人雨后玩竹","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南天春雨时，","那鉴雪霜姿。","众类亦云茂，","虚心能自持。","多留晋贤醉，","早伴舜妃悲。","晚岁君能赏，","苍苍劲节奇。"],"stanzas":[["南天春雨时，","那鉴雪霜姿。"],["众类亦云茂，","虚心能自持。"],["多留晋贤醉，","早伴舜妃悲。"],["晚岁君能赏，","苍苍劲节奇。"]]}
{"id":"71e146c4e7","title":"春望词四首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花开不同赏，","花落不同悲。","欲问相思处，","花开花落时。"],"stanzas":[["花开不同赏，","花落不同悲。"],["欲问相思处，","花开花落时。"]]}
{"id":"2fe8bc05b0","title":"春望词四首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["揽草结同心，","将以遗知音。","春愁正断绝，","春鸟复哀吟。"],"stanzas":[["揽草结同心，","将以遗知音。"],["春愁正断绝，","春鸟复哀吟。"]]}
{"id":"ef65791c95","title":"春望词四首 三","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风花日将老，","佳期犹渺渺。","不结同心人，","空结同心草。"],"stanzas":[["风花日将老，","佳期犹渺渺。"],["不结同心人，","空结同心草。"]]}
{"id":"b908eaf5de","title":"春望词四首 四","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["那堪花满枝，","翻作两相思。","玉筯垂朝镜，","春风知不知。"],"stanzas":[["那堪花满枝，","翻作两相思。"],["玉筯垂朝镜，","春风知不知。"]]}
{"id":"55ab5735f1","title":"宣上人见示与诸公唱和","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["许厕高斋唱，","涓泉定不如。","可怜谯记室，","流水满禅居。"],"stanzas":[["许厕高斋唱，","涓泉定不如。"],["可怜谯记室，","流水满禅居。"]]}
{"id":"4577264782","title":"风","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猎蕙微风远，","飘弦唳一声。","林梢鸣淅沥，","松径夜凄清。"],"stanzas":[["猎蕙微风远，","飘弦唳一声。"],["林梢鸣淅沥，","松径夜凄清。"]]}
{"id":"9573419d94","title":"月","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魄依钩样小，","扇逐汉机团。","细影将圆质，","人间几处看。"],"stanzas":[["魄依钩样小，","扇逐汉机团。"],["细影将圆质，","人间几处看。"]]}
{"id":"6d2f32b449","title":"蝉","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["露涤清音远，","风吹数叶齐。","声声似相接，","各在一枝栖。"],"stanzas":[["露涤清音远，","风吹数叶齐。"],["声声似相接，","各在一枝栖。"]]}
{"id":"e11882a766","title":"池上双鸟","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["双栖绿池上，","朝暮共飞还。","更忆将雏日，","同心莲叶间。"],"stanzas":[["双栖绿池上，","朝暮共飞还。"],["更忆将雏日，","同心莲叶间。"]]}
{"id":"674ec6ee0c","title":"鸳鸯草","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿英满香砌，","两两鸳鸯小。","但娱春日长，","不管秋风早。"],"stanzas":[["绿英满香砌，","两两鸳鸯小。"],["但娱春日长，","不管秋风早。"]]}
{"id":"cb0cd418ce","title":"罚赴边有怀上韦令公二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻道边城苦，","今来到始知。","羞将门下曲，","唱与陇头儿。"],"stanzas":[["闻道边城苦，","今来到始知。"],["羞将门下曲，","唱与陇头儿。"]]}
{"id":"feb6d8ec43","title":"罚赴边有怀上韦令公二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黠虏犹违命，","烽烟直北愁。","却教严谴妾，","不敢向松州。"],"stanzas":[["黠虏犹违命，","烽烟直北愁。"],["却教严谴妾，","不敢向松州。"]]}
{"id":"0b44999a54","title":"咏八十一颗","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["色比丹霞朝日，","形如合浦筼筜。","开时九九如数，","见处双双颉颃。"],"stanzas":[["色比丹霞朝日，","形如合浦筼筜。"],["开时九九如数，","见处双双颉颃。"]]}
{"id":"6b56e94ce8","title":"谒巫山庙","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱猨啼处访高唐，","路入烟霞草木香。","山色未能忘宋玉，","水声犹是哭襄王。","朝朝夜夜阳台下，","为雨为云楚国亡。","惆怅庙前多少柳，","春来空鬬画眉长。"],"stanzas":[["乱猨啼处访高唐，","路入烟霞草木香。"],["山色未能忘宋玉，","水声犹是哭襄王。"],["朝朝夜夜阳台下，","为雨为云楚国亡。"],["惆怅庙前多少柳，","春来空鬬画眉长。"]]}
{"id":"473fafaec6","title":"牡丹","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去春零落暮春时，","泪湿红笺怨别离。","常恐便同巫峡散，","因何重有武陵期。","传情每向馨香得，","不语还应彼此知。","只欲栏边安枕席，","夜深闲共说相思。"],"stanzas":[["去春零落暮春时，","泪湿红笺怨别离。"],["常恐便同巫峡散，","因何重有武陵期。"],["传情每向馨香得，","不语还应彼此知。"],["只欲栏边安枕席，","夜深闲共说相思。"]]}
{"id":"ba95d3290e","title":"贼平后上高相公","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惊看天地白荒荒，","瞥见青山旧夕阳。","始信大威能照映，","由来日月借生光。"],"stanzas":[["惊看天地白荒荒，","瞥见青山旧夕阳。"],["始信大威能照映，","由来日月借生光。"]]}
{"id":"5b237f4157","title":"送友人","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水国蒹葭夜有霜，","月寒山色共苍苍。","谁言千里自今夕，","离梦杳如关塞长。"],"stanzas":[["水国蒹葭夜有霜，","月寒山色共苍苍。"],["谁言千里自今夕，","离梦杳如关塞长。"]]}
{"id":"f6a8d7e420","title":"听僧吹芦管","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓蝉呜咽暮莺愁，","言语殷勤十指头。","罢阅梵书聊一弄，","散随金磬泥清秋。"],"stanzas":[["晓蝉呜咽暮莺愁，","言语殷勤十指头。"],["罢阅梵书聊一弄，","散随金磬泥清秋。"]]}
{"id":"b50e4a8ca6","title":"酬郭简州寄柑子","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霜规不让黄金色，","圆质仍含御史香。","何处同声情最异，","临川太守谢家郎。"],"stanzas":[["霜规不让黄金色，","圆质仍含御史香。"],["何处同声情最异，","临川太守谢家郎。"]]}
{"id":"acd9381dc2","title":"上川主武元衡相国二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落日重城夕雾收，","玳筵雕俎荐诸侯。","因令朗月当庭燎，","不使珠帘下玉钩。"],"stanzas":[["落日重城夕雾收，","玳筵雕俎荐诸侯。"],["因令朗月当庭燎，","不使珠帘下玉钩。"]]}
{"id":"47aebeb8da","title":"上川主武元衡相国二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东阁移尊绮席陈，","貂簪龙节更宜春。","军城画角三声歇，","云幕初垂红烛新。"],"stanzas":[["东阁移尊绮席陈，","貂簪龙节更宜春。"],["军城画角三声歇，","云幕初垂红烛新。"]]}
{"id":"7bbeab5b69","title":"忆荔枝","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["传闻象郡隔南荒，","绛实丰肌不可忘。","近有青衣连楚水，","素浆还得类琼浆。"],"stanzas":[["传闻象郡隔南荒，","绛实丰肌不可忘。"],["近有青衣连楚水，","素浆还得类琼浆。"]]}
{"id":"399ff39090","title":"斛石山晓望寄吕侍御","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曦轮初转照仙扃，","旋擘烟岚上窅冥。","不得玄晖同指点，","天涯苍翠漫青青。"],"stanzas":[["曦轮初转照仙扃，","旋擘烟岚上窅冥。"],["不得玄晖同指点，","天涯苍翠漫青青。"]]}
{"id":"270cafc197","title":"寄词","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["菌阁芝楼杳霭中，","霞开深见玉皇宫。","紫阳天上神仙客，","称在人间立世功。"],"stanzas":[["菌阁芝楼杳霭中，","霞开深见玉皇宫。"],["紫阳天上神仙客，","称在人间立世功。"]]}
{"id":"7093a59146","title":"斛石山书事","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["王家山水画图中，","意思都卢粉墨容。","今日忽登虚境望，","步摇冠翠一千峰。"],"stanzas":[["王家山水画图中，","意思都卢粉墨容。"],["今日忽登虚境望，","步摇冠翠一千峰。"]]}
{"id":"a4bf717716","title":"送姚员外","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万条江柳早秋枝，","褭地翻风色未衰。","欲折尔来将赠别，","莫教烟月两乡悲。"],"stanzas":[["万条江柳早秋枝，","褭地翻风色未衰。"],["欲折尔来将赠别，","莫教烟月两乡悲。"]]}
{"id":"f4ba06ed09","title":"酬祝十三秀才","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浩思蓝山玉彩寒，","冰囊敲碎楚金盘。","诗家利器驰声久，","何用春闱榜下看。"],"stanzas":[["浩思蓝山玉彩寒，","冰囊敲碎楚金盘。"],["诗家利器驰声久，","何用春闱榜下看。"]]}
{"id":"bdbe9a45b5","title":"别李郎中","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花落梧桐凤别凰，","想登秦岭更凄凉。","安仁纵有诗将赋，","一半音词杂悼亡。"],"stanzas":[["花落梧桐凤别凰，","想登秦岭更凄凉。"],["安仁纵有诗将赋，","一半音词杂悼亡。"]]}
{"id":"bb6abe4805","title":"送扶炼师","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["锦浦归舟巫峡云，","绿波迢递雨纷纷。","山阴妙术人传久，","也说将鹅与右军。"],"stanzas":[["锦浦归舟巫峡云，","绿波迢递雨纷纷。"],["山阴妙术人传久，","也说将鹅与右军。"]]}
{"id":"192c4b7c45","title":"摩诃池赠萧中丞","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔以多能佐碧油，","今朝同泛旧仙舟。","凄凉逝水颓波远，","惟有碑泉咽不流。"],"stanzas":[["昔以多能佐碧油，","今朝同泛旧仙舟。"],["凄凉逝水颓波远，","惟有碑泉咽不流。"]]}
{"id":"0d4c86bfd7","title":"乡思","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峨嵋山下水如油，","怜我心同不系舟。","何日片帆离锦浦，","櫂声齐唱发中流。"],"stanzas":[["峨嵋山下水如油，","怜我心同不系舟。"],["何日片帆离锦浦，","櫂声齐唱发中流。"]]}
{"id":"122f36b5bf","title":"和李书记席上见赠","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翩翩射策东堂秀，","岂复相逢豁寸心。","借问风光为谁丽，","万条丝柳翠烟深。"],"stanzas":[["翩翩射策东堂秀，","岂复相逢豁寸心。"],["借问风光为谁丽，","万条丝柳翠烟深。"]]}
{"id":"74ca1cffe9","title":"棠梨花和李太尉","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴均蕙圃移嘉木，","正及东溪春雨时。","日晚莺啼何所为，","浅深红腻压繁枝。"],"stanzas":[["吴均蕙圃移嘉木，","正及东溪春雨时。"],["日晚莺啼何所为，","浅深红腻压繁枝。"]]}
{"id":"5ee46dba22","title":"酬文使君","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["延英晓拜汉恩新，","五马腾骧九陌尘。","今日谢庭飞白雪，","巴歌不复旧阳春。"],"stanzas":[["延英晓拜汉恩新，","五马腾骧九陌尘。"],["今日谢庭飞白雪，","巴歌不复旧阳春。"]]}
{"id":"5ebe29aafd","title":"酬吴随君","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["支公别墅接花扃，","买得前山总未经。","入户剡溪云水满，","高斋咫尺蹑青冥。"],"stanzas":[["支公别墅接花扃，","买得前山总未经。"],["入户剡溪云水满，","高斋咫尺蹑青冥。"]]}
{"id":"a1450de452","title":"酬李校书","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["才游象外身虽远，","学茂区中事易闻。","自顾漳滨多病后，","空瞻逸翮舞青云。"],"stanzas":[["才游象外身虽远，","学茂区中事易闻。"],["自顾漳滨多病后，","空瞻逸翮舞青云。"]]}
{"id":"986832cf76","title":"赋凌云寺二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻说凌云寺里苔，","风高日近绝纤埃。","横云点染芙蓉壁，","似待诗人宝月来。"],"stanzas":[["闻说凌云寺里苔，","风高日近绝纤埃。"],["横云点染芙蓉壁，","似待诗人宝月来。"]]}
{"id":"ac5ddc5e98","title":"赋凌云寺二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻说凌云寺里花，","飞空绕磴逐江斜。","有时锁得嫦娥镜，","镂出瑶台五色霞。"],"stanzas":[["闻说凌云寺里花，","飞空绕磴逐江斜。"],["有时锁得嫦娥镜，","镂出瑶台五色霞。"]]}
{"id":"15016a1733","title":"九日遇雨二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里惊飙朔气深，","江城萧索昼阴阴。","谁怜不得登山去，","可惜寒芳色似金。"],"stanzas":[["万里惊飙朔气深，","江城萧索昼阴阴。"],["谁怜不得登山去，","可惜寒芳色似金。"]]}
{"id":"af85a03595","title":"九日遇雨二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茱萸秋节佳期阻，","金菊寒花满院香。","神女欲来知有意，","先令云雨暗池塘。"],"stanzas":[["茱萸秋节佳期阻，","金菊寒花满院香。"],["神女欲来知有意，","先令云雨暗池塘。"]]}
{"id":"aa56ec40ea","title":"酬雍秀才贻巴峡图","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千叠云峰万顷湖，","白波分去绕荆吴。","感君识我枕流意，","重示瞿塘峡口图。"],"stanzas":[["千叠云峰万顷湖，","白波分去绕荆吴。"],["感君识我枕流意，","重示瞿塘峡口图。"]]}
{"id":"0ae1849d10","title":"上王尚书","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧玉双幢白玉郎，","初辞天帝下扶桑。","手持云篆题新榜，","十万人家春日长。"],"stanzas":[["碧玉双幢白玉郎，","初辞天帝下扶桑。"],["手持云篆题新榜，","十万人家春日长。"]]}
{"id":"7485b18c9c","title":"和刘宾客玉蕣","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琼枝的皪露珊珊，","欲折如披玉彩寒。","闲拂朱房何所似，","缘山偏映月轮残。"],"stanzas":[["琼枝的皪露珊珊，","欲折如披玉彩寒。"],["闲拂朱房何所似，","缘山偏映月轮残。"]]}
{"id":"af50879836","title":"江边","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西风忽报鴈双双，","人世心形两自降。","不为鱼肠有真诀，","谁能梦梦立清江。"],"stanzas":[["西风忽报鴈双双，","人世心形两自降。"],["不为鱼肠有真诀，","谁能梦梦立清江。"]]}
{"id":"4fa2a0a982","title":"送卢员外","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉垒山前风雪夜，","锦官城外别离魂。","信陵公子如相问，","长向夷门感旧恩。"],"stanzas":[["玉垒山前风雪夜，","锦官城外别离魂。"],["信陵公子如相问，","长向夷门感旧恩。"]]}
{"id":"ba0281b4e5","title":"题竹郎庙","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹郎庙前多古木，","夕阳沈沈山更绿。","何处江村有笛声，","声声尽是迎郎曲。"],"stanzas":[["竹郎庙前多古木，","夕阳沈沈山更绿。"],["何处江村有笛声，","声声尽是迎郎曲。"]]}
{"id":"7082b61213","title":"赠苏十三中丞","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洛阳陌上埋轮气，","欲逐秋空击隼飞。","今日芝泥检征诏，","别须台外振霜威。"],"stanzas":[["洛阳陌上埋轮气，","欲逐秋空击隼飞。"],["今日芝泥检征诏，","别须台外振霜威。"]]}
{"id":"2011f48228","title":"和郭员外题万里桥","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里桥头独越吟，","知凭文字写愁心。","细侯风韵兼前事，","不止为舟也作霖。"],"stanzas":[["万里桥头独越吟，","知凭文字写愁心。"],["细侯风韵兼前事，","不止为舟也作霖。"]]}
{"id":"7666349c1f","title":"送郑眉州","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨暗眉山江水流，","离人掩袂立高楼。","双旌千骑骈东陌，","独有罗敷望上头。"],"stanzas":[["雨暗眉山江水流，","离人掩袂立高楼。"],["双旌千骑骈东陌，","独有罗敷望上头。"]]}
{"id":"4ce3a64c44","title":"江亭饯别","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿沼红泥物象幽，","范汪兼倅李并州。","离亭急管四更后，","不见公车心独愁。"],"stanzas":[["绿沼红泥物象幽，","范汪兼倅李并州。"],["离亭急管四更后，","不见公车心独愁。"]]}
{"id":"6b19ddeb97","title":"海棠溪","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春教风景驻仙霞，","水面鱼身总带花。","人世不思灵卉异，","竞将红缬染轻沙。"],"stanzas":[["春教风景驻仙霞，","水面鱼身总带花。"],["人世不思灵卉异，","竞将红缬染轻沙。"]]}
{"id":"a658d6762b","title":"采莲舟","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风前一叶压荷蕖，","解报新秋又得鱼。","兔走乌驰人语静，","满溪红袂櫂歌初。"],"stanzas":[["风前一叶压荷蕖，","解报新秋又得鱼。"],["兔走乌驰人语静，","满溪红袂櫂歌初。"]]}
{"id":"f3ef090670","title":"菱荇沼","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水荇斜牵绿藻浮，","柳丝和叶卧清流。","何时得向溪头赏，","旋摘菱花旋泛舟。"],"stanzas":[["水荇斜牵绿藻浮，","柳丝和叶卧清流。"],["何时得向溪头赏，","旋摘菱花旋泛舟。"]]}
{"id":"098902a89a","title":"金灯花","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阑边不见蘘蘘叶，","砌下惟翻艳艳丛。","细视欲将何物比，","晓霞初叠赤城宫。"],"stanzas":[["阑边不见蘘蘘叶，","砌下惟翻艳艳丛。"],["细视欲将何物比，","晓霞初叠赤城宫。"]]}
{"id":"6bf41c3588","title":"春郊游眺寄孙处士二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["低头久立向蔷薇，","爱似零陵香惹衣。","何事碧溪孙处士，","百劳东去燕西飞。"],"stanzas":[["低头久立向蔷薇，","爱似零陵香惹衣。"],["何事碧溪孙处士，","百劳东去燕西飞。"]]}
{"id":"771c217487","title":"春郊游眺寄孙处士二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今朝纵目玩芳菲，","夹缬笼裙绣地衣。","满袖满头兼手把，","教人识是看花归。"],"stanzas":[["今朝纵目玩芳菲，","夹缬笼裙绣地衣。"],["满袖满头兼手把，","教人识是看花归。"]]}
{"id":"fb1dd97f03","title":"酬杨供奉法师见招","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远水长流洁复清，","雪窗高卧与云平。","不嫌袁室无烟火，","惟笑商山有姓名。"],"stanzas":[["远水长流洁复清，","雪窗高卧与云平。"],["不嫌袁室无烟火，","惟笑商山有姓名。"]]}
{"id":"10b987c9c7","title":"试新服裁制初成三首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["紫阳宫里赐红绡，","仙雾朦胧隔海遥。","霜兔毳寒冰茧净，","嫦娥笑指织星桥。"],"stanzas":[["紫阳宫里赐红绡，","仙雾朦胧隔海遥。"],["霜兔毳寒冰茧净，","嫦娥笑指织星桥。"]]}
{"id":"1408d6fda3","title":"试新服裁制初成三首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九气分为九色霞，","五灵仙驭五云车。","春风因过东君舍，","偷样人间染百花。"],"stanzas":[["九气分为九色霞，","五灵仙驭五云车。"],["春风因过东君舍，","偷样人间染百花。"]]}
{"id":"325f9749e2","title":"试新服裁制初成三首 三","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长裾本是上清仪，","曾逐群仙把玉芝。","每到宫中歌舞会，","折腰齐唱步虚词。"],"stanzas":[["长裾本是上清仪，","曾逐群仙把玉芝。"],["每到宫中歌舞会，","折腰齐唱步虚词。"]]}
{"id":"c301d060a0","title":"寄张元夫","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前溪独立后溪行，","鹭识朱衣自不惊。","借问人间愁寂意，","伯牙弦绝已无声。"],"stanzas":[["前溪独立后溪行，","鹭识朱衣自不惊。"],["借问人间愁寂意，","伯牙弦绝已无声。"]]}
{"id":"84b66cac99","title":"酬辛员外折花见遗","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青鸟东飞正落梅，","衔花满口下瑶台。","一枝为授殷勤意，","把向风前旋旋开。"],"stanzas":[["青鸟东飞正落梅，","衔花满口下瑶台。"],["一枝为授殷勤意，","把向风前旋旋开。"]]}
{"id":"21912bcb13","title":"赠远二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芙蓉新落蜀山秋，","锦字开缄到是愁。","闺阁不知戎马事，","月高还上望夫楼。"],"stanzas":[["芙蓉新落蜀山秋，","锦字开缄到是愁。"],["闺阁不知戎马事，","月高还上望夫楼。"]]}
{"id":"551da2f9e4","title":"赠远二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["扰弱新蒲叶又齐，","春深花落塞前溪。","知君未转秦关骑，","月照千门掩袖啼。"],"stanzas":[["扰弱新蒲叶又齐，","春深花落塞前溪。"],["知君未转秦关骑，","月照千门掩袖啼。"]]}
{"id":"e6ff8e683b","title":"秋泉","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冷色初澄一带烟，","幽声遥泻十丝弦。","长来枕上牵情思，","不使愁人半夜眠。"],"stanzas":[["冷色初澄一带烟，","幽声遥泻十丝弦。"],["长来枕上牵情思，","不使愁人半夜眠。"]]}
{"id":"f7a9f93f6b","title":"柳絮","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["二月杨花轻复微，","春风摇荡惹人衣。","他家本是无情物，","一任南飞又北飞。"],"stanzas":[["二月杨花轻复微，","春风摇荡惹人衣。"],["他家本是无情物，","一任南飞又北飞。"]]}
{"id":"23c402dd2b","title":"续嘉陵驿诗献武相国","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蜀门西更上青天，","强为公歌蜀国弦。","卓氏长卿称士女，","锦江玉垒献山川。"],"stanzas":[["蜀门西更上青天，","强为公歌蜀国弦。"],["卓氏长卿称士女，","锦江玉垒献山川。"]]}
{"id":"0496a0dbc6","title":"段相国游武担寺病不能从题寄","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["消瘦翻堪见令公，","落花无那恨东风。","侬心犹道青春在，","羞看飞蓬石镜中。"],"stanzas":[["消瘦翻堪见令公，","落花无那恨东风。"],["侬心犹道青春在，","羞看飞蓬石镜中。"]]}
{"id":"4a4751115e","title":"赠段校书","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["公子翩翩说校书，","玉弓金勒紫绡裾。","玄成莫便骄名誉，","文采风流定不如。"],"stanzas":[["公子翩翩说校书，","玉弓金勒紫绡裾。"],["玄成莫便骄名誉，","文采风流定不如。"]]}
{"id":"8391eeea0b","title":"十离诗 犬离主","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["驯扰朱门四五年，","毛香足净主人怜。","无端咬著亲情客，","不得红丝毯上眠。"],"stanzas":[["驯扰朱门四五年，","毛香足净主人怜。"],["无端咬著亲情客，","不得红丝毯上眠。"]]}
{"id":"c63fef5580","title":"十离诗 笔离手","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["越管宣毫始称情，","红笺纸上撒花琼。","都缘用久锋头尽，","不得羲之手里擎。"],"stanzas":[["越管宣毫始称情，","红笺纸上撒花琼。"],["都缘用久锋头尽，","不得羲之手里擎。"]]}
{"id":"828ebc87ad","title":"十离诗 马离廐","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪耳红毛浅碧蹄，","追风曾到日东西。","为惊玉貌郎君坠，","不得华轩更一嘶。"],"stanzas":[["雪耳红毛浅碧蹄，","追风曾到日东西。"],["为惊玉貌郎君坠，","不得华轩更一嘶。"]]}
{"id":"84434b5958","title":"十离诗 鹦鹉离笼","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陇西独自一孤身，","飞去飞来上锦茵。","都缘出语无方便，","不得笼中再唤人。"],"stanzas":[["陇西独自一孤身，","飞去飞来上锦茵。"],["都缘出语无方便，","不得笼中再唤人。"]]}
{"id":"398a54dbb7","title":"十离诗 燕离巢","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["出入朱门未忍抛，","主人常爱语交交。","衔泥秽汚珊瑚枕，","不得梁间更垒巢。"],"stanzas":[["出入朱门未忍抛，","主人常爱语交交。"],["衔泥秽汚珊瑚枕，","不得梁间更垒巢。"]]}
{"id":"8a9ec9b14a","title":"十离诗 珠离掌","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皎洁圆明内外通，","清光似照水晶宫。","只缘一点玷相秽，","不得终宵在掌中。"],"stanzas":[["皎洁圆明内外通，","清光似照水晶宫。"],["只缘一点玷相秽，","不得终宵在掌中。"]]}
{"id":"038428d6b1","title":"十离诗 鱼离池","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["跳跃深池四五秋，","常摇朱尾弄纶钩。","无端摆断芙蓉朵，","不得清波更一游。"],"stanzas":[["跳跃深池四五秋，","常摇朱尾弄纶钩。"],["无端摆断芙蓉朵，","不得清波更一游。"]]}
{"id":"def7861b2e","title":"十离诗 鱼离池","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戏跃莲池四五秋，","常揺朱尾弄银钩。","无缘摆罢芙蓉朶，","不得清波更一游。"],"stanzas":[["戏跃莲池四五秋，","常揺朱尾弄银钩。"],["无缘摆罢芙蓉朶，","不得清波更一游。"]]}
{"id":"46f99655c8","title":"十离诗 鹰离鞲","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爪利如锋眼似铃，","平原捉兔称高情。","无端窜向青云外，","不得君王臂上擎。"],"stanzas":[["爪利如锋眼似铃，","平原捉兔称高情。"],["无端窜向青云外，","不得君王臂上擎。"]]}
{"id":"8625defadf","title":"十离诗 竹离亭","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蓊郁新栽四五行，","常将劲节负秋霜。","为缘春笋钻墙破，","不得垂阴覆玉堂。"],"stanzas":[["蓊郁新栽四五行，","常将劲节负秋霜。"],["为缘春笋钻墙破，","不得垂阴覆玉堂。"]]}
{"id":"2b46dcd01c","title":"十离诗 镜离台","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["铸泻黄金镜始开，","初生三五月裴回。","为遭无限尘蒙蔽，","不得华堂上玉台。"],"stanzas":[["铸泻黄金镜始开，","初生三五月裴回。"],["为遭无限尘蒙蔽，","不得华堂上玉台。"]]}
{"id":"db21fb474f","title":"酬杜舍人","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["双鱼底事到侬家，","扑手新诗片片霞。","唱到白苹洲畔曲，","芙蓉空老蜀江花。"],"stanzas":[["双鱼底事到侬家，","扑手新诗片片霞。"],["唱到白苹洲畔曲，","芙蓉空老蜀江花。"]]}
{"id":"d52bb31e26","title":"筹边楼","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平临云鸟八窗秋，","壮压西川四十州。","诸将莫贪羌族马，","最高层处见边头。"],"stanzas":[["平临云鸟八窗秋，","壮压西川四十州。"],["诸将莫贪羌族马，","最高层处见边头。"]]}
{"id":"224751072e","title":"赠韦校书","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芸香误比荆山玉，","那似登科甲乙年。","澹地鲜风将绮思，","飘花散蕊媚青天。"],"stanzas":[["芸香误比荆山玉，","那似登科甲乙年。"],["澹地鲜风将绮思，","飘花散蕊媚青天。"]]}
{"id":"7eb8d091e0","title":"江月楼","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秋风仿佛吴江冷，","鸥鹭参差夕阳影。","垂虹纳纳卧谯门，","雉堞眈眈俯渔艇。","阳安小儿拍手笑，","使君幻出江南景。"],"stanzas":[["秋风仿佛吴江冷，","鸥鹭参差夕阳影。"],["垂虹纳纳卧谯门，","雉堞眈眈俯渔艇。"],["阳安小儿拍手笑，","使君幻出江南景。"]]}
{"id":"3995eea7c0","title":"西岩","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凭阑却忆骑鲸客，","把酒临风手自招。","细雨声中停去马，","夕阳影里乱鸣蜩。"],"stanzas":[["凭阑却忆骑鲸客，","把酒临风手自招。"],["细雨声中停去马，","夕阳影里乱鸣蜩。"]]}
{"id":"6ec522029e","title":"罚赴边上武相公二首 一","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["萤在荒芜月在天，","萤飞岂到月轮边。","重光万里应相照，","目断云霄信不传。"],"stanzas":[["萤在荒芜月在天，","萤飞岂到月轮边。"],["重光万里应相照，","目断云霄信不传。"]]}
{"id":"58d766a8bf","title":"罚赴边上武相公二首 二","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["按辔岭头寒复寒，","微风细雨彻心肝。","但得放儿归舍去，","山水屏风永不看。"],"stanzas":[["按辔岭头寒复寒，","微风细雨彻心肝。"],["但得放儿归舍去，","山水屏风永不看。"]]}
{"id":"da60229c78","title":"寄旧诗与元微之","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗篇调态人皆有，","细腻风光我独知。","月下咏花怜暗澹，","雨朝题柳为欹垂。","长教碧玉藏深处，","总向红牋写自随。","老大不能收拾得，","与君开似教男儿。"],"stanzas":[["诗篇调态人皆有，","细腻风光我独知。"],["月下咏花怜暗澹，","雨朝题柳为欹垂。"],["长教碧玉藏深处，","总向红牋写自随。"],["老大不能收拾得，","与君开似教男儿。"]]}
{"id":"8f616a0ccc","title":"句","author":"薛涛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["枝迎南北鸟，","叶送往来风。"],"stanzas":[["枝迎南北鸟，","叶送往来风。"]]}
{"id":"d76cf1a81f","title":"赋得江边柳","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翠色连荒岸，","烟姿入远楼。","影铺秋水面，","花落钓人头。","根老藏鱼窟，","枝低系客舟。","萧萧风雨夜，","惊梦复添愁。"],"stanzas":[["翠色连荒岸，","烟姿入远楼。"],["影铺秋水面，","花落钓人头。"],["根老藏鱼窟，","枝低系客舟。"],["萧萧风雨夜，","惊梦复添愁。"]]}
{"id":"2cf714ea62","title":"赠邻女","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["羞日遮罗袖，","愁春嬾起妆。","易求无价宝，","难得有心郎。","枕上潜垂泪，","花间暗断肠。","自能窥宋玉，","何必恨王昌。"],"stanzas":[["羞日遮罗袖，","愁春嬾起妆。"],["易求无价宝，","难得有心郎。"],["枕上潜垂泪，","花间暗断肠。"],["自能窥宋玉，","何必恨王昌。"]]}
{"id":"94144366cc","title":"寄国香","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旦夕醉吟身，","相思又此春。","雨中寄书使，","窗下断肠人。","山卷珠帘看，","愁随芳草新。","别来清宴上，","几度落梁尘。"],"stanzas":[["旦夕醉吟身，","相思又此春。"],["雨中寄书使，","窗下断肠人。"],["山卷珠帘看，","愁随芳草新。"],["别来清宴上，","几度落梁尘。"]]}
{"id":"200f1e8e42","title":"寄题炼师","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霞彩翦为衣，","添香出绣帏。","芙蓉花叶□，","山水帔□稀。","驻履闻莺语，","开笼放鹤飞。","高堂春睡觉，","暮雨正霏霏。"],"stanzas":[["霞彩翦为衣，","添香出绣帏。"],["芙蓉花叶□，","山水帔□稀。"],["驻履闻莺语，","开笼放鹤飞。"],["高堂春睡觉，","暮雨正霏霏。"]]}
{"id":"57cf7a2e98","title":"寄刘尚书","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八座镇雄军，","歌谣满路新。","汾川三月雨，","晋水百花春。","囹圄长空锁，","干戈久覆尘。","儒僧观子夜，","羁客醉红茵。","笔砚行随手，","诗书坐绕身。","小材多顾盼，","得作食鱼人。"],"stanzas":[["八座镇雄军，","歌谣满路新。"],["汾川三月雨，","晋水百花春。"],["囹圄长空锁，","干戈久覆尘。"],["儒僧观子夜，","羁客醉红茵。"],["笔砚行随手，","诗书坐绕身。"],["小材多顾盼，","得作食鱼人。"]]}
{"id":"4b80603273","title":"浣纱庙","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴越相谋计策多，","浣纱神女已相和。","一双笑靥才回面，","十万精兵尽倒戈。","范蠡功成身隐遯，","伍胥谏死国消磨。","只今诸暨长江畔，","空有青山号苎萝。"],"stanzas":[["吴越相谋计策多，","浣纱神女已相和。"],["一双笑靥才回面，","十万精兵尽倒戈。"],["范蠡功成身隐遯，","伍胥谏死国消磨。"],["只今诸暨长江畔，","空有青山号苎萝。"]]}
{"id":"695c4df722","title":"卖残牡丹","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["临风兴叹落花频，","芳意潜消又一春。","应为价高人不问，","却缘香甚蝶难亲。","红英只称生宫里，","翠叶那堪染路尘。","及至移根上林苑，","王孙方恨买无因。"],"stanzas":[["临风兴叹落花频，","芳意潜消又一春。"],["应为价高人不问，","却缘香甚蝶难亲。"],["红英只称生宫里，","翠叶那堪染路尘。"],["及至移根上林苑，","王孙方恨买无因。"]]}
{"id":"90cfda4fa8","title":"酬李学士寄簟","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珍簟新铺翡翠楼，","泓澄玉水记方流。","唯应云扇情相似，","同向银床恨早秋。"],"stanzas":[["珍簟新铺翡翠楼，","泓澄玉水记方流。"],["唯应云扇情相似，","同向银床恨早秋。"]]}
{"id":"5c8372999a","title":"情书寄李子安","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["饮冰食蘗志无功，","晋水壶关在梦中。","秦镜欲分愁堕鹊，","舜琴将弄怨飞鸿。","井边桐叶鸣秋雨，","窗下银灯暗晓风。","书信茫茫何处问，","持竿尽日碧江空。"],"stanzas":[["饮冰食蘗志无功，","晋水壶关在梦中。"],["秦镜欲分愁堕鹊，","舜琴将弄怨飞鸿。"],["井边桐叶鸣秋雨，","窗下银灯暗晓风。"],["书信茫茫何处问，","持竿尽日碧江空。"]]}
{"id":"bc19865127","title":"闺怨","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蘼芜盈手泣斜晖，","闻道邻家夫壻归。","别日南鸿才北去，","今朝北鴈又南飞。","春来秋去相思在，","秋去春来信息稀。","扃闭朱门人不到，","砧声何事透罗帏。"],"stanzas":[["蘼芜盈手泣斜晖，","闻道邻家夫壻归。"],["别日南鸿才北去，","今朝北鴈又南飞。"],["春来秋去相思在，","秋去春来信息稀。"],["扃闭朱门人不到，","砧声何事透罗帏。"]]}
{"id":"241dc5f79c","title":"春情寄子安","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山路敧斜石磴危，","不愁行苦苦相思。","冰销远磵怜清韵，","雪远寒峰想玉姿。","莫听凡歌春病酒，","休招闲客夜贪棋。","如松匪石盟长在，","比翼连襟会肯迟。","虽恨独行冬尽日，","终期相见月圆时。","别君何物堪持赠，","泪落晴光一首诗。"],"stanzas":[["山路敧斜石磴危，","不愁行苦苦相思。"],["冰销远磵怜清韵，","雪远寒峰想玉姿。"],["莫听凡歌春病酒，","休招闲客夜贪棋。"],["如松匪石盟长在，","比翼连襟会肯迟。"],["虽恨独行冬尽日，","终期相见月圆时。"],["别君何物堪持赠，","泪落晴光一首诗。"]]}
{"id":"03a02d8e4b","title":"打毬作","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["坚圆净滑一星流，","月杖争敲未拟休。","无滞碍时从拨弄，","有遮栏处任钩留。","不辞宛转长随手，","却恐相将不到头。","毕竟入门应始了，","愿君争取最前筹。"],"stanzas":[["坚圆净滑一星流，","月杖争敲未拟休。"],["无滞碍时从拨弄，","有遮栏处任钩留。"],["不辞宛转长随手，","却恐相将不到头。"],["毕竟入门应始了，","愿君争取最前筹。"]]}
{"id":"56575c5a1d","title":"暮春有感寄友人","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莺语惊残梦，","轻妆改泪容。","竹阴初月薄，","江静晚烟浓。","湿觜衔泥燕，","香须采蕊蜂。","独怜无限思，","吟罢亚枝松。"],"stanzas":[["莺语惊残梦，","轻妆改泪容。"],["竹阴初月薄，","江静晚烟浓。"],["湿觜衔泥燕，","香须采蕊蜂。"],["独怜无限思，","吟罢亚枝松。"]]}
{"id":"42a3c7322d","title":"冬夜寄温飞卿","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苦思搜诗灯下吟，","不眠长夜怕寒衾。","满庭木叶愁风起，","透幌纱窗惜月沈。","疎散未闲终遂愿，","盛衰空见本来心。","幽栖莫定梧桐处，","暮雀啾啾空绕林。"],"stanzas":[["苦思搜诗灯下吟，","不眠长夜怕寒衾。"],["满庭木叶愁风起，","透幌纱窗惜月沈。"],["疎散未闲终遂愿，","盛衰空见本来心。"],["幽栖莫定梧桐处，","暮雀啾啾空绕林。"]]}
{"id":"5ca8698d2a","title":"酬李郢夏日钓鱼回见示","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["住处虽同巷，","经年不一过。","清词劝旧女，","香桂折新柯。","道性欺冰雪，","禅心笑绮罗。","迹登霄汉上，","无路接烟波。"],"stanzas":[["住处虽同巷，","经年不一过。"],["清词劝旧女，","香桂折新柯。"],["道性欺冰雪，","禅心笑绮罗。"],["迹登霄汉上，","无路接烟波。"]]}
{"id":"043033fb82","title":"次韵西邻新居兼乞酒","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一首诗来百度吟，","新情字字又声金。","西看已有登垣意，","远望能无化石心。","河汉期赊空极目，","潇湘梦断罢调琴。","况逢寒节添乡思，","叔夜佳醪莫独斟。"],"stanzas":[["一首诗来百度吟，","新情字字又声金。"],["西看已有登垣意，","远望能无化石心。"],["河汉期赊空极目，","潇湘梦断罢调琴。"],["况逢寒节添乡思，","叔夜佳醪莫独斟。"]]}
{"id":"f668cdc307","title":"和友人次韵","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何事能销旅馆愁，","红牋开处见银钩。","蓬山雨洒千峰小，","嶰谷风吹万叶秋。","字字朝看轻碧玉，","篇篇夜诵在衾裯。","欲将香匣收藏却，","且惜时吟在手头。"],"stanzas":[["何事能销旅馆愁，","红牋开处见银钩。"],["蓬山雨洒千峰小，","嶰谷风吹万叶秋。"],["字字朝看轻碧玉，","篇篇夜诵在衾裯。"],["欲将香匣收藏却，","且惜时吟在手头。"]]}
{"id":"0d98a686ee","title":"和新及第悼亡诗二首 一","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙籍人间不久留，","片时已过十经秋。","鸳鸯帐下香犹暖，","鹦鹉笼中语未休。","朝露缀花如脸恨，","晚风敧柳似眉愁。","彩云一去无消息，","潘岳多情欲白头。"],"stanzas":[["仙籍人间不久留，","片时已过十经秋。"],["鸳鸯帐下香犹暖，","鹦鹉笼中语未休。"],["朝露缀花如脸恨，","晚风敧柳似眉愁。"],["彩云一去无消息，","潘岳多情欲白头。"]]}
{"id":"8143a717bb","title":"和新及第悼亡诗二首 二","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一枝月桂和烟秀，","万树江桃带雨红。","且醉尊前休怅望，","古来悲乐与今同。"],"stanzas":[["一枝月桂和烟秀，","万树江桃带雨红。"],["且醉尊前休怅望，","古来悲乐与今同。"]]}
{"id":"a2881ecce5","title":"游崇真观南楼覩新及第题名处","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云峰满目放春晴，","历历银钩指下生。","自恨罗衣掩诗句，","举头空羡榜中名。"],"stanzas":[["云峰满目放春晴，","历历银钩指下生。"],["自恨罗衣掩诗句，","举头空羡榜中名。"]]}
{"id":"e03e30835a","title":"愁思","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落叶纷纷暮雨和，","朱丝独抚自清歌。","放情休恨无心友，","养性空抛苦海波。","长者车音门外有，","道家书卷枕前多。","布衣终作云霄客，","绿水青山时一过。"],"stanzas":[["落叶纷纷暮雨和，","朱丝独抚自清歌。"],["放情休恨无心友，","养性空抛苦海波。"],["长者车音门外有，","道家书卷枕前多。"],["布衣终作云霄客，","绿水青山时一过。"]]}
{"id":"ac745da466","title":"秋怨","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自叹多情是足愁，","况当风月满庭秋。","洞房偏与更声近，","夜夜灯前欲白头。"],"stanzas":[["自叹多情是足愁，","况当风月满庭秋。"],["洞房偏与更声近，","夜夜灯前欲白头。"]]}
{"id":"3dba098361","title":"江行 一","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大江横抱武昌斜，","鹦鹉洲前户万家。","画舸春眠朝未足，","梦为蝴蝶也寻花。"],"stanzas":[["大江横抱武昌斜，","鹦鹉洲前户万家。"],["画舸春眠朝未足，","梦为蝴蝶也寻花。"]]}
{"id":"797f04eb87","title":"江行 二","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟花已入鸬鹚港，","画舸犹沿鹦鹉洲。","醉卧醒吟都不觉，","今朝惊在汉江头。"],"stanzas":[["烟花已入鸬鹚港，","画舸犹沿鹦鹉洲。"],["醉卧醒吟都不觉，","今朝惊在汉江头。"]]}
{"id":"b0812f57bf","title":"闻李端公垂钓回寄赠","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无限荷香染暑衣，","阮郎何处弄船归。","自慙不及鸳鸯侣，","犹得双双近钓矶。"],"stanzas":[["无限荷香染暑衣，","阮郎何处弄船归。"],["自慙不及鸳鸯侣，","犹得双双近钓矶。"]]}
{"id":"7edcb86a6e","title":"题任处士刱资福寺","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽人刱奇境，","游客驻行程。","粉壁空留字，","莲宫未有名。","凿池泉自出，","开径草重生。","百尺金轮阁，","当川豁眼明。"],"stanzas":[["幽人刱奇境，","游客驻行程。"],["粉壁空留字，","莲宫未有名。"],["凿池泉自出，","开径草重生。"],["百尺金轮阁，","当川豁眼明。"]]}
{"id":"778c81b324","title":"题隐雾亭","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春花秋月入诗篇，","白日清宵是散仙。","空卷珠帘不曾下，","长移一榻对山眠。"],"stanzas":[["春花秋月入诗篇，","白日清宵是散仙。"],["空卷珠帘不曾下，","长移一榻对山眠。"]]}
{"id":"5d340879ca","title":"重阳阻雨","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满庭黄菊篱边拆，","两朵芙蓉镜里开。","落帽台前风雨阻，","不知何处醉金杯。"],"stanzas":[["满庭黄菊篱边拆，","两朵芙蓉镜里开。"],["落帽台前风雨阻，","不知何处醉金杯。"]]}
{"id":"5fbc21ef22","title":"早秋","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嫩菊含新彩，","远山闲夕烟。","凉风惊绿树，","清韵入朱弦。","思妇机中锦，","征人塞外天。","鴈飞鱼在水，","书信若为传。"],"stanzas":[["嫩菊含新彩，","远山闲夕烟。"],["凉风惊绿树，","清韵入朱弦。"],["思妇机中锦，","征人塞外天。"],["鴈飞鱼在水，","书信若为传。"]]}
{"id":"18a2de68c9","title":"感怀寄人","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["恨寄朱弦上，","含情意不任。","早知云雨会，","未起蕙兰心。","灼灼桃兼李，","无妨国士寻。","苍苍松与桂，","仍羡世人钦。","月色苔阶净，","歌声竹院深。","门前红叶地，","不埽待知音。"],"stanzas":[["恨寄朱弦上，","含情意不任。"],["早知云雨会，","未起蕙兰心。"],["灼灼桃兼李，","无妨国士寻。"],["苍苍松与桂，","仍羡世人钦。"],["月色苔阶净，","歌声竹院深。"],["门前红叶地，","不埽待知音。"]]}
{"id":"75062dbc74","title":"期友人阻雨不至","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鴈鱼空有信，","鸡黍恨无期。","闭户方笼月，","褰帘已散丝。","近泉鸣砌畔，","远浪涨江湄。","乡思悲秋客，","愁吟五字诗。"],"stanzas":[["鴈鱼空有信，","鸡黍恨无期。"],["闭户方笼月，","褰帘已散丝。"],["近泉鸣砌畔，","远浪涨江湄。"],["乡思悲秋客，","愁吟五字诗。"]]}
{"id":"e8d0e9facb","title":"访赵炼师不遇","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何处同仙侣，","青衣独在家。","暖炉留煮药，","邻院为煎茶。","画壁灯光暗，","幡竿日影斜。","殷勤重回首，","墙外数枝花。"],"stanzas":[["何处同仙侣，","青衣独在家。"],["暖炉留煮药，","邻院为煎茶。"],["画壁灯光暗，","幡竿日影斜。"],["殷勤重回首，","墙外数枝花。"]]}
{"id":"aa4ec939e4","title":"遣怀","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲散身无事，","风光独自游。","断云江上月，","解缆海中舟。","琴弄萧梁寺，","诗吟庾亮楼。","丛篁堪作伴，","片石好为俦。","燕雀徒为贵，","金银志不求。","满杯春酒绿，","对月夜窗幽。","绕砌澄清沼，","抽簪映细流。","卧床书册徧，","半醉起梳头。"],"stanzas":[["闲散身无事，","风光独自游。"],["断云江上月，","解缆海中舟。"],["琴弄萧梁寺，","诗吟庾亮楼。"],["丛篁堪作伴，","片石好为俦。"],["燕雀徒为贵，","金银志不求。"],["满杯春酒绿，","对月夜窗幽。"],["绕砌澄清沼，","抽簪映细流。"],["卧床书册徧，","半醉起梳头。"]]}
{"id":"16a07d75b2","title":"寄飞卿","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阶砌乱蛩鸣，","庭柯烟露清。","月中邻乐响，","楼上远山明。","珍簟凉风著，","瑶琴寄恨生。","嵇君嬾书札，","底物慰秋情。"],"stanzas":[["阶砌乱蛩鸣，","庭柯烟露清。"],["月中邻乐响，","楼上远山明。"],["珍簟凉风著，","瑶琴寄恨生。"],["嵇君嬾书札，","底物慰秋情。"]]}
{"id":"99a747eb2e","title":"过鄂州","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳拂兰桡花满枝，","石城城下暮帆迟。","折牌峰上三闾墓，","远火山头五马旗。","白雪调高题旧寺，","阳春歌在唤新词。","莫愁魂逐清江去，","空使行人万首诗。"],"stanzas":[["柳拂兰桡花满枝，","石城城下暮帆迟。"],["折牌峰上三闾墓，","远火山头五马旗。"],["白雪调高题旧寺，","阳春歌在唤新词。"],["莫愁魂逐清江去，","空使行人万首诗。"]]}
{"id":"7357d3749f","title":"夏日山居","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["移得仙居此地来，","花丛自徧不曾栽。","庭前亚树张衣桁，","坐上新泉泛酒杯。","轩槛暗传深竹径，","绮罗长拥乱书堆。","闲乘画舫吟明月，","信任轻风吹却回。"],"stanzas":[["移得仙居此地来，","花丛自徧不曾栽。"],["庭前亚树张衣桁，","坐上新泉泛酒杯。"],["轩槛暗传深竹径，","绮罗长拥乱书堆。"],["闲乘画舫吟明月，","信任轻风吹却回。"]]}
{"id":"5e7f918f23","title":"暮春即事","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深巷穷门少侣俦，","阮郎唯有梦中留。","香飘罗绮谁家席，","风送歌声何处楼。","街近鼓鼙喧晓睡，","庭闲鹊语乱春愁。","安能追逐人间事，","万里身同不系舟。"],"stanzas":[["深巷穷门少侣俦，","阮郎唯有梦中留。"],["香飘罗绮谁家席，","风送歌声何处楼。"],["街近鼓鼙喧晓睡，","庭闲鹊语乱春愁。"],["安能追逐人间事，","万里身同不系舟。"]]}
{"id":"3cd76e08e1","title":"代人悼亡","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾覩夭桃想玉姿，","带风杨柳认蛾眉。","珠归龙窟知谁见，","镜在鸾台话向谁。","从此梦悲烟雨夜，","不堪吟苦寂寥时。","西山日落东山月，","恨想无因有了期。"],"stanzas":[["曾覩夭桃想玉姿，","带风杨柳认蛾眉。"],["珠归龙窟知谁见，","镜在鸾台话向谁。"],["从此梦悲烟雨夜，","不堪吟苦寂寥时。"],["西山日落东山月，","恨想无因有了期。"]]}
{"id":"aa946ddc7a","title":"和人","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茫茫九陌无知己，","暮去朝来典绣衣。","宝匣镜昏蝉鬓乱，","博山炉暖麝烟微。","多情公子春留句，","少思文君昼掩扉。","莫惜羊车频列载，","柳丝梅绽正芳菲。"],"stanzas":[["茫茫九陌无知己，","暮去朝来典绣衣。"],["宝匣镜昏蝉鬓乱，","博山炉暖麝烟微。"],["多情公子春留句，","少思文君昼掩扉。"],["莫惜羊车频列载，","柳丝梅绽正芳菲。"]]}
{"id":"0e60565eed","title":"隔汉江寄子安","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江南江北愁望，","相思相忆空吟。","鸳鸯暖卧沙浦，","㶉𪆟闲飞橘林。","烟里歌声隐隐，","渡头月色沈沈。","含情咫尺千里，","况听家家远砧。"],"stanzas":[["江南江北愁望，","相思相忆空吟。"],["鸳鸯暖卧沙浦，","㶉𪆟闲飞橘林。"],["烟里歌声隐隐，","渡头月色沈沈。"],["含情咫尺千里，","况听家家远砧。"]]}
{"id":"d198a06ef8","title":"寓言","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红桃处处春色，","碧柳家家月明。","楼上新妆待夜，","闺中独坐含情。","芙蓉月下鱼戏，","䗖𬟽天边雀声。","人世悲欢一梦，","如何得作双成。"],"stanzas":[["红桃处处春色，","碧柳家家月明。"],["楼上新妆待夜，","闺中独坐含情。"],["芙蓉月下鱼戏，","䗖𬟽天边雀声。"],["人世悲欢一梦，","如何得作双成。"]]}
{"id":"858626ead5","title":"江陵愁望寄子安","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["枫叶千枝复万枝，","江桥掩映暮帆迟。","忆君心似西江水，","日夜东流无歇时。"],"stanzas":[["枫叶千枝复万枝，","江桥掩映暮帆迟。"],["忆君心似西江水，","日夜东流无歇时。"]]}
{"id":"97bd875146","title":"寄子安","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["醉别千巵不浣愁，","离肠百结解无由。","蕙兰销歇归春圃，","杨柳东西绊客舟。","聚散已悲云不定，","恩情须学水长流。","有花时节知难遇，","未肯厌厌醉玉楼。"],"stanzas":[["醉别千巵不浣愁，","离肠百结解无由。"],["蕙兰销歇归春圃，","杨柳东西绊客舟。"],["聚散已悲云不定，","恩情须学水长流。"],["有花时节知难遇，","未肯厌厌醉玉楼。"]]}
{"id":"22fb2cc216","title":"送别","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦楼几夜惬心期，","不料仙郎有别离。","睡觉莫言云去处，","残灯一醆野蛾飞。"],"stanzas":[["秦楼几夜惬心期，","不料仙郎有别离。"],["睡觉莫言云去处，","残灯一醆野蛾飞。"]]}
{"id":"d4f8624fa5","title":"迎李近仁员外","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今日喜时闻喜鹊，","昨宵灯下拜灯花。","焚香出户迎潘岳，","不羡牵牛织女家。"],"stanzas":[["今日喜时闻喜鹊，","昨宵灯下拜灯花。"],["焚香出户迎潘岳，","不羡牵牛织女家。"]]}
{"id":"8ca8f997a0","title":"送别","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水柔逐器知难定，","云出无心肯再归。","惆怅春风楚江暮，","鸳鸯一只失群飞。"],"stanzas":[["水柔逐器知难定，","云出无心肯再归。"],["惆怅春风楚江暮，","鸳鸯一只失群飞。"]]}
{"id":"b3b3220400","title":"左名场自泽州至京使人传语","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲居作赋几年愁，","王屋山前是旧游。","诗咏东西千嶂乱，","马随南北一泉流。","曾陪雨夜同欢席，","别后花时独上楼。","忽喜扣门传语至，","为怜邻巷小房幽。","相如琴罢朱弦断，","双燕巢分白露秋。","莫倦蓬门时一访，","每春忙在曲江头。"],"stanzas":[["闲居作赋几年愁，","王屋山前是旧游。"],["诗咏东西千嶂乱，","马随南北一泉流。"],["曾陪雨夜同欢席，","别后花时独上楼。"],["忽喜扣门传语至，","为怜邻巷小房幽。"],["相如琴罢朱弦断，","双燕巢分白露秋。"],["莫倦蓬门时一访，","每春忙在曲江头。"]]}
{"id":"0e664cce9b","title":"和人次韵","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["喧喧朱紫杂人寰，","独自清吟日色间。","何事玉郎搜藻思，","忽将琼韵扣柴关。","白花发咏慙称谢，","僻巷深居谬学颜。","不用多情欲相见，","松萝高处是前山。"],"stanzas":[["喧喧朱紫杂人寰，","独自清吟日色间。"],["何事玉郎搜藻思，","忽将琼韵扣柴关。"],["白花发咏慙称谢，","僻巷深居谬学颜。"],["不用多情欲相见，","松萝高处是前山。"]]}
{"id":"76b8918952","title":"光威裒姊妹三人少孤而始妍乃有是作精粹难俦虽谢家联雪何以加之有客自京师来者示予因次其韵","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔闻南国容华少，","今日东邻姊妹三。","妆阁相看鹦鹉赋，","碧窗应绣凤凰衫。","红芳满院参差折，","绿醑盈杯次第衔。","恐向瑶池曾作女，","谪来尘世未为男。","文姬有貌终堪比，","西子无言我更惭。","一曲艳歌琴杳杳，","四弦轻拨语喃喃。","当台竞鬬青丝发，","对月争夸白玉簪。","小有洞中松露滴，","大罗天上柳烟含。","但能为雨心长在，","不怕吹箫事未谙。","阿母几嗔花下语，","潘郎曾向梦中参。","暂持清句魂犹断，","若覩红颜死亦甘。","怅望佳人何处在，","行云归北又归南。"],"stanzas":[["昔闻南国容华少，","今日东邻姊妹三。"],["妆阁相看鹦鹉赋，","碧窗应绣凤凰衫。"],["红芳满院参差折，","绿醑盈杯次第衔。"],["恐向瑶池曾作女，","谪来尘世未为男。"],["文姬有貌终堪比，","西子无言我更惭。"],["一曲艳歌琴杳杳，","四弦轻拨语喃喃。"],["当台竞鬬青丝发，","对月争夸白玉簪。"],["小有洞中松露滴，","大罗天上柳烟含。"],["但能为雨心长在，","不怕吹箫事未谙。"],["阿母几嗔花下语，","潘郎曾向梦中参。"],["暂持清句魂犹断，","若覩红颜死亦甘。"],["怅望佳人何处在，","行云归北又归南。"]]}
{"id":"e48e1ae69a","title":"折杨柳","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝朝送别泣花钿，","折尽春风杨柳烟。","愿得西山无树木，","免教人作泪悬悬。"],"stanzas":[["朝朝送别泣花钿，","折尽春风杨柳烟。"],["愿得西山无树木，","免教人作泪悬悬。"]]}
{"id":"9e5a553d47","title":"句","author":"鱼玄机","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["焚香登玉坛，","端简礼金阙。","明月照幽隙，","清风开短襟。","绮陌春望远，","瑶徽春兴多。","殷勤不得语，","红泪一双流。","云情自郁争同梦，","仙貌长芳又胜花。"],"stanzas":[["焚香登玉坛，","端简礼金阙。"],["明月照幽隙，","清风开短襟。"],["绮陌春望远，","瑶徽春兴多。"],["殷勤不得语，","红泪一双流。"],["云情自郁争同梦，","仙貌长芳又胜花。"]]}
{"id":"a9f47dd105","title":"湖上卧病喜陆鸿渐至","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔去繁霜月，","今来苦雾时。","相逢仍卧病，","欲语泪先垂。","强劝陶家酒，","还吟谢客诗。","偶然成一醉，","此外更何之。"],"stanzas":[["昔去繁霜月，","今来苦雾时。"],["相逢仍卧病，","欲语泪先垂。"],["强劝陶家酒，","还吟谢客诗。"],["偶然成一醉，","此外更何之。"]]}
{"id":"4bbb0df741","title":"寄校书七兄","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无事乌程县，","蹉跎岁月余。","不知芸阁吏，","寂寞竟何如。","远水浮仙棹，","寒星伴使车。","因过大雷岸，","莫忘八行书。"],"stanzas":[["无事乌程县，","蹉跎岁月余。"],["不知芸阁吏，","寂寞竟何如。"],["远水浮仙棹，","寒星伴使车。"],["因过大雷岸，","莫忘八行书。"]]}
{"id":"923e404f09","title":"寄朱放","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["望水试登山，","山高湖又阔。","相思无晓夕，","相望经年月。","郁郁山木荣，","绵绵野花发。","别后无限情，","相逢一时说。"],"stanzas":[["望水试登山，","山高湖又阔。"],["相思无晓夕，","相望经年月。"],["郁郁山木荣，","绵绵野花发。"],["别后无限情，","相逢一时说。"]]}
{"id":"e881ab2325","title":"送韩揆之江西","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相看指杨柳，","别恨转依依。","万里江西水，","孤舟何处归？","湓城潮不到，","夏口信应稀。","唯有衡阳雁，","年年来去飞。"],"stanzas":[["相看指杨柳，","别恨转依依。"],["万里江西水，","孤舟何处归？"],["湓城潮不到，","夏口信应稀。"],["唯有衡阳雁，","年年来去飞。"]]}
{"id":"1099416275","title":"道意寄崔侍郎","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫漫恋浮名，","应须薄宦情。","百年齐旦暮，","前事尽虚盈。","愁鬓行看白，","童颜学未成。","无过天竺国，","依止古先生。"],"stanzas":[["莫漫恋浮名，","应须薄宦情。"],["百年齐旦暮，","前事尽虚盈。"],["愁鬓行看白，","童颜学未成。"],["无过天竺国，","依止古先生。"]]}
{"id":"9c11fa0267","title":"从萧叔子听弹琴赋得三峡流泉歌","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾家本住巫山云，","巫山流泉常自闻。","玉琴弹出转寥敻，","直是当时梦里听。","三峡迢迢几千里，","一时流入幽闺里。","巨石崩崖指下生，","飞泉走浪弦中起。","初疑愤怒含雷风，","又似呜咽流不通。","回湍曲濑势将尽，","时复滴沥平沙中。","忆昔阮公为此曲，","能令仲容听不足。","一弹既罢复一弹，","愿作流泉镇相续。"],"stanzas":[["妾家本住巫山云，","巫山流泉常自闻。"],["玉琴弹出转寥敻，","直是当时梦里听。"],["三峡迢迢几千里，","一时流入幽闺里。"],["巨石崩崖指下生，","飞泉走浪弦中起。"],["初疑愤怒含雷风，","又似呜咽流不通。"],["回湍曲濑势将尽，","时复滴沥平沙中。"],["忆昔阮公为此曲，","能令仲容听不足。"],["一弹既罢复一弹，","愿作流泉镇相续。"]]}
{"id":"2513facdc0","title":"相思怨","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人道海水深，","不抵相思半。","海水尚有涯，","相思渺无畔。","携琴上高楼，","楼虚月华满。","弹著相思曲，","弦肠一时断。"],"stanzas":[["人道海水深，","不抵相思半。"],["海水尚有涯，","相思渺无畔。"],["携琴上高楼，","楼虚月华满。"],["弹著相思曲，","弦肠一时断。"]]}
{"id":"94e4f732c9","title":"感兴","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝云暮雨镇相随，","去雁来人有返期。","玉枕秪知长下泪，","银灯空照不眠时。","仰看明月翻含意，","俯眄流波欲寄词。","却忆初闻凤楼曲，","教人寂寞复相思。"],"stanzas":[["朝云暮雨镇相随，","去雁来人有返期。"],["玉枕秪知长下泪，","银灯空照不眠时。"],["仰看明月翻含意，","俯眄流波欲寄词。"],["却忆初闻凤楼曲，","教人寂寞复相思。"]]}
{"id":"857fe6135e","title":"恩命追入留别广陵故人","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无才多病分龙钟，","不料虚名达九重。","仰媿弹冠上华发，","多慙拂镜理衰容。","驰心北阙随芳草，","极目南山望旧峰。","桂树不能留野客，","沙鸥出浦谩相逢。"],"stanzas":[["无才多病分龙钟，","不料虚名达九重。"],["仰媿弹冠上华发，","多慙拂镜理衰容。"],["驰心北阙随芳草，","极目南山望旧峰。"],["桂树不能留野客，","沙鸥出浦谩相逢。"]]}
{"id":"1f9abe6c76","title":"八至","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至近至远东西，","至深至浅清溪。","至高至明日月，","至亲至疎夫妻。"],"stanzas":[["至近至远东西，","至深至浅清溪。"],["至高至明日月，","至亲至疎夫妻。"]]}
{"id":"7435ed1d7f","title":"送阎二十六赴剡县","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["流水阊门外，","孤舟日复西。","离情遍芳草，","无处不萋萋。","妾梦经吴苑，","君行到剡溪。","归来重相访，","莫学阮郎迷。"],"stanzas":[["流水阊门外，","孤舟日复西。"],["离情遍芳草，","无处不萋萋。"],["妾梦经吴苑，","君行到剡溪。"],["归来重相访，","莫学阮郎迷。"]]}
{"id":"21490bd41c","title":"得阎伯钧书","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["情来对镜嬾梳头，","暮雨萧萧庭树秋。","莫怪阑干垂玉筯，","只缘惆怅对银钩。"],"stanzas":[["情来对镜嬾梳头，","暮雨萧萧庭树秋。"],["莫怪阑干垂玉筯，","只缘惆怅对银钩。"]]}
{"id":"5b05737a7b","title":"结素鱼贻友人","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尺素如残雪，","结为双鲤鱼。","欲知心里事，","看取腹中书。"],"stanzas":[["尺素如残雪，","结为双鲤鱼。"],["欲知心里事，","看取腹中书。"]]}
{"id":"9e8ab0126b","title":"偶居","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心远浮云知不还，","心云并在有无间。","狂风何事相摇荡，","吹向南山复北山。"],"stanzas":[["心远浮云知不还，","心云并在有无间。"],["狂风何事相摇荡，","吹向南山复北山。"]]}
{"id":"c5d90304f1","title":"明月夜留别","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["离人无语月无声，","明月有光人有情。","别后相思人似月，","云间水上到层城。"],"stanzas":[["离人无语月无声，","明月有光人有情。"],["别后相思人似月，","云间水上到层城。"]]}
{"id":"a97b1db5c8","title":"春闺怨","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百尺井栏上，","数株桃已红。","念君辽海北，","抛妾宋家东。"],"stanzas":[["百尺井栏上，","数株桃已红。"],["念君辽海北，","抛妾宋家东。"]]}
{"id":"17e814ba35","title":"句","author":"李冶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["经时未架却，","心绪乱纵横。","已看云鬓散，","更念木枯荣。","鞞鼓喧行选，","旌旗拂座隅。","不覩河阳一县花，","空见青山三两点。"],"stanzas":[["经时未架却，","心绪乱纵横。"],["已看云鬓散，","更念木枯荣。"],["鞞鼓喧行选，","旌旗拂座隅。"],["不覩河阳一县花，","空见青山三两点。"]]}
{"id":"825b9fbcc9","title":"寄洛中诸姊","author":"元淳","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["旧国经年别，","关河万里思。","题诗凭鴈翼，","望月想蛾眉。","白发愁偏觉，","归心梦独知。","谁堪离乱处，","掩泪向南枝。"],"stanzas":[["旧国经年别，","关河万里思。"],["题诗凭鴈翼，","望月想蛾眉。"],["白发愁偏觉，","归心梦独知。"],["谁堪离乱处，","掩泪向南枝。"]]}
{"id":"0ef016bacb","title":"秦中春望","author":"元淳","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤楼春望好，","宫阙一重重。","上苑雨中树，","终南霁后峰。","落花行处徧，","佳气晚来浓。","喜见休明代，","霓裳蹑道踪。"],"stanzas":[["凤楼春望好，","宫阙一重重。"],["上苑雨中树，","终南霁后峰。"],["落花行处徧，","佳气晚来浓。"],["喜见休明代，","霓裳蹑道踪。"]]}
{"id":"64a03a94b2","title":"句","author":"元淳","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弟兄俱已尽，","松柏问何人。","闻道茂陵山水好，","碧溪流水有桃源。","赤城峭壁无人到，","丹灶芝田有鹤来。","三千宫女露蛾眉，","笑煮黄金日月迟。"],"stanzas":[["弟兄俱已尽，","松柏问何人。"],["闻道茂陵山水好，","碧溪流水有桃源。"],["赤城峭壁无人到，","丹灶芝田有鹤来。"],["三千宫女露蛾眉，","笑煮黄金日月迟。"]]}
{"id":"6257dfb7d3","title":"舟夜一章","author":"海印","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水色连天色，","风声益浪声。","旅人归思苦，","渔叟梦魂惊。","举棹云先到，","移舟月逐行。","旋吟诗句罢，","犹见远山横。"],"stanzas":[["水色连天色，","风声益浪声。"],["旅人归思苦，","渔叟梦魂惊。"],["举棹云先到，","移舟月逐行。"],["旋吟诗句罢，","犹见远山横。"]]}
{"id":"00241503c6","title":"诗三百三首 一","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凡读我诗者，","心中须护净。","悭贪继日廉，","谄曲登时正。","驱遣除恶业，","归依受真性。","今日得佛身，","急急如律令。"],"stanzas":[["凡读我诗者，","心中须护净。"],["悭贪继日廉，","谄曲登时正。"],["驱遣除恶业，","归依受真性。"],["今日得佛身，","急急如律令。"]]}
{"id":"747047d013","title":"诗三百三首 二","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重岩我卜居，","鸟道绝人迹。","庭际何所有，","白云抱幽石。","住兹凡几年，","屡见春冬易。","寄语钟鼎家，","虚名定无益。"],"stanzas":[["重岩我卜居，","鸟道绝人迹。"],["庭际何所有，","白云抱幽石。"],["住兹凡几年，","屡见春冬易。"],["寄语钟鼎家，","虚名定无益。"]]}
{"id":"0919475fcf","title":"诗三百三首 三","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可笑寒山道，","而无车马踪。","联溪难记曲，","叠嶂不知重。","泣露千般草，","吟风一样松。","此时迷径处，","形问影何从。"],"stanzas":[["可笑寒山道，","而无车马踪。"],["联溪难记曲，","叠嶂不知重。"],["泣露千般草，","吟风一样松。"],["此时迷径处，","形问影何从。"]]}
{"id":"55d236e07a","title":"诗三百三首 四","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吾家好隐沦，","居处绝嚣尘。","践草成三径，","瞻云作四邻。","助歌声有鸟，","问法语无人。","今日娑婆树，","几年为一春。"],"stanzas":[["吾家好隐沦，","居处绝嚣尘。"],["践草成三径，","瞻云作四邻。"],["助歌声有鸟，","问法语无人。"],["今日娑婆树，","几年为一春。"]]}
{"id":"379813e1f3","title":"诗三百三首 五","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琴书须自随，","禄位用何为。","投辇从贤妇，","巾车有孝儿。","风吹曝麦地，","水溢沃鱼池。","常念鹪鹩鸟，","安身在一枝。"],"stanzas":[["琴书须自随，","禄位用何为。"],["投辇从贤妇，","巾车有孝儿。"],["风吹曝麦地，","水溢沃鱼池。"],["常念鹪鹩鸟，","安身在一枝。"]]}
{"id":"ac67e452e1","title":"诗三百三首 六","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弟兄同五郡，","父子本三州。","欲验飞凫集，","须征白兔游。","灵瓜梦里受，","神橘座中收。","乡国何迢遰，","同鱼寄水流。"],"stanzas":[["弟兄同五郡，","父子本三州。"],["欲验飞凫集，","须征白兔游。"],["灵瓜梦里受，","神橘座中收。"],["乡国何迢遰，","同鱼寄水流。"]]}
{"id":"6e86014e01","title":"诗三百三首 七","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一为书劒客，","二遇圣明君。","东守文不赏，","西征武不勋。","学文兼学武，","学武兼学文。","今日既老矣，","余生不足云。"],"stanzas":[["一为书劒客，","二遇圣明君。"],["东守文不赏，","西征武不勋。"],["学文兼学武，","学武兼学文。"],["今日既老矣，","余生不足云。"]]}
{"id":"ce30e1c728","title":"诗三百三首 八","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庄子说送终，","天地为棺椁。","吾归此有时，","唯须一番箔。","死将餧青蝇，","吊不劳白鹤。","饿著首阳山，","生廉死亦乐。"],"stanzas":[["庄子说送终，","天地为棺椁。"],["吾归此有时，","唯须一番箔。"],["死将餧青蝇，","吊不劳白鹤。"],["饿著首阳山，","生廉死亦乐。"]]}
{"id":"5e8161c81f","title":"诗三百三首 九","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人问寒山道，","寒山路不通。","夏天冰未释，","日出雾朦胧。","似我何由届，","与君心不同。","君心若似我，","还得到其中。"],"stanzas":[["人问寒山道，","寒山路不通。"],["夏天冰未释，","日出雾朦胧。"],["似我何由届，","与君心不同。"],["君心若似我，","还得到其中。"]]}
{"id":"392f7aef34","title":"诗三百三首 十","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天生百尺树，","翦作长条木。","可惜栋梁材，","抛之在幽谷。","年多心尚劲，","日久皮渐秃。","识者取将来，","犹堪柱马屋。"],"stanzas":[["天生百尺树，","翦作长条木。"],["可惜栋梁材，","抛之在幽谷。"],["年多心尚劲，","日久皮渐秃。"],["识者取将来，","犹堪柱马屋。"]]}
{"id":"c69e23d1db","title":"诗三百三首 十一","author":"寒山","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["驱马度荒城，","荒城动客情。","高低旧雉堞，","大小古坟茔。","自振孤蓬影，","长凝拱木声。","所嗟皆俗骨，","仙史更无名。"],"stanzas":[["驱马度荒城，","荒城动客情。"],["高低旧雉堞，","大小古坟茔。"],["自振孤蓬影，","长凝拱木声。"],["所嗟皆俗骨，","仙史更无名。"]]}
