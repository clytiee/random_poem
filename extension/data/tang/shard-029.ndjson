{"id":"5f94ec8b6a","title":"听山鹧鸪","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁家无春酒，","何处无春鸟。","夜宿桃花村，","踏歌接天晓。"],"stanzas":[["谁家无春酒，","何处无春鸟。"],["夜宿桃花村，","踏歌接天晓。"]]}
{"id":"516c5626a7","title":"山径柳","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宛转若游丝，","浅深栽绿崦。","年年立春后，","即被啼莺占。"],"stanzas":[["宛转若游丝，","浅深栽绿崦。"],["年年立春后，","即被啼莺占。"]]}
{"id":"9f7b563b53","title":"石上藤","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["空山无鸟迹，","何物如人意。","委曲结绳文，","离披草书字。"],"stanzas":[["空山无鸟迹，","何物如人意。"],["委曲结绳文，","离披草书字。"]]}
{"id":"6eb8adf459","title":"薜荔庵","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["薜荔作禅庵，","重叠庵边树。","空山径欲绝，","也有人知处。"],"stanzas":[["薜荔作禅庵，","重叠庵边树。"],["空山径欲绝，","也有人知处。"]]}
{"id":"0a8049d707","title":"芙蓉榭","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风摆莲衣干，","月背鸟巢寒。","文鱼翻乱叶，","翠羽上危栏。"],"stanzas":[["风摆莲衣干，","月背鸟巢寒。"],["文鱼翻乱叶，","翠羽上危栏。"]]}
{"id":"e956360b9f","title":"欹松漪","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湛湛碧涟漪，","老松欹侧卧。","悠扬绿萝影，","下拂波纹破。"],"stanzas":[["湛湛碧涟漪，","老松欹侧卧。"],["悠扬绿萝影，","下拂波纹破。"]]}
{"id":"feac5f5880","title":"焙茶坞","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新茶已上焙，","旧架忧生醭。","旋旋续新烟，","呼儿劈寒木。"],"stanzas":[["新茶已上焙，","旧架忧生醭。"],["旋旋续新烟，","呼儿劈寒木。"]]}
{"id":"cbfce44149","title":"弹琴谷","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谷中谁弹琴，","琴响谷冥寂。","因君扣商调，","草虫惊暗壁。"],"stanzas":[["谷中谁弹琴，","琴响谷冥寂。"],["因君扣商调，","草虫惊暗壁。"]]}
{"id":"a3e3a9b4f9","title":"白鹭汀","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["靃靡汀草碧，","淋森鹭毛白。","夜起沙月中，","思量捕鱼策。"],"stanzas":[["靃靡汀草碧，","淋森鹭毛白。"],["夜起沙月中，","思量捕鱼策。"]]}
{"id":"993428b5a1","title":"千松岭","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["终日吟天风，","有时天籁止。","问渠何旨意，","恐落凡人耳。"],"stanzas":[["终日吟天风，","有时天籁止。"],["问渠何旨意，","恐落凡人耳。"]]}
{"id":"c49e958cf4","title":"黄菊湾","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["时菊凝晓露，","露华滴秋湾。","仙人酿酒熟，","醉里飞空山。"],"stanzas":[["时菊凝晓露，","露华滴秋湾。"],["仙人酿酒熟，","醉里飞空山。"]]}
{"id":"376f97c80a","title":"临平湖","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["采藕平湖上，","藕泥封藕节。","船影入荷香，","莫冲莲柄折。"],"stanzas":[["采藕平湖上，","藕泥封藕节。"],["船影入荷香，","莫冲莲柄折。"]]}
{"id":"20debf40a1","title":"山春洞","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["引烛踏仙泥，","时时乱乳燕。","不知何道士，","手把灵书卷。"],"stanzas":[["引烛踏仙泥，","时时乱乳燕。"],["不知何道士，","手把灵书卷。"]]}
{"id":"eb6935ccba","title":"石窦泉","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吹沙复喷石，","曲折仍圆旋。","野客漱流时，","杯黏落花片。"],"stanzas":[["吹沙复喷石，","曲折仍圆旋。"],["野客漱流时，","杯黏落花片。"]]}
{"id":"daf967791d","title":"古仙坛","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远山谁放烧，","疑是坛边醮。","仙人错下山，","拍手坛边笑。"],"stanzas":[["远山谁放烧，","疑是坛边醮。"],["仙人错下山，","拍手坛边笑。"]]}
{"id":"308fe0d93b","title":"题山顶寺","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["遥闻林下语，","知是经行所。","日暮香风时，","诸天散花雨。"],"stanzas":[["遥闻林下语，","知是经行所。"],["日暮香风时，","诸天散花雨。"]]}
{"id":"5cb56a1e51","title":"天宝题壁","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五十余年别，","伶俜道不行。","却来书处在，","惆怅似前生。"],"stanzas":[["五十余年别，","伶俜道不行。"],["却来书处在，","惆怅似前生。"]]}
{"id":"8e1816b8c4","title":"哭李别驾","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故人行迹灭，","秋草向南悲。","不欲频回步，","孀妻正哭时。"],"stanzas":[["故人行迹灭，","秋草向南悲。"],["不欲频回步，","孀妻正哭时。"]]}
{"id":"564e265f30","title":"春雨不闻百舌","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百舌春来哑，","愁人共待晴。","不关秋水事，","饮恨亦无声。"],"stanzas":[["百舌春来哑，","愁人共待晴。"],["不关秋水事，","饮恨亦无声。"]]}
{"id":"b243a8500c","title":"忆鄱阳旧游","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悠悠南国思，","夜向江南泊。","楚客断肠时，","月明枫子落。"],"stanzas":[["悠悠南国思，","夜向江南泊。"],["楚客断肠时，","月明枫子落。"]]}
{"id":"a80302094d","title":"春怀","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["园莺啼已倦，","树树陨香红。","不是春相背，","当由己自翁。"],"stanzas":[["园莺啼已倦，","树树陨香红。"],["不是春相背，","当由己自翁。"]]}
{"id":"e2d72f0b98","title":"洛阳陌二首 一","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莺声满御隄，","隄柳拂丝齐。","风送名花落，","香红衬马蹄。"],"stanzas":[["莺声满御隄，","隄柳拂丝齐。"],["风送名花落，","香红衬马蹄。"]]}
{"id":"0fec90e47b","title":"洛阳陌二首 二","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珂珮逐鸣驺，","王孙结伴游。","金丸落飞鸟，","乘兴醉青楼。"],"stanzas":[["珂珮逐鸣驺，","王孙结伴游。"],["金丸落飞鸟，","乘兴醉青楼。"]]}
{"id":"737a5b9961","title":"寄淮上柳十三","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苇萧中辟户，","相映绿淮流。","莫讶春潮阔，","鸥边可泊舟。"],"stanzas":[["苇萧中辟户，","相映绿淮流。"],["莫讶春潮阔，","鸥边可泊舟。"]]}
{"id":"93b25efddf","title":"送李泌","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔别吴堤雨，","春帆去较迟。","江波千里绿，","囗囗囗囗囗。"],"stanzas":[["昔别吴堤雨，","春帆去较迟。"],["江波千里绿，","囗囗囗囗囗。"]]}
{"id":"15014e5af0","title":"山中夜宿","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凉月挂层峰，","萝林落叶重。","掩关深畏虎，","风起撼长松。"],"stanzas":[["凉月挂层峰，","萝林落叶重。"],["掩关深畏虎，","风起撼长松。"]]}
{"id":"edfd6f316b","title":"登楼","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高阁成长望，","江流雁呌哀。","凄凉故吴事，","麋鹿走荒台。"],"stanzas":[["高阁成长望，","江流雁呌哀。"],["凄凉故吴事，","麋鹿走荒台。"]]}
{"id":"11fb355e32","title":"江上","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江清白鸟斜，","荡桨罥苹花。","听唱菱歌晚，","回塘月照沙。"],"stanzas":[["江清白鸟斜，","荡桨罥苹花。"],["听唱菱歌晚，","回塘月照沙。"]]}
{"id":"fff63e468b","title":"溪上","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["采莲溪上女，","舟小怯摇风。","惊起鸳鸯宿，","水云撩乱红。"],"stanzas":[["采莲溪上女，","舟小怯摇风。"],["惊起鸳鸯宿，","水云撩乱红。"]]}
{"id":"56030bacee","title":"田家","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["带水摘禾穗，","夜捣具晨炊。","县帖取社长，","嗔怪见官迟。"],"stanzas":[["带水摘禾穗，","夜捣具晨炊。"],["县帖取社长，","嗔怪见官迟。"]]}
{"id":"a92cd9d3e2","title":"宿山中僧","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不爇香炉烟，","蒲团坐如铁。","尝想同夜禅，","风堕松顶雪。"],"stanzas":[["不爇香炉烟，","蒲团坐如铁。"],["尝想同夜禅，","风堕松顶雪。"]]}
{"id":"0f69fac72a","title":"梅湾","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白石盘盘磴，","清香树树梅。","山深不吟赏，","[辜]负委苍苔。"],"stanzas":[["白石盘盘磴，","清香树树梅。"],["山深不吟赏，","[辜]负委苍苔。"]]}
{"id":"226537b56a","title":"思归","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不能经纶大经，","甘作草莽闲臣。","青[琐]应须长别，","白云漫与相亲。"],"stanzas":[["不能经纶大经，","甘作草莽闲臣。"],["青[琐]应须长别，","白云漫与相亲。"]]}
{"id":"491462ce01","title":"归山作","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心事数茎白发，","生涯一片青山。","空林有雪相待，","古道无人独还。"],"stanzas":[["心事数茎白发，","生涯一片青山。"],["空林有雪相待，","古道无人独还。"]]}
{"id":"a87dfcf7a6","title":"过山农家","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["板桥人渡泉声，","茆簷日午鸡鸣。","莫嗔焙茶烟暗，","却喜晒谷天晴。"],"stanzas":[["板桥人渡泉声，","茆簷日午鸡鸣。"],["莫嗔焙茶烟暗，","却喜晒谷天晴。"]]}
{"id":"90a88bcd85","title":"代佳人赠别","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里行人欲渡溪，","千行珠泪滴为泥。","已成残梦随君去，","犹有惊乌半夜啼。"],"stanzas":[["万里行人欲渡溪，","千行珠泪滴为泥。"],["已成残梦随君去，","犹有惊乌半夜啼。"]]}
{"id":"ca1177c2a8","title":"忆故园","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惆怅多山人复稀，","杜鹃啼处泪沾衣。","故园此去千余里，","春梦犹能夜夜归。"],"stanzas":[["惆怅多山人复稀，","杜鹃啼处泪沾衣。"],["故园此去千余里，","春梦犹能夜夜归。"]]}
{"id":"915d46d127","title":"题叶道士山房","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水边垂柳赤栏桥，","洞里仙人碧玉箫。","近得麻姑音信否，","浔阳江上不通潮。"],"stanzas":[["水边垂柳赤栏桥，","洞里仙人碧玉箫。"],["近得麻姑音信否，","浔阳江上不通潮。"]]}
{"id":"4dbe09cef1","title":"送李秀才入京","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五湖秋叶满行船，","八月灵槎欲上天。","君向长安余适越，","独登秦望望秦川。"],"stanzas":[["五湖秋叶满行船，","八月灵槎欲上天。"],["君向长安余适越，","独登秦望望秦川。"]]}
{"id":"bdc71040f0","title":"越中席上看弄老人","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不到山阴十二春，","镜中相见白头新。","此生不复为年少，","今日从他弄老人。"],"stanzas":[["不到山阴十二春，","镜中相见白头新。"],["此生不复为年少，","今日从他弄老人。"]]}
{"id":"3392d97a58","title":"听刘安唱歌","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子夜新声何处传，","悲翁更忆太平年。","即今法曲无人唱，","已逐霓裳飞上天。"],"stanzas":[["子夜新声何处传，","悲翁更忆太平年。"],["即今法曲无人唱，","已逐霓裳飞上天。"]]}
{"id":"304fe86aca","title":"樱桃曲","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百舌犹来上苑花，","游人独自忆京华。","遥知寝庙尝新后，","敕赐樱桃向几家。"],"stanzas":[["百舌犹来上苑花，","游人独自忆京华。"],["遥知寝庙尝新后，","敕赐樱桃向几家。"]]}
{"id":"f9fe7bcb5e","title":"山中","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野人爱向山中宿，","况在葛洪丹井西。","庭前有个长松树，","夜半子规来上啼。"],"stanzas":[["野人爱向山中宿，","况在葛洪丹井西。"],["庭前有个长松树，","夜半子规来上啼。"]]}
{"id":"1f03bf8c54","title":"赠朱放","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野客归时无四邻，","黔娄别久案常贫。","渔樵旧路不堪入，","何处空山犹有人。"],"stanzas":[["野客归时无四邻，","黔娄别久案常贫。"],["渔樵旧路不堪入，","何处空山犹有人。"]]}
{"id":"d53832df8b","title":"江村乱后","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江村日暮寻遗老，","江水东流横浩浩。","竹里闲窗不见人，","门前旧路生青草。"],"stanzas":[["江村日暮寻遗老，","江水东流横浩浩。"],["竹里闲窗不见人，","门前旧路生青草。"]]}
{"id":"f12e1e89c7","title":"望简寂观","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青嶂青溪直复斜，","白鸡白犬到人家。","仙人住在最高处，","向晚春泉流白花。"],"stanzas":[["青嶂青溪直复斜，","白鸡白犬到人家。"],["仙人住在最高处，","向晚春泉流白花。"]]}
{"id":"68a5c4b359","title":"五两歌送张夏","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竿头五两风褭褭，","水上云帆逐飞鸟。","送君初出扬州时，","霭霭曈曈江溢晓。"],"stanzas":[["竿头五两风褭褭，","水上云帆逐飞鸟。"],["送君初出扬州时，","霭霭曈曈江溢晓。"]]}
{"id":"ec90c54bd7","title":"临海所居三首 一","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此是昔年征战处，","曾经永日绝人行。","千家寂寂对流水，","唯有汀洲春草生。"],"stanzas":[["此是昔年征战处，","曾经永日绝人行。"],["千家寂寂对流水，","唯有汀洲春草生。"]]}
{"id":"6e77f7821d","title":"临海所居三首 二","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此去临溪不是遥，","楼中望见赤城标。","不知叠嶂重霞里，","更有何人度石桥。"],"stanzas":[["此去临溪不是遥，","楼中望见赤城标。"],["不知叠嶂重霞里，","更有何人度石桥。"]]}
{"id":"867964c4ad","title":"临海所居三首 三","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家在双峰兰若边，","一声秋磬发孤烟。","山连极浦鸟飞尽，","月上青林人未眠。"],"stanzas":[["家在双峰兰若边，","一声秋磬发孤烟。"],["山连极浦鸟飞尽，","月上青林人未眠。"]]}
{"id":"5444839812","title":"听角思归","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故园黄叶满青苔，","梦后城头晓角哀。","此夜断肠人不见，","起行残日影徘徊。"],"stanzas":[["故园黄叶满青苔，","梦后城头晓角哀。"],["此夜断肠人不见，","起行残日影徘徊。"]]}
{"id":"db4b080f71","title":"酬柳相公","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天下如今已太平，","相公何事唤狂生。","个身恰似笼中鹤，","东望沧溟呌数声。"],"stanzas":[["天下如今已太平，","相公何事唤狂生。"],["个身恰似笼中鹤，","东望沧溟呌数声。"]]}
{"id":"6faec8460c","title":"题明霞台","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野人本自不求名，","欲向山中过一生。","莫嫌憔悴无知己，","别有烟霞似弟兄。"],"stanzas":[["野人本自不求名，","欲向山中过一生。"],["莫嫌憔悴无知己，","别有烟霞似弟兄。"]]}
{"id":"237757b2f5","title":"哭绚法师","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚客停桡欲问谁，","白沙江草曲尘丝。","生公手种殿前树，","唯有花开鶗鴂悲。"],"stanzas":[["楚客停桡欲问谁，","白沙江草曲尘丝。"],["生公手种殿前树，","唯有花开鶗鴂悲。"]]}
{"id":"81d568cd75","title":"送柳宜城葬","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸣笳已逐春风咽，","匹马犹依旧路嘶。","遥望柳家门外树，","恐闻黄鸟向人啼。"],"stanzas":[["鸣笳已逐春风咽，","匹马犹依旧路嘶。"],["遥望柳家门外树，","恐闻黄鸟向人啼。"]]}
{"id":"2cdd920630","title":"宫词五首 一","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["禁柳烟中闻晓乌，","风吹玉漏尽铜壶。","内官先向蓬莱殿，","金合开香泻御𬬻。"],"stanzas":[["禁柳烟中闻晓乌，","风吹玉漏尽铜壶。"],["内官先向蓬莱殿，","金合开香泻御𬬻。"]]}
{"id":"b9a3708e67","title":"宫词五首 二","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉楼天半起笙歌，","风送宫嫔笑语和。","月殿影开闻夜漏，","水精帘卷近银河。"],"stanzas":[["玉楼天半起笙歌，","风送宫嫔笑语和。"],["月殿影开闻夜漏，","水精帘卷近银河。"]]}
{"id":"c3ec68a832","title":"宫词五首 三","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉阶容卫宿千官，","风猎青旗晓仗寒。","侍女先来荐琼蘂，","露浆新下九霄盘。"],"stanzas":[["玉阶容卫宿千官，","风猎青旗晓仗寒。"],["侍女先来荐琼蘂，","露浆新下九霄盘。"]]}
{"id":"eb3838e0f4","title":"宫词五首 四","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九重天乐降神仙，","步舞分行踏锦筵。","嘈囋一声钟鼓歇，","万人楼下拾金钱。"],"stanzas":[["九重天乐降神仙，","步舞分行踏锦筵。"],["嘈囋一声钟鼓歇，","万人楼下拾金钱。"]]}
{"id":"fa214ea8c8","title":"宫词五首 五","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金吾持戟护新簷，","天乐声传万姓瞻。","楼上美人相倚看，","红妆透出水精帘。"],"stanzas":[["金吾持戟护新簷，","天乐声传万姓瞻。"],["楼上美人相倚看，","红妆透出水精帘。"]]}
{"id":"7d0144b101","title":"寻桃花岭潘三姑台","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桃花岭上觉天低，","人上青山马隔溪。","行到三姑学仙处，","还有刘阮二郎迷。"],"stanzas":[["桃花岭上觉天低，","人上青山马隔溪。"],["行到三姑学仙处，","还有刘阮二郎迷。"]]}
{"id":"6df669ef70","title":"夜中望仙观","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日暮衔花飞鸟还，","月明溪上见青山。","遥知玉女窗前树，","不是仙人不得攀。"],"stanzas":[["日暮衔花飞鸟还，","月明溪上见青山。"],["遥知玉女窗前树，","不是仙人不得攀。"]]}
{"id":"4ff88cbcd1","title":"送李侍御往吴兴","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世间只有情难说，","今夜应无不醉人。","若向洞庭山下过，","暗知浇沥圣姑神。"],"stanzas":[["世间只有情难说，","今夜应无不醉人。"],["若向洞庭山下过，","暗知浇沥圣姑神。"]]}
{"id":"d0d8c7521f","title":"奉和韩晋公晦日呈诸判官","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江南无处不闻歌，","晦日中军乐更多。","不是风光催柳色，","却缘威令动阳和。"],"stanzas":[["江南无处不闻歌，","晦日中军乐更多。"],["不是风光催柳色，","却缘威令动阳和。"]]}
{"id":"e6803414c5","title":"子规","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杜宇冤亡积有时，","年年啼血动人悲。","若教恨魄皆能化，","何树何山着子规。"],"stanzas":[["杜宇冤亡积有时，","年年啼血动人悲。"],["若教恨魄皆能化，","何树何山着子规。"]]}
{"id":"6b3b23266c","title":"海鸥咏","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里飞来为客鸟，","曾蒙丹凤借枝柯。","一朝凤去梧桐死，","满目鸱鸢奈尔何。"],"stanzas":[["万里飞来为客鸟，","曾蒙丹凤借枝柯。"],["一朝凤去梧桐死，","满目鸱鸢奈尔何。"]]}
{"id":"d17c4ccbd2","title":"赠韦清将军","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["身执金吾主禁兵，","腰间宝剑重横行。","接舆亦是狂歌者，","更就将军乞一声。"],"stanzas":[["身执金吾主禁兵，","腰间宝剑重横行。"],["接舆亦是狂歌者，","更就将军乞一声。"]]}
{"id":"4384ceb4b3","title":"赠僧二首 一","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["家住义兴东舍溪，","溪边莎草雨无泥。","上人一向心入定，","春鸟年年空自啼。"],"stanzas":[["家住义兴东舍溪，","溪边莎草雨无泥。"],["上人一向心入定，","春鸟年年空自啼。"]]}
{"id":"6603a62490","title":"赠僧二首 二","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["出头皆是新年少，","何处能容老病翁。","更把浮荣喻生灭，","世间无事不虚空。"],"stanzas":[["出头皆是新年少，","何处能容老病翁。"],["更把浮荣喻生灭，","世间无事不虚空。"]]}
{"id":"f884bacec5","title":"登楼望水","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸟啼花发柳含烟，","掷却风光忆少年。","更上高楼望江水，","故乡何处一归船。"],"stanzas":[["鸟啼花发柳含烟，","掷却风光忆少年。"],["更上高楼望江水，","故乡何处一归船。"]]}
{"id":"154b5ef4f7","title":"湖中","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["青草湖边日色低，","黄茅嶂里鹧鸪啼。","丈夫飘荡今如此，","一曲长歌楚水西。"],"stanzas":[["青草湖边日色低，","黄茅嶂里鹧鸪啼。"],["丈夫飘荡今如此，","一曲长歌楚水西。"]]}
{"id":"5e90d03c07","title":"岁日作","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不觉老将春共至，","更悲携手几人全。","还丹寂寞羞明镜，","手把屠苏让少年。"],"stanzas":[["不觉老将春共至，","更悲携手几人全。"],["还丹寂寞羞明镜，","手把屠苏让少年。"]]}
{"id":"cdf2c7aedb","title":"山中赠客","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山中好处无人别，","涧梅伪作山中雪。","野客相逢夜不眠，","山中童子烧松节。"],"stanzas":[["山中好处无人别，","涧梅伪作山中雪。"],["野客相逢夜不眠，","山中童子烧松节。"]]}
{"id":"cc8ca535d4","title":"王郎中妓席五咏 箜篌","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉作搔头金步摇，","高张苦调响连宵。","欲知写尽相思梦，","度水寻云不用桥。"],"stanzas":[["玉作搔头金步摇，","高张苦调响连宵。"],["欲知写尽相思梦，","度水寻云不用桥。"]]}
{"id":"12528afb6b","title":"王郎中妓席五咏 舞","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汗浥新装画不成，","丝催急节舞衣轻。","落花绕树疑无影，","回雪从风暗有情。"],"stanzas":[["汗浥新装画不成，","丝催急节舞衣轻。"],["落花绕树疑无影，","回雪从风暗有情。"]]}
{"id":"f693402614","title":"王郎中妓席五咏 歌","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳拂青楼花满衣，","能歌宛转世应稀。","空中几处闻清响，","欲绕行云不遣飞。"],"stanzas":[["柳拂青楼花满衣，","能歌宛转世应稀。"],["空中几处闻清响，","欲绕行云不遣飞。"]]}
{"id":"a3b5f74e81","title":"王郎中妓席五咏 筝","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦声楚调怨无穷，","陇水胡笳咽复通。","莫遣黄莺花里啭，","参差撩乱妬春风。"],"stanzas":[["秦声楚调怨无穷，","陇水胡笳咽复通。"],["莫遣黄莺花里啭，","参差撩乱妬春风。"]]}
{"id":"d938c7d8d5","title":"王郎中妓席五咏 笙","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲写人间离别心，","须听鸣凤似龙吟。","江南曲尽归何处，","洞水山云知浅深。"],"stanzas":[["欲写人间离别心，","须听鸣凤似龙吟。"],["江南曲尽归何处，","洞水山云知浅深。"]]}
{"id":"e781d73060","title":"送李山人还玉溪","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好鸟共鸣临水树，","幽人独欠买山钱。","若为种得千竿竹，","引取君家一眼泉。"],"stanzas":[["好鸟共鸣临水树，","幽人独欠买山钱。"],["若为种得千竿竹，","引取君家一眼泉。"]]}
{"id":"0a91bf8983","title":"送少微上人还鹿门","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少微不向吴中隐，","为个生缘在鹿门。","行入汉江秋月色，","襄阳耆旧几人存。"],"stanzas":[["少微不向吴中隐，","为个生缘在鹿门。"],["行入汉江秋月色，","襄阳耆旧几人存。"]]}
{"id":"7d5ce9091c","title":"宿昭应","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武帝祈灵太乙坛，","新丰树色绕千官。","那知今夜长生殿，","独闭山门月影寒。"],"stanzas":[["武帝祈灵太乙坛，","新丰树色绕千官。"],["那知今夜长生殿，","独闭山门月影寒。"]]}
{"id":"aaa8993b54","title":"题琅邪上方","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东晋王家在此溪，","南朝树色隔窗低。","碑沈字灭昔人远，","谷鸟犹向寒花啼。"],"stanzas":[["东晋王家在此溪，","南朝树色隔窗低。"],["碑沈字灭昔人远，","谷鸟犹向寒花啼。"]]}
{"id":"08d8f99200","title":"安仁港口望仙人城","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼台采翠远分明，","闻说仙家在此城。","欲上仙城无路上，","水边花里有人声。"],"stanzas":[["楼台采翠远分明，","闻说仙家在此城。"],["欲上仙城无路上，","水边花里有人声。"]]}
{"id":"2f9f1978b7","title":"寄秘书包监","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一别长安路几千，","遥知旧日主人怜。","贾生只是三年谪，","独自无才已四年。"],"stanzas":[["一别长安路几千，","遥知旧日主人怜。"],["贾生只是三年谪，","独自无才已四年。"]]}
{"id":"68bf7141d6","title":"小孤山","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古庙枫林江水边，","寒鸦接饭雁横天。","大孤山远小孤出，","月照洞庭归客船。"],"stanzas":[["古庙枫林江水边，","寒鸦接饭雁横天。"],["大孤山远小孤出，","月照洞庭归客船。"]]}
{"id":"1152fbb74b","title":"送李秀才游嵩山","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["嵩山石壁挂飞流，","无限神仙在上头。","采得新诗题石壁，","老人惆怅不同游。"],"stanzas":[["嵩山石壁挂飞流，","无限神仙在上头。"],["采得新诗题石壁，","老人惆怅不同游。"]]}
{"id":"f0f2b2afb4","title":"从剡溪至赤城","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵溪宿处接灵山，","窈映高楼向月闲。","夜半鹤声残梦里，","犹疑琴曲洞房闲。"],"stanzas":[["灵溪宿处接灵山，","窈映高楼向月闲。"],["夜半鹤声残梦里，","犹疑琴曲洞房闲。"]]}
{"id":"f0229668b4","title":"叶上题诗从苑中流出","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花落深宫莺亦悲，","上阳宫女断肠时。","君恩不闭东流水，","叶上题诗寄与谁。"],"stanzas":[["花落深宫莺亦悲，","上阳宫女断肠时。"],["君恩不闭东流水，","叶上题诗寄与谁。"]]}
{"id":"c998d80e9e","title":"崦里桃花","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["崦里桃花逢女冠，","林间杏叶落仙坛。","老人方授上清箓，","夜听步虚山月寒。"],"stanzas":[["崦里桃花逢女冠，","林间杏叶落仙坛。"],["老人方授上清箓，","夜听步虚山月寒。"]]}
{"id":"c1d7f8df93","title":"听子规","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["栖霞山中子规鸟，","口边血出啼不了。","山僧后夜初出定，","闻似不闻山月晓。"],"stanzas":[["栖霞山中子规鸟，","口边血出啼不了。"],["山僧后夜初出定，","闻似不闻山月晓。"]]}
{"id":"258cd47247","title":"竹枝曲","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["帝子苍梧不复归，","洞庭叶下荆云飞。","巴人夜唱竹枝后，","肠断晓猿声渐稀。"],"stanzas":[["帝子苍梧不复归，","洞庭叶下荆云飞。"],["巴人夜唱竹枝后，","肠断晓猿声渐稀。"]]}
{"id":"54fd64f275","title":"寻僧二首 一","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["方丈玲珑花竹闲，","已将心印出人闲。","家家门外长安道，","何处相逢是宝山。"],"stanzas":[["方丈玲珑花竹闲，","已将心印出人闲。"],["家家门外长安道，","何处相逢是宝山。"]]}
{"id":"f9127fcff1","title":"寻僧二首 二","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弥天释子本高情，","往往山中独自行。","莫怪狂人游楚国，","莲花只在淤泥生。"],"stanzas":[["弥天释子本高情，","往往山中独自行。"],["莫怪狂人游楚国，","莲花只在淤泥生。"]]}
{"id":"122fb6b1f2","title":"桃花曲","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魏帝宫人舞凤楼，","隋家天子泛龙舟。","君王夜醉春眠晏，","不觉桃花逐水流。"],"stanzas":[["魏帝宫人舞凤楼，","隋家天子泛龙舟。"],["君王夜醉春眠晏，","不觉桃花逐水流。"]]}
{"id":"6636d96659","title":"赠远","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暂出河边思远道，","却来窗下听新莺。","故人一别几时见，","春草还从旧处生。"],"stanzas":[["暂出河边思远道，","却来窗下听新莺。"],["故人一别几时见，","春草还从旧处生。"]]}
{"id":"fa4d39e098","title":"早春思归有唱竹枝歌者坐中下泪","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渺渺春生楚水波，","楚人齐唱竹枝歌。","与君皆是思归客，","拭泪看花奈老何。"],"stanzas":[["渺渺春生楚水波，","楚人齐唱竹枝歌。"],["与君皆是思归客，","拭泪看花奈老何。"]]}
{"id":"f6956faf76","title":"送郭秀才","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故人曾任丹徒令，","买得青山拟独耕。","不作草堂招远客，","却将垂柳借啼莺。"],"stanzas":[["故人曾任丹徒令，","买得青山拟独耕。"],["不作草堂招远客，","却将垂柳借啼莺。"]]}
{"id":"b99ab332d8","title":"宫词","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长乐宫连上苑春，","玉楼金殿艳歌新。","君门一入无由出，","唯有宫莺得见人。"],"stanzas":[["长乐宫连上苑春，","玉楼金殿艳歌新。"],["君门一入无由出，","唯有宫莺得见人。"]]}
{"id":"5317c74d5e","title":"悼稚","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["稚子比来骑竹马，","犹疑只在屋东西。","莫言道者无悲事，","曾听巴猿向月啼。"],"stanzas":[["稚子比来骑竹马，","犹疑只在屋东西。"],["莫言道者无悲事，","曾听巴猿向月啼。"]]}
{"id":"274af83413","title":"山僧兰若","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绝顶茅庵老此生，","寒云孤木伴经行。","世人那得知幽径，","遥向青峰礼磬声。"],"stanzas":[["绝顶茅庵老此生，","寒云孤木伴经行。"],["世人那得知幽径，","遥向青峰礼磬声。"]]}
{"id":"5f37fc36c9","title":"句","author":"顾况","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["崦合桃花水，","窗鸣柳谷泉。","颓垣化为陂，","陆地堪乘舟。","汀洲渺渺江篱短，","疑是疑非两断肠。","巫峡朝云暮不归，","洞庭春水晴空满。","龙吟四泽欲兴雨，","凤引九雏警宿乌。","新妇矶边月明，","女儿浦口潮平。"],"stanzas":[["崦合桃花水，","窗鸣柳谷泉。"],["颓垣化为陂，","陆地堪乘舟。"],["汀洲渺渺江篱短，","疑是疑非两断肠。"],["巫峡朝云暮不归，","洞庭春水晴空满。"],["龙吟四泽欲兴雨，","凤引九雏警宿乌。"],["新妇矶边月明，","女儿浦口潮平。"]]}
{"id":"e1124262fb","title":"发南康夜泊灨石中","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["倦客乘归舟，","春溪杳将暮。","群林结暝色，","孤泊有佳趣。","夜山转长江，","赤月吐深树。","飒飒松上吹，","泛泛花间露。","险石俯潭涡，","跳湍碍沿溯。","岂唯垂堂戒，","兼以临深惧。","稍出回雁峰，","明登斩蛟柱。","连云向重山，","杳未见钟路。"],"stanzas":[["倦客乘归舟，","春溪杳将暮。"],["群林结暝色，","孤泊有佳趣。"],["夜山转长江，","赤月吐深树。"],["飒飒松上吹，","泛泛花间露。"],["险石俯潭涡，","跳湍碍沿溯。"],["岂唯垂堂戒，","兼以临深惧。"],["稍出回雁峰，","明登斩蛟柱。"],["连云向重山，","杳未见钟路。"]]}
{"id":"b13be7a7b9","title":"过王山人旧居","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故宅春山中，","来逢夕阳入。","汲少井味变，","开稀户枢涩。","树朽鸟不栖，","阶闲云自湿。","先生何处去，","惆怅空独立。"],"stanzas":[["故宅春山中，","来逢夕阳入。"],["汲少井味变，","开稀户枢涩。"],["树朽鸟不栖，","阶闲云自湿。"],["先生何处去，","惆怅空独立。"]]}
{"id":"eef9c4350a","title":"晚次昭应","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落日向林路，","东风吹麦陇。","藤草蔓古渠，","牛羊下荒冢。","骊宫户久闭，","温谷泉长涌。","为问全盛时，","何人最荣宠。"],"stanzas":[["落日向林路，","东风吹麦陇。"],["藤草蔓古渠，","牛羊下荒冢。"],["骊宫户久闭，","温谷泉长涌。"],["为问全盛时，","何人最荣宠。"]]}
{"id":"ced9a100d9","title":"听早蝉歌","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蝉鸣兮夕曛，","声和兮夏云。","白日兮将短，","秋意兮已满。","乍悲鸣兮欲长，","犹嘶涩兮多断。","风萧萧兮转清，","韵嘒嘒兮初成。","依婆娑之古树，","思辽落之荒城。","闲院支颐，","深林倚策。","犹惆怅而无语，","鬓星星而已白。"],"stanzas":[["蝉鸣兮夕曛，","声和兮夏云。"],["白日兮将短，","秋意兮已满。"],["乍悲鸣兮欲长，","犹嘶涩兮多断。"],["风萧萧兮转清，","韵嘒嘒兮初成。"],["依婆娑之古树，","思辽落之荒城。"],["闲院支颐，","深林倚策。"],["犹惆怅而无语，","鬓星星而已白。"]]}
{"id":"b9d97b1de5","title":"芦花动","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["连素穗，","翻秋气，","细节疎茎任长吹。","共作月中声，","孤舟发乡思。"],"stanzas":[["连素穗，","翻秋气，","细节疎茎任长吹。"],["共作月中声，","孤舟发乡思。"]]}
{"id":"9389aa0815","title":"赋得寒蛩","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尔谁造，","鸣何早，","趯趯连声徧阶草。","复与夜雨和，","游人听堪老。"],"stanzas":[["尔谁造，","鸣何早，","趯趯连声徧阶草。"],["复与夜雨和，","游人听堪老。"]]}
{"id":"9080761942","title":"宣城逢张二南史","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["全家宛陵客，","文雅世难逢。","寄食年将老，","干时计未从。","秋来句曲水，","雨后敬亭峰。","西北长安远，","登临恨几重。"],"stanzas":[["全家宛陵客，","文雅世难逢。"],["寄食年将老，","干时计未从。"],["秋来句曲水，","雨后敬亭峰。"],["西北长安远，","登临恨几重。"]]}
{"id":"27fa91b97f","title":"题童子寺","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["半偈留何处，","全身弃此中。","雨余沙塔坏，","月满雪山空。","耸刹临回磴，","朱楼间碧丛。","朝朝日将暮，","长对晋阳宫。"],"stanzas":[["半偈留何处，","全身弃此中。"],["雨余沙塔坏，","月满雪山空。"],["耸刹临回磴，","朱楼间碧丛。"],["朝朝日将暮，","长对晋阳宫。"]]}
{"id":"f67b968d79","title":"夏日寄东溪隐者","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日华浮野水，","草色合遥空。","处处山依旧，","年年事不同。","闲田孤垒外，","暑雨片云中。","惆怅多尘累，","无由访钓翁。"],"stanzas":[["日华浮野水，","草色合遥空。"],["处处山依旧，","年年事不同。"],["闲田孤垒外，","暑雨片云中。"],["惆怅多尘累，","无由访钓翁。"]]}
{"id":"77a0b91d8e","title":"之江淮留别京亲故","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长云迷一雁，","渐远向南声。","已带千霜鬓，","初为万里行。","繁虫满夜草，","连雨暗秋城。","前路诸侯贵，","何人重客卿。"],"stanzas":[["长云迷一雁，","渐远向南声。"],["已带千霜鬓，","初为万里行。"],["繁虫满夜草，","连雨暗秋城。"],["前路诸侯贵，","何人重客卿。"]]}
{"id":"075031ddc5","title":"太原送许侍御出幕归东都","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔随刘越石，","今日独归时。","汾水风烟冷，","并州花木迟。","荒庭增别梦，","野雨失行期。","莫向山阳过，","隣人夜笛悲。"],"stanzas":[["昔随刘越石，","今日独归时。"],["汾水风烟冷，","并州花木迟。"],["荒庭增别梦，","野雨失行期。"],["莫向山阳过，","隣人夜笛悲。"]]}
{"id":"1117124373","title":"华州客舍奉和崔端公春城晓望","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不语看芳径，","悲春嬾独行。","向人微月在，","报雨早霞生。","贫病催年齿，","风尘掩姓名。","赖逢骢马客，","郢曲缓羇情。"],"stanzas":[["不语看芳径，","悲春嬾独行。"],["向人微月在，","报雨早霞生。"],["贫病催年齿，","风尘掩姓名。"],["赖逢骢马客，","郢曲缓羇情。"]]}
{"id":"71a3a10305","title":"题清萝翁双泉","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侧弁向清漪，","门中夕照移。","异源生暗石，","叠响落秋池。","叶拥沙痕没，","流回草蔓随。","泠泠无限意，","不独远公知。"],"stanzas":[["侧弁向清漪，","门中夕照移。"],["异源生暗石，","叠响落秋池。"],["叶拥沙痕没，","流回草蔓随。"],["泠泠无限意，","不独远公知。"]]}
{"id":"ddb105b1cb","title":"酬李文","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落照长杨苑，","秋天渭水滨。","初飞万木叶，","又长一年人。","贫病仍为客，","艰虞更问津。","多慙惠然意，","今日肯相亲。"],"stanzas":[["落照长杨苑，","秋天渭水滨。"],["初飞万木叶，","又长一年人。"],["贫病仍为客，","艰虞更问津。"],["多慙惠然意，","今日肯相亲。"]]}
{"id":"38128d88ab","title":"赠严维","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["许询清论重，","寂寞住山阴。","野路接寒寺，","闲门当古林。","海田秋熟早，","湖水夜渔深。","世上穷通理，","谁人奈此心。"],"stanzas":[["许询清论重，","寂寞住山阴。"],["野路接寒寺，","闲门当古林。"],["海田秋熟早，","湖水夜渔深。"],["世上穷通理，","谁人奈此心。"]]}
{"id":"5d26f837d6","title":"春日题苗发竹亭","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春亭及策上，","郎吏谢玄晖。","闲咏疎篁近，","高眠远岫微。","偏宜留野客，","暂得解朝衣。","犹忆东溪里，","雷云掩故扉。"],"stanzas":[["春亭及策上，","郎吏谢玄晖。"],["闲咏疎篁近，","高眠远岫微。"],["偏宜留野客，","暂得解朝衣。"],["犹忆东溪里，","雷云掩故扉。"]]}
{"id":"58424828ab","title":"题孝子陵","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["荒坟秋陌上，","霜露正霏霏。","松柏自成拱，","苫庐长不归。","浮埃积蓬鬓，","流血在麻衣。","何必曾参传，","千年至行稀。"],"stanzas":[["荒坟秋陌上，","霜露正霏霏。"],["松柏自成拱，","苫庐长不归。"],["浮埃积蓬鬓，","流血在麻衣。"],["何必曾参传，","千年至行稀。"]]}
{"id":"3f40d471da","title":"题庄上人房","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不语焚香坐，","心知道已成。","流年衰此世，","定力见他生。","暮雪余春冷，","寒灯续昼明。","寻常五侯至，","敢望下阶迎。"],"stanzas":[["不语焚香坐，","心知道已成。"],["流年衰此世，","定力见他生。"],["暮雪余春冷，","寒灯续昼明。"],["寻常五侯至，","敢望下阶迎。"]]}
{"id":"93c60b8c78","title":"宋中","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日暮黄云合，","年深白骨稀。","旧村乔木在，","秋草远人归。","废井莓苔厚，","荒田路径微。","唯余近山色，","相对似依依。"],"stanzas":[["日暮黄云合，","年深白骨稀。"],["旧村乔木在，","秋草远人归。"],["废井莓苔厚，","荒田路径微。"],["唯余近山色，","相对似依依。"]]}
{"id":"5da0bb4913","title":"秋夜思归","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["来时犹暑服，","今已露漫漫。","多雨逢初霁，","深秋生夜寒。","投人心似切，","为客事皆难。","何处无留滞，","谁能暂问看。"],"stanzas":[["来时犹暑服，","今已露漫漫。"],["多雨逢初霁，","深秋生夜寒。"],["投人心似切，","为客事皆难。"],["何处无留滞，","谁能暂问看。"]]}
{"id":"a57434ee84","title":"送李端","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世上许刘桢，","洋洋风雅声。","客来空改岁，","归去未成名。","远近天初暮，","关河雪半晴。","空怀谏书在，","回首恋承明。"],"stanzas":[["世上许刘桢，","洋洋风雅声。"],["客来空改岁，","归去未成名。"],["远近天初暮，","关河雪半晴。"],["空怀谏书在，","回首恋承明。"]]}
{"id":"68427d16a8","title":"送崔明府赴青城","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清冬宾御出，","蜀道翠微间。","远雾开群壑，","初阳照近关。","霜潭浮紫菜，","雪栈绕青山。","当似遗民去，","柴桑政自闲。"],"stanzas":[["清冬宾御出，","蜀道翠微间。"],["远雾开群壑，","初阳照近关。"],["霜潭浮紫菜，","雪栈绕青山。"],["当似遗民去，","柴桑政自闲。"]]}
{"id":"bc3fbfdf21","title":"送王将军出塞","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉家边事重，","窦宪出临戎。","绝漠秋山在，","阳关旧路通。","列营依茂草，","吹角向高风。","更就燕然石，","行看奏虏功。"],"stanzas":[["汉家边事重，","窦宪出临戎。"],["绝漠秋山在，","阳关旧路通。"],["列营依茂草，","吹角向高风。"],["更就燕然石，","行看奏虏功。"]]}
{"id":"df4aa3dec1","title":"雨中留别","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东西无定客，","风雨未休时。","悯默此中别，","飘零何处期。","青山违旧隐，","白发入新诗。","岁岁迷津路，","生涯渐可悲。"],"stanzas":[["东西无定客，","风雨未休时。"],["悯默此中别，","飘零何处期。"],["青山违旧隐，","白发入新诗。"],["岁岁迷津路，","生涯渐可悲。"]]}
{"id":"bd40be9d6d","title":"送杨将军","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一身良将后，","万里讨乌孙。","落日边陲静，","秋风鼓角喧。","远山当碛路，","茂草向营门。","生死酬恩宠，","功名岂敢论。"],"stanzas":[["一身良将后，","万里讨乌孙。"],["落日边陲静，","秋风鼓角喧。"],["远山当碛路，","茂草向营门。"],["生死酬恩宠，","功名岂敢论。"]]}
{"id":"0b34c6b4a7","title":"送夏侯审游蜀","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暮峰和玉垒，","回望不通秦。","更问蜀城路，","但逢巴语人。","石林莺啭晓，","板屋月明春。","若访严夫子，","无嫌卜肆贫。"],"stanzas":[["暮峰和玉垒，","回望不通秦。"],["更问蜀城路，","但逢巴语人。"],["石林莺啭晓，","板屋月明春。"],["若访严夫子，","无嫌卜肆贫。"]]}
{"id":"585a95d031","title":"送张侍御赴郴州别驾","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佐郡人难料，","分襟日复斜。","一帆随远水，","百口过长沙。","明月江边夜，","平陵梦里家。","王孙对芳草，","愁思杳无涯。"],"stanzas":[["佐郡人难料，","分襟日复斜。"],["一帆随远水，","百口过长沙。"],["明月江边夜，","平陵梦里家。"],["王孙对芳草，","愁思杳无涯。"]]}
{"id":"fc6d12623b","title":"送苗赟赴阳翟丞","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夕阳秋草上，","去马弟兄看。","年少初辞阙，","时危远效官。","山行独夜雨，","旅宿二陵寒。","诗兴生何处，","嵩阳羽客坛。"],"stanzas":[["夕阳秋草上，","去马弟兄看。"],["年少初辞阙，","时危远效官。"],["山行独夜雨，","旅宿二陵寒。"],["诗兴生何处，","嵩阳羽客坛。"]]}
{"id":"adfc79ff4f","title":"送绛州郭参军","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远事诸侯出，","青山古晋城。","连行曲水阁，","独入议中兵。","夜雨新田湿，","春风曙角鸣。","人传府公政，","记室有参卿。"],"stanzas":[["远事诸侯出，","青山古晋城。"],["连行曲水阁，","独入议中兵。"],["夜雨新田湿，","春风曙角鸣。"],["人传府公政，","记室有参卿。"]]}
{"id":"f58039cc71","title":"常州留别","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万里南天外，","求书禹穴间。","往来成白首，","旦暮见青山。","夜浦凉云过，","秋塘好月闲。","殷勤阳羡桂，","别此几时攀。"],"stanzas":[["万里南天外，","求书禹穴间。"],["往来成白首，","旦暮见青山。"],["夜浦凉云过，","秋塘好月闲。"],["殷勤阳羡桂，","别此几时攀。"]]}
{"id":"e4aad2ce4e","title":"关山月","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月明边徼静，","戍客望乡时。","塞古柳衰尽，","关寒榆发迟。","苍苍万里道，","戚戚十年北。","今夜青楼上，","还应照所思。"],"stanzas":[["月明边徼静，","戍客望乡时。"],["塞古柳衰尽，","关寒榆发迟。"],["苍苍万里道，","戚戚十年北。"],["今夜青楼上，","还应照所思。"]]}
{"id":"0e0e2c7a21","title":"代宋州将淮上乞师","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["唇齿幸相依，","危亡故远归。","身轻百战出，","家在数重围。","上将坚深垒，","残兵鬬落晖。","常闻铁劒利，","早晚借余威。"],"stanzas":[["唇齿幸相依，","危亡故远归。"],["身轻百战出，","家在数重围。"],["上将坚深垒，","残兵鬬落晖。"],["常闻铁劒利，","早晚借余威。"]]}
{"id":"b1cb4038b1","title":"秋晚卧疾寄司空拾遗曙卢少府纶","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒几坐空堂，","疎髯似积霜。","老医迷旧疾，","朽药误新方。","晚果红低树，","秋苔绿徧墙。","慙非蒋生径，","不敢望求羊。"],"stanzas":[["寒几坐空堂，","疎髯似积霜。"],["老医迷旧疾，","朽药误新方。"],["晚果红低树，","秋苔绿徧墙。"],["慙非蒋生径，","不敢望求羊。"]]}
{"id":"3b5f4faaa3","title":"赠海明上人","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["来自西天竺，","持经奉紫微。","年深梵语变，","行苦俗流归。","月上安禅久，","苔生出院稀。","梁间有驯鸽，","不去复何依。"],"stanzas":[["来自西天竺，","持经奉紫微。"],["年深梵语变，","行苦俗流归。"],["月上安禅久，","苔生出院稀。"],["梁间有驯鸽，","不去复何依。"]]}
{"id":"b4020680af","title":"津亭有怀","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["津亭一望乡，","淮海晚茫茫。","草没栖洲鹭，","天连暎浦樯。","徃来通楚越，","旦暮易渔商。","惆怅缄书毕，","何人向洛阳。"],"stanzas":[["津亭一望乡，","淮海晚茫茫。"],["草没栖洲鹭，","天连暎浦樯。"],["徃来通楚越，","旦暮易渔商。"],["惆怅缄书毕，","何人向洛阳。"]]}
{"id":"89c77bdb95","title":"晚投江泽浦即事呈柳兵曹泥","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["落日过重霞，","轻烟上远沙。","移舟冲荇蔓，","转浦入芦花。","断岸迂来客，","连波漾去槎。","故乡何处在，","更道向天涯。"],"stanzas":[["落日过重霞，","轻烟上远沙。"],["移舟冲荇蔓，","转浦入芦花。"],["断岸迂来客，","连波漾去槎。"],["故乡何处在，","更道向天涯。"]]}
{"id":"20e69215c9","title":"东郊别业","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东臯占薄田，","耕种过余年。","护药栽山刺，","浇蔬引竹泉。","晚雷期稔岁，","重雾报晴天。","若问幽人意，","思齐沮溺贤。"],"stanzas":[["东臯占薄田，","耕种过余年。"],["护药栽山刺，","浇蔬引竹泉。"],["晚雷期稔岁，","重雾报晴天。"],["若问幽人意，","思齐沮溺贤。"]]}
{"id":"b0be569ad3","title":"早朝","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钟鼓余声里，","千官向紫微。","冒寒人语少，","乘月烛来稀。","清漏闻驰道，","轻霞暎琐闱。","犹看嘶马处，","未启掖垣扉。"],"stanzas":[["钟鼓余声里，","千官向紫微。"],["冒寒人语少，","乘月烛来稀。"],["清漏闻驰道，","轻霞暎琐闱。"],["犹看嘶马处，","未启掖垣扉。"]]}
{"id":"bbd61221e1","title":"屏居盩厔","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百年心不料，","一卷日相知。","乘兴偏难改，","忧家是强为。","县城寒寂寞，","峰树远参差。","自笑无谋者，","秪应道在斯。"],"stanzas":[["百年心不料，","一卷日相知。"],["乘兴偏难改，","忧家是强为。"],["县城寒寂寞，","峰树远参差。"],["自笑无谋者，","秪应道在斯。"]]}
{"id":"e8ca61dbe5","title":"进秋隼","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岂悟因罗者，","迎霜献紫微。","夕阳分素臆，","秋色上花衣。","举翅云天近，","回眸燕雀稀。","应随明主意，","百中有光辉。"],"stanzas":[["岂悟因罗者，","迎霜献紫微。"],["夕阳分素臆，","秋色上花衣。"],["举翅云天近，","回眸燕雀稀。"],["应随明主意，","百中有光辉。"]]}
{"id":"7691d7f0d2","title":"咏宣州笔","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒竹慙虚受，","纤毫任几重。","影端缘守直，","心劲懒藏锋。","落纸惊风起，","摇空见露浓。","丹青与文事，","舍此复何从。"],"stanzas":[["寒竹慙虚受，","纤毫任几重。"],["影端缘守直，","心劲懒藏锋。"],["落纸惊风起，","摇空见露浓。"],["丹青与文事，","舍此复何从。"]]}
{"id":"efa519f758","title":"春日洪州即事","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["钟陵春日好，","春水满南塘。","竹宇分朱阁，","桐花间绿杨。","蹉跎看鬓色，","留滞惜年芳。","欲问羇愁发，","秦关道路长。"],"stanzas":[["钟陵春日好，","春水满南塘。"],["竹宇分朱阁，","桐花间绿杨。"],["蹉跎看鬓色，","留滞惜年芳。"],["欲问羇愁发，","秦关道路长。"]]}
{"id":"1fd493fba5","title":"雪后宿王纯池州草堂","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宿君湖上宅，","琴韵静参差。","夜雪入秋浦，","孤城连贵池。","流年看共老，","衔酒发中悲。","良会应难再，","晨鸡自有期。"],"stanzas":[["宿君湖上宅，","琴韵静参差。"],["夜雪入秋浦，","孤城连贵池。"],["流年看共老，","衔酒发中悲。"],["良会应难再，","晨鸡自有期。"]]}
{"id":"fa964596d8","title":"旅次汉故畤","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我行过汉畤，","寥落见孤城。","邑里经多难，","儿童识五兵。","广川桑遍绿，","丛薄雉连鸣。","惆怅萧关道，","终军愿请缨。"],"stanzas":[["我行过汉畤，","寥落见孤城。"],["邑里经多难，","儿童识五兵。"],["广川桑遍绿，","丛薄雉连鸣。"],["惆怅萧关道，","终军愿请缨。"]]}
{"id":"75569fd809","title":"过三郊驿却寄杨评事时此子郭令公欲有表荐","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冉冉青衫客，","悠悠白发人。","乱山孤驿暮，","长路百花新。","终岁行他县，","全家望此身。","更思君去就，","早晚问平津。"],"stanzas":[["冉冉青衫客，","悠悠白发人。"],["乱山孤驿暮，","长路百花新。"],["终岁行他县，","全家望此身。"],["更思君去就，","早晚问平津。"]]}
{"id":"7b67b989d1","title":"陇西行","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪下阳关路，","人稀陇戍头。","封狐犹未翦，","边将岂无羞。","白草三冬色，","黄云万里愁。","因思李都尉，","毕竟不封侯。"],"stanzas":[["雪下阳关路，","人稀陇戍头。"],["封狐犹未翦，","边将岂无羞。"],["白草三冬色，","黄云万里愁。"],["因思李都尉，","毕竟不封侯。"]]}
{"id":"a9ab995803","title":"巴陵逢洛阳邻舍","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["因君知北事，","流浪已忘机。","客久多人识，","年高众病归。","连云湖色远，","度雪雁声稀。","又说家林尽，","凄伤泪满衣。"],"stanzas":[["因君知北事，","流浪已忘机。"],["客久多人识，","年高众病归。"],["连云湖色远，","度雪雁声稀。"],["又说家林尽，","凄伤泪满衣。"]]}
{"id":"87c674749c","title":"哭张融","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["早岁能文客，","中年与世违。","有家孀妇少，","无子吊人稀。","繐帐尘空暗，","铭旌雨不飞。","依然旧乡路，","寂寞几回归。"],"stanzas":[["早岁能文客，","中年与世违。"],["有家孀妇少，","无子吊人稀。"],["繐帐尘空暗，","铭旌雨不飞。"],["依然旧乡路，","寂寞几回归。"]]}
{"id":"b875faca96","title":"送友贬岭南","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暮年从远谪，","落日别交亲。","湖上北飞雁，","天涯南去人。","梦成湘浦夜，","泪尽桂阳春。","岁月茫茫意，","何时雨露新。"],"stanzas":[["暮年从远谪，","落日别交亲。"],["湖上北飞雁，","天涯南去人。"],["梦成湘浦夜，","泪尽桂阳春。"],["岁月茫茫意，","何时雨露新。"]]}
{"id":"241b0344e1","title":"春日即事二首 一","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诗书成志业，","嬾慢致蹉跎。","圣代丹霄远，","明时白发多。","浅谋堪自笑，","穷巷忆谁过。","寂寞前山暮，","归人樵采歌。"],"stanzas":[["诗书成志业，","嬾慢致蹉跎。"],["圣代丹霄远，","明时白发多。"],["浅谋堪自笑，","穷巷忆谁过。"],["寂寞前山暮，","归人樵采歌。"]]}
{"id":"6c12d0d5f3","title":"春日即事二首 二","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数亩东臯宅，","青春独屏居。","家贫僮仆慢，","官罢友朋疎。","强饮沽来酒，","羞看读了书。","闲花开满地，","惆怅复何如。"],"stanzas":[["数亩东臯宅，","青春独屏居。"],["家贫僮仆慢，","官罢友朋疎。"],["强饮沽来酒，","羞看读了书。"],["闲花开满地，","惆怅复何如。"]]}
{"id":"392d9bb5cd","title":"赠田家翁","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老人迎客处，","篱落稻畦间。","蚕屋朝寒闭，","田家昼雨闲。","门闾新薙草，","蹊径旧谙山。","自道谁相及，","邀予试徃还。"],"stanzas":[["老人迎客处，","篱落稻畦间。"],["蚕屋朝寒闭，","田家昼雨闲。"],["门闾新薙草，","蹊径旧谙山。"],["自道谁相及，","邀予试徃还。"]]}
{"id":"2c2a9cf71c","title":"赠韦山人","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["失意成逋客，","终年独掩扉。","无机狎鸥惯，","多病见人稀。","流水知行药，","孤云伴采薇。","空斋莫闲笑，","心事与时违。"],"stanzas":[["失意成逋客，","终年独掩扉。"],["无机狎鸥惯，","多病见人稀。"],["流水知行药，","孤云伴采薇。"],["空斋莫闲笑，","心事与时违。"]]}
{"id":"832d45db24","title":"濬公院怀旧","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远公传教毕，","身没向他方。","吊客来何见，","门人闭影堂。","纱灯临古砌，","尘札在空床。","寂寞疎钟后，","秋天有夕阳。"],"stanzas":[["远公传教毕，","身没向他方。"],["吊客来何见，","门人闭影堂。"],["纱灯临古砌，","尘札在空床。"],["寂寞疎钟后，","秋天有夕阳。"]]}
{"id":"c66467899e","title":"雨中宿义兴寺","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["遥夜宿东林，","虫声阶草深。","高风初落叶，","多雨未归心。","家国身犹负，","星霜鬓已侵。","沧洲纵不去，","何处有知音。"],"stanzas":[["遥夜宿东林，","虫声阶草深。"],["高风初落叶，","多雨未归心。"],["家国身犹负，","星霜鬓已侵。"],["沧洲纵不去，","何处有知音。"]]}
{"id":"4ba3d4786c","title":"送王秘书归江东","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["回首望知音，","逶迤桑柘林。","人归海郡远，","路入雨天深。","万木经秋叶，","孤舟向暮心。","唯余江畔草，","应见白头吟。"],"stanzas":[["回首望知音，","逶迤桑柘林。"],["人归海郡远，","路入雨天深。"],["万木经秋叶，","孤舟向暮心。"],["唯余江畔草，","应见白头吟。"]]}
{"id":"29e9697cfa","title":"渭上送李蔵器移家东都","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["求名虽有据，","学稼又无田。","故国三千里，","新春五十年。","移家还作客，","避地莫知贤。","洛浦今何处，","风帆去渺然。"],"stanzas":[["求名虽有据，","学稼又无田。"],["故国三千里，","新春五十年。"],["移家还作客，","避地莫知贤。"],["洛浦今何处，","风帆去渺然。"]]}
{"id":"f87633ea5b","title":"春寻柳先生","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["言是商山老，","尘心莫问年。","白髯垂策短，","乌帽据梧偏。","酒熟飞巴雨，","丹成见海田。","疎云披远水，","景动石床前。"],"stanzas":[["言是商山老，","尘心莫问年。"],["白髯垂策短，","乌帽据梧偏。"],["酒熟飞巴雨，","丹成见海田。"],["疎云披远水，","景动石床前。"]]}
{"id":"37fc115913","title":"题藏公院","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古院林公住，","疎篁近井桃。","俗年人见少，","禅地自知高。","药草诚多喻，","沧溟在一毫。","仍悲次宗辈，","尘事日为劳。"],"stanzas":[["古院林公住，","疎篁近井桃。"],["俗年人见少，","禅地自知高。"],["药草诚多喻，","沧溟在一毫。"],["仍悲次宗辈，","尘事日为劳。"]]}
{"id":"35f505e839","title":"夏夜西亭即事寄钱员外","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["高亭宾客散，","暑夜醉相和。","细汗迎衣集，","微凉待扇过。","风还池色定，","月晚树阴多。","遥想随行者，","珊珊动晓珂。"],"stanzas":[["高亭宾客散，","暑夜醉相和。"],["细汗迎衣集，","微凉待扇过。"],["风还池色定，","月晚树阴多。"],["遥想随行者，","珊珊动晓珂。"]]}
{"id":"06e1675c60","title":"与清江上人及诸公宿李八昆季宅","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汤公多外友，","洛社自相依。","远客还登会，","秋怀欲忘归。","惊风林果少，","骤雨砌虫稀。","更过三张价，","东游愧陆机。"],"stanzas":[["汤公多外友，","洛社自相依。"],["远客还登会，","秋怀欲忘归。"],["惊风林果少，","骤雨砌虫稀。"],["更过三张价，","东游愧陆机。"]]}
{"id":"78bf80ee9e","title":"春日即事","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["邻里朝光徧，","披衣夜醉醒。","庖厨非旧火，","林木发新青。","接果移天性，","疎泉逐地形。","清明来几日，","戴胜已堪听。"],"stanzas":[["邻里朝光徧，","披衣夜醉醒。"],["庖厨非旧火，","林木发新青。"],["接果移天性，","疎泉逐地形。"],["清明来几日，","戴胜已堪听。"]]}
{"id":"458beb3f44","title":"秋夜会宿李永宅忆江南旧游","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶宿俱南客，","相看喜尽归。","湖山话不极，","岁月念空违。","子夜高梧冷，","秋阴远漏微。","那无此良会，","惜在谢家稀。"],"stanzas":[["偶宿俱南客，","相看喜尽归。"],["湖山话不极，","岁月念空违。"],["子夜高梧冷，","秋阴远漏微。"],["那无此良会，","惜在谢家稀。"]]}
{"id":"7f98e051b2","title":"冬夜寻李永因书事赠之","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["栖遑偏降志，","疵贱倍修身。","近觉多衰鬓，","深知独故人。","天垂五夜月，","霜覆九衢尘。","不待逢沮溺，","而今恶问津。"],"stanzas":[["栖遑偏降志，","疵贱倍修身。"],["近觉多衰鬓，","深知独故人。"],["天垂五夜月，","霜覆九衢尘。"],["不待逢沮溺，","而今恶问津。"]]}
{"id":"8cbe67092a","title":"立春日宴高陵任明府宅","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春灰今变候，","密雪又霏霏。","坐客同心满，","流年此会稀。","风成空处乱，","素积夜来飞。","且共衔杯酒，","陶潜不得归。"],"stanzas":[["春灰今变候，","密雪又霏霏。"],["坐客同心满，","流年此会稀。"],["风成空处乱，","素积夜来飞。"],["且共衔杯酒，","陶潜不得归。"]]}
{"id":"efcc536f58","title":"春日游慈恩寺寄畅当","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浮世今何事，","空门此谛真。","死生俱是梦，","哀乐讵关身。","远草光连水，","春篁色离尘。","当从庚中庶，","诗客更何人。"],"stanzas":[["浮世今何事，","空门此谛真。"],["死生俱是梦，","哀乐讵关身。"],["远草光连水，","春篁色离尘。"],["当从庚中庶，","诗客更何人。"]]}
{"id":"bc4667b4d1","title":"晚秋过苏少府","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九江迷去住，","群吏且因依。","高木秋垂露，","寒城暮掩扉。","随云心自远，","看草伴应稀。","肯信同年友，","相望青琐闱。"],"stanzas":[["九江迷去住，","群吏且因依。"],["高木秋垂露，","寒城暮掩扉。"],["随云心自远，","看草伴应稀。"],["肯信同年友，","相望青琐闱。"]]}
{"id":"9af430a3a0","title":"登鹳雀楼","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["久客心常醉，","高楼日渐低。","黄河经海内，","华岳镇关西。","去远千帆小，","来迟独鸟迷。","终年不得意，","空觉负东溪。"],"stanzas":[["久客心常醉，","高楼日渐低。"],["黄河经海内，","华岳镇关西。"],["去远千帆小，","来迟独鸟迷。"],["终年不得意，","空觉负东溪。"]]}
{"id":"36c01284e3","title":"赋得沙上雁","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["衡阳多道里，","弱羽复哀音。","还塞知何日，","惊弦乱此心。","夜阴前侣远，","秋冷后湖深。","独立汀洲意，","宁知霜霰侵。"],"stanzas":[["衡阳多道里，","弱羽复哀音。"],["还塞知何日，","惊弦乱此心。"],["夜阴前侣远，","秋冷后湖深。"],["独立汀洲意，","宁知霜霰侵。"]]}
{"id":"38cc532562","title":"夜寻卢处士","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月高鸡犬静，","门掩向寒塘。","夜竹深茅宇，","秋庭冷石床。","住山年已远，","服药寿偏长。","虚弃如吾者，","逢君益自伤。"],"stanzas":[["月高鸡犬静，","门掩向寒塘。"],["夜竹深茅宇，","秋庭冷石床。"],["住山年已远，","服药寿偏长。"],["虚弃如吾者，","逢君益自伤。"]]}
{"id":"57bdeec1dd","title":"邠州留别","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["终岁山川路，","生涯总几何。","艰难为客惯，","贫贱受恩多。","暮角寒山色，","秋风远水波。","无人见惆怅，","垂鞚入烟萝。"],"stanzas":[["终岁山川路，","生涯总几何。"],["艰难为客惯，","贫贱受恩多。"],["暮角寒山色，","秋风远水波。"],["无人见惆怅，","垂鞚入烟萝。"]]}
{"id":"ebb3c1d718","title":"赠张将军","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寥落军城暮，","重门返照间。","鼓鼙经雨暗，","士马过秋闲。","惯守临边郡，","曾营近海山。","关西旧业在，","夜夜梦中还。"],"stanzas":[["寥落军城暮，","重门返照间。"],["鼓鼙经雨暗，","士马过秋闲。"],["惯守临边郡，","曾营近海山。"],["关西旧业在，","夜夜梦中还。"]]}
{"id":"2c8d84c5c8","title":"赠隐公","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世间无近远，","定里徧曾过。","东海经长在，","南朝寺最多。","暮年聊化俗，","初地即摧魔。","今日忘尘虑，","看心义若何。"],"stanzas":[["世间无近远，","定里徧曾过。"],["东海经长在，","南朝寺最多。"],["暮年聊化俗，","初地即摧魔。"],["今日忘尘虑，","看心义若何。"]]}
{"id":"bb5af12206","title":"赠别安邑韩少府","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子真能自在，","江海意何如。","门掩疎尘吏，","心闲阅道书。","古城寒欲雪，","远客暮无车。","杳杳思前路，","谁堪千里余。"],"stanzas":[["子真能自在，","江海意何如。"],["门掩疎尘吏，","心闲阅道书。"],["古城寒欲雪，","远客暮无车。"],["杳杳思前路，","谁堪千里余。"]]}
{"id":"ae97389886","title":"送胡校书秩满归河中","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["古树汾阴道，","悠悠东去长。","位卑仍解印，","身老又还乡。","河水平秋岸，","关门向夕阳。","音书须数附，","莫学晋嵇康。"],"stanzas":[["古树汾阴道，","悠悠东去长。"],["位卑仍解印，","身老又还乡。"],["河水平秋岸，","关门向夕阳。"],["音书须数附，","莫学晋嵇康。"]]}
{"id":"81674bd3f7","title":"送河中张胄曹往太原计会回","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北风长至远，","四牡向幽并。","衰木新田路，","寒芜故绛城。","遥听边上信，","远计朔南程。","料变当临事，","遥知外国情。"],"stanzas":[["北风长至远，","四牡向幽并。"],["衰木新田路，","寒芜故绛城。"],["遥听边上信，","远计朔南程。"],["料变当临事，","遥知外国情。"]]}
{"id":"870ec6f8ed","title":"送郭正字归郢上","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["济江篇已出，","书府俸犹贫。","积雪商山道，","全家楚塞人。","大堤逢落日，","广汉望通津。","却别渔潭下，","惊鸥那可亲。"],"stanzas":[["济江篇已出，","书府俸犹贫。"],["积雪商山道，","全家楚塞人。"],["大堤逢落日，","广汉望通津。"],["却别渔潭下，","惊鸥那可亲。"]]}
{"id":"ff7dbf7358","title":"题李孝廉书房","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["野情专易外，","一室向青山。","业就三编绝，","心通万事闲。","莺稀春木上，","草徧暮堦间。","莫道归𦈡在，","来时弃故关。"],"stanzas":[["野情专易外，","一室向青山。"],["业就三编绝，","心通万事闲。"],["莺稀春木上，","草徧暮堦间。"],["莫道归𦈡在，","来时弃故关。"]]}
{"id":"f078a28c54","title":"酬畅当","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["同游漆沮后，","已是十年余。","几度曾相梦，","何时定得书。","月高城影尽，","霜重柳条疎。","且对尊中酒，","千般想未如。"],"stanzas":[["同游漆沮后，","已是十年余。"],["几度曾相梦，","何时定得书。"],["月高城影尽，","霜重柳条疎。"],["且对尊中酒，","千般想未如。"]]}
{"id":"ebe64dadfa","title":"留别解县韩明府","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闲人州县厌，","贱士友朋讥。","朔雪逢初下，","秦关独暮归。","寒茅下原浅，","残雪过风微。","一路何相慰，","唯君能政稀。"],"stanzas":[["闲人州县厌，","贱士友朋讥。"],["朔雪逢初下，","秦关独暮归。"],["寒茅下原浅，","残雪过风微。"],["一路何相慰，","唯君能政稀。"]]}
{"id":"f20edccd0e","title":"游钟山紫芝观","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["系舟仙宅下，","清磬落春风。","雨数芝田长，","云开石路重。","古房清磴接，","深殿紫烟浓。","鹤驾何时去，","游人自不逢。"],"stanzas":[["系舟仙宅下，","清磬落春风。"],["雨数芝田长，","云开石路重。"],["古房清磴接，","深殿紫烟浓。"],["鹤驾何时去，","游人自不逢。"]]}
{"id":"2f77de594f","title":"晚秋宿裴员外寺院","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仲言多丽藻，","晚水独芙蓉。","梁苑仍秋过，","仁祠又夜逢。","回林通暗竹，","去雨带寒钟。","愿向空门里，","修持比昼龙。"],"stanzas":[["仲言多丽藻，","晚水独芙蓉。"],["梁苑仍秋过，","仁祠又夜逢。"],["回林通暗竹，","去雨带寒钟。"],["愿向空门里，","修持比昼龙。"]]}
{"id":"97cbd137c8","title":"秋夜喜卢司直严少府访宿","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寂闭层城，","悠悠此夜情。","早凉过鬓发，","秋思入柴荆。","严子多高趣，","卢公有盛名。","还如杜陵下，","暂拂蒋元卿。"],"stanzas":[["寂寂闭层城，","悠悠此夜情。"],["早凉过鬓发，","秋思入柴荆。"],["严子多高趣，","卢公有盛名。"],["还如杜陵下，","暂拂蒋元卿。"]]}
{"id":"b9dadff9dd","title":"下邽客舍喜叔孙主簿郑少府见过","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["良宵复杪秋，","把酒说羇游。","落木东西别，","寒萍远近流。","萧条旅馆月，","寂历曙更筹。","不是仇梅至，","何人问百忧。"],"stanzas":[["良宵复杪秋，","把酒说羇游。"],["落木东西别，","寒萍远近流。"],["萧条旅馆月，","寂历曙更筹。"],["不是仇梅至，","何人问百忧。"]]}
{"id":"b7368d8d36","title":"盩厔客舍","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寥寂荒垒下，","客舍雨微微。","门见苔生满，","心慙吏到稀。","篱花看未发，","海燕欲先归。","无限堪惆怅，","谁家复捣衣。"],"stanzas":[["寥寂荒垒下，","客舍雨微微。"],["门见苔生满，","心慙吏到稀。"],["篱花看未发，","海燕欲先归。"],["无限堪惆怅，","谁家复捣衣。"]]}
{"id":"396e040002","title":"宿韦员外宅","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["传经韦相后，","赐笔汉家郎。","幽阁诸生会，","寒宵几刻长。","座中灯泛酒，","簷外月如霜。","人事多飘忽，","邀欢讵可忘。"],"stanzas":[["传经韦相后，","赐笔汉家郎。"],["幽阁诸生会，","寒宵几刻长。"],["座中灯泛酒，","簷外月如霜。"],["人事多飘忽，","邀欢讵可忘。"]]}
{"id":"53957103db","title":"登沃州山","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沃州初望海，","携手尽时髦。","小暑开鹏翼，","新蓂长鹭涛。","月如芳草远，","身比夕阳高。","羊祜伤风景，","谁云异我曹。"],"stanzas":[["沃州初望海，","携手尽时髦。"],["小暑开鹏翼，","新蓂长鹭涛。"],["月如芳草远，","身比夕阳高。"],["羊祜伤风景，","谁云异我曹。"]]}
{"id":"694f5749d3","title":"宿岐山姜明府厅","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暝色休群动，","秋斋远客情。","细风和雨气，","寒竹度帘声。","日觉蹉跎近，","天教嬾慢成。","谁能谒卿相，","朝夕筭浮荣。"],"stanzas":[["暝色休群动，","秋斋远客情。"],["细风和雨气，","寒竹度帘声。"],["日觉蹉跎近，","天教嬾慢成。"],["谁能谒卿相，","朝夕筭浮荣。"]]}
{"id":"b9bfeab8b7","title":"上巳日","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共来修禊事，","内顾一悲翁。","玉鬓风尘下，","花林丝管中。","故山离水石，","旧侣失鹓鸿。","不及游鱼乐，","裴回莲叶东。"],"stanzas":[["共来修禊事，","内顾一悲翁。"],["玉鬓风尘下，","花林丝管中。"],["故山离水石，","旧侣失鹓鸿。"],["不及游鱼乐，","裴回莲叶东。"]]}
{"id":"9baf744ae7","title":"登乐游原","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["园庙何年废，","登临有故丘。","孤村连日静，","多雨及霖休。","常与秦山对，","曾经汉主游。","岂知千载后，","万事水东流。"],"stanzas":[["园庙何年废，","登临有故丘。"],["孤村连日静，","多雨及霖休。"],["常与秦山对，","曾经汉主游。"],["岂知千载后，","万事水东流。"]]}
{"id":"d075e1d012","title":"题惟干上人房","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绳床茅屋下，","独坐味闲安。","苦行无童子，","忘机避宰官。","是非齐已久，","夏腊比应难。","更悟真如性，","尘心稍自宽。"],"stanzas":[["绳床茅屋下，","独坐味闲安。"],["苦行无童子，","忘机避宰官。"],["是非齐已久，","夏腊比应难。"],["更悟真如性，","尘心稍自宽。"]]}
{"id":"8da5d2f96f","title":"会凤翔张少尹南亭","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远过张正见，","诗兴自依依。","西府军城暮，","南庭吏事稀。","草簷宜日过，","花圃任烟归。","更料重关外，","群僚候启扉。"],"stanzas":[["远过张正见，","诗兴自依依。"],["西府军城暮，","南庭吏事稀。"],["草簷宜日过，","花圃任烟归。"],["更料重关外，","群僚候启扉。"]]}
{"id":"6db1102101","title":"早春宴高陵滑少府","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["且宽沈簿领，","应赖酒如渑。","春夜霜犹下，","东城月未升。","清言饶醉客，","乱舞避寒灯。","名字书仙籍，","诸生病未能。"],"stanzas":[["且宽沈簿领，","应赖酒如渑。"],["春夜霜犹下，","东城月未升。"],["清言饶醉客，","乱舞避寒灯。"],["名字书仙籍，","诸生病未能。"]]}
{"id":"18fa76fecd","title":"寒蜂采菊蕊","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["游飏下晴空，","寻芳到菊丛。","带声来蕊上，","连影在香中。","去住沾余雾，","高低顺过风。","终慙异蝴蝶，","不与梦魂通。"],"stanzas":[["游飏下晴空，","寻芳到菊丛。"],["带声来蕊上，","连影在香中。"],["去住沾余雾，","高低顺过风。"],["终慙异蝴蝶，","不与梦魂通。"]]}
{"id":"23cd16ad87","title":"题杨著别业","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["柳巷向陂斜，","回阳噪乱鵶。","农桑子云业，","书籍蔡邕家。","暮叶初飜砌，","寒池转露沙。","如何守儒行，","寂寞过年华。"],"stanzas":[["柳巷向陂斜，","回阳噪乱鵶。"],["农桑子云业，","书籍蔡邕家。"],["暮叶初飜砌，","寒池转露沙。"],["如何守儒行，","寂寞过年华。"]]}
{"id":"1db740e120","title":"送太仆寺李丞赴都到桃林塞","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["远过桃林塞，","休年自昔闻。","曲河随暮草，","重阜接闲云。","造父为周御，","詹嘉守晋军。","应多怀古思，","落叶又纷纷。"],"stanzas":[["远过桃林塞，","休年自昔闻。"],["曲河随暮草，","重阜接闲云。"],["造父为周御，","詹嘉守晋军。"],["应多怀古思，","落叶又纷纷。"]]}
{"id":"d2ec30582a","title":"宋中","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百战无军食，","孤城陷虏尘。","为伤多易子，","翻吊浅为臣。","漫漫东流水，","悠悠南陌人。","空思前事往，","向晓泪沾巾。"],"stanzas":[["百战无军食，","孤城陷虏尘。"],["为伤多易子，","翻吊浅为臣。"],["漫漫东流水，","悠悠南陌人。"],["空思前事往，","向晓泪沾巾。"]]}
{"id":"ed412e1ecb","title":"陪䜩湖州公堂","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢公为楚郡，","坐客是瑶林。","文府重门奥，","儒源积浪深。","壶觞邀薄醉，","笙磬发高音。","末至才仍短，","难随白雪吟。"],"stanzas":[["谢公为楚郡，","坐客是瑶林。"],["文府重门奥，","儒源积浪深。"],["壶觞邀薄醉，","笙磬发高音。"],["末至才仍短，","难随白雪吟。"]]}
{"id":"dca0f630d7","title":"寻觉公因寄李二端司空十四曙","author":"耿𣲗","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年尝昧道，","无事日悠悠。","及至悟生死，","寻僧已白头。","云回庐瀑雨，","树落给园秋。","为我谢宗许，","尘中难久留。"],"stanzas":[["少年尝昧道，","无事日悠悠。"],["及至悟生死，","寻僧已白头。"],["云回庐瀑雨，","树落给园秋。"],["为我谢宗许，","尘中难久留。"]]}
