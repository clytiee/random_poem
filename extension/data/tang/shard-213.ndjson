{"id":"cb1245fe41","title":"又诗二首 一","author":"马湘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["省悟前非一息间，","更抛闲事弃尘寰。","徒夸美酒如琼液，","休恋娇娥似玉颜。","含笑谩教情面厚，","多愁还使鬓毛斑。","云中幸有堪归路，","无限青山是我山。"],"stanzas":[["省悟前非一息间，","更抛闲事弃尘寰。"],["徒夸美酒如琼液，","休恋娇娥似玉颜。"],["含笑谩教情面厚，","多愁还使鬓毛斑。"],["云中幸有堪归路，","无限青山是我山。"]]}
{"id":"9956f8d466","title":"又诗二首 二","author":"马湘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何用烧丹学驻颜，","闹非城市静非山。","时人若觅长生药，","对景无心是大还。"],"stanzas":[["何用烧丹学驻颜，","闹非城市静非山。"],["时人若觅长生药，","对景无心是大还。"]]}
{"id":"c0470f2baa","title":"题壁","author":"张辞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["争那金乌何，","头上飞不住。","红炉漫烧药，","玉颜安可驻。","今年花发枝，","明年叶落树。","不如且饮酒，","莫管流年度。"],"stanzas":[["争那金乌何，","头上飞不住。"],["红炉漫烧药，","玉颜安可驻。"],["今年花发枝，","明年叶落树。"],["不如且饮酒，","莫管流年度。"]]}
{"id":"2d84246b20","title":"上盐城令述德诗","author":"张辞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门风常有蕙兰馨，","鼎族家传霸国名。","容貌静悬秋月彩，","文章高振海涛声。","讼堂无事调琴轸，","郡阁何妨醉玉觥。","今日东渐桥下水，","一条从此镇常清。"],"stanzas":[["门风常有蕙兰馨，","鼎族家传霸国名。"],["容貌静悬秋月彩，","文章高振海涛声。"],["讼堂无事调琴轸，","郡阁何妨醉玉觥。"],["今日东渐桥下水，","一条从此镇常清。"]]}
{"id":"4f0f586c7a","title":"谢令学道诗","author":"张辞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何用梯媒向外求，","长生只合内中修。","莫言大道人难得，","自是行心不到头。"],"stanzas":[["何用梯媒向外求，","长生只合内中修。"],["莫言大道人难得，","自是行心不到头。"]]}
{"id":"7eb2547386","title":"别令诗","author":"张辞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["张辞张辞自不会，","天下经书在腹内。","身即腾腾处世间，","心即逍遥出天外。"],"stanzas":[["张辞张辞自不会，","天下经书在腹内。"],["身即腾腾处世间，","心即逍遥出天外。"]]}
{"id":"003f941b20","title":"赠吴生","author":"陆禹臣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["露下瑶簪湿，","云生石室寒。","星坛鸾鹤舞，","丹灶虎龙蟠。"],"stanzas":[["露下瑶簪湿，","云生石室寒。"],["星坛鸾鹤舞，","丹灶虎龙蟠。"]]}
{"id":"4e3eef9f6e","title":"丈人山诗","author":"李真","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春冻晓鞯露重，","夜寒幽枕云生。","岂是与山无素，","丈人著帽相迎。"],"stanzas":[["春冻晓鞯露重，","夜寒幽枕云生。"],["岂是与山无素，","丈人著帽相迎。"]]}
{"id":"522e8151c9","title":"醉歌","author":"殷七七","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["琴弹碧玉调，","药炼白朱砂。","解酝顷刻酒，","能开非时花。"],"stanzas":[["琴弹碧玉调，","药炼白朱砂。"],["解酝顷刻酒，","能开非时花。"]]}
{"id":"81e4597b98","title":"阳春曲","author":"殷七七","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁见唱阳春，","令人离肠结。","郎去未归家，","柳自飘香雪。"],"stanzas":[["愁见唱阳春，","令人离肠结。"],["郎去未归家，","柳自飘香雪。"]]}
{"id":"c1ae6495f0","title":"寄杜光庭","author":"张令问","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["试问朝中为宰相，","何如林下作神仙。","一壶美酒一炉药，","饱听松风清昼眠。"],"stanzas":[["试问朝中为宰相，","何如林下作神仙。"],["一壶美酒一炉药，","饱听松风清昼眠。"]]}
{"id":"a8a92e184f","title":"上升歌","author":"吴涵虚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉皇有诏登仙职，","龙吐云兮凤著力。","眼前蓦地见楼台，","异草奇花不可识。","我向大罗观世界，","世界即如指掌大。","当时不为上升忙，","一时提向瀛洲卖。"],"stanzas":[["玉皇有诏登仙职，","龙吐云兮凤著力。"],["眼前蓦地见楼台，","异草奇花不可识。"],["我向大罗观世界，","世界即如指掌大。"],["当时不为上升忙，","一时提向瀛洲卖。"]]}
{"id":"a1aac00904","title":"荅常学士","author":"李梦符","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["罢修儒业罢修真，","养拙藏愚春复春。","到老不疎林里鹿，","平生难见日边人。","洞桃深处千林锦，","岩雪铺时万草新。","深谢名贤远相访，","求闻难博凤为邻。"],"stanzas":[["罢修儒业罢修真，","养拙藏愚春复春。"],["到老不疎林里鹿，","平生难见日边人。"],["洞桃深处千林锦，","岩雪铺时万草新。"],["深谢名贤远相访，","求闻难博凤为邻。"]]}
{"id":"d1d45a3177","title":"渔父引二首 一","author":"李梦符","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["林寺钟声度远滩，","半轮残月落山前。","徐徐拨櫂却归湾，","浪叠朝霞锦绣翻。"],"stanzas":[["林寺钟声度远滩，","半轮残月落山前。"],["徐徐拨櫂却归湾，","浪叠朝霞锦绣翻。"]]}
{"id":"90577a401a","title":"渔父引二首 二","author":"李梦符","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渔弟渔兄喜到来，","波官赛却坐江隈。","椰榆杓子木瘤杯，","烂煮鲈鱼满案堆。"],"stanzas":[["渔弟渔兄喜到来，","波官赛却坐江隈。"],["椰榆杓子木瘤杯，","烂煮鲈鱼满案堆。"]]}
{"id":"5ec25a5025","title":"察考取状荅","author":"李梦符","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["插花饮酒何妨事，","樵唱渔歌不碍时。"],"stanzas":[["插花饮酒何妨事，","樵唱渔歌不碍时。"]]}
{"id":"600078648a","title":"荅高安宰","author":"沈廷瑞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何须问我道成时，","紫府清都自有期。","手握药苗人不识，","体含金骨俗争知。"],"stanzas":[["何须问我道成时，","紫府清都自有期。"],["手握药苗人不识，","体含金骨俗争知。"]]}
{"id":"9d41e9100e","title":"赠僧昭莹","author":"沈廷瑞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南北东西路，","人生会不无。","早曾依阁皂，","又却上玄都。","云片随天阔，","泉声落石孤。","何期早相遇，","乐共煮菖蒲。"],"stanzas":[["南北东西路，","人生会不无。"],["早曾依阁皂，","又却上玄都。"],["云片随天阔，","泉声落石孤。"],["何期早相遇，","乐共煮菖蒲。"]]}
{"id":"04b90a1106","title":"寄袁州陈智周","author":"沈廷瑞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["名山相别后，","别后会难期。","金鼎销红日，","丹田老紫芝。","访君虽有路，","怀我岂无诗。","休羡繁华事，","百年能几时。"],"stanzas":[["名山相别后，","别后会难期。"],["金鼎销红日，","丹田老紫芝。"],["访君虽有路，","怀我岂无诗。"],["休羡繁华事，","百年能几时。"]]}
{"id":"2dd57d07f5","title":"垄穴遗诗","author":"沈廷瑞","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虚劳营殡玉山前，","殡后那知已脱蝉。","应是元神归洞府，","更无遗魄在黄泉。","灵台已得修真诀，","尘世空留悟道篇。","堪叹浮生今古事，","北邙山下草芊芊。"],"stanzas":[["虚劳营殡玉山前，","殡后那知已脱蝉。"],["应是元神归洞府，","更无遗魄在黄泉。"],["灵台已得修真诀，","尘世空留悟道篇。"],["堪叹浮生今古事，","北邙山下草芊芊。"]]}
{"id":"8f2b0c6ca8","title":"大言诗","author":"谭峭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["线作长江扇作天，","靸鞵抛向海东边。","蓬莱信道无多路，","只在谭生拄杖前。"],"stanzas":[["线作长江扇作天，","靸鞵抛向海东边。"],["蓬莱信道无多路，","只在谭生拄杖前。"]]}
{"id":"e453b93ba5","title":"大言诗","author":"谭峭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["线大长江扇大天，","屐鞋抛在海东邉。","世间多少闲虫豸，","尽在郯生柱杖前。"],"stanzas":[["线大长江扇大天，","屐鞋抛在海东邉。"],["世间多少闲虫豸，","尽在郯生柱杖前。"]]}
{"id":"bdbdd4760f","title":"句","author":"谭峭","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["云外星霜如走电，","世间娱乐似抛砖。"],"stanzas":[["云外星霜如走电，","世间娱乐似抛砖。"]]}
{"id":"4f7a86d070","title":"望江南词咏鼓","author":"伊用昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["江南鼓，","梭肚两头栾。","钉著不知侵骨髓，","打来只是没心肝，","空腹被人谩。"],"stanzas":[["江南鼓，","梭肚两头栾。"],["钉著不知侵骨髓，","打来只是没心肝，","空腹被人谩。"]]}
{"id":"d57a889c75","title":"题茶陵县门","author":"伊用昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["茶陵一道好长街，","两畔栽柳不栽槐。","夜后不闻更漏鼓，","只听锤芒织草鞋。"],"stanzas":[["茶陵一道好长街，","两畔栽柳不栽槐。"],["夜后不闻更漏鼓，","只听锤芒织草鞋。"]]}
{"id":"d675c589b2","title":"题酒楼壁","author":"伊用昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此生生在此生先，","何事从玄不复玄。","已在淮南鸡犬后，","而今便到玉皇前。"],"stanzas":[["此生生在此生先，","何事从玄不复玄。"],["已在淮南鸡犬后，","而今便到玉皇前。"]]}
{"id":"ec2262cf5c","title":"题游帷观真君殿后","author":"伊用昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日日祥云瑞气连，","侬家应作大神仙。","笔头洒起风雷力，","劒下驱驰造化权。","更与戎夷添礼乐，","永教胡虏绝烽烟。","列仙功业只如此，","直上三清第一天。"],"stanzas":[["日日祥云瑞气连，","侬家应作大神仙。"],["笔头洒起风雷力，","劒下驱驰造化权。"],["更与戎夷添礼乐，","永教胡虏绝烽烟。"],["列仙功业只如此，","直上三清第一天。"]]}
{"id":"79b78cf372","title":"留题阁皂观","author":"伊用昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花洞门前吠似雷，","险声流断俗尘埃。","雨喷山脚毒龙起，","月照松梢孤鹤回。","萝幕秋高添碧翠，","画帘时卷到楼台。","两坛诗客何年去，","去后门关更不开。"],"stanzas":[["花洞门前吠似雷，","险声流断俗尘埃。"],["雨喷山脚毒龙起，","月照松梢孤鹤回。"],["萝幕秋高添碧翠，","画帘时卷到楼台。"],["两坛诗客何年去，","去后门关更不开。"]]}
{"id":"59be89d0a0","title":"湖南闯斋吟","author":"伊用昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁人能识白元君，","上士由来尽见闻。","避世早空南火宅，","植田高种北山云。","鸡能抱卵心常听，","蝉到成形壳自分。","学取大罗些子术，","免教松下作孤坟。"],"stanzas":[["谁人能识白元君，","上士由来尽见闻。"],["避世早空南火宅，","植田高种北山云。"],["鸡能抱卵心常听，","蝉到成形壳自分。"],["学取大罗些子术，","免教松下作孤坟。"]]}
{"id":"17c58fc0fb","title":"游溧阳霞泉寺限白字","author":"许坚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["近枕吴溪与越峰，","前朝恩赐云泉额。","竹林晴见鴈塔高，","石室曾栖几禅伯。","荒碑字没莓苔深，","古池香泛荷花白。","客有经年别故林，","落日啼猨情脉脉。"],"stanzas":[["近枕吴溪与越峰，","前朝恩赐云泉额。"],["竹林晴见鴈塔高，","石室曾栖几禅伯。"],["荒碑字没莓苔深，","古池香泛荷花白。"],["客有经年别故林，","落日啼猨情脉脉。"]]}
{"id":"f1f266efca","title":"幽栖观","author":"许坚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["仙翁上升去，","丹井寄晴壑。","山色接天台，","湖光照寥廓。","玉洞绝无人，","老桧犹栖鹤。","我欲掣青蛇，","他时冲碧落。"],"stanzas":[["仙翁上升去，","丹井寄晴壑。"],["山色接天台，","湖光照寥廓。"],["玉洞绝无人，","老桧犹栖鹤。"],["我欲掣青蛇，","他时冲碧落。"]]}
{"id":"e984054887","title":"题茅山观","author":"许坚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尝恨清风千载郁，","洞天今得恣游遨。","松楸一色古坛静，","鸾鹤不来青汉高。","茅氏井寒丹已化，","玄宗碑断梦仍劳。","分明有个长生路，","休向红尘叹二毛。"],"stanzas":[["尝恨清风千载郁，","洞天今得恣游遨。"],["松楸一色古坛静，","鸾鹤不来青汉高。"],["茅氏井寒丹已化，","玄宗碑断梦仍劳。"],["分明有个长生路，","休向红尘叹二毛。"]]}
{"id":"013ddfd615","title":"题扇","author":"许坚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["哦吟但写胸中妙，","饮酒能忘身后名。","但愿长闲有诗酒，","一溪风月共清明。"],"stanzas":[["哦吟但写胸中妙，","饮酒能忘身后名。"],["但愿长闲有诗酒，","一溪风月共清明。"]]}
{"id":"ac9c494956","title":"上徐舍人铉","author":"许坚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几宵烟月锁楼台，","欲寄侯门荐祢才。","满面尘埃人不识，","谩随流水出山来。"],"stanzas":[["几宵烟月锁楼台，","欲寄侯门荐祢才。"],["满面尘埃人不识，","谩随流水出山来。"]]}
{"id":"f2e1eb81bf","title":"句","author":"许坚","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道既学不得，","仙从何处来？","卧久似慵伸雪项，","立迟犹未整霜衣。"],"stanzas":[["道既学不得，","仙从何处来？","卧久似慵伸雪项，","立迟犹未整霜衣。"]]}
{"id":"ab0f197b99","title":"醉吟","author":"许碏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阆苑花前是醉乡，","踏翻王母九霞觞。","群仙拍手嫌轻薄，","谪向人间作酒狂。"],"stanzas":[["阆苑花前是醉乡，","踏翻王母九霞觞。"],["群仙拍手嫌轻薄，","谪向人间作酒狂。"]]}
{"id":"fd12fce677","title":"题南岳招仙观壁上","author":"许碏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洪𬬻烹锻人性命，","器用不同分皆定。","妖精鬼魅鬬神通，","只自干邪不干正。","黄口小儿初学行，","唯知日月东西生。","还为万灵威圣力，","移月在南日在北。","玉为玉兮石是石，","蕴弃深泥终不易。","邓通饿死严陵贫，","帝王岂是无人力。","丈夫未达莫相侵，","攀龙附凤捐精神。"],"stanzas":[["洪𬬻烹锻人性命，","器用不同分皆定。"],["妖精鬼魅鬬神通，","只自干邪不干正。"],["黄口小儿初学行，","唯知日月东西生。"],["还为万灵威圣力，","移月在南日在北。"],["玉为玉兮石是石，","蕴弃深泥终不易。"],["邓通饿死严陵贫，","帝王岂是无人力。"],["丈夫未达莫相侵，","攀龙附凤捐精神。"]]}
{"id":"572c02d158","title":"武陵春色","author":"张白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武陵春色好，","十二酒家楼。","大醉方回首，","逢人不举头。","是非都不采，","名利混然休。","戴个星冠子，","浮沉逐世流。"],"stanzas":[["武陵春色好，","十二酒家楼。"],["大醉方回首，","逢人不举头。"],["是非都不采，","名利混然休。"],["戴个星冠子，","浮沉逐世流。"]]}
{"id":"10ad14bcd2","title":"赠酒店崔氏","author":"张白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["武陵城里崔家酒，","地上应无天上有。","南游道士饮一斗，","卧向白云深洞口。"],"stanzas":[["武陵城里崔家酒，","地上应无天上有。"],["南游道士饮一斗，","卧向白云深洞口。"]]}
{"id":"7e0dea40c7","title":"哭陆先生","author":"张白","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六亲恸哭还复苏，","我笑先生泪个无。","脱履定归天上去，","空坟留入武陵图。"],"stanzas":[["六亲恸哭还复苏，","我笑先生泪个无。"],["脱履定归天上去，","空坟留入武陵图。"]]}
{"id":"32b21c7e6e","title":"市中狂吟","author":"段谷","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一间茅屋，","尚自修治。","任狂风吹，","连簷破碎。","枓栱斜欹，","看著倒也。","墙壁作散土一堆，","主人翁永不来归。"],"stanzas":[["一间茅屋，","尚自修治。"],["任狂风吹，","连簷破碎。"],["枓栱斜欹，","看著倒也。"],["墙壁作散土一堆，","主人翁永不来归。"]]}
{"id":"eb19e437ab","title":"诗","author":"赵自然","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["常欲栖山岛，","闲眠玉洞寒。","丹哥时引舞，","来去跨云鸾。"],"stanzas":[["常欲栖山岛，","闲眠玉洞寒。"],["丹哥时引舞，","来去跨云鸾。"]]}
{"id":"f1cad42799","title":"大丹诗四首 一","author":"李浩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["混沌未分我独存，","包含四象立乾坤。","还丹须向此中觅，","得此方为至妙门。"],"stanzas":[["混沌未分我独存，","包含四象立乾坤。"],["还丹须向此中觅，","得此方为至妙门。"]]}
{"id":"c3e58c7a0f","title":"大丹诗四首 二","author":"李浩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["煮石烹金炼太元，","神仙不肯等闲传。","人能认得其中理，","夺尽乾坤造化权。"],"stanzas":[["煮石烹金炼太元，","神仙不肯等闲传。"],["人能认得其中理，","夺尽乾坤造化权。"]]}
{"id":"5f5927c29f","title":"大丹诗四首 三","author":"李浩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百首荒辞义亦深，","因传同道决疑心。","华池本是真神水，","神水元来是白金。"],"stanzas":[["百首荒辞义亦深，","因传同道决疑心。"],["华池本是真神水，","神水元来是白金。"]]}
{"id":"2189e51bf4","title":"大丹诗四首 四","author":"李浩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["取将白金为鼎器，","鼎成潜伏汞来侵。","汞入金鼎终年尽，","产出灵砂似太阴。"],"stanzas":[["取将白金为鼎器，","鼎成潜伏汞来侵。"],["汞入金鼎终年尽，","产出灵砂似太阴。"]]}
{"id":"c683f0bb76","title":"自吟","author":"徐钓者","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾见秦皇架石桥，","海神忙迫涨惊潮。","蓬莱隔海虽难到，","直上三清却不遥。"],"stanzas":[["曾见秦皇架石桥，","海神忙迫涨惊潮。"],["蓬莱隔海虽难到，","直上三清却不遥。"]]}
{"id":"5452007088","title":"踏歌","author":"蓝采和","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["踏歌踏歌蓝采和，","世界能几何。","红颜三春树，","流年一掷梭。","古人混混去不返，","今人纷纷来更多。","朝骑鸾凤到碧落，","暮见桑田生白波。","长景明晖在空际，","金银宫阙高嵯峨。"],"stanzas":[["踏歌踏歌蓝采和，","世界能几何。"],["红颜三春树，","流年一掷梭。"],["古人混混去不返，","今人纷纷来更多。"],["朝骑鸾凤到碧落，","暮见桑田生白波。"],["长景明晖在空际，","金银宫阙高嵯峨。"]]}
{"id":"41be921ffb","title":"同沈恭子游虎丘寺有作","author":"清远道士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我本长殷周，","遭罹历秦汉。","四渎与五岳，","名山尽幽窜。","及此寰区中，","始有近峰玩。","近峰何郁郁，","平湖渺弥漫。","吟俯川之阴，","步上山之岸。","山川共澄澈，","光彩交凌乱。","白云蓊欲归，","青松忽消半。","客去川岛静，","人来山鸟散。","谷深中见日，","崖幽晓非旦。","闻子盛游遨，","风流足词翰。","嘉兹好松石，","一言常累叹。","勿谓余鬼神，","忻君共幽赞。"],"stanzas":[["我本长殷周，","遭罹历秦汉。"],["四渎与五岳，","名山尽幽窜。"],["及此寰区中，","始有近峰玩。"],["近峰何郁郁，","平湖渺弥漫。"],["吟俯川之阴，","步上山之岸。"],["山川共澄澈，","光彩交凌乱。"],["白云蓊欲归，","青松忽消半。"],["客去川岛静，","人来山鸟散。"],["谷深中见日，","崖幽晓非旦。"],["闻子盛游遨，","风流足词翰。"],["嘉兹好松石，","一言常累叹。"],["勿谓余鬼神，","忻君共幽赞。"]]}
{"id":"b40d7ab1e6","title":"游春台诗 一","author":"春台仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉幢亘碧虚，","此乃真人居。","裴回仍未进，","邪省犹难除。"],"stanzas":[["玉幢亘碧虚，","此乃真人居。"],["裴回仍未进，","邪省犹难除。"]]}
{"id":"9a8259c9d7","title":"游春台诗 二","author":"春台仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日落烟水黯，","骊珠色岂昏。","寒光射万里，","霜缟遍千门。"],"stanzas":[["日落烟水黯，","骊珠色岂昏。"],["寒光射万里，","霜缟遍千门。"]]}
{"id":"a9b4844368","title":"游春台诗 三","author":"春台仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉魄东方开，","嫦娥逐影来。","洗心兼涤目，","怳若游春台。"],"stanzas":[["玉魄东方开，","嫦娥逐影来。"],["洗心兼涤目，","怳若游春台。"]]}
{"id":"75c99f34ad","title":"游春台诗 四","author":"春台仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清波滔碧天，","乌藏黯黮连。","二仪不辨处，","忽吐清光圆。"],"stanzas":[["清波滔碧天，","乌藏黯黮连。"],["二仪不辨处，","忽吐清光圆。"]]}
{"id":"3304f8161a","title":"游春台诗 五","author":"春台仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乌沈海西岸，","蟾吐天东头。"],"stanzas":[["乌沈海西岸，","蟾吐天东头。"]]}
{"id":"5e216b5a51","title":"游春台诗 六","author":"春台仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤凰三十六，","碧天高太清。","元君夫人蹋云语，","冷风飒飒吹鹅笙。"],"stanzas":[["凤凰三十六，","碧天高太清。"],["元君夫人蹋云语，","冷风飒飒吹鹅笙。"]]}
{"id":"05af43656b","title":"醉吟","author":"酒肆布衣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["阳春时节天气和，","万物芳盛人如何。","素秋时节天地肃，","荣秀丛林立衰促。","有同人世当少年，","壮心仪貌皆俨然。","一旦形羸又发白，","旧游空使泪连连。"],"stanzas":[["阳春时节天气和，","万物芳盛人如何。"],["素秋时节天地肃，","荣秀丛林立衰促。"],["有同人世当少年，","壮心仪貌皆俨然。"],["一旦形羸又发白，","旧游空使泪连连。"]]}
{"id":"359405c884","title":"又吟","author":"酒肆布衣","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有形皆朽孰不知，","休吟春景与秋时。","争如且醉长安酒，","荣华零悴总奚为。"],"stanzas":[["有形皆朽孰不知，","休吟春景与秋时。"],["争如且醉长安酒，","荣华零悴总奚为。"]]}
{"id":"a8d32435b8","title":"嫁女诗 一","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["劝君酒，","为君悲且吟。","自从频见市朝改，","无复瑶池宴乐心。"],"stanzas":[["劝君酒，","为君悲且吟。"],["自从频见市朝改，","无复瑶池宴乐心。"]]}
{"id":"4dd0054fa1","title":"嫁女诗 二","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["奉君酒，","休叹市朝非。","早知无复瑶池兴，","悔驾骅骝草草归。"],"stanzas":[["奉君酒，","休叹市朝非。"],["早知无复瑶池兴，","悔驾骅骝草草归。"]]}
{"id":"b90727c3d1","title":"嫁女诗 三","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["八马回乘汗漫风，","犹思往事憩昭宫。","宴移玄圃情方洽，","乐奏钧天曲未终。","斜汉露凝残月冷，","流霞杯泛曙光红。","昆仑回首不知处，","疑是酒酣魂梦中。"],"stanzas":[["八马回乘汗漫风，","犹思往事憩昭宫。"],["宴移玄圃情方洽，","乐奏钧天曲未终。"],["斜汉露凝残月冷，","流霞杯泛曙光红。"],["昆仑回首不知处，","疑是酒酣魂梦中。"]]}
{"id":"babf3dcb54","title":"嫁女诗 四","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一曲笙歌瑶水滨，","曾留逸足驻征轮。","人间甲子周千岁，","灵境杯觞初一巡。","玉兔银河终不夜，","奇花好树镇长春。","悄知碧海饶词句，","歌向俗流疑误人。"],"stanzas":[["一曲笙歌瑶水滨，","曾留逸足驻征轮。"],["人间甲子周千岁，","灵境杯觞初一巡。"],["玉兔银河终不夜，","奇花好树镇长春。"],["悄知碧海饶词句，","歌向俗流疑误人。"]]}
{"id":"2561bc17d3","title":"嫁女诗 五","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珠露金风下界秋，","汉家陵树冷修修。","当时不得仙桃力，","寻作浮尘飘陇头。"],"stanzas":[["珠露金风下界秋，","汉家陵树冷修修。"],["当时不得仙桃力，","寻作浮尘飘陇头。"]]}
{"id":"f57f45506a","title":"嫁女诗 六","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五十余年四海清，","自亲丹药得长生。","若言尽是仙桃力，","看取神仙簿上名。"],"stanzas":[["五十余年四海清，","自亲丹药得长生。"],["若言尽是仙桃力，","看取神仙簿上名。"]]}
{"id":"cad02e50b0","title":"嫁女诗 七","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月照骊山露泣花，","似悲先帝早升遐。","至今犹有长生鹿，","时绕温泉望翠华。"],"stanzas":[["月照骊山露泣花，","似悲先帝早升遐。"],["至今犹有长生鹿，","时绕温泉望翠华。"]]}
{"id":"ba873c5e5b","title":"嫁女诗 八","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽蓟烟尘别九重，","贵妃汤殿罢歌钟。","中宵扈从无全杖，","大驾苍黄发六龙。","妆匣尚留金翡翠，","暖池犹浸玉芙蓉。","荆榛一闭朝元路，","唯有悲风吹晚松。"],"stanzas":[["幽蓟烟尘别九重，","贵妃汤殿罢歌钟。"],["中宵扈从无全杖，","大驾苍黄发六龙。"],["妆匣尚留金翡翠，","暖池犹浸玉芙蓉。"],["荆榛一闭朝元路，","唯有悲风吹晚松。"]]}
{"id":"c2af8172d0","title":"嫁女诗 九","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上清神女，","玉京仙郎。","乐此今夕，","和鸣凤凰。","凤凰和鸣，","将翱将翔。","与天齐休，","庆流无央。"],"stanzas":[["上清神女，","玉京仙郎。"],["乐此今夕，","和鸣凤凰。"],["凤凰和鸣，","将翱将翔。"],["与天齐休，","庆流无央。"]]}
{"id":"c2a63c4ea3","title":"嫁女诗 十","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉为质兮花为颜，","蝉为鬓兮云为鬟。","何劳傅粉兮施渥丹，","早出娉婷兮缥缈间。"],"stanzas":[["玉为质兮花为颜，","蝉为鬓兮云为鬟。"],["何劳傅粉兮施渥丹，","早出娉婷兮缥缈间。"]]}
{"id":"4e4f43de12","title":"嫁女诗 十一","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水晶帐开银烛明，","风摇珠珮连云清。","休匀红粉饰花态，","早驾双鸾朝玉京。"],"stanzas":[["水晶帐开银烛明，","风摇珠珮连云清。"],["休匀红粉饰花态，","早驾双鸾朝玉京。"]]}
{"id":"060416fc53","title":"嫁女诗 十二","author":"嵩岳诸仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三星在天银河回，","人间曙色东方来。","玉苗琼蕊亦宜夜，","莫使一花冲晓开。"],"stanzas":[["三星在天银河回，","人间曙色东方来。"],["玉苗琼蕊亦宜夜，","莫使一花冲晓开。"]]}
{"id":"c413e33496","title":"吟 一","author":"芙蓉古丈夫　毛女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["饵柏身轻叠嶂间，","是非无意到尘寰。","冠裳暂备论浮世，","一饷云游碧落间。"],"stanzas":[["饵柏身轻叠嶂间，","是非无意到尘寰。"],["冠裳暂备论浮世，","一饷云游碧落间。"]]}
{"id":"ebce2b8d91","title":"吟 二","author":"芙蓉古丈夫　毛女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁知古是与今非，","闲蹑青霞与翠微。","箫管秦楼应寂寂，","彩云空惹薜萝衣。"],"stanzas":[["谁知古是与今非，","闲蹑青霞与翠微。"],["箫管秦楼应寂寂，","彩云空惹薜萝衣。"]]}
{"id":"69ba0b8c93","title":"授炙毂子歌二首 一","author":"希道","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["木津天魂，","金液地魄。","坎离运行宽无成，","金木有数秦晋合。","近効宜六旬，","远期三载阔。"],"stanzas":[["木津天魂，","金液地魄。"],["坎离运行宽无成，","金木有数秦晋合。"],["近効宜六旬，","远期三载阔。"]]}
{"id":"fd4c25d32b","title":"授炙毂子歌二首 二","author":"希道","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魄微入魂牝牡结，","阳呴阴滋神鬼灭。","千歌万赞皆未决，","古往今来抛日月。"],"stanzas":[["魄微入魂牝牡结，","阳呴阴滋神鬼灭。"],["千歌万赞皆未决，","古往今来抛日月。"]]}
{"id":"2f6a58175e","title":"李泌庭黑石诗","author":"隐者","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["神真链形年未足，","化为我子功相续。","丞相瘗之刻玄玉，","仙路何长死何促。"],"stanzas":[["神真链形年未足，","化为我子功相续。"],["丞相瘗之刻玄玉，","仙路何长死何促。"]]}
{"id":"10631c8d80","title":"戏吟","author":"广陵道士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无事到扬州，","相携上酒楼。","药囊为赠别，","千载更何求。"],"stanzas":[["无事到扬州，","相携上酒楼。"],["药囊为赠别，","千载更何求。"]]}
{"id":"c3c667aa96","title":"授马氏女诗","author":"黄冠野夫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["女是寄生枝，","男是冬青木。","冬青驾白鹅，","寄生跨黄鹿。","若遇寇相凌，","稳便抛家族。","早早上三清，","莫候丹砂熟。"],"stanzas":[["女是寄生枝，","男是冬青木。"],["冬青驾白鹅，","寄生跨黄鹿。"],["若遇寇相凌，","稳便抛家族。"],["早早上三清，","莫候丹砂熟。"]]}
{"id":"1aeb070470","title":"歌","author":"蜀中酒阁道人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尾闾不禁沧溟竭，","九转神丹都谩说。","惟有班龙顶上珠，","能补玉堂关下穴。"],"stanzas":[["尾闾不禁沧溟竭，","九转神丹都谩说。"],["惟有班龙顶上珠，","能补玉堂关下穴。"]]}
{"id":"d1d02bba71","title":"吟","author":"章江书生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西去长沙东上船，","思量此事已千年。","长春殿掩无人扫，","满眼梨花哭杜鹃。"],"stanzas":[["西去长沙东上船，","思量此事已千年。"],["长春殿掩无人扫，","满眼梨花哭杜鹃。"]]}
{"id":"bf24c38b0e","title":"示边洞元","author":"萼岭书生","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["邂逅相逢萼岭边，","对倾浮蚁共谈玄。","拟将劒法亲传授，","却为迷人未有缘。"],"stanzas":[["邂逅相逢萼岭边，","对倾浮蚁共谈玄。"],["拟将劒法亲传授，","却为迷人未有缘。"]]}
{"id":"d1b867be9e","title":"示胡二郎歌","author":"成都醉道士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲究丹砂理，","幽玄无处寻。","不离铅与汞，","无出水中金。","金欲炼时须得水，","水遇土兮终不起。","但知火候不参差，","自得还丹微妙旨。","人世分明知有死，","刚只留心恋朱紫。","岂知光景片时间，","将谓人生长似此。","何不回心师至道？","免逐年光虚自老。","临樽只解醉醺酣，","对镜方知渐枯槁。","二郎切切听我语，","仙乡咫尺无寒暑。","与君说尽只如斯，","莫恋娇奢不肯去。","感君恩义言方苦，","火急回心求出路。","吟成数句赠君辞，","不觉便成今与古。"],"stanzas":[["欲究丹砂理，","幽玄无处寻。"],["不离铅与汞，","无出水中金。"],["金欲炼时须得水，","水遇土兮终不起。"],["但知火候不参差，","自得还丹微妙旨。"],["人世分明知有死，","刚只留心恋朱紫。"],["岂知光景片时间，","将谓人生长似此。"],["何不回心师至道？","免逐年光虚自老。"],["临樽只解醉醺酣，","对镜方知渐枯槁。"],["二郎切切听我语，","仙乡咫尺无寒暑。"],["与君说尽只如斯，","莫恋娇奢不肯去。"],["感君恩义言方苦，","火急回心求出路。"],["吟成数句赠君辞，","不觉便成今与古。"]]}
{"id":"5063c38698","title":"贻白永年诗","author":"樵夫","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清秋无所事，","乘露出遥天。","凭杖樵人语，","相期白永年。"],"stanzas":[["清秋无所事，","乘露出遥天。"],["凭杖樵人语，","相期白永年。"]]}
{"id":"048f3f9bee","title":"留诗","author":"李公佐仆","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我有衣中珠，","不嫌衣上尘。","我有长生理，","不厌有生身。","江南神仙窟，","吾当混其真。","不嫌市井諠，","来救世间人。","苏子迹已往，","颛蒙事可亲。","莫言东海变，","天地有长春。"],"stanzas":[["我有衣中珠，","不嫌衣上尘。"],["我有长生理，","不厌有生身。"],["江南神仙窟，","吾当混其真。"],["不嫌市井諠，","来救世间人。"],["苏子迹已往，","颛蒙事可亲。"],["莫言东海变，","天地有长春。"]]}
{"id":"ea45ede72a","title":"酒尽君莫沽","author":"木客","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["酒尽君莫沽，","壶倾我当发。","城市多嚣尘，","还山弄明月。"],"stanzas":[["酒尽君莫沽，","壶倾我当发。"],["城市多嚣尘，","还山弄明月。"]]}
{"id":"34981a2aee","title":"西山吟","author":"许大","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自从明府归仙后，","出入尘寰直至今。","不是藏名混时俗，","卖药沽酒要安心。"],"stanzas":[["自从明府归仙后，","出入尘寰直至今。"],["不是藏名混时俗，","卖药沽酒要安心。"]]}
{"id":"4e2697d31e","title":"东洛货丹","author":"许学士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三千功满去升天，","一住人间数百年。","华表他时却归日，","沧溟应恐变桑田。"],"stanzas":[["三千功满去升天，","一住人间数百年。"],["华表他时却归日，","沧溟应恐变桑田。"]]}
{"id":"0ee8e564b7","title":"天关回到世吟","author":"许学士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九霄云路奇哉险，","曾把冲身入太和。","今日东归浑似梦，","望崖回首隔天波。"],"stanzas":[["九霄云路奇哉险，","曾把冲身入太和。"],["今日东归浑似梦，","望崖回首隔天波。"]]}
{"id":"ebe9d3afbd","title":"送青城丈人酒","author":"紫微孙处士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深羡青城好洞天，","白龙一觉已千年。","铺云枕石长松下，","朝退看书尽日眠。"],"stanzas":[["深羡青城好洞天，","白龙一觉已千年。"],["铺云枕石长松下，","朝退看书尽日眠。"]]}
{"id":"33eff14232","title":"送王懿昌酒","author":"紫微孙处士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["将知骨分到仙乡，","酒饮金华玉液浆。","莫道人间只如此，","回头已是一年强。"],"stanzas":[["将知骨分到仙乡，","酒饮金华玉液浆。"],["莫道人间只如此，","回头已是一年强。"]]}
{"id":"60e09e8773","title":"送太乙真君酒","author":"青城丈人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["峨嵋仙府静沈沈，","玉液金华莫厌斟。","凡客欲知真一洞，","劒门西北五云深。"],"stanzas":[["峨嵋仙府静沈沈，","玉液金华莫厌斟。"],["凡客欲知真一洞，","劒门西北五云深。"]]}
{"id":"6aa9fa2fc6","title":"送紫微处士酒","author":"太乙真君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此中何必羡青城，","玉树云栖不记名。","闷即乘龙游紫府，","北辰南斗逐君行。"],"stanzas":[["此中何必羡青城，","玉树云栖不记名。"],["闷即乘龙游紫府，","北辰南斗逐君行。"]]}
{"id":"c825a548a7","title":"题法云寺双桧","author":"方壶居士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢郎双桧绿于云，","昏晓浓阴色未分。","若竝毫宫仙鹿迹，","定知高峭不如君。"],"stanzas":[["谢郎双桧绿于云，","昏晓浓阴色未分。"],["若竝毫宫仙鹿迹，","定知高峭不如君。"]]}
{"id":"a8b6e434ad","title":"隋堤词","author":"方壶居士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尝忆江都大业秋，","曾随銮跸戏龙舟。","伤心一觉兴亡梦，","堤柳无情识世愁。"],"stanzas":[["尝忆江都大业秋，","曾随銮跸戏龙舟。"],["伤心一觉兴亡梦，","堤柳无情识世愁。"]]}
{"id":"d80a1bf19f","title":"画地吟","author":"太白山玄士","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["学得丹青数万年，","人间几度变桑田。","桑田虽变丹青在，","谁向丹青合得仙。"],"stanzas":[["学得丹青数万年，","人间几度变桑田。"],["桑田虽变丹青在，","谁向丹青合得仙。"]]}
{"id":"9d9c87a72c","title":"货丹吟","author":"邻道场人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寻仙何必三山上，","但使神存九窍清。","炼得绵绵元气定，","自然不食亦长生。"],"stanzas":[["寻仙何必三山上，","但使神存九窍清。"],["炼得绵绵元气定，","自然不食亦长生。"]]}
{"id":"e31a438f90","title":"灵响词 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此响非俗响，","心知是灵仙。","不曾离耳里，","高下如秋蝉。"],"stanzas":[["此响非俗响，","心知是灵仙。"],["不曾离耳里，","高下如秋蝉。"]]}
{"id":"48b75465ee","title":"灵响词 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["入夜声则厉，","在昼声则微。","神灵斥众恶，","与我作风威。"],"stanzas":[["入夜声则厉，","在昼声则微。"],["神灵斥众恶，","与我作风威。"]]}
{"id":"3dd10a7d73","title":"灵响词 三","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妙响无住时，","昼夜常轮回。","那是偶然事，","上界特使来。"],"stanzas":[["妙响无住时，","昼夜常轮回。"],["那是偶然事，","上界特使来。"]]}
{"id":"1f29a01534","title":"灵响词 四","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何以辨灵应，","事须得梯媒。","自从灵响降，","如有真人来。"],"stanzas":[["何以辨灵应，","事须得梯媒。"],["自从灵响降，","如有真人来。"]]}
{"id":"dd979408f0","title":"灵响词 五","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["存念长在心，","展转无停音。","可怜清爽夜，","静听秋蝉吟。"],"stanzas":[["存念长在心，","展转无停音。"],["可怜清爽夜，","静听秋蝉吟。"]]}
{"id":"cdbfc47a5a","title":"度世古玄歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["始青之下月与日，","两半同升合为一。","大如弹丸甘如蜜，","出彼玉堂入金室，","子若得之慎勿失。"],"stanzas":[["始青之下月与日，","两半同升合为一。"],["大如弹丸甘如蜜，","出彼玉堂入金室，","子若得之慎勿失。"]]}
{"id":"797e4ebcf3","title":"鬻丹砂醉吟","author":"刘道昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心田但使灵芝长，","气海常教法水朝。","功满自然留不住，","更将何物驭丹霄。"],"stanzas":[["心田但使灵芝长，","气海常教法水朝。"],["功满自然留不住，","更将何物驭丹霄。"]]}
{"id":"c3c5d67fc0","title":"龟市告别","author":"刘道昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["还丹功满气成胎，","九百年来混俗埃。","自此三山一归去，","无因重到世间来。"],"stanzas":[["还丹功满气成胎，","九百年来混俗埃。"],["自此三山一归去，","无因重到世间来。"]]}
{"id":"8d9f64a8df","title":"摘紫芝","author":"李太玄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶游洞府到芝田，","星月茫茫欲曙天。","虽则似离尘世了，","不知何处偶真仙。"],"stanzas":[["偶游洞府到芝田，","星月茫茫欲曙天。"],["虽则似离尘世了，","不知何处偶真仙。"]]}
{"id":"f98833e1ff","title":"玉女舞霓裳","author":"李太玄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["舞势随风散复收，","歌声似磬韵还幽。","千回赴节填词处，","娇眼如波入鬓流。"],"stanzas":[["舞势随风散复收，","歌声似磬韵还幽。"],["千回赴节填词处，","娇眼如波入鬓流。"]]}
{"id":"7ceca706fc","title":"玩月诗 一","author":"曲龙山仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曲龙桥顶玩瀛洲，","凡骨空陪汗漫流。","不假丹梯蹑霄汉，","水晶盘冷桂花秋。"],"stanzas":[["曲龙桥顶玩瀛洲，","凡骨空陪汗漫流。"],["不假丹梯蹑霄汉，","水晶盘冷桂花秋。"]]}
{"id":"67294ad47e","title":"玩月诗 二","author":"曲龙山仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["月砌瑶阶泉滴乳，","玉箫催凤和烟舞。","青城丈人何处游，","玄鹤唳天云一缕。"],"stanzas":[["月砌瑶阶泉滴乳，","玉箫催凤和烟舞。"],["青城丈人何处游，","玄鹤唳天云一缕。"]]}
{"id":"8fd687c356","title":"玩月诗 三","author":"曲龙山仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["造化天桥碧海东，","玉轮还过辗晴虹。","霓襟似拂瀛洲顶，","颢气潜消橐籥中。"],"stanzas":[["造化天桥碧海东，","玉轮还过辗晴虹。"],["霓襟似拂瀛洲顶，","颢气潜消橐籥中。"]]}
{"id":"620171a50a","title":"玩月诗 四","author":"曲龙山仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危桥横石架云端，","跨鹿登临景象宽。","颢魄洗烟澄碧落，","桂花低拂玉簪寒。"],"stanzas":[["危桥横石架云端，","跨鹿登临景象宽。"],["颢魄洗烟澄碧落，","桂花低拂玉簪寒。"]]}
{"id":"900676a98f","title":"句","author":"陈复休","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜坐空庭月色微，","一树寒梅发两枝。"],"stanzas":[["夜坐空庭月色微，","一树寒梅发两枝。"]]}
{"id":"e262e3bd92","title":"句","author":"郑冠卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不缘过去行方便，","安得今朝会碧虚。"],"stanzas":[["不缘过去行方便，","安得今朝会碧虚。"]]}
{"id":"c61187740e","title":"句","author":"陈蓬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["竹篱疎见浦，","茅屋漏通星。"],"stanzas":[["竹篱疎见浦，","茅屋漏通星。"]]}
{"id":"672e144df7","title":"句","author":"伊梦昌","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["惟有松杉空弄月，","更无云鹤暗迷人。","露凝金盏滴残酒，","檀点佳人喷异香。"],"stanzas":[["惟有松杉空弄月，","更无云鹤暗迷人。"],["露凝金盏滴残酒，","檀点佳人喷异香。"]]}
{"id":"f0ac00ffd9","title":"与薛昭合婚诗 一","author":"张云容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["脸花不绽几含幽，","今夕阳春独换秋。","我守孤灯无白日，","寒云陇上更添愁。"],"stanzas":[["脸花不绽几含幽，","今夕阳春独换秋。"],["我守孤灯无白日，","寒云陇上更添愁。"]]}
{"id":"0b0ca2a96d","title":"与薛昭合婚诗 二","author":"张云容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["幽谷啼莺整羽翰，","犀沈玉冷自长叹。","月华不向扃泉户，","露滴松枝一夜寒。"],"stanzas":[["幽谷啼莺整羽翰，","犀沈玉冷自长叹。"],["月华不向扃泉户，","露滴松枝一夜寒。"]]}
{"id":"ea1a966561","title":"与薛昭合婚诗 三","author":"张云容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["韶光不见分成尘，","曾饵金丹忽有神。","不意薛生携旧律，","独开幽谷一枝春。"],"stanzas":[["韶光不见分成尘，","曾饵金丹忽有神。"],["不意薛生携旧律，","独开幽谷一枝春。"]]}
{"id":"bf9893edb1","title":"与薛昭合婚诗 四","author":"张云容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["误入宫垣漏网人，","月华静洗玉阶尘。","自疑飞到蓬莱顶，","琼艳三枝半夜春。"],"stanzas":[["误入宫垣漏网人，","月华静洗玉阶尘。"],["自疑飞到蓬莱顶，","琼艳三枝半夜春。"]]}
{"id":"b3ac084a13","title":"留别卢陲","author":"崔少玄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得之一元，","匪受自天。","太老之真，","无上之僊。","光含影藏，","形于自然。","真安匪求，","神之久留。","淑美其真，","体性刚柔。","丹霄碧虚，","上圣之俦。","百岁之后，","空余坟丘。"],"stanzas":[["得之一元，","匪受自天。"],["太老之真，","无上之僊。"],["光含影藏，","形于自然。"],["真安匪求，","神之久留。"],["淑美其真，","体性刚柔。"],["丹霄碧虚，","上圣之俦。"],["百岁之后，","空余坟丘。"]]}
{"id":"b2cec3ee99","title":"歌","author":"戚逍遥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["笑看沧海欲成尘，","王母花前别众真。","千岁却归天上去，","一心珍重世间人。"],"stanzas":[["笑看沧海欲成尘，","王母花前别众真。"],["千岁却归天上去，","一心珍重世间人。"]]}
{"id":"b7aab62f98","title":"锦城春望","author":"卓英英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["和风装点锦城春，","细雨如丝压玉尘。","漫把诗情访奇景，","艳花浓酒属闲人。"],"stanzas":[["和风装点锦城春，","细雨如丝压玉尘。"],["漫把诗情访奇景，","艳花浓酒属闲人。"]]}
{"id":"ee1599cce6","title":"理笙","author":"卓英英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["频倚银屏理凤笙，","调中幽意起春情。","因思往事成惆怅，","不得缑山和一声。"],"stanzas":[["频倚银屏理凤笙，","调中幽意起春情。"],["因思往事成惆怅，","不得缑山和一声。"]]}
{"id":"93a84b9849","title":"游福感寺荅少年","author":"卓英英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["牡丹未及开时节，","况是秋风莫近前。","留待来年二三月，","一枝和露压神仙。"],"stanzas":[["牡丹未及开时节，","况是秋风莫近前。"],["留待来年二三月，","一枝和露压神仙。"]]}
{"id":"bd72c6037e","title":"荅玄士","author":"卓英英","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["数载幽栏种牡丹，","裹香包艳待神仙。","神仙既有丹青术，","携取何妨入洞天。"],"stanzas":[["数载幽栏种牡丹，","裹香包艳待神仙。"],["神仙既有丹青术，","携取何妨入洞天。"]]}
{"id":"1a6a7a9a2f","title":"和卓英英锦城春望","author":"眉娘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蚕市初开处处春，","九衢明艳起香尘。","世间总有浮华事，","争及仙山出世人。"],"stanzas":[["蚕市初开处处春，","九衢明艳起香尘。"],["世间总有浮华事，","争及仙山出世人。"]]}
{"id":"68416e1f0f","title":"和卓英英理笙","author":"眉娘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但于闺阁熟吹笙，","太白真仙自有情。","他日丹霄骖白凤，","何愁子晋不闻声。"],"stanzas":[["但于闺阁熟吹笙，","太白真仙自有情。"],["他日丹霄骖白凤，","何愁子晋不闻声。"]]}
{"id":"71e3b864b1","title":"太白山玄士画地吟","author":"眉娘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["学得丹青数万年，","人间几度变桑田。","桑田虽变丹青在，","谁向丹青合得仙。"],"stanzas":[["学得丹青数万年，","人间几度变桑田。"],["桑田虽变丹青在，","谁向丹青合得仙。"]]}
{"id":"f2dd3a0d90","title":"荅张郁歌 一","author":"洛川仙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["彩云入帝乡，","白鹤又回翔。","久留深不可，","蓬岛路遐长。"],"stanzas":[["彩云入帝乡，","白鹤又回翔。"],["久留深不可，","蓬岛路遐长。"]]}
{"id":"7182ec42c2","title":"荅张郁歌 二","author":"洛川仙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["空爱长生术，","不是长生人。","今日洛川别，","可惜洞中春。"],"stanzas":[["空爱长生术，","不是长生人。"],["今日洛川别，","可惜洞中春。"]]}
{"id":"298cf0ccb6","title":"张郁洛川沿步吟","author":"洛川仙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浮生如梦能几何，","浮生复更忧患多。","无人与我长生术，","洛川春日且长歌。"],"stanzas":[["浮生如梦能几何，","浮生复更忧患多。"],["无人与我长生术，","洛川春日且长歌。"]]}
{"id":"d2f56b4555","title":"题玉壶赠元柳二子","author":"南溟夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["来从一叶舟中来，","去向百花桥上去。","若到人间扣玉壶，","鸳鸯自解分明语。"],"stanzas":[["来从一叶舟中来，","去向百花桥上去。"],["若到人间扣玉壶，","鸳鸯自解分明语。"]]}
{"id":"2d151b0906","title":"会真诗 一","author":"云台峰五女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人世徒纷扰，","其生似梦华。","谁言今昔里，","俯首视云霞。"],"stanzas":[["人世徒纷扰，","其生似梦华。"],["谁言今昔里，","俯首视云霞。"]]}
{"id":"57497ceb12","title":"会真诗 二","author":"云台峰五女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几劫澄烦思，","今身仅小成。","誓将云外隐，","不向世间存。"],"stanzas":[["几劫澄烦思，","今身仅小成。"],["誓将云外隐，","不向世间存。"]]}
{"id":"cfdeb94317","title":"会真诗 三","author":"云台峰五女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绰约离尘世，","从容上太清。","云衣无绽日，","鹤驾没遥程。"],"stanzas":[["绰约离尘世，","从容上太清。"],["云衣无绽日，","鹤驾没遥程。"]]}
{"id":"53c5a4166e","title":"会真诗 四","author":"云台峰五女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["华岳无三尺，","东瀛仅一杯。","入云骑彩凤，","歌舞上蓬莱。"],"stanzas":[["华岳无三尺，","东瀛仅一杯。"],["入云骑彩凤，","歌舞上蓬莱。"]]}
{"id":"3b579a53e6","title":"会真诗 五","author":"云台峰五女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共作云山侣，","俱辞世界尘。","静思前日事，","抛却几年身。"],"stanzas":[["共作云山侣，","俱辞世界尘。"],["静思前日事，","抛却几年身。"]]}
{"id":"82ed93524b","title":"仙诗五首 一","author":"吴清妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["道启真心觉渐清，","天教绝粒应精诚。","云外仙歌笙管合，","花间风引步虚声。"],"stanzas":[["道启真心觉渐清，","天教绝粒应精诚。"],["云外仙歌笙管合，","花间风引步虚声。"]]}
{"id":"4b153c7627","title":"仙诗五首 二","author":"吴清妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["□□□□□□□，","□君隐处当一星。","□□莲花山头饭，","黄精仙人掌上经。"],"stanzas":[["□□□□□□□，","□君隐处当一星。"],["□□莲花山头饭，","黄精仙人掌上经。"]]}
{"id":"a136215204","title":"仙诗五首 三","author":"吴清妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飞鸟莫到人莫攀，","一隐十年不下山。","袖中短书谁为达，","华山道士卖药还。"],"stanzas":[["飞鸟莫到人莫攀，","一隐十年不下山。"],["袖中短书谁为达，","华山道士卖药还。"]]}
{"id":"0bf20f362d","title":"仙诗五首 四","author":"吴清妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日落焚香坐醮坛，","庭花露湿渐更阑。","净水仙童调玉液，","春宵羽客化金丹。"],"stanzas":[["日落焚香坐醮坛，","庭花露湿渐更阑。"],["净水仙童调玉液，","春宵羽客化金丹。"]]}
{"id":"ee46aa295d","title":"仙诗五首 五","author":"吴清妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["摄念精思引彩霞，","焚香虚室对烟花。","道合云霄游紫府，","湛然真境瑞皇家。"],"stanzas":[["摄念精思引彩霞，","焚香虚室对烟花。"],["道合云霄游紫府，","湛然真境瑞皇家。"]]}
{"id":"4affcc26f7","title":"赠封陟","author":"上元夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谪居蓬岛别瑶池，","春媚烟花有所思。","为爱君心能洁白，","愿操箕帚奉屏帏。"],"stanzas":[["谪居蓬岛别瑶池，","春媚烟花有所思。"],["为爱君心能洁白，","愿操箕帚奉屏帏。"]]}
{"id":"d7e9de2935","title":"再赠","author":"上元夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弄玉有夫皆得道，","刘纲兼室尽登仙。","君能仔细窥朝露，","须逐云车拜洞天。"],"stanzas":[["弄玉有夫皆得道，","刘纲兼室尽登仙。"],["君能仔细窥朝露，","须逐云车拜洞天。"]]}
{"id":"4df89a0133","title":"留别","author":"上元夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["萧郎不顾凤楼人，","云涩回车泪脸新。","愁想蓬瀛归去路，","难窥旧苑碧桃春。"],"stanzas":[["萧郎不顾凤楼人，","云涩回车泪脸新。"],["愁想蓬瀛归去路，","难窥旧苑碧桃春。"]]}
{"id":"5337752ede","title":"题寺廊柱 一","author":"慈恩塔院女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["皇子陂头好月明，","忘却华筵到晓行。","烟收山低翠黛横，","折得荷花远恨生。"],"stanzas":[["皇子陂头好月明，","忘却华筵到晓行。"],["烟收山低翠黛横，","折得荷花远恨生。"]]}
{"id":"4029ca44b2","title":"题寺廊柱 二","author":"慈恩塔院女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湖水团团夜如镜，","碧树红花相掩映。","北斗阑干移晓柄，","有似佳期常不定。"],"stanzas":[["湖水团团夜如镜，","碧树红花相掩映。"],["北斗阑干移晓柄，","有似佳期常不定。"]]}
{"id":"3faf6a397f","title":"后土夫人","author":"蜀宫群仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶引群仙到世间，","熏风殿里醉华筵。","等闲贪赏不归去，","愁杀韦郎一觉眠。"],"stanzas":[["偶引群仙到世间，","熏风殿里醉华筵。"],["等闲贪赏不归去，","愁杀韦郎一觉眠。"]]}
{"id":"a0210fe30c","title":"王母","author":"蜀宫群仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沧海成尘几万秋，","碧桃花发长春愁。","不来便是数千载，","周穆汉皇何处游。"],"stanzas":[["沧海成尘几万秋，","碧桃花发长春愁。"],["不来便是数千载，","周穆汉皇何处游。"]]}
{"id":"8f471eab47","title":"麻姑","author":"蜀宫群仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世间何事不潸然，","得失人情命不延。","适向蔡家厅上饮，","回头已见一千年。"],"stanzas":[["世间何事不潸然，","得失人情命不延。"],["适向蔡家厅上饮，","回头已见一千年。"]]}
{"id":"f3c22652aa","title":"上元夫人","author":"蜀宫群仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["思量往事一愁容，","阿母曾邀到汉宫。","城阙不存人不见，","茂陵荒草恨无穷。"],"stanzas":[["思量往事一愁容，","阿母曾邀到汉宫。"],["城阙不存人不见，","茂陵荒草恨无穷。"]]}
{"id":"c36db97f42","title":"弄玉","author":"蜀宫群仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["采凤飞来到禁闱，","便随王母驻瑶池。","如今记得秦楼上，","偷见萧郎恼妾时。"],"stanzas":[["采凤飞来到禁闱，","便随王母驻瑶池。"],["如今记得秦楼上，","偷见萧郎恼妾时。"]]}
{"id":"8be39c4f7d","title":"太真","author":"蜀宫群仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春梦悠扬生下界，","一堪成笑一堪悲。","马嵬不是无情地，","自遇蓬莱睡觉时。"],"stanzas":[["春梦悠扬生下界，","一堪成笑一堪悲。"],["马嵬不是无情地，","自遇蓬莱睡觉时。"]]}
{"id":"1a3104e05d","title":"赠郭翰二首 一","author":"织女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["河汉虽云阔，","三秋尚有期。","情人终已矣，","良㑹更何时。"],"stanzas":[["河汉虽云阔，","三秋尚有期。"],["情人终已矣，","良㑹更何时。"]]}
{"id":"c2914edcac","title":"赠郭翰二首 二","author":"织女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱阁临清溪，","琼宫衔紫房。","佳情期在此，","只是断人肠。"],"stanzas":[["朱阁临清溪，","琼宫衔紫房。"],["佳情期在此，","只是断人肠。"]]}
{"id":"0c09898fd2","title":"郭翰酬织女 一","author":"织女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人世将天上，","由来不可期。","谁知一回顾，","更作两相思。"],"stanzas":[["人世将天上，","由来不可期。"],["谁知一回顾，","更作两相思。"]]}
{"id":"7e0be0bbb9","title":"郭翰酬织女 二","author":"织女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赠枕犹香泽，","啼衣尚泪痕。","玉颜霄汉里，","空有往来魂。"],"stanzas":[["赠枕犹香泽，","啼衣尚泪痕。"],["玉颜霄汉里，","空有往来魂。"]]}
{"id":"7cf639c147","title":"书任生案 一","author":"嵩山女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我本籍上清，","谪居游五岳。","以君无俗累，","来劝神仙学。"],"stanzas":[["我本籍上清，","谪居游五岳。"],["以君无俗累，","来劝神仙学。"]]}
{"id":"a2d8ab1760","title":"书任生案 二","author":"嵩山女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["葛洪还有妇，","王母亦有夫。","神仙尽灵匹，","君意合何如。"],"stanzas":[["葛洪还有妇，","王母亦有夫。"],["神仙尽灵匹，","君意合何如。"]]}
{"id":"1a3f372ac9","title":"临去书赠","author":"嵩山女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君子既执迷，","无由达情素。","明月海山上，","秋风独归去。"],"stanzas":[["君子既执迷，","无由达情素。"],["明月海山上，","秋风独归去。"]]}
{"id":"bb5b971103","title":"与赵旭叩柱歌","author":"青童","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白云飘飘星汉斜，","独行窈窕浮云车。","仙郎独邀青童君，","结情罗帐连心花。"],"stanzas":[["白云飘飘星汉斜，","独行窈窕浮云车。"],["仙郎独邀青童君，","结情罗帐连心花。"]]}
{"id":"bef15b801b","title":"题壁","author":"观梅女仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南枝向暖北枝寒。","一种春花有两般，","凭仗高楼莫吹笛。","大家留取倚阑看。"],"stanzas":[["南枝向暖北枝寒。"],["一种春花有两般，","凭仗高楼莫吹笛。"],["大家留取倚阑看。"]]}
{"id":"a3f6d42004","title":"歌","author":"吴彩鸾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["若能相伴陟仙坛，","应得文箫驾彩鸾。","自有绣襦并甲帐，","瑶台不怕雪霜寒。"],"stanzas":[["若能相伴陟仙坛，","应得文箫驾彩鸾。"],["自有绣襦并甲帐，","瑶台不怕雪霜寒。"]]}
{"id":"75a96933b8","title":"临化绝句","author":"王氏女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玩水登山无足时，","诸仙频下听吟诗。","此心不恋居人世，","唯见天边双鹤飞。"],"stanzas":[["玩水登山无足时，","诸仙频下听吟诗。"],["此心不恋居人世，","唯见天边双鹤飞。"]]}
{"id":"79a153707e","title":"赠华山游人 一","author":"毛女正美","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["药苗不满笥，","又更上危巅。","回首归去路，","相将入翠烟。"],"stanzas":[["药苗不满笥，","又更上危巅。"],["回首归去路，","相将入翠烟。"]]}
{"id":"691173713f","title":"赠华山游人 二","author":"毛女正美","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾折松枝为宝栉，","又编栗叶代罗襦。","有时问却秦宫事，","笑撚山花望太虚。"],"stanzas":[["曾折松枝为宝栉，","又编栗叶代罗襦。"],["有时问却秦宫事，","笑撚山花望太虚。"]]}
{"id":"970f0dd690","title":"在紫霄夫人席上作","author":"桃花夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔时训子西河上，","汉使经过问妾缘。","自到仙山不知老，","凡间唤作几千年。"],"stanzas":[["昔时训子西河上，","汉使经过问妾缘。"],["自到仙山不知老，","凡间唤作几千年。"]]}
{"id":"f02690d020","title":"荅孙玄照","author":"王仙仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸳鸯相见不相随，","笼里笼前整羽衣。","但得他时人放去，","水中长作一双飞。"],"stanzas":[["鸳鸯相见不相随，","笼里笼前整羽衣。"],["但得他时人放去，","水中长作一双飞。"]]}
{"id":"c9480a2ed4","title":"孙玄照琴中歌赠王仙仙","author":"王仙仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相如曾作凤兮吟，","昔被文君会此音。","今日孤鸾还独语，","痛哉仙子不弹琴。"],"stanzas":[["相如曾作凤兮吟，","昔被文君会此音。"],["今日孤鸾还独语，","痛哉仙子不弹琴。"]]}
{"id":"c754936ae5","title":"临刑赋","author":"杨损","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["圣主何曾识仲都，","可嗟社稷在须臾。","市东便是神仙窟，","何必乘舟泛五湖。"],"stanzas":[["圣主何曾识仲都，","可嗟社稷在须臾。"],["市东便是神仙窟，","何必乘舟泛五湖。"]]}
{"id":"a074c3690e","title":"别遥见诗","author":"妙女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["手攀桥柱立，","滴泪天河满。"],"stanzas":[["手攀桥柱立，","滴泪天河满。"]]}
{"id":"b16f3b4a29","title":"宴柳毅诗 一","author":"洞庭龙君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["大天苍苍兮大地茫茫，","人各有志兮何可思量。","狐神鼠圣兮薄社依墙，","雷霆一发兮其孰敢当。","荷贞人兮信义长，","令骨肉兮还故乡，","永言惭愧兮何时忘。"],"stanzas":[["大天苍苍兮大地茫茫，","人各有志兮何可思量。"],["狐神鼠圣兮薄社依墙，","雷霆一发兮其孰敢当。"],["荷贞人兮信义长，","令骨肉兮还故乡，","永言惭愧兮何时忘。"]]}
{"id":"c56beb618b","title":"宴柳毅诗 二","author":"洞庭龙君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上天配合兮生死有途，","此不当妇兮彼不当夫。","腹心辛苦兮泾水之隅，","风霜满鬓兮雨雪罗襦。","赖明公兮引素书，","令肉骨兮家如初，","永言珍重兮无时无。"],"stanzas":[["上天配合兮生死有途，","此不当妇兮彼不当夫。"],["腹心辛苦兮泾水之隅，","风霜满鬓兮雨雪罗襦。"],["赖明公兮引素书，","令肉骨兮家如初，","永言珍重兮无时无。"]]}
{"id":"5a23600a4a","title":"宴柳毅诗 三","author":"洞庭龙君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧云悠悠兮泾水东流，","伤嗟美人兮雨泣花愁。","尺书远达兮以解君忧，","哀冤果雪兮还处其休。","荷君和雅兮感甘羞，","山家寂寞兮难久留，","欲将辞去兮悲绸缪。"],"stanzas":[["碧云悠悠兮泾水东流，","伤嗟美人兮雨泣花愁。"],["尺书远达兮以解君忧，","哀冤果雪兮还处其休。"],["荷君和雅兮感甘羞，","山家寂寞兮难久留，","欲将辞去兮悲绸缪。"]]}
{"id":"8f61da5bff","title":"铸镜歌","author":"龙护老人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盘龙盘龙，","隐于镜中。","分野有象，","变化无穷。","兴云吐雾，","行雨生风。","上清仙子，","来献圣聪。"],"stanzas":[["盘龙盘龙，","隐于镜中。"],["分野有象，","变化无穷。"],["兴云吐雾，","行雨生风。"],["上清仙子，","来献圣聪。"]]}
{"id":"b32cfa5260","title":"示韦泛禄命","author":"冥吏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["前阳复后杨，","后杨年年强，","七月之节归玄乡。"],"stanzas":[["前阳复后杨，","后杨年年强，","七月之节归玄乡。"]]}
{"id":"d12ec7d42b","title":"赠僧","author":"滕传胤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["卓立不求名出家，","长怀片志在青霞。","今日英雄气冲盖，","谁能久坐宝莲花。"],"stanzas":[["卓立不求名出家，","长怀片志在青霞。"],["今日英雄气冲盖，","谁能久坐宝莲花。"]]}
{"id":"8329ef6fd0","title":"赠人","author":"滕传胤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平生才不足，","立身信有余。","自叹无大故，","君子莫相疎。"],"stanzas":[["平生才不足，","立身信有余。"],["自叹无大故，","君子莫相疎。"]]}
{"id":"e3aab1e853","title":"郑锋宅神诗 一","author":"滕传胤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浦口潮来初淼漫，","莲舟摇飏采花难。","春心不惬空归去，","会待潮回更折看。"],"stanzas":[["浦口潮来初淼漫，","莲舟摇飏采花难。"],["春心不惬空归去，","会待潮回更折看。"]]}
{"id":"b5d5880fb8","title":"郑锋宅神诗 二","author":"滕传胤","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忽然湖上片云飞，","不觉舟中雨湿衣。","折得莲花浑忘却，","空将荷叶盖头归。"],"stanzas":[["忽然湖上片云飞，","不觉舟中雨湿衣。"],["折得莲花浑忘却，","空将荷叶盖头归。"]]}
{"id":"45bd9e5edc","title":"与郑德璘奇遇诗 一","author":"水府君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["物触轻舟心自知，","风恬烟静月光微。","夜深江上解愁思，","拾得红蕖香惹衣。"],"stanzas":[["物触轻舟心自知，","风恬烟静月光微。"],["夜深江上解愁思，","拾得红蕖香惹衣。"]]}
{"id":"16f6056612","title":"与郑德璘奇遇诗 二","author":"水府君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["纤手垂钩对水窗，","红蕖秋色艳长江。","既能解珮投交甫，","更有明珠乞一双。"],"stanzas":[["纤手垂钩对水窗，","红蕖秋色艳长江。"],["既能解珮投交甫，","更有明珠乞一双。"]]}
{"id":"6eb38ba106","title":"与郑德璘奇遇诗 三","author":"水府君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湖面狂风且莫吹，","浪花初绽月光微。","沈潜暗想横波泪，","得共鲛人相对垂。"],"stanzas":[["湖面狂风且莫吹，","浪花初绽月光微。"],["沈潜暗想横波泪，","得共鲛人相对垂。"]]}
{"id":"f693a26355","title":"与郑德璘奇遇诗 四","author":"水府君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洞庭风软荻花秋，","新没青娥细浪愁。","泪滴白苹君不见，","月明江上有轻鸥。"],"stanzas":[["洞庭风软荻花秋，","新没青娥细浪愁。"],["泪滴白苹君不见，","月明江上有轻鸥。"]]}
{"id":"a1a1bbd095","title":"与郑德璘奇遇诗 五","author":"水府君","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔日江头菱芡人，","蒙君数饮松醪春。","活君家室以为报，","珍重长沙郑德璘。"],"stanzas":[["昔日江头菱芡人，","蒙君数饮松醪春。"],["活君家室以为报，","珍重长沙郑德璘。"]]}
{"id":"dbd030368c","title":"笑巫诗","author":"李序","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["魍魉何曾见，","头旋即下神。","图他衫子段，","诈道大王嗔。"],"stanzas":[["魍魉何曾见，","头旋即下神。"],["图他衫子段，","诈道大王嗔。"]]}
{"id":"87a8b2d469","title":"霅溪夜宴诗 一","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浊波扬扬兮凝晓雾，","公无渡河兮公竟渡。","风号水激兮呼不闻，","提衣看入兮中流去。","浪排衣兮随步没，","沈尸深入兮蛟螭窟。","蛟螭尽醉兮君血干，","推出黄沙兮泛君骨。","当时君死兮妾何适，","遂就波澜兮合魂魄。","愿持精卫衔石心，","穷断河源塞泉脉。"],"stanzas":[["浊波扬扬兮凝晓雾，","公无渡河兮公竟渡。"],["风号水激兮呼不闻，","提衣看入兮中流去。"],["浪排衣兮随步没，","沈尸深入兮蛟螭窟。"],["蛟螭尽醉兮君血干，","推出黄沙兮泛君骨。"],["当时君死兮妾何适，","遂就波澜兮合魂魄。"],["愿持精卫衔石心，","穷断河源塞泉脉。"]]}
{"id":"dbda82f526","title":"霅溪夜宴诗 二","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悲风淅淅兮波緜緜，","芦花万里兮凝苍烟。","虬螭窟宅兮渊且玄，","排波叠浪兮沈我天。","所覆不全兮身宁全，","溢眸恨血兮徒涟涟。","誓将柔荑抉锯牙之喙，","空水府而藏其腥涎。","青娥翠黛兮沈江壖，","碧云斜月兮空婵娟。","吞声饮恨兮语无力，","徒扬哀怨兮登歌筵。"],"stanzas":[["悲风淅淅兮波緜緜，","芦花万里兮凝苍烟。"],["虬螭窟宅兮渊且玄，","排波叠浪兮沈我天。"],["所覆不全兮身宁全，","溢眸恨血兮徒涟涟。"],["誓将柔荑抉锯牙之喙，","空水府而藏其腥涎。"],["青娥翠黛兮沈江壖，","碧云斜月兮空婵娟。"],["吞声饮恨兮语无力，","徒扬哀怨兮登歌筵。"]]}
{"id":"c2f6533b16","title":"霅溪夜宴诗 三","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白露漙兮西风高，","碧波万里兮翻洪涛。","莫言天下至柔者，","载舟覆舟皆我曹。"],"stanzas":[["白露漙兮西风高，","碧波万里兮翻洪涛。"],["莫言天下至柔者，","载舟覆舟皆我曹。"]]}
{"id":"c1e6e1c3f0","title":"霅溪夜宴诗 四","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君不见夜来渡口拥千艘，","中载万姓之脂膏。","当楼船泛泛于叠浪，","恨珠贝又轻于鸿毛。","又不见朝来津亭维一舠，","中有一士青其袍。","赴宰邑之良日，","任波吼而风号。","是知溺名溺利者，","不免为水府之腥臊。"],"stanzas":[["君不见夜来渡口拥千艘，","中载万姓之脂膏。"],["当楼船泛泛于叠浪，","恨珠贝又轻于鸿毛。"],["又不见朝来津亭维一舠，","中有一士青其袍。"],["赴宰邑之良日，","任波吼而风号。"],["是知溺名溺利者，","不免为水府之腥臊。"]]}
{"id":"e9e809b754","title":"霅溪夜宴诗 五","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["山势萦回水脉分，","水光山色翠连云。","四时尽入诗人咏，","役杀吴兴柳使君。"],"stanzas":[["山势萦回水脉分，","水光山色翠连云。"],["四时尽入诗人咏，","役杀吴兴柳使君。"]]}
{"id":"ad4f9a3e71","title":"霅溪夜宴诗 六","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["渺渺烟波接九疑，","几人经此泣江蓠。","年年绿水青山色，","不改重华南狩时。"],"stanzas":[["渺渺烟波接九疑，","几人经此泣江蓠。"],["年年绿水青山色，","不改重华南狩时。"]]}
{"id":"ce6359c235","title":"霅溪夜宴诗 七","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浪阔波澄秋气凉，","沈沈水殿夜初长。","自怜休退五湖客，","何幸追陪百谷王。","香袅碧云飘几席，","觥飞白玉艳椒浆。","酒酣独泛扁舟去，","笑入琴高不死乡。"],"stanzas":[["浪阔波澄秋气凉，","沈沈水殿夜初长。"],["自怜休退五湖客，","何幸追陪百谷王。"],["香袅碧云飘几席，","觥飞白玉艳椒浆。"],["酒酣独泛扁舟去，","笑入琴高不死乡。"]]}
{"id":"4ccd306c53","title":"霅溪夜宴诗 八","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珠光龙耀火燑燑，","夜接朝云宴渚宫。","凤管清吹凄极浦，","朱弦间奏冷秋空。","论心幸遇同归友，","揣分慙无辅佐功。","云雨各飞真境后，","不堪波上起悲风。"],"stanzas":[["珠光龙耀火燑燑，","夜接朝云宴渚宫。"],["凤管清吹凄极浦，","朱弦间奏冷秋空。"],["论心幸遇同归友，","揣分慙无辅佐功。"],["云雨各飞真境后，","不堪波上起悲风。"]]}
{"id":"2dbfc66511","title":"霅溪夜宴诗 九","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凤𬸣𬸣以降瑞兮，","患山鸡之杂飞。","玉温温以呈器兮，","因碔砆之争辉。","当侯门之四辟兮，","墐嘉谟之重扉。","既瑞器而无庸兮，","宜昏暗之相微。","徒刳石以为舟兮，","顾沿流而志违。","将刻木而作羽兮，","与超腾之理非。","矜孑孑于空江兮，","靡群援之可依。","血淋淋而滂流兮，","顾江鱼之腹而将归。","西风萧萧兮湘水悠悠，","白芷芳歇兮江蓠秋。","日晼晼兮川云收，","櫂四起兮悲风幽。","羁魂汨没兮我名永浮，","碧波虽涸兮厥誉长流。","向使甘言盛行于曩昔，","岂今日居君王之座头。","是知贪名徇禄而随世磨灭者，","虽正寝之死乎无得与吾俦。","当鼎足之嘉会兮，","获周旋于君侯。","雕盘玉豆兮罗珍羞，","金巵琼斝兮方献酬。","敢写心兮歌一曲，","无诮余持杯以淹留。"],"stanzas":[["凤𬸣𬸣以降瑞兮，","患山鸡之杂飞。"],["玉温温以呈器兮，","因碔砆之争辉。"],["当侯门之四辟兮，","墐嘉谟之重扉。"],["既瑞器而无庸兮，","宜昏暗之相微。"],["徒刳石以为舟兮，","顾沿流而志违。"],["将刻木而作羽兮，","与超腾之理非。"],["矜孑孑于空江兮，","靡群援之可依。"],["血淋淋而滂流兮，","顾江鱼之腹而将归。"],["西风萧萧兮湘水悠悠，","白芷芳歇兮江蓠秋。"],["日晼晼兮川云收，","櫂四起兮悲风幽。"],["羁魂汨没兮我名永浮，","碧波虽涸兮厥誉长流。"],["向使甘言盛行于曩昔，","岂今日居君王之座头。"],["是知贪名徇禄而随世磨灭者，","虽正寝之死乎无得与吾俦。"],["当鼎足之嘉会兮，","获周旋于君侯。"],["雕盘玉豆兮罗珍羞，","金巵琼斝兮方献酬。"],["敢写心兮歌一曲，","无诮余持杯以淹留。"]]}
{"id":"a912e7d1c9","title":"霅溪夜宴诗 十","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["行殿秋未晚，","水宫风初凉。","谁言此中夜，","得接朝宗行。","灵鼍振冬冬，","神龙耀煌煌。","红楼压波起，","翠幄连云张。","玉箫冷吟秋，","瑶瑟清含商。","贤臻江湖叟，","贵列川渎王。","谅予衰俗人，","无能振颓纲。","分辞皆乱世，","乐寐蛟螭乡。","栖迟幽岛间，","几见波成桑。","尔来尽流俗，","难与倾壶觞。","今日登华筵，","稍觉神扬扬。","方欢沧浪侣，","遽恐白日光。","海人瑞锦前，","岂敢言文章。","聊歌灵境会，","此会诚难忘。"],"stanzas":[["行殿秋未晚，","水宫风初凉。"],["谁言此中夜，","得接朝宗行。"],["灵鼍振冬冬，","神龙耀煌煌。"],["红楼压波起，","翠幄连云张。"],["玉箫冷吟秋，","瑶瑟清含商。"],["贤臻江湖叟，","贵列川渎王。"],["谅予衰俗人，","无能振颓纲。"],["分辞皆乱世，","乐寐蛟螭乡。"],["栖迟幽岛间，","几见波成桑。"],["尔来尽流俗，","难与倾壶觞。"],["今日登华筵，","稍觉神扬扬。"],["方欢沧浪侣，","遽恐白日光。"],["海人瑞锦前，","岂敢言文章。"],["聊歌灵境会，","此会诚难忘。"]]}
{"id":"a29731c8fa","title":"霅溪夜宴诗 十一","author":"水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雪集大野兮血波汹汹，","玄黄交战兮吴无全陇。","既霸业之将坠，","宜嘉谟之不从。","国步颠蹶兮吾道遘凶，","处鸱夷之大困，","入渊泉之九重。","上帝愍余之非辜兮，","俾大江鼓怒其冤踪。","所以鞭浪山而疾驱波岳，","亦粗足展余拂郁之心胸。","当灵境之良宴兮，","谬尊俎之相容。","击箫鼓兮撞歌钟，","吴讴越舞兮欢未极。","遽军城晓鼓之冬冬，","愿保上善之柔德，","何行乐之地兮难相逢。"],"stanzas":[["雪集大野兮血波汹汹，","玄黄交战兮吴无全陇。"],["既霸业之将坠，","宜嘉谟之不从。"],["国步颠蹶兮吾道遘凶，","处鸱夷之大困，","入渊泉之九重。"],["上帝愍余之非辜兮，","俾大江鼓怒其冤踪。"],["所以鞭浪山而疾驱波岳，","亦粗足展余拂郁之心胸。"],["当灵境之良宴兮，","谬尊俎之相容。"],["击箫鼓兮撞歌钟，","吴讴越舞兮欢未极。"],["遽军城晓鼓之冬冬，","愿保上善之柔德，","何行乐之地兮难相逢。"]]}
{"id":"e004626231","title":"为刘洪作 一","author":"辅国将军","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乌乌在虚飞，","玄驹遂野依。","名今编户籍，","翠过叶生稀。"],"stanzas":[["乌乌在虚飞，","玄驹遂野依。"],["名今编户籍，","翠过叶生稀。"]]}
{"id":"b5c8e5a05e","title":"为刘洪作 二","author":"辅国将军","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["个树枝条朽，","三花五面啼。","移家朝度日，","谁觉。"],"stanzas":[["个树枝条朽，","三花五面啼。"],["移家朝度日，","谁觉。"]]}
{"id":"7dc03762e8","title":"语","author":"太白山神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三珠并一珠，","驴马没人驱。","岁月甲庚午，","中兴戊己土。"],"stanzas":[["三珠并一珠，","驴马没人驱。"],["岁月甲庚午，","中兴戊己土。"]]}
{"id":"083de9af34","title":"月夜吟","author":"瀵水神","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜月明皎皎，","绿波空悠悠。"],"stanzas":[["夜月明皎皎，","绿波空悠悠。"]]}
{"id":"95b37b829c","title":"荅郑生歌","author":"湘中蛟女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溯青山兮江之隅，","拖湘波兮褭绿裾。","荷拳拳兮情未舒，","匪同归兮将焉如。"],"stanzas":[["溯青山兮江之隅，","拖湘波兮褭绿裾。"],["荷拳拳兮情未舒，","匪同归兮将焉如。"]]}
{"id":"7fbab7cd18","title":"风光词","author":"湘中蛟女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["隆佳秀兮昭盛时，","播薰绿兮淑华归。","故里荑与处萼兮，","潜重房以饰姿。","见雅态之韶华兮，","蒙长霭以为帏。","醉融光兮渺渺弥弥，","迷千里兮涵烟眉，","晨陶陶兮暮熙熙。","舞袅娜之秾条兮，","娉盈盈以披迟。","酡游颜兮倡蔓卉縠，","流倩电兮石发髓施。"],"stanzas":[["隆佳秀兮昭盛时，","播薰绿兮淑华归。"],["故里荑与处萼兮，","潜重房以饰姿。"],["见雅态之韶华兮，","蒙长霭以为帏。"],["醉融光兮渺渺弥弥，","迷千里兮涵烟眉，","晨陶陶兮暮熙熙。"],["舞袅娜之秾条兮，","娉盈盈以披迟。"],["酡游颜兮倡蔓卉縠，","流倩电兮石发髓施。"]]}
