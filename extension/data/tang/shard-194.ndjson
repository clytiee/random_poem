{"id":"709826b6da","title":"宫词 一五五","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水中芹叶土中花，","拾得还将避众家。","总待别人般数尽，","袖中拈出郁金芽。"],"stanzas":[["水中芹叶土中花，","拾得还将避众家。"],["总待别人般数尽，","袖中拈出郁金芽。"]]}
{"id":"f864bfd04e","title":"宫词 一五六","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉箫改调筝移柱，","催换红罗绣舞筵。","未戴柘枝花帽子，","两行宫监在帘前。"],"stanzas":[["玉箫改调筝移柱，","催换红罗绣舞筵。"],["未戴柘枝花帽子，","两行宫监在帘前。"]]}
{"id":"0efadf8b5b","title":"宫词 一五七","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["窗窗户户院相当，","总有珠帘玳瑁床。","虽道君王不来宿，","帐中长是炷牙香。"],"stanzas":[["窗窗户户院相当，","总有珠帘玳瑁床。"],["虽道君王不来宿，","帐中长是炷牙香。"]]}
{"id":"32a171e5b6","title":"述国亡诗","author":"花蕊夫人徐氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君王城上竖降旗，","妾在深宫那得知。","十四万人齐解甲，","宁无一个是男儿。"],"stanzas":[["君王城上竖降旗，","妾在深宫那得知。"],["十四万人齐解甲，","宁无一个是男儿。"]]}
{"id":"a0b26a025d","title":"新妆诗","author":"杨容华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["啼鸟惊眠罢，","房栊乘晓开。","凤钗金作缕，","鸾镜玉为台。","妆似临池出，","人疑向月来。","自怜终不见，","欲去复裴回。"],"stanzas":[["啼鸟惊眠罢，","房栊乘晓开。"],["凤钗金作缕，","鸾镜玉为台。"],["妆似临池出，","人疑向月来。"],["自怜终不见，","欲去复裴回。"]]}
{"id":"97c2fdfe2f","title":"赠外","author":"魏氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["浮萍依绿水，","弱茑寄青松。","与君结大义，","移天得所从。","翰林无双鸟，","劒水不分龙。","谐和类琴瑟，","坚固同胶漆。","义重恩欲深，","夷险贵如一。","本自身不令，","积多婴痛疾。","朝夕倦床枕，","形体耻巾栉。","游子倦风尘，","从官初解巾。","束装赴南郢，","脂驾出西秦。","比翼终难遂，","衔雌苦未因。","徒悲枫岸远，","空对柳园春。","男儿不重旧，","丈夫多好新。","新人喜新聘，","朝朝临粉镜。","两鸳固无比，","双蛾谁与竞。","讵怜愁思人，","衔啼嗟薄命。","蕣华不足恃，","松枝有余劲。","所愿好九思，","勿令亏百行。"],"stanzas":[["浮萍依绿水，","弱茑寄青松。"],["与君结大义，","移天得所从。"],["翰林无双鸟，","劒水不分龙。"],["谐和类琴瑟，","坚固同胶漆。"],["义重恩欲深，","夷险贵如一。"],["本自身不令，","积多婴痛疾。"],["朝夕倦床枕，","形体耻巾栉。"],["游子倦风尘，","从官初解巾。"],["束装赴南郢，","脂驾出西秦。"],["比翼终难遂，","衔雌苦未因。"],["徒悲枫岸远，","空对柳园春。"],["男儿不重旧，","丈夫多好新。"],["新人喜新聘，","朝朝临粉镜。"],["两鸳固无比，","双蛾谁与竞。"],["讵怜愁思人，","衔啼嗟薄命。"],["蕣华不足恃，","松枝有余劲。"],["所愿好九思，","勿令亏百行。"]]}
{"id":"aae74ac742","title":"咏破帘","author":"乔氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["已漏风声罢，","绳持也不禁。","一从经落后，","无复有贞心。"],"stanzas":[["已漏风声罢，","绳持也不禁。"],["一从经落后，","无复有贞心。"]]}
{"id":"e451b66ba9","title":"送兄","author":"七岁女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["别路云初起，","离亭叶正飞。","所嗟人异鴈，","不作一行归。"],"stanzas":[["别路云初起，","离亭叶正飞。"],["所嗟人异鴈，","不作一行归。"]]}
{"id":"6ee954dd29","title":"送男左贬诗","author":"林氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["他日初投杼，","勤王在饮冰。","有辞期不罚，","积毁竟相仍。","谪宦今何在，","衔冤犹未胜。","天涯分越徼，","驿骑速毘陵。","肠断腹非苦，","书传写岂能。","泪添江水远，","心剧海云蒸。","明月珠难识，","甘泉赋可称。","但将忠报主，","何惧点青蝇。"],"stanzas":[["他日初投杼，","勤王在饮冰。"],["有辞期不罚，","积毁竟相仍。"],["谪宦今何在，","衔冤犹未胜。"],["天涯分越徼，","驿骑速毘陵。"],["肠断腹非苦，","书传写岂能。"],["泪添江水远，","心剧海云蒸。"],["明月珠难识，","甘泉赋可称。"],["但将忠报主，","何惧点青蝇。"]]}
{"id":"d61a3bb9d0","title":"古兴 一","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["郁蒸夏将半，","暑气扇飞阁。","骤雨满空来，","当轩卷罗幕。","度云开夕霁，","宇宙何清廓。","明月流素光，","轻风换炎铄。","孤鸾伤对影，","宝瑟悲别鹤。","君子去不还，","遥心欲何托。"],"stanzas":[["郁蒸夏将半，","暑气扇飞阁。"],["骤雨满空来，","当轩卷罗幕。"],["度云开夕霁，","宇宙何清廓。"],["明月流素光，","轻风换炎铄。"],["孤鸾伤对影，","宝瑟悲别鹤。"],["君子去不还，","遥心欲何托。"]]}
{"id":"fb3908b07c","title":"古兴 二","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金菊延清霜，","玉壶多美酒。","良人犹不归，","芳菲岂常有。","不惜芳菲歇，","但伤别离久。","含情罢斟酌，","凝怨对窗牖。"],"stanzas":[["金菊延清霜，","玉壶多美酒。"],["良人犹不归，","芳菲岂常有。"],["不惜芳菲歇，","但伤别离久。"],["含情罢斟酌，","凝怨对窗牖。"]]}
{"id":"7e1d97ef4a","title":"古兴 三","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霁雪舒长野，","寒云半幽谷。","严风振枯条，","猨啼抱冰木。","所嗟游宦子，","少小荷天禄。","前程未云至，","凄怆对车仆。","岁寒成咏歌，","日暮栖林朴。","不惮行险道，","空悲年运促。"],"stanzas":[["霁雪舒长野，","寒云半幽谷。"],["严风振枯条，","猨啼抱冰木。"],["所嗟游宦子，","少小荷天禄。"],["前程未云至，","凄怆对车仆。"],["岁寒成咏歌，","日暮栖林朴。"],["不惮行险道，","空悲年运促。"]]}
{"id":"8e8a2c3462","title":"寄夫","author":"郭绍兰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["我壻去重湖，","临窗泣血书。","殷勤凭燕翼，","寄与薄情夫。"],"stanzas":[["我壻去重湖，","临窗泣血书。"],["殷勤凭燕翼，","寄与薄情夫。"]]}
{"id":"160c546d4c","title":"同夫游秦","author":"王韫秀","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["路扫饥寒迹，","天哀志气人。","休零离别泪，","携手入西秦。"],"stanzas":[["路扫饥寒迹，","天哀志气人。"],["休零离别泪，","携手入西秦。"]]}
{"id":"115fdd6899","title":"夫入相寄姨妹","author":"王韫秀","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相国已随麟阁贵，","家风第一右丞诗。","笄年解笑鸣机妇，","耻见苏秦富贵时。"],"stanzas":[["相国已随麟阁贵，","家风第一右丞诗。"],["笄年解笑鸣机妇，","耻见苏秦富贵时。"]]}
{"id":"18b1c1f004","title":"喻夫阻客","author":"王韫秀","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚竹燕歌动画梁，","春兰重换舞衣裳。","公孙开阁招嘉客，","知道浮荣不久长。"],"stanzas":[["楚竹燕歌动画梁，","春兰重换舞衣裳。"],["公孙开阁招嘉客，","知道浮荣不久长。"]]}
{"id":"59bcc22849","title":"古意","author":"张夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["辘轳晓转素丝绠，","桐声夜落苍苔塼。","涓涓吹溜若时雨，","濯濯佳蔬非用天。","丈夫不解此中意，","抱瓮当时徒自贤。"],"stanzas":[["辘轳晓转素丝绠，","桐声夜落苍苔塼。"],["涓涓吹溜若时雨，","濯濯佳蔬非用天。"],["丈夫不解此中意，","抱瓮当时徒自贤。"]]}
{"id":"b34903e8c8","title":"拜新月","author":"张夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拜新月，","拜月出堂前。","暗魄初笼桂，","虚弓未引弦。","拜新月，","拜月妆楼上。","鸾镜始安台，","蛾眉已相向。","拜新月，","拜月不胜情，","庭花风露清。","月临人自老，","人望月长明。","东家阿母亦拜月，","一拜一悲声断绝。","昔年拜月逞容辉，","如今拜月双泪垂。","回看众女拜新月，","却忆红闺年少时。"],"stanzas":[["拜新月，","拜月出堂前。"],["暗魄初笼桂，","虚弓未引弦。"],["拜新月，","拜月妆楼上。"],["鸾镜始安台，","蛾眉已相向。"],["拜新月，","拜月不胜情，","庭花风露清。"],["月临人自老，","人望月长明。"],["东家阿母亦拜月，","一拜一悲声断绝。"],["昔年拜月逞容辉，","如今拜月双泪垂。"],["回看众女拜新月，","却忆红闺年少时。"]]}
{"id":"2211f7c624","title":"柳絮","author":"张夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["霭霭芳春朝，","雪絮起青条。","或值花同舞，","不因风自飘。","过尊浮绿醑，","拂幌缀红绡。","那用持愁玩，","春怀不自聊。"],"stanzas":[["霭霭芳春朝，","雪絮起青条。"],["或值花同舞，","不因风自飘。"],["过尊浮绿醑，","拂幌缀红绡。"],["那用持愁玩，","春怀不自聊。"]]}
{"id":"e42ba279b1","title":"拾得韦氏花钿以诗寄赠","author":"张夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今朝妆阁前，","拾得旧花钿。","粉汚痕犹在，","尘侵色尚鲜。","曾经纤手里，","拈向翠眉边。","能助千金笑，","如何忍弃捐。"],"stanzas":[["今朝妆阁前，","拾得旧花钿。"],["粉汚痕犹在，","尘侵色尚鲜。"],["曾经纤手里，","拈向翠眉边。"],["能助千金笑，","如何忍弃捐。"]]}
{"id":"e12a0c76ef","title":"诮喜鹊","author":"张夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["畴昔鸳鸯侣，","朱门贺客多。","如今无此事，","好去莫相过。"],"stanzas":[["畴昔鸳鸯侣，","朱门贺客多。"],["如今无此事，","好去莫相过。"]]}
{"id":"31c595ce1d","title":"句","author":"张夫人","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["游蜂乍起惊落墀，","黄鸟衔来却上枝。","临风重回首，","掩泪向庭花。","镜中春色老，","枕前秋夜长。"],"stanzas":[["游蜂乍起惊落墀，","黄鸟衔来却上枝。"],["临风重回首，","掩泪向庭花。"],["镜中春色老，","枕前秋夜长。"]]}
{"id":"2f819f9a9c","title":"书石壁","author":"王氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何事潘郎恋别筵，","欢情未断妾心悬。","汰王滩下相思处，","猨叫山山月满船。"],"stanzas":[["何事潘郎恋别筵，","欢情未断妾心悬。"],["汰王滩下相思处，","猨叫山山月满船。"]]}
{"id":"3960159a56","title":"荅微之","author":"裴淑","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侯门初拥节，","御苑柳丝新。","不是悲殊命，","唯愁别近亲。","黄莺迁古木，","朱履从清尘。","想到千山外，","沧江正暮春。"],"stanzas":[["侯门初拥节，","御苑柳丝新。"],["不是悲殊命，","唯愁别近亲。"],["黄莺迁古木，","朱履从清尘。"],["想到千山外，","沧江正暮春。"]]}
{"id":"82a0a7269b","title":"夫下第","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["良人的的有奇才，","何事年年被放回。","如今妾面羞君面，","君若来时近夜来。"],"stanzas":[["良人的的有奇才，","何事年年被放回。"],["如今妾面羞君面，","君若来时近夜来。"]]}
{"id":"c2746bab08","title":"杂言寄杜羔","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君从淮海游，","再过兰杜秋。","归来未须臾，","又欲向梁州。","梁州秦岭西，","栈道与云齐。","羌蛮万余落，","矛戟自高低。","已念寡俦侣，","复虑劳攀跻。","丈夫重志气，","儿女空悲啼。","临邛滞游地，","肯顾浊水泥。","人生赋命有厚薄，","君但遨游我寂寞。"],"stanzas":[["君从淮海游，","再过兰杜秋。"],["归来未须臾，","又欲向梁州。"],["梁州秦岭西，","栈道与云齐。"],["羌蛮万余落，","矛戟自高低。"],["已念寡俦侣，","复虑劳攀跻。"],["丈夫重志气，","儿女空悲啼。"],["临邛滞游地，","肯顾浊水泥。"],["人生赋命有厚薄，","君但遨游我寂寞。"]]}
{"id":"e9cdf18d25","title":"闻夫杜羔登第","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长安此去无多地，","郁郁葱葱佳气浮。","良人得意正年少，","今夜醉眠何处楼。"],"stanzas":[["长安此去无多地，","郁郁葱葱佳气浮。"],["良人得意正年少，","今夜醉眠何处楼。"]]}
{"id":"5dd5779419","title":"杂言","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上林园中青青桂，","折得一枝好夫壻。","杏花如雪柳垂丝，","春风荡飏不同枝。"],"stanzas":[["上林园中青青桂，","折得一枝好夫壻。"],["杏花如雪柳垂丝，","春风荡飏不同枝。"]]}
{"id":"f17f56f0a8","title":"寄夫 一","author":"张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["久无音信到罗帏，","路远迢迢遣问谁。","闻君折得东堂桂，","折罢那能不暂归。"],"stanzas":[["久无音信到罗帏，","路远迢迢遣问谁。"],["闻君折得东堂桂，","折罢那能不暂归。"]]}
{"id":"729236dad3","title":"寄夫 二","author":"张氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["驿使今朝过五湖，","殷勤为我报狂夫。","从来夸有龙泉劒，","试割相思得断无。"],"stanzas":[["驿使今朝过五湖，","殷勤为我报狂夫。"],["从来夸有龙泉劒，","试割相思得断无。"]]}
{"id":"c143aadb95","title":"赠郑女郎","author":"薛馧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["艳阳灼灼河洛神，","珠帘绣户青楼春。","能弹箜篌弄纤指，","愁杀门前少年子。","笑开一面红粉妆，","东园几树桃花死。","朝理曲，","暮理曲，","独坐窗前一片玉。","行也娇，","坐也娇，","见之令人魂魄销。","堂前锦褥红地𬬻，","绿沉香榼倾屠苏。","解佩时时歇歌管，","芙蓉帐里兰麝满。","晚起罗衣香不断，","灭烛每嫌秋夜短。"],"stanzas":[["艳阳灼灼河洛神，","珠帘绣户青楼春。"],["能弹箜篌弄纤指，","愁杀门前少年子。"],["笑开一面红粉妆，","东园几树桃花死。"],["朝理曲，","暮理曲，","独坐窗前一片玉。"],["行也娇，","坐也娇，","见之令人魂魄销。"],["堂前锦褥红地𬬻，","绿沉香榼倾屠苏。"],["解佩时时歇歌管，","芙蓉帐里兰麝满。"],["晚起罗衣香不断，","灭烛每嫌秋夜短。"]]}
{"id":"4bd83ddecf","title":"古意","author":"薛馧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨夜巫山中，","失却阳台女。","朝来香阁里，","独伴楚王语。"],"stanzas":[["昨夜巫山中，","失却阳台女。"],["朝来香阁里，","独伴楚王语。"]]}
{"id":"8122a2cc9d","title":"赠故人","author":"薛馧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔别容如玉，","今来鬓若丝。","泪痕应共见，","肠断阿谁知。"],"stanzas":[["昔别容如玉，","今来鬓若丝。"],["泪痕应共见，","肠断阿谁知。"]]}
{"id":"1dd0fc14f2","title":"句","author":"薛馧","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寞相思处，","雕梁落燕泥。"],"stanzas":[["寂寞相思处，","雕梁落燕泥。"]]}
{"id":"e0cb239922","title":"题奉慈寺","author":"杨德麟","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日月金轮动，","旃檀碧树秋。","塔分鸿鴈翅，","钟挂凤凰楼。"],"stanzas":[["日月金轮动，","旃檀碧树秋。"],["塔分鸿鴈翅，","钟挂凤凰楼。"]]}
{"id":"a3549ff019","title":"述怀","author":"崔氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不怨卢郎年纪大，","不怨卢郎官职卑。","自恨妾身生较晚，","不及卢郎年少时。"],"stanzas":[["不怨卢郎年纪大，","不怨卢郎官职卑。"],["自恨妾身生较晚，","不及卢郎年少时。"]]}
{"id":"574ef69aa3","title":"寄夫","author":"陈玉兰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夫戍边关妾在吴，","西风吹妾妾忧夫。","一行书信千行泪，","寒到君边衣到无。"],"stanzas":[["夫戍边关妾在吴，","西风吹妾妾忧夫。"],["一行书信千行泪，","寒到君边衣到无。"]]}
{"id":"d3220becb8","title":"写真寄夫","author":"薛媛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["欲下丹青笔，","先拈宝镜寒。","已经颜索寞，","渐觉鬓凋残。","泪眼描将易，","愁肠写出难。","恐君浑忘却，","时展画图看。"],"stanzas":[["欲下丹青笔，","先拈宝镜寒。"],["已经颜索寞，","渐觉鬓凋残。"],["泪眼描将易，","愁肠写出难。"],["恐君浑忘却，","时展画图看。"]]}
{"id":"756284858c","title":"闻琴","author":"孙氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉指朱弦轧复清，","湘妃愁怨最难听。","初疑飒飒凉风劲，","又似萧萧暮雨零。","近比流泉来碧嶂，","远如玄鹤下青冥。","夜深弹罢堪惆怅，","露湿丛兰月满庭。"],"stanzas":[["玉指朱弦轧复清，","湘妃愁怨最难听。"],["初疑飒飒凉风劲，","又似萧萧暮雨零。"],["近比流泉来碧嶂，","远如玄鹤下青冥。"],["夜深弹罢堪惆怅，","露湿丛兰月满庭。"]]}
{"id":"c9343a3648","title":"白蜡烛诗","author":"孙氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["景胜银釭香比兰，","一条白玉偪人寒。","他时紫禁春风夜，","醉草天书仔细看。"],"stanzas":[["景胜银釭香比兰，","一条白玉偪人寒。"],["他时紫禁春风夜，","醉草天书仔细看。"]]}
{"id":"9f2c69be72","title":"谢人送酒","author":"孙氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谢将清酒寄愁人，","澄澈甘香气味真。","好是绿窗风月夜，","一杯摇荡满怀春。"],"stanzas":[["谢将清酒寄愁人，","澄澈甘香气味真。"],["好是绿窗风月夜，","一杯摇荡满怀春。"]]}
{"id":"22901071f5","title":"诗","author":"张立本女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["危冠广袖楚宫妆，","独步闲庭逐夜凉。","自把玉簪敲砌竹，","清歌一曲月如霜。"],"stanzas":[["危冠广袖楚宫妆，","独步闲庭逐夜凉。"],["自把玉簪敲砌竹，","清歌一曲月如霜。"]]}
{"id":"4b9f248c86","title":"绣龟形诗","author":"侯氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暌离已是十秋强，","对镜那堪重理妆。","闻鴈几回修尺素，","见霜先为制衣裳。","开箱叠练先垂泪，","拂杵调砧更断肠。","绣作龟形献天子，","愿教征客早还乡。"],"stanzas":[["暌离已是十秋强，","对镜那堪重理妆。"],["闻鴈几回修尺素，","见霜先为制衣裳。"],["开箱叠练先垂泪，","拂杵调砧更断肠。"],["绣作龟形献天子，","愿教征客早还乡。"]]}
{"id":"efc88d3ee1","title":"感夫诗","author":"慎氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["当时心事已相关，","雨散云飞一饷间。","便是孤帆从此去，","不堪重上望夫山。"],"stanzas":[["当时心事已相关，","雨散云飞一饷间。"],["便是孤帆从此去，","不堪重上望夫山。"]]}
{"id":"c6edeb5bc8","title":"谣","author":"薛瑶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["化云心兮思淑贞，","洞寂灭兮不见人。","瑶草芳兮思芬蒀，","将奈何兮青春。"],"stanzas":[["化云心兮思淑贞，","洞寂灭兮不见人。"],["瑶草芳兮思芬蒀，","将奈何兮青春。"]]}
{"id":"ef9b40936e","title":"题唐安寺阁壁","author":"王霞卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春来引步暂寻游，","愁见风光倚寺楼。","正好开怀对烟月，","双眉不觉自如钩。"],"stanzas":[["春来引步暂寻游，","愁见风光倚寺楼。"],["正好开怀对烟月，","双眉不觉自如钩。"]]}
{"id":"6022d3cb16","title":"荅郑殷彝","author":"王霞卿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君是烟霄折桂身，","圣朝方切用儒珍。","正堪西上文场战，","空向途中泥妇人。"],"stanzas":[["君是烟霄折桂身，","圣朝方切用儒珍。"],["正堪西上文场战，","空向途中泥妇人。"]]}
{"id":"6e7da53961","title":"喜卢郎及第","author":"窦梁宾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晓妆初罢眼初瞤，","小玉惊人踏破帬。","手把红笺书一纸，","上头名字有郎君。"],"stanzas":[["晓妆初罢眼初瞤，","小玉惊人踏破帬。"],["手把红笺书一纸，","上头名字有郎君。"]]}
{"id":"7051266ada","title":"雨中看牡丹","author":"窦梁宾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东风未放晓泥干，","红药花开不奈寒。","待得天晴花已老，","不如携手雨中看。"],"stanzas":[["东风未放晓泥干，","红药花开不奈寒。"],["待得天晴花已老，","不如携手雨中看。"]]}
{"id":"ac8166955d","title":"书桐叶","author":"任氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拭翠敛蛾眉，","郁郁心中事。","搦管下庭除，","书成相思字。","此字不书石，","此字不书纸。","书在桐叶上，","愿逐秋风起。","天下有心人，","尽解相思死。","天下负心人，","不识相思字。","有心与负心，","不知落何地。"],"stanzas":[["拭翠敛蛾眉，","郁郁心中事。"],["搦管下庭除，","书成相思字。"],["此字不书石，","此字不书纸。"],["书在桐叶上，","愿逐秋风起。"],["天下有心人，","尽解相思死。"],["天下负心人，","不识相思字。"],["有心与负心，","不知落何地。"]]}
{"id":"fb29b6c961","title":"下狱贡诗","author":"黄崇嘏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["偶辞幽隐在临邛，","行止坚贞比涧松。","何事政清如水镜，","绊他野鹤在深笼。"],"stanzas":[["偶辞幽隐在临邛，","行止坚贞比涧松。"],["何事政清如水镜，","绊他野鹤在深笼。"]]}
{"id":"eb50a59087","title":"辞蜀相妻女诗","author":"黄崇嘏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一辞拾翠碧江湄，","贫守蓬茅但赋诗。","自服蓝衫居郡掾，","永抛鸾镜画蛾眉。","立身卓尔青松操，","挺志铿然白璧姿。","幕府若容为坦腹，","愿天速变作男儿。"],"stanzas":[["一辞拾翠碧江湄，","贫守蓬茅但赋诗。"],["自服蓝衫居郡掾，","永抛鸾镜画蛾眉。"],["立身卓尔青松操，","挺志铿然白璧姿。"],["幕府若容为坦腹，","愿天速变作男儿。"]]}
{"id":"03c6e4f9d6","title":"荅诸姊妹戒饮","author":"蒋氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["平生偏好酒，","劳尔劝吾餐。","但得杯中满，","时光度不难。"],"stanzas":[["平生偏好酒，","劳尔劝吾餐。"],["但得杯中满，","时光度不难。"]]}
{"id":"47820aa5fb","title":"书壁","author":"周仲美","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爱妾不爱子，","为问此何理。","弃官更弃妻，","人情宁可已。","永诀泗之滨，","遗言空在耳。","三载无朝昏，","孤帏泪如洗。","妇人义从夫，","一节誓生死。","江乡感残春，","肠断晚烟起。","西望太华峰，","不知几千里。"],"stanzas":[["爱妾不爱子，","为问此何理。"],["弃官更弃妻，","人情宁可已。"],["永诀泗之滨，","遗言空在耳。"],["三载无朝昏，","孤帏泪如洗。"],["妇人义从夫，","一节誓生死。"],["江乡感残春，","肠断晚烟起。"],["西望太华峰，","不知几千里。"]]}
{"id":"435d1f7392","title":"溪口云","author":"张文姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["溶溶溪口云，","才向溪中吐。","不复归溪中，","还作溪中雨。"],"stanzas":[["溶溶溪口云，","才向溪中吐。"],["不复归溪中，","还作溪中雨。"]]}
{"id":"2b222fac63","title":"池上竹","author":"张文姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["此君临此池，","枝低水相近。","碧色绿波中，","日日流不尽。"],"stanzas":[["此君临此池，","枝低水相近。"],["碧色绿波中，","日日流不尽。"]]}
{"id":"19c6711f4e","title":"沙上鹭","author":"张文姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["沙头一水禽，","鼓翼扬清音。","只待高风便，","非无云汉心。"],"stanzas":[["沙头一水禽，","鼓翼扬清音。"],["只待高风便，","非无云汉心。"]]}
{"id":"454446274f","title":"双槿树","author":"张文姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿影竞扶疎，","红姿相照灼。","不学桃李花，","乱向春风落。"],"stanzas":[["绿影竞扶疎，","红姿相照灼。"],["不学桃李花，","乱向春风落。"]]}
{"id":"28e113774a","title":"狱中书情上使君","author":"程长文","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾家本住鄱阳曲，","一片贞心比孤竹。","当年二八盛容仪，","红牋草隶恰如飞。","尽日闲窗刺绣坐，","有时极浦采莲归。","谁道居贫守都邑，","幽闺寂寞无人识。","海燕朝归衾枕寒，","山花夜落阶墀湿。","强暴之男何所为，","手持白刃向帘帏。","一命任从刀下死，","千金岂受暗中欺。","我心匪石情难转，","志夺秋霜意不移。","血溅罗衣终不恨，","疮黏锦袖亦何辞。","县僚曾未知情绪，","即便教人絷囹圄。","朱唇滴沥独衔冤，","玉筯阑干叹非所。","十月寒更堪思人，","一闻击柝一伤神。","高髻不梳云已散，","蛾眉罢埽月仍新。","三尺严章难可越，","百年心事向谁说。","但看洗雪出圜扉，","始信白圭无玷缺。"],"stanzas":[["妾家本住鄱阳曲，","一片贞心比孤竹。"],["当年二八盛容仪，","红牋草隶恰如飞。"],["尽日闲窗刺绣坐，","有时极浦采莲归。"],["谁道居贫守都邑，","幽闺寂寞无人识。"],["海燕朝归衾枕寒，","山花夜落阶墀湿。"],["强暴之男何所为，","手持白刃向帘帏。"],["一命任从刀下死，","千金岂受暗中欺。"],["我心匪石情难转，","志夺秋霜意不移。"],["血溅罗衣终不恨，","疮黏锦袖亦何辞。"],["县僚曾未知情绪，","即便教人絷囹圄。"],["朱唇滴沥独衔冤，","玉筯阑干叹非所。"],["十月寒更堪思人，","一闻击柝一伤神。"],["高髻不梳云已散，","蛾眉罢埽月仍新。"],["三尺严章难可越，","百年心事向谁说。"],["但看洗雪出圜扉，","始信白圭无玷缺。"]]}
{"id":"cad69657e6","title":"铜雀台怨","author":"程长文","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君王去后行人绝，","箫筝不响歌喉咽。","雄劒无威光彩沈，","宝琴零落金星灭。","玉阶寂寞坠秋露，","月照当时歌舞处。","当时歌舞人不回，","化为今日西陵灰。"],"stanzas":[["君王去后行人绝，","箫筝不响歌喉咽。"],["雄劒无威光彩沈，","宝琴零落金星灭。"],["玉阶寂寞坠秋露，","月照当时歌舞处。"],["当时歌舞人不回，","化为今日西陵灰。"]]}
{"id":"d00af60fe5","title":"春闺怨","author":"程长文","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["[绮]陌香飘柳如线，","时光瞬息如流电。","良人何处事功名，","十载相思不相见。"],"stanzas":[["[绮]陌香飘柳如线，","时光瞬息如流电。"],["良人何处事功名，","十载相思不相见。"]]}
{"id":"af0498876d","title":"荅韩翃","author":"柳氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["杨柳枝，","芳菲节，","可恨年年赠离别。","一叶随风忽报秋，","纵使君来岂堪折。"],"stanzas":[["杨柳枝，","芳菲节，","可恨年年赠离别。"],["一叶随风忽报秋，","纵使君来岂堪折。"]]}
{"id":"c071f2a86b","title":"归李江州后寄别王氏","author":"程洛宾","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼鴈回时写报音，","难凭剉蘖数年心。","虽然情断沙咤后，","争奈平生怨恨深。"],"stanzas":[["鱼鴈回时写报音，","难凭剉蘖数年心。"],["虽然情断沙咤后，","争奈平生怨恨深。"]]}
{"id":"d7831a66d7","title":"忆崔生","author":"红绡妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["深洞莺啼恨阮郎，","偷来花下解珠珰。","碧云飘断音书绝，","空倚玉箫愁凤皇。"],"stanzas":[["深洞莺啼恨阮郎，","偷来花下解珠珰。"],["碧云飘断音书绝，","空倚玉箫愁凤皇。"]]}
{"id":"6ebd116cc1","title":"寄文茂","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花笺制叶寄郎边，","的的寻鱼为妾传。","并蒂已看灵鹊报，","倩郎早觅买花船。"],"stanzas":[["花笺制叶寄郎边，","的的寻鱼为妾传。"],["并蒂已看灵鹊报，","倩郎早觅买花船。"]]}
{"id":"5b71a3a837","title":"秋日再寄","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珍簟生凉夜漏余，","梦中恍惚觉来初。","魂离不得空成病，","面见无由浪寄书。","窗外江村钟响绝，","枕边梧叶雨声疎。","此时最是思君处，","肠断寒猨定不如。"],"stanzas":[["珍簟生凉夜漏余，","梦中恍惚觉来初。"],["魂离不得空成病，","面见无由浪寄书。"],["窗外江村钟响绝，","枕边梧叶雨声疎。"],["此时最是思君处，","肠断寒猨定不如。"]]}
{"id":"c28129e8f0","title":"春日送夫之长安","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["思君远别妾心愁，","踏翠江边送画舟。","欲待相看迟此别，","只忧红日向西流。"],"stanzas":[["思君远别妾心愁，","踏翠江边送画舟。"],["欲待相看迟此别，","只忧红日向西流。"]]}
{"id":"9c5e9eb019","title":"雨中忆夫 一","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["窗前细雨日啾啾，","妾在闺中独自愁。","何事玉郎久离别，","忘忧总对岂忘忧。"],"stanzas":[["窗前细雨日啾啾，","妾在闺中独自愁。"],["何事玉郎久离别，","忘忧总对岂忘忧。"]]}
{"id":"54dcccd17a","title":"雨中忆夫 二","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风送雨过窗东，","忽忆良人在客中。","安得妾身今似雨，","也随风去与郎同。"],"stanzas":[["春风送雨过窗东，","忽忆良人在客中。"],["安得妾身今似雨，","也随风去与郎同。"]]}
{"id":"0891804eba","title":"子夜歌十八首 一","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侬既剪云鬟，","郎亦分丝发。","觅向无人处，","绾作同心结。"],"stanzas":[["侬既剪云鬟，","郎亦分丝发。"],["觅向无人处，","绾作同心结。"]]}
{"id":"a136fdb03a","title":"子夜歌十八首 二","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜夜不成寐，","拥被啼终夕。","郎不信侬时，","但看枕上迹。"],"stanzas":[["夜夜不成寐，","拥被啼终夕。"],["郎不信侬时，","但看枕上迹。"]]}
{"id":"28f0df3d6f","title":"子夜歌十八首 三","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何时得成匹，","离恨不复牵。","金针刺菡萏，","夜夜得见莲。"],"stanzas":[["何时得成匹，","离恨不复牵。"],["金针刺菡萏，","夜夜得见莲。"]]}
{"id":"524a0498a1","title":"子夜歌十八首 四","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相逢逐凉候，","黄花忽复香。","颦眉腊月露，","愁杀未成霜。"],"stanzas":[["相逢逐凉候，","黄花忽复香。"],["颦眉腊月露，","愁杀未成霜。"]]}
{"id":"d45422f62d","title":"子夜歌十八首 五","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明窗弄玉指，","指甲如水晶。","翦之特寄郎，","聊当携手行。"],"stanzas":[["明窗弄玉指，","指甲如水晶。"],["翦之特寄郎，","聊当携手行。"]]}
{"id":"37771b7b9d","title":"子夜歌十八首 六","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寄语闺中娘，","颜色不常好。","含笑对棘实，","欢娱须是枣。"],"stanzas":[["寄语闺中娘，","颜色不常好。"],["含笑对棘实，","欢娱须是枣。"]]}
{"id":"3d044dfbfd","title":"子夜歌十八首 七","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["良会终有时，","劝郎莫得怒。","姜蘖畏春蚕，","要绵须辛苦。"],"stanzas":[["良会终有时，","劝郎莫得怒。"],["姜蘖畏春蚕，","要绵须辛苦。"]]}
{"id":"fd2869a5d2","title":"子夜歌十八首 八","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["醉梦幸逢郎，","无奈乌哑哑。","中山如有酒，","敢借千金价。"],"stanzas":[["醉梦幸逢郎，","无奈乌哑哑。"],["中山如有酒，","敢借千金价。"]]}
{"id":"c940a4cbb8","title":"子夜歌十八首 九","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["信使无虚日，","玉酝寄盈觥。","一年一日雨，","底事太多晴。"],"stanzas":[["信使无虚日，","玉酝寄盈觥。"],["一年一日雨，","底事太多晴。"]]}
{"id":"2849f9f7ce","title":"子夜歌十八首 十","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绣房拟会郎，","四窗日离离。","手自施屏障，","恐有女伴窥。"],"stanzas":[["绣房拟会郎，","四窗日离离。"],["手自施屏障，","恐有女伴窥。"]]}
{"id":"f4d6dd52b2","title":"子夜歌十八首 十一","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相思百余日，","相见苦无期。","褰裳摘藕花，","要莲敢恨池。"],"stanzas":[["相思百余日，","相见苦无期。"],["褰裳摘藕花，","要莲敢恨池。"]]}
{"id":"1abdca21f9","title":"子夜歌十八首 十二","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金盆盥素手，","焚香诵普门。","来生何所愿，","与郎为一身。"],"stanzas":[["金盆盥素手，","焚香诵普门。"],["来生何所愿，","与郎为一身。"]]}
{"id":"cb64980e74","title":"子夜歌十八首 十三","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花池多芳水，","玉杯挹赠郎。","避人藏袖里，","湿却素罗裳。"],"stanzas":[["花池多芳水，","玉杯挹赠郎。"],["避人藏袖里，","湿却素罗裳。"]]}
{"id":"8942e41710","title":"子夜歌十八首 十四","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["感郎金针赠，","欲报物俱轻。","一双连素缕，","与郎聊定情。"],"stanzas":[["感郎金针赠，","欲报物俱轻。"],["一双连素缕，","与郎聊定情。"]]}
{"id":"f77c1a90ff","title":"子夜歌十八首 十五","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寒风响枯木，","通夕不得卧。","早起遣问郎，","昨宵何以过。"],"stanzas":[["寒风响枯木，","通夕不得卧。"],["早起遣问郎，","昨宵何以过。"]]}
{"id":"3cf03209ac","title":"子夜歌十八首 十六","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["得郎日嗣音，","令人不可覩。","熊胆磨作墨，","书来字字苦。"],"stanzas":[["得郎日嗣音，","令人不可覩。"],["熊胆磨作墨，","书来字字苦。"]]}
{"id":"279bf148bc","title":"子夜歌十八首 十七","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轻巾手自制，","颜色烂含桃。","先怀侬袖里，","然后约郎腰。"],"stanzas":[["轻巾手自制，","颜色烂含桃。"],["先怀侬袖里，","然后约郎腰。"]]}
{"id":"e1ee00c448","title":"子夜歌十八首 十八","author":"晁采","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侬赠绿丝衣，","郎遗玉钩子。","即欲系侬心，","侬思著郎体。"],"stanzas":[["侬赠绿丝衣，","郎遗玉钩子。"],["即欲系侬心，","侬思著郎体。"]]}
{"id":"a4cc30b5ad","title":"荅张生","author":"崔莺莺","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["待月西厢下，","迎风户半开。","拂墙花影动，","疑是玉人来。"],"stanzas":[["待月西厢下，","迎风户半开。"],["拂墙花影动，","疑是玉人来。"]]}
{"id":"aa38a99a1f","title":"寄诗","author":"崔莺莺","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自从销瘦减容光，","万转千回嬾下床。","不为傍人羞不起，","为郎憔悴却羞郎。"],"stanzas":[["自从销瘦减容光，","万转千回嬾下床。"],["不为傍人羞不起，","为郎憔悴却羞郎。"]]}
{"id":"58a557aac4","title":"告绝诗","author":"崔莺莺","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弃置今何道，","当时且自亲。","还将旧来意，","怜取眼前人。"],"stanzas":[["弃置今何道，","当时且自亲。"],["还将旧来意，","怜取眼前人。"]]}
{"id":"b1549f2ab8","title":"荅赵子","author":"步非烟","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿惨双蛾不自持，","只缘幽恨在新诗。","郎心应似琴心怨，","脉脉春情更泥谁。"],"stanzas":[["绿惨双蛾不自持，","只缘幽恨在新诗。"],["郎心应似琴心怨，","脉脉春情更泥谁。"]]}
{"id":"9abaa59ccf","title":"又荅赵象独坐","author":"步非烟","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["无力严妆倚绣栊，","暗题蝉锦思难穷。","近来赢得伤春病，","柳弱花敧怯晓风。"],"stanzas":[["无力严妆倚绣栊，","暗题蝉锦思难穷。"],["近来赢得伤春病，","柳弱花敧怯晓风。"]]}
{"id":"7c51a3522e","title":"寄怀","author":"步非烟","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["画簷春燕须同宿，","兰浦双鸳肯独飞。","长恨桃源诸女伴，","等闲花里送郎归。"],"stanzas":[["画簷春燕须同宿，","兰浦双鸳肯独飞。"],["长恨桃源诸女伴，","等闲花里送郎归。"]]}
{"id":"9e9f403fc0","title":"荅赵象","author":"步非烟","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["相思只恨难相见，","相见还愁却别君。","愿得化为松上鹤，","一双飞去入行云。"],"stanzas":[["相思只恨难相见，","相见还愁却别君。"],["愿得化为松上鹤，","一双飞去入行云。"]]}
{"id":"48b4bc8370","title":"临行献李尚书","author":"崔紫云","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["从来学制斐然诗，","不料霜台御史知。","忽见便教随命去，","恋恩肠断出门时。"],"stanzas":[["从来学制斐然诗，","不料霜台御史知。"],["忽见便教随命去，","恋恩肠断出门时。"]]}
{"id":"7650f26452","title":"怨诗效徐淑体","author":"姚月华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾生兮不辰，","盛年兮逢屯。","寒暑兮心结，","夙夜兮眉颦。","循环兮不息，","如彼兮车轮。","车轮兮可歇，","妾心兮焉伸。","杂沓兮无绪，","如彼兮丝棼。","丝棼兮可理，","妾心兮焉分。","空闺兮岑寂，","妆阁兮生尘。","萱草兮徒树，","兹忧兮岂泯。","幸逢兮君子，","许结兮殷勤。","分香兮翦发，","赠玉兮共珍。","指天兮结誓，","愿为兮一身。","所遭兮多舛，","玉体兮难亲。","损餐兮减寝，","带缓兮罗裙。","菱鉴兮慵启，","博𬬻兮焉熏。","整袜兮欲举，","塞路兮荆榛。","逢人兮欲语，","鞈匝兮顽嚚。","烦冤兮凭胸，","何时兮可论。","愿君兮见察，","妾死兮何瞋。"],"stanzas":[["妾生兮不辰，","盛年兮逢屯。"],["寒暑兮心结，","夙夜兮眉颦。"],["循环兮不息，","如彼兮车轮。"],["车轮兮可歇，","妾心兮焉伸。"],["杂沓兮无绪，","如彼兮丝棼。"],["丝棼兮可理，","妾心兮焉分。"],["空闺兮岑寂，","妆阁兮生尘。"],["萱草兮徒树，","兹忧兮岂泯。"],["幸逢兮君子，","许结兮殷勤。"],["分香兮翦发，","赠玉兮共珍。"],["指天兮结誓，","愿为兮一身。"],["所遭兮多舛，","玉体兮难亲。"],["损餐兮减寝，","带缓兮罗裙。"],["菱鉴兮慵启，","博𬬻兮焉熏。"],["整袜兮欲举，","塞路兮荆榛。"],["逢人兮欲语，","鞈匝兮顽嚚。"],["烦冤兮凭胸，","何时兮可论。"],["愿君兮见察，","妾死兮何瞋。"]]}
{"id":"4c93c5b686","title":"制履赠杨达","author":"姚月华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金刀翦紫羢，","与郎作轻履。","愿化双仙凫，","飞来入闺里。"],"stanzas":[["金刀翦紫羢，","与郎作轻履。"],["愿化双仙凫，","飞来入闺里。"]]}
{"id":"0b7403e384","title":"有期不至","author":"姚月华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["银烛清尊久延伫，","出门入门天欲曙。","月落星稀竟不来，","烟柳胧朣鹊飞去。"],"stanzas":[["银烛清尊久延伫，","出门入门天欲曙。"],["月落星稀竟不来，","烟柳胧朣鹊飞去。"]]}
{"id":"e2a592a972","title":"怨诗寄杨达 一","author":"姚月华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春水悠悠春草绿，","对此思君泪相续。","羞将离恨向东风，","理尽秦筝不成曲。"],"stanzas":[["春水悠悠春草绿，","对此思君泪相续。"],["羞将离恨向东风，","理尽秦筝不成曲。"]]}
{"id":"c3da2b5108","title":"怨诗寄杨达 二","author":"姚月华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["与君形影分吴越，","玉枕经年对离别。","登台北望烟雨深，","回身泣向寥天月。"],"stanzas":[["与君形影分吴越，","玉枕经年对离别。"],["登台北望烟雨深，","回身泣向寥天月。"]]}
{"id":"392457063d","title":"楚妃怨","author":"姚月华","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梧桐叶下黄金井，","横架辘轳牵素绠。","美人初起天未明，","手拂银瓶秋水冷。"],"stanzas":[["梧桐叶下黄金井，","横架辘轳牵素绠。"],["美人初起天未明，","手拂银瓶秋水冷。"]]}
{"id":"ce22779c16","title":"独游家园","author":"孟氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["可惜春时节，","依前独自游。","无端两行泪，","长只对花流。"],"stanzas":[["可惜春时节，","依前独自游。"],["无端两行泪，","长只对花流。"]]}
{"id":"2fa66d1532","title":"荅少年","author":"孟氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁家少年儿，","心中暗自欺。","不道终不可，","可即恐郎知。"],"stanzas":[["谁家少年儿，","心中暗自欺。"],["不道终不可，","可即恐郎知。"]]}
{"id":"3812add0ce","title":"寄情","author":"赵氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风白马紫丝缰，","正值蚕娘未采桑。","五夜有心随暮雨，","百年无节抱秋霜。","重寻绣带朱藤合，","却忍罗裙碧草长。","为报西游减离恨，","阮郎才去嫁刘郎。"],"stanzas":[["春风白马紫丝缰，","正值蚕娘未采桑。"],["五夜有心随暮雨，","百年无节抱秋霜。"],["重寻绣带朱藤合，","却忍罗裙碧草长。"],["为报西游减离恨，","阮郎才去嫁刘郎。"]]}
{"id":"ed3f232adc","title":"书红绡帕 一","author":"李节度姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["囊裹真香谁见窃，","鲛绡滴泪染成红。","殷勤遗下轻绡意，","好与情郎怀袖中。"],"stanzas":[["囊裹真香谁见窃，","鲛绡滴泪染成红。"],["殷勤遗下轻绡意，","好与情郎怀袖中。"]]}
{"id":"3feb2c153a","title":"书红绡帕 二","author":"李节度姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金珠富贵吾家事，","常渴佳期乃寂寥。","偶用志诚求雅合，","良媒未必胜红绡。"],"stanzas":[["金珠富贵吾家事，","常渴佳期乃寂寥。"],["偶用志诚求雅合，","良媒未必胜红绡。"]]}
{"id":"732d8283cf","title":"会张生述怀","author":"李节度姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门前画戟寻常设，","堂上犀簪取次看。","最是恼人情绪处，","凤皇楼上月华寒。"],"stanzas":[["门前画戟寻常设，","堂上犀簪取次看。"],["最是恼人情绪处，","凤皇楼上月华寒。"]]}
{"id":"802242dec2","title":"别韦洵美诗","author":"崔素娥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾闭闲房君路岐，","妾心君恨两依依。","神魂倘遇巫娥伴，","犹逐朝云暮雨归。"],"stanzas":[["妾闭闲房君路岐，","妾心君恨两依依。"],["神魂倘遇巫娥伴，","犹逐朝云暮雨归。"]]}
{"id":"2f0587060c","title":"送韦生酒","author":"鲍家四弦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白露湿庭砌，","皓月临前轩。","此时去留恨，","含思独无言。"],"stanzas":[["白露湿庭砌，","皓月临前轩。"],["此时去留恨，","含思独无言。"]]}
{"id":"a2bbe7dbc0","title":"送鲍生酒","author":"鲍家四弦","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风飐荷珠难暂圆，","多情信有短姻缘。","西楼今夜三更月，","还照离人泣断弦。"],"stanzas":[["风飐荷珠难暂圆，","多情信有短姻缘。"],["西楼今夜三更月，","还照离人泣断弦。"]]}
{"id":"9318f1625d","title":"赠别","author":"[严]续姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风柳摇摇无定枝，","阳台云雨梦中归。","他年蓬岛音尘绝，","留取尊前旧舞衣。"],"stanzas":[["风柳摇摇无定枝，","阳台云雨梦中归。"],["他年蓬岛音尘绝，","留取尊前旧舞衣。"]]}
{"id":"5dd3fa4cab","title":"采桑","author":"郎大家宋氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春来南鴈归，","日去西蚕远。","妾思粉何极，","客游殊未返。"],"stanzas":[["春来南鴈归，","日去西蚕远。"],["妾思粉何极，","客游殊未返。"]]}
{"id":"197604c647","title":"宛转歌二首 一","author":"郎大家宋氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风已清，","月朗琴复鸣。","掩抑非千态，","殷勤是一声。","歌宛转，","宛转和且长。","愿为双鸿鹄，","比翼共翺翔。"],"stanzas":[["风已清，","月朗琴复鸣。"],["掩抑非千态，","殷勤是一声。"],["歌宛转，","宛转和且长。"],["愿为双鸿鹄，","比翼共翺翔。"]]}
{"id":"08d9d985f2","title":"宛转歌二首 二","author":"郎大家宋氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日已暮，","长簷鸟声度。","此时望君君不来，","此时思君君不顾。","歌宛转，","宛转那能异栖宿。","愿为形与影，","出入恒相逐。"],"stanzas":[["日已暮，","长簷鸟声度。"],["此时望君君不来，","此时思君君不顾。"],["歌宛转，","宛转那能异栖宿。"],["愿为形与影，","出入恒相逐。"]]}
{"id":"d920f88bf0","title":"长相思","author":"郎大家宋氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长相思，","久离别。","关山阻，","风烟绝。","台上镜文销，","袖中书字灭。","不见君形影，","何曾有欢悦。"],"stanzas":[["长相思，","久离别。"],["关山阻，","风烟绝。"],["台上镜文销，","袖中书字灭。"],["不见君形影，","何曾有欢悦。"]]}
{"id":"81fc184f86","title":"朝云引","author":"郎大家宋氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巴西巫峡指巴东，","朝云触石上朝空。","巫山巫峡高何已，","行雨行云一时起。","一时起，","三春暮。","若言来，","且就阳台路。"],"stanzas":[["巴西巫峡指巴东，","朝云触石上朝空。"],["巫山巫峡高何已，","行雨行云一时起。"],["一时起，","三春暮。"],["若言来，","且就阳台路。"]]}
{"id":"6d41e0b075","title":"宿巫山寄远人","author":"梁琼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["巫山云，","巫山雨，","朝云暮雨无定所。","南峰忽暗北峰晴，","空里仙人语笑声。","曾侍荆王枕席处，","直至如今如有灵。","春风澹澹白云闲，","惊湍流水响千山。","一夜此中对明月，","忆得此中与君别。","感物情怀如旧时，","君今渺渺在天涯。","晓看襟上泪流处，","点点血痕犹在衣。"],"stanzas":[["巫山云，","巫山雨，","朝云暮雨无定所。"],["南峰忽暗北峰晴，","空里仙人语笑声。"],["曾侍荆王枕席处，","直至如今如有灵。"],["春风澹澹白云闲，","惊湍流水响千山。"],["一夜此中对明月，","忆得此中与君别。"],["感物情怀如旧时，","君今渺渺在天涯。"],["晓看襟上泪流处，","点点血痕犹在衣。"]]}
{"id":"db1654ca6a","title":"昭君怨","author":"梁琼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自古无和亲，","贻灾到妾身。","朔风嘶去马，","汉月出行轮。","衣薄狼山雪，","妆成虏塞春。","回看父母国，","生死毕胡尘。"],"stanzas":[["自古无和亲，","贻灾到妾身。"],["朔风嘶去马，","汉月出行轮。"],["衣薄狼山雪，","妆成虏塞春。"],["回看父母国，","生死毕胡尘。"]]}
{"id":"69c6d6cff7","title":"铜雀台","author":"梁琼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["歌扇向陵开，","齐行奠玉杯。","舞时飞燕列，","梦里片云来。","月色空余恨，","松声莫更哀。","谁怜未死妾，","掩袂下铜台。"],"stanzas":[["歌扇向陵开，","齐行奠玉杯。"],["舞时飞燕列，","梦里片云来。"],["月色空余恨，","松声莫更哀。"],["谁怜未死妾，","掩袂下铜台。"]]}
{"id":"150ab5291c","title":"远意","author":"梁琼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["脉脉长摅气，","微微不离心。","叩头从此去，","烦恼阿谁禁。"],"stanzas":[["脉脉长摅气，","微微不离心。"],["叩头从此去，","烦恼阿谁禁。"]]}
{"id":"ca367f331d","title":"句","author":"梁琼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉枕空流别后泪，","罗衣已尽去时香。"],"stanzas":[["玉枕空流别后泪，","罗衣已尽去时香。"]]}
{"id":"ce6ba3ea13","title":"有所思","author":"刘云","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝亦有所思，","暮亦有所思。","登楼望君处，","蔼蔼萧关道。","掩泪向浮云，","谁知妾怀抱。","玉井苍苔春院深，","桐花落尽无人埽。"],"stanzas":[["朝亦有所思，","暮亦有所思。"],["登楼望君处，","蔼蔼萧关道。"],["掩泪向浮云，","谁知妾怀抱。"],["玉井苍苔春院深，","桐花落尽无人埽。"]]}
{"id":"32f6db8e4d","title":"婕妤怨","author":"刘云","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君恩不可见，","妾岂如秋扇。","秋扇尚有时，","妾身永微贱。","莫言朝花不复落，","娇容几夺昭阳殿。"],"stanzas":[["君恩不可见，","妾岂如秋扇。"],["秋扇尚有时，","妾身永微贱。"],["莫言朝花不复落，","娇容几夺昭阳殿。"]]}
{"id":"ad2257ff54","title":"望月","author":"刘云","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天汉凉秋夜，","澄澄一镜明。","山空猨屡啸，","林静鹊频惊。"],"stanzas":[["天汉凉秋夜，","澄澄一镜明。"],["山空猨屡啸，","林静鹊频惊。"]]}
{"id":"fa098b6429","title":"古意","author":"崔萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灼灼叶中花，","夏萎春又芳。","明明天上月，","蟾缺圆复光。","未如君子情，","朝违夕已忘。","玉帐枕犹暖，","纨扇思何长。","愿因西南风，","吹上玳瑁床。","娇眠锦衾里，","展转双鸳鸯。"],"stanzas":[["灼灼叶中花，","夏萎春又芳。"],["明明天上月，","蟾缺圆复光。"],["未如君子情，","朝违夕已忘。"],["玉帐枕犹暖，","纨扇思何长。"],["愿因西南风，","吹上玳瑁床。"],["娇眠锦衾里，","展转双鸳鸯。"]]}
{"id":"f29dd13623","title":"叙别","author":"崔萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["碧池漾漾春水绿，","中有佳禽暮栖宿。","愿持此意永相贻，","祗虑君情中反复。"],"stanzas":[["碧池漾漾春水绿，","中有佳禽暮栖宿。"],["愿持此意永相贻，","祗虑君情中反复。"]]}
{"id":"fd59d233e3","title":"豪家子","author":"崔萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年少家藏累代金，","红楼尽日醉沈沈。","马非躞蹀宁酬价，","人不婵娟肯动心。"],"stanzas":[["年少家藏累代金，","红楼尽日醉沈沈。"],["马非躞蹀宁酬价，","人不婵娟肯动心。"]]}
{"id":"0282a74889","title":"句","author":"崔萱","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["岂知一只凤钗价，","沽得数村蜗舍人。"],"stanzas":[["岂知一只凤钗价，","沽得数村蜗舍人。"]]}
{"id":"7af09bf707","title":"赠所思","author":"崔仲容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["所居幸接隣，","相见不相亲。","一似云间月，","何殊镜里人。","丹诚空有梦，","肠断不禁春。","愿作梁间燕，","无由变此身。"],"stanzas":[["所居幸接隣，","相见不相亲。"],["一似云间月，","何殊镜里人。"],["丹诚空有梦，","肠断不禁春。"],["愿作梁间燕，","无由变此身。"]]}
{"id":"b60c590412","title":"戏赠","author":"崔仲容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["暂到昆仑未得归，","阮郎何事教人非。","如今身佩上清箓，","莫遣落花沾羽衣。"],"stanzas":[["暂到昆仑未得归，","阮郎何事教人非。"],["如今身佩上清箓，","莫遣落花沾羽衣。"]]}
{"id":"7cbb6bc892","title":"赠歌姬","author":"崔仲容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水翦双眸雾翦衣，","当筵一曲媚春辉。","潇湘夜瑟怨犹在，","巫峡晓云愁不稀。","皓齿乍分寒玉细，","黛眉轻蹙远山微。","渭城朝雨休重唱，","满眼阳关客未归。"],"stanzas":[["水翦双眸雾翦衣，","当筵一曲媚春辉。"],["潇湘夜瑟怨犹在，","巫峡晓云愁不稀。"],["皓齿乍分寒玉细，","黛眉轻蹙远山微。"],["渭城朝雨休重唱，","满眼阳关客未归。"]]}
{"id":"d282b74b67","title":"句","author":"崔仲容","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["妾心合君心，","一似影随形。","梁燕无情困，","双栖语此时。","不觉红颜去，","空嗟白发生。","桐花落尽春又尽，","紫塞征人犹未归。"],"stanzas":[["妾心合君心，","一似影随形。"],["梁燕无情困，","双栖语此时。"],["不觉红颜去，","空嗟白发生。"],["桐花落尽春又尽，","紫塞征人犹未归。"]]}
{"id":"90d9df6fd4","title":"独夜词","author":"崔公远","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["晴天霜落寒风急，","锦帐罗帏羞更入。","秦筝不复续断弦，","回身掩泪挑灯立。"],"stanzas":[["晴天霜落寒风急，","锦帐罗帏羞更入。"],["秦筝不复续断弦，","回身掩泪挑灯立。"]]}
{"id":"e76dfa0370","title":"句","author":"崔公远","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["看花独不语，","裴回双泪澘。","君今远戍在何处，","遣妾秋来长望天。"],"stanzas":[["看花独不语，","裴回双泪澘。"],["君今远戍在何处，","遣妾秋来长望天。"]]}
{"id":"30790e1b10","title":"春词二首 一","author":"张琰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["垂柳鸣黄鹂，","关关若求友。","春情不可耐，","愁杀闺中妇。","日暮登高楼，","谁怜小垂手。"],"stanzas":[["垂柳鸣黄鹂，","关关若求友。"],["春情不可耐，","愁杀闺中妇。"],["日暮登高楼，","谁怜小垂手。"]]}
{"id":"d69bf61f33","title":"春词二首 二","author":"张琰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日桃花飞，","今朝梨花吐。","春色能几时，","那堪此愁绪。","荡子游不归，","春来泪如雨。"],"stanzas":[["昨日桃花飞，","今朝梨花吐。"],["春色能几时，","那堪此愁绪。"],["荡子游不归，","春来泪如雨。"]]}
{"id":"02a526242f","title":"铜雀台","author":"张琰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君王冥漠不可见，","铜雀歌舞空裴回。","西陵啧啧悲宿鸟，","高殿沈沈闭青苔。","青苔无人迹，","红粉空自哀。"],"stanzas":[["君王冥漠不可见，","铜雀歌舞空裴回。"],["西陵啧啧悲宿鸟，","高殿沈沈闭青苔。"],["青苔无人迹，","红粉空自哀。"]]}
{"id":"d28352a765","title":"句","author":"张琰","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年年人自老，","日日水东流。","庭芳自摇落，","永念结中肠。"],"stanzas":[["年年人自老，","日日水东流。"],["庭芳自摇落，","永念结中肠。"]]}
{"id":"d302185179","title":"哭夫二首 一","author":"裴羽仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风卷平沙日欲曛，","狼烟遥认犬羊群。","李陵一战无归日，","望断胡天哭塞云。"],"stanzas":[["风卷平沙日欲曛，","狼烟遥认犬羊群。"],["李陵一战无归日，","望断胡天哭塞云。"]]}
{"id":"ec38f2ebd5","title":"哭夫二首 二","author":"裴羽仙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["良人平昔逐蕃浑，","力战轻行出塞门。","从此不归成万古，","空留贱妾怨黄昏。"],"stanzas":[["良人平昔逐蕃浑，","力战轻行出塞门。"],["从此不归成万古，","空留贱妾怨黄昏。"]]}
{"id":"842a893817","title":"长门怨 一","author":"刘媛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["雨滴梧桐秋夜长，","愁心和雨到昭阳。","泪痕不学君恩断，","拭却千行更万行。"],"stanzas":[["雨滴梧桐秋夜长，","愁心和雨到昭阳。"],["泪痕不学君恩断，","拭却千行更万行。"]]}
{"id":"d43fb7dcf1","title":"长门怨 二","author":"刘媛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["学画蛾眉独出群，","当时人道便承恩。","经年不见君王面，","花落黄昏空掩门。"],"stanzas":[["学画蛾眉独出群，","当时人道便承恩。"],["经年不见君王面，","花落黄昏空掩门。"]]}
{"id":"4f3c285886","title":"送远","author":"刘媛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻道瞿塘滟滪堆，","青山流水近阳台。","知君此去无还日，","妾亦随波不复回。"],"stanzas":[["闻道瞿塘滟滪堆，","青山流水近阳台。"],["知君此去无还日，","妾亦随波不复回。"]]}
{"id":"c3cadd55ee","title":"句","author":"刘媛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春风报梅柳，","一夜发南枝。","傍人那得知心事，","一面残妆空泪痕。"],"stanzas":[["春风报梅柳，","一夜发南枝。"],["傍人那得知心事，","一面残妆空泪痕。"]]}
{"id":"f30d29bcba","title":"怀良人","author":"葛鵶儿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蓬鬓荆钗世所稀，","布裙犹是嫁时衣。","胡麻好种无人种，","正是归时不见归。"],"stanzas":[["蓬鬓荆钗世所稀，","布裙犹是嫁时衣。"],["胡麻好种无人种，","正是归时不见归。"]]}
{"id":"9edc4e9982","title":"会仙诗 一","author":"葛鵶儿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["彩凤摇摇下翠微，","烟光漠漠徧芳枝。","玉窗仙会何人见，","唯有春风仔细知。"],"stanzas":[["彩凤摇摇下翠微，","烟光漠漠徧芳枝。"],["玉窗仙会何人见，","唯有春风仔细知。"]]}
{"id":"c644c629f6","title":"会仙诗 二","author":"葛鵶儿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["烟霞迤逦接蓬莱，","宫殿参差晓日开。","群玉山前人别处，","紫鸾飞起望仙台。"],"stanzas":[["烟霞迤逦接蓬莱，","宫殿参差晓日开。"],["群玉山前人别处，","紫鸾飞起望仙台。"]]}
{"id":"ee96ac9d7a","title":"暗别离","author":"刘瑶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["槐花结子桐叶焦，","单飞越鸟啼青霄。","翠轩辗云轻遥遥，","燕脂泪迸红线条。","瑶草歇芳心耿耿，","玉佩无声画屏冷。","朱弦暗断不见人，","风动花枝月中影。","青鸾脉脉西飞去，","海阔天高不知处。"],"stanzas":[["槐花结子桐叶焦，","单飞越鸟啼青霄。"],["翠轩辗云轻遥遥，","燕脂泪迸红线条。"],["瑶草歇芳心耿耿，","玉佩无声画屏冷。"],["朱弦暗断不见人，","风动花枝月中影。"],["青鸾脉脉西飞去，","海阔天高不知处。"]]}
{"id":"0a0699d978","title":"古意曲","author":"刘瑶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梧桐阶下月团团，","洞房如水秋夜阑。","吴刀翦破机头锦，","茱萸花坠相思枕。","绿窗寂寞背灯时，","暗数寒更不成寝。"],"stanzas":[["梧桐阶下月团团，","洞房如水秋夜阑。"],["吴刀翦破机头锦，","茱萸花坠相思枕。"],["绿窗寂寞背灯时，","暗数寒更不成寝。"]]}
{"id":"89f17a3c52","title":"阖闾城怀古","author":"刘瑶","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["五湖春水接遥天，","国破君亡不记年。","唯有妖娥曾舞处，","古台寂寞起愁烟。"],"stanzas":[["五湖春水接遥天，","国破君亡不记年。"],["唯有妖娥曾舞处，","古台寂寞起愁烟。"]]}
{"id":"ea7152ba4c","title":"峡中即事","author":"廉氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清秋三峡此中去，","鸣鸟孤猨不可闻。","一道水声多乱石，","四时天色少晴云。","日暮泛舟溪溆口，","那堪夜永思氛氲。"],"stanzas":[["清秋三峡此中去，","鸣鸟孤猨不可闻。"],["一道水声多乱石，","四时天色少晴云。"],["日暮泛舟溪溆口，","那堪夜永思氛氲。"]]}
{"id":"14605c2f8b","title":"怀远","author":"廉氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["隟尘何微微，","朝夕通其辉。","人生各有托，","君去独不归。","青林有蝉响，","赤日无鸟飞。","裴回东南望，","双泪空沾衣。"],"stanzas":[["隟尘何微微，","朝夕通其辉。"],["人生各有托，","君去独不归。"],["青林有蝉响，","赤日无鸟飞。"],["裴回东南望，","双泪空沾衣。"]]}
{"id":"fc3cc3a17b","title":"寄征人","author":"廉氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凄凄北风吹鸳被，","娟娟西月生蛾眉。","谁知独夜相思处，","泪滴寒塘蕙草时。"],"stanzas":[["凄凄北风吹鸳被，","娟娟西月生蛾眉。"],["谁知独夜相思处，","泪滴寒塘蕙草时。"]]}
{"id":"dae90e9fa3","title":"寄远","author":"田娥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忆昨会诗酒，","终日相逢迎。","今来成故事，","岁月令人惊。","泪流红粉薄，","风度罗衣轻。","难为子猷志，","虚负文君名。"],"stanzas":[["忆昨会诗酒，","终日相逢迎。"],["今来成故事，","岁月令人惊。"],["泪流红粉薄，","风度罗衣轻。"],["难为子猷志，","虚负文君名。"]]}
{"id":"5c02356ac5","title":"携手曲","author":"田娥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["携手共惜芳菲节，","莺啼锦花满城阙。","行乐逶迤念容色，","色衰秪恐君恩歇。","凤笙龙管白日阴，","盈亏自感青天月。"],"stanzas":[["携手共惜芳菲节，","莺啼锦花满城阙。"],["行乐逶迤念容色，","色衰秪恐君恩歇。"],["凤笙龙管白日阴，","盈亏自感青天月。"]]}
{"id":"3fae8cbf76","title":"长信宫","author":"田娥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["团圆手中扇，","昔为君所持。","今日君弃捐，","复值秋风时。","悲将入箧笥，","自叹知何为。"],"stanzas":[["团圆手中扇，","昔为君所持。"],["今日君弃捐，","复值秋风时。"],["悲将入箧笥，","自叹知何为。"]]}
{"id":"b27c6f57bd","title":"句","author":"田娥","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春至偏无兴，","秋来秪是眠。"],"stanzas":[["春至偏无兴，","秋来秪是眠。"]]}
{"id":"29cf4b082b","title":"中秋夜泊武昌","author":"刘淑柔","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["两城相对峙，","一水向东流。","今夜素娥月，","何年黄鹤楼。","悠悠兰棹晚，","渺渺荻花秋。","无奈柔肠断，","关山总是愁。"],"stanzas":[["两城相对峙，","一水向东流。"],["今夜素娥月，","何年黄鹤楼。"],["悠悠兰棹晚，","渺渺荻花秋。"],["无奈柔肠断，","关山总是愁。"]]}
{"id":"3faf5e887b","title":"赋荆门","author":"薛琼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄鸟翻红树，","青牛卧绿苔。","渚宫歌舞地，","轻雾锁楼台。"],"stanzas":[["黄鸟翻红树，","青牛卧绿苔。"],["渚宫歌舞地，","轻雾锁楼台。"]]}
{"id":"da11adfee3","title":"戏赠","author":"赵虚舟","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["砌下梧桐叶正齐，","花繁雨后压枝低。","报道不须鵶鸟乱，","他家自有凤凰栖。"],"stanzas":[["砌下梧桐叶正齐，","花繁雨后压枝低。"],["报道不须鵶鸟乱，","他家自有凤凰栖。"]]}
{"id":"9cab3d37d5","title":"铜雀台","author":"张瑛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君王冥漠不可见，","铜雀歌舞空裴回。","西陵啧啧悲宿鸟，","高殿沈沈闭青苔。","青苔无人迹，","红粉空相哀。"],"stanzas":[["君王冥漠不可见，","铜雀歌舞空裴回。"],["西陵啧啧悲宿鸟，","高殿沈沈闭青苔。"],["青苔无人迹，","红粉空相哀。"]]}
{"id":"cb2eb00817","title":"望月","author":"张瑛","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["天汉凉秋夜，","澄澄一镜明。","山空猨屡啸，","林静鹤频惊。"],"stanzas":[["天汉凉秋夜，","澄澄一镜明。"],["山空猨屡啸，","林静鹤频惊。"]]}
{"id":"c0882f3683","title":"荅外","author":"长孙佐转妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["征人去年戍边水，","夜得边书字盈纸。","挥刀就烛裁红绮，","结作同心荅千里。","君寄边书书莫绝，","妾荅同心心自结。","同心再解不心离，","离字频看字愁灭。","结成一衣和泪封，","封书只在怀袖中。","莫如书故字难久，","愿学同心长可同。"],"stanzas":[["征人去年戍边水，","夜得边书字盈纸。"],["挥刀就烛裁红绮，","结作同心荅千里。"],["君寄边书书莫绝，","妾荅同心心自结。"],["同心再解不心离，","离字频看字愁灭。"],["结成一衣和泪封，","封书只在怀袖中。"],["莫如书故字难久，","愿学同心长可同。"]]}
{"id":"cfc79d6669","title":"早梅","author":"刘元载妻","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南枝向暖北枝寒，","一种春风有两般。","凭仗高楼莫吹笛，","大家留取倚阑干。"],"stanzas":[["南枝向暖北枝寒，","一种春风有两般。"],["凭仗高楼莫吹笛，","大家留取倚阑干。"]]}
{"id":"f8d361d9f3","title":"明月堂 一","author":"刘氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蝉鬓惊秋华发新，","可怜红隙尽埃尘。","西山一梦何年觉，","明月堂前不见人。"],"stanzas":[["蝉鬓惊秋华发新，","可怜红隙尽埃尘。"],["西山一梦何年觉，","明月堂前不见人。"]]}
{"id":"f88df0a9e1","title":"明月堂 二","author":"刘氏妇","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉钩风急响丁东，","回首西山似梦中。","明月堂前人不到，","庭梧一夜老秋风。"],"stanzas":[["玉钩风急响丁东，","回首西山似梦中。"],["明月堂前人不到，","庭梧一夜老秋风。"]]}
{"id":"e0ce3a2d03","title":"和潘雍","author":"葛氏女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九天天远瑞烟浓，","驾鹤骖鸾意已同。","从此三山山上月，","琼花开处照春风。"],"stanzas":[["九天天远瑞烟浓，","驾鹤骖鸾意已同。"],["从此三山山上月，","琼花开处照春风。"]]}
{"id":"892febcd33","title":"寄诗","author":"李主簿姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去时盟约与心违，","秋日离家春不归。","应是维扬风景好，","恣情欢笑到芳菲。"],"stanzas":[["去时盟约与心违，","秋日离家春不归。"],["应是维扬风景好，","恣情欢笑到芳菲。"]]}
{"id":"bee5d23539","title":"题兴元明珠亭","author":"京兆女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["寂寥满地落花红，","独有离人万恨中。","回首池塘更无语，","手弹珠泪与春风。"],"stanzas":[["寂寥满地落花红，","独有离人万恨中。"],["回首池塘更无语，","手弹珠泪与春风。"]]}
{"id":"6a94455dac","title":"题玉泉溪","author":"湘驿女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红叶醉秋色，","碧溪弹夜弦。","佳期不可再，","风雨杳如年。"],"stanzas":[["红叶醉秋色，","碧溪弹夜弦。"],["佳期不可再，","风雨杳如年。"]]}
{"id":"caf972c634","title":"题三乡诗","author":"若耶溪女子","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔逐良人西入关，","良人身殁妾空还。","谢娘卫女不相待，","为雨为云归此山。"],"stanzas":[["昔逐良人西入关，","良人身殁妾空还。"],["谢娘卫女不相待，","为雨为云归此山。"]]}
{"id":"9cda9b9818","title":"题沙鹿门","author":"谁氏女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔逐良人去上京，","良人身殁妾东征。","同来不得同归去，","永负朝云暮雨情。"],"stanzas":[["昔逐良人去上京，","良人身殁妾东征。"],["同来不得同归去，","永负朝云暮雨情。"]]}
{"id":"9803819293","title":"联句","author":"光\t威\t裒","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱楼影直日当午，","玉树阴低月已三。","腻粉暗销银镂合，","错刀闲翦泥金衫。","绣床怕引乌龙吠，","锦字愁教青鸟衔。","百味炼来怜益母，","千花开处鬬宜男。","鸳鸯有伴谁能羡，","鹦鹉无言我自惭。","浪喜游蜂飞扑扑，","佯惊孤燕语喃喃。","偏怜爱数螆蛦掌，","每忆光抽玳瑁簪。","烟洞几年悲尚在，","星桥一夕帐空含。","窗前时节羞虚掷，","世上风流笑苦谙。","独结香绡偷饷送，","暗垂檀袖学通参。","须知化石心难定，","却是为云分易甘。","看见风光零落尽，","弦声犹逐望江南。"],"stanzas":[["朱楼影直日当午，","玉树阴低月已三。"],["腻粉暗销银镂合，","错刀闲翦泥金衫。"],["绣床怕引乌龙吠，","锦字愁教青鸟衔。"],["百味炼来怜益母，","千花开处鬬宜男。"],["鸳鸯有伴谁能羡，","鹦鹉无言我自惭。"],["浪喜游蜂飞扑扑，","佯惊孤燕语喃喃。"],["偏怜爱数螆蛦掌，","每忆光抽玳瑁簪。"],["烟洞几年悲尚在，","星桥一夕帐空含。"],["窗前时节羞虚掷，","世上风流笑苦谙。"],["独结香绡偷饷送，","暗垂檀袖学通参。"],["须知化石心难定，","却是为云分易甘。"],["看见风光零落尽，","弦声犹逐望江南。"]]}
{"id":"3817ae08f1","title":"联句","author":"越溪杨女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["珠帘半床月，","青竹满林风。","何事今宵景，","无人解语同。"],"stanzas":[["珠帘半床月，","青竹满林风。"],["何事今宵景，","无人解语同。"]]}
{"id":"5f0e48f8ee","title":"春日","author":"越溪杨女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春尽花随尽，","其如自是花。","从来说花意，","不过此容华。","明月易亏轮，","好花难恋春。","常将花月恨，","并作可怜人。"],"stanzas":[["春尽花随尽，","其如自是花。"],["从来说花意，","不过此容华。"],["明月易亏轮，","好花难恋春。"],["常将花月恨，","并作可怜人。"]]}
{"id":"7db7004633","title":"句","author":"曹文姬","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["凿开天外长生地，","炼出人间不死丹。"],"stanzas":[["凿开天外长生地，","炼出人间不死丹。"]]}
{"id":"072475e789","title":"燕子楼三首 一","author":"关盼盼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼上残灯伴晓霜，","独眠人起合欢床。","相思一夜情多少，","地角天涯不是长。"],"stanzas":[["楼上残灯伴晓霜，","独眠人起合欢床。"],["相思一夜情多少，","地角天涯不是长。"]]}
{"id":"01b35bc3d5","title":"燕子楼三首 二","author":"关盼盼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北邙松柏锁愁烟，","燕子楼中思悄然。","自埋劒履歌尘散，","红袖香销一十年。"],"stanzas":[["北邙松柏锁愁烟，","燕子楼中思悄然。"],["自埋劒履歌尘散，","红袖香销一十年。"]]}
{"id":"faf7cdab3d","title":"燕子楼三首 三","author":"关盼盼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["适看鸿雁岳阳回，","又覩玄禽逼社来。","瑶瑟玉箫无意绪，","任从蛛网任从灰。"],"stanzas":[["适看鸿雁岳阳回，","又覩玄禽逼社来。"],["瑶瑟玉箫无意绪，","任从蛛网任从灰。"]]}
{"id":"03e9689607","title":"和白公诗","author":"关盼盼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自守空楼敛恨眉，","形同春后牡丹枝。","舍人不会人深意，","讶道泉台不去随。"],"stanzas":[["自守空楼敛恨眉，","形同春后牡丹枝。"],["舍人不会人深意，","讶道泉台不去随。"]]}
{"id":"0f16e8c720","title":"句","author":"关盼盼","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["儿童不识冲天物，","漫把青泥污雪毫。"],"stanzas":[["儿童不识冲天物，","漫把青泥污雪毫。"]]}
{"id":"d74604e578","title":"啰唝曲六首 一","author":"刘采春","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不喜秦淮水，","生憎江上船。","载儿夫壻去，","经岁又经年。"],"stanzas":[["不喜秦淮水，","生憎江上船。"],["载儿夫壻去，","经岁又经年。"]]}
{"id":"f1992b3756","title":"啰唝曲六首 二","author":"刘采春","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["借问东园柳，","枯来得几年。","自无枝叶分，","莫怨太阳偏。"],"stanzas":[["借问东园柳，","枯来得几年。"],["自无枝叶分，","莫怨太阳偏。"]]}
{"id":"141c6def4f","title":"啰唝曲六首 三","author":"刘采春","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["莫作商人妇，","金钗当卜钱。","朝朝江口望，","错认几人船。"],"stanzas":[["莫作商人妇，","金钗当卜钱。"],["朝朝江口望，","错认几人船。"]]}
{"id":"6cc145c5af","title":"啰唝曲六首 四","author":"刘采春","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["那年离别日，","只道住桐庐。","桐庐人不见，","今得广州书。"],"stanzas":[["那年离别日，","只道住桐庐。"],["桐庐人不见，","今得广州书。"]]}
{"id":"4af0dcac80","title":"啰唝曲六首 五","author":"刘采春","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日胜今日，","今年老去年。","黄河清有日，","白发黑无缘。"],"stanzas":[["昨日胜今日，","今年老去年。"],["黄河清有日，","白发黑无缘。"]]}
{"id":"14b97ac8e0","title":"啰唝曲六首 六","author":"刘采春","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昨日北风寒，","牵船浦里安。","潮来打缆断，","摇橹始知难。"],"stanzas":[["昨日北风寒，","牵船浦里安。"],["潮来打缆断，","摇橹始知难。"]]}
{"id":"3e51179c2b","title":"寄欧阳詹","author":"太原妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["自从别后减容光，","半是思郎半恨郎。","欲识旧来云髻样，","为奴开取缕金箱。"],"stanzas":[["自从别后减容光，","半是思郎半恨郎。"],["欲识旧来云髻样，","为奴开取缕金箱。"]]}
{"id":"9a94b1afc9","title":"续韦蟾句","author":"武昌妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["悲莫悲兮生别离，","登山临水送将归。","武昌无限新栽柳，","不见杨花扑面飞。"],"stanzas":[["悲莫悲兮生别离，","登山临水送将归。"],["武昌无限新栽柳，","不见杨花扑面飞。"]]}
{"id":"76db8c12dc","title":"献李观察","author":"舞柘枝女","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["湘江舞罢忽成悲，","便脱蛮靴出绛帷。","谁是蔡邕琴酒客，","魏公怀旧嫁文姬。"],"stanzas":[["湘江舞罢忽成悲，","便脱蛮靴出绛帷。"],["谁是蔡邕琴酒客，","魏公怀旧嫁文姬。"]]}
{"id":"e6c91f8799","title":"赠卢夫人","author":"常浩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["佳人惜颜色，","恐逐芳菲歇。","日暮出画堂，","下堦拜新月。","拜月如有词，","傍人那得知。","归来投玉枕，","始觉泪痕垂。"],"stanzas":[["佳人惜颜色，","恐逐芳菲歇。"],["日暮出画堂，","下堦拜新月。"],["拜月如有词，","傍人那得知。"],["归来投玉枕，","始觉泪痕垂。"]]}
{"id":"3ecd9ed071","title":"寄远","author":"常浩","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["年年二月时，","十年期别期。","春风不知信，","轩盖独迟迟。","今日无端卷珠箔，","始见庭花复零落。","人心一往不复归，","岁月来时未尝错。","可怜荧荧玉镜台，","尘飞幂幂几时开。","却念容华非昔好，","画眉犹自待君来。"],"stanzas":[["年年二月时，","十年期别期。"],["春风不知信，","轩盖独迟迟。"],["今日无端卷珠箔，","始见庭花复零落。"],["人心一往不复归，","岁月来时未尝错。"],["可怜荧荧玉镜台，","尘飞幂幂几时开。"],["却念容华非昔好，","画眉犹自待君来。"]]}
{"id":"4cdb56b694","title":"送武补阙","author":"襄阳妓","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["弄珠滩上欲销魂，","独把离怀寄酒尊。","无限烟花不留意，","忍教芳草怨王孙。"],"stanzas":[["弄珠滩上欲销魂，","独把离怀寄酒尊。"],["无限烟花不留意，","忍教芳草怨王孙。"]]}
{"id":"a6cdf7115e","title":"题孙棨诗后","author":"王福娘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苦把文章邀劝人，","吟看好个语言新。","虽然不及相如赋，","也直黄金一二斤。"],"stanzas":[["苦把文章邀劝人，","吟看好个语言新。"],["虽然不及相如赋，","也直黄金一二斤。"]]}
{"id":"b52edfb463","title":"问棨诗","author":"王福娘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["日日悲伤未有图，","嬾将心事话凡夫。","非同覆水应收得，","只问仙郎有意无。"],"stanzas":[["日日悲伤未有图，","嬾将心事话凡夫。"],["非同覆水应收得，","只问仙郎有意无。"]]}
{"id":"b4f9d9cb1c","title":"谢棨诗","author":"王福娘","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["久赋恩情欲托身，","已将心事再三陈。","泥莲既没移栽分，","今日分离莫恨人。"],"stanzas":[["久赋恩情欲托身，","已将心事再三陈。"],["泥莲既没移栽分，","今日分离莫恨人。"]]}
{"id":"7f53352303","title":"荅小子弟诗","author":"杨莱儿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄口小儿口莫凭，","逡巡看取第三名。","孝廉持水添缾子，","莫向街头乱椀鸣。"],"stanzas":[["黄口小儿口莫凭，","逡巡看取第三名。"],["孝廉持水添缾子，","莫向街头乱椀鸣。"]]}
{"id":"fc38ea8b8b","title":"和赵光远题壁","author":"杨莱儿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["长者车尘每到门，","长卿非慕卓王孙。","定知羽翼难随凤，","却喜波涛未化鲲。","娇别翠钿黏去袂，","醉歌金雀碎残尊。","多情多病年应促，","早办名香为返魂。"],"stanzas":[["长者车尘每到门，","长卿非慕卓王孙。"],["定知羽翼难随凤，","却喜波涛未化鲲。"],["娇别翠钿黏去袂，","醉歌金雀碎残尊。"],["多情多病年应促，","早办名香为返魂。"]]}
{"id":"07900ace24","title":"贻郑昌图","author":"楚儿","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["应是前生有宿冤，","不期今世恶因缘。","蛾眉欲碎巨灵掌，","鸡肋难胜子路拳。","秪拟吓人传铁券，","未应教我踏青莲。","曲江昨日君相遇，","当下遭他数十鞭。"],"stanzas":[["应是前生有宿冤，","不期今世恶因缘。"],["蛾眉欲碎巨灵掌，","鸡肋难胜子路拳。"],["秪拟吓人传铁券，","未应教我踏青莲。"],["曲江昨日君相遇，","当下遭他数十鞭。"]]}
{"id":"3c20ad4f37","title":"和李标","author":"王苏苏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["怪得犬惊鸡乱飞，","羸童瘦马老麻衣。","阿谁乱引闲人到，","留住青蚨热赶归。"],"stanzas":[["怪得犬惊鸡乱飞，","羸童瘦马老麻衣。"],["阿谁乱引闲人到，","留住青蚨热赶归。"]]}
