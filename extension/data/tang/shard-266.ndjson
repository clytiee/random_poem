{"id":"f20261f320","title":"咏月诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉钩千丈挂，","金波万里遥。","蚌亏轮影灭，","蓂落桂阴销。","入风花气馥，","出树鸟声娇。","独使高楼妇，","空度可怜宵。"],"stanzas":[["玉钩千丈挂，","金波万里遥。"],["蚌亏轮影灭，","蓂落桂阴销。"],["入风花气馥，","出树鸟声娇。"],["独使高楼妇，","空度可怜宵。"]]}
{"id":"7a8077bb6a","title":"咏春诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["何处觅消愁？","春园可暂游。","菊黄堪泛酒，","梅红可插头。","（以上二首为落节诗）。"],"stanzas":[["何处觅消愁？","春园可暂游。"],["菊黄堪泛酒，","梅红可插头。"],["（以上二首为落节诗）。"]]}
{"id":"5b7b125838","title":"忆友诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["思君不可见，","徒令年鬓秋。","独惊积寒暑，","迢遰阻风牛。","奥余慕樵隐，","萧然重一丘。","（此为杂乱诗）。"],"stanzas":[["思君不可见，","徒令年鬓秋。"],["独惊积寒暑，","迢遰阻风牛。"],["奥余慕樵隐，","萧然重一丘。"],["（此为杂乱诗）。"]]}
