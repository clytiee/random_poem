{"id":"fb632586c8","title":"道藏歌诗 四十八","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉台敷朱霄，","绿霞高有墉。","体矫万津波，","神生摄十方。"],"stanzas":[["玉台敷朱霄，","绿霞高有墉。"],["体矫万津波，","神生摄十方。"]]}
{"id":"70bad1eb6f","title":"道藏歌诗 四十九","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["但闻仙道贵，","不闻鬼道隆。","谣謌参天炁，","贾生元正章。","（以上四十首均见同书卷二）。"],"stanzas":[["但闻仙道贵，","不闻鬼道隆。"],["谣謌参天炁，","贾生元正章。"],["（以上四十首均见同书卷二）。"]]}
{"id":"3ac4b6e39b","title":"道藏歌诗 五十","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["提携宴玉宾，","契驾乘烟骋。","黄箓命玉符，","公子运我上。"],"stanzas":[["提携宴玉宾，","契驾乘烟骋。"],["黄箓命玉符，","公子运我上。"]]}
{"id":"b746978e5c","title":"道藏歌诗 五十一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玉虚范玄象，","高会通冥想。","三曜无停晖，","明真焕云芒。"],"stanzas":[["玉虚范玄象，","高会通冥想。"],["三曜无停晖，","明真焕云芒。"]]}
{"id":"eec7caf948","title":"道藏歌诗 五十二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["解散七玄祖，","更法无中影。","七化反自然，","帝一同玄飨。","（以上见同书卷三）。"],"stanzas":[["解散七玄祖，","更法无中影。"],["七化反自然，","帝一同玄飨。"],["（以上见同书卷三）。"]]}
{"id":"a69cb0824f","title":"道藏歌诗 五十三","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飞轮蔼太宗，","无形亦无迹。","纵路任飞轮，","萧萧起界外。"],"stanzas":[["飞轮蔼太宗，","无形亦无迹。"],["纵路任飞轮，","萧萧起界外。"]]}
{"id":"b80b5e3023","title":"道藏歌诗 五十四","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清明重霄上，","合期庆云际。","玉条流逸响，","从容灵妙话。","。"],"stanzas":[["清明重霄上，","合期庆云际。"],["玉条流逸响，","从容灵妙话。"],["。"]]}
{"id":"5fd792e7bf","title":"道藏歌诗 五十五","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夕游蓬莱岛，","期对华景宴。","神仙结丹藻，","流晖寄文翰。"],"stanzas":[["夕游蓬莱岛，","期对华景宴。"],["神仙结丹藻，","流晖寄文翰。"]]}
{"id":"6051df3f0c","title":"道藏歌诗 五十六","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风云隐宛微，","讲论五岳匠。","砗磲精流璃，","琥珀金刚镜。"],"stanzas":[["风云隐宛微，","讲论五岳匠。"],["砗磲精流璃，","琥珀金刚镜。"]]}
{"id":"2ebbf3a71a","title":"道藏歌诗 五十七","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绛衣表群会，","生始似久梦。","德隐冲内迹，","至寂不觉当。","（当，","去声。","）（以上见同书卷四）。"],"stanzas":[["绛衣表群会，","生始似久梦。"],["德隐冲内迹，","至寂不觉当。"],["（当，","去声。"],["）（以上见同书卷四）。"]]}
{"id":"9f7295f4fd","title":"道藏元君诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["彼云泛灵舆，","倏忽适下土。","崆峒灭玄云，","至感不容冶。","（同前卷三）。"],"stanzas":[["彼云泛灵舆，","倏忽适下土。"],["崆峒灭玄云，","至感不容冶。"],["（同前卷三）。"]]}
{"id":"220327cc7e","title":"道藏元始歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黄庭戊己无流源，","彻通五藏十二纶。","（见同书卷二）。"],"stanzas":[["黄庭戊己无流源，","彻通五藏十二纶。"],["（见同书卷二）。"]]}
{"id":"7729c973d3","title":"道藏左夫人歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["腾跃云景辕，","浮观霞上空。","霄軿纵横舞，","紫盖记灵方。"],"stanzas":[["腾跃云景辕，","浮观霞上空。"],["霄軿纵横舞，","紫盖记灵方。"]]}
{"id":"1fb59ee8e0","title":"道藏中岳仙人歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["徘徊玄岳巓，","翻焉御飞龙。","齐腾八纮外，","翺翔阊阖房。","（见同书卷一。","以上所录《韵补》中诗，","均以中华书局影宋本为底本，","校以《连筠簃丛书》本、影印文渊阁《四库全书》本）（〖1〗《韵补》卷首书目释《道藏》歌诗云：","「当是魏晋时人所作。","其文词非儒家所急，","取其韵古也。","多阳声，","与《黄庭》同。","」今人逯钦立《先秦汉魏晋南北朝诗后记》云：","「《韵补》引用的《道藏》歌诗，","其中就有唐孟郊作的《列仙文·方诸青童歌》，","……为此，","《韵补》所用道歌，","本书一概不取。","」今按：","以孟郊诗与吴棫所录对校，","二十字中有八字不同，","故前仍录出。","据逯先生所云，","《韵补》诸诗虽不能断定为魏）（晋间人作，","但为宋以前人作，","殆无疑义。","宋代道家著作中常见的「坎离交媾、婴儿姹女、道家修养之术」〖《四库全书总目》卷一四七《金丹诗诀》提要语〗，","诸诗中皆未见，","即为一证。","今收入先宋诗。","）。"],"stanzas":[["徘徊玄岳巓，","翻焉御飞龙。"],["齐腾八纮外，","翺翔阊阖房。"],["（见同书卷一。"],["以上所录《韵补》中诗，","均以中华书局影宋本为底本，","校以《连筠簃丛书》本、影印文渊阁《四库全书》本）（〖1〗《韵补》卷首书目释《道藏》歌诗云：","「当是魏晋时人所作。"],["其文词非儒家所急，","取其韵古也。"],["多阳声，","与《黄庭》同。"],["」今人逯钦立《先秦汉魏晋南北朝诗后记》云：","「《韵补》引用的《道藏》歌诗，","其中就有唐孟郊作的《列仙文·方诸青童歌》，","……为此，","《韵补》所用道歌，","本书一概不取。"],["」今按：","以孟郊诗与吴棫所录对校，","二十字中有八字不同，","故前仍录出。"],["据逯先生所云，","《韵补》诸诗虽不能断定为魏）（晋间人作，","但为宋以前人作，","殆无疑义。"],["宋代道家著作中常见的「坎离交媾、婴儿姹女、道家修养之术」〖《四库全书总目》卷一四七《金丹诗诀》提要语〗，","诸诗中皆未见，","即为一证。"],["今收入先宋诗。"],["）。"]]}
{"id":"df6d94e791","title":"叠韵诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["看河水漠沥，","望野草苍黄。","露停君子树，","霜宿女姓姜。"],"stanzas":[["看河水漠沥，","望野草苍黄。"],["露停君子树，","霜宿女姓姜。"]]}
{"id":"ac311712ad","title":"叠连韵诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["羁客意盘桓，","流泪下阑干。","虽对琴觞乐，","烦情仍未欢。"],"stanzas":[["羁客意盘桓，","流泪下阑干。"],["虽对琴觞乐，","烦情仍未欢。"]]}
{"id":"c35ae1c576","title":"掷韵诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不知羞，","不敢留。","但好去，","莫相虑。","孤客惊，","百愁生。","饭蔬簟食乐道，","忘饥陋巷不疲。"],"stanzas":[["不知羞，","不敢留。"],["但好去，","莫相虑。"],["孤客惊，","百愁生。"],["饭蔬簟食乐道，","忘饥陋巷不疲。"]]}
{"id":"d989f3031d","title":"掷韵诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不知羞，","不肯留。","集丽城，","夜啼声。","出长安，","过上兰。","指杨都，","越江湖。","念邯郸，","忘朝飡。","但好去，","莫相虑。"],"stanzas":[["不知羞，","不肯留。"],["集丽城，","夜啼声。"],["出长安，","过上兰。"],["指杨都，","越江湖。"],["念邯郸，","忘朝飡。"],["但好去，","莫相虑。"]]}
{"id":"f4b37d08bc","title":"重字韵诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["望野草青青，","临河水活活。","斜峰缆舟行，","曲浦浮积沫。"],"stanzas":[["望野草青青，","临河水活活。"],["斜峰缆舟行，","曲浦浮积沫。"]]}
{"id":"43747525ff","title":"同音韵诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今朝是何夕，","良人谁观觌。","中心实怜爱，","夜寐不安席。","（以上六首均见《文镜秘府论校注》天卷《八种韵》）（按：","《八种韵》节凡引诗九首，","除梁萧绎、唐王昌龄、李白各一首外，","余六首作者不详。","王利器《文镜秘府论校注》引任学良《文镜秘府论校注》稿本云：","「本节曾引王昌龄李白诗，","疑系元兢《脑髓》之文，","皎然《诗议》不致有此种琐屑声）（韵之论也。","」然兢为高宗时人，","安得引及李、王之诗。","其说未谛。","诸诗为六朝至盛唐间作品，","殆无可疑。","）。"],"stanzas":[["今朝是何夕，","良人谁观觌。"],["中心实怜爱，","夜寐不安席。"],["（以上六首均见《文镜秘府论校注》天卷《八种韵》）（按：","《八种韵》节凡引诗九首，","除梁萧绎、唐王昌龄、李白各一首外，","余六首作者不详。"],["王利器《文镜秘府论校注》引任学良《文镜秘府论校注》稿本云：","「本节曾引王昌龄李白诗，","疑系元兢《脑髓》之文，","皎然《诗议》不致有此种琐屑声）（韵之论也。"],["」然兢为高宗时人，","安得引及李、王之诗。"],["其说未谛。"],["诸诗为六朝至盛唐间作品，","殆无可疑。"],["）。"]]}
