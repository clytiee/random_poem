{"id":"24b95e4a3a","title":"援寡阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["女萝本细草，","抽茎信不功。","凭高出岭上，","假树入云中。"],"stanzas":[["女萝本细草，","抽茎信不功。"],["凭高出岭上，","假树入云中。"]]}
{"id":"d8f71b4512","title":"援寡阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["愁临玉台镜，","泪垂金缕裙。"],"stanzas":[["愁临玉台镜，","泪垂金缕裙。"]]}
{"id":"a59edd346b","title":"和诗阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["花桃微散红，","萠兰稍开紫。","客子情已多，","春望复如此。"],"stanzas":[["花桃微散红，","萠兰稍开紫。"],["客子情已多，","春望复如此。"]]}
{"id":"f052abf2ab","title":"和诗阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["风光摇陇麦，","日华映林蘂。","春情重以伤，","归念（一作命）何由弭？","（均见《文镜秘府论》地卷《八阶》录佚名《文笔式》）（〖1〗今人逯钦立《先秦汉魏晋南北朝诗后记》云：","「又如《文镜秘府》也曾征引许多诗篇，","但这些诗篇率不著作者，","其中有一部分又可能是初唐之作，","因此，","这里也不加辑录。","」按：","逯说甚是。","今参照王利器先生《文镜秘府论校注》的考订，","将《文镜秘府论》中不见于《先秦汉魏晋南北朝诗》及《全唐诗》的作品，","皆录入先宋诗，","以便研究者检用。","）。"],"stanzas":[["风光摇陇麦，","日华映林蘂。"],["春情重以伤，","归念（一作命）何由弭？"],["（均见《文镜秘府论》地卷《八阶》录佚名《文笔式》）（〖1〗今人逯钦立《先秦汉魏晋南北朝诗后记》云：","「又如《文镜秘府》也曾征引许多诗篇，","但这些诗篇率不著作者，","其中有一部分又可能是初唐之作，","因此，","这里也不加辑录。"],["」按：","逯说甚是。"],["今参照王利器先生《文镜秘府论校注》的考订，","将《文镜秘府论》中不见于《先秦汉魏晋南北朝诗》及《全唐诗》的作品，","皆录入先宋诗，","以便研究者检用。"],["）。"]]}
{"id":"e9ac836e35","title":"北方歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北方玄武身本黑，","家乡体住昆仑国。","寻常定志有长生，","方圆任性可生得。","随流信运长为客，","谁识我身性无白。","不独含著五行精，","就中偏感阴阳魄。","调和兑震为夫妇，","四象排来在高处。","分明指似后人言，","莫使昏迷错天路。"],"stanzas":[["北方玄武身本黑，","家乡体住昆仑国。"],["寻常定志有长生，","方圆任性可生得。"],["随流信运长为客，","谁识我身性无白。"],["不独含著五行精，","就中偏感阴阳魄。"],["调和兑震为夫妇，","四象排来在高处。"],["分明指似后人言，","莫使昏迷错天路。"]]}
{"id":"b840b3da4f","title":"西方歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西方白虎本属阴，","为男为女亦为金。","长立子宫胎产午，","成形兑体坎同心。","娇姿玉貌欺冰雪，","素质含光洒轻血。","则知唤作白琅玕，","怎识我身是明月。","无媒自嫁得黄芽，","生死在归戊己家。","炎烈下时寒国上，","阴阳催强緫成砂。","若人会得吾此语，","目前便是三清路。","驾鹤冲天日有菁定知永劫抛尘土。"],"stanzas":[["西方白虎本属阴，","为男为女亦为金。"],["长立子宫胎产午，","成形兑体坎同心。"],["娇姿玉貌欺冰雪，","素质含光洒轻血。"],["则知唤作白琅玕，","怎识我身是明月。"],["无媒自嫁得黄芽，","生死在归戊己家。"],["炎烈下时寒国上，","阴阳催强緫成砂。"],["若人会得吾此语，","目前便是三清路。"],["驾鹤冲天日有菁定知永劫抛尘土。"]]}
{"id":"88270c3421","title":"南方歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["南方朱雀其身赤，","猛烈雄强势难敌。","性共乾坤造化齐，","体并阴阳难消息。","水妻土母木家子，","白帝金形胎受此。","四象皆因我气生，","万类须由我气死。","性连甲乙气偏通，","媾扇金娘嫁木翁。","归投戊己到中宫，","看看变转緫交红。","此謌不悟慇懃说，","句句从头细分雪。","莫言积学但阴功，","始解消详吾志诀。"],"stanzas":[["南方朱雀其身赤，","猛烈雄强势难敌。"],["性共乾坤造化齐，","体并阴阳难消息。"],["水妻土母木家子，","白帝金形胎受此。"],["四象皆因我气生，","万类须由我气死。"],["性连甲乙气偏通，","媾扇金娘嫁木翁。"],["归投戊己到中宫，","看看变转緫交红。"],["此謌不悟慇懃说，","句句从头细分雪。"],["莫言积学但阴功，","始解消详吾志诀。"]]}
{"id":"a3a12d4d6e","title":"东方歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东方有木本名砂，","为男为女亦为芽。","受气午成须立子，","含精育质长金家。","自从成长多年月，","朝朝各自向天涯。","莫欺形貌黑皴皵，","浑身緫是日精华。","忽若遇著阴家子，","不假良媒自相许。","迎归宝帐到中宫，","阴阳气合情意与。","特地为胎重造化，","运动坎离巡八卦。","十月怀胎母子分，","定知霄汉骖鸾驾。"],"stanzas":[["东方有木本名砂，","为男为女亦为芽。"],["受气午成须立子，","含精育质长金家。"],["自从成长多年月，","朝朝各自向天涯。"],["莫欺形貌黑皴皵，","浑身緫是日精华。"],["忽若遇著阴家子，","不假良媒自相许。"],["迎归宝帐到中宫，","阴阳气合情意与。"],["特地为胎重造化，","运动坎离巡八卦。"],["十月怀胎母子分，","定知霄汉骖鸾驾。"]]}
{"id":"f67565b039","title":"中方歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["中央戊己属句陈，","体合虚无与道隣。","纯抱元和精粹气，","陶身万炼緫成真。","木妻火子水家鬼，","水土相镇不能起。","还教却产西方金，","递代相承壮精髓。","虽然我身无正形，","志事隈凭四象生。","四象不因连我气，","水金木火岂能成？","徧通金木恩情熟，","留向胎中亲养育。","丽物相和气緫并，","须凭丙火来煎蹙。","丙火元来是我命，","节候轮排依法令。"],"stanzas":[["中央戊己属句陈，","体合虚无与道隣。"],["纯抱元和精粹气，","陶身万炼緫成真。"],["木妻火子水家鬼，","水土相镇不能起。"],["还教却产西方金，","递代相承壮精髓。"],["虽然我身无正形，","志事隈凭四象生。"],["四象不因连我气，","水金木火岂能成？"],["徧通金木恩情熟，","留向胎中亲养育。"],["丽物相和气緫并，","须凭丙火来煎蹙。"],["丙火元来是我命，","节候轮排依法令。"]]}
{"id":"fb9afb5f96","title":"二气产黄芽歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乾坤感应始为形，","造化元因北户成。","日月周旋魂魄合，","阴阳交媾结为精。","分明一气从金长，","认取黄芽自水生。","无限虚于尘世里，","时人日用不知名。"],"stanzas":[["乾坤感应始为形，","造化元因北户成。"],["日月周旋魂魄合，","阴阳交媾结为精。"],["分明一气从金长，","认取黄芽自水生。"],["无限虚于尘世里，","时人日用不知名。"]]}
{"id":"e4c26411cf","title":"广成子口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["世上忙忙没了程，","百年如梦瞥然荣。","不知道有云衢客，","刚自争超尘里名。","若欲留年从太一，","须吞灵药便长生。","纯烧无地阴阳髓，","炼取乾坤日月精。"],"stanzas":[["世上忙忙没了程，","百年如梦瞥然荣。"],["不知道有云衢客，","刚自争超尘里名。"],["若欲留年从太一，","须吞灵药便长生。"],["纯烧无地阴阳髓，","炼取乾坤日月精。"]]}
{"id":"c780481fac","title":"广成子传附二味","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["要伏离宫亦等闲，","搜求坎户取精研。","但比夫妇成交感，","孕出黄芽见本源。","若不亲传师指受，","此外徒劳虚费钱。","火候仍修终九九，","丹成直待是三年。","（按：","广成子为古神仙，","事见《庄子·在宥》。","）。"],"stanzas":[["要伏离宫亦等闲，","搜求坎户取精研。"],["但比夫妇成交感，","孕出黄芽见本源。"],["若不亲传师指受，","此外徒劳虚费钱。"],["火候仍修终九九，","丹成直待是三年。"],["（按：","广成子为古神仙，","事见《庄子·在宥》。"],["）。"]]}
{"id":"5f38e42139","title":"抱朴子口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朱砂水银入华池，","收得黄芽人不知。","本是仙人留口诀，","世上喧喧乱言说。","七十年中付一人，","分付还须有仙骨。","一一事须手眼传，","采取只在片时间。","河专覆在丹田里，","制伏只在黄芽边。","（按：","抱朴子即晋葛洪。","）。"],"stanzas":[["朱砂水银入华池，","收得黄芽人不知。"],["本是仙人留口诀，","世上喧喧乱言说。"],["七十年中付一人，","分付还须有仙骨。"],["一一事须手眼传，","采取只在片时间。"],["河专覆在丹田里，","制伏只在黄芽边。"],["（按：","抱朴子即晋葛洪。"],["）。"]]}
{"id":"48798db81a","title":"张华真人铅汞歌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赤龙化为粉，","白虎利如霜。","其中投石液，","还要帝流浆。","调神清五脏，","欲得炼三光。","专守坚冰性，","如何阴使阳？","。"],"stanzas":[["赤龙化为粉，","白虎利如霜。"],["其中投石液，","还要帝流浆。"],["调神清五脏，","欲得炼三光。"],["专守坚冰性，","如何阴使阳？","。"]]}
{"id":"1af83e4500","title":"张华真人二味口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虎伏龙亦藏，","龙潜先伏虎。","但毕河车功，","不用隄防虑。","黄老学飞仙，","狂迷不得路。","回首指牝鸡，","不测阴阳数。","却坐太一宫，","参商方始遇。","左右得近神，","四相皆扶护。","乾坤法象成，","自有仙人顾。","（按：","张华为西晋时人。","）。"],"stanzas":[["虎伏龙亦藏，","龙潜先伏虎。"],["但毕河车功，","不用隄防虑。"],["黄老学飞仙，","狂迷不得路。"],["回首指牝鸡，","不测阴阳数。"],["却坐太一宫，","参商方始遇。"],["左右得近神，","四相皆扶护。"],["乾坤法象成，","自有仙人顾。"],["（按：","张华为西晋时人。"],["）。"]]}
{"id":"224cca08fe","title":"尹喜真人口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["至药须用铅，","杯向黑中聚。","若欲识黄芽，","先应问阴土。","真铅配坎男，","戊己来相顾。","只此号黄矾，","便是还丹祖。","（按：","尹喜即关尹喜，","传为老子同时人。","）。"],"stanzas":[["至药须用铅，","杯向黑中聚。"],["若欲识黄芽，","先应问阴土。"],["真铅配坎男，","戊己来相顾。"],["只此号黄矾，","便是还丹祖。"],["（按：","尹喜即关尹喜，","传为老子同时人。"],["）。"]]}
{"id":"46cf542b05","title":"函谷关元君铅汞謌","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["红铅黑铅大丹头，","红铅黑铅体同金。","黑金取精赤取髓，","解用赤黑药无比。","用赤入黑保长生，","用黑入赤天仙矣。","颠倒两法緫称铅，","黑能变化赤天仙。","至道之人莫容易，","贪财好色不须传。","函谷关头梁石山，","老君镌石留此言。"],"stanzas":[["红铅黑铅大丹头，","红铅黑铅体同金。"],["黑金取精赤取髓，","解用赤黑药无比。"],["用赤入黑保长生，","用黑入赤天仙矣。"],["颠倒两法緫称铅，","黑能变化赤天仙。"],["至道之人莫容易，","贪财好色不须传。"],["函谷关头梁石山，","老君镌石留此言。"]]}
{"id":"7f9ddd6e41","title":"汉祖天师口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["铅抽髓，","髓抽精，","精髓相合丹必成。","一斤水银十七两，","一两变化是铅精。","将此铅精作大丹，","老子九转入生研。","一丽水银特牛力，","服之令人貌若仙，","貌若仙兮筋骨坚。","筋骨坚强返枯槁，","截舌人间不须道。","未能隐显出没藏，","切慎惧口莫颠狂。","若教上界天神怒，","恐遭非横及刀光。","。"],"stanzas":[["铅抽髓，","髓抽精，","精髓相合丹必成。"],["一斤水银十七两，","一两变化是铅精。"],["将此铅精作大丹，","老子九转入生研。"],["一丽水银特牛力，","服之令人貌若仙，","貌若仙兮筋骨坚。"],["筋骨坚强返枯槁，","截舌人间不须道。"],["未能隐显出没藏，","切慎惧口莫颠狂。"],["若教上界天神怒，","恐遭非横及刀光。"],["。"]]}
{"id":"4cc3991f78","title":"严君平口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["铅是铅，","汞是汞，","只这两般是铅汞。","龙是龙，","虎是虎，","只这两个同宗祖。","若能识此坎离宫，","离宫之下出黄土。","黄土出黄芽，","黄芽之下金花成。","金花成，","金花之下结紫精。","紫精成，","紫精之下出白金。","白金沉，","黄金浮，","世人采沉作丹头，","搜取赤髓相和种。","种有时，","采有日，","换筋骨，","添寿历，","天仙地仙不思议。","点铅铁，","兼瓦砾，","一二三四五，","水火木金土。","但知明此诀，","便是长生路。"],"stanzas":[["铅是铅，","汞是汞，","只这两般是铅汞。"],["龙是龙，","虎是虎，","只这两个同宗祖。"],["若能识此坎离宫，","离宫之下出黄土。"],["黄土出黄芽，","黄芽之下金花成。"],["金花成，","金花之下结紫精。"],["紫精成，","紫精之下出白金。"],["白金沉，","黄金浮，","世人采沉作丹头，","搜取赤髓相和种。"],["种有时，","采有日，","换筋骨，","添寿历，","天仙地仙不思议。"],["点铅铁，","兼瓦砾，","一二三四五，","水火木金土。"],["但知明此诀，","便是长生路。"]]}
{"id":"db03972e3b","title":"阴长生口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["金作骨兮铅作身，","阴阳定配龙虎亲。","红颜二八三才合，","八卦分张斗建寅。","从子午，","不须移，","七十二候莫参差。","姹女因媒归太一，","紫微宫内生雄雌。","铅中宝，","砂中珍，","此物含弘象五神。","七月怀胎分六甲，","终岁人转乃成真。","淮南法，","炼秋石，","黄帝金花烧琥珀。","白酒杯添九酝香，","晶辉甘甜号龙液。","一人有，","一人无，","三姓同家二子俱。","狐兔非群不乳马，","异类天然种性殊。","冥复冥，","玄复玄，","此法非人不可传。","世人不知世上药，","知我还命不由天。","（按：","严君平、阴长生皆汉时人。","）。"],"stanzas":[["金作骨兮铅作身，","阴阳定配龙虎亲。"],["红颜二八三才合，","八卦分张斗建寅。"],["从子午，","不须移，","七十二候莫参差。"],["姹女因媒归太一，","紫微宫内生雄雌。"],["铅中宝，","砂中珍，","此物含弘象五神。"],["七月怀胎分六甲，","终岁人转乃成真。"],["淮南法，","炼秋石，","黄帝金花烧琥珀。"],["白酒杯添九酝香，","晶辉甘甜号龙液。"],["一人有，","一人无，","三姓同家二子俱。"],["狐兔非群不乳马，","异类天然种性殊。"],["冥复冥，","玄复玄，","此法非人不可传。"],["世人不知世上药，","知我还命不由天。"],["（按：","严君平、阴长生皆汉时人。"],["）。"]]}
{"id":"63ec495d11","title":"果州谢自然口诀","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["白女正当年十六，","自夸弱质颜如玉。","常嗟岁月无良媒，","昼夜孤单唯独宿。","爷娘不审他心意，","谩说张三并李四。","几度为话緫不成，","教人羞天复愧地。","忽遇黄婆来扣门，","说道金公体性温，","遂将二命问君平。","君平断言此好婚，","不偏不曲合乾坤。","审此因缘甚宜良，","至今子孙满帝乡。","昔时不因黄婆力，","如何得契合阴阳。","（以上皆见《正统道藏》本《大还丹照鉴》）（按：","《大还丹照鉴》编者不详，","卷首有后蜀广政二十五年序，","称「偶因闲暇，","采摭仙经，","重删先圣格言，","留为后人轨范，","名曰《照鉴登仙集》，","总成一卷，","分作三十三篇」。","《通志·艺文略》著录作《大还丹照鉴登仙集》一卷。","知今本书名未完。","此书所收诗以唐的之作为多。","上录自《北方歌》以下六篇不题撰人，","自《广成子口诀》以下十篇皆题古圣前哲之名，","应皆为唐人或唐以前人所依托。","谢自然，","为唐德宗贞元时人，","事详《太平广记》卷六六引《集仙录》。","然此诗显为时人咏其事之作。","与前列诸诗不同，","姑录存于此。","）。"],"stanzas":[["白女正当年十六，","自夸弱质颜如玉。"],["常嗟岁月无良媒，","昼夜孤单唯独宿。"],["爷娘不审他心意，","谩说张三并李四。"],["几度为话緫不成，","教人羞天复愧地。"],["忽遇黄婆来扣门，","说道金公体性温，","遂将二命问君平。"],["君平断言此好婚，","不偏不曲合乾坤。"],["审此因缘甚宜良，","至今子孙满帝乡。"],["昔时不因黄婆力，","如何得契合阴阳。"],["（以上皆见《正统道藏》本《大还丹照鉴》）（按：","《大还丹照鉴》编者不详，","卷首有后蜀广政二十五年序，","称「偶因闲暇，","采摭仙经，","重删先圣格言，","留为后人轨范，","名曰《照鉴登仙集》，","总成一卷，","分作三十三篇」。"],["《通志·艺文略》著录作《大还丹照鉴登仙集》一卷。"],["知今本书名未完。"],["此书所收诗以唐的之作为多。"],["上录自《北方歌》以下六篇不题撰人，","自《广成子口诀》以下十篇皆题古圣前哲之名，","应皆为唐人或唐以前人所依托。"],["谢自然，","为唐德宗贞元时人，","事详《太平广记》卷六六引《集仙录》。"],["然此诗显为时人咏其事之作。"],["与前列诸诗不同，","姑录存于此。"],["）。"]]}
{"id":"d6796a924a","title":"太微天帝君赞大有妙经颂一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹晖映云庭，","紫烟光玉林。","焕烂七宝花，","璀璨瑶灵音。","宫商自相和，","妙灵开人衿。","玄唱种福田，","广度无界心。"],"stanzas":[["丹晖映云庭，","紫烟光玉林。"],["焕烂七宝花，","璀璨瑶灵音。"],["宫商自相和，","妙灵开人衿。"],["玄唱种福田，","广度无界心。"]]}
{"id":"fa2b0aef02","title":"天帝君赞大有妙经颂一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["玄化本无迹，","有迹生道宗。","遨游九天际，","息驾六领宫，","道畅虚漠内，","灵歌发太空。","形感至寂庭，","思咏希微通。"],"stanzas":[["玄化本无迹，","有迹生道宗。"],["遨游九天际，","息驾六领宫，","道畅虚漠内，","灵歌发太空。"],["形感至寂庭，","思咏希微通。"]]}
{"id":"7bed0912b8","title":"太帝君赞大有妙经颂一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["翳翳元化初，","眇眇晨霞散。","太寂空玄上，","寥朗二仪判。","凝精抱空胎，","结化孕灵观。","含真颐神内，","倏歘启㝠旦。","始悟忧促龄，","运交反天汉。"],"stanzas":[["翳翳元化初，","眇眇晨霞散。"],["太寂空玄上，","寥朗二仪判。"],["凝精抱空胎，","结化孕灵观。"],["含真颐神内，","倏歘启㝠旦。"],["始悟忧促龄，","运交反天汉。"]]}
{"id":"70051f8c22","title":"老君本生经颂一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["众生之本际，","寂然无起灭。","弱丧迷其根，","自与真源别。","妄作善恶缘，","祸福报无绝。","欲得苦海倾，","当使爱河竭。","守一固专柔，","持此无疵缺。","正智通群有，","妙慧摧诸结。","万行混同归，","三乘泯殊辙。","真静离尘垢，","清凉无恼热。"],"stanzas":[["众生之本际，","寂然无起灭。"],["弱丧迷其根，","自与真源别。"],["妄作善恶缘，","祸福报无绝。"],["欲得苦海倾，","当使爱河竭。"],["守一固专柔，","持此无疵缺。"],["正智通群有，","妙慧摧诸结。"],["万行混同归，","三乘泯殊辙。"],["真静离尘垢，","清凉无恼热。"]]}
{"id":"b54353ab6a","title":"太上智慧佪玄经颂一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灵仙乘庆霄，","驾龙蹑玄波。","洽真表嘉祥，","濯足八天河。","福应不我期，","故能释天罗。","道德冠三界，","地网亦以过。","感遇灵真会，","净慧经莲华。"],"stanzas":[["灵仙乘庆霄，","驾龙蹑玄波。"],["洽真表嘉祥，","濯足八天河。"],["福应不我期，","故能释天罗。"],["道德冠三界，","地网亦以过。"],["感遇灵真会，","净慧经莲华。"]]}
{"id":"4c9fe7742e","title":"太上智慧经赞一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["学仙绝华念，","念念相因积。","去来乱我神，","神躁靡不历。","灭念停虚闲，","萧萧入空寂。","请经若饥渴，","持志如金石。","保子飞玄路，","五灵度符籍。"],"stanzas":[["学仙绝华念，","念念相因积。"],["去来乱我神，","神躁靡不历。"],["灭念停虚闲，","萧萧入空寂。"],["请经若饥渴，","持志如金石。"],["保子飞玄路，","五灵度符籍。"]]}
{"id":"78d352bacf","title":"本愿大戒经颂一章","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["学自行为急，","奉戒制情心。","虚夷正气居，","仙圣自相寻。"],"stanzas":[["学自行为急，","奉戒制情心。"],["虚夷正气居，","仙圣自相寻。"]]}
{"id":"f046020043","title":"玉皇授歘生大洞三十九章与登龙台歌二章 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["飚飚三霞领，","佪刚七元盖。","八景入太元，","飞洒九天外。","琼扉生景云，","灵烟绝幽蔼。","西宫咏洞玄，","清唱扶桑际。","守雌森峰间，","玄吟五老会。","歘生有心哉，","与尔结中带。"],"stanzas":[["飚飚三霞领，","佪刚七元盖。"],["八景入太元，","飞洒九天外。"],["琼扉生景云，","灵烟绝幽蔼。"],["西宫咏洞玄，","清唱扶桑际。"],["守雌森峰间，","玄吟五老会。"],["歘生有心哉，","与尔结中带。"]]}
{"id":"39b44c1e4b","title":"玉皇授歘生大洞三十九章与登龙台歌二章 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["匏河振沧茫，","天津鼓万流。","八风驾神霄，","缅缅虚中游。","咏洞神明唱，","音为汝玄投。","歘生必至行，","肘伏尘中趋。","可为苦心哉，","当告尔所求。","。"],"stanzas":[["匏河振沧茫，","天津鼓万流。"],["八风驾神霄，","缅缅虚中游。"],["咏洞神明唱，","音为汝玄投。"],["歘生必至行，","肘伏尘中趋。"],["可为苦心哉，","当告尔所求。"],["。"]]}
{"id":"49de1cb8ab","title":"西王母授紫度炎光神变经颂三篇 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["啸歌九玄台，","崖岭凝凄端。","心理六觉畅，","目弃尘滓氛。","流霞耀金室，","虚堂散重玄。","积感致灵降，","形单道亦分。","倏歘盼万劫，","岂觉周亿椿。"],"stanzas":[["啸歌九玄台，","崖岭凝凄端。"],["心理六觉畅，","目弃尘滓氛。"],["流霞耀金室，","虚堂散重玄。"],["积感致灵降，","形单道亦分。"],["倏歘盼万劫，","岂觉周亿椿。"]]}
{"id":"e9203be9ff","title":"西王母授紫度炎光神变经颂三篇 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秀圃蔚神阶，","朱扉琼林庭。","流风鼓空洞，","玉籁乘虚鸣。","紫烟缠曲户，","丹晖映绿軿。","飞旗欝玄盖，","羽节耀紫清。","登景九霄际，","遨游戏凤城。","顾爱幽境子，","一乐同朝生。"],"stanzas":[["秀圃蔚神阶，","朱扉琼林庭。"],["流风鼓空洞，","玉籁乘虚鸣。"],["紫烟缠曲户，","丹晖映绿軿。"],["飞旗欝玄盖，","羽节耀紫清。"],["登景九霄际，","遨游戏凤城。"],["顾爱幽境子，","一乐同朝生。"]]}
{"id":"9630edfae3","title":"西王母授紫度炎光神变经颂三篇 三","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["腾辔控朗晖，","宴景洞野外。","流浪寻灵人，","合形庆霄际。","手披朱岛户，","朗若神冲泰。","金阙欝嵯峨，","清景无尘秽，","解衿玄阆台，","适我良愿会。","脱屣三涂难，","保炼固年迈。"],"stanzas":[["腾辔控朗晖，","宴景洞野外。"],["流浪寻灵人，","合形庆霄际。"],["手披朱岛户，","朗若神冲泰。"],["金阙欝嵯峨，","清景无尘秽，","解衿玄阆台，","适我良愿会。"],["脱屣三涂难，","保炼固年迈。"]]}
