{"id":"33fe93a310","title":"回文对诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["情亲由得意，","得意遂情亲。","新情终会故，","会故亦经新。","（自《的名对诗》以下十题均出《文镜秘府论》东卷《二十九种对》）。"],"stanzas":[["情亲由得意，","得意遂情亲。"],["新情终会故，","会故亦经新。"],["（自《的名对诗》以下十题均出《文镜秘府论》东卷《二十九种对》）。"]]}
{"id":"191c60e394","title":"诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["净宫邻博望，","香刹对承华。","（见《文镜秘府论》地卷《十四例》引皎公《诗议》引）。"],"stanzas":[["净宫邻博望，","香刹对承华。"],["（见《文镜秘府论》地卷《十四例》引皎公《诗议》引）。"]]}
{"id":"c809a449e1","title":"双虚实对诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["故人云雨散，","空山来往疏。"],"stanzas":[["故人云雨散，","空山来往疏。"]]}
{"id":"04e7e378d9","title":"假对诗","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不献胸中策，","空归海上山。","（同前书东卷引皎然《诗议》）。"],"stanzas":[["不献胸中策，","空归海上山。"],["（同前书东卷引皎然《诗议》）。"]]}
{"id":"3fdf22bdb3","title":"咏物阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["双眉学新绿，","二脸例轻红。","言模（一作摸）出浪鸟，","字写入花虫。"],"stanzas":[["双眉学新绿，","二脸例轻红。"],["言模（一作摸）出浪鸟，","字写入花虫。"]]}
{"id":"dcbcdc328d","title":"咏物阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["洒尘成细迹，","点水作圆文。","白银花里散，","明珠叶上分。","。"],"stanzas":[["洒尘成细迹，","点水作圆文。"],["白银花里散，","明珠叶上分。"],["。"]]}
{"id":"0e13dde22e","title":"赠物阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心贞如玉性，","志洁若金为。","托曾同心叶，","因附合欢枝。"],"stanzas":[["心贞如玉性，","志洁若金为。"],["托曾同心叶，","因附合欢枝。"]]}
{"id":"43d493e83c","title":"赠物阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["合瞑刺缝罢，","守啼方达曙。","带长垂两巾，","代人交手处。"],"stanzas":[["合瞑刺缝罢，","守啼方达曙。"],["带长垂两巾，","代人交手处。"]]}
{"id":"86ca1b340d","title":"述志阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有鸟异孤鸾，","飞无群独漾。","鹤戏逐轻风，","起响（一作「聊起」）三台上。"],"stanzas":[["有鸟异孤鸾，","飞无群独漾。"],["鹤戏逐轻风，","起响（一作「聊起」）三台上。"]]}
{"id":"1cddab1120","title":"述志阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丈夫怀慷慨，","胆（一作瞻）上涌波奔。","只将三尺剑，","决搆一朱门。"],"stanzas":[["丈夫怀慷慨，","胆（一作瞻）上涌波奔。"],["只将三尺剑，","决搆一朱门。"]]}
{"id":"ee9010300d","title":"写心阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["命礼遣舟车，","伫望谈言志。","若值信来符（一作府），","共子同琴瑟。"],"stanzas":[["命礼遣舟车，","伫望谈言志。"],["若值信来符（一作府），","共子同琴瑟。"]]}
{"id":"bfa5c7b9a7","title":"写心阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["插花花未歇，","薰衣衣已香。","望望遥心断，","凄凄愁切肠。"],"stanzas":[["插花花未歇，","薰衣衣已香。"],["望望遥心断，","凄凄愁切肠。"]]}
{"id":"02ee654d2c","title":"近酬阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盛夏盛炎光（一作光炎），","焦天焦气烈。"],"stanzas":[["盛夏盛炎光（一作光炎），","焦天焦气烈。"]]}
{"id":"b85aaa48ca","title":"近酬阶诗 二","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["清阶清溜泻，","凉户凉风入。"],"stanzas":[["清阶清溜泻，","凉户凉风入。"]]}
{"id":"2d331938fd","title":"赞毁阶诗 一","author":"无名氏","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["施朱桃恶彩，","点黛柳惭色。"],"stanzas":[["施朱桃恶彩，","点黛柳惭色。"]]}
