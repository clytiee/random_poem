{"id":"d09a46bdf4","title":"唐虞门 虞舜","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["进善惩奸立帝功，","功成揖让益温恭。","满朝卿士多元凯，","为黜兜苗与四凶。"],"stanzas":[["进善惩奸立帝功，","功成揖让益温恭。"],["满朝卿士多元凯，","为黜兜苗与四凶。"]]}
{"id":"469dcdc775","title":"唐虞门 舜妃","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["苍梧一望隔重云，","帝子悲寻不记春。","何事泪痕偏在竹，","贞姿应念节高人。"],"stanzas":[["苍梧一望隔重云，","帝子悲寻不记春。"],["何事泪痕偏在竹，","贞姿应念节高人。"]]}
{"id":"3a1a31af04","title":"唐虞门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["潇湘何代泣幽魂，","骨化重泉志尚存。","若道地中休下泪，","不应新竹有啼痕。"],"stanzas":[["潇湘何代泣幽魂，","骨化重泉志尚存。"],["若道地中休下泪，","不应新竹有啼痕。"]]}
{"id":"5df15f5575","title":"三代门 夏禹","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["尧违天孽赖询谟，","顿免洪波浸碧虚。","海内生灵微伯禹，","尽应随浪化为鱼。"],"stanzas":[["尧违天孽赖询谟，","顿免洪波浸碧虚。"],["海内生灵微伯禹，","尽应随浪化为鱼。"]]}
{"id":"80dc1807ae","title":"三代门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万古龙门一旦开，","无成甘死作黄能。","司空定有匡尧术，","九载之前何处来。"],"stanzas":[["万古龙门一旦开，","无成甘死作黄能。"],["司空定有匡尧术，","九载之前何处来。"]]}
{"id":"f1137bf7f7","title":"三代门 太康","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["师保何人为琢磨，","安知父祖苦辛多。","酒酣禽色方为乐，","讵肯闲听五子歌。"],"stanzas":[["师保何人为琢磨，","安知父祖苦辛多。"],["酒酣禽色方为乐，","讵肯闲听五子歌。"]]}
{"id":"684f00c4f3","title":"三代门 后稷","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["人惟邦本本由农，","旷古谁高后稷功。","百谷且繁三曜在，","牲牢郊祀信无穷。"],"stanzas":[["人惟邦本本由农，","旷古谁高后稷功。"],["百谷且繁三曜在，","牲牢郊祀信无穷。"]]}
{"id":"7fa9e457ce","title":"三代门 文王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昭然明德报天休，","禴祭惟馨胜杀牛。","二老五侯何所诈，","不归商受尽归周。"],"stanzas":[["昭然明德报天休，","禴祭惟馨胜杀牛。"],["二老五侯何所诈，","不归商受尽归周。"]]}
{"id":"6f954c117a","title":"三代门 武王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文王寝膳武王随，","内竖言安色始怡。","七载岂堪囚羑里，","一夫为报亦何疑。"],"stanzas":[["文王寝膳武王随，","内竖言安色始怡。"],["七载岂堪囚羑里，","一夫为报亦何疑。"]]}
{"id":"0635f1d2ed","title":"三代门 太公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昌猎关西纣猎东，","纣怜崇虎弃非熊。","危邦自谓多麟凤，","肯把王纲取钓翁。"],"stanzas":[["昌猎关西纣猎东，","纣怜崇虎弃非熊。"],["危邦自谓多麟凤，","肯把王纲取钓翁。"]]}
{"id":"303a0f46ce","title":"三代门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["东邻不事事西邻，","御物卑和物自亲。","天下言知天下者，","兆人无主属贤人。"],"stanzas":[["东邻不事事西邻，","御物卑和物自亲。"],["天下言知天下者，","兆人无主属贤人。"]]}
{"id":"0277a8c078","title":"三代门 又吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["千妖万态逞妍姿，","破国亡家更是谁。","匡政必能除苟媚，","去邪当断勿狐疑。"],"stanzas":[["千妖万态逞妍姿，","破国亡家更是谁。"],["匡政必能除苟媚，","去邪当断勿狐疑。"]]}
{"id":"4287f145dd","title":"三代门 子牙妻","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陵柏无心竹变秋，","不能同戚拟同休。","岁寒焉在空垂涕，","覆水如何欲再收。"],"stanzas":[["陵柏无心竹变秋，","不能同戚拟同休。"],["岁寒焉在空垂涕，","覆水如何欲再收。"]]}
{"id":"0c959a3ed9","title":"三代门 周公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["文武传芳百代基，","几多贤哲守成规。","仍闻吐握延儒素，","犹恐民疵未尽知。"],"stanzas":[["文武传芳百代基，","几多贤哲守成规。"],["仍闻吐握延儒素，","犹恐民疵未尽知。"]]}
{"id":"9e635426c3","title":"三代门 夷齐","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["让国由衷义亦乖，","不知天命匹夫才。","将除暴虐诚能阻，","何异崎岖助纣来。"],"stanzas":[["让国由衷义亦乖，","不知天命匹夫才。"],["将除暴虐诚能阻，","何异崎岖助纣来。"]]}
{"id":"dad323d12b","title":"三代门 管蔡","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["伊商胡越尚同图，","管蔡如何有异谟。","不念祖宗危社稷，","强于仁圣遣行诛。"],"stanzas":[["伊商胡越尚同图，","管蔡如何有异谟。"],["不念祖宗危社稷，","强于仁圣遣行诛。"]]}
{"id":"6c6c1fec03","title":"三代门 成王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["成王有过伯禽笞，","圣惠能新日自奇。","王道既成何所感，","越裳呈瑞凤来仪。"],"stanzas":[["成王有过伯禽笞，","圣惠能新日自奇。"],["王道既成何所感，","越裳呈瑞凤来仪。"]]}
{"id":"16cb2a20b0","title":"三代门 幽王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["狼烟篝火为边尘，","烽候那宜悦妇人。","厚德未闻闻厚色，","不亡家国幸亡身。"],"stanzas":[["狼烟篝火为边尘，","烽候那宜悦妇人。"],["厚德未闻闻厚色，","不亡家国幸亡身。"]]}
{"id":"a8668fb796","title":"三代门 平王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["犬戎西集杀幽王，","邦土何由不便亡。","宜臼东来年更远，","川流难绝信源长。"],"stanzas":[["犬戎西集杀幽王，","邦土何由不便亡。"],["宜臼东来年更远，","川流难绝信源长。"]]}
{"id":"f39c3ca65e","title":"春秋战国门 祭足","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴鲁燕韩岂别宗，","曾无外御但相攻。","当时周郑谁为相，","交质将何服远戎。"],"stanzas":[["吴鲁燕韩岂别宗，","曾无外御但相攻。"],["当时周郑谁为相，","交质将何服远戎。"]]}
{"id":"7ac50b8a58","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["周室衰微不共匡，","干戈终日互争强。","诸侯若解尊天子，","列国何因次第亡。"],"stanzas":[["周室衰微不共匡，","干戈终日互争强。"],["诸侯若解尊天子，","列国何因次第亡。"]]}
{"id":"94ad610fa0","title":"春秋战国门 隐公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["今古难隄是小人，","苟希荣宠任相亲。","陈谋不信怀忧惧，","反间须防却害身。"],"stanzas":[["今古难隄是小人，","苟希荣宠任相亲。"],["陈谋不信怀忧惧，","反间须防却害身。"]]}
{"id":"b7aae847bc","title":"春秋战国门 庄公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["齐甲强临力有余，","鲁庄为战念区区。","鱼丽三鼓微曹刿，","肉食安能暇远谟。"],"stanzas":[["齐甲强临力有余，","鲁庄为战念区区。"],["鱼丽三鼓微曹刿，","肉食安能暇远谟。"]]}
{"id":"dd34302be9","title":"春秋战国门 哀公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贤为邻用国忧危，","庙算无非委艳奇。","两叶翠娥春乍展，","一毛须去不难吹。"],"stanzas":[["贤为邻用国忧危，","庙算无非委艳奇。"],["两叶翠娥春乍展，","一毛须去不难吹。"]]}
{"id":"a242b2e6be","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["好龙天为降真龙，","及见真龙瘁厥躬。","接下不勤徒好士，","叶公何异鲁哀公。"],"stanzas":[["好龙天为降真龙，","及见真龙瘁厥躬。"],["接下不勤徒好士，","叶公何异鲁哀公。"]]}
{"id":"365a5c6817","title":"春秋战国门 平公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鸿鹄轻腾万里高，","何殊朝野得贤豪。","能知翼戴穹苍力，","不是蒙茸腹背毛。"],"stanzas":[["鸿鹄轻腾万里高，","何殊朝野得贤豪。"],["能知翼戴穹苍力，","不是蒙茸腹背毛。"]]}
{"id":"16f97b32aa","title":"春秋战国门 文公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["灭虢吞虞未息兵，","柔秦败楚霸威成。","文公徒欲三强服，","分晋元来是六卿。"],"stanzas":[["灭虢吞虞未息兵，","柔秦败楚霸威成。"],["文公徒欲三强服，","分晋元来是六卿。"]]}
{"id":"bff1962467","title":"春秋战国门 景公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["觉病当宜早问师，","病深难疗恨难追。","晋侯徒有秦医缓，","疾在膏肓救已迟。"],"stanzas":[["觉病当宜早问师，","病深难疗恨难追。"],["晋侯徒有秦医缓，","疾在膏肓救已迟。"]]}
{"id":"bed94aa58a","title":"春秋战国门 卫灵公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子鱼无隐欲源清，","死不忘忠感卫灵。","伯玉既亲知德润，","残桃休吃悟兰馨。"],"stanzas":[["子鱼无隐欲源清，","死不忘忠感卫灵。"],["伯玉既亲知德润，","残桃休吃悟兰馨。"]]}
{"id":"16e6c46a18","title":"春秋战国门 陈灵公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁与陈君嫁祸来，","孔宁行父夏姬媒。","灵公徒认徴舒面，","至死何曾识祸胎。"],"stanzas":[["谁与陈君嫁祸来，","孔宁行父夏姬媒。"],["灵公徒认徴舒面，","至死何曾识祸胎。"]]}
{"id":"c4f2d5cb0b","title":"春秋战国门 陈蔡君","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楚聘宣尼欲道光，","是时陈蔡畏邻强。","庸谋但解遮贤路，","不解迎贤谋自昌。"],"stanzas":[["楚聘宣尼欲道光，","是时陈蔡畏邻强。"],["庸谋但解遮贤路，","不解迎贤谋自昌。"]]}
{"id":"e29016cea5","title":"春秋战国门 楚惠王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["芹中遇蛭强为吞，","不欲缘微有害人。","何事免成心腹疾，","皇天惟德是相亲。"],"stanzas":[["芹中遇蛭强为吞，","不欲缘微有害人。"],["何事免成心腹疾，","皇天惟德是相亲。"]]}
{"id":"51572a27d7","title":"春秋战国门 楚怀王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不听陈轸信张仪，","六里商于果见欺。","既舍黔中西换得，","又令生去益堪悲。"],"stanzas":[["不听陈轸信张仪，","六里商于果见欺。"],["既舍黔中西换得，","又令生去益堪悲。"]]}
{"id":"97abb2e1b4","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不得商于又失齐，","楚怀方寸一何迷。","明知秦是虎狼国，","更忍车轮独向西。"],"stanzas":[["不得商于又失齐，","楚怀方寸一何迷。"],["明知秦是虎狼国，","更忍车轮独向西。"]]}
{"id":"4562b5ce55","title":"春秋战国门 韩惠王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["韩惠开渠止暴秦，","营田万顷饱秦人。","何殊般肉供羸兽，","兽壮安知不害身。"],"stanzas":[["韩惠开渠止暴秦，","营田万顷饱秦人。"],["何殊般肉供羸兽，","兽壮安知不害身。"]]}
{"id":"5b75f6e3d8","title":"春秋战国门 顷襄王","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦陷荆王死不还，","秪缘偏听子兰言。","顷襄还信子兰语，","忍使江鱼葬屈原。"],"stanzas":[["秦陷荆王死不还，","秪缘偏听子兰言。"],["顷襄还信子兰语，","忍使江鱼葬屈原。"]]}
{"id":"4e495f4f30","title":"春秋战国门 武公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["猛兽来兵秪为文，","岂宜凉德拟图尊。","君看豹彩蒙麋质，","人取无难必不存。"],"stanzas":[["猛兽来兵秪为文，","岂宜凉德拟图尊。"],["君看豹彩蒙麋质，","人取无难必不存。"]]}
{"id":"2c3d4e1d83","title":"春秋战国门 华元","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["未知军法忌偏颇，","徒解于思腹漫皤。","昔日羊斟曾不预，","今朝为政事如何。"],"stanzas":[["未知军法忌偏颇，","徒解于思腹漫皤。"],["昔日羊斟曾不预，","今朝为政事如何。"]]}
{"id":"9b2414afef","title":"春秋战国门 臧孙","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["诸孟憎吾似犬狞，","贤臧哭孟倍伤情。","季孙爱我如甘疾，","疾足亡身药故宁。"],"stanzas":[["诸孟憎吾似犬狞，","贤臧哭孟倍伤情。"],["季孙爱我如甘疾，","疾足亡身药故宁。"]]}
{"id":"cee3b72409","title":"春秋战国门 公叔","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴起南奔魏国荒，","必听公叔失贤良。","无谋纵欲离安邑，","可免河沟徙大梁。"],"stanzas":[["吴起南奔魏国荒，","必听公叔失贤良。"],["无谋纵欲离安邑，","可免河沟徙大梁。"]]}
{"id":"df96ffcc24","title":"春秋战国门 庄辛","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庄辛正谏谓妖词，","兵及鄢陵始悔思。","见兔必能知顾犬，","亡羊补栈未为迟。"],"stanzas":[["庄辛正谏谓妖词，","兵及鄢陵始悔思。"],["见兔必能知顾犬，","亡羊补栈未为迟。"]]}
{"id":"8ec59fd13e","title":"春秋战国门 孙膑","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曾嫌胜己害贤人，","钻火明知速自焚。","断足尔能行不足，","逢君谁肯不酬君。"],"stanzas":[["曾嫌胜己害贤人，","钻火明知速自焚。"],["断足尔能行不足，","逢君谁肯不酬君。"]]}
{"id":"dea2c2b155","title":"春秋战国门 灵[辄]","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["失水枯鳞得再生，","翳桑无地谢深情。","朱轮为染酬恩血，","公子何由见赤诚。"],"stanzas":[["失水枯鳞得再生，","翳桑无地谢深情。"],["朱轮为染酬恩血，","公子何由见赤诚。"]]}
{"id":"7d3c478459","title":"春秋战国门 郭开","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦袭邯郸岁月深，","何人沾赠郭开金。","廉颇还国李牧在，","安得赵王为尔擒。"],"stanzas":[["秦袭邯郸岁月深，","何人沾赠郭开金。"],["廉颇还国李牧在，","安得赵王为尔擒。"]]}
{"id":"cb22c11929","title":"春秋战国门 乐羊","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["桮羹忍啜得非忠，","巧佞胡为惑主聪。","盈箧谤书能寝默，","中山不是乐羊功。"],"stanzas":[["桮羹忍啜得非忠，","巧佞胡为惑主聪。"],["盈箧谤书能寝默，","中山不是乐羊功。"]]}
{"id":"d3edae29bc","title":"春秋战国门 虞卿","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["割地求和国必危，","安知坚守绝来思。","年年来伐年年割，","割尽韩郸何所之。"],"stanzas":[["割地求和国必危，","安知坚守绝来思。"],["年年来伐年年割，","割尽韩郸何所之。"]]}
{"id":"a4bf50d180","title":"春秋战国门 豫让","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门客家臣义莫俦，","漆身吞炭不能休。","中行智伯思何异，","国士终期国士酬。"],"stanzas":[["门客家臣义莫俦，","漆身吞炭不能休。"],["中行智伯思何异，","国士终期国士酬。"]]}
{"id":"ad69c99288","title":"春秋战国门 毛遂","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不识囊中颕脱锥，","功成方信有英奇。","平原门下三千客，","得力何曾是素知。"],"stanzas":[["不识囊中颕脱锥，","功成方信有英奇。"],["平原门下三千客，","得力何曾是素知。"]]}
{"id":"b8ddee5612","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["定获英奇不在多，","然须设网遍山河。","禽虽一目罗中得，","岂可空张一目罗。"],"stanzas":[["定获英奇不在多，","然须设网遍山河。"],["禽虽一目罗中得，","岂可空张一目罗。"]]}
{"id":"816452b94f","title":"春秋战国门 田文","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["下客常才不足珍，","谁为狗盗脱强秦。","秦关若待鸡鸣出，","笑杀临淄土偶人。"],"stanzas":[["下客常才不足珍，","谁为狗盗脱强秦。"],["秦关若待鸡鸣出，","笑杀临淄土偶人。"]]}
{"id":"40ea71e4ab","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门下三千各自矜，","频弹剑客独无能。","田文不厌无能客，","三窟全身果有凭。"],"stanzas":[["门下三千各自矜，","频弹剑客独无能。"],["田文不厌无能客，","三窟全身果有凭。"]]}
{"id":"02708ba74e","title":"春秋战国门 冯讙","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兔窟穿成主再兴，","辈流狐伏敢骄矜。","冯讙不是无能者，","要试君心欲展能。"],"stanzas":[["兔窟穿成主再兴，","辈流狐伏敢骄矜。"],["冯讙不是无能者，","要试君心欲展能。"]]}
{"id":"707d333bfc","title":"春秋战国门 章子","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["在家能子必能臣，","齐将功成以孝闻。","改葬义无欺死父，","临戎安肯背生君。"],"stanzas":[["在家能子必能臣，","齐将功成以孝闻。"],["改葬义无欺死父，","临戎安肯背生君。"]]}
{"id":"7710199109","title":"春秋战国门 卞和","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["磷磷谁为惑温温，","至宝凡姿甚易分。","自是时人多贵耳，","目无明鉴使俱焚。"],"stanzas":[["磷磷谁为惑温温，","至宝凡姿甚易分。"],["自是时人多贵耳，","目无明鉴使俱焚。"]]}
{"id":"c094f13d50","title":"春秋战国门 季札","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吹毛霜刃过千金，","生许徐君死挂林。","宝剑徒称无价宝，","行心更贵不欺心。"],"stanzas":[["吹毛霜刃过千金，","生许徐君死挂林。"],["宝剑徒称无价宝，","行心更贵不欺心。"]]}
{"id":"2f5e46bae0","title":"春秋战国门 孙武","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["理国无难似理兵，","兵家法令贵遵行。","行刑不避君王宠，","一笑随刀八阵成。"],"stanzas":[["理国无难似理兵，","兵家法令贵遵行。"],["行刑不避君王宠，","一笑随刀八阵成。"]]}
{"id":"8f4c50d598","title":"春秋战国门 夫差","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["信听谗言疾不除，","忠臣须杀竟何如。","会稽既雪夫差死，","泉下胡颜见子胥。"],"stanzas":[["信听谗言疾不除，","忠臣须杀竟何如。"],["会稽既雪夫差死，","泉下胡颜见子胥。"]]}
{"id":"e635184caa","title":"春秋战国门 少孺","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宝贵亲仁与善邻，","邻兵何要互相臻。","螳蜋定是遭黄雀，","黄雀须访挟弹人。"],"stanzas":[["宝贵亲仁与善邻，","邻兵何要互相臻。"],["螳蜋定是遭黄雀，","黄雀须访挟弹人。"]]}
{"id":"af3b359d86","title":"春秋战国门 苏厉","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百步穿杨箭不移，","养由堪教听弘规。","身隆业著未知退，","勿遣功名一旦隳。"],"stanzas":[["百步穿杨箭不移，","养由堪教听弘规。"],["身隆业著未知退，","勿遣功名一旦隳。"]]}
{"id":"155bd5231c","title":"春秋战国门 鬻拳","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鬻拳强谏惧威刑，","退省怀慙不顾生。","双刖忍行留痛恨，","惟君适足见忠诚。"],"stanzas":[["鬻拳强谏惧威刑，","退省怀慙不顾生。"],["双刖忍行留痛恨，","惟君适足见忠诚。"]]}
{"id":"f8fb33571c","title":"春秋战国门 荆轲","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["反刃相酬是匹夫，","安知突骑驾群胡。","有心为报怀权畧，","可在于期与地图。"],"stanzas":[["反刃相酬是匹夫，","安知突骑驾群胡。"],["有心为报怀权畧，","可在于期与地图。"]]}
{"id":"47a4e5e0d1","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["几尺如霜利不群，","恩仇未报反亡身。","诚哉利器全由用，","可惜吹毛不得人。"],"stanzas":[["几尺如霜利不群，","恩仇未报反亡身。"],["诚哉利器全由用，","可惜吹毛不得人。"]]}
{"id":"d081394663","title":"春秋战国门 陈轸","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丹青徒有逞諠哗，","有足由来不是蛇。","杀将破军为柱国，","君今官极更何加。"],"stanzas":[["丹青徒有逞諠哗，","有足由来不是蛇。"],["杀将破军为柱国，","君今官极更何加。"]]}
{"id":"5ba1b57d00","title":"春秋战国门 田饶","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["厨抛败肉士怀饥，","仓烂余粮客未炊。","临难欲行求死士，","将何恩信致扶危。"],"stanzas":[["厨抛败肉士怀饥，","仓烂余粮客未炊。"],["临难欲行求死士，","将何恩信致扶危。"]]}
{"id":"153cd38484","title":"春秋战国门 鲍叔","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忠臣祝寿吐嘉词，","鲍叔临轩酒一巵。","安不忘危臣所愿，","愿思危困必无危。"],"stanzas":[["忠臣祝寿吐嘉词，","鲍叔临轩酒一巵。"],["安不忘危臣所愿，","愿思危困必无危。"]]}
{"id":"a5568aa282","title":"春秋战国门 晏婴","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["正人徒以刃相危，","贪利忘忠死不为。","麋鹿命悬当有处，","驱车何必用奔驰。"],"stanzas":[["正人徒以刃相危，","贪利忘忠死不为。"],["麋鹿命悬当有处，","驱车何必用奔驰。"]]}
{"id":"68c18709a4","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["下泽逢蛇盖是常，","还如山上见豺狼。","国中有怪非蛇兽，","不用贤能是不祥。"],"stanzas":[["下泽逢蛇盖是常，","还如山上见豺狼。"],["国中有怪非蛇兽，","不用贤能是不祥。"]]}
{"id":"42362e1de1","title":"春秋战国门 又吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["马毙廐人欲就刑，","百年临尽一言生。","赖逢贤相能匡救，","仍免吾君播恶声。"],"stanzas":[["马毙廐人欲就刑，","百年临尽一言生。"],["赖逢贤相能匡救，","仍免吾君播恶声。"]]}
{"id":"e26daac72a","title":"春秋战国门 叔向","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重禄存家不敢言，","小臣忧祸亦如然。","明开谏诤能无罪，","秪此宜为理国先。"],"stanzas":[["重禄存家不敢言，","小臣忧祸亦如然。"],["明开谏诤能无罪，","秪此宜为理国先。"]]}
{"id":"9dbd30cab7","title":"春秋战国门 师旷","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["老能劝学照余生，","似夜随灯到处明。","往行前言如不见，","暗中无烛若为行。"],"stanzas":[["老能劝学照余生，","似夜随灯到处明。"],["往行前言如不见，","暗中无烛若为行。"]]}
{"id":"d19b75e300","title":"春秋战国门 智伯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三国连兵敌就擒，","晋阳城下碧波深。","风涛撼处看沈赵，","舟楫不从飜自沈。"],"stanzas":[["三国连兵敌就擒，","晋阳城下碧波深。"],["风涛撼处看沈赵，","舟楫不从飜自沈。"]]}
{"id":"59536d1d7d","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["攻城来下惜先分，","一旦家邦属四邻。","徒逞威强称智伯，","不知权变是愚人。"],"stanzas":[["攻城来下惜先分，","一旦家邦属四邻。"],["徒逞威强称智伯，","不知权变是愚人。"]]}
{"id":"71414bf889","title":"春秋战国门 襄子","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君子常闻不迫危，","城崩何用急重围。","叛亡能退修文德，","果见中牟以义归。"],"stanzas":[["君子常闻不迫危，","城崩何用急重围。"],["叛亡能退修文德，","果见中牟以义归。"]]}
{"id":"954eb9009d","title":"春秋战国门 杨回","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三逐乡闾五去君，","莫知何地可容身。","杨回不是逢英鉴，","白首无成一旅人。"],"stanzas":[["三逐乡闾五去君，","莫知何地可容身。"],["杨回不是逢英鉴，","白首无成一旅人。"]]}
{"id":"efeb316b14","title":"春秋战国门 颜回","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陋巷箪瓢困有年，","是时端木饫腥膻。","宣尼行教何形迹，","不肯分甘救子渊。"],"stanzas":[["陋巷箪瓢困有年，","是时端木饫腥膻。"],["宣尼行教何形迹，","不肯分甘救子渊。"]]}
{"id":"96f1dd8ac2","title":"春秋战国门 子贡","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["救鲁亡吴事可伤，","谁令利口说田常。","吴亡必定由端木，","鲁亦宜其运不长。"],"stanzas":[["救鲁亡吴事可伤，","谁令利口说田常。"],["吴亡必定由端木，","鲁亦宜其运不长。"]]}
{"id":"e277e95a1e","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一言能使定安危，","安己危人是所宜。","仁义不思垂教化，","背恩亡德岂儒为。"],"stanzas":[["一言能使定安危，","安己危人是所宜。"],["仁义不思垂教化，","背恩亡德岂儒为。"]]}
{"id":"d192c7c412","title":"春秋战国门 郑相","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["郑相清贤慎有余，","好鱼鱼至竟何如。","退鱼留得终身禄，","禄在何忧不得鱼。"],"stanzas":[["郑相清贤慎有余，","好鱼鱼至竟何如。"],["退鱼留得终身禄，","禄在何忧不得鱼。"]]}
{"id":"accc2ec1e8","title":"春秋战国门 子产","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为政何门是化源，","宽仁高下保安全。","如嫌水德人多狎，","拯溺宜将猛济宽。"],"stanzas":[["为政何门是化源，","宽仁高下保安全。"],["如嫌水德人多狎，","拯溺宜将猛济宽。"]]}
{"id":"4c5ac30283","title":"春秋战国门 管仲","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["美酒浓馨客要沽，","门深谁敢强提壶。","苟非贤主询贤士，","肯信沽人畏子獹。"],"stanzas":[["美酒浓馨客要沽，","门深谁敢强提壶。"],["苟非贤主询贤士，","肯信沽人畏子獹。"]]}
{"id":"ee95ac1fe3","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["社鼠穿墙巧庇身，","何由攻灌若为熏。","能知窟穴依形势，","不听谗邪是圣君。"],"stanzas":[["社鼠穿墙巧庇身，","何由攻灌若为熏。"],["能知窟穴依形势，","不听谗邪是圣君。"]]}
{"id":"87ebd2d005","title":"春秋战国门 范蠡","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["西子能令转嫁吴，","会稽知尔啄姑苏。","迹高尘外功成处，","一叶翩翩在五湖。"],"stanzas":[["西子能令转嫁吴，","会稽知尔啄姑苏。"],["迹高尘外功成处，","一叶翩翩在五湖。"]]}
{"id":"766599419b","title":"春秋战国门 屈原","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["满朝皆醉不容醒，","众浊如何拟独清。","江上流人真浪死，","谁知浸润悮深诚。"],"stanzas":[["满朝皆醉不容醒，","众浊如何拟独清。"],["江上流人真浪死，","谁知浸润悮深诚。"]]}
{"id":"05db8d5446","title":"春秋战国门 黄歇","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["春申随质若王图，","为主轻生大丈夫。","女子异心安足听，","功成何更用阴谟。"],"stanzas":[["春申随质若王图，","为主轻生大丈夫。"],["女子异心安足听，","功成何更用阴谟。"]]}
{"id":"1aebbddd76","title":"春秋战国门 王后","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["连环要解解非难，","忽碎瑶堦一旦间。","两国相持兵不解，","会应俱碎似连环。"],"stanzas":[["连环要解解非难，","忽碎瑶堦一旦间。"],["两国相持兵不解，","会应俱碎似连环。"]]}
{"id":"5eb0f83b9f","title":"春秋战国门 樊姬","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["侧影频移未退朝，","喜逢贤相日从高。","当时不有樊姬问，","令尹何由进叔敖。"],"stanzas":[["侧影频移未退朝，","喜逢贤相日从高。"],["当时不有樊姬问，","令尹何由进叔敖。"]]}
{"id":"42b68af8ce","title":"春秋战国门 齐桓公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["三往何劳万乘君，","五来方见一微臣。","微臣傲爵能轻主，","霸主如何敢傲人。"],"stanzas":[["三往何劳万乘君，","五来方见一微臣。"],["微臣傲爵能轻主，","霸主如何敢傲人。"]]}
{"id":"757504727d","title":"春秋战国门 中山君","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["敌临烹子一何庸，","激怒来军速自攻。","结怨岂思围不解，","愚谋多以杀为雄。"],"stanzas":[["敌临烹子一何庸，","激怒来军速自攻。"],["结怨岂思围不解，","愚谋多以杀为雄。"]]}
{"id":"23cdba4b5d","title":"春秋战国门 赵简子","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["简子雄心蓄霸机，","贤愚聊欲试诸儿。","假言藏宝非真宝，","不是生知焉得知。"],"stanzas":[["简子雄心蓄霸机，","贤愚聊欲试诸儿。"],["假言藏宝非真宝，","不是生知焉得知。"]]}
{"id":"f2ab2769e6","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谔谔能昌唯唯亡，","亦由匡正得贤良。","一从忠谠无周舍，","吾过何人为短长。"],"stanzas":[["谔谔能昌唯唯亡，","亦由匡正得贤良。"],["一从忠谠无周舍，","吾过何人为短长。"]]}
{"id":"6aeaa645ed","title":"春秋战国门 赵宣子","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["门人曾不有提弥，","连嗾呀呀孰敢支。","临难若教无苟免，","乱朝争那以獒为。"],"stanzas":[["门人曾不有提弥，","连嗾呀呀孰敢支。"],["临难若教无苟免，","乱朝争那以獒为。"]]}
{"id":"9a58cb51aa","title":"春秋战国门 韩昭侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["去年秦伐我宜阳，","今岁天灾旱且荒。","对此不思人力困，","楼门何可更高张。"],"stanzas":[["去年秦伐我宜阳，","今岁天灾旱且荒。"],["对此不思人力困，","楼门何可更高张。"]]}
{"id":"f371455a74","title":"春秋战国门 魏文侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["冒雨如何固出畋，","虑乖群约失干干。","文侯不是贪禽者，","示信将为教化先。"],"stanzas":[["冒雨如何固出畋，","虑乖群约失干干。"],["文侯不是贪禽者，","示信将为教化先。"]]}
{"id":"0abae1fa6a","title":"春秋战国门 郄成子","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["陈乐无懽璧在隅，","宰臣怀智有微谟。","苟非成子当明哲，","谁是仁人可托孤。"],"stanzas":[["陈乐无懽璧在隅，","宰臣怀智有微谟。"],["苟非成子当明哲，","谁是仁人可托孤。"]]}
{"id":"bbb6bf516e","title":"春秋战国门 秦武阳","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["丱岁徒闻有壮名，","及令为副误荆卿。","是时环柱能相副，","谁谓燕囚事不成。"],"stanzas":[["丱岁徒闻有壮名，","及令为副误荆卿。"],["是时环柱能相副，","谁谓燕囚事不成。"]]}
{"id":"290b737647","title":"春秋战国门 田子方","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太子无嫌礼乐亏，","愿听贫富与安危。","贱贫骄物贫终在，","富贵骄人贵必隳。"],"stanzas":[["太子无嫌礼乐亏，","愿听贫富与安危。"],["贱贫骄物贫终在，","富贵骄人贵必隳。"]]}
{"id":"b9da50375c","title":"春秋战国门 淳于髠","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["穰穰何祷手何賷，","一呷村浆与只鸡。","以少求多诚可笑，","还如轻币欲全齐。"],"stanzas":[["穰穰何祷手何賷，","一呷村浆与只鸡。"],["以少求多诚可笑，","还如轻币欲全齐。"]]}
{"id":"4ec584b140","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戏问将何对所耽，","滑稽无骨是常谭。","昔时王者皆通四，","近见君王祗好三。"],"stanzas":[["戏问将何对所耽，","滑稽无骨是常谭。"],["昔时王者皆通四，","近见君王祗好三。"]]}
{"id":"ed0185765a","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["曲突徙薪不谓贤，","焦头烂额飨盘筵。","时人多是轻先见，","不独田家国亦然。"],"stanzas":[["曲突徙薪不谓贤，","焦头烂额飨盘筵。"],["时人多是轻先见，","不独田家国亦然。"]]}
{"id":"d228439c9b","title":"春秋战国门 田子奇","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["少年为吏虑非循，","一骑奔追委使臣。","使者不追何所对，","车中缘见白头人。"],"stanzas":[["少年为吏虑非循，","一骑奔追委使臣。"],["使者不追何所对，","车中缘见白头人。"]]}
{"id":"5e93321aba","title":"春秋战国门 百里奚","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["船骥由来是股肱，","在虞虞灭在秦兴。","裁量何异刀将尺，","秪系用之能不能。"],"stanzas":[["船骥由来是股肱，","在虞虞灭在秦兴。"],["裁量何异刀将尺，","秪系用之能不能。"]]}
{"id":"6fcf0b728d","title":"春秋战国门 孙叔敖","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["童稚逢蛇叹不祥，","虑悲来者为埋藏。","是知阳报由阴施，","天爵昭然契日彰。"],"stanzas":[["童稚逢蛇叹不祥，","虑悲来者为埋藏。"],["是知阳报由阴施，","天爵昭然契日彰。"]]}
{"id":"f97eb1437a","title":"春秋战国门 鲁仲连","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["昔迸烧牛发战机，","夜奔惊火走燕师。","今来跃马怀骄惰，","十万如无一撮时。"],"stanzas":[["昔迸烧牛发战机，","夜奔惊火走燕师。"],["今来跃马怀骄惰，","十万如无一撮时。"]]}
{"id":"83922b7f31","title":"春秋战国门 宋子罕","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子怜温润欲归仁，","吾贵坚廉是宝身。","自有不贪身内宝，","玉人徒献外来珍。"],"stanzas":[["子怜温润欲归仁，","吾贵坚廉是宝身。"],["自有不贪身内宝，","玉人徒献外来珍。"]]}
{"id":"b2fb410e61","title":"春秋战国门 宫之奇","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["虞虢相依自保安，","谋臣吞度不为难。","贪怜璧马迷香饵，","肯信之奇谕齿寒。"],"stanzas":[["虞虢相依自保安，","谋臣吞度不为难。"],["贪怜璧马迷香饵，","肯信之奇谕齿寒。"]]}
{"id":"fb1de755f3","title":"春秋战国门 王孙满","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九牧金镕物像成，","辞昏去乱祚休明。","兴亡在德不在鼎，","楚子何劳问重轻。"],"stanzas":[["九牧金镕物像成，","辞昏去乱祚休明。"],["兴亡在德不在鼎，","楚子何劳问重轻。"]]}
{"id":"650f73fd25","title":"春秋战国门 颜叔子","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夜雨邻娃告屋倾，","一宵从寄念悲惊。","诚知独处从烧烛，","君子行心要自明。"],"stanzas":[["夜雨邻娃告屋倾，","一宵从寄念悲惊。"],["诚知独处从烧烛，","君子行心要自明。"]]}
{"id":"df16297910","title":"春秋战国门 张孟谭","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["强兵四合国将危，","赖有谋臣为发挥。","城内蒿铜诚自有，","无谋谁解见玄机。"],"stanzas":[["强兵四合国将危，","赖有谋臣为发挥。"],["城内蒿铜诚自有，","无谋谁解见玄机。"]]}
{"id":"ac67da7a73","title":"春秋战国门 公子无忌","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["按剑临笼震咄呼，","鹞甘枭戮伏鸠辜。","能怜钝拙诛豪俊，","悯弱摧强真丈夫。"],"stanzas":[["按剑临笼震咄呼，","鹞甘枭戮伏鸠辜。"],["能怜钝拙诛豪俊，","悯弱摧强真丈夫。"]]}
{"id":"053438c9ec","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赵解重围魏再昌，","信陵贤德日馨芳。","昏蒙愚主听谗说，","公子云亡国亦亡。"],"stanzas":[["赵解重围魏再昌，","信陵贤德日馨芳。"],["昏蒙愚主听谗说，","公子云亡国亦亡。"]]}
{"id":"cdf09b5fe1","title":"春秋战国门 侯嬴朱亥","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["屠肆监门一贱微，","信陵交结国人非。","当时不是二君计，","匹马那能解赵围。"],"stanzas":[["屠肆监门一贱微，","信陵交结国人非。"],["当时不是二君计，","匹马那能解赵围。"]]}
{"id":"ceed521ae5","title":"春秋战国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["走敌存亡义有余，","全由雄勇与英谟。","但如公子能交结，","朱亥侯嬴何代无。"],"stanzas":[["走敌存亡义有余，","全由雄勇与英谟。"],["但如公子能交结，","朱亥侯嬴何代无。"]]}
{"id":"8b6d7ebb5e","title":"秦门 胡亥","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鹿马何难辨是非，","宁劳卜筮问安危。","权臣为乱多如此，","亡国时君不自知。"],"stanzas":[["鹿马何难辨是非，","宁劳卜筮问安危。"],["权臣为乱多如此，","亡国时君不自知。"]]}
{"id":"ba8f93b72e","title":"秦门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["盗贼纵横主恶闻，","遂为流矢犯君轩。","怪言何不早言者，","若使早言还不存。"],"stanzas":[["盗贼纵横主恶闻，","遂为流矢犯君轩。"],["怪言何不早言者，","若使早言还不存。"]]}
{"id":"990d39c937","title":"秦门 赵高","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["赵高胡亥速天诛，","率土兴兵怨毒痡。","丰沛见机群小吏，","功成儿戏亦何殊。"],"stanzas":[["赵高胡亥速天诛，","率土兴兵怨毒痡。"],["丰沛见机群小吏，","功成儿戏亦何殊。"]]}
{"id":"1fa34a6be6","title":"秦门 陈涉","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秦法烦苛霸业隳，","一夫攘臂万夫随。","王侯无种英雄志，","燕雀喧喧安得知。"],"stanzas":[["秦法烦苛霸业隳，","一夫攘臂万夫随。"],["王侯无种英雄志，","燕雀喧喧安得知。"]]}
{"id":"fc278b2bb2","title":"秦门 项籍","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["九垓垂定弃谋臣，","一阵无功便杀身。","壮士诚知轻性命，","不思辜负八千人。"],"stanzas":[["九垓垂定弃谋臣，","一阵无功便杀身。"],["壮士诚知轻性命，","不思辜负八千人。"]]}
{"id":"c873fc2d8d","title":"秦门 范增","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["智士宁为暗主谟，","范公曾不读兵书。","平生心力为谁尽，","一事无成空背疽。"],"stanzas":[["智士宁为暗主谟，","范公曾不读兵书。"],["平生心力为谁尽，","一事无成空背疽。"]]}
{"id":"4b1a248643","title":"前汉门 高祖","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["爱子从烹报主时，","安知强啜不含悲。","太公悬命临刀几，","忍取桮羹欲为谁。"],"stanzas":[["爱子从烹报主时，","安知强啜不含悲。"],["太公悬命临刀几，","忍取桮羹欲为谁。"]]}
{"id":"78dbfa9fb7","title":"前汉门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["北伐匈奴事可悲，","当时将相是其谁。","君臣束手平城里，","三十万兵能忍饥。"],"stanzas":[["北伐匈奴事可悲，","当时将相是其谁。"],["君臣束手平城里，","三十万兵能忍饥。"]]}
{"id":"107e930202","title":"前汉门 周苛纪信","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为主坚能不顾身，","赴汤蹈火见忠臣。","后来邦国论心义，","谁是君王出热人。"],"stanzas":[["为主坚能不顾身，","赴汤蹈火见忠臣。"],["后来邦国论心义，","谁是君王出热人。"]]}
{"id":"1beecea307","title":"前汉门 酂侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["共怪酂侯第一功，","咸称得地合先封。","韩生不是萧君荐，","猎犬何人为指踪。"],"stanzas":[["共怪酂侯第一功，","咸称得地合先封。"],["韩生不是萧君荐，","猎犬何人为指踪。"]]}
{"id":"5a743eb6c1","title":"前汉门 曲逆侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["社肉分平未足奇，","须观大用展无私。","一朝如得宰天下，","必使还如宰社时。"],"stanzas":[["社肉分平未足奇，","须观大用展无私。"],["一朝如得宰天下，","必使还如宰社时。"]]}
{"id":"ef398ba689","title":"前汉门 薛公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["黥布称兵孰敢当，","薛公三计为斟量。","上中良策知非用，","南取长沙是死乡。"],"stanzas":[["黥布称兵孰敢当，","薛公三计为斟量。"],["上中良策知非用，","南取长沙是死乡。"]]}
{"id":"921489434a","title":"前汉门 条侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上将风戈赏罚明，","矛鋋严闭亚夫营。","人君却禀将军令，","按辔垂鞭为缓行。"],"stanzas":[["上将风戈赏罚明，","矛鋋严闭亚夫营。"],["人君却禀将军令，","按辔垂鞭为缓行。"]]}
{"id":"bab76a0523","title":"前汉门 平津侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["儒素逢时得自媒，","忽从徒步列公台。","北辰如不延吾辈，","东阁何由逐汝开。"],"stanzas":[["儒素逢时得自媒，","忽从徒步列公台。"],["北辰如不延吾辈，","东阁何由逐汝开。"]]}
{"id":"7f07f2cfe2","title":"前汉门 博陆侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["栋梁徒自保坚贞，","毁穴难防雀鼠争。","不是主人知诈伪，","如何柱石免欹倾。"],"stanzas":[["栋梁徒自保坚贞，","毁穴难防雀鼠争。"],["不是主人知诈伪，","如何柱石免欹倾。"]]}
{"id":"b41bfd9852","title":"前汉门 夏贺良","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉代中微亦再昌，","忠臣忧国冀修禳。","赤精符谶诚非妄，","枉杀无辜夏贺良。"],"stanzas":[["汉代中微亦再昌，","忠臣忧国冀修禳。"],["赤精符谶诚非妄，","枉杀无辜夏贺良。"]]}
{"id":"cdfbedeb0d","title":"前汉门 王莽","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["权归诸吕牝鸡鸣，","殷鉴昭然讵可轻。","新室不囚崇外戚，","水中安敢寄生营。"],"stanzas":[["权归诸吕牝鸡鸣，","殷鉴昭然讵可轻。"],["新室不囚崇外戚，","水中安敢寄生营。"]]}
{"id":"7b5ecadfd5","title":"前汉门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["重赋严刑作祸胎，","岂知由此乱离媒。","家传揖让亦难济，","况是身从倾篡来。"],"stanzas":[["重赋严刑作祸胎，","岂知由此乱离媒。"],["家传揖让亦难济，","况是身从倾篡来。"]]}
{"id":"397ebb078e","title":"前汉门 又吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["铜马朱眉满四方，","总缘居摄乱天常。","因君多少布衣士，","不是公卿即帝王。"],"stanzas":[["铜马朱眉满四方，","总缘居摄乱天常。"],["因君多少布衣士，","不是公卿即帝王。"]]}
{"id":"1013c27782","title":"前汉门 毛延寿","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不拔金钗赂汉臣，","徒嗟玉艳委胡尘。","能知货贿移妍丑，","岂独丹青画美人。"],"stanzas":[["不拔金钗赂汉臣，","徒嗟玉艳委胡尘。"],["能知货贿移妍丑，","岂独丹青画美人。"]]}
{"id":"c9b1eef6d3","title":"前汉门 刘圣公","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["不纳良谋刘𬙂言，","胡为衔璧向崇宣。","伤哉乱帝途穷处，","何必当时谮福先。"],"stanzas":[["不纳良谋刘𬙂言，","胡为衔璧向崇宣。"],["伤哉乱帝途穷处，","何必当时谮福先。"]]}
{"id":"36de6673ab","title":"前汉门 樊崇徐宣","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["庸中佼佼铁铮铮，","百万长驱入帝京。","首事纵隳三善在，","归仁何虑不全生。"],"stanzas":[["庸中佼佼铁铮铮，","百万长驱入帝京。"],["首事纵隳三善在，","归仁何虑不全生。"]]}
{"id":"cfec1baece","title":"前汉门 僭号公孙述","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["剑蜀金汤孰敢争，","子阳才业匪雄英。","方知在德不在险，","危栈何曾阻汉兵。"],"stanzas":[["剑蜀金汤孰敢争，","子阳才业匪雄英。"],["方知在德不在险，","危栈何曾阻汉兵。"]]}
{"id":"56c1fdc9ef","title":"后汉门 光武","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["成败非儒孰可量，","儒生何指指萧王。","萧王得众能宽裕，","吴汉归来帝业昌。"],"stanzas":[["成败非儒孰可量，","儒生何指指萧王。"],["萧王得众能宽裕，","吴汉归来帝业昌。"]]}
{"id":"2af69a18a3","title":"后汉门 明帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["朝臣咸佞孰知非，","张佚公忠语独奇。","博士一言除太傅，","谥为明帝信其宜。"],"stanzas":[["朝臣咸佞孰知非，","张佚公忠语独奇。"],["博士一言除太傅，","谥为明帝信其宜。"]]}
{"id":"e696e5e222","title":"后汉门 桓帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["能嫌跋扈斩梁王，","宁便荣枯信段张。","襄楷忠言谁佞惑，","忍教奸祸起萧墙。"],"stanzas":[["能嫌跋扈斩梁王，","宁便荣枯信段张。"],["襄楷忠言谁佞惑，","忍教奸祸起萧墙。"]]}
{"id":"bb95557cba","title":"后汉门 灵帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["榜悬金价鬻官荣，","千万为公五百卿。","公瑾孔明穷退者，","安知高卧遇雄英。"],"stanzas":[["榜悬金价鬻官荣，","千万为公五百卿。"],["公瑾孔明穷退者，","安知高卧遇雄英。"]]}
{"id":"7e5867934d","title":"后汉门 废帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["乱兵如猬走王师，","社稷颠危孰为持。","夜逐萤光寻道路，","汉家天子步归时。"],"stanzas":[["乱兵如猬走王师，","社稷颠危孰为持。"],["夜逐萤光寻道路，","汉家天子步归时。"]]}
{"id":"16cf93e8d5","title":"后汉门 献帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["秪为曹侯数贵人，","普天黔首尽黄巾。","汉灵早听侍中谏，","安得献生称不辰。"],"stanzas":[["秪为曹侯数贵人，","普天黔首尽黄巾。"],["汉灵早听侍中谏，","安得献生称不辰。"]]}
{"id":"f72051d75d","title":"后汉门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["咸怨刑科有党偏，","耕夫无不事戎旃。","是时老幼饥号处，","一斛黄禾五百千。"],"stanzas":[["咸怨刑科有党偏，","耕夫无不事戎旃。"],["是时老幼饥号处，","一斛黄禾五百千。"]]}
{"id":"f9aa733138","title":"后汉门 子密","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["子密封侯岂所宜，","能高德义必无为。","当时若缚还彭氏，","率土何忧不自归。"],"stanzas":[["子密封侯岂所宜，","能高德义必无为。"],["当时若缚还彭氏，","率土何忧不自归。"]]}
{"id":"1888c2eb20","title":"后汉门 羊续","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["鱼悬洁白振清风，","禄散亲宾岁自穷。","单席寒厅慙使者，","葛衣何以至三公。"],"stanzas":[["鱼悬洁白振清风，","禄散亲宾岁自穷。"],["单席寒厅慙使者，","葛衣何以至三公。"]]}
{"id":"4b98d33a72","title":"后汉门 杨震","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为国推贤匪惠私，","十金为报遽相危。","无言暗室何人见，","咫尺斯须已四知。"],"stanzas":[["为国推贤匪惠私，","十金为报遽相危。"],["无言暗室何人见，","咫尺斯须已四知。"]]}
{"id":"d6bf2d54ab","title":"后汉门 赵孝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿林清旦正朝饥，","岂计行人瘦与肥。","为感在原哀叫切，","鹡鸰休报听双飞。"],"stanzas":[["绿林清旦正朝饥，","岂计行人瘦与肥。"],["为感在原哀叫切，","鹡鸰休报听双飞。"]]}
{"id":"b67401b5e7","title":"后汉门 马后","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["麄衣闲寂阅群书，","荐达嫔妃广帝居。","再实伤根嫌贵宠，","惠慈劳悴育皇储。"],"stanzas":[["麄衣闲寂阅群书，","荐达嫔妃广帝居。"],["再实伤根嫌贵宠，","惠慈劳悴育皇储。"]]}
{"id":"bc8095d8d5","title":"后汉门 魏博妻","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["萝挂青松是所依，","松凋萝更改何枝。","操刀必割腕可断，","磐石徒坚心不移。"],"stanzas":[["萝挂青松是所依，","松凋萝更改何枝。"],["操刀必割腕可断，","磐石徒坚心不移。"]]}
{"id":"4773945821","title":"后汉门 曹娥","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["心摧目断哭江𣸣，","窥浪无踪日又昏。","不入重泉寻水底，","此生安得见沈魂。"],"stanzas":[["心摧目断哭江𣸣，","窥浪无踪日又昏。"],["不入重泉寻水底，","此生安得见沈魂。"]]}
{"id":"e30c984fcf","title":"后汉门 周都妻","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["绿水双鸳一已沈，","皇天更欲配何禽。","不将血涕随霜刃，","谁见朱殷未死心。"],"stanzas":[["绿水双鸳一已沈，","皇天更欲配何禽。"],["不将血涕随霜刃，","谁见朱殷未死心。"]]}
{"id":"e121ca9b53","title":"后汉门 鲍宣妻","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君恶奢华意不欢，","一言从俭亦何难。","但能和乐同琴瑟，","未必恩情在绮纨。"],"stanzas":[["君恶奢华意不欢，","一言从俭亦何难。"],["但能和乐同琴瑟，","未必恩情在绮纨。"]]}
{"id":"8a77f147df","title":"后汉门 吕母","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["狱无良吏雪无由，","处处戈鋋自执仇。","吕母衔冤穷老妇，","亦能为帅复私雠。"],"stanzas":[["狱无良吏雪无由，","处处戈鋋自执仇。"],["吕母衔冤穷老妇，","亦能为帅复私雠。"]]}
{"id":"1dac6e0ac1","title":"三国门 蜀先主","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["豫州军败信途穷，","徐庶推能荐卧龙。","不是卑词三访谒，","谁令玄德主巴邛。"],"stanzas":[["豫州军败信途穷，","徐庶推能荐卧龙。"],["不是卑词三访谒，","谁令玄德主巴邛。"]]}
{"id":"7340d5c310","title":"三国门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一家区宇忽三分，","龌龊车书曷足论。","定有伊姜为佐辅，","忍教鸿鴈各乾坤。"],"stanzas":[["一家区宇忽三分，","龌龊车书曷足论。"],["定有伊姜为佐辅，","忍教鸿鴈各乾坤。"]]}
{"id":"a80bc8f49d","title":"三国门 后主","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["万峰如剑载前来，","危阁横空信险哉。","对此玄休长叹息，","方知刘禅是庸才。"],"stanzas":[["万峰如剑载前来，","危阁横空信险哉。"],["对此玄休长叹息，","方知刘禅是庸才。"]]}
{"id":"7445649a6e","title":"三国门 吴后主","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["吴宫季主恣骄奢，","移尽江南百媚花。","一旦狂风江上起，","花随风散落谁家。"],"stanzas":[["吴宫季主恣骄奢，","移尽江南百媚花。"],["一旦狂风江上起，","花随风散落谁家。"]]}
{"id":"ac88da96c3","title":"三国门 王表","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["王表闻声莫见身，","吴中敬事甚君亲。","是知邦国将亡灭，","不听人臣听鬼神。"],"stanzas":[["王表闻声莫见身，","吴中敬事甚君亲。"],["是知邦国将亡灭，","不听人臣听鬼神。"]]}
{"id":"bd09b4422e","title":"三国门 鲁肃","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["轻财重义见英奇，","圣主贤臣是所依。","公瑾窘饥求子敬，","一言才起数船归。"],"stanzas":[["轻财重义见英奇，","圣主贤臣是所依。"],["公瑾窘饥求子敬，","一言才起数船归。"]]}
{"id":"f5b7983076","title":"晋门 晋武帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["汉贪金帛鬻公卿，","财赡羸军冀国宁。","晋武鬻官私室富，","是知犹不及桓灵。"],"stanzas":[["汉贪金帛鬻公卿，","财赡羸军冀国宁。"],["晋武鬻官私室富，","是知犹不及桓灵。"]]}
{"id":"ef95da302e","title":"晋门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["君人为理在安民，","论道求贤德自新。","经国远图无所问，","何曾言指一何神。"],"stanzas":[["君人为理在安民，","论道求贤德自新。"],["经国远图无所问，","何曾言指一何神。"]]}
{"id":"22b53ae00e","title":"晋门 惠帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蛙鸣堪笑问官私，","更劝饥人食肉糜。","蒙昧万机犹妇女，","寇戎安得不纷披。"],"stanzas":[["蛙鸣堪笑问官私，","更劝饥人食肉糜。"],["蒙昧万机犹妇女，","寇戎安得不纷披。"]]}
{"id":"6883a326d6","title":"晋门 贾后","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贾后甘为废戮人，","齐王还杀赵王伦。","一从天下无真主，","瓜割中原四百春。"],"stanzas":[["贾后甘为废戮人，","齐王还杀赵王伦。"],["一从天下无真主，","瓜割中原四百春。"]]}
{"id":"fb08423310","title":"晋门 怀帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["蕃汉戈矛遍九垓，","两京簪绂走黄埃。","刘聪大会平阳日，","遣帝行觞事可哀。"],"stanzas":[["蕃汉戈矛遍九垓，","两京簪绂走黄埃。"],["刘聪大会平阳日，","遣帝行觞事可哀。"]]}
{"id":"fb205115b6","title":"晋门 愍帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["耕牛吃尽大田荒，","二两黄金籴斗粮。","御粥又闻无曲屑，","不降胡虏奈饥肠。"],"stanzas":[["耕牛吃尽大田荒，","二两黄金籴斗粮。"],["御粥又闻无曲屑，","不降胡虏奈饥肠。"]]}
{"id":"fe3d1f80b3","title":"晋门 郭钦","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["谁疑忠谏郭钦言，","不逐戎夷出塞垣。","晋室既无明圣主，","果为胡虏乱中原。"],"stanzas":[["谁疑忠谏郭钦言，","不逐戎夷出塞垣。"],["晋室既无明圣主，","果为胡虏乱中原。"]]}
{"id":"0b2db8f9f7","title":"晋门 王夷甫","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["六合谁为辅弼臣，","八风昏处尽胡尘。","是知济弱扶倾术，","不属高谈虚论人。"],"stanzas":[["六合谁为辅弼臣，","八风昏处尽胡尘。"],["是知济弱扶倾术，","不属高谈虚论人。"]]}
{"id":"4eb48de932","title":"晋门 王茂弘","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["韩魏荆扬日岂堪，","胡风看欲过江南。","中原一片生灵血，","谁秉王纲色不慙。"],"stanzas":[["韩魏荆扬日岂堪，","胡风看欲过江南。"],["中原一片生灵血，","谁秉王纲色不慙。"]]}
{"id":"b5376f201c","title":"晋门 吴隐之","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["闻说贪泉近郁林，","隐之今日得深斟。","徒言滴水能穿石，","其那坚贞匪石心。"],"stanzas":[["闻说贪泉近郁林，","隐之今日得深斟。"],["徒言滴水能穿石，","其那坚贞匪石心。"]]}
{"id":"2bcc62bd15","title":"晋门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["贪泉何处是泉源，","只在灵台一点间。","必也心源元自有，","此泉何必在江山。"],"stanzas":[["贪泉何处是泉源，","只在灵台一点间。"],["必也心源元自有，","此泉何必在江山。"]]}
{"id":"c12b3001c2","title":"六朝门 前赵刘聪","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["戎羯谁令识善言，","刑将不舍遽能原。","垂成却罢凤仪殿，","仍改逍遥纳谏园。"],"stanzas":[["戎羯谁令识善言，","刑将不舍遽能原。"],["垂成却罢凤仪殿，","仍改逍遥纳谏园。"]]}
{"id":"92794c0bc1","title":"六朝门 前凉张轨","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["官从主簿至专征，","谁遣凉王破赵名。","益信用贤由拔擢，","穰苴不是将家生。"],"stanzas":[["官从主簿至专征，","谁遣凉王破赵名。"],["益信用贤由拔擢，","穰苴不是将家生。"]]}
{"id":"e5fd7b100b","title":"六朝门 后魏武帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["太武南征似卷蓬，","徐阳兖蔡杀皆空。","从来吊伐宁如此，","千里无烟血草红。"],"stanzas":[["太武南征似卷蓬，","徐阳兖蔡杀皆空。"],["从来吊伐宁如此，","千里无烟血草红。"]]}
{"id":"403ac552d0","title":"六朝门 三废帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["明庄节闵并罹殃，","命在朱高二悖王。","已叹一年三易换，","更嗟殴辱下东廊。"],"stanzas":[["明庄节闵并罹殃，","命在朱高二悖王。"],["已叹一年三易换，","更嗟殴辱下东廊。"]]}
{"id":"6352b90524","title":"六朝门 苻坚","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["百万南征几马归，","叛亡如猬亦何悲。","宾擒敌国诸戎主，","更遣权兵过在谁。"],"stanzas":[["百万南征几马归，","叛亡如猬亦何悲。"],["宾擒敌国诸戎主，","更遣权兵过在谁。"]]}
{"id":"5d8d451b97","title":"六朝门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["空知勇锐不知兵，","困兽孤军未可轻。","安有长驱百余万，","身驰几旅欲先征。"],"stanzas":[["空知勇锐不知兵，","困兽孤军未可轻。"],["安有长驱百余万，","身驰几旅欲先征。"]]}
{"id":"230f9c9ff1","title":"六朝门 又吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["水影星光怪异多，","不思修德事干戈。","无谋拒谏仍轻敌，","国破身擒将奈何。"],"stanzas":[["水影星光怪异多，","不思修德事干戈。"],["无谋拒谏仍轻敌，","国破身擒将奈何。"]]}
{"id":"cdb20b85a0","title":"六朝门 宋武帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["栖栖老楚未遭时，","债主凭陵似迫危。","人杰既为王谧识，","刁逵诛斩独何悲。"],"stanzas":[["栖栖老楚未遭时，","债主凭陵似迫危。"],["人杰既为王谧识，","刁逵诛斩独何悲。"]]}
{"id":"979b0c89bf","title":"六朝门 二废帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["肆意荒狂杀不辜，","方嗟废帝又苍梧。","自言威震为英武，","肯虑湘东与玉夫。"],"stanzas":[["肆意荒狂杀不辜，","方嗟废帝又苍梧。"],["自言威震为英武，","肯虑湘东与玉夫。"]]}
{"id":"79a42c2b4e","title":"六朝门 齐废帝东昏侯","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["定策谁扶捕鼠儿，","不忧萧衍畏潘妃。","长围既合刀临项，","犹惜金钱对落晖。"],"stanzas":[["定策谁扶捕鼠儿，","不忧萧衍畏潘妃。"],["长围既合刀临项，","犹惜金钱对落晖。"]]}
{"id":"a4ff999ae0","title":"六朝门 梁武帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["梁武年高厌六龙，","繁华声色尽归空。","不求贤德追尧舜，","翻作忧囚一病翁。"],"stanzas":[["梁武年高厌六龙，","繁华声色尽归空。"],["不求贤德追尧舜，","翻作忧囚一病翁。"]]}
{"id":"14077e5d18","title":"六朝门 再吟","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["兴亡何故遽环回，","汤纣身为事可哀。","莫是自长嫌胜己，","蔽贤犹执匹夫才。"],"stanzas":[["兴亡何故遽环回，","汤纣身为事可哀。"],["莫是自长嫌胜己，","蔽贤犹执匹夫才。"]]}
{"id":"e29678dba2","title":"六朝门 简文帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["救兵方至强抽军，","与贼开城是简文。","曲项琵琶催酒处，","不图为乐向谁云。"],"stanzas":[["救兵方至强抽军，","与贼开城是简文。"],["曲项琵琶催酒处，","不图为乐向谁云。"]]}
{"id":"0b0f4bdcd0","title":"六朝门 元帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["木栅江城困魏军，","王褒横议遏谋臣。","宾降未免俱为戮，","一死安能谢益仁。"],"stanzas":[["木栅江城困魏军，","王褒横议遏谋臣。"],["宾降未免俱为戮，","一死安能谢益仁。"]]}
{"id":"9e352a6a6b","title":"六朝门 谢举","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["叛奴逃数岂堪留，","忠节曾无肯到头。","朱异早能同远见，","青衫宁假帝登楼。"],"stanzas":[["叛奴逃数岂堪留，","忠节曾无肯到头。"],["朱异早能同远见，","青衫宁假帝登楼。"]]}
{"id":"30184c7e17","title":"六朝门 朱异","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["徒览儒书不学兵，","彦和虚得不廉名。","四郊多垒犹相罪，","国破将何谢太清。"],"stanzas":[["徒览儒书不学兵，","彦和虚得不廉名。"],["四郊多垒犹相罪，","国破将何谢太清。"]]}
{"id":"a252403172","title":"六朝门 傅昭","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["为政残苛兽亦饥，","除饥机在养疲羸。","人能善政兽何暴，","焉用劳人以槛为。"],"stanzas":[["为政残苛兽亦饥，","除饥机在养疲羸。"],["人能善政兽何暴，","焉用劳人以槛为。"]]}
{"id":"9611e32598","title":"六朝门 宣帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["宣帝骄奢恣所为，","后宫升降略无时。","乘危自有妻公在，","安许鸾凰是尉迟。"],"stanzas":[["宣帝骄奢恣所为，","后宫升降略无时。"],["乘危自有妻公在，","安许鸾凰是尉迟。"]]}
{"id":"dd2581b7b0","title":"六朝门 李集","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["忠谏能坚信正臣，","三沈三屈竟何云。","每沈良久方能语，","及语还呼桀纣君。"],"stanzas":[["忠谏能坚信正臣，","三沈三屈竟何云。"],["每沈良久方能语，","及语还呼桀纣君。"]]}
{"id":"5fd03ce94b","title":"隋门 隋文帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["孤儿寡妇忍同欺，","辅政刚教篡夺为。","矫诏必能疎昉译，","直臣诚合重颜仪。"],"stanzas":[["孤儿寡妇忍同欺，","辅政刚教篡夺为。"],["矫诏必能疎昉译，","直臣诚合重颜仪。"]]}
{"id":"b8f4c5c6ef","title":"隋门 独孤后","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["腹生奚强有亲疎，","怜者为贤弃者愚。","储贰不遭谗搆死，","隋亡宁便在江都。"],"stanzas":[["腹生奚强有亲疎，","怜者为贤弃者愚。"],["储贰不遭谗搆死，","隋亡宁便在江都。"]]}
{"id":"e5cca9f444","title":"隋门 炀帝","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["拒谏劳兵作祸基，","穷奢极武向戎夷。","兆人疲弊不堪命，","天下嗷嗷新主资。"],"stanzas":[["拒谏劳兵作祸基，","穷奢极武向戎夷。"],["兆人疲弊不堪命，","天下嗷嗷新主资。"]]}
{"id":"87e4cd164e","title":"隋门 贺若弼","author":"周昙","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["破敌江军意气豪，","请除倾国斩妖娆。","红绡忍染娇春雪，","瞪目看行切玉刀。"],"stanzas":[["破敌江军意气豪，","请除倾国斩妖娆。"],["红绡忍染娇春雪，","瞪目看行切玉刀。"]]}
{"id":"a1ad734b39","title":"上清辞五首 一","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["入海浮生汗漫秋，","紫皇高宴五云楼。","霓裳曲罢天风起，","吹散仙香满十洲。"],"stanzas":[["入海浮生汗漫秋，","紫皇高宴五云楼。"],["霓裳曲罢天风起，","吹散仙香满十洲。"]]}
{"id":"28805bd3df","title":"上清辞五首 二","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["楼鏁彤霞地绝尘，","碧桃花发九天春。","东皇近日慵游宴，","闲煞瑶池五色麟。"],"stanzas":[["楼鏁彤霞地绝尘，","碧桃花发九天春。"],["东皇近日慵游宴，","闲煞瑶池五色麟。"]]}
{"id":"1009be9c6c","title":"上清辞五首 三","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["上清仙路有丹梯，","影响行人到即迷。","不会无端个渔父，","阿谁教入武陵溪。"],"stanzas":[["上清仙路有丹梯，","影响行人到即迷。"],["不会无端个渔父，","阿谁教入武陵溪。"]]}
{"id":"b2bef09617","title":"上清辞五首 四","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["本来方朔是真仙，","偶别丹台未得还。","何事玉皇消息晚，","忍教顦顇向人间。"],"stanzas":[["本来方朔是真仙，","偶别丹台未得还。"],["何事玉皇消息晚，","忍教顦顇向人间。"]]}
{"id":"e8cbc07d81","title":"上清辞五首 五","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["新拜天官上玉都，","紫皇亲授五灵符。","群仙个个来相问，","人世风光似此无。"],"stanzas":[["新拜天官上玉都，","紫皇亲授五灵符。"],["群仙个个来相问，","人世风光似此无。"]]}
{"id":"55496025be","title":"读三国志","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["有国由来在得贤，","莫言兴废是循环。","武侯星落周瑜死，","平蜀降吴似等闲。"],"stanzas":[["有国由来在得贤，","莫言兴废是循环。"],["武侯星落周瑜死，","平蜀降吴似等闲。"]]}
{"id":"709ca2fada","title":"山舍南溪小桃花","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["一树繁英夺眼红，","开时先合占东风。","可怜地僻无人赏，","抛掷深山乱木中。"],"stanzas":[["一树繁英夺眼红，","开时先合占东风。"],["可怜地僻无人赏，","抛掷深山乱木中。"]]}
{"id":"65969f60f2","title":"春行遇雨","author":"李九龄","dynasty":"唐","genre":"诗","collection":"全唐诗","lines":["夹路轻风撼柳条，","雨侵春态动无憀。","采香陌上谁家女，","湿损钗头翡翠翘。"],"stanzas":[["夹路轻风撼柳条，","雨侵春态动无憀。"],["采香陌上谁家女，","湿损钗头翡翠翘。"]]}
