{"id":"b29885b3bf","title":"阮郎归","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"阮郎归","lines":["去年今日落花时。","依前又见伊。","淡匀双脸浅匀眉。","青衫透玉肌。","才会面，","便相思。","相思无尽期。","这回相见好相知。","相知已是迟。"],"stanzas":[["去年今日落花时。"],["依前又见伊。"],["淡匀双脸浅匀眉。"],["青衫透玉肌。"],["才会面，","便相思。"],["相思无尽期。"],["这回相见好相知。"],["相知已是迟。"]]}
{"id":"2ae5321207","title":"阮郎归","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"阮郎归","lines":["玉肌花脸柳腰肢。","红妆浅黛眉。","翠鬟斜亸语声低。","娇羞云雨时。","伊怜我，","我怜伊。","心儿与眼儿。","绣屏深处说深期。","幽情谁得知。"],"stanzas":[["玉肌花脸柳腰肢。"],["红妆浅黛眉。"],["翠鬟斜亸语声低。"],["娇羞云雨时。"],["伊怜我，","我怜伊。"],["心儿与眼儿。"],["绣屏深处说深期。"],["幽情谁得知。"]]}
{"id":"c6837c6fae","title":"怨春郎","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"怨春郎","lines":["为伊家，","终日闷。","受尽恓惶谁问。","不知不觉上心头，","悄一霎身心，","顿也没处顿。","恼愁肠，","成寸寸。","已恁莫把人萦损。","奈每每人前道著伊，","空把相思泪眼和衣揾。"],"stanzas":[["为伊家，","终日闷。"],["受尽恓惶谁问。"],["不知不觉上心头，","悄一霎身心，","顿也没处顿。"],["恼愁肠，","成寸寸。"],["已恁莫把人萦损。"],["奈每每人前道著伊，","空把相思泪眼和衣揾。"]]}
{"id":"458e74e717","title":"滴滴金","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"滴滴金","lines":["尊前一把横波溜。","彼此心儿有。","曲屏深幌解香罗，","花灯微透。","偎人欲语眉先皱。","红玉困春酒。","为问鸳衾这回后。","几时重又。"],"stanzas":[["尊前一把横波溜。"],["彼此心儿有。"],["曲屏深幌解香罗，","花灯微透。"],["偎人欲语眉先皱。"],["红玉困春酒。"],["为问鸳衾这回后。"],["几时重又。"]]}
{"id":"9c696c1666","title":"卜算子","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"卜算子","lines":["极得醉中眠，","迤逦翻成病。","莫是前生负你来，","今世里、教孤冷。","言约全无定。","是谁先薄幸。","不惯孤眠惯成双，","奈奴子、心肠硬。"],"stanzas":[["极得醉中眠，","迤逦翻成病。"],["莫是前生负你来，","今世里、教孤冷。"],["言约全无定。"],["是谁先薄幸。"],["不惯孤眠惯成双，","奈奴子、心肠硬。"]]}
{"id":"52de3f7351","title":"感庭秋・撼庭秋","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"感庭秋・撼庭秋","lines":["红笺封了还重拆。","这添追忆。","且教伊见我，","别来翠减香销端的。","渌波平远，","暮山重叠，","算难凭鳞翼。","倚危楼极目，","无情细草长天色。"],"stanzas":[["红笺封了还重拆。"],["这添追忆。"],["且教伊见我，","别来翠减香销端的。"],["渌波平远，","暮山重叠，","算难凭鳞翼。"],["倚危楼极目，","无情细草长天色。"]]}
{"id":"24d2e07f75","title":"满路花・促拍满路花","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满路花・促拍满路花","lines":["铜荷融烛泪，","金兽啮扉环。","兰堂春夜疑，","惜更残。","落花风雨，","向晓作轻寒。","金龟朝早，","香衾馀暖，","殢娇由自慵眠。","小鬟无事须来唤，","呵破点唇檀。","回身还、却背屏山。","春禽飞下，","帘外日三竿。","起来云鬓乱，","不妆红粉，","下阶且上秋千。"],"stanzas":[["铜荷融烛泪，","金兽啮扉环。"],["兰堂春夜疑，","惜更残。"],["落花风雨，","向晓作轻寒。"],["金龟朝早，","香衾馀暖，","殢娇由自慵眠。"],["小鬟无事须来唤，","呵破点唇檀。"],["回身还、却背屏山。"],["春禽飞下，","帘外日三竿。"],["起来云鬓乱，","不妆红粉，","下阶且上秋千。"]]}
{"id":"2a528b2092","title":"好女儿令・好女儿","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"好女儿令・好女儿","lines":["眼细眉长。","宫样梳妆。","靸鞋儿走向花下立著。","一身绣出，","两同心字，","浅浅金黄。","早是肌肤轻渺，","抱著了、暖仍香。","姿姿媚媚端正好，","怎教人别后，","从头仔细，","断得思量。"],"stanzas":[["眼细眉长。"],["宫样梳妆。"],["靸鞋儿走向花下立著。"],["一身绣出，","两同心字，","浅浅金黄。"],["早是肌肤轻渺，","抱著了、暖仍香。"],["姿姿媚媚端正好，","怎教人别后，","从头仔细，","断得思量。"]]}
{"id":"2bb7399494","title":"南乡子","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"南乡子","lines":["浅浅画双眉。","取次梳妆也便宜。","洒着胭脂红扑面，","须知。","更有何人得似伊。","宝帐烛残时。","好个温柔模样儿。","月里仙郎清似玉，","相期。","些子精神更与谁。"],"stanzas":[["浅浅画双眉。"],["取次梳妆也便宜。"],["洒着胭脂红扑面，","须知。"],["更有何人得似伊。"],["宝帐烛残时。"],["好个温柔模样儿。"],["月里仙郎清似玉，","相期。"],["些子精神更与谁。"]]}
{"id":"df24db0912","title":"南乡子","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"南乡子","lines":["好个人人，","深点唇儿淡抹腮。","花下相逢、忙走怕人猜。","遗下弓弓小绣鞋。","刬袜重来。","半亸乌云金凤钗。","行笑行行连抱得，","相挨。","一向娇痴不下怀。"],"stanzas":[["好个人人，","深点唇儿淡抹腮。"],["花下相逢、忙走怕人猜。"],["遗下弓弓小绣鞋。"],["刬袜重来。"],["半亸乌云金凤钗。"],["行笑行行连抱得，","相挨。"],["一向娇痴不下怀。"]]}
{"id":"ed9a25eda9","title":"踏莎行","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行","lines":["碧藓回廊，","绿杨深院。","偷期夜入帘犹卷。","照人无奈月华明，","潜身却恨花深浅。","密约如沈，","前欢未便。","看看掷尽金壶箭。","阑干敲遍不应人，","分明帘下闻裁剪。"],"stanzas":[["碧藓回廊，","绿杨深院。"],["偷期夜入帘犹卷。"],["照人无奈月华明，","潜身却恨花深浅。"],["密约如沈，","前欢未便。"],["看看掷尽金壶箭。"],["阑干敲遍不应人，","分明帘下闻裁剪。"]]}
{"id":"d9ebe0e869","title":"踏莎行","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行","lines":["云母屏低，","流苏帐小。","矮床薄被秋将晓。","乍凉天气未寒时，","平明窗外闻啼鸟。","困殢榴花，","香添蕙草。","佳期须及朱颜好。","莫言多病为多情，","此身甘向情中老。"],"stanzas":[["云母屏低，","流苏帐小。"],["矮床薄被秋将晓。"],["乍凉天气未寒时，","平明窗外闻啼鸟。"],["困殢榴花，","香添蕙草。"],["佳期须及朱颜好。"],["莫言多病为多情，","此身甘向情中老。"]]}
{"id":"4830ce6d6d","title":"诉衷情","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"诉衷情","lines":["歌时眉黛舞时腰。","无处不娇饶。","初剪菊、欲登高。","天气怯鲛绡。","紫丝障，","绿杨桥。","路迢迢。","酒阑歌罢，","一度归时，","一度魂消。"],"stanzas":[["歌时眉黛舞时腰。"],["无处不娇饶。"],["初剪菊、欲登高。"],["天气怯鲛绡。"],["紫丝障，","绿杨桥。"],["路迢迢。"],["酒阑歌罢，","一度归时，","一度魂消。"]]}
{"id":"f85686168f","title":"诉衷情","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"诉衷情","lines":["离怀酒病两忡忡。","倚枕梦无踪。","可怜有人今夜，","胆小怯房空。","杨柳绿，","杏梢红。","负春风。","迢迢别恨，","脉脉归心，","付与征鸿。"],"stanzas":[["离怀酒病两忡忡。"],["倚枕梦无踪。"],["可怜有人今夜，","胆小怯房空。"],["杨柳绿，","杏梢红。"],["负春风。"],["迢迢别恨，","脉脉归心，","付与征鸿。"]]}
{"id":"6a24a6a00b","title":"恨春迟","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"恨春迟","lines":["欲借江梅荐饮。","望陇驿、音息沈沈。","住在柳州东，","彼此相思，","梦回云去难寻。","归燕来时花期浸。","淡月坠、将晓还阴。","争奈多情易感，","风信无凭，","如何消遣初心。"],"stanzas":[["欲借江梅荐饮。"],["望陇驿、音息沈沈。"],["住在柳州东，","彼此相思，","梦回云去难寻。"],["归燕来时花期浸。"],["淡月坠、将晓还阴。"],["争奈多情易感，","风信无凭，","如何消遣初心。"]]}
{"id":"97ace73437","title":"盐角儿","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"盐角儿","lines":["增之太长，","减之太短，","出群风格。","施朱太赤，","施粉太白，","倾城颜色。","慧多多，","娇的的。","天付与、教谁怜惜。","除非我、偎著抱著，","更有何人消得。"],"stanzas":[["增之太长，","减之太短，","出群风格。"],["施朱太赤，","施粉太白，","倾城颜色。"],["慧多多，","娇的的。"],["天付与、教谁怜惜。"],["除非我、偎著抱著，","更有何人消得。"]]}
{"id":"7f6fb1772e","title":"盐角儿","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"盐角儿","lines":["人生最苦，","少年不得，","鸳帏相守。","西风时节，","那堪话别，","双蛾频皱。","暗消魂，","重回首。","奈心儿里、彼此皆有。","后时我、两个相见，","管取一双清瘦。"],"stanzas":[["人生最苦，","少年不得，","鸳帏相守。"],["西风时节，","那堪话别，","双蛾频皱。"],["暗消魂，","重回首。"],["奈心儿里、彼此皆有。"],["后时我、两个相见，","管取一双清瘦。"]]}
{"id":"81d6ede5af","title":"忆秦娥","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"忆秦娥","lines":["十五六，","脱罗裳，","长恁黛眉蹙。","红玉暖，","入人怀，","春困熟。","展香裀，","帐前明画烛。","眼波长，","斜浸鬓云绿。","看不足。","苦残宵、更漏促。"],"stanzas":[["十五六，","脱罗裳，","长恁黛眉蹙。"],["红玉暖，","入人怀，","春困熟。"],["展香裀，","帐前明画烛。"],["眼波长，","斜浸鬓云绿。"],["看不足。"],["苦残宵、更漏促。"]]}
{"id":"1207cab59c","title":"少年游","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"少年游","lines":["绿云双亸插金翘。","年纪正妖饶。","汉妃束素，","小蛮垂柳，","都占洛城腰。","锦屏春过衣初减，","香雪暖凝消。","试问当筵眼波恨，","滴滴为谁娇。"],"stanzas":[["绿云双亸插金翘。"],["年纪正妖饶。"],["汉妃束素，","小蛮垂柳，","都占洛城腰。"],["锦屏春过衣初减，","香雪暖凝消。"],["试问当筵眼波恨，","滴滴为谁娇。"]]}
{"id":"1b6c4d3242","title":"踏莎行慢","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行慢","lines":["独自上孤舟。","倚危樯目断。","难成暮雨，","更朝云散。","凉劲残叶乱。","新月照、澄波浅。","今夜里，","厌厌离绪难销遣。","强来就枕，","灯残漏永，","合相思眼。","分明梦见如花面。","依前是、旧庭院。","新月照，","罗幕挂，","珠帘卷。","渐向晓，","脉然睡觉如天远。"],"stanzas":[["独自上孤舟。"],["倚危樯目断。"],["难成暮雨，","更朝云散。"],["凉劲残叶乱。"],["新月照、澄波浅。"],["今夜里，","厌厌离绪难销遣。"],["强来就枕，","灯残漏永，","合相思眼。"],["分明梦见如花面。"],["依前是、旧庭院。"],["新月照，","罗幕挂，","珠帘卷。"],["渐向晓，","脉然睡觉如天远。"]]}
{"id":"147e2d20cb","title":"蕙香囊・鹊桥仙","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蕙香囊・鹊桥仙","lines":["身作琵琶，","调全宫羽，","佳人自然用意。","宝檀槽在雪胸前，","倚香脐、横枕琼臂。","组带金钩，","背垂红绶，","纤指转弦韵细。","愿伊只恁拨梁州，","且多时、得在怀里。"],"stanzas":[["身作琵琶，","调全宫羽，","佳人自然用意。"],["宝檀槽在雪胸前，","倚香脐、横枕琼臂。"],["组带金钩，","背垂红绶，","纤指转弦韵细。"],["愿伊只恁拨梁州，","且多时、得在怀里。"]]}
{"id":"f6a535cb6b","title":"玉楼春","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"玉楼春","lines":["艳冶风情天与措。","清瘦肌肤冰雪妒。","百年心事一宵同，","愁听鸡声窗外度。","信阻青禽云雨暮。","海月空惊人两处。","强将离恨倚江楼，","江水不能流恨去。"],"stanzas":[["艳冶风情天与措。"],["清瘦肌肤冰雪妒。"],["百年心事一宵同，","愁听鸡声窗外度。"],["信阻青禽云雨暮。"],["海月空惊人两处。"],["强将离恨倚江楼，","江水不能流恨去。"]]}
{"id":"fa801dc1ee","title":"玉楼春","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"玉楼春","lines":["半辐霜绡亲手剪。","香染青蛾和泪卷。","画时横接媚霞长，","印处双沾愁黛浅。","当时付我情何限。","欲使妆痕长在眼。","一回忆著一拈看，","便似花前重见面。"],"stanzas":[["半辐霜绡亲手剪。"],["香染青蛾和泪卷。"],["画时横接媚霞长，","印处双沾愁黛浅。"],["当时付我情何限。"],["欲使妆痕长在眼。"],["一回忆著一拈看，","便似花前重见面。"]]}
{"id":"60045584ae","title":"玉楼春","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"玉楼春","lines":["红楼昨夜相将饮。","月近珠帘花近枕。","银缸照客酒方酣，","玉漏催人街已禁。","晚潮去棹浮清浸。","古岸平芜萧索甚。","大都薄宦足离愁，","不放双鸳长恁恁。"],"stanzas":[["红楼昨夜相将饮。"],["月近珠帘花近枕。"],["银缸照客酒方酣，","玉漏催人街已禁。"],["晚潮去棹浮清浸。"],["古岸平芜萧索甚。"],["大都薄宦足离愁，","不放双鸳长恁恁。"]]}
{"id":"c84984682e","title":"玉楼春","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"玉楼春","lines":["金雀双鬟年纪小。","学画蛾眉红淡扫。","尽人言语尽人怜，","不解此情惟解笑。","稳着舞衣行动俏。","走向绮筵呈曲妙。","刘郎大有惜花心，","只恨寻花来较早。"],"stanzas":[["金雀双鬟年纪小。"],["学画蛾眉红淡扫。"],["尽人言语尽人怜，","不解此情惟解笑。"],["稳着舞衣行动俏。"],["走向绮筵呈曲妙。"],["刘郎大有惜花心，","只恨寻花来较早。"]]}
{"id":"aa76313573","title":"玉楼春","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"玉楼春","lines":["夜来枕上争闲事。","推倒屏山褰绣被。","尽人求守不应人，","走向碧纱窗下睡。","直到起来由自殢。","向道夜来真个醉。","大家恶发大家休，","毕竟到头谁不是。"],"stanzas":[["夜来枕上争闲事。"],["推倒屏山褰绣被。"],["尽人求守不应人，","走向碧纱窗下睡。"],["直到起来由自殢。"],["向道夜来真个醉。"],["大家恶发大家休，","毕竟到头谁不是。"]]}
{"id":"d1d2fdf3a4","title":"减字木兰花","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"减字木兰花","lines":["去年残腊。","曾折梅花相对插。","人面而今。","空有花开无处寻。","天天不远。","把酒拈花重发愿。","愿得和伊。","偎雪眠香似旧时。"],"stanzas":[["去年残腊。"],["曾折梅花相对插。"],["人面而今。"],["空有花开无处寻。"],["天天不远。"],["把酒拈花重发愿。"],["愿得和伊。"],["偎雪眠香似旧时。"]]}
{"id":"4031c31ad2","title":"减字木兰花","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"减字木兰花","lines":["年来方寸。","十日幽欢千日恨。","未会此情。","白尽人头可得平。","区区堪比。","水趁浮萍风趁水。","试望瑶京。","芳草随人上古城。"],"stanzas":[["年来方寸。"],["十日幽欢千日恨。"],["未会此情。"],["白尽人头可得平。"],["区区堪比。"],["水趁浮萍风趁水。"],["试望瑶京。"],["芳草随人上古城。"]]}
{"id":"5757e45da2","title":"迎春乐","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"迎春乐","lines":["薄纱衫子裙腰匝。","步轻轻、小罗靸。","人前爱把眼儿札。","香汗透、胭脂蜡。","良夜永、幽期欢则洽。","约重会、玉纤频插。","执手临归，","犹且更待留时霎。"],"stanzas":[["薄纱衫子裙腰匝。"],["步轻轻、小罗靸。"],["人前爱把眼儿札。"],["香汗透、胭脂蜡。"],["良夜永、幽期欢则洽。"],["约重会、玉纤频插。"],["执手临归，","犹且更待留时霎。"]]}
{"id":"194c304ad1","title":"一落索","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"一落索","lines":["小桃风撼香红碎。","满帘笼花气。","看花何事却成愁，","悄不会、春风意。","窗在梧桐叶底。","更黄昏雨细。","枕前前事上心来，","独自个、怎生睡。"],"stanzas":[["小桃风撼香红碎。"],["满帘笼花气。"],["看花何事却成愁，","悄不会、春风意。"],["窗在梧桐叶底。"],["更黄昏雨细。"],["枕前前事上心来，","独自个、怎生睡。"]]}
{"id":"0e55b4abcc","title":"夜行船","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"夜行船","lines":["闲把鸳衾横枕。","损眉尖、泪痕红沁。","花时良夜不归来，","忍频听、漏移清禁。","一饷无言都未寝。","忆当初、是谁先恁。","及至如今，","教人成病，","风流万般徒甚。"],"stanzas":[["闲把鸳衾横枕。"],["损眉尖、泪痕红沁。"],["花时良夜不归来，","忍频听、漏移清禁。"],["一饷无言都未寝。"],["忆当初、是谁先恁。"],["及至如今，","教人成病，","风流万般徒甚。"]]}
{"id":"57a4c8c564","title":"夜行船","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"夜行船","lines":["轻捧香腮低枕。","眼波媚、向人相浸。","佯娇佯醉索如今，","这风情、怎教人禁。","却与和衣推未寝。","低声地、告人休恁。","月夕花朝，","不成虚过，","芳年嫁君徒甚。"],"stanzas":[["轻捧香腮低枕。"],["眼波媚、向人相浸。"],["佯娇佯醉索如今，","这风情、怎教人禁。"],["却与和衣推未寝。"],["低声地、告人休恁。"],["月夕花朝，","不成虚过，","芳年嫁君徒甚。"]]}
{"id":"910da4204b","title":"望江南・忆江南","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"望江南・忆江南","lines":["江南柳，","花柳两相柔。","花片落时粘酒盏，","柳条低处拂人头。","各自是风流。","江南月，","如镜复如钩。","似镜不侵红粉面，","似钩不挂画帘头。","长是照离愁。"],"stanzas":[["江南柳，","花柳两相柔。"],["花片落时粘酒盏，","柳条低处拂人头。"],["各自是风流。"],["江南月，","如镜复如钩。"],["似镜不侵红粉面，","似钩不挂画帘头。"],["长是照离愁。"]]}
{"id":"a2c6488529","title":"宴瑶池・越江吟","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"宴瑶池・越江吟","lines":["恋眼哝心终未改。","向意间长在。","都缘为、颜色殊常，","见馀花、尽无心爱。","都为是风流㬠。","至他人、强来厮壤。","从今后、若得相逢，","绣帏里、痛惜娇态。"],"stanzas":[["恋眼哝心终未改。"],["向意间长在。"],["都缘为、颜色殊常，","见馀花、尽无心爱。"],["都为是风流㬠。"],["至他人、强来厮壤。"],["从今后、若得相逢，","绣帏里、痛惜娇态。"]]}
{"id":"70a9e0acd5","title":"解仙佩","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"解仙佩","lines":["有个人人牵系。","泪成痕、滴尽罗衣。","问海约山盟何时。","镇教人、目断魂飞。","梦里似偎人睡。","肌肤依旧骨香腻。","觉来但堆鸳被。","想忡忡、那里争知。"],"stanzas":[["有个人人牵系。"],["泪成痕、滴尽罗衣。"],["问海约山盟何时。"],["镇教人、目断魂飞。"],["梦里似偎人睡。"],["肌肤依旧骨香腻。"],["觉来但堆鸳被。"],["想忡忡、那里争知。"]]}
{"id":"c91ec88aa4","title":"渔家傲","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"渔家傲","lines":["战胜归来飞捷奏。","倾贺酒。","玉阶遥献南山寿。"],"stanzas":[["战胜归来飞捷奏。"],["倾贺酒。"],["玉阶遥献南山寿。"]]}
{"id":"6db9dd37c8","title":"少年游","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"少年游","lines":["阑干十二独凭春。","晴碧远连云。","千里万里，","二月三月，","行色苦愁人。","谢家池上，","江淹浦畔，","吟魄与离魂。","那堪疏雨滴黄昏。","更特地、忆王孙。"],"stanzas":[["阑干十二独凭春。"],["晴碧远连云。"],["千里万里，","二月三月，","行色苦愁人。"],["谢家池上，","江淹浦畔，","吟魄与离魂。"],["那堪疏雨滴黄昏。"],["更特地、忆王孙。"]]}
{"id":"e46548a0d7","title":"桃源忆故人","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"桃源忆故人","lines":["碧纱影弄东风晓。","一夜海棠开了。","枝上数声啼鸟。","妆点愁多少。","妒云恨雨腰支袅。","眉黛不忺重扫。","薄幸不来春老。","羞带宜男草。"],"stanzas":[["碧纱影弄东风晓。"],["一夜海棠开了。"],["枝上数声啼鸟。"],["妆点愁多少。"],["妒云恨雨腰支袅。"],["眉黛不忺重扫。"],["薄幸不来春老。"],["羞带宜男草。"]]}
{"id":"4a2fb1a1bc","title":"阮郎归","author":"欧阳修","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"阮郎归","lines":["雪霜林际见依稀。","清香已暗期。","前村已遍倚南枝。","群花犹未知。","情似旧，","赏休迟。","看看陇上吹。","便从今日赏芳菲。","韶华取次归。"],"stanzas":[["雪霜林际见依稀。"],["清香已暗期。"],["前村已遍倚南枝。"],["群花犹未知。"],["情似旧，","赏休迟。"],["看看陇上吹。"],["便从今日赏芳菲。"],["韶华取次归。"]]}
