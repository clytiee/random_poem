{"id":"a052f947b3","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["征人去日殷勤嘱，","莫负心期。","寒雁来时。","第一传书慰别离。","轻春织就机中素，","泪墨题诗。","欲寄相思。","日日高楼看雁飞。"],"stanzas":[["征人去日殷勤嘱，","莫负心期。"],["寒雁来时。"],["第一传书慰别离。"],["轻春织就机中素，","泪墨题诗。"],["欲寄相思。"],["日日高楼看雁飞。"]]}
{"id":"14d5e13592","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["花时恼得琼枝瘦，","半被残香。","睡损梅妆。","红泪今春第一行。","风流笑伴相逢处，","白马游缰。","共折垂杨。","手拈芳条说夜长。"],"stanzas":[["花时恼得琼枝瘦，","半被残香。"],["睡损梅妆。"],["红泪今春第一行。"],["风流笑伴相逢处，","白马游缰。"],["共折垂杨。"],["手拈芳条说夜长。"]]}
{"id":"ae8809073a","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["春风不负年年信，","长趁花期。","小锦堂西。","红杏初开第一枝。","碧箫度曲留人醉，","昨夜归迟。","短恨凭谁。","莺语殷勤月落时。"],"stanzas":[["春风不负年年信，","长趁花期。"],["小锦堂西。"],["红杏初开第一枝。"],["碧箫度曲留人醉，","昨夜归迟。"],["短恨凭谁。"],["莺语殷勤月落时。"]]}
{"id":"719a851a88","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["秋来更觉消魂苦，","小字还稀。","坐想行思。","怎得相看似旧时。","南楼把手凭肩处，","风月应知。","别后除非。","梦里时时得见伊。"],"stanzas":[["秋来更觉消魂苦，","小字还稀。"],["坐想行思。"],["怎得相看似旧时。"],["南楼把手凭肩处，","风月应知。"],["别后除非。"],["梦里时时得见伊。"]]}
{"id":"e173e177e6","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["谁将一点凄凉意，","送入低眉。","画箔闲垂。","多是今宵得睡迟。","夜痕记尽窗间月，","曾误心期。","准拟相思。","还是窗间记月时。"],"stanzas":[["谁将一点凄凉意，","送入低眉。"],["画箔闲垂。"],["多是今宵得睡迟。"],["夜痕记尽窗间月，","曾误心期。"],["准拟相思。"],["还是窗间记月时。"]]}
{"id":"d459225377","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["宜春苑外楼堪倚，","雪意方浓。","雁影冥蒙。","正共银屏小景同。","可无人解相思处，","昨夜东风。","梅蕊应红。","知在谁家锦字中。"],"stanzas":[["宜春苑外楼堪倚，","雪意方浓。"],["雁影冥蒙。"],["正共银屏小景同。"],["可无人解相思处，","昨夜东风。"],["梅蕊应红。"],["知在谁家锦字中。"]]}
{"id":"8c9e2e6a7c","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["白莲池上当时月，","今夜重圆。","曲水兰船。","忆伴飞琼看月眠。","黄花绿酒分携后，","泪湿吟笺。","旧事年年。","时节南湖又采莲。"],"stanzas":[["白莲池上当时月，","今夜重圆。"],["曲水兰船。"],["忆伴飞琼看月眠。"],["黄花绿酒分携后，","泪湿吟笺。"],["旧事年年。"],["时节南湖又采莲。"]]}
{"id":"5cf0eed646","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["高吟烂醉淮西月，","诗酒相留。","明日归舟。","碧藕花中醉过秋。","文姬赠别双团扇，","自写银钩。","散尽离愁。","携得清风出画楼。"],"stanzas":[["高吟烂醉淮西月，","诗酒相留。"],["明日归舟。"],["碧藕花中醉过秋。"],["文姬赠别双团扇，","自写银钩。"],["散尽离愁。"],["携得清风出画楼。"]]}
{"id":"2fccab2158","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["前欢几处笙歌地，","长负登临。","月幌风襟。","犹忆西楼著意深。","莺花见尽当时事，","应笑如今。","一寸愁心。","日日寒蝉夜夜砧。"],"stanzas":[["前欢几处笙歌地，","长负登临。"],["月幌风襟。"],["犹忆西楼著意深。"],["莺花见尽当时事，","应笑如今。"],["一寸愁心。"],["日日寒蝉夜夜砧。"]]}
{"id":"3faeb3918b","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["无端恼破桃源梦，","明日青楼。","玉腻花柔。","不学行云易去留。","应嫌衫袖前香冷，","重傍金虬。","歌扇风流。","遮尽归时翠黛愁。"],"stanzas":[["无端恼破桃源梦，","明日青楼。"],["玉腻花柔。"],["不学行云易去留。"],["应嫌衫袖前香冷，","重傍金虬。"],["歌扇风流。"],["遮尽归时翠黛愁。"]]}
{"id":"04b147f4a0","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["年年此夕东城见，","欢意匆匆。","明日还重。","却在楼台缥缈中。","垂螺拂黛清歌女，","曾唱相逢。","秋月春风。","醉枕香衾一岁同。"],"stanzas":[["年年此夕东城见，","欢意匆匆。"],["明日还重。"],["却在楼台缥缈中。"],["垂螺拂黛清歌女，","曾唱相逢。"],["秋月春风。"],["醉枕香衾一岁同。"]]}
{"id":"806e0c365a","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["双螺未学同心绾，","已占歌名。","月白风清。","长倚昭华笛里声。","知音敲尽朱颜改，","寂寞时情。","一曲离亭。","惜与青楼忍泪听。"],"stanzas":[["双螺未学同心绾，","已占歌名。"],["月白风清。"],["长倚昭华笛里声。"],["知音敲尽朱颜改，","寂寞时情。"],["一曲离亭。"],["惜与青楼忍泪听。"]]}
{"id":"d502a26180","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["西楼月下当时见，","泪粉偷匀。","歌罢还颦。","恨隔炉烟看未真。","别来楼外垂杨缕，","几换青春。","倦客红尘。","长记楼中粉泪人。"],"stanzas":[["西楼月下当时见，","泪粉偷匀。"],["歌罢还颦。"],["恨隔炉烟看未真。"],["别来楼外垂杨缕，","几换青春。"],["倦客红尘。"],["长记楼中粉泪人。"]]}
{"id":"01f007ce5f","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["非花非雾前时见，","满眼娇春。","浅笑微颦。","恨隔垂帘看未真。","殷勤借问家何处，","不在红尘。","若是朝云。","宜作今宵梦里人。"],"stanzas":[["非花非雾前时见，","满眼娇春。"],["浅笑微颦。"],["恨隔垂帘看未真。"],["殷勤借问家何处，","不在红尘。"],["若是朝云。"],["宜作今宵梦里人。"]]}
{"id":"30477033e8","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["当时月下分飞处，","依旧凄凉。","也会思量。","不道孤眠夜更长。","泪痕揾遍鸳鸯枕，","重绕回廊。","月上东窗。","长到如今欲断肠。"],"stanzas":[["当时月下分飞处，","依旧凄凉。"],["也会思量。"],["不道孤眠夜更长。"],["泪痕揾遍鸳鸯枕，","重绕回廊。"],["月上东窗。"],["长到如今欲断肠。"]]}
{"id":"4447ea0fc6","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["湘妃浦口莲开尽，","昨夜红稀。","懒过前溪。","闲舣扁舟看雁飞。","去年谢女池边醉，","晚雨霏微。","记得归时。","旋折新荷盖舞衣。"],"stanzas":[["湘妃浦口莲开尽，","昨夜红稀。"],["懒过前溪。"],["闲舣扁舟看雁飞。"],["去年谢女池边醉，","晚雨霏微。"],["记得归时。"],["旋折新荷盖舞衣。"]]}
{"id":"ae89e9f538","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["别来长记西楼事，","结遍兰襟。","遗恨重寻。","弦断相如绿绮琴。","何时一枕逍遥夜，","细话初心。","若问如今。","也似当时著意深。"],"stanzas":[["别来长记西楼事，","结遍兰襟。"],["遗恨重寻。"],["弦断相如绿绮琴。"],["何时一枕逍遥夜，","细话初心。"],["若问如今。"],["也似当时著意深。"]]}
{"id":"7c2fb10a65","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["红窗碧玉新名旧，","犹绾双螺。","一寸秋波。","千斛明珠觉未多。","小来竹马同游客，","惯听清歌。","今日蹉跎。","恼乱工夫晕翠蛾。"],"stanzas":[["红窗碧玉新名旧，","犹绾双螺。"],["一寸秋波。"],["千斛明珠觉未多。"],["小来竹马同游客，","惯听清歌。"],["今日蹉跎。"],["恼乱工夫晕翠蛾。"]]}
{"id":"07efcae1c7","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["昭华凤管知名久，","长闭帘栊。","闻道春慵。","方倚庭花晕脸红。","可怜金谷无人后，","此会相逢。","三弄临风。","送得当筵玉盏空。"],"stanzas":[["昭华凤管知名久，","长闭帘栊。"],["闻道春慵。"],["方倚庭花晕脸红。"],["可怜金谷无人后，","此会相逢。"],["三弄临风。"],["送得当筵玉盏空。"]]}
{"id":"ccf9376be4","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["金风玉露初凉夜，","秋草窗前。","浅醉闲眠。","一枕江风梦不圆。","长情短恨难凭寄，","枉费红笺。","试拂么弦。","却恐琴心可暗传。"],"stanzas":[["金风玉露初凉夜，","秋草窗前。"],["浅醉闲眠。"],["一枕江风梦不圆。"],["长情短恨难凭寄，","枉费红笺。"],["试拂么弦。"],["却恐琴心可暗传。"]]}
{"id":"4c96cae605","title":"采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["心期昨夜寻思遍，","犹负殷勤。","齐斗堆金。","难买丹诚一寸真。","须知枕上尊前意，","占得长春。","寄语东邻。","似此相看有几人。"],"stanzas":[["心期昨夜寻思遍，","犹负殷勤。"],["齐斗堆金。"],["难买丹诚一寸真。"],["须知枕上尊前意，","占得长春。"],["寄语东邻。"],["似此相看有几人。"]]}
{"id":"1da15edbdf","title":"踏莎行","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行","lines":["柳上烟归，","池南雪尽。","东风渐有繁华信。","花开花谢蝶应知，","春来春去莺能问。","梦意犹疑，","心期欲近。","云笺字字萦方寸。","宿妆曾比杏腮红，","忆人细把香英认。"],"stanzas":[["柳上烟归，","池南雪尽。"],["东风渐有繁华信。"],["花开花谢蝶应知，","春来春去莺能问。"],["梦意犹疑，","心期欲近。"],["云笺字字萦方寸。"],["宿妆曾比杏腮红，","忆人细把香英认。"]]}
{"id":"27c5383b42","title":"踏莎行","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行","lines":["宿雨收尘，","朝霞破暝。","风光暗许花期定。","玉人呵手试妆时，","粉香帘幕阴阴静。","斜雁朱弦，","孤鸾绿镜。","伤春误了寻芳兴。","去年今日杏墙西，","啼莺唤得闲愁醒。"],"stanzas":[["宿雨收尘，","朝霞破暝。"],["风光暗许花期定。"],["玉人呵手试妆时，","粉香帘幕阴阴静。"],["斜雁朱弦，","孤鸾绿镜。"],["伤春误了寻芳兴。"],["去年今日杏墙西，","啼莺唤得闲愁醒。"]]}
{"id":"d2fa7a3c12","title":"踏莎行","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行","lines":["绿径穿花，","红楼压水。","寻芳误到蓬莱地。","玉颜人是蕊珠仙，","相逢展尽双蛾翠。","梦草闲眠，","流觞浅醉。","一春总见瀛洲事。","别来双燕又西飞，","无端不寄相思字。"],"stanzas":[["绿径穿花，","红楼压水。"],["寻芳误到蓬莱地。"],["玉颜人是蕊珠仙，","相逢展尽双蛾翠。"],["梦草闲眠，","流觞浅醉。"],["一春总见瀛洲事。"],["别来双燕又西飞，","无端不寄相思字。"]]}
{"id":"19b73f98b1","title":"踏莎行","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"踏莎行","lines":["雪尽寒轻，","月斜烟重。","清欢犹记前时共。","迎风朱户背灯开，","拂檐花影侵帘动。","绣枕双鸳，","香苞翠凤。","从来往事都如梦。","伤心最是醉归时，","眼前少个人人送。"],"stanzas":[["雪尽寒轻，","月斜烟重。"],["清欢犹记前时共。"],["迎风朱户背灯开，","拂檐花影侵帘动。"],["绣枕双鸳，","香苞翠凤。"],["从来往事都如梦。"],["伤心最是醉归时，","眼前少个人人送。"]]}
{"id":"adbbbd7c3a","title":"满庭芳","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满庭芳","lines":["南苑吹花，","西楼题叶，","故园欢事重重。","凭阑秋思，","闲记旧相逢。","几处歌云梦雨，","可怜便、流水西东。","别来久，","浅情未有，","锦字系征鸿。","年光还少味，","开残槛菊，","落尽溪桐。","漫留得，","尊前淡月西风。","此恨谁堪共说，","清愁付、绿酒杯中。","佳期在，","归时待把，","香袖看啼红。"],"stanzas":[["南苑吹花，","西楼题叶，","故园欢事重重。"],["凭阑秋思，","闲记旧相逢。"],["几处歌云梦雨，","可怜便、流水西东。"],["别来久，","浅情未有，","锦字系征鸿。"],["年光还少味，","开残槛菊，","落尽溪桐。"],["漫留得，","尊前淡月西风。"],["此恨谁堪共说，","清愁付、绿酒杯中。"],["佳期在，","归时待把，","香袖看啼红。"]]}
{"id":"26ce67a471","title":"留春令","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"留春令","lines":["画屏天畔，","梦回依约，","十洲云水。","手拈红笺寄人书，","写无限、伤春事。","别浦高楼曾漫倚。","对江南千里。","楼下分流水声中，","有当日、凭高泪。"],"stanzas":[["画屏天畔，","梦回依约，","十洲云水。"],["手拈红笺寄人书，","写无限、伤春事。"],["别浦高楼曾漫倚。"],["对江南千里。"],["楼下分流水声中，","有当日、凭高泪。"]]}
{"id":"037e0f676f","title":"留春令","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"留春令","lines":["采莲舟上，","夜来陡觉，","十分秋意。","懊恼寒花暂时香，","与情浅、人相似。","玉蕊歌清招晚醉。","恋小桥风细。","水湿红裙酒初消，","又记得、南溪事。"],"stanzas":[["采莲舟上，","夜来陡觉，","十分秋意。"],["懊恼寒花暂时香，","与情浅、人相似。"],["玉蕊歌清招晚醉。"],["恋小桥风细。"],["水湿红裙酒初消，","又记得、南溪事。"]]}
{"id":"87b010c0ac","title":"留春令","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"留春令","lines":["海棠风横，","醉中吹落，","香红强半。","小粉多情怨花飞，","仔细把、残香看。","一抹浓檀秋水畔。","缕金衣新换。","鹦鹉杯深艳歌迟，","更莫放、人肠断。"],"stanzas":[["海棠风横，","醉中吹落，","香红强半。"],["小粉多情怨花飞，","仔细把、残香看。"],["一抹浓檀秋水畔。"],["缕金衣新换。"],["鹦鹉杯深艳歌迟，","更莫放、人肠断。"]]}
{"id":"f340d6cc77","title":"风入松","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"风入松","lines":["柳阴庭院杏梢墙。","依旧巫阳。","凤箫已远青楼在，","水沈谁、复暖前香。","临镜舞鸾离照，","倚筝飞雁辞行。","坠鞭人意自凄凉。","泪眼回肠。","断云残雨当年事，","到如今、几处难忘。","两袖晓风花陌，","一帘夜月兰堂。"],"stanzas":[["柳阴庭院杏梢墙。"],["依旧巫阳。"],["凤箫已远青楼在，","水沈谁、复暖前香。"],["临镜舞鸾离照，","倚筝飞雁辞行。"],["坠鞭人意自凄凉。"],["泪眼回肠。"],["断云残雨当年事，","到如今、几处难忘。"],["两袖晓风花陌，","一帘夜月兰堂。"]]}
{"id":"7a33eb6a61","title":"风入松","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"风入松","lines":["心心念念忆相逢。","别恨谁浓。","就中懊恼难拼处，","是擘钗、分钿匆匆。","却似桃源路失，","落花空记前踪。","彩笺书尽浣溪红。","深意难通。","强欢殢酒图消遣，","到醒来、愁闷还重。","若是初心未改，","多应此意须同。"],"stanzas":[["心心念念忆相逢。"],["别恨谁浓。"],["就中懊恼难拼处，","是擘钗、分钿匆匆。"],["却似桃源路失，","落花空记前踪。"],["彩笺书尽浣溪红。"],["深意难通。"],["强欢殢酒图消遣，","到醒来、愁闷还重。"],["若是初心未改，","多应此意须同。"]]}
{"id":"d1dfc6182f","title":"清商怨","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"清商怨","lines":["庭花香信尚浅。","最玉楼先暖。","梦觉春衾，","江南依旧远。","回纹锦字暗翦。","漫寄与、也应归晚。","要问相思，","天涯犹自短。"],"stanzas":[["庭花香信尚浅。"],["最玉楼先暖。"],["梦觉春衾，","江南依旧远。"],["回纹锦字暗翦。"],["漫寄与、也应归晚。"],["要问相思，","天涯犹自短。"]]}
{"id":"4329653279","title":"秋蕊香","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"秋蕊香","lines":["池苑清阴欲就。","还傍送春时候。","眼中人去难欢偶。","谁共一杯芳酒。","朱阑碧砌皆如旧。","记携手。","有情不管别离久。","情在相逢终有。"],"stanzas":[["池苑清阴欲就。"],["还傍送春时候。"],["眼中人去难欢偶。"],["谁共一杯芳酒。"],["朱阑碧砌皆如旧。"],["记携手。"],["有情不管别离久。"],["情在相逢终有。"]]}
{"id":"3455e66b9e","title":"秋蕊香","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"秋蕊香","lines":["歌彻郎君秋草。","别恨远山眉小。","无情莫把多情恼。","第一归来须早。","红尘自古长安道。","故人少。","相思不比相逢好。","此别朱颜应老。"],"stanzas":[["歌彻郎君秋草。"],["别恨远山眉小。"],["无情莫把多情恼。"],["第一归来须早。"],["红尘自古长安道。"],["故人少。"],["相思不比相逢好。"],["此别朱颜应老。"]]}
{"id":"eff368a699","title":"思远人","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"思远人","lines":["红叶黄花秋意晚，","千里念行客。","飞云过尽，","归鸿无信，","何处寄书得。","泪弹不尽临窗滴。","就砚旋研墨。","渐写到别来，","此情深处，","红笺为无色。"],"stanzas":[["红叶黄花秋意晚，","千里念行客。"],["飞云过尽，","归鸿无信，","何处寄书得。"],["泪弹不尽临窗滴。"],["就砚旋研墨。"],["渐写到别来，","此情深处，","红笺为无色。"]]}
{"id":"ede1bccaf2","title":"碧牡丹","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"碧牡丹","lines":["翠袖疏纨扇。","凉叶催归燕。","一夜西风，","几处伤高怀远。","细菊枝头，","开嫩香还遍。","月痕依旧庭院。","事何限。","怅望秋意晚。","离人鬓华将换。","静忆天涯，","路比此情犹短。","试约鸾笺，","传素期良愿。","南云应有新雁。"],"stanzas":[["翠袖疏纨扇。"],["凉叶催归燕。"],["一夜西风，","几处伤高怀远。"],["细菊枝头，","开嫩香还遍。"],["月痕依旧庭院。"],["事何限。"],["怅望秋意晚。"],["离人鬓华将换。"],["静忆天涯，","路比此情犹短。"],["试约鸾笺，","传素期良愿。"],["南云应有新雁。"]]}
{"id":"651b57698c","title":"长相思","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"长相思","lines":["长相思。","长相思。","若问相思甚了期。","除非相见时。","长相思。","长相思。","欲把相思说似谁。","浅情人不知。"],"stanzas":[["长相思。"],["长相思。"],["若问相思甚了期。"],["除非相见时。"],["长相思。"],["长相思。"],["欲把相思说似谁。"],["浅情人不知。"]]}
{"id":"9da4b85043","title":"醉落魄・一斛珠","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"醉落魄・一斛珠","lines":["满街斜月。","垂鞭自唱阳关彻。","断尽柔肠思归切。","都为人人，","不许多时别。","南桥昨夜风吹雪。","短长亭下征尘歇。","归时定有梅堪折。","欲把离愁，","细拈花枝说。"],"stanzas":[["满街斜月。"],["垂鞭自唱阳关彻。"],["断尽柔肠思归切。"],["都为人人，","不许多时别。"],["南桥昨夜风吹雪。"],["短长亭下征尘歇。"],["归时定有梅堪折。"],["欲把离愁，","细拈花枝说。"]]}
{"id":"2025443ac0","title":"醉落魄・一斛珠","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"醉落魄・一斛珠","lines":["鸾孤月缺。","两春惆怅音尘绝。","如今若负当时节。","信道欢缘，","狂向衣襟结。","若问相思何处歇。","相逢便是相思彻。","尽饶别后留心别。","也待相逢，","细把相思说。"],"stanzas":[["鸾孤月缺。"],["两春惆怅音尘绝。"],["如今若负当时节。"],["信道欢缘，","狂向衣襟结。"],["若问相思何处歇。"],["相逢便是相思彻。"],["尽饶别后留心别。"],["也待相逢，","细把相思说。"]]}
{"id":"75be52cf06","title":"醉落魄・一斛珠","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"醉落魄・一斛珠","lines":["天教命薄。","青楼占得声名恶。","对酒当歌寻思著。","月户星窗，","多少旧期约。","相逢细语初心错。","两行红泪尊前落。","霞觞且共深深酌。","恼乱春宵，","翠被都闲却。"],"stanzas":[["天教命薄。"],["青楼占得声名恶。"],["对酒当歌寻思著。"],["月户星窗，","多少旧期约。"],["相逢细语初心错。"],["两行红泪尊前落。"],["霞觞且共深深酌。"],["恼乱春宵，","翠被都闲却。"]]}
{"id":"279a577f92","title":"醉落魄・一斛珠","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"醉落魄・一斛珠","lines":["休休莫莫。","离多还是因缘恶。","有情无奈思量著。","月夜佳期，","近写青笺约。","心心口口长恨昨。","分飞容易当时错。","后期休似前欢薄。","买断青楼，","莫放春闲却。"],"stanzas":[["休休莫莫。"],["离多还是因缘恶。"],["有情无奈思量著。"],["月夜佳期，","近写青笺约。"],["心心口口长恨昨。"],["分飞容易当时错。"],["后期休似前欢薄。"],["买断青楼，","莫放春闲却。"]]}
{"id":"89e40a29f8","title":"望仙楼・胡捣练","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"望仙楼・胡捣练","lines":["小春花信日边来，","未上江楼先坼。","今岁东君消息。","还自南枝得。","素衣染尽天香，","玉酒添成国色。","一自故溪疏隔。","肠断长相忆。"],"stanzas":[["小春花信日边来，","未上江楼先坼。"],["今岁东君消息。"],["还自南枝得。"],["素衣染尽天香，","玉酒添成国色。"],["一自故溪疏隔。"],["肠断长相忆。"]]}
{"id":"c8d3ac426a","title":"凤孤飞","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"凤孤飞","lines":["一曲画楼钟动，","宛转歌声缓。","绮席飞尘满。","更少待、金蕉暖。","细雨轻寒今夜短。","依前是、粉墙别馆。","端的欢期应未晚。","奈归云难管。"],"stanzas":[["一曲画楼钟动，","宛转歌声缓。"],["绮席飞尘满。"],["更少待、金蕉暖。"],["细雨轻寒今夜短。"],["依前是、粉墙别馆。"],["端的欢期应未晚。"],["奈归云难管。"]]}
{"id":"1cae57d49f","title":"西江月","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"西江月","lines":["愁黛颦成月浅，","啼妆印得花残。","只消鸳枕夜来闲。","晓镜心情便懒。","醉帽檐头风细，","征衫袖口香寒。","绿江春水寄书难。","携手佳期又晚。"],"stanzas":[["愁黛颦成月浅，","啼妆印得花残。"],["只消鸳枕夜来闲。"],["晓镜心情便懒。"],["醉帽檐头风细，","征衫袖口香寒。"],["绿江春水寄书难。"],["携手佳期又晚。"]]}
{"id":"ae388a2fae","title":"西江月","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"西江月","lines":["南苑垂鞭路冷，","西楼把袂人稀。","庭花犹有鬓边枝。","且插残红自醉。","画幕凉催燕去，","香屏晓放云归。","依前青枕梦回时。","试问闲愁有几。"],"stanzas":[["南苑垂鞭路冷，","西楼把袂人稀。"],["庭花犹有鬓边枝。"],["且插残红自醉。"],["画幕凉催燕去，","香屏晓放云归。"],["依前青枕梦回时。"],["试问闲愁有几。"]]}
{"id":"13acbe3c28","title":"武陵春","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"武陵春","lines":["绿蕙红兰芳信歇，","金蕊正风流。","应为诗人多怨秋。","花意与消愁。","梁王苑路香英密，","长记旧嬉游。","曾看飞琼戴满头。","浮动舞梁州。"],"stanzas":[["绿蕙红兰芳信歇，","金蕊正风流。"],["应为诗人多怨秋。"],["花意与消愁。"],["梁王苑路香英密，","长记旧嬉游。"],["曾看飞琼戴满头。"],["浮动舞梁州。"]]}
{"id":"651555df75","title":"武陵春","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"武陵春","lines":["九日黄花如有意，","依旧满珍丛。","谁似龙山秋兴浓。","吹帽落西风。","年年岁岁登高节，","欢事旋成空。","几处佳人此会同。","今在泪痕中。"],"stanzas":[["九日黄花如有意，","依旧满珍丛。"],["谁似龙山秋兴浓。"],["吹帽落西风。"],["年年岁岁登高节，","欢事旋成空。"],["几处佳人此会同。"],["今在泪痕中。"]]}
{"id":"1787e51684","title":"武陵春","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"武陵春","lines":["烟柳长堤知几曲，","一曲一魂消。","秋水无情天共遥。","愁送木兰桡。","熏香绣被心情懒，","期信转迢迢。","记得来时倚画桥。","红泪满鲛绡。"],"stanzas":[["烟柳长堤知几曲，","一曲一魂消。"],["秋水无情天共遥。"],["愁送木兰桡。"],["熏香绣被心情懒，","期信转迢迢。"],["记得来时倚画桥。"],["红泪满鲛绡。"]]}
{"id":"9a6d78cff4","title":"解佩令","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"解佩令","lines":["玉阶秋感，","年华暗去。","掩深宫、团扇无绪。","记得当时，","自翦下、机中轻素。","点丹青、画成秦女。","凉襟犹在，","朱弦未改，","忍霜纨、飘零何处。","自古悲凉，","是情事、轻如云雨。","倚么弦、恨长难诉。"],"stanzas":[["玉阶秋感，","年华暗去。"],["掩深宫、团扇无绪。"],["记得当时，","自翦下、机中轻素。"],["点丹青、画成秦女。"],["凉襟犹在，","朱弦未改，","忍霜纨、飘零何处。"],["自古悲凉，","是情事、轻如云雨。"],["倚么弦、恨长难诉。"]]}
{"id":"cd8e83fadf","title":"行香子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"行香子","lines":["晚绿寒红。","芳意匆匆。","惜年华、今与谁同。","碧云零落，","数字征鸿。","看渚莲凋，","宫扇旧，","怨秋风。","流波坠叶，","佳期何在，","想天教、离恨无穷。","试将前事，","闲倚梧桐。","有消魂处，","明月夜，","粉屏空。"],"stanzas":[["晚绿寒红。"],["芳意匆匆。"],["惜年华、今与谁同。"],["碧云零落，","数字征鸿。"],["看渚莲凋，","宫扇旧，","怨秋风。"],["流波坠叶，","佳期何在，","想天教、离恨无穷。"],["试将前事，","闲倚梧桐。"],["有消魂处，","明月夜，","粉屏空。"]]}
{"id":"68e61d5440","title":"庆春时","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"庆春时","lines":["倚天楼殿，","升平风月，","彩仗春移。","鸾丝凤竹，","长生调里，","迎得翠舆归。","雕鞍游罢，","何处还有心期。","浓熏翠被，","深停画烛，","人约月西时。"],"stanzas":[["倚天楼殿，","升平风月，","彩仗春移。"],["鸾丝凤竹，","长生调里，","迎得翠舆归。"],["雕鞍游罢，","何处还有心期。"],["浓熏翠被，","深停画烛，","人约月西时。"]]}
{"id":"522f8ee3c1","title":"庆春时","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"庆春时","lines":["梅梢已有，","春来音信，","风意犹寒。","南楼暮雪，","无人共赏，","闲却玉阑干。","殷勤今夜，","凉月还似眉弯。","尊前为把，","桃根丽曲，","重倚四弦看。"],"stanzas":[["梅梢已有，","春来音信，","风意犹寒。"],["南楼暮雪，","无人共赏，","闲却玉阑干。"],["殷勤今夜，","凉月还似眉弯。"],["尊前为把，","桃根丽曲，","重倚四弦看。"]]}
{"id":"509a2b2236","title":"喜团圆","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"喜团圆","lines":["危楼静锁，","窗中远岫，","门外垂杨。","珠帘不禁春风度，","解偷送馀香。","眠思梦想，","不如双燕，","得到兰房。","别来只是，","凭高泪眼，","感旧离肠。"],"stanzas":[["危楼静锁，","窗中远岫，","门外垂杨。"],["珠帘不禁春风度，","解偷送馀香。"],["眠思梦想，","不如双燕，","得到兰房。"],["别来只是，","凭高泪眼，","感旧离肠。"]]}
{"id":"2891012a76","title":"忆闷令","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"忆闷令","lines":["取次临鸾匀画浅。","酒醒迟来晚。","多情爱惹闲愁，","长黛眉低敛。","月底相逢花下见。","有深深良愿。","愿期信、似月如花，","须更教长远。"],"stanzas":[["取次临鸾匀画浅。"],["酒醒迟来晚。"],["多情爱惹闲愁，","长黛眉低敛。"],["月底相逢花下见。"],["有深深良愿。"],["愿期信、似月如花，","须更教长远。"]]}
{"id":"3711775f75","title":"梁州令","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"梁州令","lines":["莫唱阳关曲。","泪湿当年金缕。","离歌自古最消魂，","闻歌更在魂消处。","南楼杨柳多情绪。","不系行人住。","人情却似飞絮。","悠扬便逐春风去。"],"stanzas":[["莫唱阳关曲。"],["泪湿当年金缕。"],["离歌自古最消魂，","闻歌更在魂消处。"],["南楼杨柳多情绪。"],["不系行人住。"],["人情却似飞絮。"],["悠扬便逐春风去。"]]}
{"id":"4d1f7f6490","title":"燕归梁","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"燕归梁","lines":["莲叶雨，","蓼花风。","秋恨几枝红。","远烟收尽水溶溶。","飞雁碧云中。","衷肠事。","鱼笺字。","情绪年年相似。","凭高双袖晚寒浓。","人在月桥东。"],"stanzas":[["莲叶雨，","蓼花风。"],["秋恨几枝红。"],["远烟收尽水溶溶。"],["飞雁碧云中。"],["衷肠事。"],["鱼笺字。"],["情绪年年相似。"],["凭高双袖晚寒浓。"],["人在月桥东。"]]}
{"id":"5e8fef193a","title":"胡捣练","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"胡捣练","lines":["小亭初报一枝梅，","惹起江南归兴。","遥想玉溪风景，","水漾横斜影。","异香直到醉乡中，","醉后还因香醒。","好是玉容相并。","人与花争莹。"],"stanzas":[["小亭初报一枝梅，","惹起江南归兴。"],["遥想玉溪风景，","水漾横斜影。"],["异香直到醉乡中，","醉后还因香醒。"],["好是玉容相并。"],["人与花争莹。"]]}
{"id":"6f6776a26b","title":"扑蝴蝶","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"扑蝴蝶","lines":["风梢雨叶，","绿遍江南岸。","思归倦客，","寻芳来最晚。","酒边红日初长，","陌上飞花正满。","凄凉数声弦管。","怨春短。","玉人应在，","明月楼中画眉懒。","鱼笺锦字，","多时音信断。","恨如去水空长，","事与行云渐远。","罗衾旧香馀暖。"],"stanzas":[["风梢雨叶，","绿遍江南岸。"],["思归倦客，","寻芳来最晚。"],["酒边红日初长，","陌上飞花正满。"],["凄凉数声弦管。"],["怨春短。"],["玉人应在，","明月楼中画眉懒。"],["鱼笺锦字，","多时音信断。"],["恨如去水空长，","事与行云渐远。"],["罗衾旧香馀暖。"]]}
{"id":"4d32cc4557","title":"丑奴儿・采桑子","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"丑奴儿・采桑子","lines":["夜来酒醒清无梦，","愁倚阑干。","露滴轻寒。","雨打芙蓉泪不干。","佳人别后音尘悄，","瘦尽难拼。","明月无端。","已过红楼十二间。"],"stanzas":[["夜来酒醒清无梦，","愁倚阑干。"],["露滴轻寒。"],["雨打芙蓉泪不干。"],["佳人别后音尘悄，","瘦尽难拼。"],["明月无端。"],["已过红楼十二间。"]]}
{"id":"e7d7c61aa6","title":"谒金门","author":"晏几道","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"谒金门","lines":["溪声急。","无数落花漂出。","燕子分泥蜂酿蜜。","迟迟艳风日。","须信芳菲随失。","况复佳期难必。","拟把此情书万一。","愁多翻阁笔。"],"stanzas":[["溪声急。"],["无数落花漂出。"],["燕子分泥蜂酿蜜。"],["迟迟艳风日。"],["须信芳菲随失。"],["况复佳期难必。"],["拟把此情书万一。"],["愁多翻阁笔。"]]}
