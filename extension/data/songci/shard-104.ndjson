{"id":"c498ada6ab","title":"破阵子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"破阵子","lines":["看破空花尘世，","放轻昨梦浮名。","蜡屐登山真率饮，","筇杖穿林自在行。","身闲心太平。","料峭馀寒犹力，","廉纤细雨初晴。","苔纸闲题溪上句，","菱唱遥闻烟外声。","与君同醉醒。"],"stanzas":[["看破空花尘世，","放轻昨梦浮名。"],["蜡屐登山真率饮，","筇杖穿林自在行。"],["身闲心太平。"],["料峭馀寒犹力，","廉纤细雨初晴。"],["苔纸闲题溪上句，","菱唱遥闻烟外声。"],["与君同醉醒。"]]}
{"id":"542bd99fad","title":"上西楼・相见欢","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"上西楼・相见欢","lines":["江头绿暗红稀。","燕交飞。","忽到当年行处、恨依依。","洒清泪。","叹人事。","与心违。","满酌玉壶花露、送春归。"],"stanzas":[["江头绿暗红稀。"],["燕交飞。"],["忽到当年行处、恨依依。"],["洒清泪。"],["叹人事。"],["与心违。"],["满酌玉壶花露、送春归。"]]}
{"id":"9e0f339987","title":"点绛唇","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"点绛唇","lines":["采药归来，","独寻茅店沽新酿。","暮烟千嶂。","处处闻渔唱。","醉弄扁舟，","不怕粘天浪。","江湖上。","遮回疏放。","作个闲人样。"],"stanzas":[["采药归来，","独寻茅店沽新酿。"],["暮烟千嶂。"],["处处闻渔唱。"],["醉弄扁舟，","不怕粘天浪。"],["江湖上。"],["遮回疏放。"],["作个闲人样。"]]}
{"id":"0462acd994","title":"谢池春","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"谢池春","lines":["壮岁从戎，","曾是气吞残虏。","阵云高、狼烽夜举。","朱颜青鬓，","拥雕戈西戍。","笑儒冠、自来多误。","功名梦断，","却泛扁舟吴楚。","漫悲歌、伤怀吊古。","烟波无际，","望秦关何处。","叹流年、又成虚度。"],"stanzas":[["壮岁从戎，","曾是气吞残虏。"],["阵云高、狼烽夜举。"],["朱颜青鬓，","拥雕戈西戍。"],["笑儒冠、自来多误。"],["功名梦断，","却泛扁舟吴楚。"],["漫悲歌、伤怀吊古。"],["烟波无际，","望秦关何处。"],["叹流年、又成虚度。"]]}
{"id":"6226a2b84e","title":"谢池春","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"谢池春","lines":["贺监湖边，","初系放翁归棹。","小园林、时时醉倒。","春眠惊起，","听啼莺催晓。","叹功名、误人勘笑。","朱桥翠径，","不许京尘飞到。","挂朝衣、东归欠早。","连宵风雨，","卷残红如扫。","恨樽前、送春人老。"],"stanzas":[["贺监湖边，","初系放翁归棹。"],["小园林、时时醉倒。"],["春眠惊起，","听啼莺催晓。"],["叹功名、误人勘笑。"],["朱桥翠径，","不许京尘飞到。"],["挂朝衣、东归欠早。"],["连宵风雨，","卷残红如扫。"],["恨樽前、送春人老。"]]}
{"id":"285b3f49f0","title":"谢池春","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"谢池春","lines":["七十衰翁，","不减少年豪气。","似天山、凄凉病骥。","铜驼荆棘，","洒临风清泪。","甚情怀、伴人儿戏。","如今何幸，","作个故溪归计。","鹤飞来、晴岚暖翠。","玉壶春酒，","约群仙同醉。","洞天寒、露桃开未。"],"stanzas":[["七十衰翁，","不减少年豪气。"],["似天山、凄凉病骥。"],["铜驼荆棘，","洒临风清泪。"],["甚情怀、伴人儿戏。"],["如今何幸，","作个故溪归计。"],["鹤飞来、晴岚暖翠。"],["玉壶春酒，","约群仙同醉。"],["洞天寒、露桃开未。"]]}
{"id":"36045e8e1a","title":"一落索","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"一落索","lines":["满路游丝飞絮。","韶光将暮。","此时谁与说新愁，","有百啭、流莺语。","俯仰人间今古。","神仙何处。","花前须判醉扶归，","酒不到、刘伶墓。"],"stanzas":[["满路游丝飞絮。"],["韶光将暮。"],["此时谁与说新愁，","有百啭、流莺语。"],["俯仰人间今古。"],["神仙何处。"],["花前须判醉扶归，","酒不到、刘伶墓。"]]}
{"id":"a56c89a130","title":"一落索","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"一落索","lines":["识破浮生虚妄。","从人讥谤。","此身恰似弄潮儿，","曾过了、千重浪。","且喜归来无恙。","一壶春酿。","雨蓑烟笠傍渔矶，","应不是、封侯相。"],"stanzas":[["识破浮生虚妄。"],["从人讥谤。"],["此身恰似弄潮儿，","曾过了、千重浪。"],["且喜归来无恙。"],["一壶春酿。"],["雨蓑烟笠傍渔矶，","应不是、封侯相。"]]}
{"id":"8a55489a40","title":"杏花天","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"杏花天","lines":["老来驹隙骎骎度。","筭只合、狂歌醉舞。","金杯到手君休诉。","看著春光又暮。","谁为倩、柳条系住。","且莫遣、城笳催去。","残红转眼无寻处。","尽属蜂房燕户。"],"stanzas":[["老来驹隙骎骎度。"],["筭只合、狂歌醉舞。"],["金杯到手君休诉。"],["看著春光又暮。"],["谁为倩、柳条系住。"],["且莫遣、城笳催去。"],["残红转眼无寻处。"],["尽属蜂房燕户。"]]}
{"id":"ec5c99e381","title":"太平时・添声杨柳枝","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"太平时・添声杨柳枝","lines":["竹里房栊一径深。","静愔愔。","乱红飞尽绿成阴。","有鸣禽。","临罢兰亭无一事，","自修琴。","铜炉袅袅海南沉。","洗尘襟。"],"stanzas":[["竹里房栊一径深。"],["静愔愔。"],["乱红飞尽绿成阴。"],["有鸣禽。"],["临罢兰亭无一事，","自修琴。"],["铜炉袅袅海南沉。"],["洗尘襟。"]]}
{"id":"8e6be4f852","title":"恋绣衾","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"恋绣衾","lines":["不惜貂裘换钓篷。","嗟时人、谁识放翁。","归棹借、樵风稳，","数声闻、林外暮锺。","幽栖莫笑蜗庐小，","有云山、烟水万重。","半世向、丹青看，","喜如今、身在画中。"],"stanzas":[["不惜貂裘换钓篷。"],["嗟时人、谁识放翁。"],["归棹借、樵风稳，","数声闻、林外暮锺。"],["幽栖莫笑蜗庐小，","有云山、烟水万重。"],["半世向、丹青看，","喜如今、身在画中。"]]}
{"id":"78226f9d20","title":"恋绣衾","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"恋绣衾","lines":["无方能驻脸上红。","笑浮生、扰扰梦中。","平地是、冲霄路，","又何劳、千日用功。","飘然再过莲峰下，","乱云深、吹下暮锺。","访旧隐、依然在，","但鹤巢、时有堕松。"],"stanzas":[["无方能驻脸上红。"],["笑浮生、扰扰梦中。"],["平地是、冲霄路，","又何劳、千日用功。"],["飘然再过莲峰下，","乱云深、吹下暮锺。"],["访旧隐、依然在，","但鹤巢、时有堕松。"]]}
{"id":"3e62523510","title":"风入松","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"风入松","lines":["十年裘马锦江滨。","酒隐红尘。","万金选胜莺花海，","倚疏狂、驱使青春。","吹笛鱼龙尽出，","题诗风月俱新。","自怜华发满纱巾。","犹是官身。","凤楼常记当年语，","问浮名、何似身亲。","欲寄吴笺说与，","这回真个闲人。"],"stanzas":[["十年裘马锦江滨。"],["酒隐红尘。"],["万金选胜莺花海，","倚疏狂、驱使青春。"],["吹笛鱼龙尽出，","题诗风月俱新。"],["自怜华发满纱巾。"],["犹是官身。"],["凤楼常记当年语，","问浮名、何似身亲。"],["欲寄吴笺说与，","这回真个闲人。"]]}
{"id":"20aa06bd78","title":"真珠帘","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"真珠帘","lines":["灯前月下嬉游处。","向笙歌、锦绣丛中相遇。","彼此知名，","才见便论心素。","浅黛娇蝉风调别，","最动人、时时偷顾。","归去。","想闲窗深院，","调弦促柱。","乐府初翻新谱。","漫裁红点翠，","闲题金缕。","燕子入帘时，","又一番春暮。","侧帽燕脂坡下过，","料也记、前年崔护。","休诉。","待从今须与，","好花为主。"],"stanzas":[["灯前月下嬉游处。"],["向笙歌、锦绣丛中相遇。"],["彼此知名，","才见便论心素。"],["浅黛娇蝉风调别，","最动人、时时偷顾。"],["归去。"],["想闲窗深院，","调弦促柱。"],["乐府初翻新谱。"],["漫裁红点翠，","闲题金缕。"],["燕子入帘时，","又一番春暮。"],["侧帽燕脂坡下过，","料也记、前年崔护。"],["休诉。"],["待从今须与，","好花为主。"]]}
{"id":"3a9a8462cc","title":"风流子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"风流子","lines":["佳人多命薄，","初心慕、德耀嫁梁鸿。","记绿窗睡起，","静吟闲咏，","句翻离合，","格变玲珑。","更乘兴，","素纨留戏墨，","纤玉抚孤桐。","蟾滴夜寒，","水浮微冻，","凤笺春丽，","花砑轻红。","人生谁能料，","堪悲处、身落柳陌花丛。","空羡画堂鹦鹉，","深闭金笼。","向宝镜鸾钗，","临妆常晚，","绣茵牙版，","催舞还慵。","肠断市桥月笛，","灯院霜锺。"],"stanzas":[["佳人多命薄，","初心慕、德耀嫁梁鸿。"],["记绿窗睡起，","静吟闲咏，","句翻离合，","格变玲珑。"],["更乘兴，","素纨留戏墨，","纤玉抚孤桐。"],["蟾滴夜寒，","水浮微冻，","凤笺春丽，","花砑轻红。"],["人生谁能料，","堪悲处、身落柳陌花丛。"],["空羡画堂鹦鹉，","深闭金笼。"],["向宝镜鸾钗，","临妆常晚，","绣茵牙版，","催舞还慵。"],["肠断市桥月笛，","灯院霜锺。"]]}
{"id":"1ca4f4c1dc","title":"双头莲","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"双头莲","lines":["风卷征尘，","堪叹处、青骢正摇金辔。","客襟贮泪。","漫万点如血，","凭谁持寄。","伫想艳态幽情，","压江南佳丽。","春正媚。","怎忍长亭，","匆匆顿分连理。","目断淡日平芜，","望烟浓树远，","微茫如荠。","悲欢梦里。","奈倦客、又是关河千里。","最苦唱彻骊歌，","重迟留无计。","何限事。","待与丁宁，","行时已醉。"],"stanzas":[["风卷征尘，","堪叹处、青骢正摇金辔。"],["客襟贮泪。"],["漫万点如血，","凭谁持寄。"],["伫想艳态幽情，","压江南佳丽。"],["春正媚。"],["怎忍长亭，","匆匆顿分连理。"],["目断淡日平芜，","望烟浓树远，","微茫如荠。"],["悲欢梦里。"],["奈倦客、又是关河千里。"],["最苦唱彻骊歌，","重迟留无计。"],["何限事。"],["待与丁宁，","行时已醉。"]]}
{"id":"0e70335ab7","title":"鹧鸪天","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["杖屦寻春苦未迟。","洛城樱笋正当时。","三千界外归初到，","五百年前事总知。","吹玉笛，","渡清伊。","相逢休问姓名谁。","小车处士深衣叟，","曾是天津共赋诗。"],"stanzas":[["杖屦寻春苦未迟。"],["洛城樱笋正当时。"],["三千界外归初到，","五百年前事总知。"],["吹玉笛，","渡清伊。"],["相逢休问姓名谁。"],["小车处士深衣叟，","曾是天津共赋诗。"]]}
{"id":"ea488a0e0d","title":"蝶恋花","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蝶恋花","lines":["禹庙兰亭今古路。","一夜清霜，","染尽湖边树。","鹦鹉杯深君莫诉。","他时相遇知何处。","冉冉年华留不住。","镜里朱颜，","毕竟消磨去。","一句丁宁君记取。","神仙须是闲人做。"],"stanzas":[["禹庙兰亭今古路。"],["一夜清霜，","染尽湖边树。"],["鹦鹉杯深君莫诉。"],["他时相遇知何处。"],["冉冉年华留不住。"],["镜里朱颜，","毕竟消磨去。"],["一句丁宁君记取。"],["神仙须是闲人做。"]]}
{"id":"500a468998","title":"渔父・渔歌子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"渔父・渔歌子","lines":["石帆山下雨空蒙。","三扇香新翠箬篷。","苹叶绿，","蓼花红。","回首功名一梦中。"],"stanzas":[["石帆山下雨空蒙。"],["三扇香新翠箬篷。"],["苹叶绿，","蓼花红。"],["回首功名一梦中。"]]}
{"id":"b0bce83487","title":"渔父・渔歌子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"渔父・渔歌子","lines":["晴山滴翠水挼蓝。","聚散渔舟两复三。","横埭北，","断桥南。","侧起船篷便作帆。"],"stanzas":[["晴山滴翠水挼蓝。"],["聚散渔舟两复三。"],["横埭北，","断桥南。"],["侧起船篷便作帆。"]]}
{"id":"2db05851c2","title":"渔父・渔歌子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"渔父・渔歌子","lines":["镜湖俯仰两青天。","万顷玻璃一叶船。","拈棹舞，","拥蓑眠。","不作天仙作水仙。"],"stanzas":[["镜湖俯仰两青天。"],["万顷玻璃一叶船。"],["拈棹舞，","拥蓑眠。"],["不作天仙作水仙。"]]}
{"id":"1ad19b4007","title":"渔父・渔歌子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"渔父・渔歌子","lines":["湘湖烟雨长莼丝。","菰米新炊滑上匙。","云散后，","月斜时。","潮落舟横醉不知。"],"stanzas":[["湘湖烟雨长莼丝。"],["菰米新炊滑上匙。"],["云散后，","月斜时。"],["潮落舟横醉不知。"]]}
{"id":"7bdc3e4200","title":"渔父・渔歌子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"渔父・渔歌子","lines":["长安拜免几公卿。","渔父横眠醉未醒。","烟艇小，","钓车腥。","遥指梅山一点青。"],"stanzas":[["长安拜免几公卿。"],["渔父横眠醉未醒。"],["烟艇小，","钓车腥。"],["遥指梅山一点青。"]]}
{"id":"0be86742f7","title":"恋绣衾","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"恋绣衾","lines":["雨断西山晚照明。","悄无人、幽梦自惊。","说道去、多时也，","到如今、真个是行。","远山已是无心画，","小楼空、斜掩绣屏。","你嚎早、收心呵，","趁刘郎、双鬓未星。"],"stanzas":[["雨断西山晚照明。"],["悄无人、幽梦自惊。"],["说道去、多时也，","到如今、真个是行。"],["远山已是无心画，","小楼空、斜掩绣屏。"],["你嚎早、收心呵，","趁刘郎、双鬓未星。"]]}
{"id":"fd41d6ff08","title":"采桑子","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"采桑子","lines":["三山山下闲居士，","巾履萧然。","小醉闲眠。","风引飞花落钓船。"],"stanzas":[["三山山下闲居士，","巾履萧然。"],["小醉闲眠。"],["风引飞花落钓船。"]]}
{"id":"fa7d159784","title":"水龙吟","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"水龙吟","lines":["摩诃池上追游路，","红绿参差春晚。","韶光妍媚，","海棠如醉，","桃花欲暖。","挑菜初闲，","禁烟将近，","一城丝管。","看金鞍争道，","香车飞盖，","争先占、新亭馆。","惆怅年华暗换。","黯销魂、雨收云散。","镜奁掩月，","钗梁拆凤，","秦筝斜雁。","身在天涯，","乱山孤垒，","危楼飞观。","叹春来只有，","杨花和恨、向东风满。"],"stanzas":[["摩诃池上追游路，","红绿参差春晚。"],["韶光妍媚，","海棠如醉，","桃花欲暖。"],["挑菜初闲，","禁烟将近，","一城丝管。"],["看金鞍争道，","香车飞盖，","争先占、新亭馆。"],["惆怅年华暗换。"],["黯销魂、雨收云散。"],["镜奁掩月，","钗梁拆凤，","秦筝斜雁。"],["身在天涯，","乱山孤垒，","危楼飞观。"],["叹春来只有，","杨花和恨、向东风满。"]]}
{"id":"b3e506c377","title":"月照梨花・河传","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"月照梨花・河传","lines":["霁景风软，","烟江春涨。","小阁无人，","绣帘半上。","花外姊妹相呼。","约樗蒲。","修蛾忘了章台样。","细思一饷。","感事添惆怅。","胸酥臂玉消减，","拟觅双鱼。","倩传书。"],"stanzas":[["霁景风软，","烟江春涨。"],["小阁无人，","绣帘半上。"],["花外姊妹相呼。"],["约樗蒲。"],["修蛾忘了章台样。"],["细思一饷。"],["感事添惆怅。"],["胸酥臂玉消减，","拟觅双鱼。"],["倩传书。"]]}
{"id":"f0d56133eb","title":"月照梨花・河传","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"月照梨花・河传","lines":["闷已萦损。","那堪多病。","几曲屏山，","伴人昼静。","梁燕催起犹慵。","换熏龙。","新愁旧恨何时尽。","渐凋绿鬓。","小雨知花信。","芳笺寄与何处，","绣阁珠栊。","柳阴中。"],"stanzas":[["闷已萦损。"],["那堪多病。"],["几曲屏山，","伴人昼静。"],["梁燕催起犹慵。"],["换熏龙。"],["新愁旧恨何时尽。"],["渐凋绿鬓。"],["小雨知花信。"],["芳笺寄与何处，","绣阁珠栊。"],["柳阴中。"]]}
{"id":"0c5f0a48c4","title":"夜游宫","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"夜游宫","lines":["宴罢珠帘半卷。","画檐外、蜡香人散。","翠雾霏霏漏声断。","倚香肩，","看中庭，","花影乱。","宛是高唐馆。","宝奁炷、麝烟初暖。","璧月何妨夜夜满。","拥芳柔，","恨今年，","寒尚浅。"],"stanzas":[["宴罢珠帘半卷。"],["画檐外、蜡香人散。"],["翠雾霏霏漏声断。"],["倚香肩，","看中庭，","花影乱。"],["宛是高唐馆。"],["宝奁炷、麝烟初暖。"],["璧月何妨夜夜满。"],["拥芳柔，","恨今年，","寒尚浅。"]]}
{"id":"3d51c2e3c2","title":"如梦令","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"如梦令","lines":["独倚博山峰小。","翠雾满身飞绕。","只恐学行云，","去作阳台春晓。","春晓。","春晓。","满院绿阳芳草。"],"stanzas":[["独倚博山峰小。"],["翠雾满身飞绕。"],["只恐学行云，","去作阳台春晓。"],["春晓。"],["春晓。"],["满院绿阳芳草。"]]}
{"id":"c1c7aa917c","title":"失调名","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"失调名","lines":["飞上锦裀红皱。"],"stanzas":[["飞上锦裀红皱。"]]}
{"id":"a009a17fd7","title":"解连环","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"解连环","lines":["泪淹妆薄。","背东风伫立，","柳绵池阁。","漫细字、书满芳笺，","恨钗燕筝鸿，","总难凭托。","风雨无情，","又颠倒、绿苔红萼。","仗香醪破闷，","怎禁夜阑，","酒酲萧索。","刘郎已望故约。","奈重门静院，","光景如昨。","尽做它、别有留心，","便不念当时，","雨意初著。","京兆眉残，","怎忍为、新人梳掠。","尽今生、拼了为伊，","任人道错。"],"stanzas":[["泪淹妆薄。"],["背东风伫立，","柳绵池阁。"],["漫细字、书满芳笺，","恨钗燕筝鸿，","总难凭托。"],["风雨无情，","又颠倒、绿苔红萼。"],["仗香醪破闷，","怎禁夜阑，","酒酲萧索。"],["刘郎已望故约。"],["奈重门静院，","光景如昨。"],["尽做它、别有留心，","便不念当时，","雨意初著。"],["京兆眉残，","怎忍为、新人梳掠。"],["尽今生、拼了为伊，","任人道错。"]]}
{"id":"8bf6f5110b","title":"大圣乐","author":"陆游","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"大圣乐","lines":["电转雷惊，","自叹浮生，","四十二年。","试思量往事，","虚无似梦，","悲欢万状，","合散如烟。","苦海无边，","爱河无底，","流浪看成百漏船。","何人解，","问无常火里，","铁打身坚。","须臾便是华颠。","好收拾形体归自然。","又何通，","是非荣辱，","此事由来都在天。","从今去，","任东西南北，","作个飞仙。"],"stanzas":[["电转雷惊，","自叹浮生，","四十二年。"],["试思量往事，","虚无似梦，","悲欢万状，","合散如烟。"],["苦海无边，","爱河无底，","流浪看成百漏船。"],["何人解，","问无常火里，","铁打身坚。"],["须臾便是华颠。"],["好收拾形体归自然。"],["又何通，","是非荣辱，","此事由来都在天。"],["从今去，","任东西南北，","作个飞仙。"]]}
{"id":"88db8525c6","title":"钗头凤・撷芳词","author":"唐婉","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"钗头凤・撷芳词","lines":["世情薄。","人情恶。","雨送黄昏花易落。","晓风干。","泪痕残。","欲笺心事，","独语斜阑。","难难难。","人成各。","今非昨。","病魂尝似秋千索。","角声寒。","夜阑珊。","怕人寻问，","咽泪装欢。","瞒瞒瞒。"],"stanzas":[["世情薄。"],["人情恶。"],["雨送黄昏花易落。"],["晓风干。"],["泪痕残。"],["欲笺心事，","独语斜阑。"],["难难难。"],["人成各。"],["今非昨。"],["病魂尝似秋千索。"],["角声寒。"],["夜阑珊。"],["怕人寻问，","咽泪装欢。"],["瞒瞒瞒。"]]}
{"id":"b17ff7a386","title":"生查子","author":"陆游妾某氏","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"生查子","lines":["只知愁上眉，","不识愁来路。","窗外有芭蕉，","阵阵黄昏雨。","逗晓理残妆，","整顿教愁去。","不合画春山，","依旧留连住。"],"stanzas":[["只知愁上眉，","不识愁来路。"],["窗外有芭蕉，","阵阵黄昏雨。"],["逗晓理残妆，","整顿教愁去。"],["不合画春山，","依旧留连住。"]]}
{"id":"309bba6a20","title":"祝英台近","author":"王","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"祝英台近","lines":["柳烟浓，","花露重，","合是醉时候。","楼倚花梢，","长记小垂手。","谁教钗燕轻分，","镜鸾慵舞，","是孤负、几番春昼。","自别后。","闻道花底花前，","多是两眉皱。","又说新来，","比似旧时瘦。","须知两意长存，","相逢终有。","莫谩被、春光僝僽。"],"stanzas":[["柳烟浓，","花露重，","合是醉时候。"],["楼倚花梢，","长记小垂手。"],["谁教钗燕轻分，","镜鸾慵舞，","是孤负、几番春昼。"],["自别后。"],["闻道花底花前，","多是两眉皱。"],["又说新来，","比似旧时瘦。"],["须知两意长存，","相逢终有。"],["莫谩被、春光僝僽。"]]}
{"id":"63ca20dad3","title":"夜行船","author":"王","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"夜行船","lines":["曲水溅裙三月二。","马如龙、钿车如水。","风扬游丝，","日烘晴昼，","人共海棠俱醉。","客里光阴难可意。","扫芳尘、旧游谁记。","午梦醒来，","小窗人静，","春在卖花声里。"],"stanzas":[["曲水溅裙三月二。"],["马如龙、钿车如水。"],["风扬游丝，","日烘晴昼，","人共海棠俱醉。"],["客里光阴难可意。"],["扫芳尘、旧游谁记。"],["午梦醒来，","小窗人静，","春在卖花声里。"]]}
{"id":"a5680c0cde","title":"朝中措","author":"贾逸祖","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["青山隐隐水斜斜。","修竹两三家。","又是水寒山瘦，","依然行客遍天涯。","天教流落，","东西南北，","不恨年华。","只恨夜来风雨，","投明月、老却梅花。"],"stanzas":[["青山隐隐水斜斜。"],["修竹两三家。"],["又是水寒山瘦，","依然行客遍天涯。"],["天教流落，","东西南北，","不恨年华。"],["只恨夜来风雨，","投明月、老却梅花。"]]}
{"id":"6e6cbb87b4","title":"鹊桥仙","author":"蜀妓","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹊桥仙","lines":["说盟说誓。","说情说意。","动便春愁满纸。","多应念得脱空经，","是那个、先生教底。","不茶不饭，","不言不语，","一味供他憔悴。","相思已是不曾闲，","又那得、功夫咒你。"],"stanzas":[["说盟说誓。"],["说情说意。"],["动便春愁满纸。"],["多应念得脱空经，","是那个、先生教底。"],["不茶不饭，","不言不语，","一味供他憔悴。"],["相思已是不曾闲，","又那得、功夫咒你。"]]}
{"id":"deaeb39bc7","title":"画堂春","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"画堂春","lines":["故园二月正芳菲。","红紫团枝。","一番草绿谢郎池。","人醉如泥。","底事江乡风物，","年年独殿芳时。","无情燕子背人飞。","似愧春迟。"],"stanzas":[["故园二月正芳菲。"],["红紫团枝。"],["一番草绿谢郎池。"],["人醉如泥。"],["底事江乡风物，","年年独殿芳时。"],["无情燕子背人飞。"],["似愧春迟。"]]}
{"id":"bbea883460","title":"浣溪沙","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["节序回环已献裘。","不堪风叶夜鸣秋。","寒螀吟露月阶幽。","蜗角虚名真误我，","蝇头细字不禁愁。","班超何日定封候。"],"stanzas":[["节序回环已献裘。"],["不堪风叶夜鸣秋。"],["寒螀吟露月阶幽。"],["蜗角虚名真误我，","蝇头细字不禁愁。"],["班超何日定封候。"]]}
{"id":"e1d395b3a1","title":"菩萨蛮","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"菩萨蛮","lines":["日长庭院无人到。","琅玕翠影摇寒瓮。","困卧北窗凉。","好风吹梦长。","壁月升东岭。","冷浸扶疏影。","苗叶万珠明。","露华圆更清。"],"stanzas":[["日长庭院无人到。"],["琅玕翠影摇寒瓮。"],["困卧北窗凉。"],["好风吹梦长。"],["壁月升东岭。"],["冷浸扶疏影。"],["苗叶万珠明。"],["露华圆更清。"]]}
{"id":"8c42757fe6","title":"菩萨蛮","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"菩萨蛮","lines":["蓬山学士文章伯。","尊前风味谁能敌。","新觅似花人。","添成小院春。","玉纤呵翠袖。","满劝金杯酒。","寿酒莫辞斟。","酒深人意深。"],"stanzas":[["蓬山学士文章伯。"],["尊前风味谁能敌。"],["新觅似花人。"],["添成小院春。"],["玉纤呵翠袖。"],["满劝金杯酒。"],["寿酒莫辞斟。"],["酒深人意深。"]]}
{"id":"3ffd9bf5fc","title":"菩萨蛮","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"菩萨蛮","lines":["镜天良月皆佳节。","休恨今宵妨皎洁。","玉锁闷蟾宫。","姮娥意自通。","终有开时节。","莫放笙歌歇。","来夕尚婵娟。","何妨把酒看。"],"stanzas":[["镜天良月皆佳节。"],["休恨今宵妨皎洁。"],["玉锁闷蟾宫。"],["姮娥意自通。"],["终有开时节。"],["莫放笙歌歇。"],["来夕尚婵娟。"],["何妨把酒看。"]]}
{"id":"0616a72a24","title":"霜天晓角","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"霜天晓角","lines":["欢娱电掣。","何况轻离别。","料得两情无奈，","思量尽、总难说。","酒热。","凄兴发。","共寻波底月。","长结西湖心愿，","水有尽、情无歇。"],"stanzas":[["欢娱电掣。"],["何况轻离别。"],["料得两情无奈，","思量尽、总难说。"],["酒热。"],["凄兴发。"],["共寻波底月。"],["长结西湖心愿，","水有尽、情无歇。"]]}
{"id":"fd24b8bf66","title":"阮郎归","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"阮郎归","lines":["绿阴庭院记年时。","家人捧寿卮。","乐声催拍送腰支。","香风匝地衣。","清梦断，","彩云飞。","刘郎今鬓丝。","强将杯酒破愁眉。","如今触事非。"],"stanzas":[["绿阴庭院记年时。"],["家人捧寿卮。"],["乐声催拍送腰支。"],["香风匝地衣。"],["清梦断，","彩云飞。"],["刘郎今鬓丝。"],["强将杯酒破愁眉。"],["如今触事非。"]]}
{"id":"3ad078e67c","title":"浪淘沙","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浪淘沙","lines":["春事有来期。","且喜春归。","问春何似去年时。","报道今年春意好，","随分开眉。","往事莫伤悲。","光景如飞。","十分潘鬓已成丝。","幸是风流犹未减，","且醉芳菲。"],"stanzas":[["春事有来期。"],["且喜春归。"],["问春何似去年时。"],["报道今年春意好，","随分开眉。"],["往事莫伤悲。"],["光景如飞。"],["十分潘鬓已成丝。"],["幸是风流犹未减，","且醉芳菲。"]]}
{"id":"a3ca1e42e3","title":"朝中措","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["芳林曲径锦玲珑。","腻白借微红。","元是海棠标格，","司花点化东风。","端相浑似，","玉真未醉，","春思先慵。","留取浅颦低笑，","夜深翠幄轻笼。"],"stanzas":[["芳林曲径锦玲珑。"],["腻白借微红。"],["元是海棠标格，","司花点化东风。"],["端相浑似，","玉真未醉，","春思先慵。"],["留取浅颦低笑，","夜深翠幄轻笼。"]]}
{"id":"1922e20ce8","title":"朝中措","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["十分天赋好精神。","宫样小腰身。","迷却阳城下蔡，","未饶宋玉东邻。","不堪回首，","高堂去梦，","楚峡归云。","从此好寻夫婿，","有书频寄鸿鳞。"],"stanzas":[["十分天赋好精神。"],["宫样小腰身。"],["迷却阳城下蔡，","未饶宋玉东邻。"],["不堪回首，","高堂去梦，","楚峡归云。"],["从此好寻夫婿，","有书频寄鸿鳞。"]]}
{"id":"89562f6031","title":"朝中措","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["如山堂上翠横空。","山影浪花中。","夜夜林间明月，","时时柳外清风。","如今到此，","け然万事，","无处情锺。","唯有尊前一笑，","分明好个山翁。"],"stanzas":[["如山堂上翠横空。"],["山影浪花中。"],["夜夜林间明月，","时时柳外清风。"],["如今到此，","け然万事，","无处情锺。"],["唯有尊前一笑，","分明好个山翁。"]]}
{"id":"8b368257bb","title":"蝶恋花","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蝶恋花","lines":["飘粉吹香三月暮。","病酒情怀，","愁绪浑无数。","有个人人来又去。","归期有恨难留驻。","明日尊前无觅处。","咿轧篮舆，","只向双溪路。","我辈情锺君谩与。","为云为雨应难据。"],"stanzas":[["飘粉吹香三月暮。"],["病酒情怀，","愁绪浑无数。"],["有个人人来又去。"],["归期有恨难留驻。"],["明日尊前无觅处。"],["咿轧篮舆，","只向双溪路。"],["我辈情锺君谩与。"],["为云为雨应难据。"]]}
{"id":"2d4aef4f08","title":"声声慢","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"声声慢","lines":["云迷越岫，","枫冷吴江，","天香忽到人寰。","满额涂黄，","别更一种施丹。","天教素秋独步，","笑同时、霜菊秋兰。","最好处，","向水阶月地，","把酒相看。","应有骚人雅韵，","将胆瓶筠管，","簇向屏山。","野店云房，","争待结屋中间。","无奈猖狂老子，","架巢卧、风露清闲。","待早晚，","约姮娥、同住广寒。"],"stanzas":[["云迷越岫，","枫冷吴江，","天香忽到人寰。"],["满额涂黄，","别更一种施丹。"],["天教素秋独步，","笑同时、霜菊秋兰。"],["最好处，","向水阶月地，","把酒相看。"],["应有骚人雅韵，","将胆瓶筠管，","簇向屏山。"],["野店云房，","争待结屋中间。"],["无奈猖狂老子，","架巢卧、风露清闲。"],["待早晚，","约姮娥、同住广寒。"]]}
{"id":"43bcb03f2e","title":"卜算子","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"卜算子","lines":["丹桂一枝芳，","陡觉秋容静。","月里人间总一般，","共此扶疏影。","枕畔忽闻香，","夜半还思省。","争奈姮娥不嫁人，","寂寞孤衾冷。"],"stanzas":[["丹桂一枝芳，","陡觉秋容静。"],["月里人间总一般，","共此扶疏影。"],["枕畔忽闻香，","夜半还思省。"],["争奈姮娥不嫁人，","寂寞孤衾冷。"]]}
{"id":"c863992f14","title":"西江月","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"西江月","lines":["富贵从来自有，","人生最羡长年。","骎骎八秩未华颠。","更喜此身强健。","金印新来如斗，","丝纶御墨犹鲜。","枣如瓜大藕如船。","莫惜尊前满劝。"],"stanzas":[["富贵从来自有，","人生最羡长年。"],["骎骎八秩未华颠。"],["更喜此身强健。"],["金印新来如斗，","丝纶御墨犹鲜。"],["枣如瓜大藕如船。"],["莫惜尊前满劝。"]]}
{"id":"4a711e0627","title":"满江红","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满江红","lines":["听说梅山，","一邱内、深藏曲折。","过醒心桥下，","水光清彻。","迤逦跻攀登翠岭，","沈沈烟壑千峰列。","更小亭、风露逼华堂，","荷香发。","歌声动，","云横阕。","舞腰转，","风回雪。","正良辰美景，","众宾欢悦。","老子中间聊笑傲，","酒行莫放觥筹歇。","愿此生、长似钓璜公，","添华发。"],"stanzas":[["听说梅山，","一邱内、深藏曲折。"],["过醒心桥下，","水光清彻。"],["迤逦跻攀登翠岭，","沈沈烟壑千峰列。"],["更小亭、风露逼华堂，","荷香发。"],["歌声动，","云横阕。"],["舞腰转，","风回雪。"],["正良辰美景，","众宾欢悦。"],["老子中间聊笑傲，","酒行莫放觥筹歇。"],["愿此生、长似钓璜公，","添华发。"]]}
{"id":"ffc24ad239","title":"念奴娇","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"念奴娇","lines":["宦途巇险，","问急流勇退，","几人闻早。","自别修门今正是，","一纪生朝还到。","绿野风光，","平泉草木，","争似梅山好。","园林如画，","芰荷香泛芳沼。","早晚玉节来临，","君恩踵至，","金印应如斗。","好是华堂开宴处，","歌舞管弦声奏。","海上蟠桃，","山中仙杏，","共劝长生酒。","莫辞沉醉，","年年此会依旧。"],"stanzas":[["宦途巇险，","问急流勇退，","几人闻早。"],["自别修门今正是，","一纪生朝还到。"],["绿野风光，","平泉草木，","争似梅山好。"],["园林如画，","芰荷香泛芳沼。"],["早晚玉节来临，","君恩踵至，","金印应如斗。"],["好是华堂开宴处，","歌舞管弦声奏。"],["海上蟠桃，","山中仙杏，","共劝长生酒。"],["莫辞沉醉，","年年此会依旧。"]]}
{"id":"d2640f4dfb","title":"满江红","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满江红","lines":["小小华堂，","朱阑外、乱山如簇。","更云中仙掌，","一峰高矗。","南极老人呈瑞处，","丙丁躔次光相烛。","又谁知、堂上有闲人，","无拘束。","宾朋至，","须歌曲。","风月好，","纷丝竹，","都不管、世间是非荣辱。","屈指如今侪辈少，","几人老后能知足。","问此身、何地寄生涯，","唯松菊。"],"stanzas":[["小小华堂，","朱阑外、乱山如簇。"],["更云中仙掌，","一峰高矗。"],["南极老人呈瑞处，","丙丁躔次光相烛。"],["又谁知、堂上有闲人，","无拘束。"],["宾朋至，","须歌曲。"],["风月好，","纷丝竹，","都不管、世间是非荣辱。"],["屈指如今侪辈少，","几人老后能知足。"],["问此身、何地寄生涯，","唯松菊。"]]}
{"id":"70b3b513e5","title":"临江仙","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"临江仙","lines":["桃李飞花春渐老，","海棠次第芬芳。","庭前红叶已成行。","酴醿开未到，","犹更有花王。","从此便须排日醉，","莫将闲事相妨。","老来不是太疏狂。","尊前君看取，","潘宾已成霜。"],"stanzas":[["桃李飞花春渐老，","海棠次第芬芳。"],["庭前红叶已成行。"],["酴醿开未到，","犹更有花王。"],["从此便须排日醉，","莫将闲事相妨。"],["老来不是太疏狂。"],["尊前君看取，","潘宾已成霜。"]]}
{"id":"73bb74eaf9","title":"感皇恩","author":"姜特立","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"感皇恩","lines":["儿女沸欢声，","生朝来到。","帘幕中间喷香兽。","京祠新任，","好事日边还又。","清闲无个事，","君恩厚。","赢得乞食，","歌姬一笑。","旧衲云山伴红袖。","蓬莱弱水，","试问神仙何有。","近来饶落托，","贪杯酒。"],"stanzas":[["儿女沸欢声，","生朝来到。"],["帘幕中间喷香兽。"],["京祠新任，","好事日边还又。"],["清闲无个事，","君恩厚。"],["赢得乞食，","歌姬一笑。"],["旧衲云山伴红袖。"],["蓬莱弱水，","试问神仙何有。"],["近来饶落托，","贪杯酒。"]]}
{"id":"13aa3b3f64","title":"朝中措","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["乘成台上晓书云。","黄色映天庭。","已谢浮名浮利，","也知来应长生。","边亭卧鼓，","馀粮栖亩，","朝野欢声。","从此四时八节，","弟兄常醉金觥。"],"stanzas":[["乘成台上晓书云。"],["黄色映天庭。"],["已谢浮名浮利，","也知来应长生。"],["边亭卧鼓，","馀粮栖亩，","朝野欢声。"],["从此四时八节，","弟兄常醉金觥。"]]}
{"id":"46363d933c","title":"满庭芳","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满庭芳","lines":["天壤茫茫，","人心殊观，","未免因欠思馀。","太山邱垤，","同载一方舆。","那更长沙下湿，","祝融峰、才比吾庐。","秋风冷，","攀缘汗浃，","应叹苦区区。","登高，","聊尔耳，","何须蜡屐，","谁暇膏车。","默存处，","清都宛在须臾。","笑约乘鸾羽客，","窥倒景、拊掌崎岖。","归来把，","萸囊菊盏，","一为洗泥涂。"],"stanzas":[["天壤茫茫，","人心殊观，","未免因欠思馀。"],["太山邱垤，","同载一方舆。"],["那更长沙下湿，","祝融峰、才比吾庐。"],["秋风冷，","攀缘汗浃，","应叹苦区区。"],["登高，","聊尔耳，","何须蜡屐，","谁暇膏车。"],["默存处，","清都宛在须臾。"],["笑约乘鸾羽客，","窥倒景、拊掌崎岖。"],["归来把，","萸囊菊盏，","一为洗泥涂。"]]}
{"id":"8fdb29caee","title":"谒金门","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"谒金门","lines":["梅乍吐。","趁寿席、香风度。","人与此花俱独步。","风流天付与。","好在青云歧路。","愿共作、和羹侣。","归访赤松辞万户。","莺花犹是主。"],"stanzas":[["梅乍吐。"],["趁寿席、香风度。"],["人与此花俱独步。"],["风流天付与。"],["好在青云歧路。"],["愿共作、和羹侣。"],["归访赤松辞万户。"],["莺花犹是主。"]]}
{"id":"c972478510","title":"点绛唇","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"点绛唇","lines":["报答风光，","满倾琼液休思睡。","乱莺声碎。","来往甘棠底。","闻道中和，","深简君王意。","归舟起。","到时应是。","玉殿槐交翠。"],"stanzas":[["报答风光，","满倾琼液休思睡。"],["乱莺声碎。"],["来往甘棠底。"],["闻道中和，","深简君王意。"],["归舟起。"],["到时应是。"],["玉殿槐交翠。"]]}
{"id":"302e2a1580","title":"点绛唇","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"点绛唇","lines":["醉上兰舟，","羡他沙暖鸳鸯睡。","月波金碎。","愁海深无底。","太守新词，","解释无穷意。","高歌起。","浮云闲事。","浑付烟中翠。"],"stanzas":[["醉上兰舟，","羡他沙暖鸳鸯睡。"],["月波金碎。"],["愁海深无底。"],["太守新词，","解释无穷意。"],["高歌起。"],["浮云闲事。"],["浑付烟中翠。"]]}
{"id":"dde5429785","title":"点绛唇","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"点绛唇","lines":["踏白江梅，","大都玉斫酥凝就。","雨肥霜逗。","痴了闺房秀。","莫待冬深，","雪压风欺后。","君知否。","却嫌伊瘦。","仍怕伊僝僽。"],"stanzas":[["踏白江梅，","大都玉斫酥凝就。"],["雨肥霜逗。"],["痴了闺房秀。"],["莫待冬深，","雪压风欺后。"],["君知否。"],["却嫌伊瘦。"],["仍怕伊僝僽。"]]}
{"id":"a94c8b81da","title":"点绛唇","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"点绛唇","lines":["秋夜乘槎，","客星容到天孙渚。","眼波微注。","将谓牵牛渡。","见了还非，","重理霓裳舞。","都无误。","几年一遇。","莫讶周郎顾。"],"stanzas":[["秋夜乘槎，","客星容到天孙渚。"],["眼波微注。"],["将谓牵牛渡。"],["见了还非，","重理霓裳舞。"],["都无误。"],["几年一遇。"],["莫讶周郎顾。"]]}
{"id":"dffbb0156e","title":"朝中措","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["月眉新画露珠圆。","今夕正相鲜。","欲导唐家诞节，","先生汉相韦贤。","悬知此去，","莺迁春谷，","鹗在秋天。","班首算来旬岁，","状头看取明年。"],"stanzas":[["月眉新画露珠圆。"],["今夕正相鲜。"],["欲导唐家诞节，","先生汉相韦贤。"],["悬知此去，","莺迁春谷，","鹗在秋天。"],["班首算来旬岁，","状头看取明年。"]]}
{"id":"b5170f2486","title":"朝中措","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"朝中措","lines":["九重深念朔庭空。","良弼梦时中。","擢第难遵常制，","筑岩直继高风。","明年东府，","金钗珠履，","列鼎鸣钟。","良酝傥分焦革，","早禾休浸曹公。"],"stanzas":[["九重深念朔庭空。"],["良弼梦时中。"],["擢第难遵常制，","筑岩直继高风。"],["明年东府，","金钗珠履，","列鼎鸣钟。"],["良酝傥分焦革，","早禾休浸曹公。"]]}
{"id":"6d2a1390b6","title":"醉落魄・一斛珠","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"醉落魄・一斛珠","lines":["山川迥别。","赤城自古雄东越。","锺英储秀簪绅列。","何事黄扉，","殊未相黄发。","如今衮职那容缺。","人心恰与天时合。","看看孚号彤庭发。","初破天荒，","留与后来说。"],"stanzas":[["山川迥别。"],["赤城自古雄东越。"],["锺英储秀簪绅列。"],["何事黄扉，","殊未相黄发。"],["如今衮职那容缺。"],["人心恰与天时合。"],["看看孚号彤庭发。"],["初破天荒，","留与后来说。"]]}
{"id":"55c34365c6","title":"醉落魄・一斛珠","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"醉落魄・一斛珠","lines":["才高句杰。","飞黄却应鸾和节。","新词聊卷波澜阔。","泉玉淙铮，","犹不比清切。","相逢未稳愁相别。","南园烟草南楼月。","阳关西出重吹彻。","垂柳新栽，","宁忍便攀折。"],"stanzas":[["才高句杰。"],["飞黄却应鸾和节。"],["新词聊卷波澜阔。"],["泉玉淙铮，","犹不比清切。"],["相逢未稳愁相别。"],["南园烟草南楼月。"],["阳关西出重吹彻。"],["垂柳新栽，","宁忍便攀折。"]]}
{"id":"83477554ab","title":"西江月","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"西江月","lines":["三月群贤毕集，","二天五马生光。","传觞击鼓底匆忙。","画鹢将飞江上。","鲁国方虚两社，","齐人要复侵疆。","延英引对上东廊。","应念幽人相望。"],"stanzas":[["三月群贤毕集，","二天五马生光。"],["传觞击鼓底匆忙。"],["画鹢将飞江上。"],["鲁国方虚两社，","齐人要复侵疆。"],["延英引对上东廊。"],["应念幽人相望。"]]}
{"id":"f78101bb8e","title":"西江月","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"西江月","lines":["借甚新除刺史，","岿然鲁殿灵光。","诏书催发棹讴忙。","沙路从今稳上。","有喜刊除戎索，","无劳远抚闽疆。","日高龙影转槐廊。","想见清光注望。"],"stanzas":[["借甚新除刺史，","岿然鲁殿灵光。"],["诏书催发棹讴忙。"],["沙路从今稳上。"],["有喜刊除戎索，","无劳远抚闽疆。"],["日高龙影转槐廊。"],["想见清光注望。"]]}
{"id":"535e85472d","title":"导引","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"导引","lines":["重华真主，","晨夕奉庭闱。","禋祀庆成时。","乾元坤载同归美，","宝册两光辉。","斑衣何似赭黄衣。","此事古今稀。","都人欢乐嵩呼震，","圣寿总天齐。"],"stanzas":[["重华真主，","晨夕奉庭闱。"],["禋祀庆成时。"],["乾元坤载同归美，","宝册两光辉。"],["斑衣何似赭黄衣。"],["此事古今稀。"],["都人欢乐嵩呼震，","圣寿总天齐。"]]}
{"id":"a13077c589","title":"导引","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"导引","lines":["新阳初应，","乐事起彤庭。","和气满吴京。","帝家来庆东皇寿，","西母共长生。","金书玉篆灿龙文。","前导沸欢声。","修龄无极名无尽，","一岁一回增。"],"stanzas":[["新阳初应，","乐事起彤庭。"],["和气满吴京。"],["帝家来庆东皇寿，","西母共长生。"],["金书玉篆灿龙文。"],["前导沸欢声。"],["修龄无极名无尽，","一岁一回增。"]]}
{"id":"e1c2a28a30","title":"导引","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"导引","lines":["合宫亲飨，","青女肃长空。","精意与天通。","后皇临顾谁为侑，","文祖暨神功。","亟蒙祉福岁长丰。","声教被华戎。","两宫眉寿同荣乐，","戬谷永来崇。"],"stanzas":[["合宫亲飨，","青女肃长空。"],["精意与天通。"],["后皇临顾谁为侑，","文祖暨神功。"],["亟蒙祉福岁长丰。"],["声教被华戎。"],["两宫眉寿同荣乐，","戬谷永来崇。"]]}
{"id":"7692e6a721","title":"合宫歌","author":"周必大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"合宫歌","lines":["圣明朝，","旷典乘秋举。","大飨本仁祖。","九室八牖四户。","敕躬齐戒格堪舆。","盛牲实俎。","并侑总稽古。","玉露乍肃天宇。","冰轮下照金铺。","燎烟嘘呼。","郁尊香，","云门舞。","仿佛翔坐，","灵心咸嘉娱。","众星俞美，","光属照熉珠。","清晓御丹凤，","湛恩遍浃率溥。","欢声雷动岳镇呼。","徐命法驾，","万骑花盈路。","献胙慈极，","寿同箕翼，","事超唐虞。","看平燕云，","从此兴文偃武。","待重会诸侯，","依旧东都。"],"stanzas":[["圣明朝，","旷典乘秋举。"],["大飨本仁祖。"],["九室八牖四户。"],["敕躬齐戒格堪舆。"],["盛牲实俎。"],["并侑总稽古。"],["玉露乍肃天宇。"],["冰轮下照金铺。"],["燎烟嘘呼。"],["郁尊香，","云门舞。"],["仿佛翔坐，","灵心咸嘉娱。"],["众星俞美，","光属照熉珠。"],["清晓御丹凤，","湛恩遍浃率溥。"],["欢声雷动岳镇呼。"],["徐命法驾，","万骑花盈路。"],["献胙慈极，","寿同箕翼，","事超唐虞。"],["看平燕云，","从此兴文偃武。"],["待重会诸侯，","依旧东都。"]]}
{"id":"d08375bc7d","title":"失调名","author":"周辉","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"失调名","lines":["卷帘试约东君，","问花信风来第几番。"],"stanzas":[["卷帘试约东君，","问花信风来第几番。"]]}
{"id":"6e97664276","title":"失调名","author":"周辉","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"失调名","lines":["生怕冻损蜂房，","胆瓶汤浸，","且与温存著。"],"stanzas":[["生怕冻损蜂房，","胆瓶汤浸，","且与温存著。"]]}
{"id":"1f8f632892","title":"满江红","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满江红","lines":["寒谷春生，","熏叶气、玉筒吹谷。","新阳后、便占新岁，","吉云清穆。","休把心情关乐裹，","但逢节序添诗轴。","笑强颜、风物岂非痴，","终非俗。","清昼永，","佳眠熟。","门外事，","何时足。","且团栾同社，","笑歌相属。","著意调停云露酿，","从头检举梅花曲。","纵不能、将醉作生涯，","休拘束。"],"stanzas":[["寒谷春生，","熏叶气、玉筒吹谷。"],["新阳后、便占新岁，","吉云清穆。"],["休把心情关乐裹，","但逢节序添诗轴。"],["笑强颜、风物岂非痴，","终非俗。"],["清昼永，","佳眠熟。"],["门外事，","何时足。"],["且团栾同社，","笑歌相属。"],["著意调停云露酿，","从头检举梅花曲。"],["纵不能、将醉作生涯，","休拘束。"]]}
{"id":"d8f93dc33b","title":"满江红","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满江红","lines":["竹里行厨，","来问讯、诸侯宾老。","春满座、弹丝未遍，","挥豪先了。","云避仁风收雨脚，","日随和气薰林表。","向尊前、来访白髯公，","衰何早。","志千里，","功名兆。","光万丈，","文章耀。","洗水壶胸次，","月秋霜晓。","应念一堂尘网暗，","故将百和香云绕。","算赏心、清话古来多，","如今少。"],"stanzas":[["竹里行厨，","来问讯、诸侯宾老。"],["春满座、弹丝未遍，","挥豪先了。"],["云避仁风收雨脚，","日随和气薰林表。"],["向尊前、来访白髯公，","衰何早。"],["志千里，","功名兆。"],["光万丈，","文章耀。"],["洗水壶胸次，","月秋霜晓。"],["应念一堂尘网暗，","故将百和香云绕。"],["算赏心、清话古来多，","如今少。"]]}
{"id":"55ecbaf47a","title":"满江红","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满江红","lines":["柳外轻雷，","催几阵、雨丝飞急。","雷雨过、半川荷气，","粉融香浥。","弄蕊攀条春一笑，","从教水溅罗衣湿。","打梁州、箫鼓浪花中，","跳鱼立。","山倒影，","云千叠。","横浩荡，","舟如叶。","有采菱清些，","桃根双楫。","忘却天涯泊地，","尊前不放闲愁人。","任碧筒、十丈卷金波，","长鲸吸。"],"stanzas":[["柳外轻雷，","催几阵、雨丝飞急。"],["雷雨过、半川荷气，","粉融香浥。"],["弄蕊攀条春一笑，","从教水溅罗衣湿。"],["打梁州、箫鼓浪花中，","跳鱼立。"],["山倒影，","云千叠。"],["横浩荡，","舟如叶。"],["有采菱清些，","桃根双楫。"],["忘却天涯泊地，","尊前不放闲愁人。"],["任碧筒、十丈卷金波，","长鲸吸。"]]}
{"id":"26737173ec","title":"满江红","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"满江红","lines":["罨画溪山，","行欲遍、风蒲还举。","天渐远、水云初静，","柁楼人语。","月色波光看不定，","玉虹横卧金鳞舞。","看五湖、今夜只边舟，","追千古。","怀往事，","渔樵侣。","曾共醉，","松江渚。","算今年依旧，","一杯沧浦。","宇宙此身元是客，","不须怅望家何许。","但中秋、时节好溪山，","皆吾土。"],"stanzas":[["罨画溪山，","行欲遍、风蒲还举。"],["天渐远、水云初静，","柁楼人语。"],["月色波光看不定，","玉虹横卧金鳞舞。"],["看五湖、今夜只边舟，","追千古。"],["怀往事，","渔樵侣。"],["曾共醉，","松江渚。"],["算今年依旧，","一杯沧浦。"],["宇宙此身元是客，","不须怅望家何许。"],["但中秋、时节好溪山，","皆吾土。"]]}
{"id":"5c9bfa26c0","title":"千秋岁","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"千秋岁","lines":["北城南埭。","玉水方流汇。","青樾里，","红尘外。","万桃春不老，","双竹寒相对。","回首处，","满城明月曾同载。","分散西园盖。","消减东阳带。","人事改，","花源在。","神仙虽可学，","功行无过醉。","新酒好，","就船况有鱼堪买。"],"stanzas":[["北城南埭。"],["玉水方流汇。"],["青樾里，","红尘外。"],["万桃春不老，","双竹寒相对。"],["回首处，","满城明月曾同载。"],["分散西园盖。"],["消减东阳带。"],["人事改，","花源在。"],["神仙虽可学，","功行无过醉。"],["新酒好，","就船况有鱼堪买。"]]}
{"id":"d2e002f53e","title":"浣溪沙","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["倾坐东风百媚生。","万红无语笑逢迎。","照妆醒睡蜡烟轻。","采𬟽横斜春不夜，","绛霞浓淡月微明。","梦中重到锦官城。"],"stanzas":[["倾坐东风百媚生。"],["万红无语笑逢迎。"],["照妆醒睡蜡烟轻。"],["采𬟽横斜春不夜，","绛霞浓淡月微明。"],["梦中重到锦官城。"]]}
{"id":"b9fd85822a","title":"浣溪沙","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["催下珠帘护绮丛。","花枝红里烛枝红。","烛光花影夜葱茏。","锦地绣天香雾里，","珠星璧月彩云中。","人间别有几春风。"],"stanzas":[["催下珠帘护绮丛。"],["花枝红里烛枝红。"],["烛光花影夜葱茏。"],["锦地绣天香雾里，","珠星璧月彩云中。"],["人间别有几春风。"]]}
{"id":"8bb87e714b","title":"浣溪沙","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["送尽残春更出游。","风前踪迹似沙鸥。","浅斟低唱小淹留。","月见西楼清夜醉，","雨添南浦绿波愁。","有人无计恋行舟。"],"stanzas":[["送尽残春更出游。"],["风前踪迹似沙鸥。"],["浅斟低唱小淹留。"],["月见西楼清夜醉，","雨添南浦绿波愁。"],["有人无计恋行舟。"]]}
{"id":"6194c7aa39","title":"浣溪沙","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["歙浦钱塘一水通。","闲云如幕碧重重。","吴山应在碧云东。","无力海棠风淡荡，","半眠官柳日葱茏。","眼前春色为谁浓。"],"stanzas":[["歙浦钱塘一水通。"],["闲云如幕碧重重。"],["吴山应在碧云东。"],["无力海棠风淡荡，","半眠官柳日葱茏。"],["眼前春色为谁浓。"]]}
{"id":"31a9f15e7d","title":"浣溪沙","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["宝髻双双出绮丛。","妆光梅影各春风。","收灯时候却相逢。","鱼子笺中此宛转，","龙香拨上语玲珑。","明朝车马莫西东。"],"stanzas":[["宝髻双双出绮丛。"],["妆光梅影各春风。"],["收灯时候却相逢。"],["鱼子笺中此宛转，","龙香拨上语玲珑。"],["明朝车马莫西东。"]]}
{"id":"5532e8c503","title":"浣溪沙","author":"范成大","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"浣溪沙","lines":["红锦障泥杏叶鞯。","解鞍呼渡忆当年。","马骄不肯上航船。","茅店竹篱开席市，","绛裙青袂斸姜田。","临平风物故依然。"],"stanzas":[["红锦障泥杏叶鞯。"],["解鞍呼渡忆当年。"],["马骄不肯上航船。"],["茅店竹篱开席市，","绛裙青袂斸姜田。"],["临平风物故依然。"]]}
