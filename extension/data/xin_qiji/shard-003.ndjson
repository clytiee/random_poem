{"id":"2ef5a3172a","title":"临江仙","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"临江仙","lines":["醉帽吟鞭花不住，","却招花共商量。","人生何必醉为乡。","从教斟酒浅，","休更和诗忙。","一斗百篇风月地，","饶他老子当行。","从今三万六千场。","青青头上发，","还作柳丝长。"],"stanzas":[["醉帽吟鞭花不住，","却招花共商量。"],["人生何必醉为乡。"],["从教斟酒浅，","休更和诗忙。"],["一斗百篇风月地，","饶他老子当行。"],["从今三万六千场。"],["青青头上发，","还作柳丝长。"]]}
{"id":"4717e2dbc9","title":"临江仙","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"临江仙","lines":["祗恐牡丹留不住，","与春约束分明。","未开微雨半开晴。","要花开定准，","又更与花盟。","魏紫朝来将进酒，","玉盘盂样先呈。","鞓红似向舞腰横。","风流人不见，","锦绣夜间行。"],"stanzas":[["祗恐牡丹留不住，","与春约束分明。"],["未开微雨半开晴。"],["要花开定准，","又更与花盟。"],["魏紫朝来将进酒，","玉盘盂样先呈。"],["鞓红似向舞腰横。"],["风流人不见，","锦绣夜间行。"]]}
{"id":"8cc7a6af66","title":"临江仙","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"临江仙","lines":["老去浑身无著处，","天教只住山林。","百年光景百年心。","更欢须叹息，","无病也呻吟。","试向浮瓜沈李处，","清风散发披襟。","莫嫌浅后更频斟。","要他诗句好，","须是酒杯深。"],"stanzas":[["老去浑身无著处，","天教只住山林。"],["百年光景百年心。"],["更欢须叹息，","无病也呻吟。"],["试向浮瓜沈李处，","清风散发披襟。"],["莫嫌浅后更频斟。"],["要他诗句好，","须是酒杯深。"]]}
{"id":"1ab6317587","title":"临江仙","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"临江仙","lines":["偶向停云堂上坐，","晓猿夜鹤惊猜。","主人何事太尘埃。","低头还说向，","被召又重来。","多谢北山山下老，","殷勤一语佳哉。","借君竹杖与芒鞋。","径须从此去，","深入白云堆。"],"stanzas":[["偶向停云堂上坐，","晓猿夜鹤惊猜。"],["主人何事太尘埃。"],["低头还说向，","被召又重来。"],["多谢北山山下老，","殷勤一语佳哉。"],["借君竹杖与芒鞋。"],["径须从此去，","深入白云堆。"]]}
{"id":"53a5f48fbd","title":"蝶恋花","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蝶恋花","lines":["泪眼送君倾似雨。","不折垂杨，","只倩愁随去。","有底风光留不住。","烟波万顷春江橹。","老马临流痴不渡。","应惜障泥，","忘了寻春路。","身在稼轩安稳处。","书来不用多行数。"],"stanzas":[["泪眼送君倾似雨。"],["不折垂杨，","只倩愁随去。"],["有底风光留不住。"],["烟波万顷春江橹。"],["老马临流痴不渡。"],["应惜障泥，","忘了寻春路。"],["身在稼轩安稳处。"],["书来不用多行数。"]]}
{"id":"142fbeeeb3","title":"蝶恋花","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蝶恋花","lines":["燕语莺啼人乍远。","却恨西园，","依旧莺和燕。","笑语十分愁一半。","翠围特地春光暖。","只道书来无过雁。","不道柔肠，","近日无肠断。","柄玉莫摇湘泪点。","怕君唤作秋风扇。"],"stanzas":[["燕语莺啼人乍远。"],["却恨西园，","依旧莺和燕。"],["笑语十分愁一半。"],["翠围特地春光暖。"],["只道书来无过雁。"],["不道柔肠，","近日无肠断。"],["柄玉莫摇湘泪点。"],["怕君唤作秋风扇。"]]}
{"id":"babc6e9e22","title":"蝶恋花","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蝶恋花","lines":["洗尽机心随法喜。","看取尊前，","秋思如春意。","谁与先生宽发齿。","醉时惟有歌而已。","岁月何须溪上记。","千古黄花，","自有渊明比。","高卧石龙呼不起。","微风不动天如醉。"],"stanzas":[["洗尽机心随法喜。"],["看取尊前，","秋思如春意。"],["谁与先生宽发齿。"],["醉时惟有歌而已。"],["岁月何须溪上记。"],["千古黄花，","自有渊明比。"],["高卧石龙呼不起。"],["微风不动天如醉。"]]}
{"id":"1319bb24bd","title":"蝶恋花","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"蝶恋花","lines":["何物能令公怒喜。","山要人来，","人要山无意。","恰似哀筝弦下齿。","千情万意无时已。","自要溪堂韩作记。","今代机云，","好语花难比。","老眼狂花空处起。","银钩未见心先醉。"],"stanzas":[["何物能令公怒喜。"],["山要人来，","人要山无意。"],["恰似哀筝弦下齿。"],["千情万意无时已。"],["自要溪堂韩作记。"],["今代机云，","好语花难比。"],["老眼狂花空处起。"],["银钩未见心先醉。"]]}
{"id":"8577bfdceb","title":"南乡子","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"南乡子","lines":["何处望神州。","满眼风光北固楼。","千古兴亡多少事，","悠悠。","不尽长江衮衮流。","年少万兜鍪。","坐断东南战未休。","天下英雄谁敌手。","曹刘。","生子当如孙仲谋。"],"stanzas":[["何处望神州。"],["满眼风光北固楼。"],["千古兴亡多少事，","悠悠。"],["不尽长江衮衮流。"],["年少万兜鍪。"],["坐断东南战未休。"],["天下英雄谁敌手。"],["曹刘。"],["生子当如孙仲谋。"]]}
{"id":"34adfda57b","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["别恨妆成白发新。","空教儿女笑阵人。","醉寻夜雨旗亭酒，","梦断东风辇路尘。","骑𫘧駬，","籋青云。","看公冠佩玉阶春。","忠言句句唐虞际，","便是人间要路津。"],"stanzas":[["别恨妆成白发新。"],["空教儿女笑阵人。"],["醉寻夜雨旗亭酒，","梦断东风辇路尘。"],["骑𫘧駬，","籋青云。"],["看公冠佩玉阶春。"],["忠言句句唐虞际，","便是人间要路津。"]]}
{"id":"3402ae59cd","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["樽俎风流有几人。","当年未遇已心亲。","金陵种柳欢娱地，","庾岭逢梅寂寞滨。","樽似海，","笔如神。","故人南北一般春。","玉人好把新妆样，","淡画眉儿浅注唇。"],"stanzas":[["樽俎风流有几人。"],["当年未遇已心亲。"],["金陵种柳欢娱地，","庾岭逢梅寂寞滨。"],["樽似海，","笔如神。"],["故人南北一般春。"],["玉人好把新妆样，","淡画眉儿浅注唇。"]]}
{"id":"aed970ebbc","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["指点斋尊特地开。","风帆莫引酒船回。","方惊共折津头柳，","却喜重寻岭上梅。","催月上，","唤风来。","莫愁瓶罄耻金罍。","只愁画角楼头起，","急管哀弦次第催。"],"stanzas":[["指点斋尊特地开。"],["风帆莫引酒船回。"],["方惊共折津头柳，","却喜重寻岭上梅。"],["催月上，","唤风来。"],["莫愁瓶罄耻金罍。"],["只愁画角楼头起，","急管哀弦次第催。"]]}
{"id":"f77054231f","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["困不成眠奈夜何。","情知归未转愁多。","暗将往事思量遍，","谁把多情恼乱他。","些底事，","误人哪。","不成真个不思家。","娇痴却妒香香睡，","唤起醒松说梦些。"],"stanzas":[["困不成眠奈夜何。"],["情知归未转愁多。"],["暗将往事思量遍，","谁把多情恼乱他。"],["些底事，","误人哪。"],["不成真个不思家。"],["娇痴却妒香香睡，","唤起醒松说梦些。"]]}
{"id":"bc7a3e4827","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["梦断京华故倦游。","只今芳草替人愁。","阳关莫作三叠唱，","越女应须为我留。","看逸韵，","自名流。","青衫司马且江州。","君家兄弟真堪笑，","个个能修五凤楼。"],"stanzas":[["梦断京华故倦游。"],["只今芳草替人愁。"],["阳关莫作三叠唱，","越女应须为我留。"],["看逸韵，","自名流。"],["青衫司马且江州。"],["君家兄弟真堪笑，","个个能修五凤楼。"]]}
{"id":"ff957b1ea0","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["一夜清霜变鬓丝。","怕愁刚把酒禁持。","玉人今夜相思不，","想见频将翠枕移。","真个恨，","未多时。","也应香雪减些儿。","菱花照面须频记，","曾道偏宜浅画眉。"],"stanzas":[["一夜清霜变鬓丝。"],["怕愁刚把酒禁持。"],["玉人今夜相思不，","想见频将翠枕移。"],["真个恨，","未多时。"],["也应香雪减些儿。"],["菱花照面须频记，","曾道偏宜浅画眉。"]]}
{"id":"ffd8ae79e1","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["木落山高一夜霜。","北风驱雁又离行。","无言每觉情怀好，","不饮能令兴味长。","频聚散，","试思量。","为谁春草梦池塘。","中年长作东山恨，","莫遣离歌苦断肠。"],"stanzas":[["木落山高一夜霜。"],["北风驱雁又离行。"],["无言每觉情怀好，","不饮能令兴味长。"],["频聚散，","试思量。"],["为谁春草梦池塘。"],["中年长作东山恨，","莫遣离歌苦断肠。"]]}
{"id":"06106ee4da","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["抛却山中诗酒窠。","却来官府听笙歌。","闲愁做弄天来大，","白发栽埋日许多。","新剑戟，","旧风波。","天生予懒奈予何。","此身已觉浑无事，","却教儿童莫恁么。"],"stanzas":[["抛却山中诗酒窠。"],["却来官府听笙歌。"],["闲愁做弄天来大，","白发栽埋日许多。"],["新剑戟，","旧风波。"],["天生予懒奈予何。"],["此身已觉浑无事，","却教儿童莫恁么。"]]}
{"id":"d64c4c5407","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["桃李漫山过眼空。","也宜恼损杜陵翁。","若将玉骨冰姿比，","李蔡为人在下中。","寻驿使，","寄芳容。","垅头休放马蹄松。","吾家离落黄昏后，","剩有西湖处士风。"],"stanzas":[["桃李漫山过眼空。"],["也宜恼损杜陵翁。"],["若将玉骨冰姿比，","李蔡为人在下中。"],["寻驿使，","寄芳容。"],["垅头休放马蹄松。"],["吾家离落黄昏后，","剩有西湖处士风。"]]}
{"id":"d3ddb0ad45","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["晚岁躬耕不怨贫。","只鸡斗酒聚比邻。","都无晋宋之间事，","自是羲皇以上人。","千载后，","百篇存。","更无一字不清真。","若教王谢诸郎在，","未抵柴桑陌上尘。"],"stanzas":[["晚岁躬耕不怨贫。"],["只鸡斗酒聚比邻。"],["都无晋宋之间事，","自是羲皇以上人。"],["千载后，","百篇存。"],["更无一字不清真。"],["若教王谢诸郎在，","未抵柴桑陌上尘。"]]}
{"id":"f607297a35","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["发底青青无限春。","落红飞雪谩纷纷。","黄花也伴秋光老，","何事尊前见在身。","书万卷，","笔如神。","眼看同辈上青云。","个中不许儿童会，","只恐功名更逼人。"],"stanzas":[["发底青青无限春。"],["落红飞雪谩纷纷。"],["黄花也伴秋光老，","何事尊前见在身。"],["书万卷，","笔如神。"],["眼看同辈上青云。"],["个中不许儿童会，","只恐功名更逼人。"]]}
{"id":"4835313516","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["老退何曾说著官。","今朝放罪上恩宽。","便支香火真侍俸，","更缀文书旧殿班。","扶病脚，","洗衰颜。","快从老病借衣冠。","此身忘世浑容易，","使世相忘却自难。"],"stanzas":[["老退何曾说著官。"],["今朝放罪上恩宽。"],["便支香火真侍俸，","更缀文书旧殿班。"],["扶病脚，","洗衰颜。"],["快从老病借衣冠。"],["此身忘世浑容易，","使世相忘却自难。"]]}
{"id":"fb892a51d3","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["绿鬓都无白发侵。","醉时拈笔越精神。","爱将芜语追前事，","更把梅花比那人。","回急雪，","遏行云。","近时歌舞旧时情。","君侯要识谁轻重，","看取金杯几许深。"],"stanzas":[["绿鬓都无白发侵。"],["醉时拈笔越精神。"],["爱将芜语追前事，","更把梅花比那人。"],["回急雪，","遏行云。"],["近时歌舞旧时情。"],["君侯要识谁轻重，","看取金杯几许深。"]]}
{"id":"4e4fe3901c","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["泉上长吟我独清。","喜君来共雪争明。","已惊并水鸥无色，","更怪行沙蟹有声。","添爽气，","动雄情。","奇因六出忆陈平。","却嫌鸟雀投林去，","触破当楼云母屏。"],"stanzas":[["泉上长吟我独清。"],["喜君来共雪争明。"],["已惊并水鸥无色，","更怪行沙蟹有声。"],["添爽气，","动雄情。"],["奇因六出忆陈平。"],["却嫌鸟雀投林去，","触破当楼云母屏。"]]}
{"id":"1213569f75","title":"鹧鸪天","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"鹧鸪天","lines":["莫殢春光花下游。","便须准备落花愁。","百年雨打风吹却，","万事三平二满休。","将扰扰，","付悠悠。","此生于世百无忧。","新愁次第相抛舍，","要伴春归天尽头。"],"stanzas":[["莫殢春光花下游。"],["便须准备落花愁。"],["百年雨打风吹却，","万事三平二满休。"],["将扰扰，","付悠悠。"],["此生于世百无忧。"],["新愁次第相抛舍，","要伴春归天尽头。"]]}
{"id":"427fd7a40b","title":"瑞鹧鸪","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"瑞鹧鸪","lines":["暮年不赋短长词。","和得渊明数首诗。","君自不归归甚易，","今犹未足足何时。","偷闲定向山中老，","此意须教鹤辈知。","闻道只今秋水上，","故人曾榜《北山移》。"],"stanzas":[["暮年不赋短长词。"],["和得渊明数首诗。"],["君自不归归甚易，","今犹未足足何时。"],["偷闲定向山中老，","此意须教鹤辈知。"],["闻道只今秋水上，","故人曾榜《北山移》。"]]}
{"id":"2b5ea8227c","title":"瑞鹧鸪","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"瑞鹧鸪","lines":["声名少日畏人知。","老去行藏与愿违。","山草旧曾呼远志，","故人今又寄当归。","何人可觅安心法，","有客来观杜德机。","却笑使君那得似，","清江万顷白鸥飞。"],"stanzas":[["声名少日畏人知。"],["老去行藏与愿违。"],["山草旧曾呼远志，","故人今又寄当归。"],["何人可觅安心法，","有客来观杜德机。"],["却笑使君那得似，","清江万顷白鸥飞。"]]}
{"id":"a24d09e259","title":"瑞鹧鸪","author":"辛弃疾","dynasty":"宋","genre":"词","collection":"全宋词","rhythmic":"瑞鹧鸪","lines":["胶胶扰扰几时休。","一出山来不自由。","秋水观中山月夜，","停云堂下菊花秋。","随缘道理应须会，","过分功名莫强求。","先自一身愁不了，","那堪愁上更添愁。"],"stanzas":[["胶胶扰扰几时休。"],["一出山来不自由。"],["秋水观中山月夜，","停云堂下菊花秋。"],["随缘道理应须会，","过分功名莫强求。"],["先自一身愁不了，","那堪愁上更添愁。"]]}
